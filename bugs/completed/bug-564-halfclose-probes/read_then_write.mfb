IMPORT errorCode
IMPORT io
IMPORT net
IMPORT strings
IMPORT tls

FUNC readUntilClosed(RES conn AS tls::Socket) AS String
  MUT got = 0
  WHILE TRUE
    LET chunk AS List OF Byte = tls::read(conn, 4096)
    got = got + len(chunk)
  END WHILE
  RETURN "drained=NEVER"
  TRAP(err)
    RETURN "drained code=" & toString(err.code) & " got=" & toString(got)
  END TRAP
END FUNC

FUNC writeLoop(RES conn AS tls::Socket, n AS Integer) AS String
  LET chunk AS String = strings::repeat("x", 65536)
  MUT w = 0
  FOR i = 1 TO n
    tls::write(conn, chunk)
    w = w + 1
  NEXT
  RETURN "after=COMPLETED writes=" & toString(w)
  TRAP(err)
    RETURN "after code=" & toString(err.code) & " writes=" & toString(w)
  END TRAP
END FUNC

FUNC main AS Integer
  RES s = tls::listen("127.0.0.1", 0, "/tmp/b564p/cert.pem", "/tmp/b564p/key.pem")
  LET at AS net::Address = tls::localAddress(s)
  io::print("port=" & toString(at.port))
  RES conn = tls::accept(s)
  io::print(readUntilClosed(conn))
  LET go AS String = io::input()
  io::print(writeLoop(conn, 2000))
  RETURN 0
END FUNC
