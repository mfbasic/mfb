IMPORT app
IMPORT canvas
IMPORT vector
IMPORT color

FUNC pt(x AS Float, y AS Float) AS vector::Float2
  RETURN vector::Float2[x := x, y := y]
END FUNC

FUNC square(cx AS Float, cy AS Float, h AS Float) AS List OF vector::Float2
  RETURN [pt(cx - h, cy - h), pt(cx + h, cy - h), pt(cx + h, cy + h), pt(cx - h, cy + h)]
END FUNC

' One polygon of two small squares 0.9 units apart, magnified 14,000 times, so both are
' far off the surface. The pixel column midway between them is where the two central
' differences of the distance cancel.
FUNC main() AS Nothing
  app::setMode(app::Mode.Canvas)
  LET t AS canvas::Transform = canvas::Transform[a := 14000.0, b := 0.0, c := 0.0, d := 14000.0, tx := 450.5, ty := 300.5]
  canvas::present([canvas::Polygon[id := "", position := pt(0.0, 0.0), contours := [square(0.0 - 0.45, 0.0, 0.0005), square(0.45, 0.0, 0.0005)], rule := canvas::FillRule.NonZero, paint := canvas::fill(color::rgb(255, 255, 255)), transform := t]])
END FUNC
