' bug-531 -- absence had two different shapes in two search packages, and now
' has one.
'
' Before:
'   strings::find("abc", "z")  raises ErrNotFound  (77050004)
'   regex::find("abc", "z")    returned -1
'
' Both were defensible in isolation. Together they meant that swapping a literal
' search for a pattern search silently turned a raising call into one that
' returned a sentinel -- and a caller who did not re-read the man page got -1
' flowing into an index expression instead of a TRAP.
'
' After: every index-returning `find` in the language raises ErrNotFound, so the
' substitution no longer changes how absence behaves. Only `find` moved; the
' members whose return type already holds a "no match" value keep their answers.

IMPORT io
IMPORT strings
IMPORT regex
IMPORT collections

FUNC stringsFind(hay AS String, needle AS String) AS String
  RETURN "returned " & toString(strings::find(hay, needle))
TRAP(err)
  RETURN "RAISED code=" & toString(err.code)
END TRAP
END FUNC

FUNC regexFind(hay AS String, pattern AS String) AS String
  RETURN "returned " & toString(regex::find(hay, pattern))
TRAP(err)
  RETURN "RAISED code=" & toString(err.code)
END TRAP
END FUNC

FUNC collectionsFind(hay AS List OF String, needle AS String) AS String
  RETURN "returned " & toString(collections::find(hay, needle))
TRAP(err)
  RETURN "RAISED code=" & toString(err.code)
END TRAP
END FUNC

FUNC main AS Integer
  LET l AS List OF String = ["a", "b", "c"]

  io::print("present -- the three agree, as they always did:")
  io::print("  strings::find(\"abc\", \"b\")     -> " & stringsFind("abc", "b"))
  io::print("  regex::find(\"abc\", \"b\")       -> " & regexFind("abc", "b"))
  io::print("  collections::find([a,b,c], \"b\") -> " & collectionsFind(l, "b"))
  io::print("")
  io::print("absent -- the three now agree here too:")
  io::print("  strings::find(\"abc\", \"z\")     -> " & stringsFind("abc", "z"))
  io::print("  regex::find(\"abc\", \"z\")       -> " & regexFind("abc", "z"))
  io::print("  collections::find([a,b,c], \"z\") -> " & collectionsFind(l, "z"))
  io::print("")
  io::print("=> one failure, reported one way.")
  io::print("")

  io::print("the convergence is narrow -- only `find` returns an index:")
  io::print("  regex::match(\"abc\", \"z\")     -> " & toString(regex::match("abc", "z")))
  io::print("  regex::findAll(\"abc\", \"z\")   -> n=" & toString(len(regex::findAll("abc", "z"))))
  io::print("  regex::replace(\"abc\", \"z\",\"-\") -> \"" & regex::replace("abc", "z", "-") & "\"")
  io::print("  regex::findMatch(\"abc\", \"z\").start -> " & toString(regex::findMatch("abc", "z").start))
  RETURN 0
END FUNC
