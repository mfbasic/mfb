' bug-526 (FIXED) -- `mfb man tls poll` rendered the list overload as
'     tls::poll(socks AS List OF tls::Socket, ...) AS tls::Socket
' while its own Description said "Given a List OF RES tls::Socket" and its
' example declared `MUT socks AS List OF RES tls::Socket`. The signature was the
' half that was wrong: `List OF tls::Socket` is TYPE_RESOURCE_REQUIRES_RES.
'
' `mfb man tcp poll` always rendered the same overload correctly, because tcp
' builds the parameter as list_of(Res(named(..))) while tls built it as
' ListOf(named(..)) -- and matching is RES-transparent, so the marker could
' always have been carried; only the RENDER lost it. tls now builds it the tcp
' way, and both pages print `List OF RES <pkg>::Socket`.
'
' The `List OF tls::Socket` line below stays commented out because it is still
' rejected -- that rule did not change, and it is what made the old signature
' uncompilable. Pinned generally by
' `cli::man::tests::every_rendered_signature_marks_a_resource_collection_element_res`.

IMPORT io
IMPORT tls

FUNC touch(go AS Boolean) AS Integer
  IF go THEN
    RES s = tls::connect("127.0.0.1", 1)
    RETURN 1
  END IF
  RETURN 0
TRAP(err)
  RETURN -1
END TRAP
END FUNC

FUNC main AS Integer
  ' What the man page prints NOW, in every place -- and it compiles:
  MUT ok AS List OF RES tls::Socket = []
  io::print("List OF RES tls::Socket declared: " & toString(len(ok)))

  ' A bare element is still refused. Restore this line to see it:
  '   MUT bad AS List OF tls::Socket = []

  io::print("touch = " & toString(touch(FALSE)))
  io::print("=> compare `mfb man tls poll` with `mfb man tcp poll`.")
  RETURN 0
END FUNC
