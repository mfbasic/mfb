' bug-532 -- FIXED. The regex package used to report WHERE a match starts and
' nothing else: `find` and `findAll` returned start indices, and there was no end
' index, no match text and no capture accessor. Extraction was impossible for a
' general pattern, because a pattern's match LENGTH is an output:
'
'   regex::findAll("a1b22c333", "\\d+") -> [1, 3, 6]
'
' Those three matches are "1", "22" and "333" -- lengths 1, 2 and 3. The only
' routes to them were `regex::replace` with a "$0" template into a side channel
' the package does not provide, or re-matching an anchored probe at every
' candidate length, which is O(text * maxlen) work to recover something the
' engine had already computed.
'
' `regex::findMatch` and `regex::findAllMatches` report it directly.

IMPORT io
IMPORT strings
IMPORT collections
IMPORT regex

FUNC main AS Integer
  LET text AS String = "a1b22c333"
  LET pattern AS String = "\\d+"

  io::print("text    = " & text)
  io::print("pattern = " & pattern)
  FOR EACH s IN regex::findAll(text, pattern)
    io::print("  match starts at scalar " & toString(s))
  NEXT
  io::print("")

  io::print("the spans, reported directly:")
  FOR EACH m IN regex::findAllMatches(text, pattern)
    io::print("  [" & toString(m.start) & ", " & toString(m.endIndex) & ") = \"" & m.text & "\"")
  NEXT
  io::print("")

  ' Captures are readable outside a replacement template too, by number and by
  ' name, so a caller who wrote (?<year>...) never counts parentheses.
  LET d AS regex::MatchInfo = regex::findMatch("due 2024-06-24", "(?<year>\\d{4})-(?<month>\\d{2})-(?<day>\\d{2})")
  io::print("named captures of " & d.text & ":")
  io::print("  year  = " & collections::get(d.groups, collections::get(d.names, "year")).text)
  io::print("  month = " & collections::get(d.groups, collections::get(d.names, "month")).text)
  io::print("  day   = " & collections::get(d.groups, collections::get(d.names, "day")).text)
  io::print("")

  ' Rewriting around a match needs the end index, which is why the start alone
  ' was not enough.
  LET first AS regex::MatchInfo = regex::findMatch(text, pattern)
  io::print("rewrite around the first match: " & strings::left(text, first.start) & "[" & first.text & "]" & strings::right(text, len(text) - first.endIndex))
  RETURN 0
END FUNC
