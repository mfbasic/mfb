IMPORT tcp
IMPORT strings
IMPORT io

FUNC reply(m AS String) AS String
  RETURN m
END FUNC

FUNC handle(RES l AS tcp::Listener) AS Nothing
  RES sock AS tcp::Socket = tcp::accept(l)
  MUT raw AS List OF Byte = []
  raw = tcp::read(sock, 65536) TRAP(e)
    RECOVER []
  END TRAP
  LET txt AS String = toString(raw)
  io::print("echoing " & toString(strings::byteLen(txt)) & " chars")
  tcp::write(sock, reply(txt)) TRAP(e)
    io::print("write failed")
    RETURN
  END TRAP
  io::print("wrote")
END FUNC

FUNC main() AS Integer
  RES s AS tcp::Listener = tcp::listen("127.0.0.1", 18082, 16)
  handle(s)
  RETURN 0
END FUNC
