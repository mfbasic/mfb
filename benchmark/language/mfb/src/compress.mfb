' Compression benchmark (compress:: package). Group `compress`.
'
' compress:: (CRC-32, raw DEFLATE, gzip) is written in MFBASIC with no system
' library. The C peer calls system zlib (crc32, deflate/inflate with raw and
' gzip window bits) and the Python peer the zlib module — each language's
' standard means of doing the job.
'
' Input: a deterministic ~128 KB word-salad text (16-word vocabulary, LCG-chosen,
' space/newline separated), built once, untimed, identically in every language.
'
' Rows:
'   crc32    64x crc32 of the input; checksum = sum of the 64 CRCs
'   deflate  4x raw DEFLATE (level 6) of the input
'   inflate  16x raw inflate of the input deflated once, untimed (level 6)
'   gzip     4x gzip encode (level 6) + gzip decode round trip
'
' Compressed bytes legitimately differ between compressors (mfb's own encoder
' vs zlib: same format, different match choices), so no row checksums a
' compressed length. Each row checksums the round-tripped data instead: per
' repetition, len + crc32 of the decompressed bytes (for `deflate` the timed
' output is inflated untimed to get them), summed. That is a fixed function of
' the input and matches bit-for-bit. `inflate` decodes each language's own
' level-6 DEFLATE stream of the same text, so its decoded work is identical
' while the coded stream it walks differs slightly.
IMPORT io
IMPORT compress
IMPORT collections
IMPORT datetime
IMPORT strings

' Deterministic text: LCG x = (x*1103515245 + 12345) MOD 2^31 picks word
' (x/65536) MOD 16; the separator is "\n" when (x/1024) MOD 13 = 0, else " ".
' Stops once at least `target` bytes are produced (shared with the C/Python
' mirrors).
FUNC compressInput(target AS Integer) AS List OF Byte
  LET words AS List OF String = ["the", "quick", "brown", "fox", "jumps", "over", "lazy", "dog", "compress", "deflate", "window", "huffman", "literal", "length", "distance", "block"]
  MUT parts AS List OF String = []
  MUT total AS Integer = 0
  MUT x AS Integer = 12345
  WHILE total < target
    x = (x * 1103515245 + 12345) MOD 2147483648
    LET w AS String = collections::get(words, (x / 65536) MOD 16)
    MUT sep AS String = " "
    IF (x / 1024) MOD 13 = 0 THEN
      sep = "\n"
    END IF
    parts = collections::append(parts, w & sep)
    total = total + len(w) + 1
  END WHILE
  RETURN strings::toBytes(strings::join(parts, ""))
END FUNC

' ---- compress crc32: 64x CRC-32 of the input --------------------------------
FUNC test_compress_crc32(run AS Integer, tests AS List OF BenchResult) AS List OF BenchResult
  LET x AS List OF Byte = compressInput(131072)
  MUT times AS List OF Integer = []
  MUT checksum AS Integer = 0
  FOR r = 0 TO run - 1
    LET t0 AS Integer = datetime::monotonicNanos()
    MUT acc AS Integer = 0
    FOR rep = 1 TO 64
      acc = acc + compress::crc32(x)
    NEXT
    checksum = acc
    LET t1 AS Integer = datetime::monotonicNanos()
    times = collections::append(times, t1 - t0)
  NEXT
  io::printError("test_compress_crc32 = " & toString(checksum))
  RETURN collections::append(tests, makeResult("compress", "crc32", times))
END FUNC

' Round-trip checksum term shared by the encoder/decoder rows: the decompressed
' length plus its CRC-32 — independent of which compressor built the stream.
FUNC compressRoundTrip(y AS List OF Byte) AS Integer
  RETURN len(y) + compress::crc32(y)
END FUNC

' ---- compress deflate: 4x raw DEFLATE of the input (level 6) ----------------
FUNC test_compress_deflate(run AS Integer, tests AS List OF BenchResult) AS List OF BenchResult
  LET x AS List OF Byte = compressInput(131072)
  MUT times AS List OF Integer = []
  MUT checksum AS Integer = 0
  FOR r = 0 TO run - 1
    MUT outs AS List OF List OF Byte = []
    LET t0 AS Integer = datetime::monotonicNanos()
    FOR rep = 1 TO 4
      outs = collections::append(outs, compress::deflate(x, 6))
    NEXT
    LET t1 AS Integer = datetime::monotonicNanos()
    times = collections::append(times, t1 - t0)
    MUT acc AS Integer = 0
    FOR EACH d IN outs
      acc = acc + compressRoundTrip(compress::inflate(d))
    NEXT
    checksum = acc
  NEXT
  io::printError("test_compress_deflate = " & toString(checksum))
  RETURN collections::append(tests, makeResult("compress", "deflate", times))
END FUNC

' ---- compress inflate: 16x raw inflate of the deflated input ----------------
FUNC test_compress_inflate(run AS Integer, tests AS List OF BenchResult) AS List OF BenchResult
  LET d AS List OF Byte = compress::deflate(compressInput(131072), 6)
  MUT times AS List OF Integer = []
  MUT checksum AS Integer = 0
  FOR r = 0 TO run - 1
    LET t0 AS Integer = datetime::monotonicNanos()
    MUT acc AS Integer = 0
    FOR rep = 1 TO 16
      acc = acc + compressRoundTrip(compress::inflate(d))
    NEXT
    checksum = acc
    LET t1 AS Integer = datetime::monotonicNanos()
    times = collections::append(times, t1 - t0)
  NEXT
  io::printError("test_compress_inflate = " & toString(checksum))
  RETURN collections::append(tests, makeResult("compress", "inflate", times))
END FUNC

' ---- compress gzip: 4x gzipEncode + gzipDecode round trip (level 6) ---------
FUNC test_compress_gzip(run AS Integer, tests AS List OF BenchResult) AS List OF BenchResult
  LET x AS List OF Byte = compressInput(131072)
  MUT times AS List OF Integer = []
  MUT checksum AS Integer = 0
  FOR r = 0 TO run - 1
    LET t0 AS Integer = datetime::monotonicNanos()
    MUT acc AS Integer = 0
    FOR rep = 1 TO 4
      acc = acc + compressRoundTrip(compress::gzipDecode(compress::gzipEncode(x, 6)))
    NEXT
    checksum = acc
    LET t1 AS Integer = datetime::monotonicNanos()
    times = collections::append(times, t1 - t0)
  NEXT
  io::printError("test_compress_gzip = " & toString(checksum))
  RETURN collections::append(tests, makeResult("compress", "gzip", times))
END FUNC
