FUNC test_lsd_set(run AS Integer, tests AS List OF BenchResult) AS List OF BenchResult
  LET stPath AS String = fs::pathJoin([fs::tempDirectory(), "bench_test_lsd_set.tmp"])
  RES f AS File STATE RecDyn = fs::open(stPath, "write")
  fs::deleteFile(stPath)
  MUT times AS List OF Integer = []
  MUT checksum AS Integer = 0
  FOR r = 0 TO run - 1
    f.state.xs = buildStrRange(200)
    LET t0 AS Integer = datetime::monotonicNanos()
    FOR pass = 0 TO 9
      FOR j = 0 TO 199
        LET cur AS List OF String = f.state.xs
        LET v AS String = collections::get(cur, j)
        f.state.xs = collections::set(cur, j, v & "!")
      NEXT
    NEXT
    LET cur AS List OF String = f.state.xs
    MUT sumv AS Integer = 0
    FOR j = 0 TO 199
      sumv = sumv + len(collections::get(cur, j))
    NEXT
    checksum = sumv
    LET t1 AS Integer = datetime::monotonicNanos()
    times = collections::append(times, t1 - t0)
  NEXT
  io::printError("test_lsd_set = " & toString(checksum))
  RETURN collections::append(tests, makeResult("list (State-Dynamic)", "set", times))
END FUNC

