FUNC test_lsf_append(run AS Integer, tests AS List OF BenchResult) AS List OF BenchResult
  LET stPath AS String = fs::pathJoin([fs::tempDirectory(), "bench_test_lsf_append.tmp"])
  RES f AS File STATE RecFixed = fs::open(stPath, "write")
  fs::deleteFile(stPath)
  MUT times AS List OF Integer = []
  MUT checksum AS Integer = 0
  FOR r = 0 TO run - 1
    LET t0 AS Integer = datetime::monotonicNanos()
    f.state.xs = []
    FOR i = 0 TO 1000 - 1
      f.state.xs = collections::append(f.state.xs, i)
    NEXT
    checksum = len(f.state.xs)
    LET t1 AS Integer = datetime::monotonicNanos()
    times = collections::append(times, t1 - t0)
  NEXT
  io::printError("test_lsf_append = " & toString(checksum))
  RETURN collections::append(tests, makeResult("list (State-Fixed)", "append", times))
END FUNC

