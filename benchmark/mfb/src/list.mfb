FUNC test_lf_groupby(run AS Integer, tests AS List OF BenchResult) AS List OF BenchResult
  LET base = buildRange(2000)
  MUT times AS List OF Integer = []
  MUT checksum AS Integer = 0
  FOR r = 0 TO run - 1
    LET t0 AS Integer = datetime::monotonicNanos()
    MUT acc AS Integer = 0
    FOR k = 0 TO 1 - 1
      acc = acc + len(collections::groupBy(base, bucketKey, identity))
    NEXT
    checksum = acc
    LET t1 AS Integer = datetime::monotonicNanos()
    times = collections::append(times, t1 - t0)
  NEXT
  io::printError("test_lf_groupby = " & toString(checksum))
