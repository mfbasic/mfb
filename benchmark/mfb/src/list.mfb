FUNC test_ld_set(run AS Integer, tests AS List OF BenchResult) AS List OF BenchResult
  MUT times AS List OF Integer = []
  MUT checksum AS Integer = 0
  FOR r = 0 TO run - 1
    MUT nums AS List OF String = buildStrRange(200)
    LET t0 AS Integer = datetime::monotonicNanos()
    FOR pass = 0 TO 9
      FOR j = 0 TO 199
        LET v AS String = collections::get(nums, j)
        nums = collections::set(nums, j, v & "!")
      NEXT
    NEXT
    MUT sumv AS Integer = 0
    FOR j = 0 TO 199
      sumv = sumv + len(collections::get(nums, j))
    NEXT
    checksum = sumv
    LET t1 AS Integer = datetime::monotonicNanos()
    times = collections::append(times, t1 - t0)
  NEXT
  io::printError("test_ld_set = " & toString(checksum))
  RETURN collections::append(tests, makeResult("list (Dynamic)", "set", times))
END FUNC

