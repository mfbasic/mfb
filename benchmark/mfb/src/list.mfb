  MUT times AS List OF Integer = []
  MUT checksum AS Integer = 0
  FOR r = 0 TO run - 1
    LET t0 AS Integer = datetime::monotonicNanos()
    MUT acc AS Integer = 0
    FOR k = 0 TO 200 - 1
      IF collections::all(base, isPos) THEN
        acc = acc + 1
      END IF
    NEXT
    checksum = acc
    LET t1 AS Integer = datetime::monotonicNanos()
    times = collections::append(times, t1 - t0)
  NEXT
  io::printError("test_lf_all = " & toString(checksum))
  RETURN collections::append(tests, makeResult("list (Fixed)", "all", times))
END FUNC

