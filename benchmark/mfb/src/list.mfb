FUNC test_lrd_set(run AS Integer, tests AS List OF BenchResult) AS List OF BenchResult
  MUT times AS List OF Integer = []
  MUT checksum AS Integer = 0
  FOR r = 0 TO run - 1
    MUT rec AS RecDyn = RecDyn[1, buildStrRange(200), 2]
    LET t0 AS Integer = datetime::monotonicNanos()
    FOR pass = 0 TO 9
      FOR j = 0 TO 199
        LET cur AS List OF String = rec.xs
        LET v AS String = collections::get(cur, j)
        rec = WITH rec { xs := collections::set(cur, j, v & "!") }
      NEXT
    NEXT
    LET cur AS List OF String = rec.xs
    MUT sumv AS Integer = 0
    FOR j = 0 TO 199
      sumv = sumv + len(collections::get(cur, j))
    NEXT
    checksum = sumv
    LET t1 AS Integer = datetime::monotonicNanos()
    times = collections::append(times, t1 - t0)
  NEXT
  io::printError("test_lrd_set = " & toString(checksum))
  RETURN collections::append(tests, makeResult("list (Record-Dynamic)", "set", times))
END FUNC

