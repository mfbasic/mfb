    LET base AS List OF String = f.state.xs
    MUT acc AS Integer = 0
    FOR k = 0 TO 100 - 1
      FOR i = 0 TO 999
        acc = acc + len2(collections::get(base, i))
      NEXT
    NEXT
    checksum = acc
    LET t1 AS Integer = datetime::monotonicNanos()
    times = collections::append(times, t1 - t0)
  NEXT
  io::printError("test_lsd_get = " & toString(checksum))
  RETURN collections::append(tests, makeResult("list (State-Dynamic)", "get", times))
END FUNC

