FUNC test_lrf_append(run AS Integer, tests AS List OF BenchResult) AS List OF BenchResult
  MUT times AS List OF Integer = []
  MUT checksum AS Integer = 0
  FOR r = 0 TO run - 1
    LET t0 AS Integer = datetime::monotonicNanos()
    MUT rec AS RecFixed = RecFixed[1, [], 2]
    FOR i = 0 TO 1000 - 1
      rec = WITH rec { xs := collections::append(rec.xs, i) }
    NEXT
    checksum = len(rec.xs)
