END FUNC

FUNC test_lf_set(run AS Integer, tests AS List OF BenchResult) AS List OF BenchResult
  MUT times AS List OF Integer = []
  MUT checksum AS Integer = 0
  FOR r = 0 TO run - 1
    MUT nums AS List OF Integer = buildRange(200)
    LET t0 AS Integer = datetime::monotonicNanos()
    FOR pass = 0 TO 9
      FOR j = 0 TO 199
        LET v AS Integer = collections::get(nums, j)
        nums = collections::set(nums, j, v + 1)
      NEXT
    NEXT
    MUT sumv AS Integer = 0
    FOR j = 0 TO 199
      sumv = sumv + collections::get(nums, j)
    NEXT
    checksum = sumv
    LET t1 AS Integer = datetime::monotonicNanos()
    times = collections::append(times, t1 - t0)
  NEXT
  io::printError("test_lf_set = " & toString(checksum))
  RETURN collections::append(tests, makeResult("list (Fixed)", "set", times))
END FUNC

FUNC test_lf_sort(run AS Integer, tests AS List OF BenchResult) AS List OF BenchResult
  LET base = buildRand(50)
  MUT times AS List OF Integer = []
  MUT checksum AS Integer = 0
  FOR r = 0 TO run - 1
    LET t0 AS Integer = datetime::monotonicNanos()
    MUT acc AS Integer = 0
    FOR k = 0 TO 1 - 1
      acc = acc + len(collections::sort(base))
    NEXT
    checksum = acc
    LET t1 AS Integer = datetime::monotonicNanos()
