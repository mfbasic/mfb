FUNC test_lf_mid(run AS Integer, tests AS List OF BenchResult) AS List OF BenchResult
  LET base = buildRange(1000)
  MUT times AS List OF Integer = []
  MUT checksum AS Integer = 0
  FOR r = 0 TO run - 1
    LET t0 AS Integer = datetime::monotonicNanos()
    MUT acc AS Integer = 0
    FOR k = 0 TO 500 - 1
      acc = acc + len(collections::mid(base, 250, 500))
    NEXT
    checksum = acc
