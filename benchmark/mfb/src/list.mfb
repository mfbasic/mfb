FUNC test_lsd_removeAt(run AS Integer, tests AS List OF BenchResult) AS List OF BenchResult
  LET stPath AS String = fs::pathJoin([fs::tempDirectory(), "bench_test_lsd_removeAt.tmp"])
  RES f AS File STATE RecDyn = fs::open(stPath, "write")
  fs::deleteFile(stPath)
  LET base = buildStrRange(1000)
  MUT times AS List OF Integer = []
  MUT checksum AS Integer = 0
  FOR r = 0 TO run - 1
    LET t0 AS Integer = datetime::monotonicNanos()
    f.state.xs = base
    MUT cnt AS Integer = 0
    WHILE len(f.state.xs) > 0
      LET cur AS List OF String = f.state.xs
      f.state.xs = collections::removeAt(cur, 0)
      cnt = cnt + 1
    END WHILE
    checksum = cnt
    LET t1 AS Integer = datetime::monotonicNanos()
    times = collections::append(times, t1 - t0)
  NEXT
  io::printError("test_lsd_removeAt = " & toString(checksum))
  RETURN collections::append(tests, makeResult("list (State-Dynamic)", "removeAt", times))
END FUNC

