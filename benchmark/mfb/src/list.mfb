FUNC test_lrd_contains(run AS Integer, tests AS List OF BenchResult) AS List OF BenchResult
  LET rec AS RecDyn = RecDyn[1, buildStrRange(1000), 2]
  MUT times AS List OF Integer = []
  MUT checksum AS Integer = 0
  FOR r = 0 TO run - 1
    LET t0 AS Integer = datetime::monotonicNanos()
    LET base AS List OF String = rec.xs
    MUT acc AS Integer = 0
    FOR k = 0 TO 500 - 1
      IF NOT collections::contains(base, "absent") THEN
        acc = acc + 1
      END IF
    NEXT
