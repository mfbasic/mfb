FUNC test_lrf_removeAt(run AS Integer, tests AS List OF BenchResult) AS List OF BenchResult
  LET base = buildRange(1000)
  MUT times AS List OF Integer = []
  MUT checksum AS Integer = 0
  FOR r = 0 TO run - 1
    LET t0 AS Integer = datetime::monotonicNanos()
    MUT rec AS RecFixed = RecFixed[1, base, 2]
    MUT cnt AS Integer = 0
    WHILE len(rec.xs) > 0
      LET cur AS List OF Integer = rec.xs
      rec = WITH rec { xs := collections::removeAt(cur, 0) }
      cnt = cnt + 1
    END WHILE
    checksum = cnt
    LET t1 AS Integer = datetime::monotonicNanos()
    times = collections::append(times, t1 - t0)
  NEXT
  io::printError("test_lrf_removeAt = " & toString(checksum))
  RETURN collections::append(tests, makeResult("list (Record-Fixed)", "removeAt", times))
END FUNC

