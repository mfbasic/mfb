END FUNC

FUNC test_lf_sort_asc(run AS Integer, tests AS List OF BenchResult) AS List OF BenchResult
  LET base = sortMakeAsc(20000)
  MUT times AS List OF Integer = []
  MUT checksum AS Integer = 0
  FOR r = 0 TO run - 1
    LET t0 AS Integer = datetime::monotonicNanos()
    MUT acc AS Integer = 0
    FOR k = 0 TO 0
      LET sorted AS List OF Integer = collections::sort(base)
      acc = acc + sortHash(sorted)
    NEXT
    checksum = acc
    LET t1 AS Integer = datetime::monotonicNanos()
    times = collections::append(times, t1 - t0)
  NEXT
  io::printError("test_lf_sort_asc = " & toString(checksum))
  RETURN collections::append(tests, makeResult("list (Fixed)", "sort_asc", times))
END FUNC

