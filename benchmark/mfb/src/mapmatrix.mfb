FUNC test_mrf_set(run AS Integer, tests AS List OF BenchResult) AS List OF BenchResult
  MUT times AS List OF Integer = []
  MUT checksum AS Integer = 0
  FOR r = 0 TO run - 1
    LET t0 AS Integer = datetime::monotonicNanos()
    MUT rec AS RecMapFixed = RecMapFixed[1, Map OF Integer TO Integer { }, 2]
    FOR i = 0 TO 300 - 1
      rec = WITH rec { xs := collections::set(rec.xs, i, i) }
    NEXT
    checksum = len(collections::keys(rec.xs))
    LET t1 AS Integer = datetime::monotonicNanos()
    times = collections::append(times, t1 - t0)
  NEXT
  io::printError("test_mrf_set = " & toString(checksum))
