END FUNC

FUNC test_mf_removeKey(run AS Integer, tests AS List OF BenchResult) AS List OF BenchResult
  LET base = buildMapII(300)
  MUT times AS List OF Integer = []
  MUT checksum AS Integer = 0
  FOR r = 0 TO run - 1
    LET t0 AS Integer = datetime::monotonicNanos()
    MUT nums AS Map OF Integer TO Integer = base
    MUT cnt AS Integer = 0
    FOR i = 0 TO 300 - 1
      nums = collections::removeKey(nums, i)
