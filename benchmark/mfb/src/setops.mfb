' ===========================================================================
' GROUP: set (Record-Fixed)
' ===========================================================================

FUNC test_srf_add(run AS Integer, tests AS List OF BenchResult) AS List OF BenchResult
  MUT times AS List OF Integer = []
  MUT checksum AS Integer = 0
  FOR r = 0 TO run - 1
    LET t0 AS Integer = datetime::monotonicNanos()
    MUT rec AS RecSetFixed = RecSetFixed[1, Set OF Integer { }, 2]
    FOR i = 0 TO 300 - 1
      rec = WITH rec { xs := collections::add(rec.xs, i) }
    NEXT
    checksum = len(rec.xs)
    LET t1 AS Integer = datetime::monotonicNanos()
    times = collections::append(times, t1 - t0)
  NEXT
  io::printError("test_srf_add = " & toString(checksum))
  RETURN collections::append(tests, makeResult("set (Record-Fixed)", "add", times))
END FUNC

FUNC test_srf_remove(run AS Integer, tests AS List OF BenchResult) AS List OF BenchResult
  LET base = buildSetRange(300)
  MUT times AS List OF Integer = []
  MUT checksum AS Integer = 0
  FOR r = 0 TO run - 1
    LET t0 AS Integer = datetime::monotonicNanos()
    MUT rec AS RecSetFixed = RecSetFixed[1, base, 2]
    MUT cnt AS Integer = 0
    FOR i = 0 TO 300 - 1
      LET cur AS Set OF Integer = rec.xs
      rec = WITH rec { xs := collections::remove(cur, i) }
      cnt = cnt + 1
    NEXT
    checksum = cnt
    LET t1 AS Integer = datetime::monotonicNanos()
    times = collections::append(times, t1 - t0)
  NEXT
  io::printError("test_srf_remove = " & toString(checksum))
  RETURN collections::append(tests, makeResult("set (Record-Fixed)", "remove", times))
END FUNC

FUNC test_srf_contains(run AS Integer, tests AS List OF BenchResult) AS List OF BenchResult
  LET rec AS RecSetFixed = RecSetFixed[1, buildSetRange(1000), 2]
  MUT times AS List OF Integer = []
  MUT checksum AS Integer = 0
  FOR r = 0 TO run - 1
    LET t0 AS Integer = datetime::monotonicNanos()
    LET base AS Set OF Integer = rec.xs
    MUT acc AS Integer = 0
    FOR k = 0 TO 100 - 1
      FOR i = 0 TO 1000 - 1
        IF collections::contains(base, i) THEN
          acc = acc + 1
        END IF
      NEXT
    NEXT
    checksum = acc
    LET t1 AS Integer = datetime::monotonicNanos()
    times = collections::append(times, t1 - t0)
  NEXT
  io::printError("test_srf_contains = " & toString(checksum))
  RETURN collections::append(tests, makeResult("set (Record-Fixed)", "contains", times))
END FUNC

