' ===========================================================================
' GROUP: set (State-Dynamic)
' ===========================================================================

FUNC test_ssd_add(run AS Integer, tests AS List OF BenchResult) AS List OF BenchResult
  LET stPath AS String = fs::pathJoin([fs::tempDirectory(), "bench_test_ssd_add.tmp"])
  RES f AS File STATE RecSetDyn = fs::open(stPath, "write")
  fs::deleteFile(stPath)
  MUT times AS List OF Integer = []
  MUT checksum AS Integer = 0
  FOR r = 0 TO run - 1
    LET t0 AS Integer = datetime::monotonicNanos()
    f.state.xs = Set OF String { }
    FOR i = 0 TO 400 - 1
      f.state.xs = collections::add(f.state.xs, "s" & toString(i))
    NEXT
    checksum = len(f.state.xs)
    LET t1 AS Integer = datetime::monotonicNanos()
    times = collections::append(times, t1 - t0)
  NEXT
  io::printError("test_ssd_add = " & toString(checksum))
  RETURN collections::append(tests, makeResult("set (State-Dynamic)", "add", times))
END FUNC

FUNC test_ssd_remove(run AS Integer, tests AS List OF BenchResult) AS List OF BenchResult
  LET stPath AS String = fs::pathJoin([fs::tempDirectory(), "bench_test_ssd_remove.tmp"])
  RES f AS File STATE RecSetDyn = fs::open(stPath, "write")
  fs::deleteFile(stPath)
  LET base = buildStrSetRange(400)
  MUT times AS List OF Integer = []
  MUT checksum AS Integer = 0
  FOR r = 0 TO run - 1
    LET t0 AS Integer = datetime::monotonicNanos()
    f.state.xs = base
    MUT cnt AS Integer = 0
    FOR i = 0 TO 400 - 1
      LET cur AS Set OF String = f.state.xs
      f.state.xs = collections::remove(cur, "s" & toString(i))
      cnt = cnt + 1
    NEXT
    checksum = cnt
    LET t1 AS Integer = datetime::monotonicNanos()
    times = collections::append(times, t1 - t0)
  NEXT
  io::printError("test_ssd_remove = " & toString(checksum))
  RETURN collections::append(tests, makeResult("set (State-Dynamic)", "remove", times))
END FUNC

FUNC test_ssd_contains(run AS Integer, tests AS List OF BenchResult) AS List OF BenchResult
  LET stPath AS String = fs::pathJoin([fs::tempDirectory(), "bench_test_ssd_contains.tmp"])
  RES f AS File STATE RecSetDyn = fs::open(stPath, "write")
  fs::deleteFile(stPath)
  f.state.xs = buildStrSetRange(200)
  MUT times AS List OF Integer = []
  MUT checksum AS Integer = 0
  FOR r = 0 TO run - 1
    LET t0 AS Integer = datetime::monotonicNanos()
    LET base AS Set OF String = f.state.xs
    MUT acc AS Integer = 0
    FOR k = 0 TO 50 - 1
      FOR i = 0 TO 200 - 1
        IF collections::contains(base, "s" & toString(i)) THEN
          acc = acc + 1
        END IF
      NEXT
    NEXT
    checksum = acc
    LET t1 AS Integer = datetime::monotonicNanos()
    times = collections::append(times, t1 - t0)
  NEXT
  io::printError("test_ssd_contains = " & toString(checksum))
  RETURN collections::append(tests, makeResult("set (State-Dynamic)", "contains", times))
END FUNC

