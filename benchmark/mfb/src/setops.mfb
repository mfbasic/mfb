FUNC test_srf_toSet(run AS Integer, tests AS List OF BenchResult) AS List OF BenchResult
  LET rec AS RecSetFixed = RecSetFixed[1, buildSetRange(300), 2]
  MUT times AS List OF Integer = []
  MUT checksum AS Integer = 0
  FOR r = 0 TO run - 1
    LET t0 AS Integer = datetime::monotonicNanos()
    LET base AS Set OF Integer = rec.xs
    MUT acc AS Integer = 0
    FOR k = 0 TO 20 - 1
      acc = acc + len(collections::toSet(collections::toList(base)))
