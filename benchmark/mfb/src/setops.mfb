  MUT times AS List OF Integer = []
  MUT checksum AS Integer = 0
  FOR r = 0 TO run - 1
    LET t0 AS Integer = datetime::monotonicNanos()
    MUT rec AS RecSetDyn = RecSetDyn[1, Set OF String { }, 2]
    FOR i = 0 TO 400 - 1
      rec = WITH rec { xs := collections::add(rec.xs, "s" & toString(i)) }
    NEXT
    checksum = len(rec.xs)
    LET t1 AS Integer = datetime::monotonicNanos()
    times = collections::append(times, t1 - t0)
  NEXT
  io::printError("test_srd_add = " & toString(checksum))
  RETURN collections::append(tests, makeResult("set (Record-Dynamic)", "add", times))
END FUNC

FUNC test_srd_remove(run AS Integer, tests AS List OF BenchResult) AS List OF BenchResult
