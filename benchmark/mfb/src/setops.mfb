  NEXT
  io::printError("test_srf_toSet = " & toString(checksum))
  RETURN collections::append(tests, makeResult("set (Record-Fixed)", "toSet", times))
END FUNC

FUNC test_srf_union(run AS Integer, tests AS List OF BenchResult) AS List OF BenchResult
  LET rec AS RecSetFixed = RecSetFixed[1, buildSetRange(300), 2]
  LET other AS Set OF Integer = buildSetShift(300, 150)
  MUT times AS List OF Integer = []
  MUT checksum AS Integer = 0
  FOR r = 0 TO run - 1
    LET t0 AS Integer = datetime::monotonicNanos()
    LET base AS Set OF Integer = rec.xs
    MUT acc AS Integer = 0
    FOR k = 0 TO 20 - 1
      acc = acc + len(collections::union(base, other))
    NEXT
