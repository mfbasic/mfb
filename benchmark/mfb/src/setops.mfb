FUNC test_ssf_isSubset(run AS Integer, tests AS List OF BenchResult) AS List OF BenchResult
  LET stPath AS String = fs::pathJoin([fs::tempDirectory(), "bench_test_ssf_isSubset.tmp"])
  RES f AS File STATE RecSetFixed = fs::open(stPath, "write")
  fs::deleteFile(stPath)
  f.state.xs = buildSetRange(1000)
  LET other AS Set OF Integer = buildSetShift(1000, 500)
  MUT times AS List OF Integer = []
  MUT checksum AS Integer = 0
  FOR r = 0 TO run - 1
    LET t0 AS Integer = datetime::monotonicNanos()
    LET base AS Set OF Integer = f.state.xs
    MUT acc AS Integer = 0
    FOR k = 0 TO 300 - 1
      IF collections::isSubset(base, other) THEN
        acc = acc + 1
      END IF
    NEXT
    checksum = acc
    LET t1 AS Integer = datetime::monotonicNanos()
    times = collections::append(times, t1 - t0)
  NEXT
  io::printError("test_ssf_isSubset = " & toString(checksum))
  RETURN collections::append(tests, makeResult("set (State-Fixed)", "isSubset", times))
END FUNC

