' ---------------------------------------------------------------------------
' json_schema/validate.mfb -- the evaluator.
'
' One function per group of keywords, all sharing one `Outcome`: the errors
' an evaluation found, the annotations it collected, and what is left of the
' evaluation budget. Annotations are not a side channel --
' `unevaluatedProperties` and `unevaluatedItems` are defined in terms of them,
' so they are carried in the same value the errors are, and they obey the same
' rule the specification gives: a subschema contributes its annotations only
' when it VALIDATED.
'
' The one distinction that shapes every merge here is in-place versus child
' application. An in-place applicator (`$ref`, `$dynamicRef`, `allOf`, `anyOf`,
' `oneOf`, `if`/`then`/`else`, `dependentSchemas`) applies a subschema to the
' SAME instance, so its annotations describe the same value and merge into this
' one's. A child applicator (`properties`, `items`, `contains`, ...) applies a
' subschema to a MEMBER, so its annotations describe a different value and must
' not: merging them would make `unevaluatedProperties` at an array's schema
' believe an object member's properties had been evaluated.
'
' Loops over the instance's members or items, and over a schema's branches,
' collect their errors in a local list rather than through a record field. A
' field append copies the whole list every time, so a schema with one error per
' item costs the square of the item count; a local list is appended in place.
'
' Every subschema is named by its location (core.mfb). `scopes` is the dynamic
' scope: the schema resources entered on the way to the current subschema, from
' the outermost in. A `$dynamicRef` searches it for a `$dynamicAnchor`.
' ---------------------------------------------------------------------------

IMPORT json
IMPORT collections
IMPORT strings
IMPORT regex
IMPORT math

' One reason an instance is not valid against a schema.
EXPORT TYPE ValidationError
  ' The keyword that rejected the instance: "type", "required", "$ref", and so
  ' on. "false" is the boolean schema `false`, which rejects everything.
  keyword AS String
  ' A JSON Pointer to the part of the INSTANCE that was rejected. "" is the
  ' whole instance.
  instancePath AS String
  ' Where the rejecting keyword lives in the compiled schemas: a JSON Pointer
  ' into the main document, or, for a registered document, its key and a
  ' JSON Pointer ("http://example.test/r.json#/$defs/a"). A failure inside a
  ' `$ref` reports where the failing keyword actually lives, not where the
  ' reference was written.
  schemaPath AS String
  ' A sentence naming what was expected and what was found.
  message AS String
END TYPE

' What one subschema evaluation produced.
PRIVATE TYPE Outcome
  ' The errors this evaluation found, and only those.
  errors AS List OF ValidationError
  ' The names of the instance object's properties this evaluation applied a
  ' subschema to -- the `properties`/`patternProperties`/`additionalProperties`
  ' annotation `unevaluatedProperties` subtracts from.
  props AS Set OF String
  ' The indexes of the instance array's items this evaluation applied a
  ' subschema to -- the `prefixItems`/`items`/`contains` annotation
  ' `unevaluatedItems` subtracts from. Indexes rather than a count, because
  ' `contains` evaluates the items that MATCH, which need not be a prefix.
  slots AS Set OF Integer
  ' What is left of the evaluation budget. Counting DOWN rather than up is what
  ' lets the limit stay out of every signature: an outcome carries how much
  ' work may still be done, not how much has been done against a limit only the
  ' caller knows.
  budget AS Integer
END TYPE

' ---------------------------------------------------------------------------
' Outcome plumbing.
' ---------------------------------------------------------------------------

PRIVATE FUNC pass(budget AS Integer) AS Outcome
  MUT empty AS List OF ValidationError = []
  RETURN Outcome[errors := empty, props := Set OF String {}, slots := Set OF Integer {}, budget := budget]
END FUNC

PRIVATE FUNC valid(outcome AS Outcome) AS Boolean
  RETURN len(outcome.errors) = 0
END FUNC

PRIVATE FUNC problemAt(keyword AS String, instancePath AS String, schemaLocation AS String, message AS String) AS ValidationError
  RETURN ValidationError[keyword := keyword, instancePath := instancePath, schemaPath := schemaPathOf(schemaLocation), message := message]
END FUNC

PRIVATE FUNC addError(state AS Outcome, keyword AS String, instancePath AS String, schemaLocation AS String, message AS String) AS Outcome
  RETURN WITH state { errors := collections::append(state.errors, problemAt(keyword, instancePath, schemaLocation, message)) }
END FUNC

' Take an IN-PLACE subschema's result: its cost always, its errors when the
' caller wants them, and its annotations only when it validated.
PRIVATE FUNC absorbInPlace(state AS Outcome, part AS Outcome, keepErrors AS Boolean) AS Outcome
  MUT errors AS List OF ValidationError = state.errors
  IF keepErrors THEN
    FOR EACH problem IN part.errors
      errors = collections::append(errors, problem)
    NEXT
  END IF
  IF valid(part) THEN
    RETURN Outcome[errors := errors, props := collections::union(state.props, part.props), slots := collections::union(state.slots, part.slots), budget := part.budget]
  END IF
  RETURN Outcome[errors := errors, props := state.props, slots := state.slots, budget := part.budget]
END FUNC

' Concatenate two outcomes: the errors of both, the annotations of both, and the
' budget the second one left.
PRIVATE FUNC joined(first AS Outcome, second AS Outcome) AS Outcome
  MUT errors AS List OF ValidationError = first.errors
  FOR EACH problem IN second.errors
    errors = collections::append(errors, problem)
  NEXT
  RETURN Outcome[errors := errors, props := collections::union(first.props, second.props), slots := collections::union(first.slots, second.slots), budget := second.budget]
END FUNC

' The truth value of a boolean schema node.
PRIVATE FUNC boolValue(node AS json::Json) AS Boolean
  MATCH node
    CASE json::JsonBool(flag) : RETURN flag.value
    CASE ELSE : RETURN FALSE
  END MATCH
END FUNC

' ---------------------------------------------------------------------------
' The entry point.
' ---------------------------------------------------------------------------

' Validate `instance` against the subschema at `location`.
'
' `active` is the stack of (subschema, instance location) pairs currently being
' evaluated. A `$ref` that re-enters a pair already on it has closed a loop
' with no progress on either side and can never terminate, so it fails rather
' than recursing until the depth limit -- a distinct, honest diagnosis.
'
' `scopes` is the dynamic scope: the resource locations entered on the way here.
' A resource root -- a document's root, or a subschema with an `$id` -- joins it.
PRIVATE FUNC evalSchema(schema AS Schema, node AS json::Json, location AS String, instance AS json::Json, instancePath AS String, active AS List OF String, scopes AS List OF String, depth AS Integer, budget AS Integer) AS Outcome
  checkDepth(depth)
  LET remaining AS Integer = spend(budget)

  ' A boolean schema: `true` accepts everything and `false` rejects everything.
  IF kindOf(node) = "boolean" THEN
    IF boolValue(node) THEN RETURN pass(remaining)
    RETURN addError(pass(remaining), "false", instancePath, location, "the schema `false` rejects every instance")
  END IF

  LET entered AS List OF String = enteringScope(node, location, scopes)

  ' The order matters: `unevaluatedProperties` and `unevaluatedItems` are
  ' defined against what every keyword above them has already evaluated.
  MUT out AS Outcome = evalInPlace(schema, node, location, instance, instancePath, active, entered, depth, remaining)
  out = joined(out, evalAssertions(schema, node, location, instance, instancePath, out.budget))
  out = joined(out, evalChildren(schema, node, location, instance, instancePath, active, entered, depth, out.budget))
  out = joined(out, evalUnevaluated(schema, node, location, instance, instancePath, active, entered, depth, out))
  RETURN out
END FUNC

' The dynamic scope on the way into a subschema: a resource root joins it.
PRIVATE FUNC enteringScope(node AS json::Json, location AS String, scopes AS List OF String) AS List OF String
  IF locationPointer(location) = "" OR hasMember(node, "$id") THEN
    RETURN enteringResource(scopes, location)
  END IF
  RETURN scopes
END FUNC

' The dynamic scope with `resource` entered. A resource already in it is not
' entered twice: the outermost occurrence is the one a search finds first.
PRIVATE FUNC enteringResource(scopes AS List OF String, resource AS String) AS List OF String
  IF collections::contains(scopes, resource) THEN RETURN scopes
  RETURN collections::append(scopes, resource)
END FUNC

' ---------------------------------------------------------------------------
' In-place applicators.
' ---------------------------------------------------------------------------

' Evaluate every subschema in a list against the same instance. Each branch
' contributes its errors, and its annotations only when it validated. Errors
' accumulate in one local list, so the cost is linear in the branches.
PRIVATE FUNC evalAll(schema AS Schema, subschemas AS List OF json::Json, locations AS List OF String, instance AS json::Json, instancePath AS String, active AS List OF String, scopes AS List OF String, depth AS Integer, budget AS Integer) AS Outcome
  MUT errors AS List OF ValidationError = []
  MUT props AS Set OF String = Set OF String {}
  MUT slots AS Set OF Integer = Set OF Integer {}
  MUT remaining AS Integer = budget
  MUT i AS Integer = 0
  WHILE i < len(subschemas)
    LET part AS Outcome = evalSchema(schema, collections::get(subschemas, i), collections::get(locations, i), instance, instancePath, active, scopes, depth + 1, remaining)
    FOR EACH problem IN part.errors
      errors = collections::append(errors, problem)
    NEXT
    IF valid(part) THEN
      props = collections::union(props, part.props)
      slots = collections::union(slots, part.slots)
    END IF
    remaining = part.budget
    i = i + 1
  END WHILE
  RETURN Outcome[errors := errors, props := props, slots := slots, budget := remaining]
END FUNC

' The locations of `count` elements, one per index, under `at`.
PRIVATE FUNC indexLocations(at AS String, count AS Integer) AS List OF String
  MUT out AS List OF String = []
  MUT i AS Integer = 0
  WHILE i < count
    out = collections::append(out, pointerIndex(at, i))
    i = i + 1
  END WHILE
  RETURN out
END FUNC

' `anyOf`: at least one branch must validate. The annotations of every branch
' that validated are kept; the errors of the branches are reported only when
' none did.
PRIVATE FUNC evalAnyOf(schema AS Schema, node AS json::Json, location AS String, instance AS json::Json, instancePath AS String, active AS List OF String, scopes AS List OF String, depth AS Integer, budget AS Integer) AS Outcome
  LET at AS String = pointerAppend(location, "anyOf")
  LET branches AS List OF json::Json = itemsOf(member(node, "anyOf"))
  MUT errors AS List OF ValidationError = []
  MUT reasons AS List OF ValidationError = []
  MUT props AS Set OF String = Set OF String {}
  MUT slots AS Set OF Integer = Set OF Integer {}
  MUT matched AS Boolean = FALSE
  MUT remaining AS Integer = budget
  MUT i AS Integer = 0
  WHILE i < len(branches)
    LET part AS Outcome = evalSchema(schema, collections::get(branches, i), pointerIndex(at, i), instance, instancePath, active, scopes, depth + 1, remaining)
    remaining = part.budget
    IF valid(part) THEN
      matched = TRUE
      props = collections::union(props, part.props)
      slots = collections::union(slots, part.slots)
    ELSE
      FOR EACH problem IN part.errors
        reasons = collections::append(reasons, problem)
      NEXT
    END IF
    i = i + 1
  END WHILE
  IF matched THEN RETURN Outcome[errors := errors, props := props, slots := slots, budget := remaining]
  FOR EACH problem IN reasons
    errors = collections::append(errors, problem)
  NEXT
  errors = collections::append(errors, problemAt("anyOf", instancePath, at, "the instance matches none of the " & toString(len(branches)) & " subschemas"))
  RETURN Outcome[errors := errors, props := Set OF String {}, slots := Set OF Integer {}, budget := remaining]
END FUNC

' `oneOf`: exactly one branch must validate. Only that branch's annotations are
' kept, and a branch that does not validate contributes nothing but its reason.
PRIVATE FUNC evalOneOf(schema AS Schema, node AS json::Json, location AS String, instance AS json::Json, instancePath AS String, active AS List OF String, scopes AS List OF String, depth AS Integer, budget AS Integer) AS Outcome
  LET at AS String = pointerAppend(location, "oneOf")
  LET branches AS List OF json::Json = itemsOf(member(node, "oneOf"))
  MUT reasons AS List OF ValidationError = []
  MUT hits AS List OF String = []
  MUT props AS Set OF String = Set OF String {}
  MUT slots AS Set OF Integer = Set OF Integer {}
  MUT remaining AS Integer = budget
  MUT i AS Integer = 0
  WHILE i < len(branches)
    LET part AS Outcome = evalSchema(schema, collections::get(branches, i), pointerIndex(at, i), instance, instancePath, active, scopes, depth + 1, remaining)
    remaining = part.budget
    IF valid(part) THEN
      hits = collections::append(hits, toString(i))
      props = collections::union(props, part.props)
      slots = collections::union(slots, part.slots)
    ELSE
      FOR EACH problem IN part.errors
        reasons = collections::append(reasons, problem)
      NEXT
    END IF
    i = i + 1
  END WHILE

  IF len(hits) = 1 THEN
    ' Exactly one branch validated, so the annotations collected are its own.
    MUT none AS List OF ValidationError = []
    RETURN Outcome[errors := none, props := props, slots := slots, budget := remaining]
  END IF
  MUT errors AS List OF ValidationError = []
  IF len(hits) = 0 THEN
    FOR EACH problem IN reasons
      errors = collections::append(errors, problem)
    NEXT
    errors = collections::append(errors, problemAt("oneOf", instancePath, at, "the instance matches none of the " & toString(len(branches)) & " subschemas, and must match exactly one"))
  ELSE
    errors = collections::append(errors, problemAt("oneOf", instancePath, at, "the instance matches subschemas " & strings::join(hits, ", ") & ", and must match exactly one"))
  END IF
  RETURN Outcome[errors := errors, props := Set OF String {}, slots := Set OF Integer {}, budget := remaining]
END FUNC

' The target of a reference keyword at `key`, which names `target` as compiled.
' A `$dynamicRef` whose target is a `$dynamicAnchor` is redirected to the
' outermost resource in the dynamic scope that declares an anchor of that name.
PRIVATE FUNC referenceTarget(schema AS Schema, key AS String, target AS String, scopes AS List OF String) AS String
  IF NOT collections::hasKey(schema.dynamicRefs, key) THEN RETURN target
  LET name AS String = collections::get(schema.dynamicRefs, key)
  LET named AS json::Json = collections::get(schema.targets, target)
  IF NOT hasMember(named, "$dynamicAnchor") THEN RETURN target
  IF stringOf(member(named, "$dynamicAnchor")) <> name THEN RETURN target
  FOR EACH resource IN scopes
    LET candidate AS String = dynamicAnchorKey(resource, name)
    IF collections::hasKey(schema.dynamicAnchors, candidate) THEN
      RETURN collections::get(schema.dynamicAnchors, candidate)
    END IF
  NEXT
  RETURN target
END FUNC

PRIVATE FUNC evalInPlace(schema AS Schema, node AS json::Json, location AS String, instance AS json::Json, instancePath AS String, active AS List OF String, scopes AS List OF String, depth AS Integer, budget AS Integer) AS Outcome
  MUT out AS Outcome = pass(budget)

  FOR EACH keyword IN ["$ref", "$dynamicRef"]
    IF hasMember(node, keyword) THEN
      LET key AS String = pointerAppend(location, keyword)
      LET target AS String = referenceTarget(schema, key, collections::get(schema.refs, key), scopes)
      ' A length prefix makes the pair unambiguous: without it the schema
      ' location "/a" with instance "/b" and the schema location "/a/b" with the
      ' empty instance path would share a key.
      LET cycleKey AS String = toString(len(target)) & ":" & target & instancePath
      IF collections::contains(active, cycleKey) THEN
        FAIL error(ErrorReferenceCycle, "json_schema: the `" & keyword & "` at `" & schemaPathOf(location) & "` re-enters `" & schemaPathOf(target) & "` at the same instance location `" & instancePath & "`, so evaluation cannot terminate")
      END IF
      LET referenced AS json::Json = collections::get(schema.targets, target)
      ' A reference can name a location inside a resource without entering its
      ' root, and the dynamic scope still contains that resource.
      LET reachedScopes AS List OF String = enteringResource(scopes, collections::get(schema.containers, target))
      out = absorbInPlace(out, evalSchema(schema, referenced, target, instance, instancePath, collections::append(active, cycleKey), reachedScopes, depth + 1, out.budget), TRUE)
    END IF
  NEXT

  IF hasMember(node, "allOf") THEN
    LET branches AS List OF json::Json = itemsOf(member(node, "allOf"))
    out = joined(out, evalAll(schema, branches, indexLocations(pointerAppend(location, "allOf"), len(branches)), instance, instancePath, active, scopes, depth, out.budget))
  END IF

  IF hasMember(node, "anyOf") THEN
    out = joined(out, evalAnyOf(schema, node, location, instance, instancePath, active, scopes, depth, out.budget))
  END IF

  IF hasMember(node, "oneOf") THEN
    out = joined(out, evalOneOf(schema, node, location, instance, instancePath, active, scopes, depth, out.budget))
  END IF

  IF hasMember(node, "not") THEN
    LET at AS String = pointerAppend(location, "not")
    LET part AS Outcome = evalSchema(schema, member(node, "not"), at, instance, instancePath, active, scopes, depth + 1, out.budget)
    out = WITH out { budget := part.budget }
    IF valid(part) THEN
      out = addError(out, "not", instancePath, at, "the instance matches the subschema it must not match")
    END IF
  END IF

  IF hasMember(node, "if") THEN
    LET at AS String = pointerAppend(location, "if")
    LET condition AS Outcome = evalSchema(schema, member(node, "if"), at, instance, instancePath, active, scopes, depth + 1, out.budget)
    ' `if` never contributes an error: its whole job is to select a branch.
    out = absorbInPlace(out, condition, FALSE)
    MUT branch AS String = "else"
    IF valid(condition) THEN branch = "then"
    IF hasMember(node, branch) THEN
      LET taken AS String = pointerAppend(location, branch)
      out = absorbInPlace(out, evalSchema(schema, member(node, branch), taken, instance, instancePath, active, scopes, depth + 1, out.budget), TRUE)
    END IF
  END IF

  IF hasMember(node, "dependentSchemas") AND isObject(instance) THEN
    LET at AS String = pointerAppend(location, "dependentSchemas")
    LET fields AS Map OF String TO json::Json = fieldsOf(instance)
    MUT subschemas AS List OF json::Json = []
    MUT locations AS List OF String = []
    FOR EACH entry IN fieldsOf(member(node, "dependentSchemas"))
      IF collections::hasKey(fields, entry.key) THEN
        subschemas = collections::append(subschemas, entry.value)
        locations = collections::append(locations, pointerAppend(at, entry.key))
      END IF
    NEXT
    out = joined(out, evalAll(schema, subschemas, locations, instance, instancePath, active, scopes, depth, out.budget))
  END IF

  RETURN out
END FUNC

' ---------------------------------------------------------------------------
' Assertions: the keywords that inspect the instance directly.
' ---------------------------------------------------------------------------

PRIVATE FUNC evalAssertions(schema AS Schema, node AS json::Json, location AS String, instance AS json::Json, instancePath AS String, budget AS Integer) AS Outcome
  MUT out AS Outcome = pass(budget)
  LET actual AS String = kindOf(instance)

  IF hasMember(node, "type") THEN
    IF NOT typeMatches(member(node, "type"), instance) THEN
      out = addError(out, "type", instancePath, pointerAppend(location, "type"), "expected " & typeWanted(member(node, "type")) & ", found " & describeInstance(instance))
    END IF
  END IF

  IF hasMember(node, "const") THEN
    IF NOT deepEqual(instance, member(node, "const")) THEN
      out = addError(out, "const", instancePath, pointerAppend(location, "const"), "expected the constant " & json::stringify(member(node, "const")) & ", found " & describeInstance(instance))
    END IF
  END IF

  IF hasMember(node, "enum") THEN
    MUT found AS Boolean = FALSE
    FOR EACH allowed IN itemsOf(member(node, "enum"))
      IF deepEqual(instance, allowed) THEN found = TRUE
    NEXT
    IF NOT found THEN
      out = addError(out, "enum", instancePath, pointerAppend(location, "enum"), "expected one of " & json::stringify(member(node, "enum")) & ", found " & describeInstance(instance))
    END IF
  END IF

  IF actual = "number" THEN out = evalNumber(node, location, numberOf(instance), instancePath, out)
  IF actual = "string" THEN out = evalString(schema.patterns, node, location, stringOf(instance), instancePath, out)
  IF actual = "array" THEN out = evalArraySize(node, location, itemsOf(instance), instancePath, out)
  IF actual = "object" THEN out = evalObjectSize(node, location, fieldsOf(instance), instancePath, out)

  RETURN out
END FUNC

PRIVATE FUNC evalNumber(node AS json::Json, location AS String, value AS Float, instancePath AS String, state AS Outcome) AS Outcome
  MUT out AS Outcome = state

  IF hasMember(node, "multipleOf") THEN
    LET factor AS Float = numberOf(member(node, "multipleOf"))
    IF NOT decimalMultiple(value, factor) THEN
      out = addError(out, "multipleOf", instancePath, pointerAppend(location, "multipleOf"), "expected a multiple of " & showNumber(factor) & ", found " & showNumber(value))
    END IF
  END IF

  IF hasMember(node, "maximum") THEN
    LET bound AS Float = numberOf(member(node, "maximum"))
    IF value > bound THEN
      out = addError(out, "maximum", instancePath, pointerAppend(location, "maximum"), "expected at most " & showNumber(bound) & ", found " & showNumber(value))
    END IF
  END IF

  IF hasMember(node, "exclusiveMaximum") THEN
    LET bound AS Float = numberOf(member(node, "exclusiveMaximum"))
    IF value >= bound THEN
      out = addError(out, "exclusiveMaximum", instancePath, pointerAppend(location, "exclusiveMaximum"), "expected less than " & showNumber(bound) & ", found " & showNumber(value))
    END IF
  END IF

  IF hasMember(node, "minimum") THEN
    LET bound AS Float = numberOf(member(node, "minimum"))
    IF value < bound THEN
      out = addError(out, "minimum", instancePath, pointerAppend(location, "minimum"), "expected at least " & showNumber(bound) & ", found " & showNumber(value))
    END IF
  END IF

  IF hasMember(node, "exclusiveMinimum") THEN
    LET bound AS Float = numberOf(member(node, "exclusiveMinimum"))
    IF value <= bound THEN
      out = addError(out, "exclusiveMinimum", instancePath, pointerAppend(location, "exclusiveMinimum"), "expected more than " & showNumber(bound) & ", found " & showNumber(value))
    END IF
  END IF

  RETURN out
END FUNC

PRIVATE FUNC evalString(patterns AS Map OF String TO String, node AS json::Json, location AS String, value AS String, instancePath AS String, state AS Outcome) AS Outcome
  MUT out AS Outcome = state
  ' `len` on a String counts Unicode scalars, which is what JSON Schema means
  ' by a string's length -- code points, not UTF-8 bytes and not UTF-16 units.
  LET size AS Integer = len(value)

  IF hasMember(node, "minLength") THEN
    LET bound AS Float = numberOf(member(node, "minLength"))
    IF size < bound THEN
      out = addError(out, "minLength", instancePath, pointerAppend(location, "minLength"), "expected at least " & showNumber(bound) & " characters, found " & toString(size))
    END IF
  END IF

  IF hasMember(node, "maxLength") THEN
    LET bound AS Float = numberOf(member(node, "maxLength"))
    IF size > bound THEN
      out = addError(out, "maxLength", instancePath, pointerAppend(location, "maxLength"), "expected at most " & showNumber(bound) & " characters, found " & toString(size))
    END IF
  END IF

  IF hasMember(node, "pattern") THEN
    LET source AS String = stringOf(member(node, "pattern"))
    IF NOT regex::match(value, collections::get(patterns, source)) THEN
      out = addError(out, "pattern", instancePath, pointerAppend(location, "pattern"), "expected a match for /" & source & "/, found " & json::stringify(json::JsonStr[value]))
    END IF
  END IF

  RETURN out
END FUNC

PRIVATE FUNC evalArraySize(node AS json::Json, location AS String, items AS List OF json::Json, instancePath AS String, state AS Outcome) AS Outcome
  MUT out AS Outcome = state
  LET size AS Integer = len(items)

  IF hasMember(node, "minItems") THEN
    LET bound AS Float = numberOf(member(node, "minItems"))
    IF size < bound THEN
      out = addError(out, "minItems", instancePath, pointerAppend(location, "minItems"), "expected at least " & showNumber(bound) & " items, found " & toString(size))
    END IF
  END IF

  IF hasMember(node, "maxItems") THEN
    LET bound AS Float = numberOf(member(node, "maxItems"))
    IF size > bound THEN
      out = addError(out, "maxItems", instancePath, pointerAppend(location, "maxItems"), "expected at most " & showNumber(bound) & " items, found " & toString(size))
    END IF
  END IF

  IF hasMember(node, "uniqueItems") AND boolValue(member(node, "uniqueItems")) THEN
    ' Each item's canonical key is looked up once, so the cost is linear in the
    ' array. The pair reported is the one whose first occurrence comes earliest,
    ' with its first later duplicate: the pair a pairwise scan would find first.
    MUT firstAt AS Map OF String TO Integer = Map OF String TO Integer {}
    MUT pairFirst AS Integer = -1
    MUT pairSecond AS Integer = -1
    MUT i AS Integer = 0
    WHILE i < size
      LET key AS String = canonicalKey(collections::get(items, i))
      IF collections::hasKey(firstAt, key) THEN
        LET first AS Integer = collections::get(firstAt, key)
        IF pairFirst < 0 OR first < pairFirst THEN
          pairFirst = first
          pairSecond = i
        END IF
      ELSE
        firstAt = collections::set(firstAt, key, i)
      END IF
      i = i + 1
    END WHILE
    IF pairFirst >= 0 THEN
      out = addError(out, "uniqueItems", instancePath, pointerAppend(location, "uniqueItems"), "items " & toString(pairFirst) & " and " & toString(pairSecond) & " are equal, and every item must be unique")
    END IF
  END IF

  RETURN out
END FUNC

PRIVATE FUNC evalObjectSize(node AS json::Json, location AS String, fields AS Map OF String TO json::Json, instancePath AS String, state AS Outcome) AS Outcome
  MUT out AS Outcome = state
  LET size AS Integer = len(fields)

  IF hasMember(node, "minProperties") THEN
    LET bound AS Float = numberOf(member(node, "minProperties"))
    IF size < bound THEN
      out = addError(out, "minProperties", instancePath, pointerAppend(location, "minProperties"), "expected at least " & showNumber(bound) & " properties, found " & toString(size))
    END IF
  END IF

  IF hasMember(node, "maxProperties") THEN
    LET bound AS Float = numberOf(member(node, "maxProperties"))
    IF size > bound THEN
      out = addError(out, "maxProperties", instancePath, pointerAppend(location, "maxProperties"), "expected at most " & showNumber(bound) & " properties, found " & toString(size))
    END IF
  END IF

  IF hasMember(node, "required") THEN
    FOR EACH wanted IN itemsOf(member(node, "required"))
      LET name AS String = stringOf(wanted)
      IF NOT collections::hasKey(fields, name) THEN
        out = addError(out, "required", instancePath, pointerAppend(location, "required"), "the required property `" & name & "` is missing")
      END IF
    NEXT
  END IF

  IF hasMember(node, "dependentRequired") THEN
    LET at AS String = pointerAppend(location, "dependentRequired")
    FOR EACH entry IN fieldsOf(member(node, "dependentRequired"))
      IF collections::hasKey(fields, entry.key) THEN
        FOR EACH wanted IN itemsOf(entry.value)
          LET name AS String = stringOf(wanted)
          IF NOT collections::hasKey(fields, name) THEN
            out = addError(out, "dependentRequired", instancePath, pointerAppend(at, entry.key), "the property `" & entry.key & "` requires `" & name & "`, which is missing")
          END IF
        NEXT
      END IF
    NEXT
  END IF

  RETURN out
END FUNC

' ---------------------------------------------------------------------------
' `type`.
' ---------------------------------------------------------------------------

PRIVATE FUNC typeMatches(wanted AS json::Json, instance AS json::Json) AS Boolean
  IF isString(wanted) THEN RETURN typeNameMatches(stringOf(wanted), instance)
  FOR EACH name IN itemsOf(wanted)
    IF typeNameMatches(stringOf(name), instance) THEN RETURN TRUE
  NEXT
  RETURN FALSE
END FUNC

' "integer" is not a seventh JSON type: it is "number" plus the requirement
' that the value have no fractional part, so 1.0 is an integer and 1.5 is not.
PRIVATE FUNC typeNameMatches(name AS String, instance AS json::Json) AS Boolean
  LET actual AS String = kindOf(instance)
  IF name = "integer" THEN
    IF actual <> "number" THEN RETURN FALSE
    RETURN isIntegral(numberOf(instance))
  END IF
  RETURN name = actual
END FUNC

PRIVATE FUNC typeWanted(wanted AS json::Json) AS String
  IF isString(wanted) THEN RETURN stringOf(wanted)
  MUT names AS List OF String = []
  FOR EACH name IN itemsOf(wanted)
    names = collections::append(names, stringOf(name))
  NEXT
  RETURN "one of " & strings::join(names, ", ")
END FUNC

' A short rendering of an instance for an error message: its type, and its
' value when the value is small enough to be worth quoting.
PRIVATE FUNC describeInstance(instance AS json::Json) AS String
  LET kind AS String = kindOf(instance)
  IF kind = "array" OR kind = "object" THEN RETURN "an " & kind
  IF kind = "null" THEN RETURN "null"
  RETURN kind & " " & json::stringify(instance)
END FUNC

' ---------------------------------------------------------------------------
' Child applicators.
' ---------------------------------------------------------------------------

PRIVATE FUNC evalChildren(schema AS Schema, node AS json::Json, location AS String, instance AS json::Json, instancePath AS String, active AS List OF String, scopes AS List OF String, depth AS Integer, budget AS Integer) AS Outcome
  LET kind AS String = kindOf(instance)
  IF kind = "object" THEN
    RETURN evalObjectChildren(schema, node, location, instance, instancePath, active, scopes, depth, budget)
  END IF
  IF kind = "array" THEN
    RETURN evalArrayChildren(schema, node, location, instance, instancePath, active, scopes, depth, budget)
  END IF
  RETURN pass(budget)
END FUNC

PRIVATE FUNC evalObjectChildren(schema AS Schema, node AS json::Json, location AS String, instance AS json::Json, instancePath AS String, active AS List OF String, scopes AS List OF String, depth AS Integer, budget AS Integer) AS Outcome
  MUT errors AS List OF ValidationError = []
  MUT evaluated AS Set OF String = Set OF String {}
  MUT remaining AS Integer = budget
  LET members AS Map OF String TO json::Json = fieldsOf(instance)

  IF hasMember(node, "propertyNames") THEN
    LET at AS String = pointerAppend(location, "propertyNames")
    LET rule AS json::Json = member(node, "propertyNames")
    FOR EACH entry IN members
      ' The subschema applies to the NAME, as a string instance. It produces no
      ' annotation: it says nothing about whether the VALUE was evaluated.
      LET asText AS json::Json = json::JsonStr[entry.key]
      LET part AS Outcome = evalSchema(schema, rule, at, asText, pointerAppend(instancePath, entry.key), active, scopes, depth + 1, remaining)
      FOR EACH problem IN part.errors
        errors = collections::append(errors, problem)
      NEXT
      remaining = part.budget
    NEXT
  END IF

  LET hasProperties AS Boolean = hasMember(node, "properties")
  LET hasPatterns AS Boolean = hasMember(node, "patternProperties")
  LET hasAdditional AS Boolean = hasMember(node, "additionalProperties")
  IF NOT hasProperties AND NOT hasPatterns AND NOT hasAdditional THEN
    RETURN Outcome[errors := errors, props := evaluated, slots := Set OF Integer {}, budget := remaining]
  END IF

  ' Read once, outside the loop over the instance: these are the SCHEMA's, and
  ' nothing in the loop changes them.
  MUT declared AS Map OF String TO json::Json = Map OF String TO json::Json {}
  IF hasProperties THEN declared = fieldsOf(member(node, "properties"))
  MUT rules AS Map OF String TO json::Json = Map OF String TO json::Json {}
  IF hasPatterns THEN rules = fieldsOf(member(node, "patternProperties"))
  MUT extra AS json::Json = json::JsonNull[NOTHING]
  IF hasAdditional THEN extra = member(node, "additionalProperties")

  FOR EACH entry IN members
    LET childPath AS String = pointerAppend(instancePath, entry.key)
    MUT covered AS Boolean = FALSE

    IF collections::hasKey(declared, entry.key) THEN
      LET at AS String = pointerAppend(pointerAppend(location, "properties"), entry.key)
      LET part AS Outcome = evalSchema(schema, collections::get(declared, entry.key), at, entry.value, childPath, active, scopes, depth + 1, remaining)
      FOR EACH problem IN part.errors
        errors = collections::append(errors, problem)
      NEXT
      remaining = part.budget
      covered = TRUE
    END IF

    FOR EACH rule IN rules
      IF regex::match(entry.key, collections::get(schema.patterns, rule.key)) THEN
        LET at AS String = pointerAppend(pointerAppend(location, "patternProperties"), rule.key)
        LET part AS Outcome = evalSchema(schema, rule.value, at, entry.value, childPath, active, scopes, depth + 1, remaining)
        FOR EACH problem IN part.errors
          errors = collections::append(errors, problem)
        NEXT
        remaining = part.budget
        covered = TRUE
      END IF
    NEXT

    ' `additionalProperties` is what `properties` and `patternProperties` did
    ' not claim -- so it is asked last, and only about what is left.
    IF NOT covered AND hasAdditional THEN
      LET at AS String = pointerAppend(location, "additionalProperties")
      LET part AS Outcome = evalSchema(schema, extra, at, entry.value, childPath, active, scopes, depth + 1, remaining)
      FOR EACH problem IN part.errors
        errors = collections::append(errors, problem)
      NEXT
      remaining = part.budget
      covered = TRUE
    END IF

    IF covered THEN evaluated = collections::add(evaluated, entry.key)
  NEXT

  RETURN Outcome[errors := errors, props := evaluated, slots := Set OF Integer {}, budget := remaining]
END FUNC

PRIVATE FUNC evalArrayChildren(schema AS Schema, node AS json::Json, location AS String, instance AS json::Json, instancePath AS String, active AS List OF String, scopes AS List OF String, depth AS Integer, budget AS Integer) AS Outcome
  MUT errors AS List OF ValidationError = []
  MUT evaluated AS Set OF Integer = Set OF Integer {}
  MUT remaining AS Integer = budget
  LET items AS List OF json::Json = itemsOf(instance)
  MUT prefixCount AS Integer = 0

  IF hasMember(node, "prefixItems") THEN
    LET at AS String = pointerAppend(location, "prefixItems")
    LET schemas AS List OF json::Json = itemsOf(member(node, "prefixItems"))
    prefixCount = math::min(len(schemas), len(items))
    MUT i AS Integer = 0
    WHILE i < prefixCount
      LET part AS Outcome = evalSchema(schema, collections::get(schemas, i), pointerIndex(at, i), collections::get(items, i), pointerIndex(instancePath, i), active, scopes, depth + 1, remaining)
      FOR EACH problem IN part.errors
        errors = collections::append(errors, problem)
      NEXT
      remaining = part.budget
      evaluated = collections::add(evaluated, i)
      i = i + 1
    END WHILE
  END IF

  IF hasMember(node, "items") THEN
    LET at AS String = pointerAppend(location, "items")
    MUT i AS Integer = prefixCount
    WHILE i < len(items)
      LET part AS Outcome = evalSchema(schema, member(node, "items"), at, collections::get(items, i), pointerIndex(instancePath, i), active, scopes, depth + 1, remaining)
      FOR EACH problem IN part.errors
        errors = collections::append(errors, problem)
      NEXT
      remaining = part.budget
      evaluated = collections::add(evaluated, i)
      i = i + 1
    END WHILE
  END IF

  IF hasMember(node, "contains") THEN
    LET at AS String = pointerAppend(location, "contains")
    MUT hits AS Integer = 0
    MUT i AS Integer = 0
    WHILE i < len(items)
      LET part AS Outcome = evalSchema(schema, member(node, "contains"), at, collections::get(items, i), pointerIndex(instancePath, i), active, scopes, depth + 1, remaining)
      remaining = part.budget
      IF valid(part) THEN
        hits = hits + 1
        evaluated = collections::add(evaluated, i)
      END IF
      i = i + 1
    END WHILE

    MUT least AS Float = 1.0
    IF hasMember(node, "minContains") THEN least = numberOf(member(node, "minContains"))
    IF hits < least THEN
      errors = collections::append(errors, problemAt("contains", instancePath, at, "expected at least " & showNumber(least) & " item(s) matching the subschema, found " & toString(hits)))
    END IF
    IF hasMember(node, "maxContains") THEN
      LET most AS Float = numberOf(member(node, "maxContains"))
      IF hits > most THEN
        errors = collections::append(errors, problemAt("maxContains", instancePath, pointerAppend(location, "maxContains"), "expected at most " & showNumber(most) & " item(s) matching the subschema, found " & toString(hits)))
      END IF
    END IF
  END IF

  RETURN Outcome[errors := errors, props := Set OF String {}, slots := evaluated, budget := remaining]
END FUNC

' ---------------------------------------------------------------------------
' `unevaluatedProperties` and `unevaluatedItems`.
'
' Both run LAST, because both are defined against what every other keyword in
' this schema object -- and every in-place applicator under it -- has already
' annotated as evaluated. `covered` carries those annotations.
' ---------------------------------------------------------------------------

PRIVATE FUNC evalUnevaluated(schema AS Schema, node AS json::Json, location AS String, instance AS json::Json, instancePath AS String, active AS List OF String, scopes AS List OF String, depth AS Integer, covered AS Outcome) AS Outcome
  MUT errors AS List OF ValidationError = []
  MUT props AS Set OF String = Set OF String {}
  MUT slots AS Set OF Integer = Set OF Integer {}
  MUT remaining AS Integer = covered.budget

  IF hasMember(node, "unevaluatedProperties") AND isObject(instance) THEN
    LET at AS String = pointerAppend(location, "unevaluatedProperties")
    FOR EACH entry IN fieldsOf(instance)
      IF NOT collections::contains(covered.props, entry.key) THEN
        LET part AS Outcome = evalSchema(schema, member(node, "unevaluatedProperties"), at, entry.value, pointerAppend(instancePath, entry.key), active, scopes, depth + 1, remaining)
        FOR EACH problem IN part.errors
          errors = collections::append(errors, problem)
        NEXT
        remaining = part.budget
        props = collections::add(props, entry.key)
      END IF
    NEXT
  END IF

  IF hasMember(node, "unevaluatedItems") AND isArray(instance) THEN
    LET at AS String = pointerAppend(location, "unevaluatedItems")
    LET items AS List OF json::Json = itemsOf(instance)
    MUT i AS Integer = 0
    WHILE i < len(items)
      IF NOT collections::contains(covered.slots, i) THEN
        LET part AS Outcome = evalSchema(schema, member(node, "unevaluatedItems"), at, collections::get(items, i), pointerIndex(instancePath, i), active, scopes, depth + 1, remaining)
        FOR EACH problem IN part.errors
          errors = collections::append(errors, problem)
        NEXT
        remaining = part.budget
        slots = collections::add(slots, i)
      END IF
      i = i + 1
    END WHILE
  END IF

  RETURN Outcome[errors := errors, props := props, slots := slots, budget := remaining]
END FUNC

' ---------------------------------------------------------------------------
' The package-internal entry the public API calls.
' ---------------------------------------------------------------------------

PUBLIC FUNC runValidation(compiled AS Schema, instance AS json::Json) AS List OF ValidationError
  MUT empty AS List OF String = []
  LET budget AS Integer = STEP_BASE + STEP_PER_NODE * countNodes(instance)
  LET outcome AS Outcome = evalSchema(compiled, compiled.root, "#", instance, "", empty, empty, 0, budget)
  RETURN outcome.errors
END FUNC
