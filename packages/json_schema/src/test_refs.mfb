' ---------------------------------------------------------------------------
' Tests: identifiers and references -- `$id`, `$anchor`, `$defs` and `$ref` --
' and the two ways a reference can fail: naming nothing, and naming a loop.
' ---------------------------------------------------------------------------

IMPORT json
IMPORT collections
IMPORT strings

PRIVATE FUNC verdict(schemaText AS String, instanceText AS String) AS String
  LET compiled AS Schema = compileSchema(json::parse(schemaText), Map OF String TO json::Json {})
  LET problems AS List OF ValidationError = runValidation(compiled, json::parse(instanceText))
  IF len(problems) = 0 THEN RETURN "valid"
  MUT keywords AS List OF String = []
  FOR EACH problem IN problems
    keywords = collections::append(keywords, problem.keyword)
  NEXT
  RETURN strings::join(keywords, ",")
END FUNC

PRIVATE FUNC ok(schemaText AS String, instanceText AS String) AS Boolean
  RETURN verdict(schemaText, instanceText) = "valid"
END FUNC

PRIVATE FUNC compileWithRegistry(schemaText AS String, known AS Map OF String TO json::Json) AS String
  LET compiled AS Schema = compileSchema(json::parse(schemaText), known)
  RETURN ""
END FUNC

PRIVATE FUNC compileOnly(schemaText AS String) AS String
  LET compiled AS Schema = compileSchema(json::parse(schemaText), Map OF String TO json::Json {})
  RETURN compiled.id
END FUNC

TESTING
  TGROUP "local references"
    TCASE "a pointer fragment names a location in the document"
      expectEqual(ok("{\"$defs\":{\"pos\":{\"type\":\"integer\",\"minimum\":1}},\"$ref\":\"#/$defs/pos\"}", "1"), TRUE)
      expectEqual(ok("{\"$defs\":{\"pos\":{\"type\":\"integer\",\"minimum\":1}},\"$ref\":\"#/$defs/pos\"}", "0"), FALSE)
      expectEqual(ok("{\"$defs\":{\"s\":{\"type\":\"string\"}},\"properties\":{\"a\":{\"$ref\":\"#/$defs/s\"}}}", "{\"a\":\"x\"}"), TRUE)
      expectEqual(ok("{\"$defs\":{\"s\":{\"type\":\"string\"}},\"properties\":{\"a\":{\"$ref\":\"#/$defs/s\"}}}", "{\"a\":1}"), FALSE)
    END TCASE

    TCASE "a pointer may cross an array-valued keyword"
      ' `prefixItems` is the target here only as a place to point AT: it does
      ' not apply to an object, so the root contributes nothing and the case
      ' measures the reference rather than the keyword beside it.
      expectEqual(ok("{\"prefixItems\":[{\"type\":\"integer\"}],\"properties\":{\"a\":{\"$ref\":\"#/prefixItems/0\"}}}", "{\"a\":1}"), TRUE)
      expectEqual(ok("{\"prefixItems\":[{\"type\":\"integer\"}],\"properties\":{\"a\":{\"$ref\":\"#/prefixItems/0\"}}}", "{\"a\":\"x\"}"), FALSE)
    END TCASE

    TCASE "a pointer token is unescaped before it is followed"
      expectEqual(ok("{\"$defs\":{\"a/b\":{\"type\":\"integer\"}},\"$ref\":\"#/$defs/a~1b\"}", "1"), TRUE)
      expectEqual(ok("{\"$defs\":{\"a~b\":{\"type\":\"integer\"}},\"$ref\":\"#/$defs/a~0b\"}", "1"), TRUE)
      ' The same location, spelled with a percent escape.
      expectEqual(ok("{\"$defs\":{\"a/b\":{\"type\":\"integer\"}},\"$ref\":\"#/$defs/a%7E1b\"}", "1"), TRUE)
    END TCASE

    TCASE "a reference applies alongside its siblings, not instead of them"
      expectEqual(ok("{\"$defs\":{\"s\":{\"type\":\"string\"}},\"$ref\":\"#/$defs/s\",\"minLength\":2}", "\"ab\""), TRUE)
      expectEqual(ok("{\"$defs\":{\"s\":{\"type\":\"string\"}},\"$ref\":\"#/$defs/s\",\"minLength\":2}", "\"a\""), FALSE)
    END TCASE

    TCASE "a recursive definition validates a nested instance"
      LET schema AS String = "{\"$defs\":{\"node\":{\"type\":\"object\",\"properties\":{\"child\":{\"$ref\":\"#/$defs/node\"}}}},\"$ref\":\"#/$defs/node\"}"
      expectEqual(ok(schema, "{}"), TRUE)
      expectEqual(ok(schema, "{\"child\":{\"child\":{}}}"), TRUE)
      expectEqual(ok(schema, "{\"child\":1}"), FALSE)
    END TCASE
  END TGROUP

  TGROUP "identifiers"
    TCASE "a root $id becomes the document's base"
      expectString(compileOnly("{\"$id\":\"https://example.com/root\"}"), "https://example.com/root")
      expectString(compileOnly("{}"), "")
    END TCASE

    TCASE "$anchor names a location the base can reach"
      expectEqual(ok("{\"$id\":\"https://example.com/r\",\"$defs\":{\"a\":{\"$anchor\":\"thing\",\"type\":\"integer\"}},\"$ref\":\"#thing\"}", "1"), TRUE)
      expectEqual(ok("{\"$id\":\"https://example.com/r\",\"$defs\":{\"a\":{\"$anchor\":\"thing\",\"type\":\"integer\"}},\"$ref\":\"#thing\"}", "\"x\""), FALSE)
      ' An anchor works without a root `$id` too -- the base is then "".
      expectEqual(ok("{\"$defs\":{\"a\":{\"$anchor\":\"thing\",\"type\":\"integer\"}},\"$ref\":\"#thing\"}", "1"), TRUE)
    END TCASE

    TCASE "a nested $id is a schema resource of its own"
      expectEqual(ok("{\"$id\":\"https://example.com/r\",\"$defs\":{\"a\":{\"$id\":\"child\",\"type\":\"integer\"}},\"$ref\":\"child\"}", "1"), TRUE)
      expectEqual(ok("{\"$id\":\"https://example.com/r\",\"$defs\":{\"a\":{\"$id\":\"child\",\"type\":\"integer\"}},\"$ref\":\"child\"}", "\"x\""), FALSE)
    END TCASE

    TCASE "a nested $id rebases everything beneath it"
      LET schema AS String = "{\"$id\":\"https://example.com/a/b/r\",\"$defs\":{\"a\":{\"$id\":\"../c/leaf\",\"type\":\"string\"}},\"$ref\":\"https://example.com/a/c/leaf\"}"
      expectEqual(ok(schema, "\"x\""), TRUE)
      expectEqual(ok(schema, "1"), FALSE)
    END TCASE

    TCASE "a duplicate identifier is refused"
      expectTrap(compileOnly("{\"$defs\":{\"a\":{\"$id\":\"https://example.com/x\"},\"b\":{\"$id\":\"https://example.com/x\"}}}"), ERR_SCHEMA)
      expectTrap(compileOnly("{\"$defs\":{\"a\":{\"$anchor\":\"n\"},\"b\":{\"$anchor\":\"n\"}}}"), ERR_SCHEMA)
    END TCASE

    TCASE "a root $id is not a duplicate of itself"
      ' The root is registered once by the walk, not once here and once there.
      expectString(compileOnly("{\"$id\":\"https://example.com/r\",\"$defs\":{\"a\":{\"type\":\"integer\"}}}"), "https://example.com/r")
    END TCASE

    TCASE "Draft 2020-12 dropped the plain-name fragment form of $id"
      expectTrap(compileOnly("{\"$id\":\"https://example.com/r#frag\"}"), ERR_SCHEMA)
    END TCASE

    TCASE "an $anchor must be a legal anchor name"
      expectTrap(compileOnly("{\"$anchor\":\"1bad\"}"), ERR_SCHEMA)
      expectTrap(compileOnly("{\"$anchor\":\"has space\"}"), ERR_SCHEMA)
      expectString(compileOnly("{\"$anchor\":\"_ok-1.2\"}"), "")
    END TCASE
  END TGROUP

  TGROUP "references that cannot be followed"
    TCASE "a reference naming nothing fails at compile time"
      expectTrap(compileOnly("{\"$ref\":\"#/$defs/missing\"}"), ERR_REF)
      expectTrap(compileOnly("{\"$ref\":\"#noSuchAnchor\"}"), ERR_REF)
    END TCASE

    TCASE "nothing is retrieved, so an external reference is refused"
      expectTrap(compileOnly("{\"$ref\":\"https://example.com/elsewhere\"}"), ERR_REF)
      expectTrap(compileOnly("{\"$ref\":\"https://example.com/elsewhere\"}"), ERR_REF)
    END TCASE

    TCASE "the Draft 2020-12 metaschema is built in, so a schema can refer to it"
      ' A bundled metaschema, not a retrieved one: it checks a schema document.
      expectString(verdict("{\"$ref\":\"https://json-schema.org/draft/2020-12/schema\"}", "{\"type\":\"string\",\"minLength\":1}"), "valid")
      expectString(verdict("{\"$ref\":\"https://json-schema.org/draft/2020-12/schema\"}", "{\"type\":5}"), "enum,type,anyOf")
    END TCASE

    TCASE "a $defs beside a $ref does not make the reference local"
      ' `#/$defs/t` is a pointer into the schema RESOURCE, so it names the
      ' ROOT's `$defs` and not the neighbouring one.
      expectTrap(compileOnly("{\"properties\":{\"x\":{\"$defs\":{\"t\":true},\"$ref\":\"#/$defs/t\"}}}"), ERR_REF)
    END TCASE

    TCASE "a reference loop with no instance progress is refused"
      LET schema AS String = "{\"$defs\":{\"loop\":{\"$ref\":\"#/$defs/loop\"}},\"$ref\":\"#/$defs/loop\"}"
      expectTrap(ok(schema, "1"), ErrorReferenceCycle)
    END TCASE

    TCASE "a 2019-09 recursive reference is refused by name"
      expectTrap(compileOnly("{\"$recursiveRef\":\"#\"}"), ERR_UNSUPPORTED)
      expectTrap(compileOnly("{\"$recursiveAnchor\":true}"), ERR_UNSUPPORTED)
    END TCASE

    TCASE "a dynamic reference names an anchor in the document, or it is refused"
      expectTrap(compileOnly("{\"$dynamicRef\":\"#missing\"}"), ERR_REF)
      expectTrap(compileOnly("{\"$dynamicAnchor\":\"bad name\"}"), ERR_SCHEMA)
    END TCASE

    TCASE "a dynamic reference with no dynamic anchor behaves as a plain reference"
      LET schema AS String = "{\"$defs\":{\"a\":{\"$anchor\":\"t\",\"type\":\"string\"}},\"$dynamicRef\":\"#t\"}"
      expectString(verdict(schema, "\"ok\""), "valid")
      expectString(verdict(schema, "5"), "type")
    END TCASE

    TCASE "a dynamic reference is redirected to the outermost dynamic anchor in scope"
      ' The inner resource's `$dynamicRef` would reach the inner root, but the
      ' outer resource declares the same dynamic anchor and is outermost, so the
      ' recursion is validated against the outer root, which requires `id`.
      LET schema AS String = "{\"$id\":\"https://ex.test/outer\",\"$dynamicAnchor\":\"meta\",\"required\":[\"id\"],\"$defs\":{\"inner\":{\"$id\":\"https://ex.test/inner\",\"$dynamicAnchor\":\"meta\",\"type\":\"object\",\"properties\":{\"v\":{\"$dynamicRef\":\"#meta\"}}}},\"properties\":{\"w\":{\"$ref\":\"#/$defs/inner\"}}}"
      expectString(verdict(schema, "{\"id\":0,\"w\":{\"v\":{}}}"), "required")
      expectString(verdict(schema, "{\"id\":0,\"w\":{\"v\":{\"id\":1}}}"), "valid")
    END TCASE

    TCASE "a reference may name a registered document, and nothing else is retrieved"
      MUT known AS Map OF String TO json::Json = Map OF String TO json::Json {}
      known = collections::set(known, "https://ex.test/money.json", json::parse("{\"$defs\":{\"c\":{\"type\":\"integer\"}}}"))
      LET compiled AS Schema = compileSchema(json::parse("{\"$ref\":\"https://ex.test/money.json#/$defs/c\"}"), known)
      expectEqual(len(runValidation(compiled, json::parse("1"))), 0)
      expectEqual(len(runValidation(compiled, json::parse("\"x\""))), 1)
      expectTrap(compileOnly("{\"$ref\":\"https://ex.test/money.json\"}"), ERR_REF)
    END TCASE

    TCASE "a registered document is checked as a schema even if nothing refers to it"
      MUT known AS Map OF String TO json::Json = Map OF String TO json::Json {}
      known = collections::set(known, "https://ex.test/unused.json", json::parse("{\"type\":5}"))
      expectTrap(compileWithRegistry("{}", known), ERR_SCHEMA)
    END TCASE

    TCASE "a registration key must be a URI with no fragment"
      MUT empty AS Map OF String TO json::Json = Map OF String TO json::Json {}
      MUT bad AS Map OF String TO json::Json = Map OF String TO json::Json {}
      bad = collections::set(bad, "", json::parse("true"))
      expectTrap(compileWithRegistry("{}", bad), ERR_ARGUMENT)
      MUT fragment AS Map OF String TO json::Json = Map OF String TO json::Json {}
      fragment = collections::set(fragment, "https://ex.test/a#b", json::parse("true"))
      expectTrap(compileWithRegistry("{}", fragment), ERR_ARGUMENT)
      expectString(compileWithRegistry("{}", empty), "")
    END TCASE

    TCASE "a reference may name a subschema under a keyword this package does not read"
      LET schema AS String = "{\"x-defs\":{\"a\":{\"type\":\"string\"}},\"$ref\":\"#/x-defs/a\"}"
      expectString(verdict(schema, "\"ok\""), "valid")
      expectString(verdict(schema, "5"), "type")
    END TCASE

    TCASE "an anchor under a keyword this package does not read is addressable"
      LET schema AS String = "{\"x-defs\":{\"a\":{\"$anchor\":\"named\",\"type\":\"string\"}},\"$ref\":\"#named\"}"
      expectString(verdict(schema, "5"), "type")
    END TCASE

    TCASE "a reference into an unread region compiles that region's patterns"
      expectTrap(compileOnly("{\"x-p\":{\"pattern\":\"(\"},\"$ref\":\"#/x-p\"}"), ERR_SCHEMA)
    END TCASE

    TCASE "a reference to something that is not a schema is refused at compile time"
      expectTrap(compileOnly("{\"properties\":{\"a\":{\"type\":\"string\"}},\"$ref\":\"#/properties/a/type\"}"), ERR_SCHEMA)
      expectTrap(compileOnly("{\"$defs\":{\"a\":{\"minLength\":3}},\"$ref\":\"#/$defs/a/minLength\"}"), ERR_SCHEMA)
    END TCASE

    TCASE "a relative root $id is resolved once, against nothing"
      expectString(verdict("{\"$id\":\"sub/x.json\",\"properties\":{\"p\":{\"$ref\":\"x.json#/$defs/a\"}},\"$defs\":{\"a\":{\"type\":\"integer\"}}}", "{\"p\":1}"), "valid")
      expectString(verdict("{\"$id\":\"sub/x.json\",\"properties\":{\"p\":{\"$ref\":\"x.json#/$defs/a\"}},\"$defs\":{\"a\":{\"type\":\"integer\"}}}", "{\"p\":\"a\"}"), "type")
      ' "../x.json" from "sub/x.json" is "x.json", which no resource here declares.
      expectTrap(compileOnly("{\"$id\":\"sub/x.json\",\"properties\":{\"p\":{\"$ref\":\"../x.json#/$defs/a\"}},\"$defs\":{\"a\":{\"type\":\"integer\"}}}"), ERR_REF)
    END TCASE

    TCASE "an $id under a keyword this package does not read is a schema resource"
      LET schema AS String = "{\"x-r\":{\"$id\":\"http://e.test/r.json\",\"$defs\":{\"a\":{\"type\":\"integer\"}}},\"$ref\":\"http://e.test/r.json#/$defs/a\"}"
      expectString(verdict(schema, "1"), "valid")
      expectString(verdict(schema, "\"x\""), "type")
    END TCASE

    TCASE "an identifier is never declared twice, even under an unread keyword"
      expectTrap(compileOnly("{\"x-a\":{\"$id\":\"http://e.test/s.json\"},\"x-b\":{\"$id\":\"http://e.test/s.json\"}}"), ERR_SCHEMA)
    END TCASE

    TCASE "a schema with a thousand and more references compiles and validates"
      MUT defs AS List OF String = []
      MUT props AS List OF String = []
      MUT i AS Integer = 0
      WHILE i < 1500
        defs = collections::append(defs, "\"d" & toString(i) & "\":{\"type\":\"integer\"}")
        props = collections::append(props, "\"p" & toString(i) & "\":{\"$ref\":\"#/$defs/d" & toString(i) & "\"}")
        i = i + 1
      END WHILE
      LET schema AS String = "{\"$defs\":{" & strings::join(defs, ",") & "},\"properties\":{" & strings::join(props, ",") & "}}"
      LET compiled AS Schema = compileSchema(json::parse(schema), Map OF String TO json::Json {})
      expectEqual(len(runValidation(compiled, json::parse("{\"p7\":7,\"p1499\":1499}"))), 0)
      LET problems AS List OF ValidationError = runValidation(compiled, json::parse("{\"p1499\":\"x\"}"))
      expectEqual(len(problems), 1)
      expectString(collections::get(problems, 0).keyword, "type")
    END TCASE
  END TGROUP
END TESTING
