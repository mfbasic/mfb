{
  "name": "zipprobe",
  "version": "0.1.0",
  "mfb": "1.0",
  "kind": "executable",
  "description": "Describes archives with packages/zip from both source kinds, so diff.py can compare against Python.",
  "sources": [
    {
      "root": "src",
      "role": "main",
      "include": [
        "**/*.mfb"
      ]
    }
  ],
  "packages": [
    {
      "name": "zip",
      "version": "=0.1.0",
      "source": "file:packages/zip.mfp",
      "direct": true,
      "requiredBy": []
    }
  ],
  "entry": "main",
  "targets": [
    "native"
  ]
}