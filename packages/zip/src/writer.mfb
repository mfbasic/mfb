' ---------------------------------------------------------------------------
' zip/writer.mfb — building an archive in memory.
'
' A `Builder` is an ordinary value: every `add*` returns an updated copy rather
' than mutating in place, so a builder can be passed around and reused without
' anyone wondering who owns it. `finish` returns the archive's bytes.
'
' For an archive too large to hold in memory, use `Writer` (stream.mfb), which
' writes each entry to a file as it is added. The bytes are the same either way:
' both lay out entries through headers.mfb.
'
' --- Why this file is shaped the way it is -------------------------------
'
' A growing `List OF Byte` is cheap to append to and expensive to move. Measured
' (plan-139-B Corrections), per append, at lengths 0 / 4000 / 16000 / 64000:
'
'   append to a bare local              10-28ns      flat
'   WITH record { field := append(..) } 13-37ns      flat
'   rebuild the record positionally     871..78086ns grows with the list
'   pass the list to a FUNC and return  411..23639ns grows with the list
'
' This is the value model, not a quirk to route around: `mfb spec language
' memory-semantics` §14.2 makes a function argument an OWNED value, so handing a
' collection to a call hands over a copy. Only a resource pointer (§15) is ever
' aliased, which is why a `RES fs::File` can be passed freely and a `List OF Byte`
' cannot.
'
' So the archive body is never built one byte at a time. `finish` collects the
' pieces it already has -- each header, each payload -- as a list of lists, and
' flattens them once with `collections::flatten`.
' ---------------------------------------------------------------------------

IMPORT collections
IMPORT compress
IMPORT encoding
IMPORT errorCode
IMPORT strings

PRIVATE LET METHOD_DEFLATE AS Integer = 8

' An archive under construction.
'
' Hold it, add to it, and call `finish` when done. Each `add*` returns a new
' builder; the one passed in is unchanged.
EXPORT TYPE Builder
  pending AS List OF Pending
END TYPE

' An empty archive.
FUNC createBuilder() AS Builder
  RETURN Builder[[]]
END FUNC

' Add a file entry holding `data`, with the Unix permission bits `mode` (0 for the
' default, 0o644).
FUNC addFileEntry(builder AS Builder, name AS String, data AS List OF Byte, store AS Boolean, modifiedSeconds AS Integer, mode AS Integer) AS Builder
  LET record AS Pending = filePending(name, data, store, modifiedSeconds, mode)
  RETURN WITH builder { pending := collections::append(builder.pending, record) }
END FUNC

' The record for a file entry, not yet placed in an archive.
'
' Shared by `Builder` and `Writer`, so both validate and compress a file the same
' way. The entry is deflated when that makes it smaller and stored when it does
' not, so an incompressible entry is never made bigger by compressing it.
PUBLIC FUNC filePending(name AS String, data AS List OF Byte, store AS Boolean, modifiedSeconds AS Integer, mode AS Integer) AS Pending
  requireFileName(name)
  checkTimestamp(modifiedSeconds)
  LET perm AS Integer = modeOf(mode, FALSE)

  LET crc AS Integer = compress::crc32(data)
  MUT method AS Integer = METHOD_STORED
  MUT payload AS List OF Byte = data
  IF NOT store AND len(data) > 0 THEN
    LET deflated AS List OF Byte = compress::deflate(data)
    ' Only take the compressed form when it is actually smaller. This is the
    ' format's normal choice, not a fallback from a failure.
    IF len(deflated) < len(data) THEN
      method = METHOD_DEFLATE
      payload = deflated
    END IF
  END IF
  RETURN Pending[name, FALSE, method, len(data), len(payload), crc, payload, modifiedSeconds, perm, 0]
END FUNC

' Add a file entry holding the UTF-8 bytes of `text`.
FUNC addTextEntry(builder AS Builder, name AS String, text AS String, store AS Boolean, modifiedSeconds AS Integer, mode AS Integer) AS Builder
  RETURN addFileEntry(builder, name, encoding::utf8Encode(text), store, modifiedSeconds, mode)
END FUNC

' Add a directory entry, with the Unix permission bits `mode` (0 for 0o755). A
' trailing slash is added when absent.
FUNC addDirectoryEntry(builder AS Builder, name AS String, modifiedSeconds AS Integer, mode AS Integer) AS Builder
  LET record AS Pending = directoryPending(name, modifiedSeconds, mode)
  RETURN WITH builder { pending := collections::append(builder.pending, record) }
END FUNC

' The record for a directory entry, not yet placed. Shared with `Writer`.
PUBLIC FUNC directoryPending(name AS String, modifiedSeconds AS Integer, mode AS Integer) AS Pending
  strictName(name, TRUE)
  checkTimestamp(modifiedSeconds)
  MUT full AS String = name
  IF NOT strings::endsWith(full, "/") THEN
    full = full & "/"
  END IF
  RETURN Pending[full, TRUE, METHOD_STORED, 0, 0, compress::crc32([]), [], modifiedSeconds, modeOf(mode, TRUE), 0]
END FUNC

' Finish the archive and return its bytes.
'
' One pass to place each entry: its local header and its bytes, then the central
' directory, then the archive's tail. Each piece is collected and flattened once.
FUNC finishBuilder(builder AS Builder, comment AS String) AS List OF Byte
  LET commentBytes AS List OF Byte = encoding::utf8Encode(comment)
  IF len(commentBytes) > U16_MAX THEN
    FAIL error(errorCode::ErrTooLarge, "zip: archive comment of " & toString(len(commentBytes)) & " bytes exceeds the 65535-byte field")
  END IF

  MUT parts AS List OF List OF Byte = []
  MUT placed AS List OF Pending = []
  MUT offset AS Integer = 0
  FOR EACH entry IN builder.pending
    LET at AS Pending = WITH entry { headerOffset := offset }
    LET header AS List OF Byte = localHeader(at)
    parts = collections::append(parts, header)
    parts = collections::append(parts, entry.payload)
    offset = offset + len(header) + len(entry.payload)
    placed = collections::append(placed, at)
  NEXT

  LET centralAt AS Integer = offset
  MUT centralSize AS Integer = 0
  FOR EACH entry IN placed
    LET header AS List OF Byte = centralHeader(entry)
    parts = collections::append(parts, header)
    centralSize = centralSize + len(header)
  NEXT
  parts = collections::append(parts, endOfArchive(len(placed), centralSize, centralAt, commentBytes))
  RETURN collections::flatten(parts)
END FUNC

' A file name, checked against the rules a written name must meet.
'
' A file name may not end in "/" -- that is how a directory is marked -- and must
' pass `strictName`.
PRIVATE FUNC requireFileName(name AS String) AS Nothing
  IF strings::endsWith(name, "/") THEN
    FAIL error(errorCode::ErrInvalidPath, "zip: file entry name \"" & name & "\" ends in a slash; use addDirectory")
  END IF
  strictName(name, FALSE)
END FUNC
