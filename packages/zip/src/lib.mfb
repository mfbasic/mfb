' ---------------------------------------------------------------------------
' zip/lib.mfb — the package's public surface.
'
' Two `open` overloads, one for each place an archive's bytes can be, and one
' set of accessors that works the same either way. Everything below this file
' reads through `source.mfb`'s `readAt`, so "the file form and the memory form
' agree" is a property of the structure rather than something the accessors
' have to maintain.
'
' Writing has two shapes: a `Builder` that holds the archive in memory until
' `finish`, and a `Writer` that writes each entry to a file as it is added. Both
' produce the same bytes for the same calls.
' ---------------------------------------------------------------------------

IMPORT fs
IMPORT collections
IMPORT encoding
IMPORT errorCode

' The checksum an entry's bytes did not match.
'
' Every other failure this package reports uses a shared `errorCode::` value; a
' CRC mismatch has no shared equivalent, so it gets the package's own code.
EXPORT LET ErrorChecksum AS Integer = 93150001

' One entry in an archive.
'
' `size` and `compressedSize` are what the central directory records, so they are
' known before any of the entry's data is read. `headerOffset` locates the entry's
' local header; `read` uses it and callers normally do not. `flags` is the central
' directory's general-purpose flag word.
EXPORT TYPE Entry
  name AS String
  isDirectory AS Boolean
  method AS Integer
  size AS Integer
  compressedSize AS Integer
  crc AS Integer
  modifiedSeconds AS Integer
  mode AS Integer
  comment AS String
  headerOffset AS Integer
  flags AS Integer
END TYPE

' An open archive: where its bytes are, what it contains, and its comment.
'
' An `Archive` over a file refers to the caller's `fs::File` without owning it. The
' file stays open until the caller closes it, and closing it makes later reads
' through this archive fail with `errorCode::ErrResourceClosed`.
EXPORT TYPE Archive
  source AS Source
  entries AS List OF Entry
  comment AS String
END TYPE

' Open an archive held in memory.
'
' A typed binding is required: an untyped list literal selects neither overload.
EXPORT FUNC open(data AS List OF Byte) AS Archive
  RETURN parseArchive(memorySource(data))
END FUNC

' Open an archive from a file the caller has open.
'
' The whole file is never read. Opening reads only the central directory, and
' `read` afterwards holds one entry at a time, so an archive far larger than memory
' is still readable one entry at a time.
'
' The handle belongs to the caller; this package never closes it.
EXPORT FUNC open(file AS fs::File) AS Archive
  RETURN parseArchive(fileSource(file))
END FUNC

' Every entry, in central-directory order.
EXPORT FUNC entries(archive AS Archive) AS List OF Entry
  RETURN archive.entries
END FUNC

' The archive-level comment, or the empty string.
EXPORT FUNC comment(archive AS Archive) AS String
  RETURN archive.comment
END FUNC

' Whether an entry with exactly this name is present.
EXPORT FUNC has(archive AS Archive, name AS String) AS Boolean
  FOR EACH entry IN archive.entries
    IF entry.name = name THEN
      RETURN TRUE
    END IF
  NEXT
  RETURN FALSE
END FUNC

' The entry with exactly this name.
'
' Zip permits an archive to hold the same name twice. This returns the FIRST such
' entry in central-directory order, which is the one `unzip` lists first.
' Raises `errorCode::ErrNotFound` when the name is absent.
EXPORT FUNC find(archive AS Archive, name AS String) AS Entry
  FOR EACH entry IN archive.entries
    IF entry.name = name THEN
      RETURN entry
    END IF
  NEXT
  FAIL error(errorCode::ErrNotFound, "zip: no entry named \"" & name & "\"")
END FUNC

' Read one entry's uncompressed bytes.
'
' `maxBytes` bounds how much memory one call can need. It is checked against the
' size the central directory records BEFORE any data is read, so an oversized entry
' is refused without cost -- which is what makes it safe to open an untrusted
' archive and look at its entry list.
'
' The bytes are checked against the CRC-32 the archive records for them: a mismatch
' raises `zip::ErrorChecksum` rather than returning data that does not match its own
' checksum. A directory entry reads as the empty list.
EXPORT FUNC read(archive AS Archive, entry AS Entry, maxBytes AS Integer = 67108864) AS List OF Byte
  RETURN readEntry(archive, entry, maxBytes)
END FUNC

' Read one entry and decode it as UTF-8 text.
'
' Everything `read` does, plus a strict UTF-8 decode: an entry that is not valid
' UTF-8 raises `errorCode::ErrInvalidFormat` rather than returning replacement
' characters.
EXPORT FUNC readText(archive AS Archive, entry AS Entry, maxBytes AS Integer = 67108864) AS String
  RETURN readEntryText(archive, entry, maxBytes)
END FUNC

' Start building a new archive in memory.
'
' Each `add*` returns a new `Builder`; the one passed in is unchanged. `finish` turns
' the result into the archive's bytes. For an archive too large to hold in memory,
' use `openWriter`.
EXPORT FUNC create() AS Builder
  RETURN createBuilder()
END FUNC

' Add a file entry holding `data`.
'
' The entry is deflated when that makes it smaller and stored when it does not,
' which is what `zip(1)` does -- an incompressible entry is never made bigger by
' compressing it. Pass `store = TRUE` to skip compression entirely.
'
' `modifiedSeconds` is seconds since the Unix epoch. 0 writes the earliest DOS time, 1980-01-01, which reads back as 315532800.
' `mode` is the Unix permission bits, 0 meaning 0o644. Raises
' `errorCode::ErrInvalidPath` for an unsafe name, and `errorCode::ErrInvalidArgument`
' for a time or mode the format cannot record.
EXPORT FUNC addFile(builder AS Builder, name AS String, data AS List OF Byte, store AS Boolean = FALSE, modifiedSeconds AS Integer = 0, mode AS Integer = 0) AS Builder
  RETURN addFileEntry(builder, name, data, store, modifiedSeconds, mode)
END FUNC

' Add a file entry holding the UTF-8 bytes of `text`.
EXPORT FUNC addText(builder AS Builder, name AS String, text AS String, store AS Boolean = FALSE, modifiedSeconds AS Integer = 0, mode AS Integer = 0) AS Builder
  RETURN addTextEntry(builder, name, text, store, modifiedSeconds, mode)
END FUNC

' Add a directory entry. A trailing `/` is added when the name lacks one.
'
' Directory entries are optional in a zip -- a file named `a/b.txt` implies `a/` --
' but most tools list them, so adding them makes the archive look the way a user
' expects. `mode` is the Unix permission bits, 0 meaning 0o755.
EXPORT FUNC addDirectory(builder AS Builder, name AS String, modifiedSeconds AS Integer = 0, mode AS Integer = 0) AS Builder
  RETURN addDirectoryEntry(builder, name, modifiedSeconds, mode)
END FUNC

' Finish the archive and return its bytes.
'
' The result is deterministic: the same calls in the same order always produce the
' same bytes. ZIP64 records are written only when the archive needs them, so a small
' archive is an ordinary zip any reader accepts.
'
' Raises `errorCode::ErrTooLarge` when `comment` is longer than 65535 bytes.
EXPORT FUNC finish(builder AS Builder, comment AS String = "") AS List OF Byte
  RETURN finishBuilder(builder, comment)
END FUNC

' Start writing an archive to `file`, which must be empty.
'
' Unlike `create`, a Writer puts each entry in the file as it is added, so the
' archive never has to fit in memory. Add entries with `writeFile`, `writeText` and
' `writeDirectory`, then call `finishWriter` to write the central directory. The
' file stays yours: this package never closes it, so close it after `finishWriter`.
'
' Raises `errorCode::ErrInvalidArgument` when the file is not empty.
EXPORT FUNC openWriter(file AS fs::File) AS Writer
  RETURN openWriterFile(file)
END FUNC

' Write a file entry holding `data` into a Writer's file, now.
'
' Returns the updated writer. Use that one, not the one passed in: see `openWriter`.
EXPORT FUNC writeFile(writer AS Writer, name AS String, data AS List OF Byte, store AS Boolean = FALSE, modifiedSeconds AS Integer = 0, mode AS Integer = 0) AS Writer
  RETURN addFileToWriter(writer, name, data, store, modifiedSeconds, mode)
END FUNC

' Write a file entry holding the UTF-8 bytes of `text` into a Writer's file.
EXPORT FUNC writeText(writer AS Writer, name AS String, text AS String, store AS Boolean = FALSE, modifiedSeconds AS Integer = 0, mode AS Integer = 0) AS Writer
  RETURN addFileToWriter(writer, name, encoding::utf8Encode(text), store, modifiedSeconds, mode)
END FUNC

' Write a directory entry into a Writer's file.
EXPORT FUNC writeDirectory(writer AS Writer, name AS String, modifiedSeconds AS Integer = 0, mode AS Integer = 0) AS Writer
  RETURN addDirectoryToWriter(writer, name, modifiedSeconds, mode)
END FUNC

' Write the central directory, completing the archive in the file.
'
' Raises `errorCode::ErrTooLarge` when `comment` is longer than 65535 bytes. Call
' this once, and do not write to the writer afterwards.
EXPORT FUNC finishWriter(writer AS Writer, comment AS String = "") AS Nothing
  writeCentralDirectory(writer, comment)
END FUNC

' Extract every entry into `directory`, returning the number of files written.
'
' `directory` is created, with any missing parents, when it does not exist.
' Directories in the archive are created but not counted.
'
' **Every entry is checked before any byte is written.** A name is refused with
' `errorCode::ErrInvalidPath` when it is empty, absolute, contains `..`, a backslash
' or a NUL, or names a Windows drive. Two entries that extract to the same path are
' refused with `errorCode::ErrInvalidFormat`, as is a file where another entry needs
' a directory. A path that already exists is refused with
' `errorCode::ErrAlreadyExists`: extraction never overwrites a file.
'
' **Containment is enforced where each file is opened.** A file cannot be written
' outside `directory`, even through a symlink already on disk.
'
' **A failed extraction leaves nothing behind.** If an entry fails after writing has
' started -- a CRC mismatch, an I/O error -- every file and directory this call
' created is removed, and the original error is raised.
'
' `maxTotalBytes` caps the total uncompressed size, checked before writing, so a
' small archive cannot be used to fill a disk.
'
' File permissions and modification times are NOT restored: `fs` cannot set either,
' so extracted files get the host's defaults.
EXPORT FUNC extractTo(archive AS Archive, directory AS String, maxTotalBytes AS Integer = 1073741824) AS Integer
  RETURN extractArchive(archive, directory, maxTotalBytes)
END FUNC
