' ---------------------------------------------------------------------------
' zip/source.mfb — the one seam every parser in this package reads bytes
' through.
'
' An archive is either a `List OF Byte` already in memory or an open `fs::File`.
' Everything above this file -- the end-of-central-directory scan, the central
' directory parse, the local header parse, the entry read -- is written against
' `readAt` and `sizeOf` and never against either concrete source. That is what makes
' "the file form and the memory form produce identical results" true by construction
' rather than by two parsers that happen to agree today.
'
' The file branch never reads the whole file. `fs::readBytesAt` reads exactly the
' requested window and leaves the handle's read position where it found it, so an
' `Archive` that aliases a caller's `fs::File` neither consumes it nor disturbs a
' reader sharing it.
'
' `Source` is a record, not a union, on purpose. Reading a union's payload with
' `MATCH` copies it, and for an in-memory archive the payload is every byte of the
' archive: each entry read would then cost a copy of the whole archive, so reading a
' large archive one entry at a time would be quadratic. A field read copies nothing.
' A memory source therefore carries an empty, unused file handle, which costs nothing
' to open and nothing to hold.
'
' `readAt` bounds-checks against `sizeOf` before it reads. Callers are expected to
' have checked already -- every offset in a zip comes from the archive's own untrusted
' bytes, so the parsers check before they trust -- and this is the backstop that turns
' a missed check into a refused archive instead of a read past the end of a file.
' ---------------------------------------------------------------------------

IMPORT fs
IMPORT collections
IMPORT errorCode

' An archive's bytes: in memory, or in a file the caller has open.
'
' Internal -- use `open`. It is exported only because `Archive` has a field of this
' type, and an exported record's field type must be nameable by importers.
'
' `fromFile` selects the source. When it is FALSE, `bytes` holds the archive and
' `handle` is an empty file this package opened and never uses. When it is TRUE,
' `handle` is the caller's file, which this package never closes: closing it while an
' `Archive` still refers to it makes later reads fail with
' `errorCode::ErrResourceClosed`.
EXPORT TYPE Source
  fromFile AS Boolean
  bytes AS List OF Byte
  handle AS RES fs::File
END TYPE

' An archive held in `data`.
FUNC memorySource(data AS List OF Byte) AS Source
  LET empty AS List OF Byte = []
  RES unused AS fs::File = fs::openData(empty, "read")
  RETURN Source[FALSE, data, unused]
END FUNC

' An archive read from `file`, which the caller keeps open.
FUNC fileSource(file AS fs::File) AS Source
  LET none AS List OF Byte = []
  RETURN Source[TRUE, none, file]
END FUNC

' How many bytes the archive holds.
FUNC sizeOf(source AS Source) AS Integer
  IF source.fromFile THEN
    RETURN fs::size(source.handle)
  END IF
  RETURN len(source.bytes)
END FUNC

' The `count` bytes at `offset`.
'
' Raises `errorCode::ErrInvalidFormat` when the window is not wholly inside the
' archive -- including the case where a file was truncated underneath an open handle,
' which shows up as a short read.
FUNC readAt(source AS Source, offset AS Integer, count AS Integer) AS List OF Byte
  LET total AS Integer = sizeOf(source)
  IF NOT fitsIn(offset, count, total) THEN
    FAIL error(errorCode::ErrInvalidFormat, "zip: read of " & toString(count) & " bytes at " & toString(offset) & " runs past the end of a " & toString(total) & "-byte archive")
  END IF
  IF NOT source.fromFile THEN
    RETURN collections::mid(source.bytes, offset, count)
  END IF
  LET got AS List OF Byte = fs::readBytesAt(source.handle, offset, count)
  IF len(got) <> count THEN
    FAIL error(errorCode::ErrInvalidFormat, "zip: file ended after " & toString(len(got)) & " of " & toString(count) & " bytes at " & toString(offset))
  END IF
  RETURN got
END FUNC
