IMPORT fs
IMPORT tcp

DOC
  PACKAGE
  DESC One-line UTC log entries, delivered in order to the console, an open
  DESC file, a connected socket, and your own code.
  DESC
  DESC A `logger::Logger` holds a minimum level and a list of backends. Every
  DESC `logger::log` call below the minimum level returns before any work is
  DESC done. Otherwise the entry is timestamped and formatted once, and the same
  DESC line is delivered to every backend, in list order.
  EXAMPLE
    IMPORT fs
    IMPORT logger

    FUNC audit(entry AS logger::LogEntry) AS Nothing
      ' entry.level, entry.timestamp and entry.message are the structured form.
    END FUNC

    FUNC main() AS Integer
      RES file AS fs::File = fs::createTempFile()
      LET console AS logger::LogBackend = logger::ConsoleBackend[]
      LET toFile AS logger::LogBackend = logger::FileBackend[file := file]
      LET custom AS logger::LogBackend = logger::CustomBackend[callback := audit]
      LET app AS logger::Logger = logger::Logger[minLevel := logger::LogLevel.INFO, backends := [console, toFile, custom]]

      logger::log(app, logger::LogLevel.DEBUG, "not delivered")
      logger::log(app, logger::LogLevel.INFO, "started")
      logger::log(app, logger::LogLevel.ERROR, "request failed")
      RETURN 0
    END FUNC
  END EXAMPLE
  DESC
  DESC Routing is by threshold, the convention of mainstream logging libraries:
  DESC an entry reaches every backend when its level is at least `minLevel`.
  DESC To send different levels to different destinations, use one `Logger` per
  DESC threshold, or a `CustomBackend` whose callback checks `entry.level`.
  DESC
  DESC Failures. Every backend is attempted, even after an earlier one fails. If
  DESC any backend fails, `logger::log` then fails with the first failure, so a
  DESC broken destination never silently starves the others. Wrap a call in a
  DESC `TRAP` where logging must not interrupt your code.
  DESC
  DESC Handles are yours
  DESC
  DESC The caller creates, flushes when needed, and closes every file and
  DESC socket. This package never opens, closes, flushes, retries, reconnects,
  DESC batches, or filters them.
  DESC
  DESC Threads
  DESC
  DESC A `Logger` cannot be sent to another thread: its type holds a file or
  DESC socket resource, and the compiler refuses to pass it to `thread::start`.
  DESC Each thread that logs builds its own `Logger` inside its worker function,
  DESC over its own handles, so no two threads ever write through one handle. To
  DESC move a file or socket to a worker, use `thread::transfer`; the `Logger`
  DESC built from it then belongs to that worker.
  SEC A message is written as one line. Before it reaches any backend, every
  SEC character that could end the line, hide text, or reorder what a reader sees
  SEC is written as an escape: a backslash as `\\`, a carriage return as `\r`, a
  SEC line feed as `\n`, a tab as `\t`, and every other control, format,
  SEC separator, or unassigned character as `\u{HEX}`. Without that, a message
  SEC built from untrusted input could forge a complete entry at any level and
  SEC timestamp, or send terminal escape sequences to the console. The escape is
  SEC reversible: a backslash is always written as `\\`, so an escape in a log
  SEC line is never confused with text that happens to look like one.
  SEC `CustomBackend` receives the unmodified `LogEntry`, because it is handed
  SEC structure rather than a line.
END DOC

DOC
  ENUM LogLevel
  DESC The severity of one entry, from least to most severe.
  DESC
  DESC The level is written into the formatted line as its name. `Logger.minLevel`
  DESC is compared against it by severity.
  PROP DEBUG Detail useful while diagnosing, normally off in production.
  PROP INFO  The ordinary course of events.
  PROP WARN  Something unexpected that did not stop the operation.
  PROP ERROR An operation failed.
END DOC
EXPORT ENUM LogLevel
  DEBUG, INFO, WARN, ERROR
END ENUM

DOC
  TYPE LogEntry
  DESC One log entry in structured form, as `CustomBackend` receives it.
  DESC
  DESC Every backend reached by a single `logger::log` call sees the same entry,
  DESC including the same timestamp. It is read once per call, not once per
  DESC backend, so a fan-out cannot disagree with itself about when something
  DESC happened.
  PROP level     The entry's severity.
  PROP timestamp The instant the entry was created, UTC, ISO-8601 with milliseconds (`2026-01-02T03:04:05.678Z`).
  PROP message   The message exactly as it was passed to `logger::log`, unescaped. The line-oriented backends escape it; this field does not.
END DOC
EXPORT TYPE LogEntry
  level AS LogLevel
  timestamp AS String
  message AS String
END TYPE

DOC
  TYPE ConsoleBackend
  DESC A backend that writes each entry to standard output with `io::print`.
  DESC
  DESC It carries no configuration, so it is written `logger::ConsoleBackend[]`.
END DOC
EXPORT TYPE ConsoleBackend
END TYPE

DOC
  TYPE FileBackend
  DESC A backend that appends each entry, and a newline, to an open file.
  DESC
  DESC Writes go through `fs::writeAll` on the handle you supply. The package
  DESC does not open, flush, or close it: open the file in append mode, flush
  DESC when you need the bytes on disk, and close it when you are done.
  PROP file An open `fs::File`. The handle stays open, and you still close it.
END DOC
EXPORT TYPE FileBackend
  file AS RES fs::File
END TYPE

DOC
  TYPE NetworkBackend
  DESC A backend that writes each entry, and a newline, to a connected socket.
  DESC
  DESC Writes go through `tcp::write` on the handle you supply. The trailing
  DESC newline is what frames the stream: a reader splits entries on it, exactly
  DESC as it would reading the file a `FileBackend` writes. The package does not
  DESC connect, reconnect, retry, or close. A write that fails propagates out of
  DESC `logger::log`.
  PROP socket A connected `tcp::Socket`. The handle stays open, and you still close it.
END DOC
EXPORT TYPE NetworkBackend
  socket AS RES tcp::Socket
END TYPE

DOC
  TYPE CustomBackend
  DESC A backend that calls your function with the structured `LogEntry`.
  DESC
  DESC This is the seam for anything the package does not do itself: counting
  DESC entries, forwarding to a service, buffering, filtering by level, or
  DESC reformatting. The callback receives the entry rather than a formatted line,
  DESC so it sees the message exactly as it was logged. Call `logger::formatEntry`
  DESC to get the same line the other backends write.
  PROP callback The function to call, once per delivery. A failure it raises is reported by `logger::log` as described in the package documentation.
END DOC
EXPORT TYPE CustomBackend
  callback AS FUNC(LogEntry) AS Nothing
END TYPE

DOC
  UNION LogBackend
  DESC One destination for log entries.
  PROP ConsoleBackend Standard output.
  PROP FileBackend    An open file, one line per entry.
  PROP NetworkBackend A connected socket, one line per entry.
  PROP CustomBackend  Your own function, given the structured entry.
END DOC
EXPORT UNION LogBackend
  ConsoleBackend
  FileBackend
  NetworkBackend
  CustomBackend
END UNION

DOC
  TYPE Logger
  DESC A minimum level and the backends that receive entries at or above it.
  DESC
  DESC Build one and pass it to `logger::log`. It holds no handle of its own and
  DESC opens nothing. Every resource in it is one you supplied and still own.
  PROP minLevel The least severe level delivered. Entries below it are dropped before they are formatted.
  PROP backends Every backend that receives a delivered entry, in list order. A backend listed twice is called twice.
END DOC
EXPORT TYPE Logger
  minLevel AS LogLevel
  backends AS List OF LogBackend
END TYPE

FUNC ignore(entry AS LogEntry) AS Nothing
END FUNC

TESTING
  TGROUP "model"
    TCASE "constructs every public data shape"
      LET callback AS FUNC(LogEntry) AS Nothing = ignore
      LET custom AS LogBackend = CustomBackend[callback := callback]
      LET console AS LogBackend = ConsoleBackend[]
      LET configured = Logger[minLevel := LogLevel.INFO, backends := [console, custom]]
      expectInteger(len(configured.backends), 2)
      expectEqual(configured.minLevel = LogLevel.INFO, TRUE)
    END TCASE

    TCASE "a file backend aliases through a list"
      RES file AS fs::File = fs::createTempFile()
      LET backend AS LogBackend = FileBackend[file := file]
      LET backends AS List OF LogBackend = [backend]
      expectInteger(len(backends), 1)
    END TCASE

    TCASE "an entry carries the level it was built with"
      LET entry AS LogEntry = LogEntry[level := LogLevel.WARN, timestamp := "2026-01-02T03:04:05Z", message := "careful"]
      expectEqual(entry.level = LogLevel.WARN, TRUE)
      expectString(entry.timestamp, "2026-01-02T03:04:05Z")
      expectString(entry.message, "careful")
    END TCASE
  END TGROUP
END TESTING
