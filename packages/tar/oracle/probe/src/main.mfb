' ---------------------------------------------------------------------------
' tar oracle probe.
'
' Reads a job file -- one archive path per line -- and writes one JSON line per
' archive describing what `packages/tar` makes of it. `diff.py` runs Python over
' the same paths and compares.
'
' Every archive is opened TWICE, from a `List OF Byte` and from an `fs::File`,
' and `sourcesAgree` reports whether the two descriptions were identical. That
' field is the one `diff.py` treats as a hard failure it can never declare away:
' a disagreement there is not a difference of opinion with Python, it is this
' package contradicting itself.
' ---------------------------------------------------------------------------

IMPORT tar
IMPORT collections
IMPORT compress
IMPORT fs
IMPORT io
IMPORT os
IMPORT strings

FUNC describeMemory(path AS String) AS String
  LET raw AS List OF Byte = fs::readBytes(path)
  RETURN describe(tar::open(raw))
END FUNC

FUNC describeFile(path AS String) AS String
  RES f AS fs::File = fs::openFile(path)
  LET out AS String = describe(tar::open(f))
  fs::close(f)
  RETURN out
END FUNC

FUNC describe(archive AS tar::Archive) AS String
  MUT rows AS List OF String = []
  FOR EACH entry IN tar::entries(archive)
    MUT digest AS String = "0"
    MUT readError AS String = "null"
    IF entry.kind = tar::KindFile THEN
      LET crc AS Integer = contentCrc(archive, entry)
      IF crc < 0 THEN
        readError = "\"read:" & toString(0 - crc) & "\""
        digest = "null"
      ELSE
        digest = toString(crc)
      END IF
    END IF
    rows = collections::append(rows, "{\"name\":" & quoted(entry.name) _
      & ",\"kind\":" & toString(entry.kind) _
      & ",\"isDirectory\":" & boolText(entry.isDirectory) _
      & ",\"size\":" & toString(entry.size) _
      & ",\"mode\":" & toString(entry.mode) _
      & ",\"mtime\":" & toString(entry.modifiedSeconds) _
      & ",\"uid\":" & toString(entry.uid) _
      & ",\"gid\":" & toString(entry.gid) _
      & ",\"user\":" & quoted(entry.user) _
      & ",\"group\":" & quoted(entry.group) _
      & ",\"linkTarget\":" & quoted(entry.linkTarget) _
      & ",\"contentCrc\":" & digest _
      & ",\"readError\":" & readError & "}")
  NEXT
  RETURN "{\"entries\":[" & strings::join(rows, ",") & "]}"
END FUNC

FUNC contentCrc(archive AS tar::Archive, entry AS tar::Entry) AS Integer
  LET crc AS Integer = compress::crc32(tar::read(archive, entry)) TRAP(e)
    RECOVER 0 - e.code
  END TRAP
  RETURN crc
END FUNC

FUNC boolText(value AS Boolean) AS String
  IF value THEN
    RETURN "true"
  END IF
  RETURN "false"
END FUNC

FUNC quoted(text AS String) AS String
  MUT out AS String = "\""
  FOR EACH scalar IN strings::toScalars(text)
    LET code AS Integer = toInt(scalar)
    IF code = 34 THEN
      out = out & "\\\""
    ELSE
      IF code = 92 THEN
        out = out & "\\\\"
      ELSE
        IF code = 10 THEN
          out = out & "\\n"
        ELSE
          IF code = 13 THEN
            out = out & "\\r"
          ELSE
            IF code = 9 THEN
              out = out & "\\t"
            ELSE
              ' Anything outside printable ASCII is escaped, not emitted raw.
              ' A fuzzed archive's name field is arbitrary bytes, and this has
              ' to produce valid JSON for every one of them -- emitting raw C1
              ' control characters produced lines Python's json refused to
              ' parse. Astral characters stay raw: they only arise from names
              ' that were valid UTF-8 to begin with, and JSON accepts them.
              IF code < 32 OR (code >= 127 AND code <= 65535) THEN
                out = out & "\\u" & padHex(code)
              ELSE
                out = out & strings::fromScalars([scalar])
              END IF
            END IF
          END IF
        END IF
      END IF
    END IF
  NEXT
  RETURN out & "\""
END FUNC

FUNC padHex(code AS Integer) AS String
  LET digits AS String = "0123456789abcdef"
  MUT out AS String = ""
  MUT rest AS Integer = code
  FOR i = 1 TO 4
    out = strings::mid(digits, rest MOD 16, 1) & out
    rest = rest / 16
  NEXT
  RETURN out
END FUNC

FUNC main AS Integer
  LET args AS List OF String = os::args()
  IF len(args) < 1 THEN
    io::print("usage: tarprobe <job-file>")
    RETURN 2
  END IF
  LET job AS String = collections::get(args, 0)
  FOR EACH path IN strings::split(strings::trim(fs::readText(job)), "\n")
    IF len(strings::trim(path)) > 0 THEN
      emit(strings::trim(path))
    END IF
  NEXT
  RETURN 0
END FUNC

SUB emit(path AS String)
  MUT fromMemory AS String = ""
  MUT memoryError AS Integer = 0
  fromMemory = describeMemory(path) TRAP(e)
    memoryError = e.code
    RECOVER ""
  END TRAP

  MUT fromFile AS String = ""
  MUT fileError AS Integer = 0
  fromFile = describeFile(path) TRAP(e)
    fileError = e.code
    RECOVER ""
  END TRAP

  LET agree AS Boolean = fromMemory = fromFile AND memoryError = fileError
  MUT line AS String = "{\"path\":" & quoted(path) _
    & ",\"sourcesAgree\":" & boolText(agree)
  IF memoryError <> 0 THEN
    line = line & ",\"error\":" & toString(memoryError)
    IF fileError <> memoryError THEN
      line = line & ",\"fileError\":" & toString(fileError)
    END IF
  ELSE
    IF fileError <> 0 THEN
      line = line & ",\"error\":0,\"fileError\":" & toString(fileError)
    ELSE
      line = line & ",\"archive\":" & fromMemory
    END IF
  END IF
  io::print(line & "}")
END SUB
