' ---------------------------------------------------------------------------
' currency/core.mfb — the vocabulary the rest of the package is built on: the
' error codes, the Amount record, and what counts as a currency code.
'
' A code is either an ISO 4217 code from the list committed with the package
' (data.mfb, generated by tools/iso4217/gen_currency_data.py), or a custom code
' spelled with a leading underscore. The underscore keeps the two namespaces
' apart for good: ISO codes are three letters and never start with `_`, so a
' custom `_GOLD` can never collide with a currency a later ISO list adds.
'
' Every code is upper-cased before it is checked, and the upper-cased spelling
' is the only one the package stores or returns. Each scalar is checked to be
' an ASCII letter or digit BEFORE strings::upper runs, because upper applies
' full Unicode case mapping: run first, it would turn `_ﬀ` (one ligature
' scalar) into the valid `_FF` instead of rejecting it.
' ---------------------------------------------------------------------------

IMPORT strings

DOC
  PACKAGE
  DESC Money amounts tagged with a currency, and the exchange rates that
  DESC convert between them.
  DESC
  DESC A `currency::Amount` is a `Money` value plus a currency code. Codes are
  DESC ISO 4217 codes such as `USD`, `EUR` and `JPY`, checked against the ISO
  DESC list committed with the package, or custom codes that start with an
  DESC underscore, such as `_GOLD` or `_POINTS`. Codes are upper-cased, so
  DESC `"usd"` and `"USD"` are the same code.
  DESC
  DESC The package keeps one rates table, a `Map OF String TO Fixed` from code
  DESC to rate, maintained with `currency::setRate`, `currency::removeRate` and
  DESC `currency::importRates`. A rate says how many units of the base
  DESC currency one unit of the code is worth. The base currency is whichever
  DESC currency has rate `1`; there is no separate setting for it.
  DESC
  DESC Arithmetic on two amounts (`add`, `subtract`, `compare`, `convert`)
  DESC needs both codes in the table, and needs a base currency when the codes
  DESC differ. The result is in the first amount's currency. Arithmetic on one
  DESC amount (`multiply`, `divide`, `negate`, `round`, `format`) never reads
  DESC the table.
  WARN The rates table belongs to the thread that set it. A worker thread
  WARN starts with an empty table. Pass `currency::exportRates()` to the worker
  WARN and call `currency::importRates` there to give it the same rates.
END DOC

' ---------------------------------------------------------------------------
' Error codes. A failure the errorCode:: registry has a name for keeps it --
' an overflow is errorCode::ErrOverflow, from Money itself. The four failures
' below are about currencies and rates, which the registry does not model, so
' they take generator-9 (user-defined) codes in subsystem 317
' (`mfb spec diagnostics error-codes`), exported by name so a caller can MATCH
' on them.
' ---------------------------------------------------------------------------

' 9-317-0001: a currency code is neither an ISO 4217 code nor `_` followed by
' 1 to 15 letters or digits.
EXPORT LET ErrorInvalidCode AS Integer = 93170001
' 9-317-0002: a rate is zero or negative.
EXPORT LET ErrorInvalidRate AS Integer = 93170002
' 9-317-0003: an amount's currency has no rate in the table.
EXPORT LET ErrorUnknownCurrency AS Integer = 93170003
' 9-317-0004: two amounts in different currencies, and no currency in the
' table has rate 1.
EXPORT LET ErrorNoBaseCurrency AS Integer = 93170004

' The longest custom code, counting its leading underscore.
PUBLIC LET MAX_CUSTOM_CODE AS Integer = 16

' The letters a code may hold, in either case.
PRIVATE LET ASCII_LETTERS AS String = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz"

' Money keeps five decimal places; a code with no minor unit keeps them all.
PUBLIC LET MONEY_DECIMALS AS Integer = 5

DOC
  TYPE Amount
  DESC A `Money` value in one currency.
  DESC
  DESC Build one with `currency::amount`, which checks and upper-cases the
  DESC code. Constructing `currency::Amount[...]` directly is allowed too; every
  DESC function that takes an `Amount` checks its code the same way, so a
  DESC lower-case code works and a malformed one fails with
  DESC `currency::ErrorInvalidCode` when it is used.
  PROP value The amount, at `Money`'s five decimal places.
  PROP code The currency code, such as `USD` or `_GOLD`.
END DOC
EXPORT TYPE Amount
  value AS Money
  code AS String
END TYPE

' ---------------------------------------------------------------------------
' Currency codes
' ---------------------------------------------------------------------------

' The upper-cased spelling of `code` if it is a valid code, else "".
PUBLIC FUNC canonicalCode(code AS String) AS String
  LET count AS Integer = len(strings::toScalars(code))
  IF count = 0 THEN RETURN ""
  LET custom AS Boolean = strings::startsWith(code, "_")
  IF custom THEN
    IF count < 2 OR count > MAX_CUSTOM_CODE THEN RETURN ""
  ELSEIF count <> 3 THEN
    RETURN ""
  END IF
  MUT allowed AS String = ASCII_LETTERS
  MUT first AS Integer = 0
  IF custom THEN
    allowed = ASCII_LETTERS & "0123456789"
    first = 1
  END IF
  FOR i = first TO count - 1
    IF NOT strings::contains(allowed, strings::mid(code, i, 1)) THEN RETURN ""
  NEXT
  ' Only ASCII letters, digits and `_` remain, so full case mapping is plain
  ' ASCII upper-casing here.
  LET result AS String = strings::upper(code)
  IF NOT custom AND isoMinorUnits(result) = -1 THEN RETURN ""
  RETURN result
END FUNC

' The upper-cased spelling of `code`, or a failure naming what is wrong with it.
PUBLIC FUNC checkedCode(code AS String) AS String
  LET result AS String = canonicalCode(code)
  IF len(result) = 0 THEN
    FAIL error(ErrorInvalidCode, "currency: \"" & code & "\" is not a currency code; use an ISO 4217 code such as USD (ISO list of " & isoPublished() & "), or `_` followed by 1 to 15 letters or digits")
  END IF
  RETURN result
END FUNC

DOC
  FUNC isValidCode
  GROUP Codes
  DESC Whether `code` is a currency code this package accepts, ignoring case.
  DESC
  DESC A valid code is either an ISO 4217 code in the list committed with the
  DESC package, such as `USD`, `JPY` or the gold code `XAU`, or a custom code:
  DESC `_` followed by 1 to 15 ASCII letters or digits, such as `_GOLD`.
  DESC An ISO-shaped code that is not in the list, such as `ABC`, is not valid.
  ARG code The code to check.
  RET `TRUE` if `currency::normalizeCode` would accept it.
  EXAMPLE
    IMPORT currency
    IMPORT io

    FUNC main() AS Nothing
      io::print(toString(currency::isValidCode("usd")))     ' TRUE
      io::print(toString(currency::isValidCode("_gold")))   ' TRUE
      io::print(toString(currency::isValidCode("ABC")))     ' FALSE
    END FUNC
  END EXAMPLE
END DOC
EXPORT FUNC isValidCode(code AS String) AS Boolean
  RETURN len(canonicalCode(code)) > 0
END FUNC

DOC
  FUNC normalizeCode
  GROUP Codes
  DESC The upper-cased spelling of a currency code, after checking it.
  DESC
  DESC This is the spelling the package stores and returns everywhere, so
  DESC `"eur"`, `"Eur"` and `"EUR"` all come back as `EUR`.
  ARG code An ISO 4217 code or a `_` custom code, in any case.
  RET The code in upper case.
  ERROR 93170001 `code` is not a valid currency code.
  EXAMPLE
    IMPORT currency
    IMPORT io

    FUNC main() AS Nothing
      io::print(currency::normalizeCode("eur"))      ' EUR
      io::print(currency::normalizeCode("_Gold2"))   ' _GOLD2
    END FUNC
  END EXAMPLE
END DOC
EXPORT FUNC normalizeCode(code AS String) AS String
  RETURN checkedCode(code)
END FUNC

DOC
  FUNC isoCodes
  GROUP Codes
  DESC Every ISO 4217 code this package accepts, in ascending order.
  DESC
  DESC The list is ISO 4217 List One as published on the date
  DESC `currency::isoListDate` returns. It includes the fund codes (such as
  DESC `USN`) and the `X` codes for precious metals, the SDR, testing (`XTS`)
  DESC and no currency (`XXX`). A currency withdrawn before that date is not
  DESC in it.
  RET The codes, upper case and ascending.
  EXAMPLE
    IMPORT currency
    IMPORT io

    FUNC main() AS Nothing
      io::print(toString(len(currency::isoCodes())) & " codes, as of " & currency::isoListDate())
    END FUNC
  END EXAMPLE
END DOC
EXPORT FUNC isoCodes() AS List OF String
  RETURN isoCodeList()
END FUNC

DOC
  FUNC isoListDate
  GROUP Codes
  DESC The publication date of the ISO 4217 list committed with the package,
  DESC as `YYYY-MM-DD`.
  DESC
  DESC Codes come from this list and from nothing else, so every program built
  DESC with the same package version accepts the same codes. A newer list
  DESC arrives with a newer package version.
  RET The date, such as `2026-09-17`.
END DOC
EXPORT FUNC isoListDate() AS String
  RETURN isoPublished()
END FUNC

DOC
  FUNC minorUnits
  GROUP Codes
  DESC The number of decimal places a currency is booked to: 2 for `USD`,
  DESC 0 for `JPY`, 3 for `BHD`.
  DESC
  DESC A code with no minor unit returns 5, `Money`'s full precision. That is
  DESC every custom `_` code, and the ISO codes the list marks "N.A.", such as
  DESC gold (`XAU`) and the SDR (`XDR`).
  ARG code The currency code, in any case.
  RET The decimal places, 0 through 5.
  ERROR 93170001 `code` is not a valid currency code.
  EXAMPLE
    IMPORT currency
    IMPORT io

    FUNC main() AS Nothing
      io::print(toString(currency::minorUnits("USD")))    ' 2
      io::print(toString(currency::minorUnits("JPY")))    ' 0
      io::print(toString(currency::minorUnits("_GOLD")))  ' 5
    END FUNC
  END EXAMPLE
END DOC
EXPORT FUNC minorUnits(code AS String) AS Integer
  RETURN minorUnitsOf(checkedCode(code))
END FUNC

' The minor units of an already-canonical code.
PUBLIC FUNC minorUnitsOf(code AS String) AS Integer
  LET units AS Integer = isoMinorUnits(code)
  IF units < 0 THEN RETURN MONEY_DECIMALS
  RETURN units
END FUNC

' ---------------------------------------------------------------------------
' Building an amount
' ---------------------------------------------------------------------------

DOC
  FUNC amount
  GROUP Amounts
  DESC An `Amount` of `value` in the currency `code`.
  DESC
  DESC The code is checked and upper-cased, but it does not need a rate:
  DESC building an amount never reads the rates table.
  ARG value The amount.
  ARG code The currency code, in any case.
  RET The amount, with its code upper-cased.
  ERROR 93170001 `code` is not a valid currency code.
  EXAMPLE
    IMPORT currency
    IMPORT io

    FUNC main() AS Nothing
      LET price AS currency::Amount = currency::amount(12.5m, "usd")
      io::print(currency::format(price))   ' 12.50 USD
    END FUNC
  END EXAMPLE
END DOC
EXPORT FUNC amount(value AS Money, code AS String) AS Amount
  RETURN Amount[value := value, code := checkedCode(code)]
END FUNC

' `a` with its code checked and upper-cased.
PUBLIC FUNC checkedAmount(a AS Amount) AS Amount
  RETURN Amount[value := a.value, code := checkedCode(a.code)]
END FUNC
