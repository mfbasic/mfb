' ---------------------------------------------------------------------------
' Tests: the rates table.
'
' The table is module state shared by every case in this run, so each case
' that reads it starts from clearRates() or importRates().
' ---------------------------------------------------------------------------

IMPORT collections
IMPORT money

TESTING
  TGROUP "setRate and getRate"
    TCASE "a rate is stored under the upper-case code"
      clearRates()
      setRate("eur", money::toRate("1.25"))
      expectInteger(getRate("EUR").scaled, money::toRate("1.25").scaled)
      expectInteger(getRate("Eur").scaled, money::toRate("1.25").scaled)
      expectEqual(hasRate("EUR"), TRUE)
    END TCASE

    TCASE "setRate replaces an existing rate"
      clearRates()
      setRate("EUR", money::toRate("1.25"))
      setRate("eur", money::toRate("1.5"))
      expectInteger(getRate("EUR").scaled, money::toRate("1.5").scaled)
      expectInteger(len(exportRates()), 1)
    END TCASE

    TCASE "custom codes take rates"
      clearRates()
      setRate("_gold", money::toRate(64))
      expectInteger(getRate("_GOLD").scaled, money::toRate(64).scaled)
    END TCASE

    TCASE "a rate must be greater than zero"
      clearRates()
      ' money::toRate never makes these; a record built by hand can.
      expectTrap(setRate("EUR", money::Rate[scaled := 0]), ErrorInvalidRate)
      expectTrap(setRate("EUR", money::Rate[scaled := -1250000000000]), ErrorInvalidRate)
      expectEqual(hasRate("EUR"), FALSE)
    END TCASE

    TCASE "the smallest positive rate is a valid rate"
      clearRates()
      setRate("EUR", money::toRate("0.000000000001"))
      expectEqual(hasRate("EUR"), TRUE)
      expectInteger(getRate("EUR").scaled, 1)
    END TCASE

    TCASE "a rate is stored exactly as written"
      clearRates()
      setRate("EUR", money::toRate("0.842"))
      expectString(toString(getRate("EUR")), "0.842")
      expectInteger(getRate("EUR").scaled, 842000000000)
    END TCASE

    TCASE "setRate refuses a hand-built zero rate"
      clearRates()
      expectTrap(setRate("EUR", money::Rate[scaled := 0]), ErrorInvalidRate)
      expectInteger(len(exportRates()), 0)
    END TCASE

    TCASE "setRate checks the code"
      clearRates()
      expectTrap(setRate("EURO", money::toRate(1)), ErrorInvalidCode)
      expectTrap(setRate("ABC", money::toRate(1)), ErrorInvalidCode)
      expectInteger(len(exportRates()), 0)
    END TCASE

    TCASE "getRate of a code with no rate"
      clearRates()
      expectTrap(getRate("EUR"), ErrorUnknownCurrency)
      expectTrap(getRate("EURO"), ErrorInvalidCode)
    END TCASE
  END TGROUP

  TGROUP "removeRate and clearRates"
    TCASE "removeRate removes the code, in any case"
      clearRates()
      setRate("USD", money::toRate(1))
      setRate("EUR", money::toRate("1.25"))
      removeRate("eur")
      expectEqual(hasRate("EUR"), FALSE)
      expectEqual(hasRate("USD"), TRUE)
    END TCASE

    TCASE "removing a code with no rate does nothing"
      clearRates()
      setRate("USD", money::toRate(1))
      expectNTrap(removeRate("EUR"))
      expectInteger(len(exportRates()), 1)
    END TCASE

    TCASE "removeRate checks the code"
      clearRates()
      expectTrap(removeRate("EURO"), ErrorInvalidCode)
    END TCASE

    TCASE "clearRates empties the table"
      clearRates()
      setRate("USD", money::toRate(1))
      setRate("EUR", money::toRate("1.25"))
      clearRates()
      expectInteger(len(exportRates()), 0)
    END TCASE

    TCASE "hasRate checks the code"
      expectTrap(hasRate("EURO"), ErrorInvalidCode)
    END TCASE
  END TGROUP

  TGROUP "base currency"
    TCASE "a table with a rate of exactly 1 has a base currency"
      clearRates()
      expectEqual(hasBaseCurrency(), FALSE)
      setRate("EUR", money::toRate("1.25"))
      expectEqual(hasBaseCurrency(), FALSE)
      setRate("USD", money::toRate(1))
      expectEqual(hasBaseCurrency(), TRUE)
      removeRate("USD")
      expectEqual(hasBaseCurrency(), FALSE)
    END TCASE

    TCASE "two currencies may both have rate 1"
      clearRates()
      setRate("USD", money::toRate(1))
      setRate("_POINTS", money::toRate(1))
      expectEqual(hasBaseCurrency(), TRUE)
    END TCASE
  END TGROUP

  TGROUP "exportRates and importRates"
    TCASE "exportRates returns a copy"
      clearRates()
      setRate("USD", money::toRate(1))
      MUT copy AS Map OF String TO money::Rate = exportRates()
      copy = collections::set(copy, "EUR", money::toRate("1.25"))
      expectEqual(hasRate("EUR"), FALSE)
      expectInteger(len(exportRates()), 1)
    END TCASE

    TCASE "exportRates then importRates round-trips"
      clearRates()
      setRate("USD", money::toRate(1))
      setRate("EUR", money::toRate("1.25"))
      setRate("_GOLD", money::toRate(64))
      LET saved AS Map OF String TO money::Rate = exportRates()
      clearRates()
      importRates(saved)
      expectInteger(len(exportRates()), 3)
      expectInteger(getRate("USD").scaled, money::toRate(1).scaled)
      expectInteger(getRate("EUR").scaled, money::toRate("1.25").scaled)
      expectInteger(getRate("_GOLD").scaled, money::toRate(64).scaled)
    END TCASE

    TCASE "importRates replaces the whole table and upper-cases keys"
      clearRates()
      setRate("GBP", money::toRate("1.5"))
      importRates(Map OF String TO money::Rate { "usd" := money::toRate(1), "_gold" := money::toRate(64) })
      expectEqual(hasRate("GBP"), FALSE)
      expectInteger(getRate("USD").scaled, money::toRate(1).scaled)
      expectInteger(getRate("_GOLD").scaled, money::toRate(64).scaled)
      expectEqual(collections::hasKey(exportRates(), "USD"), TRUE)
      expectEqual(collections::hasKey(exportRates(), "usd"), FALSE)
    END TCASE

    TCASE "importRates does not need a base currency"
      clearRates()
      importRates(Map OF String TO money::Rate { "EUR" := money::toRate("1.25") })
      expectInteger(getRate("EUR").scaled, money::toRate("1.25").scaled)
      expectEqual(hasBaseCurrency(), FALSE)
    END TCASE

    TCASE "importing an empty map empties the table"
      clearRates()
      setRate("USD", money::toRate(1))
      importRates(Map OF String TO money::Rate {})
      expectInteger(len(exportRates()), 0)
    END TCASE

    TCASE "a bad code leaves the table unchanged"
      clearRates()
      setRate("USD", money::toRate(1))
      expectTrap(importRates(Map OF String TO money::Rate { "EUR" := money::toRate("1.25"), "EURO" := money::toRate(1) }), ErrorInvalidCode)
      expectInteger(len(exportRates()), 1)
      expectInteger(getRate("USD").scaled, money::toRate(1).scaled)
    END TCASE

    TCASE "a bad rate leaves the table unchanged"
      clearRates()
      setRate("USD", money::toRate(1))
      expectTrap(importRates(Map OF String TO money::Rate { "EUR" := money::toRate("1.25"), "GBP" := money::Rate[scaled := 0] }), ErrorInvalidRate)
      expectInteger(len(exportRates()), 1)
      expectInteger(getRate("USD").scaled, money::toRate(1).scaled)
    END TCASE

    TCASE "keys that differ only in case must agree"
      clearRates()
      importRates(Map OF String TO money::Rate { "eur" := money::toRate("1.25"), "EUR" := money::toRate("1.25") })
      expectInteger(len(exportRates()), 1)
      clearRates()
      expectTrap(importRates(Map OF String TO money::Rate { "eur" := money::toRate("1.25"), "EUR" := money::toRate("1.5") }), ErrorInvalidCode)
      expectInteger(len(exportRates()), 0)
    END TCASE

    TCASE "importRates refuses a hand-built zero rate"
      clearRates()
      expectTrap(importRates(Map OF String TO money::Rate { "EUR" := money::Rate[scaled := 0] }), ErrorInvalidRate)
      expectInteger(len(exportRates()), 0)
    END TCASE
  END TGROUP

  TGROUP "exact rates"
    ' 10000000000 / 0.0067 = 1492537313432.835820895..., 1492537313432.83582 at
    ' five places. The base-currency value never has to fit Money on the way.
    TCASE "a large amount converts at a small rate"
      importRates(Map OF String TO money::Rate { "USD" := money::toRate(1), "JPY" := money::toRate("0.0067") })
      expectEqual(convert(amount(10000000000m, "USD"), "JPY").value, 1492537313432.83582m)
    END TCASE
  END TGROUP
END TESTING
