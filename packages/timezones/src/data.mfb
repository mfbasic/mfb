' The zone string for a name, ignoring case; "" for an unknown name.
FUNC zoneData(name AS String) AS String
  IF len(name) = 0 THEN RETURN ""
  LET key AS String = strings::lower(name)
  MATCH strings::left(key, 1)
    CASE "a" : RETURN zonesA(key)
    CASE "b" : RETURN zonesB(key)
    CASE "c" : RETURN zonesC(key)
    CASE "e" : RETURN zonesE(key)
    CASE "f" : RETURN zonesF(key)
    CASE "g" : RETURN zonesG(key)
    CASE "h" : RETURN zonesH(key)
    CASE "i" : RETURN zonesI(key)
    CASE "j" : RETURN zonesJ(key)
    CASE "k" : RETURN zonesK(key)
    CASE "l" : RETURN zonesL(key)
    CASE "m" : RETURN zonesM(key)
    CASE "n" : RETURN zonesN(key)
    CASE "p" : RETURN zonesP(key)
    CASE "r" : RETURN zonesR(key)
    CASE "s" : RETURN zonesS(key)
    CASE "t" : RETURN zonesT(key)
    CASE "u" : RETURN zonesU(key)
    CASE "w" : RETURN zonesW(key)
    CASE "z" : RETURN zonesZ(key)
    CASE ELSE : RETURN ""
  END MATCH
END FUNC

' The tzdb spelling of a name, ignoring case; "" for an unknown name.
FUNC canonicalName(name AS String) AS String
  IF len(name) = 0 THEN RETURN ""
  LET key AS String = strings::lower(name)
  MATCH strings::left(key, 1)
    CASE "a" : RETURN namesA(key)
    CASE "b" : RETURN namesB(key)
    CASE "c" : RETURN namesC(key)
    CASE "e" : RETURN namesE(key)
    CASE "f" : RETURN namesF(key)
    CASE "g" : RETURN namesG(key)
    CASE "h" : RETURN namesH(key)
    CASE "i" : RETURN namesI(key)
    CASE "j" : RETURN namesJ(key)
    CASE "k" : RETURN namesK(key)
    CASE "l" : RETURN namesL(key)
    CASE "m" : RETURN namesM(key)
    CASE "n" : RETURN namesN(key)
    CASE "p" : RETURN namesP(key)
    CASE "r" : RETURN namesR(key)
    CASE "s" : RETURN namesS(key)
    CASE "t" : RETURN namesT(key)
    CASE "u" : RETURN namesU(key)
    CASE "w" : RETURN namesW(key)
    CASE "z" : RETURN namesZ(key)
    CASE ELSE : RETURN ""
  END MATCH
END FUNC

