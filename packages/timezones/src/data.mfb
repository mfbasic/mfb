    CASE "chile/continental" : RETURN "Chile/Continental"
    CASE "chile/easterisland" : RETURN "Chile/EasterIsland"
    CASE "cuba" : RETURN "Cuba"
    CASE ELSE : RETURN ""
  END MATCH
END FUNC

