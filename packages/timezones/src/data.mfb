PRIVATE FUNC namesB(key AS String) AS String
  MATCH key
    CASE "brazil/acre" : RETURN "Brazil/Acre"
    CASE "brazil/denoronha" : RETURN "Brazil/DeNoronha"
    CASE "brazil/east" : RETURN "Brazil/East"
    CASE "brazil/west" : RETURN "Brazil/West"
    CASE ELSE : RETURN ""
  END MATCH
END FUNC

PRIVATE FUNC namesC(key AS String) AS String
  MATCH key
    CASE "cet" : RETURN "CET"
    CASE "cst6cdt" : RETURN "CST6CDT"
    CASE "canada/atlantic" : RETURN "Canada/Atlantic"
    CASE "canada/central" : RETURN "Canada/Central"
    CASE "canada/eastern" : RETURN "Canada/Eastern"
