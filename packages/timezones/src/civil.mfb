' ---------------------------------------------------------------------------
' timezones/civil.mfb — a wall-clock reading in a named zone, as an instant.
'
' Twice a year a reading is skipped (clocks spring forward past it) or happens
' twice (clocks fall back through it). The caller says how to resolve each case
' with a `Disambiguation`, the same four choices Temporal's `disambiguation`
' option offers:
'   - Compatible and Earlier: a skipped reading moves forward by the length of
'     the gap (the offset before the change is used), and a repeated reading is
'     the earlier of its two instants. Compatible is what Python zoneinfo does
'     with fold=0.
'   - Later: a skipped reading is the offset after the change, so it moves back
'     by the gap, and a repeated reading is the later instant. This is zoneinfo's
'     fold=1.
'   - Reject: a skipped or repeated reading is refused (77050002).
'
' The offset in force is one of at most two values near the reading. Let L be
' the reading counted as if it were UTC. Every candidate instant is L - utoff,
' and plan-135-A's generator guarantees |utoff| < W = 172800 and that a zone's
' transitions are more than 2W apart. So [L - W, L + W] holds both candidates
' and at most one transition, and the offsets at its two ends are the offsets
' either side of that transition.
' ---------------------------------------------------------------------------

IMPORT datetime

' The instant a wall-clock reading in `name` is, with a clock change that skips
' or repeats the reading resolved by `disambiguation`.
FUNC zonedCivil(date AS datetime::Date, time AS datetime::Time, name AS String, disambiguation AS Disambiguation) AS datetime::DateTime
  LET window AS Integer = 172800
  ' Rebuilding both values validates every calendar field (77050002), so a
  ' `datetime::Date[2026, 2, 30]` literal cannot slip through.
  LET d AS datetime::Date = datetime::date(date.year, date.month, date.day)
  LET t AS datetime::Time = datetime::time(time.hour, time.minute, time.second, time.nanos)
  LET wall AS Integer = datetime::resolve(datetime::civil(d, datetime::time(t.hour, t.minute, t.second, 0), datetime::utc())).seconds

  LET offsetBefore AS Integer = localTypeAt(name, wall - window).utoff
  LET offsetAfter AS Integer = localTypeAt(name, wall + window).utoff
  ' The instant the reading names under each of the two offsets.
  LET before AS Integer = wall - offsetBefore
  LET after AS Integer = wall - offsetAfter
  LET beforeFits AS Boolean = localTypeAt(name, before).utoff = offsetBefore
  MUT afterFits AS Boolean = FALSE
  IF offsetAfter <> offsetBefore THEN afterFits = localTypeAt(name, after).utoff = offsetAfter

  ' A reading that only the offset before the change gives is an ordinary
  ' reading before the change, and one only the offset after gives is an
  ' ordinary reading after it. Both fitting is a repeated reading.
  MUT chosen AS Integer = before
  IF beforeFits = FALSE AND afterFits THEN chosen = after

  IF beforeFits AND afterFits THEN
    IF disambiguation = Disambiguation.REJECT THEN FAIL repeatedReading(d, t, name)
    MUT earlier AS Integer = before
    MUT later AS Integer = after
    IF after < before THEN
      earlier = after
      later = before
    END IF
    chosen = earlier
    IF disambiguation = Disambiguation.LATER THEN chosen = later
  END IF

  ' Neither fitting is a skipped reading.
  IF beforeFits = FALSE AND afterFits = FALSE THEN
    IF disambiguation = Disambiguation.REJECT THEN FAIL skippedReading(d, t, name)
    chosen = before
    IF disambiguation = Disambiguation.LATER THEN chosen = after
  END IF

  LET at AS datetime::Instant = datetime::instant(chosen, t.nanos)
  LET found AS LocalType = localTypeAt(name, chosen)
  RETURN datetime::inZone(at, fixedZone(found.utoff, found.abbreviation))
END FUNC

' "2026-03-08 02:30:00", for the messages below.
PRIVATE FUNC readingText(d AS datetime::Date, t AS datetime::Time) AS String
  RETURN toString(d.year) & "-" & toString(d.month) & "-" & toString(d.day) & " " & toString(t.hour) & ":" & toString(t.minute) & ":" & toString(t.second)
END FUNC

PRIVATE FUNC skippedReading(d AS datetime::Date, t AS datetime::Time, name AS String) AS Error
  RETURN error(77050002, "timezones: " & readingText(d, t) & " does not occur in " & canonicalName(name) & ": a clock change skips it")
END FUNC

PRIVATE FUNC repeatedReading(d AS datetime::Date, t AS datetime::Time, name AS String) AS Error
  RETURN error(77050002, "timezones: " & readingText(d, t) & " occurs twice in " & canonicalName(name) & ": a clock change repeats it")
END FUNC
