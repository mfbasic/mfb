' ---------------------------------------------------------------------------
' Tests: civil, a wall-clock reading in a named zone.
'
' Every expected value comes from Python zoneinfo with fold=0, never from this
' package, run in the oracle venv (tzdata==2026.4, IANA 2026d) with the host
' search path disabled:
'
'   packages/timezones/oracle/.venv/bin/python -c 'import zoneinfo; zoneinfo.reset_tzpath([]);
'     from zoneinfo import ZoneInfo; from datetime import datetime, timezone;
'     d = datetime(Y, M, D, h, m, s, tzinfo=ZoneInfo(NAME), fold=0);
'     u = d.astimezone(timezone.utc).astimezone(ZoneInfo(NAME));
'     print(int(d.timestamp()), u.isoformat())'
'
' The isoformat is the normalised wall reading: a skipped reading prints the
' later wall clock it became. Each case's comment gives the answers.
' ---------------------------------------------------------------------------

IMPORT datetime

PRIVATE FUNC reading(y AS Integer, mo AS Integer, d AS Integer, h AS Integer, mi AS Integer, s AS Integer, name AS String) AS datetime::DateTime
  RETURN civil(datetime::date(y, mo, d), datetime::time(h, mi, s, 0), name)
END FUNC

PRIVATE FUNC shows(dt AS datetime::DateTime) AS String
  RETURN toString(datetime::resolve(dt).seconds) & " " & datetime::toIso(dt) & " " & dt.zone.label
END FUNC

TESTING
  TGROUP "civil"
    ' (2026,1,15,9,0,0) -> 1768485600 2026-01-15T09:00:00-05:00;
    ' (2026,7,15,9,0,0) -> 1784120400 2026-07-15T09:00:00-04:00.
    TCASE "New York at 09:00 in January and July 2026"
      expectString(shows(reading(2026, 1, 15, 9, 0, 0, "America/New_York")), "1768485600 2026-01-15T09:00:00.000-05:00 EST")
      expectString(shows(reading(2026, 7, 15, 9, 0, 0, "America/New_York")), "1784120400 2026-07-15T09:00:00.000-04:00 EDT")
      expectInteger(reading(2026, 1, 15, 9, 0, 0, "America/New_York").offset, -18000)
      expectInteger(reading(2026, 7, 15, 9, 0, 0, "America/New_York").offset, -14400)
    END TCASE

    ' (2026,3,8,2,30,0) -> 1772955000 2026-03-08T03:30:00-04:00;
    ' (2026,3,8,2,0,0) -> 1772953200 2026-03-08T03:00:00-04:00;
    ' (2026,3,8,2,59,59) -> 1772956799 2026-03-08T03:59:59-04:00;
    ' (2026,3,8,1,59,59) -> 1772953199 2026-03-08T01:59:59-05:00.
    TCASE "a skipped reading moves forward by the gap"
      expectString(shows(reading(2026, 3, 8, 2, 30, 0, "America/New_York")), "1772955000 2026-03-08T03:30:00.000-04:00 EDT")
      expectString(shows(reading(2026, 3, 8, 2, 0, 0, "America/New_York")), "1772953200 2026-03-08T03:00:00.000-04:00 EDT")
      expectString(shows(reading(2026, 3, 8, 2, 59, 59, "America/New_York")), "1772956799 2026-03-08T03:59:59.000-04:00 EDT")
      expectString(shows(reading(2026, 3, 8, 1, 59, 59, "America/New_York")), "1772953199 2026-03-08T01:59:59.000-05:00 EST")
    END TCASE

    ' (2026,11,1,1,30,0) -> 1793511000 2026-11-01T01:30:00-04:00;
    ' (2026,11,1,1,0,0) -> 1793509200 2026-11-01T01:00:00-04:00;
    ' (2026,11,1,1,59,59) -> 1793512799 2026-11-01T01:59:59-04:00;
    ' (2026,11,1,2,0,0) -> 1793516400 2026-11-01T02:00:00-05:00.
    TCASE "a repeated reading resolves to the earlier instant"
      expectString(shows(reading(2026, 11, 1, 1, 30, 0, "America/New_York")), "1793511000 2026-11-01T01:30:00.000-04:00 EDT")
      expectString(shows(reading(2026, 11, 1, 1, 0, 0, "America/New_York")), "1793509200 2026-11-01T01:00:00.000-04:00 EDT")
      expectString(shows(reading(2026, 11, 1, 1, 59, 59, "America/New_York")), "1793512799 2026-11-01T01:59:59.000-04:00 EDT")
      expectString(shows(reading(2026, 11, 1, 2, 0, 0, "America/New_York")), "1793516400 2026-11-01T02:00:00.000-05:00 EST")
    END TCASE

    ' Australia/Lord_Howe's 30-minute changes.
    ' (2026,4,5,1,30,0) -> 1775313000 2026-04-05T01:30:00+11:00;
    ' (2026,4,5,1,45,0) -> 1775313900 2026-04-05T01:45:00+11:00;
    ' (2026,4,5,2,0,0) -> 1775316600 2026-04-05T02:00:00+10:30;
    ' (2026,10,4,2,15,0) -> 1791042300 2026-10-04T02:45:00+11:00.
    TCASE "Lord Howe's 30-minute overlap and gap"
      expectString(shows(reading(2026, 4, 5, 1, 30, 0, "Australia/Lord_Howe")), "1775313000 2026-04-05T01:30:00.000+11:00 +11")
      expectString(shows(reading(2026, 4, 5, 1, 45, 0, "Australia/Lord_Howe")), "1775313900 2026-04-05T01:45:00.000+11:00 +11")
      expectString(shows(reading(2026, 4, 5, 2, 0, 0, "Australia/Lord_Howe")), "1775316600 2026-04-05T02:00:00.000+10:30 +1030")
      expectString(shows(reading(2026, 10, 4, 2, 15, 0, "Australia/Lord_Howe")), "1791042300 2026-10-04T02:45:00.000+11:00 +11")
    END TCASE

    ' Pacific/Apia skipped all of 2011-12-30.
    ' (2011,12,29,23,59,59) -> 1325239199 2011-12-29T23:59:59-10:00;
    ' (2011,12,30,0,0,0) -> 1325239200 2011-12-31T00:00:00+14:00;
    ' (2011,12,30,12,0,0) -> 1325282400 2011-12-31T12:00:00+14:00;
    ' (2011,12,31,0,0,0) -> 1325239200 2011-12-31T00:00:00+14:00.
    TCASE "Apia's skipped day moves forward 24 hours"
      expectString(shows(reading(2011, 12, 29, 23, 59, 59, "Pacific/Apia")), "1325239199 2011-12-29T23:59:59.000-10:00 -10")
      expectString(shows(reading(2011, 12, 30, 0, 0, 0, "Pacific/Apia")), "1325239200 2011-12-31T00:00:00.000+14:00 +14")
      expectString(shows(reading(2011, 12, 30, 12, 0, 0, "Pacific/Apia")), "1325282400 2011-12-31T12:00:00.000+14:00 +14")
      expectString(shows(reading(2011, 12, 31, 0, 0, 0, "Pacific/Apia")), "1325239200 2011-12-31T00:00:00.000+14:00 +14")
    END TCASE

    ' Pacific/Kwajalein jumped from -12 to +12 in 1993, skipping 1993-08-21.
    ' (1993,8,20,23,59,59) -> 745934399 1993-08-20T23:59:59-12:00;
    ' (1993,8,21,12,0,0) -> 745977600 1993-08-22T12:00:00+12:00;
    ' (1993,8,22,0,0,0) -> 745934400 1993-08-22T00:00:00+12:00.
    TCASE "Kwajalein's 1993 jump across the date line"
      expectString(shows(reading(1993, 8, 20, 23, 59, 59, "Pacific/Kwajalein")), "745934399 1993-08-20T23:59:59.000-12:00 -12")
      expectString(shows(reading(1993, 8, 21, 12, 0, 0, "Pacific/Kwajalein")), "745977600 1993-08-22T12:00:00.000+12:00 +12")
      expectString(shows(reading(1993, 8, 22, 0, 0, 0, "Pacific/Kwajalein")), "745934400 1993-08-22T00:00:00.000+12:00 +12")
    END TCASE

    ' (2026,7,15,9,0,0) -> 1784120400 2026-07-15T09:00:00-04:00; the nanoseconds
    ' ride along unchanged.
    TCASE "nanoseconds are preserved"
      LET dt AS datetime::DateTime = civil(datetime::date(2026, 7, 15), datetime::time(9, 0, 0, 123456789), "America/New_York")
      expectInteger(datetime::resolve(dt).seconds, 1784120400)
      expectInteger(datetime::resolve(dt).nanos, 123456789)
      expectString(datetime::toIso(dt, 9), "2026-07-15T09:00:00.123456789-04:00")
    END TCASE

    TCASE "an impossible calendar field raises ErrInvalidArgument"
      expectTrap(civil(datetime::Date[2026, 2, 30], datetime::time(9, 0, 0, 0), "America/New_York"), 77050002)
      expectTrap(civil(datetime::date(2026, 7, 15), datetime::Time[24, 0, 0, 0], "America/New_York"), 77050002)
    END TCASE

    TCASE "an unknown zone raises ErrNotFound"
      expectTrap(civil(datetime::date(2026, 7, 15), datetime::time(9, 0, 0, 0), "Nowhere/Bogus"), 77050004)
    END TCASE
  END TGROUP
END TESTING
