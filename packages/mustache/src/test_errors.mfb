' ---------------------------------------------------------------------------
' Tests: the templates this package refuses, and the code it refuses them with.
'
' Every one of these is a typo an author makes, so each has to fail loudly
' rather than render something plausible: a template that silently drops a
' misspelled closing tag produces a page missing a section, which is much harder
' to find than an error.
' ---------------------------------------------------------------------------

IMPORT errorCode
IMPORT json

PRIVATE FUNC bad(template AS String) AS String
  RETURN render(template, json::parse("{\"a\":true,\"b\":true}"))
END FUNC

TESTING
  TGROUP "malformed templates"
    TCASE "an unclosed tag is refused"
      expectTrap(bad("{{a"), errorCode::ErrInvalidFormat)
      expectTrap(bad("text {{"), errorCode::ErrInvalidFormat)
      expectTrap(bad("{{#a}}x{{/a"), errorCode::ErrInvalidFormat)
      expectTrap(bad("{{{a}}"), errorCode::ErrInvalidFormat)
      expectTrap(bad("{{{a"), errorCode::ErrInvalidFormat)
    END TCASE

    TCASE "a close with nothing open is refused"
      expectTrap(bad("{{/a}}"), errorCode::ErrInvalidFormat)
      expectTrap(bad("{{#a}}x{{/a}}{{/a}}"), errorCode::ErrInvalidFormat)
    END TCASE

    TCASE "a close naming a different section is refused"
      expectTrap(bad("{{#a}}x{{/b}}"), errorCode::ErrInvalidFormat)
      expectTrap(bad("{{#a}}{{#b}}x{{/a}}{{/b}}"), errorCode::ErrInvalidFormat)
    END TCASE

    TCASE "a section left open is refused"
      expectTrap(bad("{{#a}}x"), errorCode::ErrInvalidFormat)
      expectTrap(bad("{{^a}}x"), errorCode::ErrInvalidFormat)
      expectTrap(bad("{{#a}}{{#b}}x{{/b}}"), errorCode::ErrInvalidFormat)
    END TCASE

    TCASE "an inverted section closes with the same tag a section does"
      expectNTrap(bad("{{^a}}x{{/a}}"))
      expectTrap(bad("{{^a}}x{{/b}}"), errorCode::ErrInvalidFormat)
    END TCASE

    TCASE "a stray brace or an unknown sigil is ordinary text or an ordinary name"
      expectString(render("a } b { c", json::JsonNull[NOTHING]), "a } b { c")
      expectString(render("[{{@x}}]", json::parse("{\"@x\":\"at\"}")), "[at]")
      expectString(render("[{{}}]", json::parse("{}")), "[]")
      expectString(render("[{{   }}]", json::parse("{}")), "[]")
    END TCASE

    TCASE "every failure is the registry code the docs name"
      expectInteger(errorCode::ErrInvalidFormat, 77050003)
      expectInteger(errorCode::ErrDepthExceeded, 77050024)
      expectInteger(errorCode::ErrTooLarge, 77050027)
      expectInteger(errorCode::ErrInvalidArgument, 77050002)
    END TCASE
  END TGROUP
END TESTING
