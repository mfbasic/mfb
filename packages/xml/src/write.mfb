' ---------------------------------------------------------------------------
' xml/write.mfb — the serializer.
'
' `writeDocument` and `writeFragment` write a tree back as XML whose CONTENT
' (see content.mfb) equals the tree's. Formatting is free to change; content is
' not.
'
' The writer refuses a tree it cannot write faithfully rather than emitting XML
' that the reader would reject or read back differently. The rules it applies
' are the reader's own, from names.mfb: a name must be a Name and a QName, a
' declaration must be legal, no two attributes may share a name or an expanded
' name, and a document's prefixes must be declared in scope.
'
' Output is built through a List OF String joined once per node, never by
' appending to a String in a loop, which is quadratic in the document size.
' ---------------------------------------------------------------------------

IMPORT collections
IMPORT strings

' Refuse a string that holds a scalar XML 1.0 does not allow. The reader can
' never produce one, but a hand-built tree can.
PRIVATE FUNC requireWritableText(what AS String, s AS String) AS Nothing
  FOR EACH sc IN strings::toScalars(s)
    IF NOT isChar(toInt(sc)) THEN
      FAIL error(ERR_ARGUMENT, "xml: " & what & " holds U+" & toString(toInt(sc)) & ", which XML 1.0 does not allow")
    END IF
  NEXT
  RETURN NOTHING
END FUNC

' Refuse a name that is not a Name, or that is not a legal QName.
PRIVATE FUNC requireWritableName(what AS String, name AS String) AS Nothing
  IF NOT isName(name) THEN
    FAIL error(ERR_ARGUMENT, "xml: `" & name & "` is not a valid XML " & what)
  END IF
  LET problem AS String = qnameProblem(name)
  IF problem <> "" THEN
    FAIL error(ERR_ARGUMENT, "xml: " & what & " " & problem)
  END IF
  RETURN NOTHING
END FUNC

' Escape character data.
'
' `>` is always escaped, not only where it would close a CDATA section: that
' makes `]]>` impossible to emit by accident. A literal #xD is written as a
' character reference because the reader normalizes a literal one to #xA
' (§2.11), which would silently change the text on the way back in.
PUBLIC FUNC escapeText(s AS String) AS String
  requireWritableText("text", s)
  MUT parts AS List OF String = []
  FOR EACH sc IN strings::toScalars(s)
    LET code AS Integer = toInt(sc)
    IF code = B_AMP THEN
      parts = collections::append(parts, "&amp;")
    ELSEIF code = B_LT THEN
      parts = collections::append(parts, "&lt;")
    ELSEIF code = B_GT THEN
      parts = collections::append(parts, "&gt;")
    ELSEIF code = B_CR THEN
      parts = collections::append(parts, "&#13;")
    ELSE
      parts = collections::append(parts, toString(sc))
    END IF
  NEXT
  RETURN strings::join(parts, "")
END FUNC

' Escape an attribute value. Values are always double-quoted, so `"` is escaped
' and `'` is not. Tab, line feed and carriage return are written as character
' references because §3.3.3 attribute-value normalization turns a literal one
' into a space when the value is read back.
PUBLIC FUNC escapeAttribute(s AS String) AS String
  requireWritableText("an attribute value", s)
  MUT parts AS List OF String = []
  FOR EACH sc IN strings::toScalars(s)
    LET code AS Integer = toInt(sc)
    IF code = B_AMP THEN
      parts = collections::append(parts, "&amp;")
    ELSEIF code = B_LT THEN
      parts = collections::append(parts, "&lt;")
    ELSEIF code = B_DQUOTE THEN
      parts = collections::append(parts, "&quot;")
    ELSEIF code = B_TAB THEN
      parts = collections::append(parts, "&#9;")
    ELSEIF code = B_LF THEN
      parts = collections::append(parts, "&#10;")
    ELSEIF code = B_CR THEN
      parts = collections::append(parts, "&#13;")
    ELSE
      parts = collections::append(parts, toString(sc))
    END IF
  NEXT
  RETURN strings::join(parts, "")
END FUNC

' Refuse an element whose own name, attributes or namespace declarations would
' not read back. Returns the scope its children are written in.
'
' `strict` is TRUE for a document. A fragment is written for embedding in a
' document that declares its prefixes, so a prefix it uses is not checked there;
' every other rule still applies to it.
PRIVATE FUNC requireWritableElement(e AS Element, scope AS List OF Binding, strict AS Boolean) AS List OF Binding
  requireWritableName("element name", e.name)
  FOR EACH a IN e.attributes
    requireWritableName("attribute name", a.name)
    LET declares AS String = declarationProblem(a.name, a.value)
    IF declares <> "" THEN
      FAIL error(ERR_ARGUMENT, "xml: " & declares)
    END IF
  NEXT
  LET repeated AS Integer = duplicateIndex(e.attributes)
  IF repeated >= 0 THEN
    FAIL error(ERR_ARGUMENT, "xml: attribute `" & collections::get(e.attributes, repeated).name & "` appears twice on the same element")
  END IF
  LET inner AS List OF Binding = extendScope(scope, e.attributes)
  IF strict THEN
    LET elementPrefix AS String = prefixProblem(e.name, inner)
    IF elementPrefix <> "" THEN
      FAIL error(ERR_ARGUMENT, "xml: " & elementPrefix)
    END IF
    FOR EACH a IN e.attributes
      IF prefixOf(a.name) <> "xmlns" THEN
        LET attributePrefix AS String = prefixProblem(a.name, inner)
        IF attributePrefix <> "" THEN
          FAIL error(ERR_ARGUMENT, "xml: " & attributePrefix)
        END IF
      END IF
    NEXT
  END IF
  LET collision AS Integer = expandedNameIndex(e.attributes, inner)
  IF collision >= 0 THEN
    FAIL error(ERR_ARGUMENT, "xml: attribute `" & collections::get(e.attributes, collision).name & "` has the same expanded name as an earlier attribute")
  END IF
  RETURN inner
END FUNC

' An element's start-tag attributes, already checked by requireWritableElement.
PRIVATE FUNC writeAttributes(attributes AS List OF Attribute) AS String
  MUT parts AS List OF String = []
  FOR EACH a IN attributes
    parts = collections::append(parts, " " & a.name & "=\"" & escapeAttribute(a.value) & "\"")
  NEXT
  RETURN strings::join(parts, "")
END FUNC

' A comment, refused when it could not be read back: `--` may not appear inside
' one, and a comment ending in `-` would produce `--->`.
PRIVATE FUNC writeComment(s AS String) AS String
  requireWritableText("a comment", s)
  IF strings::contains(s, "--") THEN
    FAIL error(ERR_ARGUMENT, "xml: a comment may not hold `--`")
  END IF
  IF len(s) > 0 AND strings::endsWith(s, "-") THEN
    FAIL error(ERR_ARGUMENT, "xml: a comment may not end with `-`")
  END IF
  RETURN "<!--" & s & "-->"
END FUNC

' A processing instruction, refused when its target is reserved, is not an
' NCName, or its data would close it early.
PRIVATE FUNC writeProcessingInstruction(target AS String, data AS String) AS String
  requireWritableName("processing-instruction target", target)
  IF strings::contains(target, ":") THEN
    FAIL error(ERR_ARGUMENT, "xml: a processing-instruction target may not hold a colon (`" & target & "`)")
  END IF
  requireWritableText("processing-instruction data", data)
  IF strings::lower(target) = "xml" THEN
    FAIL error(ERR_ARGUMENT, "xml: `" & target & "` is a reserved processing-instruction target")
  END IF
  IF strings::contains(data, "?>") THEN
    FAIL error(ERR_ARGUMENT, "xml: processing-instruction data may not hold `?>`")
  END IF
  IF len(data) = 0 THEN RETURN "<?" & target & "?>"
  RETURN "<?" & target & " " & data & "?>"
END FUNC

' Write one node compactly, at `depth` levels of element nesting (the root is 1).
' The bound is on elements, as the reader's is, so a hand-built tree deeper than
' DEPTH_LIMIT is refused before the writer descends into it.
PRIVATE FUNC writeNodeCompact(n AS Node, depth AS Integer, scope AS List OF Binding, strict AS Boolean) AS String
  MUT out AS String = ""
  MATCH n
    CASE Element(e)
      IF depth > DEPTH_LIMIT THEN
        FAIL error(ERR_DEPTH, "xml: the tree nests more than " & toString(DEPTH_LIMIT) & " levels deep")
      END IF
      LET inner AS List OF Binding = requireWritableElement(e, scope, strict)
      LET head AS String = "<" & e.name & writeAttributes(e.attributes)
      IF len(e.children) = 0 THEN
        out = head & "/>"
      ELSE
        MUT parts AS List OF String = []
        parts = collections::append(parts, head & ">")
        FOR EACH k IN e.children
          parts = collections::append(parts, writeNodeCompact(k, depth + 1, inner, strict))
        NEXT
        parts = collections::append(parts, "</" & e.name & ">")
        out = strings::join(parts, "")
      END IF
    CASE Text(t)
      out = escapeText(t.text)
    CASE Comment(c)
      out = writeComment(c.text)
    CASE ProcessingInstruction(p)
      out = writeProcessingInstruction(p.target, p.data)
  END MATCH
  RETURN out
END FUNC

' Refuse a document that is not one: XML requires exactly one root element, and
' no text at the top level.
PRIVATE FUNC requireWritableDocument(doc AS Document) AS Nothing
  MUT elements AS Integer = 0
  FOR EACH n IN doc.children
    MATCH n
      CASE Element(e)
        elements = elements + 1
      CASE Text(t)
        FAIL error(ERR_ARGUMENT, "xml: a document may not hold text outside its root element")
      CASE ELSE
    END MATCH
  NEXT
  IF elements <> 1 THEN
    FAIL error(ERR_ARGUMENT, "xml: a document must hold exactly one root element, not " & toString(elements))
  END IF
  RETURN NOTHING
END FUNC

' The XML declaration every written document carries. Output is always UTF-8.
PUBLIC LET DECLARATION AS String = "<?xml version=\"1.0\" encoding=\"UTF-8\"?>"

' ---------------------------------------------------------------------------
' Pretty printing.
'
' The rule that keeps pretty output CONTENT-identical to compact output: an
' element's children go on their own lines only when the element has no data
' text child. Indenting inside mixed content would insert text that was never
' there -- `<p>Hello <b>x</b></p>` pretty-printed across lines reads back with
' different text -- so an element holding data text is written exactly as
' compact, children and all.
'
' A whitespace-only text node is layout ONLY when the element also has an
' element child. `<a>   </a>` therefore holds data, and is left inline;
' `<a> <b/> </a>` holds layout, which is dropped and replaced by the writer's own
' newlines and indentation.
' ---------------------------------------------------------------------------

' The indentation a count asks for: clamped to 0..10 spaces, matching
' json::stringify. 0 means compact.
PUBLIC FUNC indentOfCount(count AS Integer) AS String
  MUT n AS Integer = count
  IF n < 0 THEN n = 0
  IF n > 10 THEN n = 10
  RETURN strings::repeat(" ", n)
END FUNC

' An explicit indent string, truncated to its first 10 characters, matching
' json::stringify. "" means compact.
PUBLIC FUNC clampIndent(indent AS String) AS String
  IF len(indent) <= 10 THEN RETURN indent
  RETURN strings::mid(indent, 0, 10)
END FUNC

' TRUE when any child is an element.
PRIVATE FUNC holdsElement(children AS List OF Node) AS Boolean
  FOR EACH k IN children
    MATCH k
      CASE Element(e)
        RETURN TRUE
      CASE ELSE
    END MATCH
  NEXT
  RETURN FALSE
END FUNC

' TRUE when `s` is entirely XML whitespace. The only caller skips empty text
' before asking, so there is no empty-string case to answer for.
PRIVATE FUNC isAllSpace(s AS String) AS Boolean
  FOR EACH sc IN strings::toScalars(s)
    IF NOT isSpace(toInt(sc)) THEN RETURN FALSE
  NEXT
  RETURN TRUE
END FUNC

' TRUE when these children hold text that is DATA rather than layout -- which
' is what forbids re-indenting them.
PRIVATE FUNC holdsDataText(children AS List OF Node) AS Boolean
  LET withElement AS Boolean = holdsElement(children)
  FOR EACH k IN children
    MATCH k
      CASE Text(t)
        ' Empty text is not data: it contributes nothing to the content, and
        ' treating it as data would wrongly force the whole element inline.
        IF len(t.text) > 0 THEN
          IF NOT withElement THEN RETURN TRUE
          IF NOT isAllSpace(t.text) THEN RETURN TRUE
        END IF
      CASE ELSE
    END MATCH
  NEXT
  RETURN FALSE
END FUNC

' Write one node at `level` indents deep. `indent` is already clamped and
' non-empty.
PRIVATE FUNC writeNodePretty(n AS Node, indent AS String, depth AS Integer, level AS Integer, scope AS List OF Binding, strict AS Boolean) AS String
  MUT out AS String = ""
  MATCH n
    CASE Element(e)
      IF depth > DEPTH_LIMIT THEN
        FAIL error(ERR_DEPTH, "xml: the tree nests more than " & toString(DEPTH_LIMIT) & " levels deep")
      END IF
      LET inner AS List OF Binding = requireWritableElement(e, scope, strict)
      LET head AS String = "<" & e.name & writeAttributes(e.attributes)
      IF len(e.children) = 0 THEN
        out = head & "/>"
      ELSEIF holdsDataText(e.children) OR NOT holdsElement(e.children) THEN
        ' Two cases write exactly as compact, adding nothing inside.
        '
        ' Data text is the obvious one. The second is subtler: an element whose
        ' children are only comments or processing instructions has NO element
        ' child, so whitespace is not layout there. Newlines added here would
        ' read back as DATA, changing the content -- `<a><!--c--></a>`
        ' pretty-printed across lines comes back as `<a>` + text + `</a>`.
        out = writeNodeCompact(n, depth, scope, strict)
      ELSE
        MUT parts AS List OF String = []
        parts = collections::append(parts, head & ">")
        LET childIndent AS String = strings::repeat(indent, level + 1)
        FOR EACH k IN e.children
          MATCH k
            CASE Text(t)
              ' Whitespace-only text is layout here, and the writer supplies its own.
            CASE ELSE
              parts = collections::append(parts, "\n" & childIndent & writeNodePretty(k, indent, depth + 1, level + 1, inner, strict))
          END MATCH
        NEXT
        parts = collections::append(parts, "\n" & strings::repeat(indent, level) & "</" & e.name & ">")
        out = strings::join(parts, "")
      END IF
    CASE ELSE
      ' Text, comments and processing instructions have no inner structure to
      ' indent, so they are written exactly as compact.
      out = writeNodeCompact(n, depth, scope, strict)
  END MATCH
  RETURN out
END FUNC

' ---------------------------------------------------------------------------
' Entry points.
' ---------------------------------------------------------------------------

' A whole document with `indent` per level. An empty indent is compact, and
' byte-identical to the compact form.
PUBLIC FUNC writeDocument(doc AS Document, indent AS String) AS String
  requireWritableDocument(doc)
  LET stepText AS String = clampIndent(indent)
  MUT parts AS List OF String = []
  parts = collections::append(parts, DECLARATION)
  LET empty AS List OF Binding = []
  FOR EACH n IN doc.children
    IF stepText = "" THEN
      parts = collections::append(parts, writeNodeCompact(n, 1, empty, TRUE))
    ELSE
      parts = collections::append(parts, "\n" & writeNodePretty(n, stepText, 1, 0, empty, TRUE))
    END IF
  NEXT
  RETURN strings::join(parts, "")
END FUNC

' One node, as a fragment: no declaration.
PUBLIC FUNC writeFragment(n AS Node, indent AS String) AS String
  LET stepText AS String = clampIndent(indent)
  LET empty AS List OF Binding = []
  IF stepText = "" THEN RETURN writeNodeCompact(n, 1, empty, FALSE)
  RETURN writeNodePretty(n, stepText, 1, 0, empty, FALSE)
END FUNC
