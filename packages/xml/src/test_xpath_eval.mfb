' ---------------------------------------------------------------------------
' Tests: the XPath evaluator.
'
' Most cases assert through `valueOf`, because an XPath result's string-value is
' exactly what the specification defines and it compares without materializing
' anything. Node COUNTS and node identity go through `select`.
'
' The cases that matter most are the ones where a plausible implementation gets
' a defensible-but-wrong answer: per-step versus per-result predicates, the
' existential rule for comparing a node-set, and §4.2 number formatting.
' ---------------------------------------------------------------------------

IMPORT collections
IMPORT strings

' A catalogue with two books, a prefixed name, a comment, a PI and an empty
' element -- enough for every node test and axis in the subset.
PRIVATE FUNC evalCatalog() AS Document
  RETURN parse("<?xml version=\"1.0\"?><catalog xmlns:dc=\"urn:dc\"><book id=\"b1\" lang=\"en\"><dc:title>Dune</dc:title><author>Herbert</author><price>9.99</price></book><book id=\"b2\"><dc:title>Neuromancer</dc:title><author>Gibson</author><price>12.50</price></book><!--note--><?pi data?><empty/></catalog>")
END FUNC

' Two shelves, so `//book[1]` (the first book of EACH shelf) and `(//book)[1]`
' (the first book overall) have different answers.
PRIVATE FUNC shelves() AS Document
  RETURN parse("<library><shelf><book>a</book><book>b</book></shelf><shelf><book>c</book></shelf></library>")
END FUNC

PRIVATE FUNC countOf(doc AS Document, expression AS String) AS Integer
  RETURN len(select(doc, expression))
END FUNC

PRIVATE FUNC textsOf(doc AS Document, expression AS String) AS String
  MUT parts AS List OF String = []
  FOR EACH found IN select(doc, expression)
    parts = collections::append(parts, textOf(found))
  NEXT
  RETURN strings::join(parts, ",")
END FUNC

TESTING
  TGROUP "location paths"
    TCASE "absolute and relative paths select the same nodes"
      expectInteger(countOf(evalCatalog(), "/catalog/book"), 2)
      expectInteger(countOf(evalCatalog(), "//book"), 2)
      expectString(valueOf(evalCatalog(), "/catalog/book[1]/author"), "Herbert")
    END TCASE

    TCASE "descendant-or-self reaches every depth"
      expectInteger(countOf(evalCatalog(), "//author"), 2)
      expectInteger(countOf(evalCatalog(), "/catalog//author"), 2)
      expectInteger(countOf(evalCatalog(), "//*"), 10)
    END TCASE

    TCASE "the parent axis climbs"
      expectString(textsOf(evalCatalog(), "//dc:title/../author"), "Herbert,Gibson")
      expectInteger(countOf(evalCatalog(), "//book/.."), 1)
    END TCASE

    TCASE "self selects the context"
      expectInteger(countOf(evalCatalog(), "//book/."), 2)
      expectInteger(countOf(evalCatalog(), ".//book"), 2)
    END TCASE

    TCASE "node-type tests"
      expectInteger(countOf(evalCatalog(), "//text()"), 6)
      expectInteger(countOf(evalCatalog(), "//comment()"), 1)
      expectInteger(countOf(evalCatalog(), "//processing-instruction()"), 1)
      expectInteger(countOf(evalCatalog(), "//node()"), 18)
    END TCASE

    TCASE "a prefixed name matches the literal prefix:local text"
      expectInteger(countOf(evalCatalog(), "//dc:title"), 2)
      expectString(valueOf(evalCatalog(), "//dc:title"), "Dune")
      ' The prefix is not resolved, so the local name alone matches nothing.
      expectInteger(countOf(evalCatalog(), "//title"), 0)
    END TCASE

    TCASE "the union operator merges in document order, without duplicates"
      expectInteger(countOf(evalCatalog(), "//author | //price"), 4)
      expectInteger(countOf(evalCatalog(), "//book | //book"), 2)
      expectString(textsOf(evalCatalog(), "//author | //price"), "Herbert,9.99,Gibson,12.50")
    END TCASE
  END TGROUP

  TGROUP "predicates"
    TCASE "a positional predicate applies PER STEP"
      ' //book[1] is the first book of each shelf: two nodes, not one.
      expectInteger(countOf(shelves(), "//book[1]"), 2)
      expectString(textsOf(shelves(), "//book[1]"), "a,c")
    END TCASE

    TCASE "a filter expression applies to the whole result"
      expectInteger(countOf(shelves(), "(//book)[1]"), 1)
      expectString(textsOf(shelves(), "(//book)[1]"), "a")
      expectString(textsOf(shelves(), "(//book)[3]"), "c")
    END TCASE

    TCASE "last() and position()"
      expectString(textsOf(shelves(), "(//book)[last()]"), "c")
      expectInteger(countOf(shelves(), "//book[position() < 2]"), 2)
      expectInteger(countOf(shelves(), "(//book)[position() < 3]"), 2)
    END TCASE

    TCASE "an attribute predicate"
      expectInteger(countOf(evalCatalog(), "//book[@id]"), 2)
      expectInteger(countOf(evalCatalog(), "//book[@lang]"), 1)
      expectString(valueOf(evalCatalog(), "//book[@id='b2']/author"), "Gibson")
    END TCASE

    TCASE "a child predicate tests existence, then value"
      expectInteger(countOf(evalCatalog(), "//book[author]"), 2)
      expectInteger(countOf(evalCatalog(), "//book[missing]"), 0)
      expectString(valueOf(evalCatalog(), "//book[author='Gibson']/@id"), "b2")
    END TCASE

    TCASE "predicates chain"
      expectInteger(countOf(shelves(), "//book[1][1]"), 2)
      expectInteger(countOf(shelves(), "(//book)[1][1]"), 1)
      expectInteger(countOf(shelves(), "(//book)[1][2]"), 0)
    END TCASE
  END TGROUP

  TGROUP "attributes"
    TCASE "@name and @* select attributes"
      expectInteger(len(selectAttributes(evalCatalog(), "//book/@id")), 2)
      expectInteger(len(selectAttributes(evalCatalog(), "//book/@*")), 3)
      expectInteger(len(selectAttributes(evalCatalog(), "//book[1]/@*")), 2)
    END TCASE

    TCASE "an attribute's string-value"
      expectString(valueOf(evalCatalog(), "//book/@id"), "b1")
      expectString(valueOf(evalCatalog(), "//book[2]/@id"), "b2")
      expectString(valueOf(evalCatalog(), "count(//@id)"), "2")
    END TCASE

    TCASE "the xmlns declaration is an ordinary attribute here"
      expectInteger(len(selectAttributes(evalCatalog(), "/catalog/@*")), 1)
      expectString(valueOf(evalCatalog(), "/catalog/@xmlns:dc"), "urn:dc")
    END TCASE
  END TGROUP

  TGROUP "comparisons"
    TCASE "comparing a node-set is EXISTENTIAL, not universal"
      ' True because ONE book has id b2 -- not because all of them do.
      expectString(valueOf(evalCatalog(), "//book/@id = 'b2'"), "true")
      expectString(valueOf(evalCatalog(), "//book/@id = 'nope'"), "false")
      ' != is existential too: true because some id differs from b1.
      expectString(valueOf(evalCatalog(), "//book/@id != 'b1'"), "true")
    END TCASE

    TCASE "numeric comparison converts strings"
      expectString(valueOf(evalCatalog(), "//price > 10"), "true")
      expectString(valueOf(evalCatalog(), "//price > 100"), "false")
      expectString(valueOf(evalCatalog(), "//book[1]/price < 10"), "true")
    END TCASE

    TCASE "boolean operators short-circuit to a boolean"
      expectString(valueOf(evalCatalog(), "//book and //author"), "true")
      expectString(valueOf(evalCatalog(), "//book and //missing"), "false")
      expectString(valueOf(evalCatalog(), "//missing or //author"), "true")
      expectString(valueOf(evalCatalog(), "not(//missing)"), "true")
    END TCASE
  END TGROUP

  TGROUP "numbers, as XPath writes them"
    TCASE "an integral number has no fractional part"
      expectString(valueOf(evalCatalog(), "string(2.0)"), "2")
      expectString(valueOf(evalCatalog(), "1 + 1"), "2")
      expectString(valueOf(evalCatalog(), "count(//book)"), "2")
    END TCASE

    TCASE "division by zero is Infinity or NaN, never an error"
      expectString(valueOf(evalCatalog(), "string(1 div 0)"), "Infinity")
      expectString(valueOf(evalCatalog(), "string(-1 div 0)"), "-Infinity")
      expectString(valueOf(evalCatalog(), "string(0 div 0)"), "NaN")
    END TCASE

    TCASE "arithmetic"
      expectString(valueOf(evalCatalog(), "7 div 2"), "3.5")
      expectString(valueOf(evalCatalog(), "7 mod 2"), "1")
      expectString(valueOf(evalCatalog(), "2 * 3"), "6")
      expectString(valueOf(evalCatalog(), "10 - 4"), "6")
      expectString(valueOf(evalCatalog(), "-3 + 1"), "-2")
    END TCASE

    TCASE "sum() over a node-set, and a non-numeric string is NaN"
      ' §4.2 prints the shortest decimal that reads back as the same double. Node
      ' prints the same digits for 9.99 + 12.50.
      expectString(valueOf(evalCatalog(), "sum(//price)"), "22.490000000000002")
      expectString(valueOf(evalCatalog(), "string(number('x'))"), "NaN")
      expectString(valueOf(evalCatalog(), "number('2.5')"), "2.5")
    END TCASE
  END TGROUP

  TGROUP "functions"
    TCASE "string functions"
      expectString(valueOf(evalCatalog(), "string(//author)"), "Herbert")
      expectString(valueOf(evalCatalog(), "concat('a','b','c')"), "abc")
      expectString(valueOf(evalCatalog(), "string-length('abc')"), "3")
      expectString(valueOf(evalCatalog(), "contains(//author,'erb')"), "true")
      expectString(valueOf(evalCatalog(), "starts-with(//author,'H')"), "true")
      expectString(valueOf(evalCatalog(), "starts-with(//author,'G')"), "false")
    END TCASE

    TCASE "normalize-space collapses every kind of whitespace"
      expectString(valueOf(evalCatalog(), "normalize-space('  a   b  ')"), "a b")
      expectString(valueOf(evalCatalog(), "normalize-space('a\tb\nc')"), "a b c")
      expectString(valueOf(evalCatalog(), "normalize-space('   ')"), "")
    END TCASE

    TCASE "name() and local-name() keep and strip the prefix"
      expectString(valueOf(evalCatalog(), "name(//dc:title)"), "dc:title")
      expectString(valueOf(evalCatalog(), "local-name(//dc:title)"), "title")
      expectString(valueOf(evalCatalog(), "name(//book)"), "book")
    END TCASE

    TCASE "boolean(), true() and false()"
      expectString(valueOf(evalCatalog(), "true()"), "true")
      expectString(valueOf(evalCatalog(), "false()"), "false")
      expectString(valueOf(evalCatalog(), "boolean(//book)"), "true")
      expectString(valueOf(evalCatalog(), "boolean(//missing)"), "false")
      expectString(valueOf(evalCatalog(), "boolean('')"), "false")
    END TCASE
  END TGROUP

  TGROUP "refusals"
    TCASE "a node-set mixing attributes with other nodes is unsupported"
      expectTrap(evaluate(evalCatalog(), "//book | //@id"), 77050007)
    END TCASE

    TCASE "select needs nodes, selectAttributes needs attributes"
      expectTrap(select(evalCatalog(), "string(//book)"), 77050002)
      expectTrap(select(evalCatalog(), "count(//book)"), 77050002)
      expectTrap(select(evalCatalog(), "//book/@id"), 77050002)
      expectTrap(selectAttributes(evalCatalog(), "//book"), 77050002)
    END TCASE

    TCASE "the parser's refusals reach the caller unchanged"
      expectTrap(select(evalCatalog(), "child::book"), 77050007)
      expectTrap(select(evalCatalog(), "$x"), 77050007)
      expectTrap(select(evalCatalog(), "a["), 77050003)
    END TCASE
  END TGROUP
END TESTING
