' ---------------------------------------------------------------------------
' xml/content.mfb — the content projection of plan-138-A §4, as one canonical
' string.
'
' CONTENT is what must survive every read, write and pretty-print, and what the
' Node and Rust oracles must agree on. FORMATTING may change freely. The
' projection that separates them:
'
'   1. comments and processing instructions are removed;
'   2. adjacent text is merged into one text node (including text that becomes
'      adjacent once step 1 removes a comment between two runs);
'   3. a whitespace-only text node whose parent ALSO has an element child is
'      layout, and is removed -- any other text, including a whitespace-only
'      node that is its parent's only content (`<a>   </a>`), is data and is
'      kept byte for byte;
'   4. attributes compare as a SET of (name, value) pairs, so they are sorted;
'   5. names compare as their raw `prefix:local` text.
'
' This is package-internal: it exists so the round-trip tests can assert
' `contentKey(parse(stringify(d))) = contentKey(d)` rather than comparing
' formatted output, which would pin formatting the plan deliberately leaves
' free.
' ---------------------------------------------------------------------------

IMPORT collections
IMPORT strings

' TRUE when `s` is entirely XML whitespace (and non-empty).
PRIVATE FUNC isLayoutText(s AS String) AS Boolean
  IF len(s) = 0 THEN RETURN FALSE
  FOR EACH sc IN strings::toScalars(s)
    IF NOT isSpace(toInt(sc)) THEN RETURN FALSE
  NEXT
  RETURN TRUE
END FUNC

' TRUE when any child of `children` is an element.
PRIVATE FUNC hasElementChild(children AS List OF Node) AS Boolean
  FOR EACH k IN children
    MATCH k
      CASE Element(e)
        RETURN TRUE
      CASE ELSE
    END MATCH
  NEXT
  RETURN FALSE
END FUNC

' Steps 1-3 over one child list: drop comments and PIs, merge adjacent text,
' then drop layout whitespace.
PRIVATE FUNC contentChildren(children AS List OF Node) AS List OF Node
  LET dropLayout AS Boolean = hasElementChild(children)
  MUT out AS List OF Node = []
  MUT pending AS String = ""
  FOR EACH k IN children
    MATCH k
      CASE Text(t)
        pending = pending & t.text
      CASE Element(e)
        IF pending <> "" THEN
          IF NOT (dropLayout AND isLayoutText(pending)) THEN
            LET merged AS Node = Text[pending]
            out = collections::append(out, merged)
          END IF
          pending = ""
        END IF
        out = collections::append(out, k)
      CASE ELSE
        ' A comment or PI is not content, and removing it lets the text on
        ' either side of it merge.
    END MATCH
  NEXT
  IF pending <> "" THEN
    IF NOT (dropLayout AND isLayoutText(pending)) THEN
      LET merged AS Node = Text[pending]
      out = collections::append(out, merged)
    END IF
  END IF
  RETURN out
END FUNC

' Attributes as a set: sorted by name, then by value.
PRIVATE FUNC sortedAttributes(attributes AS List OF Attribute) AS List OF String
  MUT keys AS List OF String = []
  FOR EACH a IN attributes
    keys = collections::append(keys, a.name & "=" & a.value)
  NEXT
  RETURN collections::sort(keys)
END FUNC

' The canonical content string of one node.
PUBLIC FUNC contentKeyOf(n AS Node) AS String
  MUT out AS String = ""
  MATCH n
    CASE Element(e)
      MUT parts AS List OF String = []
      parts = collections::append(parts, "e(" & e.name)
      FOR EACH key IN sortedAttributes(e.attributes)
        parts = collections::append(parts, "|" & key)
      NEXT
      parts = collections::append(parts, "[")
      FOR EACH k IN contentChildren(e.children)
        parts = collections::append(parts, contentKeyOf(k))
      NEXT
      parts = collections::append(parts, "])")
      out = strings::join(parts, "")
    CASE Text(t)
      out = "t(" & t.text & ")"
    CASE ELSE
      ' Unreachable: contentChildren removes comments and PIs before this is
      ' ever called on one, and a document's own children are filtered too.
      out = ""
  END MATCH
  RETURN out
END FUNC

' The canonical content string of a whole document: its root element only,
' since prolog and epilog comments and processing instructions are not content.
PUBLIC FUNC contentKey(doc AS Document) AS String
  MUT parts AS List OF String = []
  FOR EACH n IN contentChildren(doc.children)
    parts = collections::append(parts, contentKeyOf(n))
  NEXT
  RETURN strings::join(parts, "")
END FUNC
