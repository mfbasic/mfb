' ---------------------------------------------------------------------------
' Tests: the XPath edges a coverage run exposed.
'
' `test_xpath_eval.mfb` covers the subset a user writes every day. This file
' covers what is left: arithmetic and comparison over NaN and the infinities,
' the document node, attribute predicates, every branch of the comparison rule,
' the arity errors, and the parser's remaining refusals.
'
' These are not hypothetical. XPath 1.0 requires `1 div 0` to be Infinity and
' every comparison with NaN to be false, and a reader that quietly answers 0
' instead -- which this package did until the NaN representation was fixed --
' gives wrong answers with no error.
' ---------------------------------------------------------------------------

IMPORT collections
IMPORT strings

PRIVATE FUNC edgeCatalog() AS Document
  RETURN parse("<catalog><book id=\"b1\" lang=\"en\"><title>Dune</title><price>9.99</price></book><book id=\"b2\"><title>Neuromancer</title><price>12.50</price></book></catalog>")
END FUNC

TESTING
  TGROUP "arithmetic over the special values"
    TCASE "an infinity absorbs an ordinary number"
      expectString(valueOf(edgeCatalog(), "string((1 div 0) + 1)"), "Infinity")
      expectString(valueOf(edgeCatalog(), "string(1 - (1 div 0))"), "-Infinity")
      expectString(valueOf(edgeCatalog(), "string((1 div 0) * 2)"), "Infinity")
      expectString(valueOf(edgeCatalog(), "string((1 div 0) div 2)"), "Infinity")
    END TCASE

    TCASE "the combinations that are NaN"
      ' Infinity minus infinity, infinity times zero, infinity over infinity.
      expectString(valueOf(edgeCatalog(), "string((1 div 0) + (-1 div 0))"), "NaN")
      expectString(valueOf(edgeCatalog(), "string((1 div 0) * 0)"), "NaN")
      expectString(valueOf(edgeCatalog(), "string((1 div 0) div (1 div 0))"), "NaN")
      expectString(valueOf(edgeCatalog(), "string((1 div 0) mod 2)"), "NaN")
      expectString(valueOf(edgeCatalog(), "string(5 mod 0)"), "NaN")
    END TCASE

    TCASE "sign is carried through"
      expectString(valueOf(edgeCatalog(), "string(-1 div 0)"), "-Infinity")
      expectString(valueOf(edgeCatalog(), "string((1 div 0) * -2)"), "-Infinity")
      expectString(valueOf(edgeCatalog(), "string((-1 div 0) * -2)"), "Infinity")
      expectString(valueOf(edgeCatalog(), "string(-(1 div 0))"), "-Infinity")
    END TCASE

    TCASE "a finite number over an infinity is zero"
      expectString(valueOf(edgeCatalog(), "string(2 div (1 div 0))"), "0")
    END TCASE

    TCASE "NaN propagates through every operator"
      expectString(valueOf(edgeCatalog(), "string((0 div 0) + 1)"), "NaN")
      expectString(valueOf(edgeCatalog(), "string((0 div 0) * 1)"), "NaN")
      expectString(valueOf(edgeCatalog(), "string((0 div 0) div 1)"), "NaN")
      expectString(valueOf(edgeCatalog(), "string((0 div 0) mod 1)"), "NaN")
      expectString(valueOf(edgeCatalog(), "string(-(0 div 0))"), "NaN")
    END TCASE
  END TGROUP

  TGROUP "comparisons over the special values"
    TCASE "every comparison with NaN is false, including NaN != NaN"
      expectString(valueOf(edgeCatalog(), "(0 div 0) = (0 div 0)"), "false")
      expectString(valueOf(edgeCatalog(), "(0 div 0) != (0 div 0)"), "false")
      expectString(valueOf(edgeCatalog(), "(0 div 0) < 1"), "false")
      expectString(valueOf(edgeCatalog(), "(0 div 0) > 1"), "false")
    END TCASE

    TCASE "infinities compare by rank"
      expectString(valueOf(edgeCatalog(), "(1 div 0) > 1"), "true")
      expectString(valueOf(edgeCatalog(), "(-1 div 0) < 1"), "true")
      expectString(valueOf(edgeCatalog(), "(1 div 0) = (1 div 0)"), "true")
      expectString(valueOf(edgeCatalog(), "(1 div 0) != (1 div 0)"), "false")
      expectString(valueOf(edgeCatalog(), "(1 div 0) < (1 div 0)"), "false")
      expectString(valueOf(edgeCatalog(), "(-1 div 0) < (1 div 0)"), "true")
      expectString(valueOf(edgeCatalog(), "(1 div 0) >= (1 div 0)"), "true")
    END TCASE

    TCASE "an infinity is true, a NaN is false"
      expectString(valueOf(edgeCatalog(), "boolean(1 div 0)"), "true")
      expectString(valueOf(edgeCatalog(), "boolean(0 div 0)"), "false")
      expectString(valueOf(edgeCatalog(), "boolean(0)"), "false")
    END TCASE
  END TGROUP

  TGROUP "the arithmetic branches a coverage run named"
    TCASE "an empty string, and an empty node-set, are NaN"
      expectString(valueOf(edgeCatalog(), "string(number(''))"), "NaN")
      expectString(valueOf(edgeCatalog(), "string(number(//missing))"), "NaN")
      expectString(valueOf(edgeCatalog(), "string(number('   '))"), "NaN")
    END TCASE

    TCASE "two infinities of the same sign add to that infinity"
      expectString(valueOf(edgeCatalog(), "string((1 div 0) + (1 div 0))"), "Infinity")
      expectString(valueOf(edgeCatalog(), "string((-1 div 0) + (-1 div 0))"), "-Infinity")
    END TCASE

    TCASE "negating an infinity flips it, both ways"
      expectString(valueOf(edgeCatalog(), "string(-(-1 div 0))"), "Infinity")
      expectString(valueOf(edgeCatalog(), "string(-(1 div 0))"), "-Infinity")
    END TCASE

    TCASE "zero times an infinity is NaN with the zero on either side"
      expectString(valueOf(edgeCatalog(), "string(0 * (1 div 0))"), "NaN")
      expectString(valueOf(edgeCatalog(), "string((1 div 0) * 0)"), "NaN")
    END TCASE

    TCASE "a float that overflows becomes an infinity, not an error"
      ' MFBASIC raises ErrFloatOverflow where XPath wants Infinity, so the
      ' overflow is caught and turned into one. The number is written out in full,
      ' because XPath 1.0 has no exponent notation (§3.5): 1e308 is not a number.
      LET big AS String = "1" & strings::repeat("0", 308)
      expectString(valueOf(edgeCatalog(), "string(number('" & big & "') + number('" & big & "'))"), "Infinity")
      expectString(valueOf(edgeCatalog(), "string(number('" & big & "') * 10)"), "Infinity")
      expectString(valueOf(edgeCatalog(), "string(number('" & big & "') div 0.5)"), "Infinity")
      expectString(valueOf(edgeCatalog(), "string(number('-" & big & "') * 10)"), "-Infinity")
    END TCASE

    TCASE "sum() needs a node-set"
      ' XPath 1.0 §4.4 defines sum() over a node-set; anything else is a type error.
      expectTrap(evaluate(edgeCatalog(), "sum('5')"), 77050003)
      expectTrap(evaluate(edgeCatalog(), "sum('x')"), 77050003)
    END TCASE
  END TGROUP

  TGROUP "the comparison rule, in every combination"
    TCASE "node-set against node-set"
      expectString(valueOf(edgeCatalog(), "//title = //title"), "true")
      expectString(valueOf(edgeCatalog(), "//title != //title"), "true")
      expectString(valueOf(edgeCatalog(), "//price > //price"), "true")
      expectString(valueOf(edgeCatalog(), "//title = //price"), "false")
    END TCASE

    TCASE "node-set against a literal, either way round"
      expectString(valueOf(edgeCatalog(), "//title = 'Dune'"), "true")
      expectString(valueOf(edgeCatalog(), "'Dune' = //title"), "true")
      expectString(valueOf(edgeCatalog(), "9.99 = //price"), "true")
      expectString(valueOf(edgeCatalog(), "//price = 9.99"), "true")
      expectString(valueOf(edgeCatalog(), "100 > //price"), "true")
      expectString(valueOf(edgeCatalog(), "//price < 100"), "true")
    END TCASE

    TCASE "node-set against a boolean"
      expectString(valueOf(edgeCatalog(), "//book = true()"), "true")
      expectString(valueOf(edgeCatalog(), "//missing = true()"), "false")
      expectString(valueOf(edgeCatalog(), "//book != false()"), "true")
    END TCASE

    TCASE "boolean against boolean, and string against string"
      expectString(valueOf(edgeCatalog(), "true() = true()"), "true")
      expectString(valueOf(edgeCatalog(), "true() != false()"), "true")
      expectString(valueOf(edgeCatalog(), "true() = false()"), "false")
      expectString(valueOf(edgeCatalog(), "'a' = 'a'"), "true")
      expectString(valueOf(edgeCatalog(), "'a' != 'b'"), "true")
      ' A RELATIONAL comparison of booleans converts them to 1 and 0 first,
      ' rather than comparing them as booleans.
      expectString(valueOf(edgeCatalog(), "true() > false()"), "true")
      expectString(valueOf(edgeCatalog(), "true() <= false()"), "false")
    END TCASE

    TCASE "opposite infinities, and plain numbers, across every operator"
      expectString(valueOf(edgeCatalog(), "(1 div 0) = (-1 div 0)"), "false")
      expectString(valueOf(edgeCatalog(), "(1 div 0) != (-1 div 0)"), "true")
      expectString(valueOf(edgeCatalog(), "(1 div 0) > (-1 div 0)"), "true")
      expectString(valueOf(edgeCatalog(), "1 != 2"), "true")
      expectString(valueOf(edgeCatalog(), "1 <= 2"), "true")
      expectString(valueOf(edgeCatalog(), "2 >= 1"), "true")
      expectString(valueOf(edgeCatalog(), "2 <= 1"), "false")
    END TCASE

    TCASE "a relational comparison converts both sides to numbers"
      ' A string on the left and a node-set on the right: the comparison is
      ' numeric, and the operands keep their order.
      expectString(valueOf(edgeCatalog(), "'9' < //price"), "true")
      expectString(valueOf(edgeCatalog(), "'99' < //price"), "false")
      expectString(valueOf(edgeCatalog(), "//price > '9'"), "true")
      expectString(valueOf(edgeCatalog(), "'1' < '2'"), "true")
      expectString(valueOf(edgeCatalog(), "'2' < '1'"), "false")
    END TCASE

    TCASE "number against boolean converts the boolean"
      expectString(valueOf(edgeCatalog(), "1 = true()"), "true")
      expectString(valueOf(edgeCatalog(), "0 = false()"), "true")
      expectString(valueOf(edgeCatalog(), "number(true())"), "1")
      expectString(valueOf(edgeCatalog(), "number(false())"), "0")
    END TCASE
  END TGROUP

  TGROUP "the document node"
    TCASE "/ selects the document, whose string-value is all the text"
      expectString(valueOf(edgeCatalog(), "string(/)"), "Dune9.99Neuromancer12.50")
      expectInteger(len(select(edgeCatalog(), "/")), 1)
    END TCASE

    TCASE "the document node has no parent"
      expectInteger(len(select(edgeCatalog(), "/..")), 0)
    END TCASE

    TCASE "selecting the document gives the document ELEMENT, not the prolog"
      ' Found by fuzz-xpath: with a comment before the root element, `..` from
      ' that element returned the comment as well. The document node has no Node
      ' form, and the prolog is not the document.
      LET withProlog AS Document = parse("<!--note--><?pi data?><root><a/></root>")
      expectInteger(len(select(withProlog, "/")), 1)
      expectInteger(len(select(withProlog, "//a/..")), 1)
      expectString(valueOf(withProlog, "name(//a/..)"), "root")
      expectString(valueOf(withProlog, "name(/*)"), "root")
    END TCASE

    TCASE "the string-value of a text node is its own text"
      expectString(valueOf(edgeCatalog(), "string(//text())"), "Dune")
    END TCASE
  END TGROUP

  TGROUP "attributes"
    TCASE "a predicate over an attribute set"
      expectInteger(len(selectAttributes(edgeCatalog(), "//book/@*[1]")), 2)
      expectInteger(len(selectAttributes(edgeCatalog(), "//book/@*[2]")), 1)
    END TCASE

    TCASE "name() over an attribute"
      expectString(valueOf(edgeCatalog(), "name(//book/@id)"), "id")
      expectString(valueOf(edgeCatalog(), "local-name(//book/@id)"), "id")
    END TCASE

    TCASE "a union of two attribute sets is a node-set, not an error"
      ' Found by the three-way XPath oracle: both oracles answered this and the
      ' package refused it.
      expectInteger(len(selectAttributes(edgeCatalog(), "//book/@id | //book/@lang")), 3)
      expectInteger(len(selectAttributes(edgeCatalog(), "//book/@id | //book/@id")), 2)
    END TCASE

    TCASE "a union returns its attributes in DOCUMENT order, interleaved"
      ' Also found by the oracle: the package appended one set after the other,
      ' so //book/@id | //book/@lang gave both ids and then the lang. A union
      ' yields a node-set, and a node-set is in document order.
      MUT names AS List OF String = []
      FOR EACH one IN selectAttributes(edgeCatalog(), "//book/@id | //book/@lang")
        names = collections::append(names, one.name & "=" & one.value)
      NEXT
      expectString(strings::join(names, ","), "id=b1,lang=en,id=b2")
    END TCASE

    TCASE "a union that MIXES attributes with other nodes is still refused"
      expectTrap(evaluate(edgeCatalog(), "//book | //book/@id"), 77050007)
    END TCASE

    TCASE "a step after an attribute step is applied to the attribute"
      ' An attribute has no children, so a child step after one is empty, and `..`
      ' after one is the element that carries it (XPath 1.0 §5.2).
      expectString(valueOf(edgeCatalog(), "count(//book/@id/title)"), "0")
      expectString(valueOf(edgeCatalog(), "count(//book/@id/..)"), "2")
      expectString(valueOf(edgeCatalog(), "name(//book/@id/..)"), "book")
    END TCASE
  END TGROUP

  TGROUP "filters and short circuits"
    TCASE "a filter may be followed by more steps"
      expectString(valueOf(edgeCatalog(), "(//book)[1]/title"), "Dune")
      expectString(valueOf(edgeCatalog(), "(//book)[2]/title"), "Neuromancer")
      expectInteger(len(select(edgeCatalog(), "(//book)[1]//title")), 1)
    END TCASE

    TCASE "or stops at the first true, and stops at the first false"
      expectString(valueOf(edgeCatalog(), "//book or //missing"), "true")
      expectString(valueOf(edgeCatalog(), "//missing or //book"), "true")
      expectString(valueOf(edgeCatalog(), "//missing and //book"), "false")
      expectString(valueOf(edgeCatalog(), "//book and //title"), "true")
    END TCASE
  END TGROUP

  TGROUP "argument errors"
    TCASE "a function given the wrong kind of argument is a type error"
      ' XPath calls this a type error: the expression is ill-typed, so it is
      ' ErrInvalidFormat, not a feature outside the subset.
      expectTrap(evaluate(edgeCatalog(), "count('x')"), 77050003)
      expectTrap(evaluate(edgeCatalog(), "name('x')"), 77050003)
      expectTrap(evaluate(edgeCatalog(), "local-name(1)"), 77050003)
    END TCASE

    TCASE "a function given the wrong number of arguments"
      expectTrap(evaluate(edgeCatalog(), "contains('a')"), 77050003)
      expectTrap(evaluate(edgeCatalog(), "starts-with('a')"), 77050003)
      expectTrap(evaluate(edgeCatalog(), "concat('a')"), 77050003)
    END TCASE

    TCASE "evaluate refuses a result no Float can hold, and names valueOf"
      expectTrap(evaluate(edgeCatalog(), "1 div 0"), 77050007)
      expectTrap(evaluate(edgeCatalog(), "0 div 0"), 77050007)
      ' The same expressions are readable as text.
      expectString(valueOf(edgeCatalog(), "string(1 div 0)"), "Infinity")
    END TCASE

    TCASE "an ordinary boolean result still comes back as one"
      LET value AS XPathValue = evaluate(edgeCatalog(), "//book = 'x'")
      MATCH value
        CASE XBoolean(b)
          expectEqual(b.value, FALSE)
        CASE ELSE
          expectString("not a boolean", "a boolean")
      END MATCH
    END TCASE
  END TGROUP

  TGROUP "the parser's remaining refusals"
    TCASE "a number may begin with a decimal point"
      expectString(valueOf(edgeCatalog(), "string(.5)"), "0.5")
      expectString(valueOf(edgeCatalog(), "string(0.5)"), "0.5")
    END TCASE

    TCASE "names may hold uppercase letters and digits"
      expectInteger(len(select(parse("<Doc><Item12/></Doc>"), "//Item12")), 1)
    END TCASE

    TCASE "a bare colon, and a character XPath has no use for"
      expectTrap(parseXPath(":"), 77050003)
      expectTrap(parseXPath("#"), 77050003)
      expectTrap(parseXPath("]"), 77050003)
      expectTrap(parseXPath("count("), 77050003)
    END TCASE

    TCASE "a name followed by ( that is not a node test"
      expectTrap(parseXPath("a/foo()"), 77050003)
    END TCASE

    TCASE "a node test with arguments is unsupported"
      expectTrap(parseXPath("processing-instruction('x')"), 77050007)
    END TCASE

    TCASE "a filter followed by //"
      expectInteger(len(select(edgeCatalog(), "(//book)//title")), 2)
    END TCASE

    TCASE "the operator-versus-name rule after a comma"
      expectString(valueOf(edgeCatalog(), "concat('a', 'b')"), "ab")
      expectInteger(len(select(edgeCatalog(), "//book[count(*) = 2]")), 2)
      ' A `*` straight after a comma is a NAME TEST, not a multiply operator --
      ' there is no left operand for it to multiply.
      expectString(valueOf(edgeCatalog(), "concat('x', *)"), "xDune9.99Neuromancer12.50")
    END TCASE
  END TGROUP
END TESTING
