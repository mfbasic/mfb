' ---------------------------------------------------------------------------
' xml/xpath_eval.mfb — evaluating a parsed XPath expression over the index.
'
' Node-sets are `List OF Integer`: positions into the flat index, which IS
' document order, so ordering and de-duplication are integer work. Nothing is
' turned back into a `Node` until the caller asks for the result. Attribute sets
' are `List OF AttrRef`: an owner element and which of its attributes.
'
' The DOCUMENT NODE is position -1. XPath's root is the parent of the root
' element, and giving it a position means `/a` and `//a` need no special case:
' `/` starts the context at -1, whose children are the top-level nodes.
'
' A context is a node, or an attribute of a node. An attribute is its own
' context node in a predicate or a function: `.` selects it, its string-value is
' its value, and `..` selects its element.
'
' Numbers live in xpath_number.mfb and the function library in xpath_functions.mfb.
' ---------------------------------------------------------------------------

IMPORT collections
IMPORT strings

' A reference to one attribute: which element, and which of its attributes.
PUBLIC TYPE AttrRef
  node AS Integer
  at AS Integer
END TYPE

' The node the expression is evaluated against: its position (-1 for the
' document), or, when `attr` is at least 0, the attribute at that index of it;
' and its position and the size of the set it belongs to.
PUBLIC TYPE Context
  node AS Integer
  attr AS Integer
  position AS Integer
  size AS Integer
END TYPE

PUBLIC TYPE VNodes
  nodes AS List OF Integer
END TYPE

PUBLIC TYPE VAttrs
  attrs AS List OF AttrRef
END TYPE

PUBLIC TYPE VString
  value AS String
END TYPE

PUBLIC TYPE VNumber
  number AS Num
END TYPE

PUBLIC TYPE VBoolean
  value AS Boolean
END TYPE

PUBLIC UNION XValue
  VNodes
  VAttrs
  VString
  VNumber
  VBoolean
END UNION

' ---------------------------------------------------------------------------
' The PUBLIC result type. Everything above works in index positions; this is
' where a result becomes nodes a caller can hold.
' ---------------------------------------------------------------------------

EXPORT TYPE XNodes
  nodes AS List OF Node
END TYPE

EXPORT TYPE XAttributes
  attributes AS List OF Attribute
END TYPE

EXPORT TYPE XString
  value AS String
END TYPE

EXPORT TYPE XNumber
  value AS Float
END TYPE

EXPORT TYPE XBoolean
  value AS Boolean
END TYPE

EXPORT UNION XPathValue
  XNodes
  XAttributes
  XString
  XNumber
  XBoolean
END UNION

' ---------------------------------------------------------------------------
' Converting between the five value kinds (§4.2, §4.3).
' ---------------------------------------------------------------------------

' The string-value of one index position, with the document node handled: its
' string-value is every text node in the document, concatenated.
PUBLIC FUNC stringValueOf(index AS List OF IndexedNode, at AS Integer) AS String
  IF at >= 0 THEN RETURN stringValueAt(index, at)
  MUT parts AS List OF String = []
  MUT i AS Integer = 0
  DO WHILE i < len(index)
    LET entry AS IndexedNode = collections::get(index, i)
    IF entry.kind = KIND_TEXT THEN
      parts = collections::append(parts, entry.value)
    END IF
    i = i + 1
  LOOP
  RETURN strings::join(parts, "")
END FUNC

PUBLIC FUNC attributeValueAt(index AS List OF IndexedNode, one AS AttrRef) AS String
  LET entry AS IndexedNode = collections::get(index, one.node)
  RETURN collections::get(entry.attributes, one.at).value
END FUNC

PUBLIC FUNC attributeNameAt(index AS List OF IndexedNode, one AS AttrRef) AS String
  LET entry AS IndexedNode = collections::get(index, one.node)
  RETURN collections::get(entry.attributes, one.at).name
END FUNC

PUBLIC FUNC stringOfValue(index AS List OF IndexedNode, value AS XValue) AS String
  MUT out AS String = ""
  MATCH value
    CASE VNodes(n)
      IF len(n.nodes) > 0 THEN
        out = stringValueOf(index, collections::get(n.nodes, 0))
      END IF
    CASE VAttrs(a)
      IF len(a.attrs) > 0 THEN
        LET one AS AttrRef = collections::get(a.attrs, 0)
        out = attributeValueAt(index, one)
      END IF
    CASE VString(s)
      out = s.value
    CASE VNumber(m)
      out = numberToString(m.number)
    CASE VBoolean(b)
      IF b.value THEN
        out = "true"
      ELSE
        out = "false"
      END IF
  END MATCH
  RETURN out
END FUNC

PUBLIC FUNC stringOfXValue(index AS List OF IndexedNode, value AS XValue) AS String
  RETURN stringOfValue(index, value)
END FUNC

PUBLIC FUNC booleanOfValue(index AS List OF IndexedNode, value AS XValue) AS Boolean
  MUT out AS Boolean = FALSE
  MATCH value
    CASE VNodes(n)
      out = len(n.nodes) > 0
    CASE VAttrs(a)
      out = len(a.attrs) > 0
    CASE VString(s)
      out = len(s.value) > 0
    CASE VNumber(m)
      ' NaN is false, an infinity is true, and 0 is false.
      IF m.number.special = NUM_NAN THEN
        out = FALSE
      ELSEIF m.number.special <> NUM_NORMAL THEN
        out = TRUE
      ELSE
        out = m.number.value <> 0.0
      END IF
    CASE VBoolean(b)
      out = b.value
  END MATCH
  RETURN out
END FUNC

PUBLIC FUNC numberOfValue(index AS List OF IndexedNode, value AS XValue) AS Num
  MUT out AS Num = nanNumber()
  MATCH value
    CASE VNumber(m)
      out = m.number
    CASE VBoolean(b)
      IF b.value THEN
        out = plainNumber(1.0)
      ELSE
        out = plainNumber(0.0)
      END IF
    CASE ELSE
      out = stringToNumber(stringOfValue(index, value))
  END MATCH
  RETURN out
END FUNC

' The context as a value: the node, or the attribute, that the expression sees.
PUBLIC FUNC contextValue(ctx AS Context) AS XValue
  IF ctx.attr >= 0 THEN
    LET one AS AttrRef = AttrRef[ctx.node, ctx.attr]
    LET attrs AS List OF AttrRef = [one]
    LET value AS XValue = VAttrs[attrs]
    RETURN value
  END IF
  LET nodes AS List OF Integer = [ctx.node]
  LET value AS XValue = VNodes[nodes]
  RETURN value
END FUNC

' ---------------------------------------------------------------------------
' Node tests and axes.
' ---------------------------------------------------------------------------

' Whether an attribute's name passes a name test. A prefix test matches every
' name that begins with the prefix and its colon.
PRIVATE FUNC attributeMatches(name AS String, entry AS PathStep) AS Boolean
  IF entry.test = TEST_STAR OR entry.test = TEST_NODE THEN RETURN TRUE
  IF entry.test = TEST_PREFIX THEN RETURN strings::startsWith(name, entry.name)
  RETURN entry.test = TEST_NAME AND name = entry.name
END FUNC

PRIVATE FUNC matchesTest(index AS List OF IndexedNode, at AS Integer, entry AS PathStep) AS Boolean
  IF at < 0 THEN
    ' Only node() and self match the document node.
    RETURN entry.test = TEST_NODE
  END IF
  LET node AS IndexedNode = collections::get(index, at)
  IF entry.test = TEST_NODE THEN RETURN TRUE
  IF entry.test = TEST_TEXT THEN RETURN node.kind = KIND_TEXT
  IF entry.test = TEST_COMMENT THEN RETURN node.kind = KIND_COMMENT
  IF entry.test = TEST_PI THEN RETURN node.kind = KIND_PI
  ' A name test selects elements only, and `*` selects every element.
  IF node.kind <> KIND_ELEMENT THEN RETURN FALSE
  IF entry.test = TEST_STAR THEN RETURN TRUE
  IF entry.test = TEST_PREFIX THEN RETURN strings::startsWith(node.name, entry.name)
  RETURN node.name = entry.name
END FUNC

' Every position an axis reaches from `at`, in document order.
PRIVATE FUNC axisFrom(index AS List OF IndexedNode, at AS Integer, axis AS Integer) AS List OF Integer
  MUT out AS List OF Integer = []
  IF axis = AXIS_SELF THEN
    out = collections::append(out, at)
    RETURN out
  END IF
  IF axis = AXIS_PARENT THEN
    IF at < 0 THEN RETURN out
    LET entry AS IndexedNode = collections::get(index, at)
    out = collections::append(out, entry.parent)
    RETURN out
  END IF
  ' AXIS_CHILD. The descendant-or-self axis never reaches here: `applyStep`
  ' scans that range and applies the node test in one pass, because
  ' materializing it first would build a list the size of the document for
  ' every `//` step.
  IF at < 0 THEN RETURN rootsOf(index)
  RETURN childrenOf(index, at)
END FUNC

' Sort and de-duplicate a node-set. Document order IS index order, so this is
' integer work.
PUBLIC FUNC orderNodes(nodes AS List OF Integer) AS List OF Integer
  ' A forward axis walked from one context node already yields ascending,
  ' distinct positions, which is the overwhelmingly common case -- `//item` on a
  ' 100,000-node document produces 50,000 of them. Sorting those again is the
  ' single most expensive thing a query can do for no result, so the ordering is
  ' checked first and the list handed back untouched when it already holds.
  MUT ascending AS Boolean = TRUE
  MUT previous AS Integer = -2
  FOR EACH one IN nodes
    IF one <= previous THEN
      ascending = FALSE
    END IF
    previous = one
  NEXT
  IF ascending THEN RETURN nodes

  LET sorted AS List OF Integer = collections::sort(nodes)
  MUT out AS List OF Integer = []
  MUT last AS Integer = -2
  FOR EACH one IN sorted
    IF one <> last THEN
      out = collections::append(out, one)
      last = one
    END IF
  NEXT
  RETURN out
END FUNC

' Whether one attribute comes before another in document order: by owner
' element first, then by position on it.
PRIVATE FUNC attrBefore(one AS AttrRef, other AS AttrRef) AS Boolean
  IF one.node <> other.node THEN RETURN one.node < other.node
  RETURN one.at < other.at
END FUNC

' Sort and de-duplicate an attribute set into document order. A set that is
' already in order, which is the usual case, is returned as it is.
PRIVATE FUNC orderAttrs(attrs AS List OF AttrRef) AS List OF AttrRef
  MUT ascending AS Boolean = TRUE
  MUT i AS Integer = 1
  DO WHILE i < len(attrs) AND ascending
    IF NOT attrBefore(collections::get(attrs, i - 1), collections::get(attrs, i)) THEN ascending = FALSE
    i = i + 1
  LOOP
  IF ascending THEN RETURN attrs
  MUT out AS List OF AttrRef = []
  MUT j AS Integer = 0
  DO WHILE j < len(attrs)
    LET candidate AS AttrRef = collections::get(attrs, j)
    MUT placed AS Boolean = FALSE
    MUT k AS Integer = 0
    DO WHILE k < len(out) AND NOT placed
      LET existing AS AttrRef = collections::get(out, k)
      IF existing.node = candidate.node AND existing.at = candidate.at THEN
        placed = TRUE
      ELSEIF attrBefore(candidate, existing) THEN
        out = collections::insert(out, k, candidate)
        placed = TRUE
      END IF
      k = k + 1
    LOOP
    IF NOT placed THEN out = collections::append(out, candidate)
    j = j + 1
  LOOP
  RETURN out
END FUNC

' ---------------------------------------------------------------------------
' Predicates.
' ---------------------------------------------------------------------------

PRIVATE FUNC predicateHolds(index AS List OF IndexedNode, value AS XValue, position AS Integer) AS Boolean
  MUT out AS Boolean = FALSE
  MATCH value
    CASE VNumber(m)
      ' A numeric predicate selects by position, so a special value selects
      ' nothing.
      out = m.number.special = NUM_NORMAL AND m.number.value = toFloat(position)
    CASE ELSE
      out = booleanOfValue(index, value)
  END MATCH
  RETURN out
END FUNC

' The nodes that pass each predicate in turn. Each predicate sees the nodes that
' survived the one before it, so `position()` counts within that set.
PUBLIC FUNC filterNodes(index AS List OF IndexedNode, nodes AS List OF Integer, predicates AS List OF Expr) AS List OF Integer
  MUT current AS List OF Integer = nodes
  FOR EACH predicate IN predicates
    MUT kept AS List OF Integer = []
    MUT position AS Integer = 0
    LET size AS Integer = len(current)
    FOR EACH one IN current
      position = position + 1
      LET value AS XValue = evalExpr(index, Context[one, -1, position, size], predicate)
      IF predicateHolds(index, value, position) THEN
        kept = collections::append(kept, one)
      END IF
    NEXT
    current = kept
  NEXT
  RETURN current
END FUNC

' As filterNodes, for attributes: each attribute is its own context node.
PUBLIC FUNC filterAttrs(index AS List OF IndexedNode, attrs AS List OF AttrRef, predicates AS List OF Expr) AS List OF AttrRef
  MUT current AS List OF AttrRef = attrs
  FOR EACH predicate IN predicates
    MUT kept AS List OF AttrRef = []
    MUT position AS Integer = 0
    LET size AS Integer = len(current)
    FOR EACH one IN current
      position = position + 1
      LET value AS XValue = evalExpr(index, Context[one.node, one.at, position, size], predicate)
      IF predicateHolds(index, value, position) THEN
        kept = collections::append(kept, one)
      END IF
    NEXT
    current = kept
  NEXT
  RETURN current
END FUNC

' ---------------------------------------------------------------------------
' Location steps.
' ---------------------------------------------------------------------------

' Apply one step to a node-set of elements, the document node and their
' descendants. Predicates apply PER CONTEXT NODE: `//book[1]` is "the first book
' of each shelf", so a document with two shelves yields two nodes -- while
' `(//book)[1]`, a filter expression, yields one.
PRIVATE FUNC applyStep(index AS List OF IndexedNode, context AS List OF Integer, entry AS PathStep) AS XValue
  IF entry.axis = AXIS_ATTRIBUTE THEN
    MUT attrs AS List OF AttrRef = []
    FOR EACH at IN context
      IF at >= 0 THEN
        LET node AS IndexedNode = collections::get(index, at)
        MUT mine AS List OF AttrRef = []
        MUT i AS Integer = 0
        FOR EACH a IN node.attributes
          IF attributeMatches(a.name, entry) THEN
            mine = collections::append(mine, AttrRef[at, i])
          END IF
          i = i + 1
        NEXT
        FOR EACH one IN filterAttrs(index, mine, entry.predicates)
          attrs = collections::append(attrs, one)
        NEXT
      END IF
    NEXT
    LET value AS XValue = VAttrs[orderAttrs(attrs)]
    RETURN value
  END IF

  MUT reached AS List OF Integer = []
  FOR EACH at IN context
    MUT candidates AS List OF Integer = []
    IF entry.axis = AXIS_DESCENDANT_OR_SELF THEN
      ' Fused: the descendant range is a contiguous span of the index, so it is
      ' scanned and tested in one pass. Materializing the span first would build
      ' a list the size of the whole document for every `//` step.
      IF matchesTest(index, at, entry) THEN
        candidates = collections::append(candidates, at)
      END IF
      MUT i AS Integer = 0
      MUT stop AS Integer = len(index)
      IF at >= 0 THEN
        i = at + 1
        stop = subtreeEnd(index, at)
      END IF
      DO WHILE i < stop
        IF matchesTest(index, i, entry) THEN
          candidates = collections::append(candidates, i)
        END IF
        i = i + 1
      LOOP
    ELSE
      FOR EACH candidate IN axisFrom(index, at, entry.axis)
        IF matchesTest(index, candidate, entry) THEN
          candidates = collections::append(candidates, candidate)
        END IF
      NEXT
    END IF
    LET ordered AS List OF Integer = orderNodes(candidates)
    FOR EACH one IN filterNodes(index, ordered, entry.predicates)
      reached = collections::append(reached, one)
    NEXT
  NEXT
  LET value AS XValue = VNodes[orderNodes(reached)]
  RETURN value
END FUNC

' Apply one step to a set of attributes. An attribute has no children and no
' descendants, so only the steps that reach itself or its element do anything:
' `.` and `descendant-or-self::node()` select the attribute, and `..` selects its
' element. Every other axis is empty from an attribute.
PRIVATE FUNC applyAttributeStep(index AS List OF IndexedNode, context AS List OF AttrRef, entry AS PathStep) AS XValue
  IF entry.axis = AXIS_PARENT THEN
    MUT owners AS List OF Integer = []
    FOR EACH one IN context
      LET single AS List OF Integer = [one.node]
      FOR EACH owner IN filterNodes(index, single, entry.predicates)
        owners = collections::append(owners, owner)
      NEXT
    NEXT
    LET value AS XValue = VNodes[orderNodes(owners)]
    RETURN value
  END IF
  IF entry.axis = AXIS_SELF OR entry.axis = AXIS_DESCENDANT_OR_SELF THEN
    MUT kept AS List OF AttrRef = []
    FOR EACH one IN context
      LET single AS List OF AttrRef = [one]
      FOR EACH k IN filterAttrs(index, single, entry.predicates)
        kept = collections::append(kept, k)
      NEXT
    NEXT
    LET value AS XValue = VAttrs[orderAttrs(kept)]
    RETURN value
  END IF
  LET none AS List OF AttrRef = []
  LET empty AS XValue = VAttrs[none]
  RETURN empty
END FUNC

' Apply each step in turn to the value the previous one produced. A location path
' is a chain of node-sets, and an attribute set is one of them: a step that
' follows an attribute (`//a/@id/..`) continues from the attribute.
PRIVATE FUNC applySteps(index AS List OF IndexedNode, start AS XValue, steps AS List OF PathStep) AS XValue
  MUT current AS XValue = start
  FOR EACH entry IN steps
    MATCH current
      CASE VNodes(n)
        current = applyStep(index, n.nodes, entry)
      CASE VAttrs(a)
        current = applyAttributeStep(index, a.attrs, entry)
      CASE ELSE
        FAIL error(ERR_FORMAT, "xml: a location step needs a node-set")
    END MATCH
  NEXT
  RETURN current
END FUNC

' ---------------------------------------------------------------------------
' Comparisons (§3.4).
' ---------------------------------------------------------------------------

' The string-values of a node-set's members, or of a single value.
PUBLIC FUNC stringsOfValue(index AS List OF IndexedNode, value AS XValue) AS List OF String
  MUT out AS List OF String = []
  MATCH value
    CASE VNodes(n)
      FOR EACH one IN n.nodes
        out = collections::append(out, stringValueOf(index, one))
      NEXT
    CASE VAttrs(a)
      FOR EACH one IN a.attrs
        out = collections::append(out, attributeValueAt(index, one))
      NEXT
    CASE ELSE
      out = collections::append(out, stringOfValue(index, value))
  END MATCH
  RETURN out
END FUNC

PRIVATE FUNC isNodeSet(value AS XValue) AS Boolean
  MUT out AS Boolean = FALSE
  MATCH value
    CASE VNodes(n)
      out = TRUE
    CASE VAttrs(a)
      out = TRUE
    CASE ELSE
  END MATCH
  RETURN out
END FUNC

PRIVATE FUNC isBoolean(value AS XValue) AS Boolean
  MUT out AS Boolean = FALSE
  MATCH value
    CASE VBoolean(b)
      out = TRUE
    CASE ELSE
  END MATCH
  RETURN out
END FUNC

' A node-set compared with a boolean has already been converted to one; any other
' value keeps its own type, which a relational operator then reads as a number.
PRIVATE FUNC asBooleanIfNodeSet(index AS List OF IndexedNode, value AS XValue) AS XValue
  IF isNodeSet(value) THEN RETURN VBoolean[booleanOfValue(index, value)]
  RETURN value
END FUNC

PRIVATE FUNC compareStrings(op AS Integer, left AS String, right AS String) AS Boolean
  IF op = OP_EQ THEN RETURN left = right
  RETURN left <> right
END FUNC

' §3.4: when either operand is a node-set the comparison is EXISTENTIAL -- true
' when ANY pairing satisfies it. `@a = 'x'` over several elements is true when
' one of them has `a="x"`, not when all do.
'
' A boolean on either side wins over everything else: a node-set is converted to
' a boolean first, as a whole, so `//empty = true()` is true when the set has a
' member, whatever that member's string-value is.
PRIVATE FUNC compareValues(index AS List OF IndexedNode, op AS Integer, left AS XValue, right AS XValue) AS Boolean
  IF isBoolean(left) OR isBoolean(right) THEN
    IF op = OP_EQ OR op = OP_NE THEN
      LET same AS Boolean = booleanOfValue(index, left) = booleanOfValue(index, right)
      IF op = OP_EQ THEN RETURN same
      RETURN NOT same
    END IF
    LET l AS XValue = asBooleanIfNodeSet(index, left)
    LET r AS XValue = asBooleanIfNodeSet(index, right)
    RETURN compareNumbers(op, numberOfValue(index, l), numberOfValue(index, r))
  END IF

  LET leftSet AS Boolean = isNodeSet(left)
  LET rightSet AS Boolean = isNodeSet(right)

  IF leftSet AND rightSet THEN
    FOR EACH l IN stringsOfValue(index, left)
      FOR EACH r IN stringsOfValue(index, right)
        IF op = OP_EQ OR op = OP_NE THEN
          IF compareStrings(op, l, r) THEN
            RETURN TRUE
          END IF
        ELSE
          IF compareNumbers(op, stringToNumber(l), stringToNumber(r)) THEN
            RETURN TRUE
          END IF
        END IF
      NEXT
    NEXT
    RETURN FALSE
  END IF

  IF leftSet OR rightSet THEN
    ' `flipped` is TRUE when the node-set is on the right, so that the comparison
    ' is always written as `left op right`.
    LET flipped AS Boolean = rightSet
    MUT values AS List OF String = stringsOfValue(index, left)
    MUT other AS XValue = right
    IF flipped THEN
      values = stringsOfValue(index, right)
      other = left
    END IF
    FOR EACH one IN values
      MUT holds AS Boolean = FALSE
      MATCH other
        CASE VNumber(m)
          LET l AS Num = stringToNumber(one)
          IF flipped THEN
            holds = compareNumbers(op, m.number, l)
          ELSE
            holds = compareNumbers(op, l, m.number)
          END IF
        CASE ELSE
          LET text AS String = stringOfValue(index, other)
          IF op = OP_EQ OR op = OP_NE THEN
            holds = compareStrings(op, one, text)
          ELSE
            LET l2 AS Num = stringToNumber(one)
            LET r2 AS Num = stringToNumber(text)
            IF flipped THEN
              holds = compareNumbers(op, r2, l2)
            ELSE
              holds = compareNumbers(op, l2, r2)
            END IF
          END IF
      END MATCH
      IF holds THEN RETURN TRUE
    NEXT
    RETURN FALSE
  END IF

  ' Neither side is a node-set or a boolean: a number on either side, or a
  ' relational operator, compares as numbers, and otherwise as strings.
  MUT leftNumber AS Boolean = FALSE
  MUT rightNumber AS Boolean = FALSE
  MATCH left
    CASE VNumber(m)
      leftNumber = TRUE
    CASE ELSE
  END MATCH
  MATCH right
    CASE VNumber(m)
      rightNumber = TRUE
    CASE ELSE
  END MATCH
  IF leftNumber OR rightNumber OR op = OP_LT OR op = OP_LE OR op = OP_GT OR op = OP_GE THEN
    RETURN compareNumbers(op, numberOfValue(index, left), numberOfValue(index, right))
  END IF
  RETURN compareStrings(op, stringOfValue(index, left), stringOfValue(index, right))
END FUNC

' ---------------------------------------------------------------------------
' Expressions.
' ---------------------------------------------------------------------------

PRIVATE FUNC nodesOfValue(value AS XValue, what AS String) AS List OF Integer
  MUT out AS List OF Integer = []
  MATCH value
    CASE VNodes(n)
      out = n.nodes
    CASE ELSE
      FAIL error(ERR_FORMAT, "xml: " & what & " needs a node-set")
  END MATCH
  RETURN out
END FUNC

' The members of two attribute sets, in document order and without repeats.
PRIVATE FUNC mergeAttrs(left AS List OF AttrRef, right AS List OF AttrRef) AS List OF AttrRef
  MUT merged AS List OF AttrRef = left
  FOR EACH one IN right
    merged = collections::append(merged, one)
  NEXT
  RETURN orderAttrs(merged)
END FUNC

' A union: two node-sets of one kind join into one, in document order. Two
' attribute sets join likewise. A union of an element set and an attribute set is
' refused, because XPathValue holds one kind of result or the other. An empty set
' of either kind joins with anything, as an empty set always does.
PRIVATE FUNC unionOf(left AS XValue, right AS XValue) AS XValue
  IF isEmptySet(left) THEN RETURN right
  IF isEmptySet(right) THEN RETURN left
  LET leftIsAttrs AS Boolean = isAttrSet(left)
  LET rightIsAttrs AS Boolean = isAttrSet(right)
  IF leftIsAttrs AND rightIsAttrs THEN
    MUT leftAttrs AS List OF AttrRef = []
    MATCH left
      CASE VAttrs(a)
        leftAttrs = a.attrs
      CASE ELSE
    END MATCH
    MUT rightAttrs AS List OF AttrRef = []
    MATCH right
      CASE VAttrs(a)
        rightAttrs = a.attrs
      CASE ELSE
    END MATCH
    LET both AS XValue = VAttrs[mergeAttrs(leftAttrs, rightAttrs)]
    RETURN both
  END IF
  IF leftIsAttrs OR rightIsAttrs THEN
    FAIL error(ERR_UNSUPPORTED, "xml: a union may not mix attributes with other nodes")
  END IF
  MUT merged AS List OF Integer = nodesOfValue(left, "a union")
  FOR EACH one IN nodesOfValue(right, "a union")
    merged = collections::append(merged, one)
  NEXT
  LET nodes AS XValue = VNodes[orderNodes(merged)]
  RETURN nodes
END FUNC

PRIVATE FUNC isEmptySet(value AS XValue) AS Boolean
  MUT out AS Boolean = FALSE
  MATCH value
    CASE VNodes(n)
      out = len(n.nodes) = 0
    CASE VAttrs(a)
      out = len(a.attrs) = 0
    CASE ELSE
  END MATCH
  RETURN out
END FUNC

PRIVATE FUNC isAttrSet(value AS XValue) AS Boolean
  MUT out AS Boolean = FALSE
  MATCH value
    CASE VAttrs(a)
      out = TRUE
    CASE ELSE
  END MATCH
  RETURN out
END FUNC

' The context value a relative path starts from, or the document for an
' absolute one.
PRIVATE FUNC pathStart(ctx AS Context, absolute AS Boolean) AS XValue
  IF absolute THEN
    LET root AS List OF Integer = [-1]
    LET value AS XValue = VNodes[root]
    RETURN value
  END IF
  RETURN contextValue(ctx)
END FUNC

PUBLIC FUNC evalExpr(index AS List OF IndexedNode, ctx AS Context, e AS Expr) AS XValue
  MUT out AS XValue = VBoolean[FALSE]
  MATCH e
    CASE Literal(l)
      out = VString[l.value]
    CASE Numeric(n)
      out = VNumber[plainNumber(n.value)]
    CASE Call(c)
      out = evalFunction(index, ctx, c)
    CASE UnaryExpr(u)
      LET operand AS XValue = evalExpr(index, ctx, u.operand)
      out = VNumber[negateNumber(numberOfValue(index, operand))]
    CASE Path(p)
      out = applySteps(index, pathStart(ctx, p.absolute), p.steps)
    CASE Filter(f)
      LET base AS XValue = evalExpr(index, ctx, f.base)
      MUT filtered AS XValue = base
      MATCH base
        CASE VNodes(n)
          filtered = VNodes[filterNodes(index, n.nodes, f.predicates)]
        CASE VAttrs(a)
          filtered = VAttrs[filterAttrs(index, a.attrs, f.predicates)]
        CASE ELSE
          FAIL error(ERR_FORMAT, "xml: a filter expression needs a node-set")
      END MATCH
      IF len(f.steps) = 0 THEN
        out = filtered
      ELSE
        out = applySteps(index, filtered, f.steps)
      END IF
    CASE BinaryExpr(b)
      IF b.op = OP_OR THEN
        LET left AS XValue = evalExpr(index, ctx, b.left)
        IF booleanOfValue(index, left) THEN
          out = VBoolean[TRUE]
        ELSE
          LET right AS XValue = evalExpr(index, ctx, b.right)
          out = VBoolean[booleanOfValue(index, right)]
        END IF
      ELSEIF b.op = OP_AND THEN
        LET left AS XValue = evalExpr(index, ctx, b.left)
        IF NOT booleanOfValue(index, left) THEN
          out = VBoolean[FALSE]
        ELSE
          LET right AS XValue = evalExpr(index, ctx, b.right)
          out = VBoolean[booleanOfValue(index, right)]
        END IF
      ELSEIF b.op = OP_UNION THEN
        LET left AS XValue = evalExpr(index, ctx, b.left)
        LET right AS XValue = evalExpr(index, ctx, b.right)
        out = unionOf(left, right)
      ELSEIF b.op = OP_EQ OR b.op = OP_NE OR b.op = OP_LT OR b.op = OP_LE OR b.op = OP_GT OR b.op = OP_GE THEN
        LET left AS XValue = evalExpr(index, ctx, b.left)
        LET right AS XValue = evalExpr(index, ctx, b.right)
        out = VBoolean[compareValues(index, b.op, left, right)]
      ELSE
        LET left AS XValue = evalExpr(index, ctx, b.left)
        LET right AS XValue = evalExpr(index, ctx, b.right)
        LET l AS Num = numberOfValue(index, left)
        LET r AS Num = numberOfValue(index, right)
        IF b.op = OP_ADD THEN
          out = VNumber[addNumbers(l, r)]
        ELSEIF b.op = OP_SUB THEN
          out = VNumber[subtractNumbers(l, r)]
        ELSEIF b.op = OP_MUL THEN
          out = VNumber[multiplyNumbers(l, r)]
        ELSEIF b.op = OP_DIV THEN
          out = VNumber[divideNumbers(l, r)]
        ELSE
          out = VNumber[moduloNumbers(l, r)]
        END IF
      END IF
  END MATCH
  RETURN out
END FUNC

' ---------------------------------------------------------------------------
' Handing a result back.
'
' This is the ONLY place index positions become `Node` values, which is what
' keeps a query proportional to its result rather than to the document.
' ---------------------------------------------------------------------------

PUBLIC FUNC publicValue(index AS List OF IndexedNode, value AS XValue) AS XPathValue
  MUT out AS XPathValue = XBoolean[FALSE]
  MATCH value
    CASE VNodes(n)
      MUT nodes AS List OF Node = []
      FOR EACH at IN n.nodes
        IF at >= 0 THEN
          nodes = collections::append(nodes, nodeAt(index, at))
        ELSE
          ' The document node has no `Node` form. Selecting it -- `/`, or `..`
          ' from the root element -- means the document, so it comes back as the
          ' document ELEMENT. Returning every top-level node instead would add
          ' the prolog's comments and processing instructions, which are not the
          ' document.
          FOR EACH one IN rootsOf(index)
            IF collections::get(index, one).kind = KIND_ELEMENT THEN
              nodes = collections::append(nodes, nodeAt(index, one))
            END IF
          NEXT
        END IF
      NEXT
      out = XNodes[nodes]
    CASE VAttrs(a)
      MUT attributes AS List OF Attribute = []
      FOR EACH one IN a.attrs
        attributes = collections::append(attributes, attributeAt(index, one.node, one.at))
      NEXT
      out = XAttributes[attributes]
    CASE VString(s)
      out = XString[s.value]
    CASE VNumber(m)
      ' `XNumber.value` is a `Float`, and MFBASIC cannot hold NaN or an infinity
      ' in one. Those results are still computable and still printable: ask for
      ' them with `xml::valueOf`, which yields "NaN", "Infinity" or "-Infinity".
      ' Handing back a `Float` here would have to invent a number.
      IF m.number.special <> NUM_NORMAL THEN
        FAIL error(ERR_UNSUPPORTED, "xml: the result is " & numberToString(m.number) & ", which no Float can hold -- use xml::valueOf to read it as text")
      END IF
      out = XNumber[m.number.value]
    CASE VBoolean(b)
      out = XBoolean[b.value]
  END MATCH
  RETURN out
END FUNC
