' ---------------------------------------------------------------------------
' xmlprobe — the MFBASIC side of the XML differential oracle.
'
' It reads one JSON job file and writes ONE JSON document to stdout, holding one
' result per case in the same order. A whole job per process rather than a
' process per case: a fuzzing run asks thousands of questions, and starting a
' process costs more than answering one.
'
'   in   {"cases":[{"id":"c1","xml":"<a/>"}]}                        (read)
'        {"cases":[{"id":"c1","tree":["doc",[...]],"indent":"  "}]}  (write)
'
'   out  {"results":[{"id":"c1","ok":true,"content":["doc",[...]]},
'                    {"id":"c2","ok":false,"kind":"parse","reason":"..."}]}
'
' A REFUSAL is a result, reported on stdout with exit 0. That leaves a non-zero
' exit or an unparseable document meaning exactly one thing -- the probe itself
' broke -- which is what the runner's `mutate` mode checks for.
'
' The answer is built as TEXT, not as `json::Json` values. That is a performance
' decision with a measurement behind it: assembling the envelope out of nested
' json::Json arrays took 15.64 s for a 100,000-node document nested 255 deep,
' against a 3.00 s budget, because storing a deeply nested value copies the whole
' graph each time (bugs/bug-647). The same document parses in 0.31 s. Emitting
' text keeps the cost proportional to the output, and each string is escaped by
' `json::stringify` on a single `JsonStr`, so no deep graph is ever built.
' ---------------------------------------------------------------------------

IMPORT xml
IMPORT json
IMPORT collections
IMPORT strings
IMPORT fs
IMPORT io
IMPORT os

FUNC main() AS Integer
  LET args AS List OF String = os::args()
  IF len(args) <> 2 THEN
    io::printError("usage: xmlprobe read|write <job.json>")
    RETURN 2
  END IF
  LET operation AS String = collections::get(args, 0)
  IF operation <> "read" AND operation <> "write" AND operation <> "xpath" THEN
    io::printError("xmlprobe: unknown operation `" & operation & "` (expected read, write or xpath)")
    RETURN 2
  END IF
  LET job AS json::Json = json::parse(fs::readText(collections::get(args, 1)))
  MUT results AS List OF String = []
  FOR EACH entry IN itemsOf(json::get(job, ["cases"]))
    IF operation = "read" THEN
      results = collections::append(results, readCase(entry))
    ELSEIF operation = "xpath" THEN
      results = collections::append(results, xpathCase(entry))
    ELSE
      results = collections::append(results, writeCase(entry))
    END IF
  NEXT
  io::print("{\"results\":[" & strings::join(results, ",") & "]}")
  RETURN 0

  TRAP(problem)
    ' A failure out here is the harness's, not the package's: an unreadable job
    ' file or a job that is not the shape agreed above.
    io::printError("xmlprobe: " & problem.message)
    RETURN 1
  END TRAP
END FUNC

' ---------------------------------------------------------------------------
' Cases. Every package failure is a RESULT; only a malformed job escapes.
' ---------------------------------------------------------------------------

PRIVATE FUNC readCase(entry AS json::Json) AS String
  LET id AS String = textOf(entry, "id", "")
  LET text AS String = textOf(entry, "xml", "")
  ' A RECOVER would have to supply a Document, so the refusal leaves by RETURN:
  ' the envelope is the result, not a substitute tree.
  LET doc AS xml::Document = xml::parse(text) TRAP(problem)
    RETURN refusal(id, problem.code, problem.message)
  END TRAP
  RETURN "{\"id\":" & quoted(id) & ",\"ok\":true,\"content\":" & contentOfDocument(doc) & "}"
END FUNC

PRIVATE FUNC writeCase(entry AS json::Json) AS String
  LET id AS String = textOf(entry, "id", "")
  LET indent AS String = textOf(entry, "indent", "")
  LET doc AS xml::Document = documentOfJson(json::get(entry, ["tree"]))
  LET text AS String = xml::stringify(doc, indent) TRAP(problem)
    RETURN refusal(id, problem.code, problem.message)
  END TRAP
  RETURN "{\"id\":" & quoted(id) & ",\"ok\":true,\"xml\":" & quoted(text) & "}"
END FUNC

' One `xpath` case: `{"id", "xml", "expr"}`.
'
' A number comes back through `xml::valueOf` rather than from the `XNumber`
' variant, for two reasons that point the same way: XPath compares a number by
' its §4.2 STRING form, and the package refuses to hand back a NaN or an
' infinity as a `Float` at all (no MFBASIC Float can hold one), so `valueOf` is
' the only way to see those results. All three sides therefore compare the same
' text.
PRIVATE FUNC xpathCase(entry AS json::Json) AS String
  LET id AS String = textOf(entry, "id", "")
  LET text AS String = textOf(entry, "xml", "")
  LET expr AS String = textOf(entry, "expr", "")

  LET doc AS Document = xml::parse(text) TRAP(problem)
    RETURN refusal(id, problem.code, problem.message)
  END TRAP

  LET value AS xml::XPathValue = xml::evaluate(doc, expr) TRAP(problem)
    ' A NaN or infinite number is refused by `evaluate` but readable by
    ' `valueOf`; anything else is a genuine refusal.
    LET asText AS String = xml::valueOf(doc, expr) TRAP(inner)
      RETURN refusal(id, problem.code, problem.message)
    END TRAP
    RETURN "{\"id\":" & quoted(id) & ",\"ok\":true,\"kind\":\"number\",\"value\":" & quoted(asText) & "}"
  END TRAP

  MATCH value
    CASE XNodes(n)
      MUT parts AS List OF String = []
      FOR EACH one IN n.nodes
        parts = collections::append(parts, nodeEnvelope(one))
      NEXT
      RETURN "{\"id\":" & quoted(id) & ",\"ok\":true,\"kind\":\"nodes\",\"value\":[" & strings::join(parts, ",") & "]}"
    CASE XAttributes(a)
      MUT parts AS List OF String = []
      FOR EACH one IN a.attributes
        parts = collections::append(parts, "[" & quoted(one.name) & "," & quoted(one.value) & "]")
      NEXT
      RETURN "{\"id\":" & quoted(id) & ",\"ok\":true,\"kind\":\"attributes\",\"value\":[" & strings::join(parts, ",") & "]}"
    CASE XString(s)
      RETURN "{\"id\":" & quoted(id) & ",\"ok\":true,\"kind\":\"string\",\"value\":" & quoted(s.value) & "}"
    CASE XNumber(m)
      RETURN "{\"id\":" & quoted(id) & ",\"ok\":true,\"kind\":\"number\",\"value\":" & quoted(xml::valueOf(doc, expr)) & "}"
    CASE XBoolean(b)
      MUT flag AS String = "false"
      IF b.value THEN flag = "true"
      RETURN "{\"id\":" & quoted(id) & ",\"ok\":true,\"kind\":\"boolean\",\"value\":" & flag & "}"
  END MATCH
END FUNC

' One node of an XPath result, in the same content shape a `read` answer uses.
PRIVATE FUNC nodeEnvelope(n AS xml::Node) AS String
  MUT out AS String = ""
  MATCH n
    CASE Element(e)
      out = elementText(e)
    CASE Text(t)
      out = "[\"t\"," & quoted(t.text) & "]"
    CASE Comment(c)
      out = "[\"t\"," & quoted(c.text) & "]"
    CASE ProcessingInstruction(p)
      out = "[\"t\"," & quoted(p.data) & "]"
  END MATCH
  RETURN out
END FUNC

' A refusal envelope. `kind` is triage only -- two refusals agree without
' comparing kind or reason, because three implementations have three
' vocabularies for "no" and demanding the same words would make the harness
' fail on wording.
PRIVATE FUNC refusal(id AS String, code AS Integer, message AS String) AS String
  RETURN "{\"id\":" & quoted(id) & ",\"ok\":false,\"kind\":" & quoted(kindOfCode(code)) & ",\"reason\":" & quoted(message) & "}"
END FUNC

PRIVATE FUNC kindOfCode(code AS Integer) AS String
  IF code = 77050007 THEN RETURN "unsupported"
  IF code = 93140001 THEN RETURN "limit"
  IF code = 77050024 THEN RETURN "limit"
  RETURN "parse"
END FUNC

' One JSON string, quoted and escaped. `json::stringify` on a single JsonStr is
' the escaper; the value is flat, so no graph is copied.
PRIVATE FUNC quoted(text AS String) AS String
  RETURN json::stringify(json::JsonStr[text])
END FUNC

' ---------------------------------------------------------------------------
' The content projection (plan-138-A §4), emitted as JSON text.
'
'   ["doc", [<node>, ...]]
'   <node> := ["e", name, [[attrName, value], ... sorted], [<node>, ...]]
'           | ["t", text]
' ---------------------------------------------------------------------------

PRIVATE FUNC contentOfDocument(doc AS Document) AS String
  RETURN "[\"doc\",[" & projectChildren(doc.children) & "]]"
END FUNC

' TRUE when any child is an element.
PRIVATE FUNC anyElement(children AS List OF xml::Node) AS Boolean
  FOR EACH k IN children
    MATCH k
      CASE Element(e) : RETURN TRUE
      CASE ELSE
    END MATCH
  NEXT
  RETURN FALSE
END FUNC

PRIVATE FUNC allSpace(s AS String) AS Boolean
  IF len(s) = 0 THEN RETURN TRUE
  FOR EACH sc IN strings::toScalars(s)
    LET code AS Integer = toInt(sc)
    IF code <> 32 AND code <> 9 AND code <> 13 AND code <> 10 THEN RETURN FALSE
  NEXT
  RETURN TRUE
END FUNC

' Steps 1-3: drop comments and PIs, merge adjacent text, drop layout whitespace.
PRIVATE FUNC projectChildren(children AS List OF xml::Node) AS String
  LET dropLayout AS Boolean = anyElement(children)
  MUT parts AS List OF String = []
  MUT pending AS String = ""
  FOR EACH k IN children
    MATCH k
      CASE Text(t)
        pending = pending & t.text
      CASE Element(e)
        IF pending <> "" THEN
          IF NOT (dropLayout AND allSpace(pending)) THEN
            parts = collections::append(parts, "[\"t\"," & quoted(pending) & "]")
          END IF
          pending = ""
        END IF
        parts = collections::append(parts, elementText(e))
      CASE ELSE
        ' A comment or PI is not content, and removing it lets the text on
        ' either side of it merge.
    END MATCH
  NEXT
  IF pending <> "" THEN
    IF NOT (dropLayout AND allSpace(pending)) THEN
      parts = collections::append(parts, "[\"t\"," & quoted(pending) & "]")
    END IF
  END IF
  RETURN strings::join(parts, ",")
END FUNC

PRIVATE FUNC elementText(e AS xml::Element) AS String
  RETURN "[\"e\"," & quoted(e.name) & ",[" & sortedAttributes(e.attributes) & "],[" & projectChildren(e.children) & "]]"
END FUNC

' Attributes as a SET: sorted by name, since XML gives their order no meaning.
PRIVATE FUNC sortedAttributes(attributes AS List OF xml::Attribute) AS String
  MUT names AS List OF String = []
  FOR EACH a IN attributes
    names = collections::append(names, a.name)
  NEXT
  MUT parts AS List OF String = []
  FOR EACH name IN collections::sort(names)
    FOR EACH a IN attributes
      IF a.name = name THEN
        parts = collections::append(parts, "[" & quoted(a.name) & "," & quoted(a.value) & "]")
      END IF
    NEXT
  NEXT
  RETURN strings::join(parts, ",")
END FUNC

' ---------------------------------------------------------------------------
' The reverse direction: a `write` job hands over a tree in the same shape.
' ---------------------------------------------------------------------------

PRIVATE FUNC documentOfJson(tree AS json::Json) AS xml::Document
  LET parts AS List OF json::Json = itemsOf(tree)
  IF len(parts) <> 2 THEN
    FAIL error(77050003, "xmlprobe: a tree must be [\"doc\", [children]]")
  END IF
  RETURN xml::document(nodesOfJson(collections::get(parts, 1)))
END FUNC

PRIVATE FUNC nodesOfJson(items AS json::Json) AS List OF xml::Node
  MUT out AS List OF xml::Node = []
  FOR EACH item IN itemsOf(items)
    out = collections::append(out, nodeOfJson(item))
  NEXT
  RETURN out
END FUNC

PRIVATE FUNC nodeOfJson(value AS json::Json) AS xml::Node
  LET parts AS List OF json::Json = itemsOf(value)
  IF len(parts) = 0 THEN
    FAIL error(77050003, "xmlprobe: a node may not be empty")
  END IF
  LET tag AS String = stringOf(collections::get(parts, 0))
  IF tag = "t" THEN
    RETURN xml::text(stringOf(collections::get(parts, 1)))
  END IF
  IF tag = "c" THEN
    RETURN xml::comment(stringOf(collections::get(parts, 1)))
  END IF
  IF tag = "p" THEN
    RETURN xml::pi(stringOf(collections::get(parts, 1)), stringOf(collections::get(parts, 2)))
  END IF
  IF tag <> "e" THEN
    FAIL error(77050003, "xmlprobe: unknown node tag `" & tag & "`")
  END IF
  MUT attributes AS List OF xml::Attribute = []
  FOR EACH pair IN itemsOf(collections::get(parts, 2))
    LET both AS List OF json::Json = itemsOf(pair)
    attributes = collections::append(attributes, xml::Attribute[stringOf(collections::get(both, 0)), stringOf(collections::get(both, 1))])
  NEXT
  RETURN xml::element(stringOf(collections::get(parts, 1)), attributes, nodesOfJson(collections::get(parts, 3)))
END FUNC

' ---------------------------------------------------------------------------
' Reading the job. Everything here is the harness's own JSON, so a shape it does
' not expect is a harness bug and fails loudly.
' ---------------------------------------------------------------------------

PRIVATE FUNC itemsOf(value AS json::Json) AS List OF json::Json
  MATCH value
    CASE json::JsonArr(list) : RETURN list.items
    CASE ELSE : FAIL error(77050003, "xmlprobe: expected a JSON array in the job")
  END MATCH
END FUNC

PRIVATE FUNC stringOf(value AS json::Json) AS String
  MATCH value
    CASE json::JsonStr(text) : RETURN text.value
    CASE ELSE : FAIL error(77050003, "xmlprobe: expected a JSON string in the job")
  END MATCH
END FUNC

PRIVATE FUNC fieldsOf(value AS json::Json) AS Map OF String TO json::Json
  MATCH value
    CASE json::JsonObj(object) : RETURN object.fields
    CASE ELSE : FAIL error(77050003, "xmlprobe: expected a JSON object in the job")
  END MATCH
END FUNC

PRIVATE FUNC textOf(value AS json::Json, member AS String, fallback AS String) AS String
  LET fields AS Map OF String TO json::Json = fieldsOf(value)
  IF NOT collections::hasKey(fields, member) THEN RETURN fallback
  RETURN stringOf(collections::get(fields, member))
END FUNC
