{
  "doc": "catalog.xml",
  "comment": "All seventeen functions of the §4 subset.",
  "exprs": [
    "count(//book)",
    "count(//tag)",
    "count(//missing)",
    "count(//book/@*)",
    "contains(//title, 'une')",
    "contains(//title, 'zzz')",
    "starts-with(//title, 'Dun')",
    "starts-with(//title, 'x')",
    "string(//title)",
    "string(//missing)",
    "string(//book/@id)",
    "string(count(//book))",
    "normalize-space('  a   b  ')",
    "normalize-space(//mixed)",
    "not(//book)",
    "not(//missing)",
    "not(1 = 2)",
    "//book[position() = last()]/@id",
    "name(//book)",
    "name(//book/@id)",
    "local-name(//book)",
    "concat('a', 'b')",
    "concat('a', 'b', 'c')",
    "concat(//title, '!')",
    "string-length('abc')",
    "string-length(//title)",
    "string-length(//missing)",
    "number('2.5')",
    "number('x')",
    "number(//price)",
    "sum(//price)",
    "sum(//missing)",
    "true()",
    "false()",
    "boolean(//book)",
    "boolean(//missing)",
    "boolean('')",
    "boolean('x')",
    "boolean(0)",
    "boolean(1)"
  ]
}
