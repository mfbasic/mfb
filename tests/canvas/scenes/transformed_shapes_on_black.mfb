IMPORT app
IMPORT canvas
IMPORT vector
IMPORT color
IMPORT collections
IMPORT math

FUNC ring(n AS Integer, cx AS Float, cy AS Float, r AS Float) AS List OF vector::Float2
  MUT points AS List OF vector::Float2 = []
  MUT i AS Integer = 0
  WHILE i < n
    LET a AS Float = toFloat(i) * 6.283185307179586 / toFloat(n)
    LET rr AS Float = r + 3.0 * math::sin(a * 5.0)
    points = collections::append(points, vector::Float2[x := cx + rr * math::cos(a), y := cy + rr * math::sin(a)])
    i = i + 1
  END WHILE
  RETURN points
END FUNC

' bug-735: the items of `stroked_shapes_on_black` -- butt-capped lines, round-capped arcs,
' filled-and-stroked circles, ellipses and rounded rectangles, butt-capped polylines --
' each under its own Paint.transform (a rotation and scale about its centre), and every
' other one clipped, over the default opaque-black surface. The transformed path takes
' five double-float samples per pixel for the gradient, and the clip its own
' double-float rectangle distance; before bug-735 both were fp32 from 16.16 inputs and
' put pixels past GPU_DEFAULT on Metal and Vulkan.
FUNC main() AS Nothing
  app::setMode(app::Mode.Canvas)
  MUT scene AS List OF canvas::DrawItem = []
  MUT k AS Integer = 0
  WHILE k < 140
    LET fx AS Float = toFloat(k) * 7.3719
    LET x AS Float = 32.0 + toFloat((k MOD 14) * 60) + math::sin(fx) * 0.37
    LET y AS Float = 32.0 + toFloat((k / 14) * 60) + math::cos(fx) * 0.41
    LET r AS Float = 8.0 + toFloat(k MOD 13) * 1.513
    LET c AS color::Color = color::rgb(250, 250, 120)
    LET w AS Float = 1.0 + toFloat(k MOD 7) * 0.3137
    LET c2 AS color::Color = color::rgb(250, 120, 250)
    LET ta AS Float = 0.93 + toFloat(k MOD 5) * 0.037
    LET tb AS Float = 0.31 - toFloat(k MOD 3) * 0.11
    LET tc AS Float = 0.0 - 0.28 + toFloat(k MOD 4) * 0.05
    LET td AS Float = 1.07 - toFloat(k MOD 7) * 0.029
    LET tf AS canvas::Transform = canvas::Transform[a := ta, b := tb, c := tc, d := td, tx := x - (ta * x + tc * y), ty := y - (tb * x + td * y)]
    ' plan-172-D: a Circle, Arc and Ellipse pivot about their `position`, which is (x, y).
    LET tfHere AS canvas::Transform = WITH tf { tx := 0.0, ty := 0.0 }
    MUT cl AS List OF List OF vector::Float2 = []
    MUT clHere AS List OF List OF vector::Float2 = []
    IF k MOD 2 = 1 THEN
      cl = [[vector::Float2[x := x - 17.3, y := y - 21.7], vector::Float2[x := x - 17.3 + 31.1, y := y - 21.7], vector::Float2[x := x - 17.3 + 31.1, y := y - 21.7 + 38.9], vector::Float2[x := x - 17.3, y := y - 21.7 + 38.9]]]
      ' plan-172-D: the same ring as offsets from (x, y), for the kinds whose clip is
      ' local to their `position`.
      clHere = [[vector::Float2[x := 0.0 - 17.3, y := 0.0 - 21.7], vector::Float2[x := 0.0 - 17.3 + 31.1, y := 0.0 - 21.7], vector::Float2[x := 0.0 - 17.3 + 31.1, y := 0.0 - 21.7 + 38.9], vector::Float2[x := 0.0 - 17.3, y := 0.0 - 21.7 + 38.9]]]
    END IF
    MUT d AS canvas::DrawItem = canvas::Line[id := "", x1 := x - r, y1 := y - r * 0.7, x2 := x + r, y2 := y + r * 0.9, paint := WITH canvas::stroke(c2, w) { clip := cl, cap := canvas::CapStyle.Butt }, transform := tf]
    IF k MOD 6 = 1 THEN
      d = canvas::Arc[id := "", position := vector::Float2[x := x, y := y], radius := r, startAngle := 0.3 + fx * 0.01, endAngle := 4.1 + fx * 0.02, paint := WITH canvas::stroke(c2, w) { clip := clHere, cap := canvas::CapStyle.Round }, transform := tfHere]
    ELSEIF k MOD 6 = 2 THEN
      d = canvas::Circle[id := "", position := vector::Float2[x := x, y := y], radius := r, paint := WITH canvas::fillStroke(c, c2, w) { clip := clHere }, transform := tfHere]
    ELSEIF k MOD 6 = 3 THEN
      ' plan-172-C: this ellipse was turned by `angle := fx` about its centre and then
      ' carried by `tf`, which turns about that same centre. The item has one transform,
      ' so it is the product of the two linear parts; plan-172-D made the centre the
      ' pivot, so there is no translation left.
      LET ec AS Float = math::cos(fx)
      LET es AS Float = math::sin(fx)
      LET turned AS canvas::Transform = canvas::Transform[a := ta * ec + tc * es, b := tb * ec + td * es, c := tc * ec - ta * es, d := td * ec - tb * es, tx := 0.0, ty := 0.0]
      d = canvas::Ellipse[id := "", position := vector::Float2[x := x, y := y], radiusX := r, radiusY := r * 0.61, paint := WITH canvas::fillStroke(c, c2, w) { clip := clHere }, transform := turned]
    ELSEIF k MOD 6 = 4 THEN
      d = canvas::RoundedRect[id := "", x := x - r, y := y - r * 0.6, w := r * 1.9, h := r * 1.3, cornerRadius := r * 0.3, paint := WITH canvas::fillStroke(c, c2, w) { clip := cl }, transform := tf]
    ELSEIF k MOD 6 = 5 THEN
      d = canvas::PolyLine[id := "", points := ring(40, x, y, r), colors := [], paint := WITH canvas::stroke(c2, w) { clip := cl, cap := canvas::CapStyle.Butt }, transform := tf]
    END IF
    scene = collections::append(scene, d)
    k = k + 1
  END WHILE
  canvas::present(scene)
END FUNC
