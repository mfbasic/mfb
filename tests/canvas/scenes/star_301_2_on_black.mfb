IMPORT app
IMPORT canvas
IMPORT vector
IMPORT color
IMPORT collections
IMPORT math

' bug-687: the star polygon {301/2}, filled, over the default opaque-black surface.
' Near black one step of coverage is several sRGB levels, so this is where a GPU
' distance that rounds to a different coverage step than the software oracle shows
' past Tolerance::GPU_DEFAULT. Even-odd fill, radius 180.
FUNC star(n AS Integer, k AS Integer, cx AS Float, cy AS Float, r AS Float) AS List OF vector::Float2
  MUT points AS List OF vector::Float2 = []
  MUT i AS Integer = 0
  WHILE i < n
    LET a AS Float = toFloat((i * k) MOD n) * 6.283185307179586 / toFloat(n)
    points = collections::append(points, vector::Float2[x := cx + r * math::cos(a), y := cy + r * math::sin(a)])
    i = i + 1
  END WHILE
  RETURN points
END FUNC

FUNC main() AS Nothing
  app::setMode(app::Mode.Canvas)
  LET e AS canvas::DrawItem = canvas::Polygon[contours := [star(301, 2, 450.0, 320.0, 180.0)], rule := canvas::FillRule.EvenOdd, paint := canvas::fill(color::rgb(250, 250, 120))]
  canvas::present([e])
END FUNC
