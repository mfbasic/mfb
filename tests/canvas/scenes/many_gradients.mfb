IMPORT app
IMPORT canvas
IMPORT vector
IMPORT color
IMPORT collections

FUNC main() AS Nothing
  app::setMode(app::Mode.Canvas)
  LET stops AS List OF canvas::GradientStop = [canvas::GradientStop[offset := 0.0, color := color::rgb(255, 64, 32)], canvas::GradientStop[offset := 1.0, color := color::rgb(32, 96, 255)]]
  MUT scene AS List OF canvas::DrawItem = []
  MUT k AS Integer = 0
  WHILE k < 2100
    LET x AS Float = toFloat((k MOD 60) * 15)
    LET y AS Float = toFloat((k / 60) * 18)
    LET ramp AS canvas::Gradient = canvas::Gradient[kind := canvas::GradientKind.Linear, startPoint := vector::Float2[x := x, y := y], endPoint := vector::Float2[x := x + 12.0, y := y + 15.0], stops := stops, spread := canvas::GradientSpread.Pad, transform := canvas::Transform[a := 0.0, b := 0.0, c := 0.0, d := 0.0, tx := 0.0, ty := 0.0], focalOffset := vector::Float2[x := 0.0, y := 0.0], focalRadius := 0.0, strokeApply := canvas::GradientApply.FillOnly]
    LET r AS canvas::DrawItem = canvas::Rectangle[x := x, y := y, w := 12.0, h := 15.0, paint := WITH canvas::fill(color::rgb(0, 0, 0)) { gradient := ramp }]
    scene = collections::append(scene, r)
    k = k + 1
  END WHILE
  canvas::present(scene)
END FUNC
