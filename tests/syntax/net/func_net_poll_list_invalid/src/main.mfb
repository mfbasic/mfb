' plan-76-A: the net::poll list overload rejects incorrect usage.
'  - A bare `List OF Socket` (no RES) is not a constructible collection type
'    (§15.6): a resource element must be marked RES.
'  - A non-list, non-Socket argument matches neither overload.
'  - A non-Integer timeout is rejected.
IMPORT net
IMPORT collections

FUNC main AS Integer
  ' Resource element without the RES marker — rejected at the declaration.
  MUT bare AS List OF Socket = []
  RES pickBare AS Socket = net::poll(bare)

  ' Neither Socket nor List OF RES Socket.
  LET pickStr = net::poll("not a socket")

  ' Wrong timeout type on the list overload.
  MUT socks AS List OF RES Socket = []
  RES pickBad AS Socket = net::poll(socks, "later")
  RETURN 0
END FUNC
