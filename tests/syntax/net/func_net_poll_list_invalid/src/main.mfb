' plan-76-A: the net::poll list overload rejects incorrect usage.
'  - A bare `List OF net::Socket` (no RES) is not a constructible collection type
'    (§15.6): a resource element must be marked RES.
'  - A non-list, non-net::Socket argument matches neither overload.
'  - A non-Integer timeout is rejected.
IMPORT net
IMPORT collections

FUNC main AS Integer
  ' Resource element without the RES marker — rejected at the declaration.
  MUT bare AS List OF net::Socket = []
  RES pickBare AS net::Socket = net::poll(bare)

  ' Neither net::Socket nor List OF RES net::Socket.
  LET pickStr = net::poll("not a socket")

  ' Wrong timeout type on the list overload.
  MUT socks AS List OF RES net::Socket = []
  RES pickBad AS net::Socket = net::poll(socks, "later")
  RETURN 0
END FUNC
