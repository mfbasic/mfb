' plan-76-A: both net::poll overloads resolve — the scalar readiness query
' (`Socket → Boolean`) and the readiness multiplex (`List OF RES Socket → Socket`,
' a borrowed element pointer the list still owns). Compile-only (-ast -ir).
IMPORT net
IMPORT io
IMPORT collections

FUNC main AS Integer
  RES server = net::listenTcp("127.0.0.1", 0)
  LET bound = net::localAddress(server)
  RES client = net::connectTcp("127.0.0.1", bound.port)
  RES conn = net::accept(server)

  ' Scalar overload: net::poll(Socket[, Integer]) → Boolean.
  LET ready AS Boolean = net::poll(conn)
  LET readyT AS Boolean = net::poll(conn, 100)
  io::print(toString(ready) & toString(readyT))

  ' List overload: net::poll(List OF RES Socket[, Integer]) → Socket (borrowed).
  MUT socks AS List OF RES Socket = []
  socks = collections::append(socks, conn)
  RES first AS Socket = net::poll(socks)
  RES firstT AS Socket = net::poll(socks, 100)
  net::writeText(first, "x")
  net::writeText(firstT, "y")
  RETURN 0
END FUNC
