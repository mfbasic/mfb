' `tcp::write`'s String overload: the same arity and argument-type errors as
' `func_tcp_write_invalid` pins for the bytes overload. `tcp` has no
' `writeText` member -- that spelling's removal is pinned by
' `func_tcp_removed_members_invalid`.
IMPORT tcp

FUNC main AS Integer
  LET missing = tcp::write()
  LET wrongType = tcp::write(1, "v")
  LET wrongValue = tcp::write("s", 5)
  LET tooMany = tcp::write(1, "v", 3)
  RETURN 0
END FUNC
