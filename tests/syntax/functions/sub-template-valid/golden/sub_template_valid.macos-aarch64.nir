    { "op": "eval", "value": { "kind": "call", "target": "consume$String", "args": [{ "kind": "const", "type": "String", "value": "ok" }] } },
    { "op": "eval", "value": { "kind": "runtimeCall", "helper": "io", "target": "io.print", "args": [{ "kind": "const", "type": "String", "value": "ok" }] } }
    ]
