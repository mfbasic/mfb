IMPORT io

PRIVATE FUNC privateDouble(value AS Integer) AS Integer
  RETURN value * 2
END FUNC

PUBLIC FUNC packageValue(value AS Integer) AS Integer
  RETURN privateDouble(value) + 1
END FUNC

FUNC exportValue(value AS Integer) AS Integer
  RETURN value + 3
END FUNC

PRIVATE FUNC privateTrace(value AS Integer) AS Nothing
  io::print("private=" & toString(value))
END FUNC

PUBLIC FUNC packageTrace(value AS Integer) AS Nothing
  privateTrace(value)
END FUNC

FUNC exportTrace(value AS Integer) AS Nothing
  io::print("export=" & toString(value))
END FUNC
