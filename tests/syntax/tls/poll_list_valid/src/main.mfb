' plan-76-C: the tls::poll list overload resolves to tls::Socket (borrowed), and the
' scalar overload still resolves to Boolean. Compile-only (-ast -ir).
IMPORT tls
IMPORT io
IMPORT collections

FUNC main AS Integer
  RES conn = tls::connect("example.com", 443)
  ' Scalar overload → Boolean.
  LET ready AS Boolean = tls::poll(conn)
  io::print(toString(ready))
  ' List overload → tls::Socket (borrowed element).
  MUT socks AS List OF RES tls::Socket = []
  socks = collections::append(socks, conn)
  RES first AS tls::Socket = tls::poll(socks)
  RES firstT AS tls::Socket = tls::poll(socks, 100)
  tls::write(first, "a")
  tls::write(firstT, "b")
  RETURN 0
END FUNC
