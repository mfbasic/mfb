IMPORT tls

FUNC main AS Integer
  LET missing = tls::connect()
  LET wrongType = tls::connect(1, 2)
  ' bug-477 added a 5th parameter (`allowSelfSigned AS Boolean`), so 5 arguments
  ' is a valid arity now and this is a TYPE error, not an arity one: `9` is an
  ' Integer in a Boolean slot. Renamed from `tooMany`, which no longer
  ' describes what it pins.
  LET wrongFlagType = tls::connect("example.com", 443, 0, "example.com", 9)
  RETURN 0
END FUNC
