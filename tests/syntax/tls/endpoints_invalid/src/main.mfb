' plan-110-D Phase 2: wrong types and arities for the four new members, plus
' the shapes the `net::Address` connect overload must NOT accept.
IMPORT tls

FUNC main AS Integer
  ' The endpoint queries take exactly one TLS socket.
  LET missingLocal = tls::localAddress()
  LET wrongLocal = tls::localAddress(1)
  LET tooManyLocal = tls::localAddress(1, 2)
  LET missingRemote = tls::remoteAddress()
  LET wrongRemote = tls::remoteAddress("sock")
  LET tooManyRemote = tls::remoteAddress(1, 2)

  ' The timeout setters take a socket and an Integer, and return Nothing --
  ' binding their result is itself an error.
  tls::setReadTimeout()
  tls::setReadTimeout(1, 2)
  tls::setReadTimeout(1, 2, 3)
  tls::setWriteTimeout()
  tls::setWriteTimeout(1, "2")
  tls::setWriteTimeout(1, 2, 3)

  ' `connect` has no 5-argument form in either shape, and no zero-argument one.
  LET tooManyConnect = tls::connect("example.com", 443, 5000, "example.com", 1)
  LET noArgs = tls::connect()
  RETURN 0
END FUNC
