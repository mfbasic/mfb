' plan-76-C: the tls::poll list overload rejects incorrect usage.
IMPORT tls
IMPORT collections

FUNC main AS Integer
  ' Resource element without RES — rejected at the declaration (§15.6).
  MUT bare AS List OF tls::TlsSocket = []
  RES pickBare AS tls::TlsSocket = tls::poll(bare)
  ' Neither tls::TlsSocket nor List OF RES tls::TlsSocket.
  LET pickStr = tls::poll("nope")
  ' Wrong timeout type on the list overload.
  MUT socks AS List OF RES tls::TlsSocket = []
  RES pickBad AS tls::TlsSocket = tls::poll(socks, "later")
  RETURN 0
END FUNC
