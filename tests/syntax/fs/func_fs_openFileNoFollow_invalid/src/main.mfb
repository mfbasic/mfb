IMPORT fs

FUNC main AS Integer
  RES missing AS fs::File = fs::openFileNoFollow()
  RES wrongPath AS fs::File = fs::openFileNoFollow(1)
  RES wrongMode AS fs::File = fs::openFileNoFollow("a", 1)
  RES tooMany AS fs::File = fs::openFileNoFollow("a", "read", "x")
  RES badName AS fs::File = fs::openFileNoFollow(file := "a")
  RETURN 0
END FUNC
