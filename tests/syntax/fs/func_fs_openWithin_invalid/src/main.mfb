IMPORT fs

FUNC main AS Integer
  RES tooFew AS fs::File = fs::openWithin("root")
  RES wrongRoot AS fs::File = fs::openWithin(1, "rel")
  RES wrongRel AS fs::File = fs::openWithin("root", 2)
  RES wrongMode AS fs::File = fs::openWithin("root", "rel", 3)
  RES tooMany AS fs::File = fs::openWithin("root", "rel", "read", "x")
  RES badName AS fs::File = fs::openWithin(root := "a", relPath := "b")
  RETURN 0
END FUNC
