' bug-680: a CASE naming a template the scrutinee's union does not carry is a
' pattern mismatch reported in source spellings, not an unknown type.

TYPE Some OF T
  value AS T
END TYPE

TYPE Box OF T
  value AS T
END TYPE

TYPE None
  value AS Nothing
END TYPE

UNION Opt OF T
  Some OF T
  None
END UNION

FUNC f(o AS Opt OF Integer) AS Integer
  MATCH o
    CASE Box(b)
      RETURN 1
    CASE ELSE
      RETURN 0
  END MATCH
END FUNC

FUNC main() AS Integer
  RETURN f(None[NOTHING])
END FUNC
