IMPORT fs
IMPORT net

TYPE StreamState
  bytes AS Integer
END TYPE

UNION Stream
  fs::File
  Socket
END UNION

' plan-74: a resource union may carry a uniform STATE. Accepted at the binding
' and at a union->union same-type STATE parameter (an exact-type match, not the
' variant->union widening of plan-13-A).
SUB observe(RES p AS Stream STATE StreamState)
  LET n = p.state.bytes
END SUB

FUNC main AS Integer
  RES s AS Stream STATE StreamState = fs::createTempFile()
  observe(s)
  RETURN 0
END FUNC
