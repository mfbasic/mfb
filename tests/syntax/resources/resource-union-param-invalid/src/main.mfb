IMPORT fs
IMPORT net

' Every variant is a resource -> Stream is a resource union.
UNION Stream
  fs::File
  net::Socket
END UNION

FUNC useFile(RES f AS fs::File) AS Integer
  RETURN 0
END FUNC

' Directionality (a): a union value into a concrete RES fs::File parameter is
' rejected. Widening is variant -> union only, never the reverse.
FUNC widenToConcrete AS Integer
  RES s AS Stream = fs::createTempFile()
  RETURN useFile(s)
END FUNC

' Directionality (b): a registered close op (fs::close, concrete RES fs::File)
' handed a union is rejected for the same reason.
FUNC closeUnion AS Integer
  RES s AS Stream = fs::createTempFile()
  fs::close(s)
  RETURN 0
END FUNC

FUNC main AS Integer
  RETURN 0
END FUNC
