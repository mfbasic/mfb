IMPORT thread
IMPORT self

' PUBLIC (not EXPORT). plan-115-A: this IS a valid entry now. `self::` no longer
' requires EXPORT -- it is just a spelling of the bare name, and requiring EXPORT
' here would make `self::hiddenWorker` stricter than `hiddenWorker`. The
' `spawnHidden` call below therefore compiles; only `spawnPlain` is rejected.
ISOLATED FUNC hiddenWorker(worker AS ThreadWorker OF String TO Integer, seed AS String) AS Integer
  RETURN len(seed)
END FUNC

' EXPORT but not ISOLATED. Still rejected, and it is what this fixture now pins:
' ISOLATED is the sole marker, so dropping the visibility condition did not make
' every self:: name an entry.
EXPORT FUNC plainWorker(worker AS ThreadWorker OF String TO Integer, seed AS String) AS Integer
  RETURN len(seed)
END FUNC

EXPORT FUNC spawnHidden AS Integer
  LET t AS Thread OF String TO Integer = thread::start(self::hiddenWorker, "hi")
  RETURN thread::waitFor(t)
END FUNC

EXPORT FUNC spawnPlain AS Integer
  LET t AS Thread OF String TO Integer = thread::start(self::plainWorker, "hi")
  RETURN thread::waitFor(t)
END FUNC
