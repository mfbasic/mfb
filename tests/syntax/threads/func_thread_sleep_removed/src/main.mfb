' plan-99: `thread::sleep` no longer exists — `os::sleep(ms)` replaced both handle
' sides. A program still calling it must fail to compile with an unknown-member
' diagnostic (not silently resolve, and not a stale arity/type complaint), on the
' parent handle and the worker handle alike. This is the removal's contract: it is
' what turns a stale call into a build error a reader can act on.
IMPORT thread
IMPORT thread_workers

ISOLATED FUNC worker(w AS ThreadWorker OF Nothing TO Integer, seed AS Integer) AS Integer
  thread::sleep(w, 50)
  RETURN seed
END FUNC

FUNC main AS Integer
  LET t AS Thread OF String TO Integer = thread::start(thread_workers::echoText, "a", 1, 1)
  thread::sleep(t, 50)
  RETURN 0
END FUNC
