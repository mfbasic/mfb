IMPORT thread
IMPORT thread_workers
IMPORT thread_file_workers
IMPORT fs

TYPE BadMessage
  handle AS ThreadWorker OF String TO Integer
END TYPE

FUNC rejectBadMessage(t AS Thread OF BadMessage TO Integer, payload AS BadMessage) AS Nothing
  thread::send(t, payload)
END FUNC

FUNC main AS Integer
  RES t AS Thread OF String TO Integer = thread::start(thread_workers::echoText, "a", 1, 1)
  RES fileThread AS Thread OF RES fs::File TO Integer = thread::start(thread_file_workers::receiveFile, "file", 2, 1)
  LET missing AS Nothing = thread::send()
  LET wrongMessage AS Nothing = thread::send(t, 1)
  LET wrongTimeout AS Nothing = thread::send(t, "b", "bad")
  LET tooMany AS Nothing = thread::send(t, "b", 0, 1)
  RES movedFile AS fs::File = fs::openFile("tests/syntax/threads/func_thread_send_invalid/src/main.mfb")
  thread::send(fileThread, movedFile)
  fs::close(movedFile)
  RETURN 0
END FUNC
