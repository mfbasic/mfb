IMPORT thread
IMPORT thread_workers
IMPORT thread_file_workers
IMPORT fs

FUNC main AS Integer
  RES t1 AS Thread OF String TO Integer = thread::start(thread_workers::echoText, "a")
  RES t2 AS Thread OF String TO Integer = thread::start(thread_workers::echoText, "b", 1)
  RES t3 AS Thread OF String TO Integer = thread::start(thread_workers::echoText, "c", 1, 1)
  RES t4 AS Thread OF Nothing TO Integer = thread::start(thread_workers::noMessages, 41, 1, 1)
  RES t5 AS Thread OF String TO Integer = thread::start(f := thread_workers::echoText, data := "d")
  RES t6 AS Thread OF String TO Integer = thread::start(data := "e", f := thread_workers::echoText, outboundLimit := 1, inboundLimit := 1)
  RES file AS fs::File = fs::openFile("tests/syntax/threads/func_thread_start_valid/src/main.mfb")
  RES t7 AS Thread OF RES fs::File TO Integer = thread::start(thread_file_workers::receiveFile, "f", 1, 1)
  thread::transfer(t7, file)
  RETURN 0
END FUNC
