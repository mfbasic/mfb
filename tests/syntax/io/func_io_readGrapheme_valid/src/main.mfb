IMPORT io

FUNC compilereadGrapheme AS Integer
  IF FALSE THEN
    LET waited AS String = io::readGrapheme()
    LET polled AS String = io::readGrapheme(0)
    LET bounded AS String = io::readGrapheme(250)
    LET named AS String = io::readGrapheme(timeoutMs := 100)
  END IF

  RETURN 0
END FUNC

FUNC main AS Integer
  RETURN compilereadGrapheme()
END FUNC
