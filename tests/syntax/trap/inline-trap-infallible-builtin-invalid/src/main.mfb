IMPORT math

' plan-165-D (Option 1): an inline TRAP is legal on any well-typed expression;
' one that cannot fail warns TYPE_INLINE_TRAP_DEAD_HANDLER. A literal and a
' package constant cannot fail, so both warn; calling a constant as a function
' is still an error (SYMBOL_NOT_CALLABLE), which keeps this fixture invalid:
FUNC main AS Integer
  ' 1. a non-call literal expression.
  LET a AS Integer = 5 TRAP(e)
    RECOVER 0
  END TRAP
  ' 2. a package constant (not a runtime call).
  LET p AS Float = math::pi() TRAP(e)
    RECOVER 0.0
  END TRAP
  RETURN a
END FUNC
