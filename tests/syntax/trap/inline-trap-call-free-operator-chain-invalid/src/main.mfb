' bug-779: a raising operator widens what an inline TRAP covers, not what may be
' one (`mfb spec language error-model` rule 11) — a scrutinee with no runtime call
' anywhere in it is rejected however many raising operators it nests. A single
' operator (`i * 2`) always was; a nested one (`i * 2 + 3`) compiled because the
' desugar lifted the inner operator and the lifted check looked like evidence.
FUNC main AS Integer
  LET i AS Integer = 5
  ' 1. a nested multiply-add, bound by LET.
  LET a AS Integer = i * 2 + 3 TRAP(e)
    RECOVER 0
  END TRAP
  ' 2. a division under an addition, bound by LET.
  LET b AS Integer = i / 2 + 1 TRAP(e)
    RECOVER 0
  END TRAP
  ' 3. a negated product.
  LET c AS Integer = -(i * 2) TRAP(e)
    RECOVER 0
  END TRAP
  ' 4. the assignment form.
  MUT d AS Integer = 0
  d = (i * 2) + 3 TRAP(e)
    RECOVER 0
  END TRAP
  ' 5. the bare-statement form.
  i * 2 + 3 TRAP(e)
    RECOVER 0
  END TRAP
  RETURN a + b + c + d
END FUNC
