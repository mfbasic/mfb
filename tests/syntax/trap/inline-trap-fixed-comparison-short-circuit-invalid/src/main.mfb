' bug-825: a comparison promotes like arithmetic, and promotion into Fixed is
' checked, so `fx < big` (Integer vs Fixed) raises ErrOverflow and
' `fx >= ratio` (non-finite Float vs Fixed) raises ErrInvalidFormat. In the
' right operand of AND/OR the comparison runs only conditionally, so an inline
' TRAP cannot lift it ahead of the expression; it compiled anyway and its error
' escaped to the function-level handler. Each scrutinee below must be rejected
' with TYPE_INLINE_TRAP_SHORT_CIRCUIT_CALL. The comparison on the LEFT of an
' AND/OR always runs and is lifted and caught; see
' tests/rt-behavior/trap/inline-trap-fixed-comparison-short-circuit-rt.
IMPORT io
FUNC finish(flag AS Boolean) AS Integer
  RETURN 1
END FUNC
FUNC viaInteger(selected AS Boolean, fx AS Fixed, big AS Integer) AS Integer
  LET b = finish(selected AND fx < big) TRAP(e)
    RECOVER 9
  END TRAP
  RETURN b
END FUNC
FUNC viaFloat(selected AS Boolean, fx AS Fixed, ratio AS Float) AS Integer
  LET b = finish(selected OR fx >= ratio) TRAP(e)
    RECOVER 9
  END TRAP
  RETURN b
END FUNC
FUNC viaNested(selected AS Boolean, fx AS Fixed, big AS Integer) AS Integer
  LET b = finish(selected AND NOT (fx = big OR selected)) TRAP(e)
    RECOVER 9
  END TRAP
  RETURN b
END FUNC
FUNC main() AS Integer
  io::print(toString(viaInteger(TRUE, 1F, 3000000000)))
  io::print(toString(viaFloat(FALSE, 1F, 3000000000.0)))
  io::print(toString(viaNested(TRUE, 1F, 3000000000)))
  RETURN 0
END FUNC
