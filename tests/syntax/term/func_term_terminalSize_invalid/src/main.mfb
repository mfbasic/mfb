IMPORT term

FUNC resize(size AS term::TermSize) AS term::TermSize
  RETURN WITH size { columns := 80 }
END FUNC

FUNC constructLet AS term::TermSize
  LET a AS term::TermSize = term::TermSize[rows := 10, columns := 10]
  RETURN a
END FUNC

FUNC constructMut AS term::TermSize
  MUT b AS term::TermSize = term::TermSize[rows := 10, columns := 10]
  RETURN b
END FUNC

FUNC main AS Integer
  RETURN 0
END FUNC
