' plan-164-A: `canvas::nurbsToBeziers` takes control points, weights, knots and a degree,
' in that order, and returns a list of `canvas::BezierCurve`. A wrong argument count, a
' knot list that is not a list of `Float`, a `Float` degree, and a result bound to the
' wrong type are each refused at compile time. (Input that is well typed and is not a
' curve -- a short knot vector, a zero weight -- is not an error: it returns an empty
' list, which `tests/canvas/rt_canvas_curves.rs` checks at run time.)
IMPORT app
IMPORT canvas
IMPORT vector

FUNC main AS Integer
  app::setMode(app::Mode.Canvas)
  LET points AS List OF vector::Float2 = [vector::Float2[x := 0.0, y := 0.0], vector::Float2[x := 1.0, y := 1.0]]
  LET weights AS List OF Float = []
  LET knots AS List OF Float = [0.0, 0.0, 1.0, 1.0]
  LET a AS List OF canvas::BezierCurve = canvas::nurbsToBeziers(points, weights, knots)
  LET b AS List OF canvas::BezierCurve = canvas::nurbsToBeziers(points, weights, [0, 0, 1, 1], 1)
  LET c AS List OF canvas::BezierCurve = canvas::nurbsToBeziers(points, weights, knots, 1.0)
  LET d AS List OF vector::Float2 = canvas::nurbsToBeziers(points, weights, knots, 1)
  RETURN 0
END FUNC
