  ],
  "imports": [
  ],
  "runtimeHelpers": ["io"],
  "functions": [
  {
    "name": "main",
    "visibility": "public",
    "kind": "func",
    "isolated": false,
    "file": "src/main.mfb",
    "params": [
    ],
    "returns": "Nothing",
    "body": [
    { "op": "eval", "value": { "kind": "runtimeCall", "helper": "io", "target": "io.print", "args": [{ "kind": "const", "type": "String", "value": "print" }] } },
    { "op": "eval", "value": { "kind": "runtimeCall", "helper": "io", "target": "io.write", "args": [{ "kind": "const", "type": "String", "value": "write" }] } },
    { "op": "eval", "value": { "kind": "runtimeCall", "helper": "io", "target": "io.printError", "args": [{ "kind": "const", "type": "String", "value": "printError" }] } },
    { "op": "eval", "value": { "kind": "runtimeCall", "helper": "io", "target": "io.writeError", "args": [{ "kind": "const", "type": "String", "value": "writeError" }] } },
    { "op": "eval", "value": { "kind": "runtimeCall", "helper": "io", "target": "io.flush", "args": [] } },
    { "op": "bind", "mutable": false, "name": "prompted", "type": "String", "value": { "kind": "runtimeCall", "helper": "io", "target": "io.input", "args": [{ "kind": "const", "type": "String", "value": "prompt: " }, { "kind": "const", "type": "Integer", "value": "9223372036854775808" }] } },
    { "op": "bind", "mutable": false, "name": "line", "type": "String", "value": { "kind": "runtimeCall", "helper": "io", "target": "io.readLine", "args": [{ "kind": "const", "type": "Integer", "value": "9223372036854775808" }] } },
    { "op": "bind", "mutable": false, "name": "raw", "type": "Byte", "value": { "kind": "runtimeCall", "helper": "io", "target": "io.readRaw", "args": [{ "kind": "const", "type": "Integer", "value": "9223372036854775808" }] } },
    { "op": "bind", "mutable": false, "name": "sc", "type": "Scalar", "value": { "kind": "runtimeCall", "helper": "io", "target": "io.readScalar", "args": [{ "kind": "const", "type": "Integer", "value": "9223372036854775808" }] } },
    { "op": "bind", "mutable": false, "name": "ch", "type": "String", "value": { "kind": "runtimeCall", "helper": "io", "target": "io.readGrapheme", "args": [{ "kind": "const", "type": "Integer", "value": "9223372036854775808" }] } },
    { "op": "bind", "mutable": false, "name": "k", "type": "io.Key", "value": { "kind": "runtimeCall", "helper": "io", "target": "io.readKey", "args": [{ "kind": "const", "type": "Integer", "value": "0" }] } },
    { "op": "bind", "mutable": false, "name": "inTerm", "type": "Boolean", "value": { "kind": "runtimeCall", "helper": "io", "target": "io.isInputTerminal", "args": [] } },
    { "op": "bind", "mutable": false, "name": "outTerm", "type": "Boolean", "value": { "kind": "runtimeCall", "helper": "io", "target": "io.isOutputTerminal", "args": [] } },
    { "op": "bind", "mutable": false, "name": "errTerm", "type": "Boolean", "value": { "kind": "runtimeCall", "helper": "io", "target": "io.isErrorTerminal", "args": [] } },
    { "op": "eval", "value": { "kind": "runtimeCall", "helper": "io", "target": "io.print", "args": [{ "kind": "binary", "op": "&", "left": { "kind": "binary", "op": "&", "left": { "kind": "binary", "op": "&", "left": { "kind": "binary", "op": "&", "left": { "kind": "binary", "op": "&", "left": { "kind": "binary", "op": "&", "left": { "kind": "binary", "op": "&", "left": { "kind": "binary", "op": "&", "left": { "kind": "local", "name": "prompted" }, "right": { "kind": "local", "name": "line" } }, "right": { "kind": "local", "name": "ch" } }, "right": { "kind": "call", "target": "toString", "args": [{ "kind": "local", "name": "raw" }] } }, "right": { "kind": "call", "target": "toString", "args": [{ "kind": "local", "name": "sc" }] } }, "right": { "kind": "memberAccess", "target": { "kind": "local", "name": "k" }, "member": "grapheme" } }, "right": { "kind": "call", "target": "toString", "args": [{ "kind": "local", "name": "inTerm" }] } }, "right": { "kind": "call", "target": "toString", "args": [{ "kind": "local", "name": "outTerm" }] } }, "right": { "kind": "call", "target": "toString", "args": [{ "kind": "local", "name": "errTerm" }] } }] } }
    ]
  }
