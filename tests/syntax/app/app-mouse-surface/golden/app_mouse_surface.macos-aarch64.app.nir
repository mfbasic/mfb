      { "op": "bind", "mutable": false, "name": "stops", "type": "Integer", "value": { "kind": "call", "target": "toInt", "args": [{ "kind": "call", "target": "collections.getOr", "args": [{ "kind": "global", "name": "#CANVAS_GEO_DATA", "type": "" }, { "kind": "binary", "op": "+", "left": { "kind": "local", "name": "offset" }, "right": { "kind": "global", "name": "#CANVAS_GEO_GRADIENT_COUNT", "type": "" } }, { "kind": "const", "type": "Float", "value": "0.0" }] }] } },
