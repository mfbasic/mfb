IMPORT io
IMPORT term
IMPORT color

' Exercises the term:: surface in app mode so the macOS .app native goldens
' capture term::on/off driving the synthesized TermView (plan-01-term.md §6.3,
' Phase 4) and the remaining term:: helpers on the shared console backend.
SUB main()
  term::on()
  term::clear()
  term::setForeground(color::rgb(0, 255, 0))
  term::setBackground(color::rgb(0, 0, 0))
  term::setBold(TRUE)
  term::setUnderline(FALSE)
  term::showCursor()
  term::hideCursor()
  term::moveTo(2, 4)
  io::write("term")

  ' The six positioned draw helpers. In app mode these are the ONLY term:: bodies
  ' the platform backend implements itself (`emit_app_term_helper`), and each reads
  ' its coordinates straight out of the incoming ABI argument registers in
  ' row-before-column order — so without them here the app-mode `.ncodesum`
  ' goldens covered no positioned drawing at all.
  term::drawHLine(term::LineStyle.Light, 5, 1, 12)
  term::drawVLine(term::LineStyle.HeavyDash, 6, 3, 10)
  term::drawBox(term::LineStyle.Double, 7, 2, 11, 20)
  term::fillRect(term::FillStyle.Medium, 8, 4, 10, 16)
  term::drawText(9, 6, "app")
  term::drawGlyph(10, 7, 0x2603)
  LET active AS Boolean = term::isOn()
  LET fg AS color::Color = term::getForeground()
  LET bg AS color::Color = term::getBackground()
  LET bold AS Boolean = term::getBold()
  LET underline AS Boolean = term::getUnderline()
  LET size AS term::TermSize = term::terminalSize()
  io::print(toString(active) & toString(fg.green) & toString(bg.red) & toString(bold) & toString(underline) & toString(size.columns))
  term::off()
END SUB
