      "condition": { "kind": "binary", "op": "=", "left": { "kind": "local", "name": "high" }, "right": { "kind": "local", "name": "r" } },
      "then": [
      { "op": "assign", "name": "hue", "value": { "kind": "binary", "op": "*", "left": { "kind": "const", "type": "Float", "value": "60.0" }, "right": { "kind": "binary", "op": "/", "left": { "kind": "binary", "op": "-", "left": { "kind": "local", "name": "g" }, "right": { "kind": "local", "name": "b" } }, "right": { "kind": "local", "name": "delta" } } } }
