      "condition": { "kind": "binary", "op": "AND", "left": { "kind": "binary", "op": "<>", "left": { "kind": "local", "name": "high" }, "right": { "kind": "local", "name": "r" } }, "right": { "kind": "binary", "op": "=", "left": { "kind": "local", "name": "high" }, "right": { "kind": "local", "name": "g" } } },
      "then": [
      { "op": "assign", "name": "hue", "value": { "kind": "binary", "op": "*", "left": { "kind": "const", "type": "Float", "value": "60.0" }, "right": { "kind": "binary", "op": "+", "left": { "kind": "binary", "op": "/", "left": { "kind": "binary", "op": "-", "left": { "kind": "local", "name": "b" }, "right": { "kind": "local", "name": "r" } }, "right": { "kind": "local", "name": "delta" } }, "right": { "kind": "const", "type": "Float", "value": "2.0" } } } }
      ],
      "else": [
      ]
    },
    {
      "op": "if",
      "condition": { "kind": "binary", "op": "AND", "left": { "kind": "binary", "op": "<>", "left": { "kind": "local", "name": "high" }, "right": { "kind": "local", "name": "r" } }, "right": { "kind": "binary", "op": "<>", "left": { "kind": "local", "name": "high" }, "right": { "kind": "local", "name": "g" } } },
      "then": [
      { "op": "assign", "name": "hue", "value": { "kind": "binary", "op": "*", "left": { "kind": "const", "type": "Float", "value": "60.0" }, "right": { "kind": "binary", "op": "+", "left": { "kind": "binary", "op": "/", "left": { "kind": "binary", "op": "-", "left": { "kind": "local", "name": "r" }, "right": { "kind": "local", "name": "g" } }, "right": { "kind": "local", "name": "delta" } }, "right": { "kind": "const", "type": "Float", "value": "4.0" } } } }
      ],
      "else": [
      ]
    },
