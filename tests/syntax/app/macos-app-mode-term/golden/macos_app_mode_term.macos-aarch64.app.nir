    "returns": "color.Hsl",
    "body": [
    { "op": "bind", "mutable": false, "name": "r", "type": "Float", "value": { "kind": "call", "target": "#color_channelFraction", "args": [{ "kind": "memberAccess", "target": { "kind": "local", "name": "base" }, "member": "red" }] } },
    { "op": "bind", "mutable": false, "name": "g", "type": "Float", "value": { "kind": "call", "target": "#color_channelFraction", "args": [{ "kind": "memberAccess", "target": { "kind": "local", "name": "base" }, "member": "green" }] } },
    { "op": "bind", "mutable": false, "name": "b", "type": "Float", "value": { "kind": "call", "target": "#color_channelFraction", "args": [{ "kind": "memberAccess", "target": { "kind": "local", "name": "base" }, "member": "blue" }] } },
    { "op": "bind", "mutable": false, "name": "high", "type": "Float", "value": { "kind": "call", "target": "math.max", "args": [{ "kind": "local", "name": "r" }, { "kind": "call", "target": "math.max", "args": [{ "kind": "local", "name": "g" }, { "kind": "local", "name": "b" }] }] } },
    { "op": "bind", "mutable": false, "name": "low", "type": "Float", "value": { "kind": "call", "target": "math.min", "args": [{ "kind": "local", "name": "r" }, { "kind": "call", "target": "math.min", "args": [{ "kind": "local", "name": "g" }, { "kind": "local", "name": "b" }] }] } },
    { "op": "bind", "mutable": false, "name": "delta", "type": "Float", "value": { "kind": "binary", "op": "-", "left": { "kind": "local", "name": "high" }, "right": { "kind": "local", "name": "low" } } },
