    { "op": "bind", "mutable": false, "name": "l", "type": "Float", "value": { "kind": "call", "target": "#color_clampFraction", "args": [{ "kind": "local", "name": "lightness" }] } },
    { "op": "bind", "mutable": false, "name": "c", "type": "Float", "value": { "kind": "binary", "op": "*", "left": { "kind": "binary", "op": "-", "left": { "kind": "const", "type": "Float", "value": "1.0" }, "right": { "kind": "call", "target": "math.abs", "args": [{ "kind": "binary", "op": "-", "left": { "kind": "binary", "op": "*", "left": { "kind": "const", "type": "Float", "value": "2.0" }, "right": { "kind": "local", "name": "l" } }, "right": { "kind": "const", "type": "Float", "value": "1.0" } }] } }, "right": { "kind": "local", "name": "s" } } },
    { "op": "bind", "mutable": false, "name": "sixth", "type": "Float", "value": { "kind": "binary", "op": "/", "left": { "kind": "local", "name": "h" }, "right": { "kind": "const", "type": "Float", "value": "60.0" } } },
    { "op": "bind", "mutable": false, "name": "sector", "type": "Integer", "value": { "kind": "call", "target": "math.floor", "args": [{ "kind": "local", "name": "sixth" }] } },
    { "op": "bind", "mutable": false, "name": "within", "type": "Float", "value": { "kind": "binary", "op": "-", "left": { "kind": "local", "name": "sixth" }, "right": { "kind": "binary", "op": "*", "left": { "kind": "call", "target": "toFloat", "args": [{ "kind": "call", "target": "math.floor", "args": [{ "kind": "binary", "op": "/", "left": { "kind": "local", "name": "sixth" }, "right": { "kind": "const", "type": "Float", "value": "2.0" } }] }] }, "right": { "kind": "const", "type": "Float", "value": "2.0" } } } },
    { "op": "bind", "mutable": false, "name": "x", "type": "Float", "value": { "kind": "binary", "op": "*", "left": { "kind": "local", "name": "c" }, "right": { "kind": "binary", "op": "-", "left": { "kind": "const", "type": "Float", "value": "1.0" }, "right": { "kind": "call", "target": "math.abs", "args": [{ "kind": "binary", "op": "-", "left": { "kind": "local", "name": "within" }, "right": { "kind": "const", "type": "Float", "value": "1.0" } }] } } } },
    { "op": "bind", "mutable": false, "name": "m", "type": "Float", "value": { "kind": "binary", "op": "-", "left": { "kind": "local", "name": "l" }, "right": { "kind": "binary", "op": "/", "left": { "kind": "local", "name": "c" }, "right": { "kind": "const", "type": "Float", "value": "2.0" } } } },
    { "op": "bind", "mutable": false, "name": "red", "type": "Byte", "value": { "kind": "call", "target": "#color_fractionChannel", "args": [{ "kind": "binary", "op": "+", "left": { "kind": "call", "target": "#color_hueSector", "args": [{ "kind": "local", "name": "sector" }, { "kind": "local", "name": "c" }, { "kind": "local", "name": "x" }, { "kind": "const", "type": "Integer", "value": "0" }] }, "right": { "kind": "local", "name": "m" } }] } },
    { "op": "bind", "mutable": false, "name": "green", "type": "Byte", "value": { "kind": "call", "target": "#color_fractionChannel", "args": [{ "kind": "binary", "op": "+", "left": { "kind": "call", "target": "#color_hueSector", "args": [{ "kind": "local", "name": "sector" }, { "kind": "local", "name": "c" }, { "kind": "local", "name": "x" }, { "kind": "const", "type": "Integer", "value": "1" }] }, "right": { "kind": "local", "name": "m" } }] } },
