' plan-77 C3: csv dialect (custom delimiter / quote / newline) round trip.
IMPORT collections
IMPORT csv
IMPORT io

FUNC main() AS Integer
  ' Semicolon delimiter, single-quote quote. "b;c" needs quoting (delimiter),
  ' "d'e" needs quoting (quote char, doubled to ''). Display with "|" newline.
  LET grid AS List OF List OF String = [["a", "b;c", "d'e"], ["1", "2", "3"]]
  io::print("semi=" & csv::stringify(grid, ";", "'", "|"))

  ' Full round trip through the same dialect recovers the cells exactly.
  LET back AS List OF List OF String = csv::parse(csv::stringify(grid, ";", "'", "\n"), ";", "'")
  io::print("rows=" & toString(len(back)))
  io::print("r0f1=" & collections::get(collections::get(back, 0), 1))
  io::print("r0f2=" & collections::get(collections::get(back, 0), 2))

  ' Tab-delimited parse.
  LET tsv AS List OF List OF String = csv::parse("x\ty\tz", "\t", "\"")
  io::print("tsvcols=" & toString(len(collections::get(tsv, 0))))

  ' The one-argument default is still RFC-4180 (comma, double quote).
  io::print("default=" & csv::stringify([["p,q", "r"]]))
  RETURN 0
END FUNC
