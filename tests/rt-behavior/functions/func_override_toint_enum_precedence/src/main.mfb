IMPORT io

' plan-140-B: a `toInt` override over a record keeps dispatching to the
' override, while the built-in answers for an enum in the same program.
TYPE Cash
  cents AS Integer
END TYPE

ENUM Color
  Red, Green, Blue
END ENUM

FUNC toInt(m AS Cash) AS Integer
  RETURN m.cents
END FUNC

FUNC main AS Integer
  LET m AS Cash = Cash[1995]
  io::print(toString(toInt(m)))           ' 1995   override
  io::print(toString(toInt(Color.Blue)))  ' 2      built-in, enum
  io::print(toString(toInt("7")))         ' 7      built-in, unchanged
  RETURN 0
END FUNC
