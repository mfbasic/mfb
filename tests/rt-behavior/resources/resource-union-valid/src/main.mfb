IMPORT fs
IMPORT net
IMPORT io

UNION Stream
  fs::File
  net::Socket
END UNION

FUNC main AS Integer
  RES s AS Stream = fs::createTempFile()
  MATCH s
    CASE fs::File(f)
      fs::writeAll(f, "union-data")
      io::print("file")
    CASE net::Socket(sock)
      io::print("socket")
  END MATCH
  RETURN 0
END FUNC
