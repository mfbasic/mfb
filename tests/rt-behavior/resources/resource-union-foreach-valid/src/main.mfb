IMPORT fs
IMPORT net
IMPORT io

UNION Stream
  fs::File
  net::Socket
END UNION

FUNC main AS Integer
  LET ns AS List OF Integer = [1]
  FOR EACH n IN ns
    RES s AS Stream = fs::createTempFile()
    MATCH s
      CASE fs::File(f)
        fs::writeAll(f, "union-data")
        io::print("file")
      CASE net::Socket(sock)
        io::print("socket")
    END MATCH
  NEXT
  RETURN 0
END FUNC
