IMPORT vector
IMPORT io

' plan-86 H2: inline vector::length / vector::distance for Integer and Fixed
' elements (relaxing the Float-only gate). The inlined sum-of-squares + sqrt must
' be BIT-IDENTICAL to the FUNC-call path: Float/Fixed use math::sqrt (Fixed lowers
' to the deterministic emit_fixed_sqrt), Integer uses the package rounding integer
' sqrt (#vector_isqrtRound) — the exact helper the FUNC body calls. This pins the
' bit-identity across 2D/3D/4D and a range of magnitudes (isqrt rounding edges).

FUNC main AS Integer
  LET a AS vector::Integer2 = vector::Integer2[3, 4]
  io::print("iLen2=" & toString(vector::length(a)))
  LET b AS vector::Integer3 = vector::Integer3[2, 3, 6]
  io::print("iLen3=" & toString(vector::length(b)))
  LET c AS vector::Integer4 = vector::Integer4[1, 2, 2, 4]
  io::print("iLen4=" & toString(vector::length(c)))
  LET d1 AS vector::Integer2 = vector::Integer2[0, 0]
  LET d2 AS vector::Integer2 = vector::Integer2[6, 8]
  io::print("iDist=" & toString(vector::distance(d1, d2)))
  MUT acc AS Integer = 0
  FOR i = 1 TO 200
    LET v AS vector::Integer2 = vector::Integer2[i, i + 1]
    acc = acc + vector::length(v)
  NEXT
  io::print("iAcc=" & toString(acc))
  LET fa AS vector::Fixed2 = vector::Fixed2[3.0, 4.0]
  io::print("fLen2=" & toString(vector::length(fa)))
  LET fb AS vector::Fixed3 = vector::Fixed3[1.5, 2.5, 3.5]
  io::print("fLen3=" & toString(vector::length(fb)))
  LET fc AS vector::Fixed4 = vector::Fixed4[1.0, 2.0, 2.0, 4.0]
  io::print("fLen4=" & toString(vector::length(fc)))
  LET fd1 AS vector::Fixed2 = vector::Fixed2[1.0, 1.0]
  LET fd2 AS vector::Fixed2 = vector::Fixed2[4.0, 5.0]
  io::print("fDist=" & toString(vector::distance(fd1, fd2)))
  RETURN 0
END FUNC
