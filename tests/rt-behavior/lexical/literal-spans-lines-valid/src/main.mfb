IMPORT collections
IMPORT io

' bug-821: a newline inside an unclosed [ ], { } or ( ) is not a statement
' separator, so every bracketed form below spans lines. Each multi-line form is
' compared at runtime against its one-line twin.

TYPE Pt
  x AS Integer
  y AS Integer
END TYPE

TYPE Account
  owner AS String
  balance AS Integer
  tags AS List OF String
END TYPE

FUNC render(xs AS List OF String) AS String
  MUT out = ""
  FOR EACH x IN xs
    out = out & x & ";"
  NEXT
  RETURN out
END FUNC

FUNC renderInts(xs AS List OF Integer) AS String
  MUT out = ""
  FOR EACH x IN xs
    out = out & toString(x) & ";"
  NEXT
  RETURN out
END FUNC

' A parameter list spans lines too, with a trailing comma.
FUNC add3(
  a AS Integer,
  b AS Integer,  ' second
  c AS Integer,
) AS Integer
  RETURN a + b + c
END FUNC

FUNC report(label AS String, ok AS Boolean) AS Nothing
  IF ok THEN
    io::print(label & " ok")
  ELSE
    io::print(label & " MISMATCH")
  END IF
END FUNC

