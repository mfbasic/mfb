  io::print("count=" & toString(len(testA)) & " first=" & collections::get(testA, 0) & " last=" & collections::get(testA, len(testA) - 1))
  LET one = render(testA)
  report("list break-after-comma", render(testB) = one)
  report("list break-after-open", render(testC) = one)
  report("list leading-comma", render(testD) = one)
  report("list trailing-comma+comments", render(testE) = one)

  ' Brackets, quotes and comment marks inside strings and comments do not
  ' affect bracket depth.
  LET tricky AS List OF String = [
    "[", "(", "{",  ' a comment with ] ) } in it
    "]", ")", "}",
    "it's", "' not a comment",
  ]
  report("strings-with-brackets", render(tricky) = "[;(;{;];);};it's;' not a comment;")

  ' Map literal.
  LET mapOne AS Map OF String TO Integer = Map OF String TO Integer { "a" := 1, "b" := 2, "c" := 3 }
  LET mapMulti AS Map OF String TO Integer = Map OF String TO Integer {
    "a" := 1,
    "b" := 2,  ' trailing comment
    "c" := 3,
  }
  LET mapLead AS Map OF String TO Integer = Map OF String TO Integer { "a" := 1
    , "b" := 2
    , "c" := 3 }
  report("map multi", len(mapMulti) = len(mapOne) AND collections::get(mapMulti, "b") = 2 AND collections::get(mapMulti, "c") = 3)
  report("map leading-comma", len(mapLead) = 3 AND collections::get(mapLead, "a") = 1 AND collections::get(mapLead, "c") = 3)

  ' Set literal.
  LET setMulti AS Set OF Integer = Set OF Integer {
    10,
    20,
    30,
  }
  report("set multi", len(setMulti) = 3 AND collections::contains(setMulti, 20))

  ' Record constructors: positional and named, multi-line.
  LET p1 AS Pt = Pt[1, 2]
  LET p2 AS Pt = Pt[
    1,
    2,
  ]
  LET p3 AS Pt = Pt[
    x := 1,
    y := 2
  ]
  report("record positional", p1 = p2)
  report("record named", p1 = p3)

  LET acct AS Account = Account[
    owner := "Ada",
    balance := 100,
    tags := [
      "vip",
      "early",
    ],
  ]
  ' WITH update across lines.
  LET acct2 AS Account = WITH acct {
    balance := 250,
    owner := "Grace",
  }
  report("with-update", acct2.owner = "Grace" AND acct2.balance = 250 AND render(acct2.tags) = "vip;early;" AND acct.balance = 100)

  ' Call arguments and parenthesized expressions.
  LET sum1 = add3(1, 2, 3)
  LET sum2 = add3(
    1,
    2,
    3,
  )
  LET sum3 = add3(1 +
    0, 2
    , 3)
  LET paren = (1 +
    2) * (
    3
  )
  report("call args", sum1 = sum2 AND sum2 = sum3)
  report("paren expr", paren = 9)

  ' Lambdas inside a call's parentheses.
  LET kept = collections::filter(
    [1, 2, 3],
    LAMBDA(n AS Integer) -> n > 1,
  )
  report("lambda in call", renderInts(kept) = "2;3;")

  ' Nested brackets and _ continuation inside and outside brackets.
  LET nested AS List OF List OF Integer = [
    [1, 2],
    [3, _
     4],
  ]
  report("nested", len(nested) = 2 AND renderInts(collections::get(nested, 1)) = "3;4;")
  LET joined = "a" & _
    "b"
  report("underscore continuation", joined = "ab")
END FUNC
