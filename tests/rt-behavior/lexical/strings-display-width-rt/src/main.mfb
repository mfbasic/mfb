' `term::measureText` returns the terminal-cell width used by the terminal grid.
' Cache every result while term is active, then turn it off before printing so
' the transcript contains the measurements rather than a live alternate screen.
IMPORT io
IMPORT term
IMPORT astrings

FUNC widthOf(value AS String) AS Integer
  RETURN term::measureText(value)
END FUNC

FUNC main() AS Integer
  term::on()
  LET literalEmpty AS Integer = term::measureText("")
  LET literalAscii AS Integer = term::measureText("abc")
  LET literalCjk AS Integer = term::measureText("日本語")
  LET literalNfd AS Integer = term::measureText("cafe" & "́")
  LET literalEmoji AS Integer = term::measureText("👨‍👩‍👧‍👦")
  LET literalZero AS Integer = term::measureText("́")
  LET attributed AS AttributedString = astrings::fromString("日本語")
  LET attributedCjk AS Integer = term::measureText(attributed)

  LET dynamicEmpty AS Integer = widthOf("")
  LET dynamicAscii AS Integer = widthOf("abc")
  LET dynamicCjk AS Integer = widthOf("日本語")
  LET dynamicNfd AS Integer = widthOf("cafe" & "́")
  LET dynamicEmoji AS Integer = widthOf("👨‍👩‍👧‍👦")
  LET dynamicZero AS Integer = widthOf("́")
  term::off()

  io::print("literal empty : " & toString(literalEmpty))
  io::print("literal ascii : " & toString(literalAscii))
  io::print("literal cjk   : " & toString(literalCjk))
  io::print("literal nfd   : " & toString(literalNfd))
  io::print("literal emoji : " & toString(literalEmoji))
  io::print("literal zero  : " & toString(literalZero))
  io::print("attributed cjk: " & toString(attributedCjk))
  io::print("dynamic empty : " & toString(dynamicEmpty))
  io::print("dynamic ascii : " & toString(dynamicAscii))
  io::print("dynamic cjk   : " & toString(dynamicCjk))
  io::print("dynamic nfd   : " & toString(dynamicNfd))
  io::print("dynamic emoji : " & toString(dynamicEmoji))
  io::print("dynamic zero  : " & toString(dynamicZero))
  io::print("ok")
  RETURN 0
END FUNC
