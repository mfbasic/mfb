IMPORT io
IMPORT thread
IMPORT fs
IMPORT state_xfer_workers

' The resource plane moves a File together with its STATE across the thread
' boundary: the worker reads the transferred `pos` (99) and returns it.
FUNC main AS Integer
  RES t AS Thread OF RES fs::File STATE state_xfer_workers::Cursor TO Integer = thread::start(state_xfer_workers::takeCursor, "seed")
  RES f AS fs::File STATE state_xfer_workers::Cursor = fs::openFile("tests/rt-behavior/threads/thread-transfer-state-rt/data/input.txt")
  f.state.pos = 99
  thread::transfer(t, f)
  LET got AS Integer = thread::waitFor(t)
  io::print(toString(got))
  RETURN 0
END FUNC
