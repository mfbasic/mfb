' plan-91-A: proves the parent-side `thread::sleep` actually blocks the calling
' thread for the requested duration. The worker `waitForCancelForever` blocks on
' its inbound queue and never exits, so the parent `Thread` handle stays open for
' the whole test. Only PASS/FAIL lines are printed — never the raw elapsed value,
' which varies run-to-run — so the golden stays deterministic.
IMPORT io
IMPORT thread
IMPORT datetime
IMPORT thread_runtime_workers

FUNC main AS Integer
  LET t AS Thread OF String TO Integer = thread::start(thread_runtime_workers::waitForCancelForever, "seed", 1, 1)

  ' ms = 0 is an immediate no-op (returns without sleeping).
  thread::sleep(t, 0)
  io::print("immediate ok")

  ' ms = 50 blocks the calling thread for at least ~50 ms of wall-clock. The
  ' bound is loose (>= 40 ms) to absorb clock granularity without flaking.
  LET t0 AS Integer = datetime::monotonicNanos()
  thread::sleep(t, 50)
  LET t1 AS Integer = datetime::monotonicNanos()
  LET elapsedMs AS Integer = (t1 - t0) / 1000000
  IF elapsedMs >= 40 THEN
    io::print("slept ok")
  ELSE
    io::print("slept short")
  END IF

  thread::cancel(t)
  LET r AS Integer = thread::waitFor(t)
  io::print("done")
  RETURN 0
  TRAP(werr)
    io::print("done")
    RETURN 0
  END TRAP
END FUNC
