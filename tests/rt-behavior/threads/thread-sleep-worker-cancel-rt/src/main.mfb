' plan-91-B: a worker-side `thread::sleep` in progress wakes early and fails with
' ErrInterrupted (77050009) when the parent requests cancellation. The worker
' `sleepUntilCancel` starts a 5000 ms sleep; the parent waits ~50 ms (its own
' plain sleep), cancels, then `waitFor` auto-propagates the worker's ErrInterrupted
' — caught here well before the 5000 ms would elapse. A broken (uninterruptible)
' worker sleep would instead run the full 5000 ms and return 0 → "no interrupt".
IMPORT io
IMPORT thread
IMPORT thread_runtime_workers

FUNC main AS Integer
  LET t AS Thread OF String TO Integer = thread::start(thread_runtime_workers::sleepUntilCancel, "seed")
  thread::sleep(t, 50)
  thread::cancel(t)
  LET r AS Integer = thread::waitFor(t)
  io::print("no interrupt " & toString(r))
  RETURN 1
  TRAP(err)
    IF err.code = 77050009 THEN
      io::print("interrupted")
      RETURN 0
    END IF
    io::print("wrong " & toString(err.code))
    RETURN 1
  END TRAP
END FUNC
