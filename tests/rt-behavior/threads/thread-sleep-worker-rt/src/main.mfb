' plan-91-B: the worker-side `thread::sleep` runs to completion when no
' cancellation is requested. The worker `sleepThenReturn` sleeps 200 ms then
' returns 5; the parent's `waitFor` blocks until it finishes. Only PASS/FAIL lines
' are printed (never the raw elapsed value) so the golden stays deterministic.
IMPORT io
IMPORT thread
IMPORT datetime
IMPORT thread_runtime_workers

FUNC main AS Integer
  LET t AS Thread OF String TO Integer = thread::start(thread_runtime_workers::sleepThenReturn, "seed")
  LET t0 AS Integer = datetime::monotonicNanos()
  LET r AS Integer = thread::waitFor(t)
  LET t1 AS Integer = datetime::monotonicNanos()
  LET elapsedMs AS Integer = (t1 - t0) / 1000000
  io::print("result " & toString(r))
  IF elapsedMs >= 150 THEN
    io::print("slept full")
  ELSE
    io::print("slept short")
  END IF
  RETURN 0
END FUNC
