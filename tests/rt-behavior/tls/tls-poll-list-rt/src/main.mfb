' plan-76-C: tls::poll(List OF RES TlsSocket) multiplex over live TLS connections
' to 8.8.8.8:443 (Google Public DNS; validated against dns.google). Output is
' reduced to stable booleans. Runs on any backend whose host executes it.
IMPORT io
IMPORT strings
IMPORT tls
IMPORT collections
IMPORT errorCode

' poll([]) on an empty list → ErrInvalidArgument.
FUNC pollEmpty AS Boolean
  MUT socks AS List OF RES TlsSocket = []
  RES r AS TlsSocket = tls::poll(socks)
  RETURN FALSE
  TRAP(e)
    RETURN e.code = errorCode::ErrInvalidArgument
  END TRAP
END FUNC

FUNC main AS Integer
  RES a = tls::connect("8.8.8.8", 443, 30000, "dns.google")
  RES b = tls::connect("8.8.8.8", 443, 30000, "dns.google")
  MUT socks AS List OF RES TlsSocket = []
  socks = collections::append(socks, a)
  socks = collections::append(socks, b)

  ' Two idle sockets: an immediate multiplex scan raises ErrTimeout.
  MUT idleTimeout AS Boolean = FALSE
  RES probe AS TlsSocket = tls::poll(socks, 0) TRAP(e)
    idleTimeout = (e.code = errorCode::ErrTimeout)
    RECOVER a
  END TRAP
  io::print("idleTimeout=" & toString(idleTimeout))

  io::print("empty=" & toString(pollEmpty()))

  ' Write to exactly one socket; the multiplex returns a readable socket.
  LET crlfBytes AS List OF Byte = [toByte(13), toByte(10)]
  LET crlf AS String = toString(crlfBytes)
  tls::writeText(b, "HEAD / HTTP/1.0" & crlf & "Host: dns.google" & crlf & crlf)
  RES ready AS TlsSocket = tls::poll(socks)
  LET reply AS String = tls::readText(ready, 4096)
  io::print("httpResponse=" & toString(strings::startsWith(reply, "HTTP/")))
  RETURN 0
END FUNC
