IMPORT io
IMPORT datetime
IMPORT errorCode

REM plan-66-A: the datetime clock/offset intrinsics (nowNanos / monotonicNanos /
REM localOffset) across every native target. Output is deterministic booleans so
REM the fixture is host-neutral: monotonic is non-decreasing, the wall clock is
REM past 2020, localOffset is run-stable, and an out-of-range instant traps
REM ErrInvalidArgument (bug-42 parity; the Windows path bound-checks the FILETIME
REM arithmetic to match the libc localtime_r NULL contract).
FUNC main AS Integer
  LET m1 AS datetime::Duration = datetime::monotonic()
  LET m2 AS datetime::Duration = datetime::monotonic()
  LET d AS datetime::Duration = datetime::minus(m2, m1)
  io::print("mono_nonneg=" & toString(d.seconds >= 0))
  LET now AS datetime::Instant = datetime::now()
  io::print("now_recent=" & toString(now.seconds > 1577836800))
  LET a AS Integer = datetime::localOffset(0)
  LET b AS Integer = datetime::localOffset(0)
  io::print("off_stable=" & toString(a = b))
  LET off AS Integer = datetime::localOffset(9223372036854775807)
  io::print("LEAKED off=" & toString(off))
  RETURN 0
  TRAP(err)
    io::print("oor_invalidArg=" & toString(err.code = errorCode::ErrInvalidArgument))
    RETURN 0
  END TRAP
END FUNC
