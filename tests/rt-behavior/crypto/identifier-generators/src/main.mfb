IMPORT crypto
IMPORT io
IMPORT strings

SUB main()
  LET u7 AS String = crypto::uuid7()
  LET variant AS String = strings::mid(u7, 19, 1)
  io::print("uuid7-length=" & toString(strings::byteLen(u7)))
  io::print("uuid7-version=" & strings::mid(u7, 14, 1))
  io::print("uuid7-variant=" & toString(variant = "8" OR variant = "9" OR variant = "a" OR variant = "b"))

  LET id AS String = crypto::ulid()
  io::print("ulid-length=" & toString(strings::byteLen(id)))
  io::print("ulid-first-valid=" & toString(strings::mid(id, 0, 1) >= "0" AND strings::mid(id, 0, 1) <= "7"))
  io::print("distinct=" & toString(crypto::uuid7() <> crypto::uuid7() AND crypto::ulid() <> crypto::ulid()))
END SUB
