' A crypto::decrypt box shorter than the 48-byte ephemeralPublicKey||tag overhead
' must FAIL with ErrInvalidArgument (the length guard in __crypto_decrypt), NOT the
' ErrIndexOutOfRange that the underlying collections::mid slice would otherwise raise
' on the negative ctLen = total - 48. It must still fail closed (no plaintext). The
' 48-byte minimum box (empty plaintext) round-trips. The recipient key pair is random
' per run, but every assertion below prints only a Boolean, so the output is stable.
IMPORT crypto
IMPORT collections
IMPORT errorCode
IMPORT io

' Decrypt a (too-short) box and report the raised error code; returns len on the
' impossible success path so a missing failure is visible as a wrong value.
FUNC shortBoxCode(priv AS List OF Byte, box AS List OF Byte) AS Integer
  LET back AS List OF Byte = crypto::decrypt(crypto::AsymmetricCipher.Ed25519_AES256GCM, priv, box)
  RETURN len(back)
  TRAP(err)
    RETURN err.code
  END TRAP
END FUNC

SUB main()
  LET kp AS crypto::KeyPair = crypto::generate(crypto::Certificate.Ed25519)

  ' Minimum valid box: empty plaintext -> ephPub(32) || ct(0) || tag(16) = 48 bytes.
  LET empty AS List OF Byte = []
  LET box48 AS List OF Byte = crypto::encrypt(crypto::AsymmetricCipher.Ed25519_AES256GCM, kp.publicKey, empty)
  LET rt AS List OF Byte = crypto::decrypt(crypto::AsymmetricCipher.Ed25519_AES256GCM, kp.privateKey, box48)
  io::print("box48-len=" & toString(len(box48)))
  io::print("roundtrip-empty-ok=" & toString(len(rt) = 0))

  ' Too-short boxes: empty, 32 bytes (ephPub only), 47 bytes (one below the overhead).
  LET box32 AS List OF Byte = collections::mid(box48, 0, 32)
  LET box47 AS List OF Byte = collections::mid(box48, 0, 47)
  io::print("empty-invalid=" & toString(shortBoxCode(kp.privateKey, empty) = errorCode::ErrInvalidArgument))
  io::print("box32-invalid=" & toString(shortBoxCode(kp.privateKey, box32) = errorCode::ErrInvalidArgument))
  io::print("box47-invalid=" & toString(shortBoxCode(kp.privateKey, box47) = errorCode::ErrInvalidArgument))
END SUB
