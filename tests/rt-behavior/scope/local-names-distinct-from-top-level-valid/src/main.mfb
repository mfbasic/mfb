' plan-136-C: none of these locals collides with a VISIBLE top-level LET/MUT, so all
' of them stay legal:
'   - `secret` is a PRIVATE binding of another file (src/other.mfb), not visible here;
'   - `helper` is a FUNC, and functions are not covered by the rule;
'   - `shared` is an imported package's binding, reachable only as `scopepkg::shared`;
'   - the FOR loop synthesizes compiler-internal locals no user can spell.
IMPORT io
IMPORT scopepkg

FUNC helper() AS Integer
  RETURN 1
END FUNC

FUNC main() AS Integer
  LET secret AS Integer = 7
  LET helper AS Integer = 2
  LET shared AS Integer = 3
  MUT total AS Integer = 0
  FOR i = 1 TO 3
    total = total + i
  NEXT
  io::print(toString(secret) & " " & toString(otherSecret()))
  io::print(toString(helper))
  io::print(toString(shared) & " " & toString(scopepkg::shared))
  io::print(toString(total))
  RETURN 0
END FUNC
