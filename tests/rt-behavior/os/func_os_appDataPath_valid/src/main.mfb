' os::appDataPath — the per-user app data directory (plan-157-B). Every line is a
' TRUE/FALSE or an error code, computed against the running OS's own rule, so the
' output is the same on macOS, Linux and Windows:
'   macOS   <home>/Library/Application Support/<project name>
'   Linux   $XDG_DATA_HOME/<name> when set, non-empty and absolute, else <home>/.local/share/<name>
'   Windows <APPDATA known folder>/<name>
' <home> is $HOME when set and non-empty, else the account's home directory.
IMPORT os
IMPORT io
IMPORT strings

FUNC resolve(p AS String) AS String
  RETURN os::appDataPath(p)
END FUNC

FUNC code(p AS String) AS Integer
  MUT c AS Integer = 0
  resolve(p) TRAP(e)
    c = e.code
    RECOVER ""
  END TRAP
  RETURN c
END FUNC

' The base this OS must produce for `home` with XDG_DATA_HOME unset.
FUNC expected(home AS String) AS String
  IF os::name() = "windows" THEN
    RETURN os::getEnv("APPDATA") & "/func_os_appDataPath_valid"
  END IF
  IF os::name() = "macos" THEN
    RETURN home & "/Library/Application Support/func_os_appDataPath_valid"
  END IF
  RETURN home & "/.local/share/func_os_appDataPath_valid"
END FUNC

FUNC main AS Integer
  os::unsetEnv("XDG_DATA_HOME")
  os::setEnv("HOME", "/tmp/mfb156")
  LET base AS String = os::appDataPath()
  io::print(toString(base = expected("/tmp/mfb156")))
  ' A trailing `/` on HOME is dropped.
  os::setEnv("HOME", "/tmp/mfb156/")
  io::print(toString(os::appDataPath() = base))
  ' XDG_DATA_HOME: an absolute value wins on Linux; macOS and Windows ignore it.
  os::setEnv("XDG_DATA_HOME", "/tmp/xdg156")
  IF os::name() = "linux" THEN
    io::print(toString(os::appDataPath() = "/tmp/xdg156/func_os_appDataPath_valid"))
  ELSE
    io::print(toString(os::appDataPath() = base))
  END IF
  ' A relative or empty value is ignored everywhere.
  os::setEnv("XDG_DATA_HOME", "rel/dir")
  io::print(toString(os::appDataPath() = base))
  os::setEnv("XDG_DATA_HOME", "")
  io::print(toString(os::appDataPath() = base))
  os::unsetEnv("XDG_DATA_HOME")
  ' `relative` joins with `/`; omitted, there is no trailing `/`.
  io::print(toString(os::appDataPath("saves/a.dat") = base & "/saves/a.dat"))
  io::print(toString(strings::endsWith(base, "/")))
  io::print(toString(os::appDataPath("") = base))
  ' A `.`/`..` component raises ErrInvalidPath (77030002); a dot in a name is fine.
  io::print(toString(code("a/../b")))
  io::print(toString(code("../x")))
  io::print(toString(code("x/..")))
  io::print(toString(code("./x")))
  io::print(toString(code("..cfg/a..b")))
  ' `\` ends a component on Windows only.
  IF os::name() = "windows" THEN
    io::print(toString(code("..\\x") = 77030002))
  ELSE
    io::print(toString(code("..\\x") = 0))
  END IF
  ' HOME unset: the account's home directory (POSIX); Windows never reads HOME.
  os::unsetEnv("HOME")
  LET noHome AS String = os::appDataPath()
  IF os::name() = "windows" THEN
    io::print(toString(noHome = base))
  ELSE
    io::print(toString(strings::startsWith(noHome, "/") AND strings::endsWith(noHome, "/func_os_appDataPath_valid")))
  END IF
  os::setEnv("HOME", "/tmp/mfb156")
  ' In place: `s = os::appDataPath(s)` agrees with the copying call.
  MUT s AS String = "saves/a.dat"
  s = os::appDataPath(s)
  io::print(toString(s = base & "/saves/a.dat"))
  MUT e AS String = ""
  e = os::appDataPath(e)
  io::print(toString(e = base))
  ' ...and follows a HOME change between statements (nothing is cached).
  os::setEnv("HOME", "/tmp/other156")
  MUT k AS String = "k"
  k = os::appDataPath(k)
  io::print(toString(k = expected("/tmp/other156") & "/k"))
  RETURN 0
END FUNC
