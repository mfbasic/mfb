' drawText stamps a string on one row at an absolute position, one cell per scalar,
' without moving the cursor; it clips at the right edge, skips off-left columns, and
' ignores control characters. Non-tty harness (24x80), deterministic escape stream.
IMPORT term
IMPORT color

FUNC main AS Integer
  term::on()
  term::setForeground(color::rgb(255, 255, 0))
  term::drawText(3, 2, "Hello, TUI!")
  term::drawText(-2, 4, "clip-left")      ' first two scalars fall off the left edge
  term::drawGlyph(0, 0, 9731)             ' also exercise drawGlyph (snowman U+2603)
  term::sync()
  term::off()
  RETURN 0
END FUNC
