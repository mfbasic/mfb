' bug-979: for an http(s) URL `net::toUrl` agrees with the WHATWG URL parser on
' the host. A numeric IPv4 host in any accepted spelling is stored in canonical
' dotted-decimal form, so an allow-list compares what a connection reaches; a
' `\` ends the authority and separates path segments exactly as `/` does; a
' bracketed IPv6 literal and a registered name are kept as written.

IMPORT net
IMPORT io

FUNC show(href AS String) AS Nothing
  LET u AS net::Url = net::toUrl(href) TRAP(e)
    io::print(href & " RAISED " & e.message)
    RETURN
  END TRAP
  io::print(href & " -> host=" & u.host & " port=" & toString(u.port) & " user=" & u.username & " path=" & u.path & " href=" & toString(u))
END FUNC

FUNC main AS Integer
  ' Every spelling of 127.0.0.1 the WHATWG IPv4 parser accepts.
  show("http://127.0.0.1/")
  show("http://0x7f.1/")
  show("http://0X7F.0.0.1/")
  show("http://2130706433/")
  show("http://127.1/")
  show("http://0177.0.0.1/")
  show("http://017700000001/")
  show("http://127.0.0.1./")
  ' A leading zero is octal: 010 is 8, not 10.
  show("http://127.0.0.010/")
  show("http://0/")
  show("http://1.2.3/")
  show("http://0xffffffff/")
  show("https://user:pw@0x7f.1:8443/x")
  ' The address is recognised in the percent-decoded host.
  show("http://%30x7f.1/")
  ' A backslash is a slash: it ends the authority and separates path segments.
  show("http://good.com\\@evil.com/")
  show("http://h.com\\a\\b?q\\q#f\\f")
  show("http://h.com:8080\\x")
  show("http://[::1]\\x")
  ' Names and IPv6 literals are stored as written.
  show("http://Example.COM/")
  show("http://a_b.example/")
  show("http://1.2.3.4.example/")
  show("http://[2001:DB8::1]:8080/")
  show("http://[::ffff:1.2.3.4]/")
  show("http://[1:2:3:4:5:6:7:8]/")
  RETURN 0
END FUNC
