' plan-73-C: net::accept timeout convention.
'  - accept(server, 0) with no pending client -> immediate ErrTimeout (77050008)
'    (was block-forever before plan-73).
'  - accept(server, -1) -> ErrInvalidArgument (77050002).
'  - accept(server) with the timeout OMITTED blocks until a client arrives; a peer
'    connects first, so it returns the connection (proving omit routes to block).
IMPORT net
IMPORT io

' accept(server, 0) on an idle listener -> ErrTimeout. Returns 0 on the expected
' error, nonzero otherwise. (The success path is unexpected.)
FUNC acceptZeroTimeout(server AS Listener) AS Integer
  RES s = net::accept(server, 0)
  net::close(s)
  RETURN 1
  TRAP(err)
    IF err.code = 77050008 THEN
      RETURN 0
    END IF
    io::print("accept0 wrong " & toString(err.code))
    RETURN 2
  END TRAP
END FUNC

' accept(server, -1) -> ErrInvalidArgument.
FUNC acceptNegativeInvalid(server AS Listener) AS Integer
  RES s = net::accept(server, -1)
  net::close(s)
  RETURN 1
  TRAP(err)
    IF err.code = 77050002 THEN
      RETURN 0
    END IF
    io::print("accept-neg wrong " & toString(err.code))
    RETURN 2
  END TRAP
END FUNC

FUNC main AS Integer
  RES server = net::listenTcp("127.0.0.1", 0)
  LET bound = net::localAddress(server)

  IF acceptZeroTimeout(server) <> 0 THEN
    RETURN 1
  END IF
  io::print("accept0 timeout")

  IF acceptNegativeInvalid(server) <> 0 THEN
    RETURN 1
  END IF
  io::print("accept-neg invalid")

  ' Omitted timeout blocks until a client arrives; connect first so it returns.
  RES client = net::connectTcp("127.0.0.1", bound.port)
  RES conn = net::accept(server)
  io::print("accept-omit ok")
  net::close(conn)
  net::close(client)
  RETURN 0
END FUNC
