' bug-480 Defect B1. The prefixed spelling of an imported enum MEMBER is the one
' the governing rule requires, and before the fix it escaped the front end and
' died in NIR with `error: NIR local reference 'net.PingStatus' does not resolve`
' -- no file, no line, no error code.
'
' Every expression position the bug report measured is exercised here: a `CASE`
' pattern (which escaped entirely), a `LET` initialiser (which reported
' TYPE_UNKNOWN_VALUE naming neither the enum nor the qualifier), a comparison,
' and a call argument. `net::ping` is deliberately NOT called -- ICMP needs OS
' permission this fixture does not want to depend on; the enum is a value in its
' own right.
'
' The second import pins the other half of the rule: the qualifier is the import
' BINDING, not the package name, so `alias::PingStatus.Ok` names the same enum
' member as `net::PingStatus.Ok`.
IMPORT net
IMPORT net AS alias
IMPORT io

FUNC statusName(s AS net::PingStatus) AS String
  MATCH s
    CASE net::PingStatus.Ok
      RETURN "Ok"
    CASE net::PingStatus.Timeout
      RETURN "Timeout"
    CASE net::PingStatus.Unreachable
      RETURN "Unreachable"
    CASE net::PingStatus.TtlExceeded
      RETURN "TtlExceeded"
  END MATCH
END FUNC

' The same enum reached entirely through the alias binding -- parameter
' annotation, CASE pattern and member alike.
FUNC aliasName(s AS alias::PingStatus) AS String
  MATCH s
    CASE alias::PingStatus.Ok
      RETURN "alias:Ok"
    CASE ELSE
      RETURN "alias:other"
  END MATCH
END FUNC

FUNC main AS Integer
  ' LET initialiser.
  LET ok = net::PingStatus.Ok
  ' Call argument.
  io::print("arg=" & statusName(net::PingStatus.Timeout))
  ' Through a binding.
  io::print("let=" & statusName(ok))
  ' Comparison.
  io::print("eq=" & toString(ok = net::PingStatus.Ok))
  io::print("ne=" & toString(ok = net::PingStatus.Unreachable))
  ' Annotated binding, the position that already worked.
  LET t AS net::PingStatus = net::PingStatus.TtlExceeded
  io::print("annotated=" & statusName(t))
  ' The alias binding names the same enum, so a value built through one spelling
  ' is matched by the other.
  io::print(aliasName(alias::PingStatus.Ok))
  io::print(aliasName(ok))
  io::print("alias eq=" & toString(alias::PingStatus.Timeout = net::PingStatus.Timeout))
  RETURN 0
END FUNC
