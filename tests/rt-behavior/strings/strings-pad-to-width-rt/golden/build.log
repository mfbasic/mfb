-- scalar padding and column padding produce different strings --
scalar=[ascii   ] width=[ascii   ]
scalar=[日本語     ] width=[日本語  ]
scalar=[café    ] width=[café    ]
scalar=[café   ] width=[café    ]
scalar=[😀😀      ] width=[😀😀    ]

-- the new measure: every row is 8 columns and they line up --
|ascii   |end|
|日本語  |end|
|café    |end|
|café    |end|
|😀😀    |end|

-- padLeftToWidth is the same rule from the other side --
|   ascii|
|  日本語|
|    café|
|    café|
|    😀😀|

-- UNDERSHOOT: the result never exceeds `columns` --
padLeftToWidth(x, 6, wide)=[😀😀x]
padRightToWidth(x, 6, wide)=[x😀😀]
padLeftToWidth(x, 7, wide)=[😀😀😀x]

-- never truncates, and 0 never pads --
[日本語]
[abc]

-- rejections, each catchable through an INLINE trap --
negative columns   77050002
empty padChar      77050002
2-scalar padChar   77050002
zero-width padChar 77050002
unbuildable width  77010001
recovered: -----
padLeft takes that same padChar, scalars=4

-- the AttributedString overload runs on the visible text --
padRightToWidth=[日本    ] bold=BB----
padLeftToWidth=[    日本] bold=----BB

-- the POSITIVE pin: padLeft/padRight are untouched --
[   42]
[42000]
[--日本] scalars=4
ascii agree: [...ab] [...ab]
