-- both members refuse the empty needle/pattern, with one code --
strings::replace  empty=RAISED 77050002
regex::replace    empty=RAISED 77050002
astrings overload empty=RAISED 77050002

-- the positive half: an ordinary needle is untouched --
strings::replace  nonEmpty="a-ca-c"
regex::replace    nonEmpty="a-ca-c"
astrings overload nonEmpty="a-c"
strings::replace  noMatch="abc"
regex::replace    noMatch="abc"
strings::replace  emptyNew="acac"
regex::replace    emptyNew="acac"

-- THE GUARD IS ON THE SPELLING, NOT ON ZERO-WIDTH MATCHING --
regex::replace "a*"   ="-b-c-"
regex::replace "(?:)" ="-a-b-c-"
regex::replace "x?"   ="-a-b-c-"
regex::replace "\\b"   ="-abc-"

-- regex QUERY members keep their zero-width answers for "" --
regex::match("abc","")    = TRUE
regex::find("abc","")     = 0
regex::findAll("abc","")  = n4
regex::findMatch("abc","").start = 0

-- the `strings` empty-needle rule, unchanged on the query side --
strings::contains("abc","") = TRUE
strings::find("abc","")     = 0

-- collections::replace shares the lowering; an empty ELEMENT is a
   value, not a degenerate needle, so it is untouched --
collections::replace  empty=[a][Z][c]
collections::replace  nonEmpty=[Z][][c]

-- the inline TRAP form, which is where a name-keyed verdict bites --
inline TRAP handler RAN, code=77050002
strings::replace  empty       -> "recovered"
strings::replace  nonEmpty    -> "a-ca-c"
collections::replace inline   -> n=3
[exit 0]
