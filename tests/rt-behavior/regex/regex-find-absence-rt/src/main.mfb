' bug-531 -- absence is one contract across the language: `find` raises.
'
' `regex::find` used to answer absence with `-1`, while `strings::find`,
' `collections::find`, `collections::findIndex` and `collections::findLastIndex`
' all raise `ErrNotFound` (77050004). Four index-returning members raised and one
' returned a sentinel; swapping a literal search for a pattern search turned a
' call that TRAPped on absence into one that fed `-1` into an index expression,
' with no compile error in between. `regex::find` now raises too.
'
' The convergence is deliberately narrow, and the second half of this fixture is
' what keeps it narrow. It touches ONLY the member whose return type has no room
' for "absent":
'
'   * `regex::match` still returns FALSE          -- a Boolean answers a predicate
'   * `regex::findAll` still returns an empty list -- an empty list IS "no matches"
'   * `regex::replace` still returns `value`      -- rewriting nothing is a result
'   * `regex::findMatch` still returns a MatchInfo whose `start` is -1 -- a record
'     HAS an absent value, and the whole no-match MatchInfo is that value
'
' Positive pins: every member is also exercised on a PRESENT match, so a guard
' that rejected a valid search would fail here too, and `find`'s returned index
' is checked to be the one `findMatch` reports.

IMPORT io
IMPORT regex
IMPORT strings

FUNC findGuard(v AS String, p AS String) AS String
  RETURN "index=" & toString(regex::find(v, p))
TRAP(err)
  RETURN "RAISED " & toString(err.code)
END TRAP
END FUNC

FUNC findAtGuard(v AS String, p AS String, s AS Integer) AS String
  RETURN "index=" & toString(regex::find(v, p, s))
TRAP(err)
  RETURN "RAISED " & toString(err.code)
END TRAP
END FUNC

FUNC stringsFindGuard(v AS String, n AS String) AS String
  RETURN "index=" & toString(strings::find(v, n))
TRAP(err)
  RETURN "RAISED " & toString(err.code)
END TRAP
END FUNC

' The documented migration for a caller that wants the old shape back.
FUNC findOrMinusOne(v AS String, p AS String) AS Integer
  RETURN regex::find(v, p)
TRAP(err)
  RETURN -1
END TRAP
END FUNC

FUNC main AS Integer
  ' Runtime-derived operands, so no constant fold can answer instead of the call.
  LET subj AS String = strings::mid("xabcx", 1, 3)
  LET present AS String = strings::mid("xbx", 1, 1)
  LET absent AS String = strings::mid("xzx", 1, 1)

  io::print("-- absence is a raise, in both packages, with the same code --")
  io::print("regex::find    absent=" & findGuard(subj, absent) & " present=" & findGuard(subj, present))
  io::print("strings::find  absent=" & stringsFindGuard(subj, absent) & " present=" & stringsFindGuard(subj, present))
  io::print("")

  io::print("-- the raise survives a start offset, and a start past the last match --")
  io::print("find(start=0) " & findAtGuard(subj, present, 0))
  io::print("find(start=2) " & findAtGuard(subj, present, 2))
  io::print("find(start=3) " & findAtGuard(subj, present, 3))
  io::print("")

  io::print("-- an out-of-range start still raises ErrIndexOutOfRange, not ErrNotFound --")
  io::print("find(start=4) " & findAtGuard(subj, present, 4))
  io::print("find(start=-1) " & findAtGuard(subj, present, 0 - 1))
  io::print("")

  io::print("-- an invalid pattern still raises ErrInvalidFormat --")
  io::print("find(\"(\")     " & findGuard(subj, "("))
  io::print("")

  io::print("-- the other members keep their answers: absence is not an error there --")
  io::print("match    absent=" & toString(regex::match(subj, absent)) & " present=" & toString(regex::match(subj, present)))
  io::print("findAll  absent=n" & toString(len(regex::findAll(subj, absent))) & " present=n" & toString(len(regex::findAll(subj, present))))
  io::print("replace  absent=\"" & regex::replace(subj, absent, "-") & "\" present=\"" & regex::replace(subj, present, "-") & "\"")
  io::print("findMatch absent start=" & toString(regex::findMatch(subj, absent).start) & " present start=" & toString(regex::findMatch(subj, present).start))
  io::print("")

  io::print("-- find and findMatch still agree WHERE A MATCH EXISTS --")
  io::print("find=" & toString(regex::find(subj, present)) & " findMatch.start=" & toString(regex::findMatch(subj, present).start))
  io::print("")

  io::print("-- the documented TRAP-to-(-1) wrapper reproduces the old shape --")
  io::print("findOrMinusOne absent=" & toString(findOrMinusOne(subj, absent)) & " present=" & toString(findOrMinusOne(subj, present)))
  RETURN 0
END FUNC
