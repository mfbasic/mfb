IMPORT net
IMPORT tcp
IMPORT io
IMPORT errorCode

' bug-109: on linux-x86_64 tcp::write used a raw SYS_WRITE syscall (return
' -errno in rax, libc errno untouched), but the failure path read errno via
' __errno_location. So an EAGAIN write timeout was misclassified as a closed
' connection (ErrConnectionClosed) on x86-64 only. Fill a TCP socket whose peer
' never reads, with a short write timeout: the write must fail with a timeout on
' every target. (plan-73-C: the retired net-only ErrWriteTimeout collapsed into
' the single ErrTimeout — this fixture now doubles as the runtime proof of that.)
FUNC pump() AS Integer
  RES server = tcp::listen("127.0.0.1", 0)
  LET bound = tcp::localAddress(server)
  RES client = tcp::connect("127.0.0.1", bound.port)
  RES accepted = tcp::accept(server)
  tcp::setWriteTimeout(client, 100)
  ' Build a ~1 MiB payload so a single write overruns the kernel buffers.
  MUT big AS String = "x"
  MUT i AS Integer = 0
  WHILE i < 20
    big = big & big
    i = i + 1
  END WHILE
  MUT n AS Integer = 0
  WHILE n < 1000
    tcp::write(client, big)
    n = n + 1
  END WHILE
  RETURN 0
  TRAP(e)
    RETURN e.code
  END TRAP
END FUNC

FUNC main AS Integer
  LET code AS Integer = pump()
  io::print("writeTimeout=" & toString(code = errorCode::ErrTimeout))
  RETURN 0
END FUNC
