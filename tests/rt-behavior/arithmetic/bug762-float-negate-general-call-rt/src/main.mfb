' bug-762: a unary minus over a bare `general` builtin call (`-toFloat(len(s))`)
' is a Float operation that lowers the finiteness check, so the module must
' register the Float error messages. Keep it the only Float operation here (see
' bug762-float-arith-on-general-call-rt for why).
IMPORT io

FUNC neg(s AS String) AS Float
  RETURN -toFloat(len(s))
END FUNC

FUNC main() AS Nothing
  io::print(toString(neg("abc")))
END FUNC
