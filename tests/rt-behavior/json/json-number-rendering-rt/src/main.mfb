' plan-120-G: json::stringify renders numbers exactly as JSON.stringify does.
'
' Every expected string below was captured from Node v24.12.0 by running
' JSON.stringify(Number(literal)) on the literal in the same row. Node is not
' a convenient oracle here, it is the specification -- the whole point of the
' letter is that a number written by MFB and read by JavaScript, or the other
' way round, is the same number and the same text.
'
' The curated rows are the ones that can go wrong for a reason: both placement
' boundaries from each side, the two exact ties where ECMA-262 requires the
' EVEN candidate rather than the larger one, the all-nines ripple that has to
' carry into the exponent, the largest finite value whose short candidates
' overflow the parser mid-search, and the two subnormals that previously had
' no JSON form at all and failed outright.
'
' The rest is a random sweep across the exponent range, fed in as shortest
' repr and therefore naming exactly one double each.
IMPORT io
IMPORT json

MUT checked AS Integer = 0
MUT wrong AS Integer = 0

FUNC render(text AS String) AS String
  RETURN json::stringify(json::JsonNum[toFloat(text)])
TRAP(e)
  RETURN "FAILED " & toString(e.code)
END TRAP
END FUNC

SUB check(text AS String, expected AS String)
  checked = checked + 1
  LET got AS String = render(text)
  IF got = expected THEN
    io::print("OK    " & text & " -> " & got)
  ELSE
    wrong = wrong + 1
    io::print("WRONG " & text)
    io::print("  want " & expected)
    io::print("  got  " & got)
  END IF
END SUB

FUNC main AS Integer
  ' boundary: first exponential
  check("1e21", "1e+21")
  ' boundary: last plain
  check("1e20", "100000000000000000000")
  ' boundary: last plain
  check("1e-6", "0.000001")
  ' boundary: first exponential
  check("1e-7", "1e-7")
  check("1e-21", "1e-21")
  ' used to FAIL: no fixed rendering exists
  check("1e-30", "1e-30")
  ' used to FAIL: the smallest subnormal
  check("5e-324", "5e-324")
  check("-5e-324", "-5e-324")
  ' largest finite; short candidates overflow
  check("1.7976931348623157e308", "1.7976931348623157e+308")
  check("-1.7976931348623157e308", "-1.7976931348623157e+308")
  ' smallest normal
  check("2.2250738585072014e-308", "2.2250738585072014e-308")
  ' largest subnormal
  check("2.2250738585072011e-308", "2.225073858507201e-308")
  ' plan-120-C: negative zero serializes as 0
  check("-0", "0")
  check("0", "0")
  check("1", "1")
  check("-1.5", "-1.5")
  check("100", "100")
  check("0.1", "0.1")
  check("0.2", "0.2")
  check("0.3", "0.3")
  check("1e-5", "0.00001")
  check("0.5", "0.5")
  check("1234", "1234")
  check("1e100", "1e+100")
  check("1e-100", "1e-100")
  ' exact tie at 16 digits: ECMA-262 takes the even one
  check("877566786661990.25", "877566786661990.2")
  ' exact tie at 17 digits
  check("2188699164681338.2", "2188699164681338.2")
  check("3.141592653589793", "3.141592653589793")
  ' 2^53
  check("9007199254740992", "9007199254740992")
  ' 2^53+1, not representable
  check("9007199254740993", "9007199254740992")
  ' 30 digits in, 17 out
  check("123456789012345678901234567890", "1.2345678901234568e+29")
  ' all-nines ripple: same double as 1e23
  check("9.999999999999999e22", "1e+23")
  check("1e23", "1e+23")
  check("4.9406564584124654e-324", "5e-324")
  check("1e-323", "1e-323")
  check("1234.5678", "1234.5678")
  check("123456789", "123456789")
  check("3.2021233947577275e+266", "3.2021233947577275e+266")
  check("2.005909754721573e-116", "2.005909754721573e-116")
