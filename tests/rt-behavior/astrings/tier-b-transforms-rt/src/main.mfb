REM plan-89-D Phases 1–2: attribute-preserving transforms (slice/trim/pad/repeat)
REM and case/normalize (drop attributes). Each line prints the transformed text
REM (which must equal the String transform of the plaintext — the text invariant)
REM and a per-scalar bold map (`B` where bold is active) proving span positions.

IMPORT astrings
IMPORT strings
IMPORT io

FUNC boldMap(a AS AttributedString) AS String
  MUT out AS String = ""
  MUT i AS Integer = 0
  LET n AS Integer = len(strings::toScalars(toString(a)))
  WHILE i < n
    MUT mark AS String = "-"
    FOR EACH at IN astrings::getAttributes(a, i)
      MATCH at
        CASE AttrFlag(f)
          mark = "B"
        CASE ELSE
      END MATCH
    NEXT
    out = out & mark
    i = i + 1
  END WHILE
  RETURN out
END FUNC

FUNC main AS Integer
  ' "hello world" with bold on [0,4] ("hello")
  LET base AS AttributedString = astrings::addAttribute(astrings::fromString("hello world"), 0, 4, astrings::bold())

  LET m AS AttributedString = strings::mid(base, 3, 5)
  io::print("mid=" & toString(m) & " inv=" & strings::mid("hello world", 3, 5) & " bold=" & boldMap(m))
  LET l AS AttributedString = strings::left(base, 3)
  io::print("left=" & toString(l) & " inv=" & strings::left("hello world", 3) & " bold=" & boldMap(l))
  LET r AS AttributedString = strings::right(base, 4)
  io::print("right=" & toString(r) & " inv=" & strings::right("hello world", 4) & " bold=" & boldMap(r))

  LET sp AS AttributedString = astrings::addAttribute(astrings::fromString("  hi  "), 2, 3, astrings::bold())
  LET tr AS AttributedString = strings::trim(sp)
  io::print("trim=[" & toString(tr) & "] inv=[" & strings::trim("  hi  ") & "] bold=" & boldMap(tr))
  LET ts AS AttributedString = strings::trimStart(sp)
  io::print("trimStart=[" & toString(ts) & "] bold=" & boldMap(ts))
  LET te AS AttributedString = strings::trimEnd(sp)
  io::print("trimEnd=[" & toString(te) & "] bold=" & boldMap(te))

  LET spx AS AttributedString = astrings::addAttribute(astrings::fromString("__hi__"), 2, 3, astrings::bold())
  LET tc AS AttributedString = strings::trimChars(spx, "_")
  io::print("trimChars=[" & toString(tc) & "] inv=[" & strings::trimChars("__hi__", "_") & "] bold=" & boldMap(tc))

  LET pfx AS AttributedString = astrings::addAttribute(astrings::fromString(">>data"), 2, 5, astrings::bold())
  LET sp2 AS AttributedString = strings::stripPrefix(pfx, ">>")
  io::print("stripPrefix=[" & toString(sp2) & "] inv=[" & strings::stripPrefix(">>data", ">>") & "] bold=" & boldMap(sp2))

  LET pl AS AttributedString = strings::padLeft(base, 14)
  io::print("padLeft=[" & toString(pl) & "] bold=" & boldMap(pl))
  LET pr AS AttributedString = strings::padRight(base, 14)
  io::print("padRight=[" & toString(pr) & "] bold=" & boldMap(pr))

  LET rep AS AttributedString = strings::repeat(base, 2)
  io::print("repeat=" & toString(rep) & " bold=" & boldMap(rep))

  ' case/normalize: text transformed, attributes dropped.
  LET up AS AttributedString = strings::upper(base)
  io::print("upper=" & toString(up) & " inv=" & strings::upper("hello world") & " bold=" & boldMap(up))
  LET lo AS AttributedString = strings::lower(astrings::addAttribute(astrings::fromString("HELLO"), 0, 4, astrings::bold()))
  io::print("lower=" & toString(lo) & " bold=" & boldMap(lo))
  RETURN 0
END FUNC
