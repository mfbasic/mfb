IMPORT io
IMPORT errorCode

' =====================================================================
' Acceptance suite for the io package (standard streams + terminal inspection).
'
' io is inherently side-effecting: the output calls write to the very stdout the
' test driver streams its report on, and the input calls read stdin, which in a
' shared, possibly-interactive driver must never be allowed to block. So the
' deterministic, non-blocking, non-polluting surface is asserted directly:
'   * buffering state (setBuffered/isBuffered/flush) — exact round-trip values;
'   * the output calls succeed on valid UTF-8 (expectNTrap; the stderr calls do
'     not touch the report stream, the stdout ones use empty/near-empty payloads);
'   * the terminal predicates never raise and return a Boolean (their VALUE is
'     environment-dependent — a pipe vs a tty — so the type/no-raise contract is
'     what is pinned, per `mfb man io`);
'   * every reader rejects a negative timeout (ErrInvalidArgument).
' The reads are exercised for their end-of-input error ONLY when an immediate
' read (timeout 0) finds the input at its end — so an interactive run skips them
' rather than hanging, while an automated run (stdin at EOF) verifies each
' reports ErrEndOfFile (77020003) at end of input.
' =====================================================================

FUNC rdLine() AS String
  RETURN io::readLine()
END FUNC
FUNC rdRaw() AS Byte
  RETURN io::readRaw()
END FUNC
FUNC rdScalar() AS Scalar
  RETURN io::readScalar()
END FUNC
FUNC rdGrapheme() AS String
  RETURN io::readGrapheme()
END FUNC
FUNC rdKey() AS io::Key
  RETURN io::readKey()
END FUNC
FUNC rdInput() AS String
  RETURN io::input()
END FUNC
FUNC rdInputPrompt() AS String
  ' The prompt overload; an empty prompt writes nothing, so it never pollutes
  ' the driver's report stream, and still reads (and reports EOF) like input().
  RETURN io::input("")
END FUNC
FUNC negLine() AS String
  RETURN io::readLine(0 - 1)
END FUNC
FUNC negInput() AS String
  RETURN io::input("", 0 - 1)
END FUNC
FUNC negRaw() AS Byte
  RETURN io::readRaw(0 - 1)
END FUNC
FUNC negScalar() AS Scalar
  RETURN io::readScalar(0 - 1)
END FUNC
FUNC negGrapheme() AS String
  RETURN io::readGrapheme(0 - 1)
END FUNC
FUNC negKey() AS io::Key
  RETURN io::readKey(0 - 1)
END FUNC
' Whether standard input is at its end: one immediate read (timeout 0), which
' never blocks. It reads nothing at the end of input, and at most one byte
' otherwise.
FUNC atEnd() AS Boolean
  LET b AS Byte = io::readRaw(0) TRAP(e)
    RETURN e.code = errorCode::ErrEndOfFile
  END TRAP
  RETURN FALSE
END FUNC

TESTING
  TGROUP "Builtin: io"

    ' =================================================================
    ' Standard-output buffering (per-thread, off by default)
    ' =================================================================
    TGROUP "buffering"
      TCASE "isBuffered defaults to FALSE"
        expectEqual(io::isBuffered(), FALSE)
      END TCASE
      TCASE "setBuffered round-trips and isBuffered reflects it"
        io::setBuffered(TRUE)
        expectEqual(io::isBuffered(), TRUE)
        io::setBuffered(FALSE)
        expectEqual(io::isBuffered(), FALSE)
        io::setBuffered(TRUE)
        io::setBuffered(TRUE)
        expectEqual(io::isBuffered(), TRUE)
        io::setBuffered(FALSE)
        expectEqual(io::isBuffered(), FALSE)
      END TCASE
      TCASE "flush never fails, buffered or not"
        expectNTrap(io::flush())
        io::setBuffered(TRUE)
        io::write("")
        expectNTrap(io::flush())
        io::setBuffered(FALSE)
        expectNTrap(io::flush())
      END TCASE
    END TGROUP

    ' =================================================================
    ' Output calls succeed on valid UTF-8 (no implicit conversion)
    ' =================================================================
    TGROUP "output"
      TCASE "stdout writers accept text without failing"
        expectNTrap(io::write(""))
        expectNTrap(io::print(""))
      END TCASE
      TCASE "stderr writers accept text (incl. multi-byte) without failing"
        expectNTrap(io::writeError(""))
        expectNTrap(io::printError("io-acceptance: stderr marker"))
        expectNTrap(io::writeError("caf\u{00E9} \u{1F600}"))
      END TCASE
    END TGROUP

    ' =================================================================
    ' Terminal predicates — never raise, always Boolean (value is env-dependent)
    ' =================================================================
    TGROUP "terminal predicates"
      TCASE "each predicate returns a Boolean and never raises"
        expectString(typeName(io::isInputTerminal()), "Boolean")
        expectString(typeName(io::isOutputTerminal()), "Boolean")
        expectString(typeName(io::isErrorTerminal()), "Boolean")
        expectNTrap(io::isInputTerminal())
        expectNTrap(io::isOutputTerminal())
        expectNTrap(io::isErrorTerminal())
      END TCASE
    END TGROUP

    ' =================================================================
    ' Timeouts — the timeout convention (§18.4)
    ' =================================================================
    TGROUP "timeouts"
      TCASE "every reader rejects a negative timeout"
        expectTrap(negLine(), errorCode::ErrInvalidArgument)
        expectTrap(negInput(), errorCode::ErrInvalidArgument)
        expectTrap(negRaw(), errorCode::ErrInvalidArgument)
        expectTrap(negScalar(), errorCode::ErrInvalidArgument)
        expectTrap(negGrapheme(), errorCode::ErrInvalidArgument)
        expectTrap(negKey(), errorCode::ErrInvalidArgument)
      END TCASE
    END TGROUP

    ' =================================================================
    ' Input reads — end-of-input error, guarded so an interactive run
    ' (no data waiting) never blocks: only read when an immediate read finds
    ' the input at its end. Under automated runs stdin is at EOF, so each
    ' read reports ErrEndOfFile.
    ' =================================================================
    TGROUP "input reads at end of input"
      TCASE "readLine reports ErrEndOfFile at EOF"
        IF atEnd() THEN
          expectTrap(rdLine(), errorCode::ErrEndOfFile)
        END IF
        expectEqual(TRUE, TRUE)
      END TCASE
      TCASE "readRaw reports ErrEndOfFile at EOF"
        IF atEnd() THEN
          expectTrap(rdRaw(), errorCode::ErrEndOfFile)
        END IF
        expectEqual(TRUE, TRUE)
      END TCASE
      TCASE "readScalar reports ErrEndOfFile at EOF"
        IF atEnd() THEN
          expectTrap(rdScalar(), errorCode::ErrEndOfFile)
        END IF
        expectEqual(TRUE, TRUE)
      END TCASE
      TCASE "readGrapheme reports ErrEndOfFile at EOF"
        IF atEnd() THEN
          expectTrap(rdGrapheme(), errorCode::ErrEndOfFile)
        END IF
        expectEqual(TRUE, TRUE)
      END TCASE
      TCASE "readKey reports ErrEndOfFile at EOF"
        IF atEnd() THEN
          expectTrap(rdKey(), errorCode::ErrEndOfFile)
        END IF
        expectEqual(TRUE, TRUE)
      END TCASE
      TCASE "input (promptless) reports ErrEndOfFile at EOF"
        IF atEnd() THEN
          expectTrap(rdInput(), errorCode::ErrEndOfFile)
        END IF
        expectEqual(TRUE, TRUE)
      END TCASE
      TCASE "input (with prompt) reports ErrEndOfFile at EOF"
        IF atEnd() THEN
          expectTrap(rdInputPrompt(), errorCode::ErrEndOfFile)
        END IF
        expectEqual(TRUE, TRUE)
      END TCASE
    END TGROUP
  END TGROUP
END TESTING
