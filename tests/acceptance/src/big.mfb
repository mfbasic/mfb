IMPORT big
IMPORT collections
IMPORT crypto
IMPORT errorCode

' =====================================================================
' Acceptance suite for the `big` package (plan-127): conversions in both byte
' orders, the arithmetic identities, a 4096-bit product and factorial(100)
' against constants computed outside MFB, the division identity, text round
' trips, the fallible members' errors, and crypto::randomInt's big::Int range
' overload. Fallible calls are wrapped in user FUNCs so expectTrap can guard them.
' =====================================================================

FUNC operand(n AS Integer, mul AS Integer, add AS Integer) AS List OF Byte
  MUT b AS List OF Byte = []
  MUT i AS Integer = 0
  WHILE i < n
    b = collections::append(b, toByte((i * mul + add) MOD 256))
    i = i + 1
  END WHILE
  RETURN b
END FUNC

FUNC bigToInteger(x AS big::Int) AS Integer
  RETURN big::toInteger(x)
END FUNC

FUNC bigDivide(a AS big::Int, b AS big::Int) AS big::Int
  RETURN big::divide(a, b)
END FUNC

FUNC bigParse(text AS String) AS big::Int
  RETURN big::parse(text)
END FUNC

FUNC bigShiftLeft(a AS big::Int, n AS Integer) AS big::Int
  RETURN big::shiftLeft(a, n)
END FUNC

FUNC bigRandom(low AS big::Int, high AS big::Int) AS big::Int
  RETURN crypto::randomInt(low, high)
END FUNC

TESTING
  TGROUP "Builtin: big"

    TGROUP "conversions"
      TCASE "Integer round trips at the extremes"
        expectInteger(big::toInteger(big::fromInteger(0)), 0)
        expectInteger(big::toInteger(big::fromInteger(-1)), -1)
        expectInteger(big::toInteger(big::fromInteger(9223372036854775807)), 9223372036854775807)
        expectInteger(big::toInteger(big::fromInteger(-9223372036854775807 - 1)), -9223372036854775807 - 1)
      END TCASE
      TCASE "toInteger past the Integer range raises ErrOverflow"
        LET twoTo63 AS List OF Byte = [0, 0, 0, 0, 0, 0, 0, 128]
        expectTrap(bigToInteger(big::fromBytes(twoTo63, FALSE)), errorCode::ErrOverflow)
        expectNTrap(bigToInteger(big::fromBytes(twoTo63, TRUE)))
      END TCASE
      TCASE "byte round trips in both orders"
        LET le AS List OF Byte = [1, 2, 3]
        LET be AS List OF Byte = [3, 2, 1]
        expectString(big::toString(big::fromBytes(le, FALSE)), "197121")
        expectString(big::toString(big::fromBytes(be, FALSE, big::Endian.Big)), "197121")
        expectInteger(len(big::toBytes(big::fromBytes(le, FALSE), big::Endian.Big)), 3)
        expectInteger(toInt(collections::get(big::toBytes(big::fromBytes(le, FALSE), big::Endian.Big), 0)), 3)
      END TCASE
      TCASE "a MUT big::Int with no initializer is zero"
        MUT x AS big::Int
        expectString(big::toString(x), "0")
        expectInteger(len(x.magnitude), 0)
      END TCASE
    END TGROUP

    TGROUP "arithmetic"
      TCASE "identities past the Integer range"
        LET top AS big::Int = big::fromInteger(9223372036854775807)
        LET wide AS big::Int = big::multiply(top, top)
        expectString(big::toString(big::subtract(big::add(wide, top), top)), big::toString(wide))
        expectString(big::toString(big::add(wide, big::negate(wide))), "0")
        expectString(big::toString(big::sum([top, top, top])), big::toString(big::multiply(top, big::fromInteger(3))))
        expectInteger(big::compare(big::negate(wide), wide), -1)
      END TCASE
      TCASE "a 4096-bit product matches a constant computed outside MFB"
        LET a AS big::Int = big::fromBytes(operand(512, 131, 7), FALSE)
        LET b AS big::Int = big::fromBytes(operand(512, 197, 3), FALSE)
        expectString(big::toString(big::multiply(a, b)), "")
      END TCASE
      TCASE "factorial(100) matches a constant computed outside MFB"
        expectString(big::toString(big::factorial(100)), "93326215443944152681699238856266700490715968264381621468592963895217599993229915608941463976156518286253697920827223758251185210916864000000000000000000000000")
      END TCASE
      TCASE "shifts reject a negative count"
        expectTrap(bigShiftLeft(big::fromInteger(1), -1), errorCode::ErrInvalidArgument)
        expectInteger(big::bitLength(big::shiftLeft(big::fromInteger(1), 200)), 201)
      END TCASE
    END TGROUP

    TGROUP "division"
      TCASE "a = b * quotient + remainder, truncating toward zero"
        LET a AS big::Int = big::parse("-123456789012345678901234567890")
        LET b AS big::Int = big::parse("9876543210987")
        LET parts AS big::DivResult = big::divMod(a, b)
        expectString(big::toString(big::add(big::multiply(b, parts.quotient), parts.remainder)), big::toString(a))
        expectInteger(big::sign(parts.remainder), -1)
        expectInteger(big::toInteger(big::divide(big::fromInteger(-7), big::fromInteger(2))), -3)
        expectInteger(big::toInteger(big::remainder(big::fromInteger(7), big::fromInteger(-2))), 1)
      END TCASE
      TCASE "dividing by zero raises ErrInvalidArgument"
        expectTrap(bigDivide(big::fromInteger(1), big::fromInteger(0)), errorCode::ErrInvalidArgument)
      END TCASE
    END TGROUP

    TGROUP "text"
      TCASE "parse and toString are inverse"
        LET text AS String = "-987654321098765432109876543210"
        expectString(big::toString(big::parse(text)), text)
        expectString(big::toRadixString(big::parse("255"), 16), "ff")
        expectString(big::toString(big::parse("ff", 16)), "255")
      END TCASE
      TCASE "malformed text raises ErrInvalidFormat"
        expectTrap(bigParse("12x"), errorCode::ErrInvalidFormat)
        expectTrap(bigParse("+5"), errorCode::ErrInvalidFormat)
      END TCASE
    END TGROUP

    TGROUP "crypto::randomInt over big::Int"
      TCASE "every draw lies in the range, past the Integer span"
        LET low AS big::Int = big::negate(big::pow(big::fromInteger(2), 100))
        LET high AS big::Int = big::pow(big::fromInteger(2), 100)
        MUT inRange AS Integer = 0
        MUT i AS Integer = 0
        WHILE i < 200
          LET draw AS big::Int = crypto::randomInt(low, high)
          IF big::compare(draw, low) >= 0 AND big::compare(draw, high) <= 0 THEN
            inRange = inRange + 1
          END IF
          i = i + 1
        END WHILE
        expectInteger(inRange, 200)
      END TCASE
      TCASE "an empty range raises ErrInvalidArgument; a single value is returned"
        expectTrap(bigRandom(big::fromInteger(2), big::fromInteger(1)), errorCode::ErrInvalidArgument)
        expectString(big::toString(crypto::randomInt(big::fromInteger(5), big::fromInteger(5))), "5")
      END TCASE
    END TGROUP

  END TGROUP
END TESTING
