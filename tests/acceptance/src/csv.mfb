IMPORT csv
IMPORT fs
IMPORT collections
IMPORT strings
IMPORT errorCode

' =============================================================================
' Full acceptance + security suite for the `csv` import.
'
' Covers all three members (parse — String and File —, stringify, readRow) with
' multiple cases each: RFC-4180 quoting rules, CR/LF/CRLF separators,
' empty/blank/ragged rows, custom delimiter/quote/newline dialects, Unicode, the
' streaming reader's record-at-a-time and end-of-file contract (bug-809), and
' every error path — a malformed quote and an empty delimiter/quote on parse,
' readRow, AND stringify (ErrInvalidFormat), and reading past the last record
' (ErrEndOfFile). Expected values were determined independently by probing the
' documented semantics, not harvested to "just pass".
'
' csv::parse is inline-lowered, so it is wrapped in a user FUNC to be
' trap-guardable; the other members are source-backed and trap directly.
' =============================================================================

FUNC crChar AS String
  RETURN "\r"
END FUNC

FUNC parse(text AS String) AS List OF List OF String
  RETURN csv::parse(text)
END FUNC

FUNC parseD(text AS String, delim AS String) AS List OF List OF String
  RETURN csv::parse(text, delim)
END FUNC

FUNC parseDQ(text AS String, delim AS String, quote AS String) AS List OF List OF String
  RETURN csv::parse(text, delim, quote)
END FUNC

' Read exactly one record from an in-memory file of `text` (used to trap
' malformed input and the end of input).
FUNC readFirst(text AS String) AS Integer
  RES f = fs::openData(text, "r")
  RETURN len(csv::readRow(f))
END FUNC

FUNC readFirstDQ(text AS String, delim AS String, quote AS String) AS Integer
  RES f = fs::openData(text, "r")
  RETURN len(csv::readRow(f, delim, quote))
END FUNC

' The second record of `text`, or a trap.
FUNC readSecond(text AS String) AS Integer
  RES f = fs::openData(text, "r")
  LET first AS List OF String = csv::readRow(f)
  RETURN len(csv::readRow(f))
END FUNC

' csv::parse over an in-memory file of `text`.
FUNC parseFile(text AS String) AS List OF List OF String
  RES f = fs::openData(text, "r")
  RETURN csv::parse(f)
END FUNC

' cell(rows, r, c) — the c-th field of the r-th row.
FUNC cell(rows AS List OF List OF String, r AS Integer, c AS Integer) AS String
  RETURN collections::get(collections::get(rows, r), c)
END FUNC

TESTING
  TGROUP "Builtin: csv"

    ' -----------------------------------------------------------------------
    TGROUP "parse"
      TCASE "basic grid"
        LET rows AS List OF List OF String = parse("a,b,c\n1,2,3")
        expectInteger(len(rows), 2)
        expectInteger(len(collections::get(rows, 0)), 3)
        expectString(cell(rows, 0, 0), "a")
        expectString(cell(rows, 0, 2), "c")
        expectString(cell(rows, 1, 1), "2")
      END TCASE
      TCASE "CRLF and LF separators; quoted comma cell"
        LET cr AS String = crChar()
        LET rows AS List OF List OF String = parse("name,age" & cr & "\nAda,36\nGrace,\"Hop,per\"\n")
        expectInteger(len(rows), 3)
        expectString(cell(rows, 0, 0), "name")
        expectString(cell(rows, 1, 0), "Ada")
        expectString(cell(rows, 2, 1), "Hop,per")
      END TCASE
      TCASE "quoted: embedded LF, embedded comma, doubled quote"
        LET rows AS List OF List OF String = parse("\"a\nb\",\"x,y\",\"he said \"\"hi\"\"\"")
        expectInteger(len(rows), 1)
        expectInteger(len(collections::get(rows, 0)), 3)
        expectString(cell(rows, 0, 0), "a\nb")
        expectInteger(strings::byteLen(cell(rows, 0, 0)), 3)
        expectString(cell(rows, 0, 1), "x,y")
        expectString(cell(rows, 0, 2), "he said \"hi\"")
        expectInteger(strings::byteLen(cell(rows, 0, 2)), 12)
      END TCASE
      TCASE "bare CR (not before LF) is ordinary data"
        LET cr AS String = crChar()
        LET rows AS List OF List OF String = parse("a" & cr & "b")
        expectInteger(len(rows), 1)
        expectInteger(len(collections::get(rows, 0)), 1)
        expectInteger(strings::byteLen(cell(rows, 0, 0)), 3)
      END TCASE
      TCASE "mid-field quote is ordinary data, not an opening quote"
        LET rows AS List OF List OF String = parse("a\"b,c")
        expectInteger(len(collections::get(rows, 0)), 2)
        expectString(cell(rows, 0, 0), "a\"b")
        expectString(cell(rows, 0, 1), "c")
      END TCASE
      TCASE "quoted-empty field and a lone escaped quote"
        LET rows AS List OF List OF String = parse("\"\",x")
        expectString(cell(rows, 0, 0), "")
        expectString(cell(rows, 0, 1), "x")
        LET only AS List OF List OF String = parse("\"\"\"\"")
        expectString(cell(only, 0, 0), "\"")
        expectInteger(strings::byteLen(cell(only, 0, 0)), 1)
      END TCASE
      TCASE "empty fields, blank middle line, ragged widths"
        LET rows AS List OF List OF String = parse("a,,c\n\nz")
        expectInteger(len(rows), 3)
        expectString(cell(rows, 0, 1), "")
        expectInteger(len(collections::get(rows, 1)), 1)
        expectString(cell(rows, 1, 0), "")
        expectString(cell(rows, 2, 0), "z")
      END TCASE
      TCASE "trailing separator does not add a row; double separator does"
        expectInteger(len(parse("a\nb\n")), 2)
        expectInteger(len(parse("a\n\nb")), 3)
        expectInteger(len(parse("")), 0)
      END TCASE
      TCASE "whitespace is significant and never trimmed"
        LET rows AS List OF List OF String = parse(" a , b ")
        expectString(cell(rows, 0, 0), " a ")
        expectString(cell(rows, 0, 1), " b ")
      END TCASE
      TCASE "Unicode scalars are preserved"
        LET rows AS List OF List OF String = parse("café,x")
        expectString(cell(rows, 0, 0), "café")
        expectInteger(strings::byteLen(cell(rows, 0, 0)), 5)
      END TCASE
      TCASE "custom delimiter, custom quote, tab delimiter"
        LET semi AS List OF List OF String = parseD("a;b;c", ";")
        expectInteger(len(collections::get(semi, 0)), 3)
        expectString(cell(semi, 0, 1), "b")
        LET sq AS List OF List OF String = parseDQ("'a,b',c", ",", "'")
        expectString(cell(sq, 0, 0), "a,b")
        expectString(cell(sq, 0, 1), "c")
        LET tab AS List OF List OF String = parseD("a\tb", "\t")
        expectInteger(len(collections::get(tab, 0)), 2)
      END TCASE
      TCASE "multi-character delimiter uses only the first scalar"
        LET rows AS List OF List OF String = parseD("a,b", ",;")
        expectInteger(len(collections::get(rows, 0)), 2)
        expectString(cell(rows, 0, 0), "a")
      END TCASE
      TCASE "security: malformed input raises ErrInvalidFormat"
        expectTrap(parse("\"abc"), errorCode::ErrInvalidFormat)
        expectTrap(parse("\"ab\"c"), errorCode::ErrInvalidFormat)
        expectTrap(parse("\"ab\" "), errorCode::ErrInvalidFormat)
      END TCASE
      TCASE "security: empty delimiter/quote raises ErrInvalidFormat"
        expectTrap(parseD("a,b", ""), errorCode::ErrInvalidFormat)
        expectTrap(parseDQ("a,b", ",", ""), errorCode::ErrInvalidFormat)
      END TCASE
      TCASE "well-formed input does not trap"
        expectNTrap(parse("a,b,c\n1,2,3\n"))
        expectNTrap(parseD("a|b", "|"))
      END TCASE
    END TGROUP

    ' -----------------------------------------------------------------------
    TGROUP "stringify"
      TCASE "bare fields are emitted unquoted"
        LET doc AS List OF List OF String = [["a", "b", "c"], ["1", "2", "3"]]
        expectString(csv::stringify(doc), "a,b,c\n1,2,3")
      END TCASE
      TCASE "quoting is forced by delimiter, quote, CR, or LF"
        expectString(csv::stringify([["has,comma", "plain"]]), "\"has,comma\",plain")
        expectString(csv::stringify([["he said \"hi\"", "x"]]), "\"he said \"\"hi\"\"\",x")
        expectString(csv::stringify([["line1\nline2", "y"]]), "\"line1\nline2\",y")
        LET cr AS String = crChar()
        expectString(csv::stringify([["a" & cr & "b"]]), "\"a" & cr & "b\"")
      END TCASE
      TCASE "ragged rows, empty document, empty rows"
        expectString(csv::stringify([["one"], ["a", "b"], []]), "one\na,b\n")
        LET empty AS List OF List OF String = []
        expectString(csv::stringify(empty), "")
        expectString(csv::stringify([[], []]), "\n")
      END TCASE
      TCASE "custom delimiter/quote/newline dialects"
        expectString(csv::stringify([["a;b", "c"]], ";"), "\"a;b\";c")
        expectString(csv::stringify([["a", "b"], ["c", "d"]], ",", "\"", "\r\n"), "a,b\r\nc,d")
        expectString(csv::stringify([["it's", "x"]], ",", "'"), "'it''s',x")
      END TCASE
      TCASE "round-trip: parse then stringify normalizes to LF"
        LET cr AS String = crChar()
        LET rows AS List OF List OF String = parse("name,age" & cr & "\nAda,36\nGrace,\"Hop,per\"\n")
        expectString(csv::stringify(rows), "name,age\nAda,36\nGrace,\"Hop,per\"")
      END TCASE
      TCASE "security: empty delimiter/quote raises ErrInvalidFormat"
        LET doc AS List OF List OF String = [["a", "b"]]
        expectTrap(csv::stringify(doc, ""), errorCode::ErrInvalidFormat)
        expectTrap(csv::stringify(doc, ",", ""), errorCode::ErrInvalidFormat)
      END TCASE
      TCASE "valid dialects do not trap"
        expectNTrap(csv::stringify([["a", "b"]], ";", "'"))
      END TCASE
    END TGROUP

    ' -----------------------------------------------------------------------
    TGROUP "readRow + parse(File)"
      TCASE "reads records in order and leaves the file at its end"
        RES f = fs::openData("a,b\nc,d", "r")
        LET first AS List OF String = csv::readRow(f)
        expectInteger(len(first), 2)
        expectString(collections::get(first, 0), "a")
        expectString(collections::get(first, 1), "b")
        expectEqual(fs::eof(f), FALSE)
        LET second AS List OF String = csv::readRow(f)
        expectString(collections::get(second, 0), "c")
        expectString(collections::get(second, 1), "d")
        expectEqual(fs::eof(f), TRUE)
      END TCASE
      TCASE "reading past the last record raises ErrEndOfFile"
        expectTrap(readSecond("a,b\n"), errorCode::ErrEndOfFile)
        expectTrap(readFirst(""), errorCode::ErrEndOfFile)
      END TCASE
      TCASE "streamed rows match parse (quoting, CRLF, ragged)"
        LET cr AS String = crChar()
        LET src AS String = "name,\"a,b\"" & cr & "\nx\n1,2,3"
        RES f = fs::openData(src, "r")
        LET r1 AS List OF String = csv::readRow(f)
        expectString(collections::get(r1, 1), "a,b")
        LET r2 AS List OF String = csv::readRow(f)
        expectInteger(len(r2), 1)
        expectString(collections::get(r2, 0), "x")
        LET r3 AS List OF String = csv::readRow(f)
        expectInteger(len(r3), 3)
        expectEqual(fs::eof(f), TRUE)
      END TCASE
      TCASE "a quoted field spanning lines keeps its line breaks exactly"
        LET cr AS String = crChar()
        RES f = fs::openData("\"one" & cr & "\ntwo\nthree\",x\nnext", "r")
        LET r1 AS List OF String = csv::readRow(f)
        expectInteger(len(r1), 2)
        expectString(collections::get(r1, 0), "one" & cr & "\ntwo\nthree")
        expectString(collections::get(r1, 1), "x")
        LET r2 AS List OF String = csv::readRow(f)
        expectString(collections::get(r2, 0), "next")
      END TCASE
      TCASE "custom delimiter dialect on readRow"
        RES f = fs::openData("a;b;c", "r")
        LET row AS List OF String = csv::readRow(f, ";")
        expectInteger(len(row), 3)
        expectString(collections::get(row, 2), "c")
      END TCASE
      TCASE "parse(File) reads from the current position to the end"
        RES f = fs::openData("h1,h2\n1,2\n3,4\n", "r")
        LET header AS List OF String = csv::readRow(f)
        expectString(collections::get(header, 1), "h2")
        LET rest AS List OF List OF String = csv::parse(f)
        expectInteger(len(rest), 2)
        expectString(cell(rest, 1, 0), "3")
        expectEqual(fs::eof(f), TRUE)
        expectInteger(len(parseFile("")), 0)
      END TCASE
      TCASE "parse(File) equals parse(String) on the same text"
        LET cr AS String = crChar()
        LET src AS String = "a,\"q\"\"x\"" & cr & "\n\n\"m\nl\",z\nlast," & cr
        LET fromText AS List OF List OF String = parse(src)
        LET fromFile AS List OF List OF String = parseFile(src)
        expectInteger(len(fromFile), len(fromText))
        expectString(cell(fromFile, 0, 1), cell(fromText, 0, 1))
        expectString(cell(fromFile, 2, 0), cell(fromText, 2, 0))
        expectString(cell(fromFile, 3, 1), cell(fromText, 3, 1))
      END TCASE
      TCASE "security: readRow on malformed input raises ErrInvalidFormat"
        expectTrap(readFirst("\"abc"), errorCode::ErrInvalidFormat)
        expectTrap(readFirst("\"ab\"c"), errorCode::ErrInvalidFormat)
        expectTrap(readFirst("\"open\nstill open"), errorCode::ErrInvalidFormat)
      END TCASE
      TCASE "security: readRow with an empty delimiter/quote raises ErrInvalidFormat"
        expectTrap(readFirstDQ("a,b", "", "\""), errorCode::ErrInvalidFormat)
        expectTrap(readFirstDQ("a,b", ",", ""), errorCode::ErrInvalidFormat)
      END TCASE
      TCASE "reading a valid record does not trap"
        expectNTrap(readFirst("a,b\nc,d"))
      END TCASE
    END TGROUP

  END TGROUP
END TESTING
