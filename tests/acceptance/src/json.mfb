IMPORT json
IMPORT strings
IMPORT collections
IMPORT errorCode

' =============================================================================
' Full acceptance + security suite for the `json` import.
'
' Covers all four members (parse, stringify, get, getOr) with multiple cases:
' every scalar and aggregate JSON form, number formatting, the full escape set,
' \uXXXX and surrogate pairs, duplicate keys, whitespace, complex nested
' documents, DEEP nesting up to the 257-frame limit (258 traps), and every error
' path (parse -> ErrInvalidFormat for a grammar mistake, ErrInvalidSurrogate for
' an unpaired \u escape, ErrDepthExceeded past the nesting cap, and toFloat's own
' code for an out-of-range number; get -> ErrNotFound). Expected values were
' determined by probing the documented semantics against an independent mental
' model of JSON/RFC-8259, not harvested to "just pass".
'
' parse/get are wrapped so expectTrap can guard them; stringify/getOr are total.
' =============================================================================

' Round-trip: parse then re-serialize (canonical compact form).
FUNC pv(text AS String) AS String
  RETURN json::stringify(json::parse(text))
END FUNC

' Navigate and serialize (fallible: the get path may miss).
FUNC getStr(value AS json::Json, path AS List OF String) AS String
  RETURN json::stringify(json::get(value, path))
END FUNC

' Byte length of a parsed JSON string scalar (-1 if not a string).
FUNC strLen(value AS json::Json) AS Integer
  MATCH value
    CASE json::JsonStr(s)
      RETURN strings::byteLen(s.value)
    CASE ELSE
      RETURN 0 - 1
  END MATCH
END FUNC

FUNC controlChar(value AS Integer) AS String
  LET bytes AS List OF Byte = [toByte(value)]
  RETURN toString(bytes)
END FUNC

FUNC backspaceChar AS String
  LET bytes AS List OF Byte = [toByte(8)]
  RETURN toString(bytes)
END FUNC

FUNC formfeedChar AS String
  LET bytes AS List OF Byte = [toByte(12)]
  RETURN toString(bytes)
END FUNC

FUNC controlChars(value AS Integer) AS String
  IF value >= 32 THEN
    RETURN ""
  END IF
  RETURN controlChar(value) & controlChars(value + 1)
END FUNC

' An array nested `d` deep: "[" * d & "]" * d.
FUNC nestedArray(d AS Integer) AS String
  MUT o AS String = ""
  MUT c AS String = ""
  MUT i AS Integer = 0
  WHILE i < d
    o = o & "["
    c = c & "]"
    i = i + 1
  END WHILE
  RETURN o & c
END FUNC

' A parseable object nested `d` deep: {"k":{"k":...1...}}.
FUNC nestedObject(d AS Integer) AS String
  MUT o AS String = ""
  MUT c AS String = ""
  MUT i AS Integer = 0
  WHILE i < d
    o = o & "{\"k\":"
    c = "}" & c
    i = i + 1
  END WHILE
  RETURN o & "1" & c
END FUNC

TESTING
  TGROUP "Builtin: json"

    ' -----------------------------------------------------------------------
    TGROUP "parse — scalars and numbers"
      TCASE "literals"
        expectString(pv(" null "), "null")
        expectString(pv("true"), "true")
        expectString(pv("false"), "false")
      END TCASE
      TCASE "number formatting"
        expectString(pv("0"), "0")
        ' plan-120-C: `-0` serializes as `0`, matching JSON.stringify. The pin
        ' flipped deliberately; the value still PARSES to a negative zero, it is
        ' only the JSON rendering that drops the sign.
        expectString(pv("-0"), "0")
        ' The round trip still holds under IEEE equality: re-parsing `0` yields a
        ' value equal to -0.0, so the integer branch is what returned it.
        expectString(pv("-0.0"), "0")
        expectString(pv("1"), "1")
        expectString(pv("-1"), "-1")
        expectString(pv("1.5"), "1.5")
        expectString(pv("-12.5"), "-12.5")
        expectString(pv("0.5"), "0.5")
        expectString(pv("1.0"), "1")
        expectString(pv("100"), "100")
        expectString(pv("1e10"), "10000000000")
        expectString(pv("1.0e2"), "100")
        expectString(pv("-12.5e+2"), "-1250")
      END TCASE
      TCASE "named argument"
        expectString(json::stringify(json::parse(value := "{\"named\":true}")), "{\"named\":true}")
      END TCASE
    END TGROUP

    ' -----------------------------------------------------------------------
    TGROUP "parse — strings, escapes, Unicode"
      TCASE "simple and empty strings"
        expectString(pv("\"hi\""), "\"hi\"")
        expectString(pv("\"\""), "\"\"")
      END TCASE
      TCASE "escape sequences round-trip"
        expectString(pv("\"\\n\""), "\"\\n\"")
        expectString(pv("\"\\t\""), "\"\\t\"")
        expectString(pv("\"\\b\""), "\"\\b\"")
        expectString(pv("\"\\f\""), "\"\\f\"")
        expectString(pv("\"\\r\""), "\"\\r\"")
        ' plan-120-C: `\/` is still ACCEPTED on input (it is valid JSON), but is
        ' no longer EMITTED — the slash comes back literal, as every other JSON
        ' writer produces it. This pin flipped deliberately.
        expectString(pv("\"a\\/b\""), "\"a/b\"")
        ' A literal slash in, a literal slash out.
        expectString(pv("\"a/b\""), "\"a/b\"")
        expectString(pv("\"\\\"\\\\\""), "\"\\\"\\\\\"")
      END TCASE
      TCASE "\\uXXXX and surrogate pairs decode to UTF-8"
        expectString(pv("\"\\u0041\""), "\"A\"")
        expectString(pv("\"\\u00e9\""), "\"é\"")
        expectString(pv("\"\\u0041\\uD83D\\uDE00\""), "\"A😀\"")
        expectInteger(strLen(json::parse("\"\\uD83D\\uDE00\"")), 4)
        expectInteger(strLen(json::parse("\"é\"")), 2)
      END TCASE
      TCASE "control-char escapes decode to single bytes"
        expectInteger(strLen(json::parse("\"\\u0000\"")), 1)
        expectInteger(strLen(json::parse("\"\\u001F\"")), 1)
        expectInteger(strLen(json::parse("\"\\u0009\"")), 1)
      END TCASE
    END TGROUP

    ' -----------------------------------------------------------------------
    TGROUP "parse — aggregates"
      TCASE "empty and flat"
        expectString(pv("[]"), "[]")
        expectString(pv("{}"), "{}")
        expectString(pv("[1,2,3]"), "[1,2,3]")
        expectString(pv("[true,false,null,{\"x\":\"y\"}]"), "[true,false,null,{\"x\":\"y\"}]")
      END TCASE
      TCASE "object key order preserved; duplicate keys keep the last"
        expectString(pv("{\"a\":1,\"b\":2,\"c\":3}"), "{\"a\":1,\"b\":2,\"c\":3}")
        expectString(pv("{\"a\":1,\"a\":2}"), "{\"a\":2}")
      END TCASE
      TCASE "whitespace is allowed around and between tokens"
        expectString(pv(" \n\t [ 1 , 2 ] \n "), "[1,2]")
        expectString(pv("{ \"a\" : 1 }"), "{\"a\":1}")
      END TCASE
    END TGROUP

    ' -----------------------------------------------------------------------
    TGROUP "parse — security: malformed input traps ErrInvalidFormat"
      TCASE "structural errors"
        expectTrap(pv(""), errorCode::ErrInvalidFormat)
        expectTrap(pv("true false"), errorCode::ErrInvalidFormat)
        expectTrap(pv("[1] x"), errorCode::ErrInvalidFormat)
        expectTrap(pv("1 2"), errorCode::ErrInvalidFormat)
        expectTrap(pv("[1,2,]"), errorCode::ErrInvalidFormat)
        expectTrap(pv("{\"a\":1,}"), errorCode::ErrInvalidFormat)
        expectTrap(pv("[1,2"), errorCode::ErrInvalidFormat)
        expectTrap(pv("{\"a\":1"), errorCode::ErrInvalidFormat)
      END TCASE
      TCASE "number and literal errors"
        expectTrap(pv("01"), errorCode::ErrInvalidFormat)
        expectTrap(pv("+1"), errorCode::ErrInvalidFormat)
        expectTrap(pv("0x1F"), errorCode::ErrInvalidFormat)
        expectTrap(pv("tru"), errorCode::ErrInvalidFormat)
        expectTrap(pv("nul"), errorCode::ErrInvalidFormat)
      END TCASE
      TCASE "string errors: unterminated, raw controls, bad escape"
        expectTrap(pv("\"abc"), errorCode::ErrInvalidFormat)
        expectTrap(pv("'a'"), errorCode::ErrInvalidFormat)
        expectTrap(pv("\"\\x\""), errorCode::ErrInvalidFormat)
        expectTrap(pv("\"" & controlChar(0) & "\""), errorCode::ErrInvalidFormat)
        expectTrap(pv("\"" & controlChar(31) & "\""), errorCode::ErrInvalidFormat)
        expectTrap(pv("\"" & "\n" & "\""), errorCode::ErrInvalidFormat)
        expectTrap(pv("\"" & "\t" & "\""), errorCode::ErrInvalidFormat)
      END TCASE
      ' plan-120-A: an unpaired surrogate escape is its own diagnosis. The escape
      ' is well-formed JSON grammar; what it names is not a Unicode scalar, and
      ' MFB strings are Unicode text. These cases used to expect ErrInvalidFormat
      ' — the inputs still fail, the CODE is what moved.
      TCASE "lone surrogate escapes are ErrInvalidSurrogate, not ErrInvalidFormat"
        expectTrap(pv("\"\\uD83D\""), errorCode::ErrInvalidSurrogate)
        expectTrap(pv("\"\\uD800\""), errorCode::ErrInvalidSurrogate)
        expectTrap(pv("\"\\uDC00\""), errorCode::ErrInvalidSurrogate)
        ' A high surrogate followed by a NON-surrogate escape is still unpaired.
        expectTrap(pv("\"\\uD800\\u0041\""), errorCode::ErrInvalidSurrogate)
        ' A high surrogate followed by a literal (unescaped) character, likewise.
        expectTrap(pv("\"\\uD800A\""), errorCode::ErrInvalidSurrogate)
        ' A well-formed pair is NOT an error: U+1F600.
        expectNTrap(pv("\"\\uD83D\\uDE00\""))
      END TCASE
      ' plan-120-A: a number outside Float's range is a RANGE verdict from
      ' `toFloat`, not a grammar mistake — `__json_toNumber` used to discard that
      ' verdict and re-raise the generic ErrInvalidFormat.
      TCASE "out-of-range numbers propagate toFloat's own code"
        expectTrap(pv("1e400"), errorCode::ErrOverflow)
        expectTrap(pv("-1e400"), errorCode::ErrOverflow)
        ' A malformed number is still a grammar mistake.
        expectTrap(pv("01"), errorCode::ErrInvalidFormat)
        expectTrap(pv("1e"), errorCode::ErrInvalidFormat)
      END TCASE
      TCASE "well-formed input does not trap"
        expectNTrap(pv("{\"a\":[1,2,{\"b\":null}]}"))
      END TCASE
    END TGROUP

    ' -----------------------------------------------------------------------
    TGROUP "stringify — every variant and the escape set"
      TCASE "member-type constructors"
        expectString(json::stringify(json::JsonNull[NOTHING]), "null")
        expectString(json::stringify(json::JsonBool[TRUE]), "true")
        expectString(json::stringify(json::JsonBool[FALSE]), "false")
        expectString(json::stringify(json::JsonNum[toFloat("-12.5")]), "-12.5")
        expectString(json::stringify(json::JsonNum[toFloat("1000000")]), "1000000")
        expectString(json::stringify(json::JsonStr["Ada"]), "\"Ada\"")
        expectString(json::stringify(json::JsonArr[[]]), "[]")
      END TCASE
      TCASE "nested arrays and objects"
        LET inner AS List OF json::Json = [json::JsonNum[toFloat("1")], json::JsonStr["x"], json::JsonBool[TRUE]]
        expectString(json::stringify(json::JsonArr[inner]), "[1,\"x\",true]")
        expectString(json::stringify(json::JsonObj[Map OF String TO json::Json { "name" := json::JsonStr["Ada"] }]), "{\"name\":\"Ada\"}")
      END TCASE
      TCASE "escape set: quote, backslash, slash, and the named controls"
        LET escaped AS String = "\"" & "\\" & "/" & "\n" & "\t" & "\r" & backspaceChar() & formfeedChar()
        ' plan-120-C: the `\/` run is gone from the middle; every OTHER escape in
        ' the set is unchanged, which is what makes this the right pin for
        ' "only the slash arm was removed".
        expectString(json::stringify(json::JsonStr[escaped]), "\"\\\"\\\\/\\n\\t\\r\\b\\f\"")
      END TCASE
      TCASE "all C0 control characters escape as named or \\uXXXX"
        expectString(json::stringify(json::JsonStr[controlChars(0)]), "\"\\u0000\\u0001\\u0002\\u0003\\u0004\\u0005\\u0006\\u0007\\b\\t\\n\\u000B\\f\\r\\u000E\\u000F\\u0010\\u0011\\u0012\\u0013\\u0014\\u0015\\u0016\\u0017\\u0018\\u0019\\u001A\\u001B\\u001C\\u001D\\u001E\\u001F\"")
      END TCASE
      TCASE "accepts a Json union value from parse"
        expectString(json::stringify(json::parse("[1,{\"a\":true}]")), "[1,{\"a\":true}]")
      END TCASE
    END TGROUP

    ' -----------------------------------------------------------------------
    TGROUP "get — path reads and ErrNotFound"
      TCASE "empty path and nested reads"
        LET v AS json::Json = json::parse("{\"user\":{\"name\":\"Ada\",\"meta\":{\"active\":true}},\"nothing\":null}")
        LET emptyPath AS List OF String = []
        expectString(json::stringify(json::get(v, emptyPath)), "{\"user\":{\"name\":\"Ada\",\"meta\":{\"active\":true}},\"nothing\":null}")
        expectString(getStr(v, ["user", "name"]), "\"Ada\"")
        expectString(getStr(v, ["user", "meta", "active"]), "true")
        expectString(getStr(v, ["nothing"]), "null")
      END TCASE
      TCASE "security: missing key raises ErrNotFound"
        LET v AS json::Json = json::parse("{\"user\":{\"name\":\"Ada\"},\"flag\":true}")
        expectTrap(getStr(v, ["missing"]), errorCode::ErrNotFound)
        expectTrap(getStr(v, ["user", "missing"]), errorCode::ErrNotFound)
      END TCASE
      TCASE "security: a step that finds nothing raises ErrNotFound"
        ' "x" is not an index, so an array rejects it exactly as it always did —
        ' plan-120-B made arrays traversable by INDEX, not by arbitrary token.
        expectTrap(getStr(json::parse("[1,2,3]"), ["x"]), errorCode::ErrNotFound)
        expectTrap(getStr(json::parse("\"hi\""), ["x"]), errorCode::ErrNotFound)
        expectTrap(getStr(json::parse("5"), ["x"]), errorCode::ErrNotFound)
        expectTrap(getStr(json::parse("true"), ["x"]), errorCode::ErrNotFound)
        expectTrap(getStr(json::parse("null"), ["x"]), errorCode::ErrNotFound)
        expectTrap(getStr(json::parse("{\"flag\":true}"), ["flag", "x"]), errorCode::ErrNotFound)
        ' A scalar never accepts an index either, however well spelled.
        expectTrap(getStr(json::parse("5"), ["0"]), errorCode::ErrNotFound)
        expectTrap(getStr(json::parse("\"hi\""), ["0"]), errorCode::ErrNotFound)
      END TCASE
      ' plan-120-B: array-index path steps. Before this, `json::get` on a
      ' `JsonArr` failed unconditionally, so every case below moves from
      ' ErrNotFound to a value — no pin is weakened, the surface is new.
      TCASE "array index steps select elements"
        LET v AS json::Json = json::parse("{\"items\":[10,20,30]}")
        expectString(getStr(v, ["items", "0"]), "10")
        expectString(getStr(v, ["items", "1"]), "20")
        expectString(getStr(v, ["items", "2"]), "30")
        ' Mixed key/index/key traversal in one path.
        LET m AS json::Json = json::parse("{\"items\":[{\"name\":\"a\"},{\"name\":\"b\"}]}")
        expectString(getStr(m, ["items", "1", "name"]), "\"b\"")
        expectString(getStr(m, ["items", "0"]), "{\"name\":\"a\"}")
        ' An index onto a nested array, and a bare (unwrapped) array root.
        expectString(getStr(json::parse("[[1,2],[3,4]]"), ["1", "0"]), "3")
        expectString(getStr(json::parse("[7]"), ["0"]), "7")
      END TCASE
      TCASE "array index out of range raises ErrNotFound"
        LET v AS json::Json = json::parse("{\"items\":[10,20]}")
        expectTrap(getStr(v, ["items", "2"]), errorCode::ErrNotFound)
        expectTrap(getStr(v, ["items", "99"]), errorCode::ErrNotFound)
        ' An empty array has no element 0.
        expectTrap(getStr(json::parse("[]"), ["0"]), errorCode::ErrNotFound)
      END TCASE
      TCASE "only the RFC 6901 spelling counts as an index"
        LET v AS json::Json = json::parse("{\"items\":[10,20]}")
        ' Leading zero, explicit sign, surrounding space, empty, non-decimal —
        ' none of these are index tokens, so on an array they find nothing.
        expectTrap(getStr(v, ["items", "01"]), errorCode::ErrNotFound)
        expectTrap(getStr(v, ["items", "+1"]), errorCode::ErrNotFound)
        expectTrap(getStr(v, ["items", "-1"]), errorCode::ErrNotFound)
        expectTrap(getStr(v, ["items", "1 "]), errorCode::ErrNotFound)
        expectTrap(getStr(v, ["items", " 1"]), errorCode::ErrNotFound)
        expectTrap(getStr(v, ["items", ""]), errorCode::ErrNotFound)
        expectTrap(getStr(v, ["items", "1.0"]), errorCode::ErrNotFound)
        expectTrap(getStr(v, ["items", "0x1"]), errorCode::ErrNotFound)
        ' A digit run too wide for an Integer must MISS, not overflow: the
        ' 19-digit token below would trap in toInt if it were converted.
        expectTrap(getStr(v, ["items", "9999999999999999999"]), errorCode::ErrNotFound)
        ' 18 digits IS converted, and is simply out of range.
        expectTrap(getStr(v, ["items", "999999999999999999"]), errorCode::ErrNotFound)
        ' A GRAPHEME that merely starts with a digit is not a digit. "1" plus
        ' U+0308 COMBINING DIAERESIS is one cluster that sorts inside ["0","9"]
        ' under lexicographic compare, so a range test wrongly accepts it and
        ' toInt then raises -- caught during plan-120-B, see Correction B-C5.
        expectTrap(getStr(v, ["items", "1\u{308}"]), errorCode::ErrNotFound)
        expectTrap(getStr(v, ["items", "11\u{308}"]), errorCode::ErrNotFound)
        ' Non-ASCII digits are not indexes either: fullwidth ONE and
        ' Arabic-Indic ONE both look like digits to a human, not to RFC 6901.
        expectTrap(getStr(v, ["items", "\u{FF11}"]), errorCode::ErrNotFound)
        expectTrap(getStr(v, ["items", "1\u{FF11}"]), errorCode::ErrNotFound)
        expectTrap(getStr(v, ["items", "1\u{661}"]), errorCode::ErrNotFound)
      END TCASE
      TCASE "the variant underfoot decides: a numeric token is still an object key"
        ' This is what makes the change backward-compatible — an object with
        ' digit-shaped keys reads them as keys, never as indexes.
        LET v AS json::Json = json::parse("{\"0\":\"zero\",\"1\":\"one\",\"01\":\"oh-one\"}")
        expectString(getStr(v, ["0"]), "\"zero\"")
        expectString(getStr(v, ["1"]), "\"one\"")
        expectString(getStr(v, ["01"]), "\"oh-one\"")
        ' And a key absent from that object is still just a miss.
        expectTrap(getStr(v, ["2"]), errorCode::ErrNotFound)
      END TCASE
    END TGROUP

    ' -----------------------------------------------------------------------
    TGROUP "getOr — total fallback"
      TCASE "returns value on a valid path; empty path returns the whole value"
        LET v AS json::Json = json::parse("{\"user\":{\"name\":\"Ada\"},\"flag\":true}")
        LET fb AS json::Json = json::JsonStr["fallback"]
        LET emptyPath AS List OF String = []
        expectString(json::stringify(json::getOr(v, emptyPath, fb)), "{\"user\":{\"name\":\"Ada\"},\"flag\":true}")
        expectString(json::stringify(json::getOr(v, ["user", "name"], fb)), "\"Ada\"")
      END TCASE
      TCASE "returns the default on missing key or non-object"
        LET v AS json::Json = json::parse("{\"user\":{\"name\":\"Ada\"},\"flag\":true}")
        LET fb AS json::Json = json::JsonStr["fallback"]
        expectString(json::stringify(json::getOr(v, ["missing"], fb)), "\"fallback\"")
        expectString(json::stringify(json::getOr(v, ["user", "missing"], fb)), "\"fallback\"")
        expectString(json::stringify(json::getOr(v, ["flag", "x"], fb)), "\"fallback\"")
        expectString(json::stringify(json::getOr(json::parse("[1,2]"), ["x"], json::JsonNull[NOTHING])), "null")
      END TCASE
      ' plan-120-B: getOr is get's contract with the FAIL replaced by the
      ' default, so every get case above has a twin here. The pairing is the
      ' review checklist for the two bodies staying parallel.
      TCASE "array index steps select elements (getOr)"
        LET v AS json::Json = json::parse("{\"items\":[10,20,30]}")
        LET fb AS json::Json = json::JsonStr["fallback"]
        expectString(json::stringify(json::getOr(v, ["items", "0"], fb)), "10")
        expectString(json::stringify(json::getOr(v, ["items", "2"], fb)), "30")
        LET m AS json::Json = json::parse("{\"items\":[{\"name\":\"a\"},{\"name\":\"b\"}]}")
        expectString(json::stringify(json::getOr(m, ["items", "1", "name"], fb)), "\"b\"")
        expectString(json::stringify(json::getOr(json::parse("[[1,2],[3,4]]"), ["1", "0"], fb)), "3")
      END TCASE
      TCASE "out-of-range and non-index tokens return the default, never fail"
        LET v AS json::Json = json::parse("{\"items\":[10,20]}")
        LET fb AS json::Json = json::JsonStr["fallback"]
        expectString(json::stringify(json::getOr(v, ["items", "2"], fb)), "\"fallback\"")
        expectString(json::stringify(json::getOr(v, ["items", "01"], fb)), "\"fallback\"")
        expectString(json::stringify(json::getOr(v, ["items", "+1"], fb)), "\"fallback\"")
        expectString(json::stringify(json::getOr(v, ["items", "-1"], fb)), "\"fallback\"")
        expectString(json::stringify(json::getOr(v, ["items", "1 "], fb)), "\"fallback\"")
        expectString(json::stringify(json::getOr(v, ["items", ""], fb)), "\"fallback\"")
        expectString(json::stringify(json::getOr(json::parse("[]"), ["0"], fb)), "\"fallback\"")
        ' The overflow guard matters most HERE: getOr must not fail, ever, so a
        ' 19-digit token has to miss rather than reach toInt.
        expectString(json::stringify(json::getOr(v, ["items", "9999999999999999999"], fb)), "\"fallback\"")
        expectNTrap(json::stringify(json::getOr(v, ["items", "9999999999999999999"], fb)))
        ' Same reason, for the combining-mark cluster: this FAILED with 77050003
        ' before Correction B-C5, which is a broken getOr contract, not a miss.
        expectString(json::stringify(json::getOr(v, ["items", "1\u{308}"], fb)), "\"fallback\"")
        expectNTrap(json::stringify(json::getOr(v, ["items", "1\u{308}"], fb)))
        expectString(json::stringify(json::getOr(v, ["items", "11\u{308}"], fb)), "\"fallback\"")
        expectNTrap(json::stringify(json::getOr(v, ["items", "11\u{308}"], fb)))
        expectNTrap(json::stringify(json::getOr(v, ["items", "1\u{FF11}"], fb)))
      END TCASE
      TCASE "a numeric token on an object is still a key (getOr)"
        LET v AS json::Json = json::parse("{\"0\":\"zero\",\"01\":\"oh-one\"}")
        LET fb AS json::Json = json::JsonStr["fallback"]
        expectString(json::stringify(json::getOr(v, ["0"], fb)), "\"zero\"")
        expectString(json::stringify(json::getOr(v, ["01"], fb)), "\"oh-one\"")
        expectString(json::stringify(json::getOr(v, ["2"], fb)), "\"fallback\"")
      END TCASE
    END TGROUP

    ' -----------------------------------------------------------------------
    ' plan-120-C promoted object member order from an observed accident to a
    ' pinned json-level contract. These cases are the TRIPWIRE: if the Map
    ' implementation ever reorders, they fail loudly and force the conversation,
    ' rather than silently changing every document MFB emits. The Map type's own
    ' contract is unchanged and still says implementation-defined.
    TGROUP "order — object members keep document order"
      TCASE "a parsed document re-serializes in its own order"
        ' Deliberately NOT the order JavaScript would produce: Node emits
        ' {"2":4,"10":3,"b":1,"a":2}, hoisting the integer-like keys and sorting
        ' them numerically. MFBASIC has no JS object semantics and keeps
        ' document order, which is the documented, permanent divergence.
        expectString(pv("{\"b\":1,\"a\":2,\"10\":3,\"2\":4}"), "{\"b\":1,\"a\":2,\"10\":3,\"2\":4}")
        ' Reverse alphabetical stays reverse alphabetical — not re-sorted.
        expectString(pv("{\"z\":1,\"y\":2,\"x\":3}"), "{\"z\":1,\"y\":2,\"x\":3}")
        ' Nested objects each keep their own order independently.
        expectString(pv("{\"b\":{\"d\":1,\"c\":2},\"a\":3}"), "{\"b\":{\"d\":1,\"c\":2},\"a\":3}")
      END TCASE
      TCASE "duplicate keys collapse last-wins, at the FIRST position"
        ' The surviving value is the last one, but it occupies the slot the key
        ' first appeared in — a consequence of insertion order that would be
        ' invisible without an explicit pin.
        expectString(pv("{\"a\":1,\"b\":2,\"a\":3}"), "{\"a\":3,\"b\":2}")
      END TCASE
    END TGROUP

    ' -----------------------------------------------------------------------
    TGROUP "complex — realistic nested document"
      TCASE "round-trip and multi-path navigation"
        LET doc AS json::Json = json::parse("{\"name\":\"Ada\",\"age\":36,\"tags\":[\"x\",\"y\"],\"nested\":{\"a\":{\"b\":{\"c\":42}}},\"items\":[{\"id\":1,\"ok\":true},{\"id\":2,\"ok\":false}],\"score\":9.5,\"note\":null,\"empty\":{},\"arr\":[]}")
        expectString(json::stringify(doc), "{\"name\":\"Ada\",\"age\":36,\"tags\":[\"x\",\"y\"],\"nested\":{\"a\":{\"b\":{\"c\":42}}},\"items\":[{\"id\":1,\"ok\":true},{\"id\":2,\"ok\":false}],\"score\":9.5,\"note\":null,\"empty\":{},\"arr\":[]}")
        expectString(getStr(doc, ["name"]), "\"Ada\"")
        expectString(getStr(doc, ["age"]), "36")
        expectString(getStr(doc, ["nested", "a", "b", "c"]), "42")
        expectString(getStr(doc, ["items"]), "[{\"id\":1,\"ok\":true},{\"id\":2,\"ok\":false}]")
        expectString(getStr(doc, ["score"]), "9.5")
        expectString(getStr(doc, ["note"]), "null")
        expectString(getStr(doc, ["empty"]), "{}")
        expectTrap(getStr(doc, ["items", "id"]), errorCode::ErrNotFound)
      END TCASE
    END TGROUP

    ' -----------------------------------------------------------------------
    ' Deep structural nesting. The parser's hard ceiling is 257 frames (258
    ' traps ErrDepthExceeded, plan-120-A) — but recursing to that limit needs more native
    ' stack than this shared runner has after its hundreds of earlier tests, so
    ' the exact over-limit trap is verified from a shallow main() in the csv/json
    ' smoke instead. Here the recursive parse+stringify is exercised at a
    ' comfortably deep 48 levels on both arrays and objects.
    TGROUP "deep — heavily nested documents"
      TCASE "deep arrays round-trip (48 levels)"
        expectString(json::stringify(json::parse(nestedArray(48))), nestedArray(48))
        expectNTrap(pv(nestedArray(48)))
      END TCASE
      TCASE "deep objects round-trip (48 levels)"
        expectNTrap(pv(nestedObject(48)))
        expectString(getStr(json::parse(nestedObject(4)), ["k", "k", "k", "k"]), "1")
      END TCASE
      TCASE "deep read reaches the innermost value"
        LET deep AS json::Json = json::parse("{\"a\":{\"a\":{\"a\":{\"a\":{\"a\":{\"a\":{\"a\":{\"a\":42}}}}}}}}")
        expectString(getStr(deep, ["a", "a", "a", "a", "a", "a", "a", "a"]), "42")
      END TCASE
    END TGROUP

  END TGROUP
END TESTING
