' bug-388: byte-identity coverage for a LINK wrapper that carries MULTIPLE
' CONST pins on abi-slots inside a function with an OUT CBuffer.
'
' The thunk generator materializes each CONST pin's immediate into its cslot
' word before the call, so a `BUFFER … SIZE` expression can read it. That
' materialization loop used to iterate the pin set as a `HashMap`, so the
' `move_immediate`/`store_u64` pair for each pin was emitted in per-process
' hash order — different `.ncode` bytes run-to-run whenever a single CBuffer
' function declared two or more matching pins (the bug-01 class, a second site
' bug-388 found). No existing fixture had >=2 CONST pins on one CBuffer
' function, so the site stayed latent; this fixture pins its `.ncode` so a
' regression re-flakes the sum.
'
'   ssize_t pread(int fd, void *buf, size_t nbyte, off_t offset);
'
' plan-112 added the third wrapper below. `SIZEOF <CStruct>` is the one unary
' operator with no other coverage anywhere in the corpus: it is LINK-only, and
' it folds to its integer during LINK lowering, so it reaches the `.ast` dump
' (as `"operator": "SIZEOF"`) and nothing after it. Before this fixture the
' `UnaryOp::SizeOf` variant round-tripped in unit tests and in no golden at all.
IMPORT io

TYPE PinnedInfo
  a AS Integer
  b AS Integer
  c AS Integer
  d AS Integer
  e AS Integer
END TYPE

LINK "c" AS libc
  ' `nbyte` and `offset` are BOTH abi-slots AND CONST pins, so both are
  ' materialized in the CBuffer size-staging loop. `SIZE nbyte` reads one of the
  ' pins, exercising the pin->cslot path the loop exists for.
  FUNC preadPinned(fd AS Integer) AS List OF Byte
    SYMBOL "pread"
    ABI (fd CInt32, buf OUT CBuffer, nbyte CInt64, offset CInt64) AS got CInt64
    BUFFER buf SIZE nbyte
    CONST nbyte = 16
    CONST offset = 0
    RETURN buf LENGTH got
  END FUNC

  ' A second CBuffer function with three pins raises the ordering entropy: 3!
  ' emission orders, so a HashMap-order regression is caught with near-certainty.
  FUNC preadTriple(fd AS Integer) AS List OF Byte
    SYMBOL "pread"
    ABI (fd CInt32, buf OUT CBuffer, nbyte CInt64, offset CInt64) AS got CInt64
    BUFFER buf SIZE nbyte + offset
    CONST fd = 3
    CONST nbyte = 24
    CONST offset = 8
    RETURN buf LENGTH got
  END FUNC
  ' plan-112: a CONST pin whose value is `SIZEOF <CStruct>` rather than a
  ' literal. Five CInt64 fields make the folded size 40 -- a value distinctive
  ' enough that it is visibly the fold, not a coincidence, in the `.ncode` dump.
  ' The pin is what makes the fold observable: `SIZEOF` is evaluated by
  ' `eval_link_const_opt`, so a regression there materializes a wrong immediate
  ' (or 0) into the cslot and flips this fixture's `.ncodesum`.
  CSTRUCT CPinnedInfo AS PinnedInfo
    a CInt64
    b CInt64
    c CInt64
    d CInt64
    e CInt64
  END CSTRUCT

  FUNC preadSizeof(fd AS Integer) AS List OF Byte
    SYMBOL "pread"
    ABI (fd CInt32, buf OUT CBuffer, nbyte CInt64, offset CInt64) AS got CInt64
    BUFFER buf SIZE nbyte
    CONST nbyte = SIZEOF CPinnedInfo
    CONST offset = 0
    RETURN buf LENGTH got
  END FUNC
END LINK

FUNC main() AS Integer
  LET a AS List OF Byte = libc::preadPinned(3)
  io::print(toString(len(a)))
  LET b AS List OF Byte = libc::preadTriple(0)
  io::print(toString(len(b)))
  LET c AS List OF Byte = libc::preadSizeof(0)
  io::print(toString(len(c)))
  RETURN 0
END FUNC
