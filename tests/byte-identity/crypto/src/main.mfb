' Byte-identity coverage for a backend that carried NO generated-code golden.\n' plan-57 rewrites the collection builders these helpers all construct their\n' List OF Byte / List OF String results through, and its acceptance is\n' artifact byte-identity — so each of these needs a .ncode golden or the gate is\n' blind to it. Goldens exist per target because several of these backends are\n' platform-specific (audio/alsa and tls/openssl are Linux-only).\n' Compile-only by design: these open devices and sockets that do not exist in a\n' test run, so there is no .run golden and the harness never executes them.\n
IMPORT io
IMPORT crypto

FUNC main() AS Integer
  LET b = crypto::randomBytes(32)
  io::print(toString(len(b)))

  ' Common typed inputs.
  LET msg = crypto::randomBytes(16)
  LET s = "the quick brown fox"

  ' Hashes — List OF Byte overload and String overload for each digest.
  io::print(toString(len(crypto::hash(crypto::Hash.SHA2_224, msg))))
  io::print(toString(len(crypto::hash(crypto::Hash.SHA2_224, s))))
  io::print(toString(len(crypto::hash(crypto::Hash.SHA2_256, msg))))
  io::print(toString(len(crypto::hash(crypto::Hash.SHA2_256, s))))
  io::print(toString(len(crypto::hash(crypto::Hash.SHA2_384, msg))))
  io::print(toString(len(crypto::hash(crypto::Hash.SHA2_384, s))))
  io::print(toString(len(crypto::hash(crypto::Hash.SHA2_512, msg))))
  io::print(toString(len(crypto::hash(crypto::Hash.SHA2_512, s))))
  io::print(toString(len(crypto::hash(crypto::Hash.SHA3_224, msg))))
  io::print(toString(len(crypto::hash(crypto::Hash.SHA3_224, s))))
  io::print(toString(len(crypto::hash(crypto::Hash.SHA3_256, msg))))
  io::print(toString(len(crypto::hash(crypto::Hash.SHA3_256, s))))
  io::print(toString(len(crypto::hash(crypto::Hash.SHA3_384, msg))))
  io::print(toString(len(crypto::hash(crypto::Hash.SHA3_384, s))))
  io::print(toString(len(crypto::hash(crypto::Hash.SHA3_512, msg))))
  io::print(toString(len(crypto::hash(crypto::Hash.SHA3_512, s))))
  ' SHA-1 is legacy: selecting it is the 2-203-0136 advisory warning (build.log).
  io::print(toString(len(crypto::hash(crypto::Hash.SHA1, msg))))
  io::print(toString(len(crypto::hash(crypto::Hash.SHA1, s))))

  ' SHAKE256 XOF — List OF Byte and String data overloads.
  io::print(toString(len(crypto::shake256(msg, 64))))
  io::print(toString(len(crypto::shake256(s, 64))))

  ' HMAC — List OF Byte data overload and String data overload.
  LET macKey = crypto::randomBytes(32)
  io::print(toString(len(crypto::hmac(crypto::Hash.SHA2_256, macKey, msg))))
  io::print(toString(len(crypto::hmac(crypto::Hash.SHA2_256, macKey, s))))
  io::print(toString(len(crypto::hmac(crypto::Hash.SHA2_512, macKey, msg))))
  io::print(toString(len(crypto::hmac(crypto::Hash.SHA2_512, macKey, s))))
  io::print(toString(len(crypto::hmac(crypto::Hash.SHA3_256, macKey, msg))))
  io::print(toString(len(crypto::hmac(crypto::Hash.SHA1, macKey, s))))

  ' HKDF — single overload each.
  LET salt = crypto::randomBytes(16)
  LET info = crypto::randomBytes(8)
  io::print(toString(len(crypto::hkdf(crypto::Hash.SHA2_256, msg, salt, info, 32))))
  io::print(toString(len(crypto::hkdf(crypto::Hash.SHA2_512, msg, salt, info, 64))))
  io::print(toString(len(crypto::hkdf(crypto::Hash.SHA3_512, msg, salt, info, 64))))

  ' PBKDF2 — single List OF Byte password overload each.
  io::print(toString(len(crypto::pbkdf2(crypto::Hash.SHA2_256, msg, salt, 1000, 32))))
  io::print(toString(len(crypto::pbkdf2(crypto::Hash.SHA2_512, msg, salt, 1000, 64))))
  io::print(toString(len(crypto::pbkdf2(crypto::Hash.SHA3_256, msg, salt, 10, 32))))

  ' AEAD — AES-256-GCM: 3-arg seal / 4-arg open and the aad overloads.
  LET aeadKey = crypto::randomBytes(32)
  LET nonce = crypto::randomBytes(12)
  LET aad = crypto::randomBytes(8)
  LET plaintext = crypto::randomBytes(24)

  LET gcmSealed = crypto::seal(crypto::SymmetricCipher.AES256GCM, aeadKey, nonce, plaintext)
  io::print(toString(len(gcmSealed.ciphertext)))
  io::print(toString(len(gcmSealed.tag)))
  io::print(toString(len(crypto::open(crypto::SymmetricCipher.AES256GCM, aeadKey, nonce, gcmSealed.ciphertext, gcmSealed.tag))))

  LET gcmSealedAad = crypto::seal(crypto::SymmetricCipher.AES256GCM, aeadKey, nonce, plaintext, aad)
  io::print(toString(len(crypto::open(crypto::SymmetricCipher.AES256GCM, aeadKey, nonce, gcmSealedAad.ciphertext, gcmSealedAad.tag, aad))))

  ' AEAD — ChaCha20-Poly1305: 3-arg seal / 4-arg open and the aad overloads.
  LET ccSealed = crypto::seal(crypto::SymmetricCipher.CHACHA20POLY1305, aeadKey, nonce, plaintext)
  io::print(toString(len(ccSealed.ciphertext)))
  io::print(toString(len(ccSealed.tag)))
  io::print(toString(len(crypto::open(crypto::SymmetricCipher.CHACHA20POLY1305, aeadKey, nonce, ccSealed.ciphertext, ccSealed.tag))))

  LET ccSealedAad = crypto::seal(crypto::SymmetricCipher.CHACHA20POLY1305, aeadKey, nonce, plaintext, aad)
  io::print(toString(len(crypto::open(crypto::SymmetricCipher.CHACHA20POLY1305, aeadKey, nonce, ccSealedAad.ciphertext, ccSealedAad.tag, aad))))

  ' Secure random and constant-time compare.
  io::print(toString(crypto::randomInt(1, 1000000)))
  io::print(crypto::uuid4())
  io::print(toString(crypto::constantTimeEqual(msg, msg)))

  ' Ed25519 — generate, sign, verify.
  LET edKeys = crypto::generate(crypto::Certificate.Ed25519)
  LET edSig = crypto::sign(crypto::Certificate.Ed25519, edKeys.privateKey, msg)
  io::print(toString(len(edSig)))
  io::print(toString(crypto::verify(crypto::Certificate.Ed25519, edKeys.publicKey, msg, edSig)))

  ' ECDSA P-256 — generate, sign, verify.
  LET p256Keys = crypto::generate(crypto::Certificate.P256)
  LET p256Sig = crypto::sign(crypto::Certificate.P256, p256Keys.privateKey, msg)
  io::print(toString(len(p256Sig)))
  io::print(toString(crypto::verify(crypto::Certificate.P256, p256Keys.publicKey, msg, p256Sig)))

  ' ECDSA P-384 — generate, sign, verify.
  LET p384Keys = crypto::generate(crypto::Certificate.P384)
  LET p384Sig = crypto::sign(crypto::Certificate.P384, p384Keys.privateKey, msg)
  io::print(toString(len(p384Sig)))
  io::print(toString(crypto::verify(crypto::Certificate.P384, p384Keys.publicKey, msg, p384Sig)))

  ' ECDSA P-521 — generate, sign, verify.
  LET p521Keys = crypto::generate(crypto::Certificate.P521)
  LET p521Sig = crypto::sign(crypto::Certificate.P521, p521Keys.privateKey, msg)
  io::print(toString(len(p521Sig)))
  io::print(toString(crypto::verify(crypto::Certificate.P521, p521Keys.publicKey, msg, p521Sig)))

  ' Ed448 — generate, sign, verify.
  LET ed448Keys = crypto::generate(crypto::Certificate.Ed448)
  LET ed448Sig = crypto::sign(crypto::Certificate.Ed448, ed448Keys.privateKey, msg)
  io::print(toString(len(ed448Sig)))
  io::print(toString(crypto::verify(crypto::Certificate.Ed448, ed448Keys.publicKey, msg, ed448Sig)))

  ' X25519 / X448 — generate, exchange (both curves), and the two key conversions.
  LET xKeys = crypto::generate(crypto::Certificate.X25519)
  LET xPeer = crypto::generate(crypto::Certificate.X25519)
  io::print(toString(len(crypto::exchange(crypto::Certificate.X25519, xKeys.privateKey, xPeer.publicKey))))
  LET x448Keys = crypto::generate(crypto::Certificate.X448)
  LET x448Peer = crypto::generate(crypto::Certificate.X448)
  io::print(toString(len(crypto::exchange(crypto::Certificate.X448, x448Keys.privateKey, x448Peer.publicKey))))
  LET edToX = crypto::convert(crypto::KeyConvert.Ed25519ToX25519, edKeys)
  io::print(toString(len(edToX.publicKey)))
  LET ed448ToX = crypto::convert(crypto::KeyConvert.Ed448ToX448, ed448Keys)
  io::print(toString(len(ed448ToX.publicKey)))

  ' HPKE — all four AsymmetricCipher profiles: List OF Byte / String data
  ' overloads and the aad overloads of encrypt; 3-arg / 4-arg decrypt.
  LET hpkeAes = crypto::encrypt(crypto::AsymmetricCipher.Ed25519_AES256GCM, edKeys.publicKey, plaintext)
  io::print(toString(len(crypto::decrypt(crypto::AsymmetricCipher.Ed25519_AES256GCM, edKeys.privateKey, hpkeAes))))
  LET hpkeChacha = crypto::encrypt(crypto::AsymmetricCipher.Ed25519_CHACHA20POLY1305, edKeys.publicKey, s, aad)
  io::print(toString(len(crypto::decrypt(crypto::AsymmetricCipher.Ed25519_CHACHA20POLY1305, edKeys.privateKey, hpkeChacha, aad))))
  LET hpke448Aes = crypto::encrypt(crypto::AsymmetricCipher.Ed448_AES256GCM, ed448Keys.publicKey, plaintext, aad)
  io::print(toString(len(crypto::decrypt(crypto::AsymmetricCipher.Ed448_AES256GCM, ed448Keys.privateKey, hpke448Aes, aad))))
  LET hpke448Chacha = crypto::encrypt(crypto::AsymmetricCipher.Ed448_CHACHA20POLY1305, ed448Keys.publicKey, s)
  io::print(toString(len(crypto::decrypt(crypto::AsymmetricCipher.Ed448_CHACHA20POLY1305, ed448Keys.privateKey, hpke448Chacha))))

  RETURN 0
END FUNC
