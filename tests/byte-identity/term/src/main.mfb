' bug-389 byte-identity codegen coverage for the term package.
' Compile-only by design: term drives a live full-screen TUI surface, which is
' irrelevant at compile time, so there is no .run golden and the harness never
' executes this — it exists only to give the term backend a .ncode golden.
IMPORT io
IMPORT term
IMPORT color

FUNC main() AS Integer
  ' Gate: enter and query TUI mode.
  term::on()
  LET on AS Boolean = term::isOn()
  io::print(toString(on))

  ' Cursor placement and visibility.
  term::moveTo(3, 7)
  term::hideCursor()
  term::showCursor()

  ' Colour setters (three Byte channels each).
  term::setForeground(color::rgb(255, 128, 0))
  term::setBackground(color::rgb(0, 64, 200))

  ' Attribute setters (Boolean).
  term::setBold(TRUE)
  term::setUnderline(FALSE)

  ' Colour getters (TermColor: three Byte fields r, g, b).
  LET fg AS color::Color = term::getForeground()
  io::print(toString(fg.red))
  io::print(toString(fg.green))
  io::print(toString(fg.blue))
  LET bg AS color::Color = term::getBackground()
  io::print(toString(bg.red))
  io::print(toString(bg.green))
  io::print(toString(bg.blue))

  ' Attribute getters (Boolean).
  LET bold AS Boolean = term::getBold()
  io::print(toString(bold))
  LET under AS Boolean = term::getUnderline()
  io::print(toString(under))

  ' Surface size (TermSize: two Integer fields columns, rows).
  LET size AS term::TermSize = term::terminalSize()
  io::print(toString(size.columns))
  io::print(toString(size.rows))

  ' plan-70-C: exercise the width- and cluster-aware draw helpers so their codegen
  ' (grapheme cluster walk, EGC pool, wide-trailing sentinel, paired-clear) gets
  ' cross-target .ncode coverage — a wide CJK run, a combining (NFD) cluster, a
  ' zero-width-joiner emoji family, a positioned wide glyph, and an overwrite that
  ' clears the orphaned half of a wide glyph.
  term::drawText(0, 0, "日本語")
  term::drawText(2, 0, "cafe" & "́")
  term::drawText(4, 0, "👨‍👩‍👧‍👦")
  term::drawGlyph(6, 10, 0x65E5)
  term::drawText(8, 0, "日本")
  term::drawText(8, 1, "X")

  ' The four box/fill drawing members. They were absent from this cover until the
  ' row/column coordinate migration, so their emitters — the only `term::` bodies
  ' that read a *pair* of coordinate argument registers per point, and the two
  ' (drawHLine/drawVLine) that share one emitter parameterised by orientation —
  ' had no cross-target `.ncode` sentinel at all.
  term::drawHLine(term::LineStyle.Light, 10, 0, 20)
  term::drawVLine(term::LineStyle.HeavyDash, 11, 4, 15)
  term::drawBox(term::LineStyle.Double, 12, 2, 16, 24)
  term::fillRect(term::FillStyle.Medium, 13, 6, 15, 18)

  ' Clear the surface and present the composed frame.
  term::clear()
  term::sync()

  ' Leave TUI mode.
  term::off()

  RETURN 0
END FUNC
