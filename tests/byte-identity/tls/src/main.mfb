' Byte-identity coverage for a backend that carried NO generated-code golden.\n' plan-57 rewrites the collection builders these helpers all construct their\n' List OF Byte / List OF String results through, and its acceptance is\n' artifact byte-identity — so each of these needs a .ncode golden or the gate is\n' blind to it. Goldens exist per target because several of these backends are\n' platform-specific (audio/alsa and tls/openssl are Linux-only).\n' Compile-only by design: these open devices and sockets that do not exist in a\n' test run, so there is no .run golden and the harness never executes them.\n
IMPORT io
IMPORT encoding
IMPORT tls

FUNC main() AS Integer
  ' connect: all three overloads
  RES sock AS tls::Socket = tls::connect("example.com", 443)
  RES sock2 AS tls::Socket = tls::connect("example.com", 443, 5000)
  RES sock3 AS tls::Socket = tls::connect("example.com", 443, 5000, "example.com")

  ' read / write (List OF Byte)
  LET got = tls::read(sock, 64)
  tls::write(sock, got)
  io::print(toString(len(got)))

  ' readText / writeText (String)
  LET txt = encoding::utf8Decode(tls::read(sock2, 4096))
  tls::write(sock2, txt)
  io::print(toString(len(txt)))
  tls::write(sock3, "GET / HTTP/1.0")

  ' poll: both overloads (plan-76-B readiness query)
  LET ready1 = tls::poll(sock)
  LET ready2 = tls::poll(sock2, 1000)
  io::print(toString(ready1) & toString(ready2))

  ' close: tls::Socket overload
  tls::close(sock)
  tls::close(sock2)
  tls::close(sock3)

  ' listen: both overloads
  RES server AS tls::Listener = tls::listen("", 8443, "cert.pem", "key.pem")
  RES server2 AS tls::Listener = tls::listen("", 8444, "cert.pem", "key.pem", 16)

  ' accept: both overloads
  RES client AS tls::Socket = tls::accept(server)
  RES client2 AS tls::Socket = tls::accept(server2, 5000)
  LET reply = encoding::utf8Decode(tls::read(client, 4096))
  io::print(toString(len(reply)))
  tls::write(client2, "hi")
  tls::close(client)
  tls::close(client2)

  ' close: tls::Listener overload
  tls::close(server)
  tls::close(server2)
  RETURN 0
END FUNC
