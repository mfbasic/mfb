' Byte-identity coverage for a backend that carried NO generated-code golden.\n' plan-57 rewrites the collection builders these helpers all construct their\n' List OF Byte / List OF String results through, and its acceptance is\n' artifact byte-identity — so each of these needs a .ncode golden or the gate is\n' blind to it. Goldens exist per target because several of these backends are\n' platform-specific (audio/alsa and tls/openssl are Linux-only).\n' Compile-only by design: these open devices and sockets that do not exist in a\n' test run, so there is no .run golden and the harness never executes them.\n
IMPORT io
IMPORT encoding
IMPORT net
IMPORT tls

FUNC main() AS Integer
  ' connect: all three overloads
  RES sock AS tls::Socket = tls::connect("example.com", 443)
  RES sock2 AS tls::Socket = tls::connect("example.com", 443, 5000)
  RES sock3 AS tls::Socket = tls::connect("example.com", 443, 5000, "example.com")

  ' bug-477: allowSelfSigned, in BOTH overloads and at BOTH values. A
  ' `codegen_cover` fixture that does not mention a member never hashes it
  ' (.ai/testing-gates.md), and the flag selects between two emitted code paths
  ' -- the strict one and the relaxed one -- so a fixture carrying only the
  ' default would leave the entire relaxed path outside the drift gate. The
  ' `net::Address` form is spelled out separately because the two overloads do
  ' not share a positional layout: `allowSelfSigned` is parameter 4 of the
  ' host/port form and parameter 3 of the Address form.
  RES sockStrict AS tls::Socket = tls::connect("example.com", 443, 5000, "example.com", FALSE)
  RES sockRelaxed AS tls::Socket = tls::connect("example.com", 443, 5000, "example.com", TRUE)
  LET peer AS net::Address = net::lookup("example.com", 443)
  RES sockAddr AS tls::Socket = tls::connect(peer, 5000, "example.com")
  RES sockAddrRelaxed AS tls::Socket = tls::connect(peer, 5000, "example.com", TRUE)
  tls::close(sockStrict)
  tls::close(sockRelaxed)
  tls::close(sockAddr)
  tls::close(sockAddrRelaxed)

  ' read / write (List OF Byte)
  LET got = tls::read(sock, 64)
  tls::write(sock, got)
  io::print(toString(len(got)))

  ' readText / writeText (String)
  LET txt = encoding::utf8Decode(tls::read(sock2, 4096))
  tls::write(sock2, txt)
  io::print(toString(len(txt)))
  tls::write(sock3, "GET / HTTP/1.0")

  ' poll: both overloads (plan-76-B readiness query)
  LET ready1 = tls::poll(sock)
  LET ready2 = tls::poll(sock2, 1000)
  io::print(toString(ready1) & toString(ready2))

  ' localAddress: the tls::Socket overload (the Listener one is below, after a
  ' listener exists). bug-465 added the second overload as a separate emitted
  ' body — `tls.localAddressListener` — so both need a sentinel here or the gate
  ' is blind to the very code that bug introduced.
  io::print(tls::localAddress(sock3).host)

  ' close: tls::Socket overload
  tls::close(sock)
  tls::close(sock2)
  tls::close(sock3)

  ' listen: both overloads
  RES server AS tls::Listener = tls::listen("", 8443, "cert.pem", "key.pem")
  RES server2 AS tls::Listener = tls::listen("", 8444, "cert.pem", "key.pem", 16)

  ' localAddress: the tls::Listener overload (bug-465). Distinct emitted body —
  ' on macOS a listener holds an nw_listener, which getsockname cannot see.
  io::print(tls::localAddress(server).host)

  ' accept: both overloads
  RES client AS tls::Socket = tls::accept(server)
  RES client2 AS tls::Socket = tls::accept(server2, 5000)
  LET reply = encoding::utf8Decode(tls::read(client, 4096))
  io::print(toString(len(reply)))
  tls::write(client2, "hi")
  tls::close(client)
  tls::close(client2)

  ' close: tls::Listener overload
  tls::close(server)
  tls::close(server2)
  RETURN 0
END FUNC
