' Byte-identity coverage for a backend that carried NO generated-code golden.\n' plan-57 rewrites the collection builders these helpers all construct their\n' List OF Byte / List OF String results through, and its acceptance is\n' artifact byte-identity — so each of these needs a .ncode golden or the gate is\n' blind to it. Goldens exist per target because several of these backends are\n' platform-specific (audio/alsa and tls/openssl are Linux-only).\n' Compile-only by design: these open devices and sockets that do not exist in a\n' test run, so there is no .run golden and the harness never executes them.\n
IMPORT collections
IMPORT io
IMPORT net

FUNC main() AS Integer
  ' plan-110-E: net's stream surface moved to `tcp`; its byte-identity coverage
  ' lives in tests/byte-identity/tcp. What net still generates code for is
  ' resolution (lookup, ping) and the URL/query helpers, all covered below.
  ' UDP moved to the `udp` package (plan-110-C); its coverage lives in
  ' tests/byte-identity/udp.

  ' lookup (host, port) overload.
  FOR EACH addr2 IN net::lookup("example.com", 80)
    io::print(toString(addr2.port))
  NEXT

  ' ping: both overloads and every arity, so the ICMP backend's codegen is gated
  ' on all five targets. Compile-only like the rest of this fixture — no packet is
  ' ever sent.
  LET p1 = net::ping("example.com")
  io::print(toString(p1.ttl))
  LET p2 = net::ping("example.com", 1000)
  io::print(toString(p2.size))
  LET p3 = net::ping("example.com", 1000, 32)
  io::print(toString(p3.rttMs))
  LET p4 = net::ping("example.com", 1000, 32, 128)
  io::print(p4.address.host)
  ' An Address to drive ping's Address overloads. It comes from `lookup` now --
  ' `net::localAddress` moved to `tcp` with the rest of the stream.
  LET locAddr = collections::get(net::lookup("example.com"), 0)
  LET p5 = net::ping(locAddr)
  io::print(toString(p5.ttl))
  LET p6 = net::ping(locAddr, 1000, 32, 128)
  io::print(toString(p6.size))

  ' URL and query string helpers.
  LET url = net::toUrl("http://user:pass@example.com:8080/a/b?x=1#frag")
  io::print(url.host)
  io::print(toString(url.port))
  io::print(toString(url))
  LET query = net::parseQuery("a=1&b=2")
  io::print(toString(len(query)))
  LET decoded = net::percentDecode("a%20b")
  io::print(decoded)

  ' net::close moved to tcp::close with the rest of the stream surface.

  RETURN 0
END FUNC
