' bug-389 byte-identity codegen-coverage fixture for the json package.
' Compile-only: exercises every json function and overload; never executed.
IMPORT io
IMPORT json

FUNC main() AS Integer
  ' json::parse — positional String, and by-name text.
  LET doc AS json::Json = json::parse("{\"a\":[1,2,3]}")
  LET doc2 AS json::Json = json::parse(text := "{\"a\":[1,2,3]}")

  ' json::stringify — the Json union and each of its six member types directly.
  LET s1 AS String = json::stringify(doc)
  LET s2 AS String = json::stringify(JsonNull[NOTHING])
  LET s3 AS String = json::stringify(JsonBool[TRUE])
  LET s4 AS String = json::stringify(JsonNum[42.0])
  LET s5 AS String = json::stringify(JsonStr["hi"])
  LET items AS List OF json::Json = [JsonNum[1.0], JsonNum[2.0]]
  LET s6 AS String = json::stringify(JsonArr[items])

  ' json::get — empty path, single key, multi-key path, and by-name key.
  LET empty AS List OF String = []
  LET g1 AS json::Json = json::get(doc, empty)
  LET g2 AS json::Json = json::get(doc, ["a"])
  LET g3 AS json::Json = json::get(doc2, key := ["a"])

  ' json::getOr — positional default, by-name default, and by-name fallback.
  LET o1 AS json::Json = json::getOr(doc, ["a"], JsonNull[NOTHING])
  LET o2 AS json::Json = json::getOr(doc, key := ["missing"], default := JsonBool[FALSE])
  LET o3 AS json::Json = json::getOr(doc, ["x"], fallback := JsonNum[0.0])

  ' Consume every result so nothing is dead-code eliminated.
  io::print(s1)
  io::print(s2)
  io::print(s3)
  io::print(s4)
  io::print(s5)
  io::print(s6)
  io::print(json::stringify(g1))
  io::print(json::stringify(g2))
  io::print(json::stringify(g3))
  io::print(json::stringify(o1))
  io::print(json::stringify(o2))
  io::print(json::stringify(o3))

  RETURN 0
END FUNC
