' bug-389 byte-identity codegen coverage for the io package.
' Compile-only by design: io reads standard input and inspects terminals, which
' is irrelevant at compile time, so there is no .run golden and the harness
' never executes this — it exists only to give the io backend a .ncode golden.
IMPORT io

FUNC main() AS Integer
  ' Output functions (String -> Nothing).
  io::print("hello")
  io::printError("hello")
  io::write("hello")
  io::writeError("hello")
  io::flush()

  ' Buffering controls.
  io::setBuffered(TRUE)
  LET buffered AS Boolean = io::isBuffered()
  io::print(toString(buffered))

  ' Input functions.
  LET line AS String = io::input()
  io::print(line)
  LET prompted AS String = io::input("Name: ")
  io::print(prompted)
  LET raw AS String = io::readLine()
  io::print(raw)
  LET timedLine AS String = io::readLine(1000)
  io::print(timedLine)

  ' Keystroke readers (no-timeout and timeout forms).
  LET b AS Byte = io::readRaw()
  io::print(toString(b))
  LET sc AS Scalar = io::readScalar()
  io::print(toString(sc))
  LET ch AS String = io::readGrapheme()
  io::print(ch)
  LET k AS io::Key = io::readKey()
  io::print(k.grapheme)
  LET kTimeout AS io::Key = io::readKey(1000)
  io::print(kTimeout.grapheme)

  ' Terminal predicates.
  LET inTerm AS Boolean = io::isInputTerminal()
  io::print(toString(inTerm))
  LET outTerm AS Boolean = io::isOutputTerminal()
  io::print(toString(outTerm))
  LET errTerm AS Boolean = io::isErrorTerminal()
  io::print(toString(errTerm))

  RETURN 0
END FUNC
