IMPORT collections
IMPORT io

' plan-86 G1 SOUNDNESS: the index is `i * 2`, which is NEITHER `i` nor `i+1`, so
' the elision must NOT fire. At i=3 the index is 6 > len 5 — MUST trap (a wrong
' elision keyed on the induction var alone would silently OOB-read).

FUNC main AS Integer
  LET xs AS List OF Integer = [10, 20, 30, 40, 50]
  MUT s AS Integer = 0
  FOR i = 0 TO len(xs) - 1
    s = s + collections::get(xs, i * 2)
  NEXT
  io::print("s=" & toString(s))
  RETURN 0
END FUNC
