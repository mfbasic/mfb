IMPORT io
IMPORT os
IMPORT fs
IMPORT tcp
IMPORT collections

UNION Handle
  fs::File
  tcp::Socket
END UNION

TYPE HB
  h AS RES Handle
END TYPE

TYPE Cur
  pos AS Integer
  note AS String
END TYPE

FUNC openOne AS RES fs::File
  RETURN fs::openFile("/tmp/g933/data.txt")
END FUNC

FUNC mkH() AS RES Handle
  RES h AS Handle = openOne()
  RETURN h
END FUNC

FUNC which(label AS String, h AS Handle) AS Integer
  MATCH h
    CASE fs::File(f)
      LET text AS String = fs::readAll(f)
      RETURN 1
    CASE tcp::Socket(s)
      RETURN 2
  END MATCH
  RETURN 0
END FUNC

FUNC main AS Integer
  MUT t AS Integer = 0
  FOR i = 1 TO toInt(os::getEnvOr("N", "10"))
    t = t + once()
  NEXT
  io::print(toString(t))
  RETURN 0
END FUNC
FUNC once() AS Integer
  MUT xs AS List OF RES fs::File STATE Cur = []
  FOR j = 1 TO 3
    RES v AS fs::File STATE Cur = openOne()
    v.state.pos = 1
    xs = collections::append(xs, v)
  NEXT
  MUT t AS Integer = 0
  FOR EACH x IN xs
    t = t + x.state.pos
  NEXT
  RETURN t
END FUNC
