' bug-760 D: collections::sort / collections::find / strings::graphemesCount lowered
' inline into main. Compiled only for its -O1 .ncode by
' tests/codegen/codegen_regalloc_eviction.rs.
IMPORT io
IMPORT collections
IMPORT datetime
IMPORT strings

FUNC mkScr(n AS Integer) AS List OF Integer
  MUT xs AS List OF Integer = []
  FOR i = 0 TO n - 1
    xs = collections::append(xs, (i * 7919) MOD n)
  NEXT
  RETURN xs
END FUNC

FUNC mkStr(n AS Integer) AS List OF String
  MUT xs AS List OF String = []
  FOR i = 0 TO n - 1
    xs = collections::append(xs, "s" & toString(i))
  NEXT
  RETURN xs
END FUNC

FUNC hashL(s AS List OF Integer) AS Integer
  MUT acc AS Integer = 0
  FOR i = 0 TO len(s) - 1
    acc = (acc * 31 + collections::get(s, i)) MOD 1000000007
  NEXT
  RETURN acc
END FUNC

FUNC main(args AS List OF String) AS Integer
  LET base = mkScr(20000)
  MUT t0 AS Integer = datetime::monotonicNanos()
  MUT acc AS Integer = 0
  FOR k = 0 TO 49
    LET sorted AS List OF Integer = collections::sort(base)
    acc = acc + len(sorted)
  NEXT
  MUT t1 AS Integer = datetime::monotonicNanos()
  io::print("sort_only  ms=" & toString((t1 - t0) / 1000000) & " chk=" & toString(acc))
  t0 = datetime::monotonicNanos()
  acc = 0
  FOR k = 0 TO 49
    acc = acc + hashL(base)
  NEXT
  t1 = datetime::monotonicNanos()
  io::print("hash_only  ms=" & toString((t1 - t0) / 1000000) & " chk=" & toString(acc))
  LET sb = mkStr(1000)
  t0 = datetime::monotonicNanos()
  acc = 0
  FOR k = 0 TO 4999
    acc = acc + collections::find(sb, "s999")
  NEXT
  t1 = datetime::monotonicNanos()
  io::print("find_str   ms=" & toString((t1 - t0) / 1000000) & " chk=" & toString(acc))
  MUT w AS String = ""
  FOR i = 0 TO 74
    w = w & "The quick brown fox jumps over the lazy dog 0123456789 "
  NEXT
  t0 = datetime::monotonicNanos()
  acc = 0
  FOR k = 0 TO 9999
    acc = acc + strings::graphemesCount(w)
  NEXT
  t1 = datetime::monotonicNanos()
  io::print("graphemes   ms=" & toString((t1 - t0) / 1000000) & " chk=" & toString(acc))
  RETURN 0
END FUNC
