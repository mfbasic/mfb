REM
REM Builtin - NET
REM

net::poll(List OF Socket) AS Socket

REM
REM Builtin - TLS
REM

tls::poll(sock AS TlsSocket) AS Boolean
tls::poll(sock AS TlsSocket, timeoutMs AS Integer) AS Boolean
tls::poll(List OF TlsSocket) AS TlsSocket

REM
REM Builtin - HTTP
REM

TYPE PendingState
  sentAll  AS Boolean
  raw      AS List OF Byte
  err      AS Integer
END TYPE

UNION Stream
  net::Socket
  net::TlsSocket
END UNION

FUNC http::startRead(url, headers, method) AS RES http::Stream STATE PendingState  ' variant from url.scheme
FUNC http::ready(RES stream AS http::Stream STATE PendingState) AS Boolean
SUB  http::pump(RES stream AS http::Stream STATE PendingState)   ' MATCHes internally; grows stream.state.raw
FUNC http::done(RES stream AS http::Stream STATE PendingState) AS Boolean
FUNC http::finish(RES stream AS http::Stream STATE PendingState) AS Response

' keep http::read/http::write blocking as-is (they become thin wrappers: startRead + pump-until-done + finish)

