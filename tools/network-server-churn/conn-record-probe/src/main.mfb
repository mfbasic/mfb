IMPORT collections
IMPORT os
IMPORT tcp

TYPE Conn
  id AS Integer
  sock AS RES tcp::Socket
END TYPE

FUNC main() AS Nothing
  RES server AS tcp::Listener = tcp::listen("127.0.0.1", 0) TRAP(e)
    os::exit(1)
  END TRAP
  MUT conns AS List OF Conn = []
  FOR i = 0 TO 2
    RES s AS tcp::Socket = tcp::accept(server, 0) TRAP(e)
      RETURN
    END TRAP
    conns = collections::append(conns, Conn[i, s])
  NEXT
END FUNC
