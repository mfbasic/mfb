' Run regex::findAll over a 100 000-character subject K times (K = first argument),
' 10 000 hits each. Each call parses the pattern into a __regex_Node tree, a recursive value
' copied and freed while the tree is built and flattened.
IMPORT io
IMPORT regex
IMPORT collections
IMPORT os

SUB main()
  LET k AS Integer = toInt(collections::get(os::args(), 0))
  MUT subject AS String = ""
  MUT j AS Integer = 0
  WHILE j < 10000
    subject = subject & "abcab1234 "
    j = j + 1
  END WHILE
  MUT hits AS Integer = 0
  MUT i AS Integer = 0
  WHILE i < k
    hits = len(regex::findAll(subject, "[a-c]+[0-9]+"))
    i = i + 1
  END WHILE
  io::print("chars=" & toString(len(subject)) & " hits=" & toString(hits))
END SUB
