' toolbar - the decision logic only (examples/water/src/toolbar.mfb), trimmed
' for a headless probe.
'
' `at AS canvas::Point` is split into `atX, atY AS Float` here, the same
' change bug-716's own manual repro made: importing `canvas` at all forces
' `--app` mode, which needs a display this probe does not have. The
' comparisons are unchanged (`atX >= playWidth(width)` is `at.x >=
' playWidth(width)` with the field read pulled out to a parameter).

IMPORT collections
IMPORT math

LET TOOLBAR_WIDTH AS Float = 88.0
LET BUTTON_SIZE AS Float = 64.0
LET BUTTON_GAP AS Float = 12.0

LET TOOL_KINDS AS List OF ShapeKind = [ShapeKind.Rectangle, ShapeKind.Triangle, ShapeKind.Circle, ShapeKind.Ellipse, ShapeKind.Star]

FUNC playWidth(width AS Float) AS Float
  RETURN math::max(width - TOOLBAR_WIDTH, 0.0)
END FUNC

FUNC buttonLeft(width AS Float) AS Float
  RETURN playWidth(width) + (TOOLBAR_WIDTH - BUTTON_SIZE) / 2.0
END FUNC

FUNC buttonTop(k AS Integer) AS Float
  RETURN BUTTON_GAP + toFloat(k) * (BUTTON_SIZE + BUTTON_GAP)
END FUNC

FUNC onToolbar(width AS Float, atX AS Float) AS Boolean
  RETURN atX >= playWidth(width)
END FUNC

FUNC buttonAt(width AS Float, atX AS Float, atY AS Float) AS Integer
  LET left AS Float = buttonLeft(width)
  IF atX < left OR atX > left + BUTTON_SIZE THEN RETURN -1
  FOR k = 0 TO len(TOOL_KINDS) - 1
    LET top AS Float = buttonTop(k)
    IF atY >= top AND atY <= top + BUTTON_SIZE THEN RETURN k
  NEXT
  RETURN -1
END FUNC

FUNC toolKind(k AS Integer) AS ShapeKind
  RETURN collections::get(TOOL_KINDS, k)
END FUNC
