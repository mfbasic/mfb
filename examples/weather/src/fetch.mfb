' fetch - getting the forecast.
'
' The data is NOAA's Global Forecast System, served by NOMADS. The whole GFS
' output for one hour is hundreds of megabytes, so this asks NOMADS' filter CGI
' for the fields it actually draws - UGRD and VGRD, the eastward and northward
' components of the wind, at 10 metres above the ground and at the 850 and 250
' millibar pressure levels (about one and a half and ten kilometres up), TMP at
' two metres above the ground, and PRATE, the precipitation rate at the surface
' - on the half degree grid.
'
' That takes three requests per hour, because the filter asks for every
' variable at every level named: asking for PRATE's level, the surface, in the
' same request as the rest would bring the ground's own temperature along too,
' and asking for the pressure levels alongside the heights would bring the
' temperature at them. The three answers are GRIB2 files, and a GRIB2 file is
' nothing but its messages one after another, so they are kept as one file: the
' surface wind and temperature, the wind aloft, then the precipitation. For the
' analysis that is about 1.7 megabytes.
'
' GFS runs four times a day, at 00, 06, 12 and 18 UTC, and the analysis hour of
' a run appears on NOMADS roughly four hours after the run's nominal time. So
' the newest cycle that should exist is the one before now minus four hours,
' and if it is not there yet - NCEP is late, the mirror is behind, a run was
' skipped - the next one back is tried, up to two days into the past. The first
' cycle that answers with a GRIB file wins.
'
' The same run also carries a forecast, out to sixteen days. The half-degree
' files come every three hours, and the program plays the first five days of
' them (forecast.mfb fetches those on a worker thread once the analysis is up).
' Every hour of a run is asked for the same way; only the fHHH in the file name
' changes.
'
' Downloads are cached in the host temporary directory under the cycle and hour
' they came from, so the second run of the program starts instantly and a
' rebuild while working on the drawing costs nothing. Only the newest cycle is
' kept: a run is 41 files and about 75 megabytes, and a new one comes out every
' six hours.

IMPORT collections
IMPORT datetime
IMPORT errorCode
IMPORT fs
IMPORT http
IMPORT net
IMPORT strings

' One GFS run, in the spellings the URL and the caption each need.
TYPE Cycle
  day AS String        ' yyyymmdd, as the NOMADS directory names it
  hour AS String       ' HH, ditto
  caption AS String    ' how the run is written on screen
  seconds AS Integer   ' the run's nominal time, in seconds since the epoch
END TYPE

' The outcome of trying one cycle. A cycle that is simply not published yet is
' an ordinary answer rather than a failure - that is the common case on the
' first attempt, several times a day - so the walk back through the cycles is
' written over a value, not over a TRAP. `winds` is only meaningful when
' `problem` is empty: attemptCycle decodes the candidate bytes (cached or
' freshly fetched) before it ever hands back an Attempt, so a cached file
' that starts with the GRIB magic but does not actually decode counts as
' this cycle's attempt failing, exactly like a cycle that has not been
' published yet.
TYPE Attempt
  winds AS Winds
  problem AS String
END TYPE

' A placeholder Winds for the failure case of an Attempt, where there is no
' real decoded data to carry. `emptyField` is main.mfb's own helper (the
' project's top-level symbols are shared across every .mfb file), reused here
' rather than duplicated.
FUNC emptyWinds AS Winds
  RETURN Winds[east := emptyField(), north := emptyField(), east850 := emptyField(), north850 := emptyField(), east250 := emptyField(), north250 := emptyField(), temperature := emptyField(), precipitation := emptyField(), label := ""]
END FUNC

' The analysis the program opens on, and the run it came from - which is the run
' the forecast is then fetched out of.
TYPE Analysis
  cycle AS Cycle
  winds AS Winds
END TYPE

' Seconds in a GFS cycle, and how long after one its analysis hour shows up.
LET CYCLE_SECONDS AS Integer = 21600

LET PUBLISH_DELAY_SECONDS AS Integer = 14400

' How many cycles back to look before giving up - eight is two days.
LET CYCLES_TO_TRY AS Integer = 8

' The grid NOMADS is asked for. The half-degree grid is 720 by 361 points and
' about 1.7 megabytes an hour for the eight requested fields, which is
' more detail than the picture can show at a world-sized zoom and enough to hold
' up when zoomed in.
LET GRID_NAME AS String = "0p50"

FUNC cycleAt(epochSeconds AS Integer) AS Cycle
  LET stamp AS datetime::DateTime = datetime::inZone(datetime::instant(epochSeconds), datetime::utc())
  RETURN Cycle[day := datetime::format(stamp, "yyyyMMdd"), hour := datetime::format(stamp, "HH"), caption := datetime::format(stamp, "yyyy-MM-dd HH") & "Z", seconds := epochSeconds]
END FUNC

' A forecast hour the way the GFS file names write it: f000, f003, ... f384.
FUNC hourTag(hour AS Integer) AS String
  RETURN "f" & strings::padLeft(toString(hour), 3, "0")
END FUNC

' How a forecast hour of a run is written in a message.
FUNC hourCaption(c AS Cycle, hour AS Integer) AS String
  IF hour = 0 THEN RETURN "the " & c.caption & " analysis"
  RETURN "+" & toString(hour) & " h of the " & c.caption & " run"
END FUNC

' The three filter requests that make up one hour: the levels and variables
' each asks for, as query-string parameters.
LET WIND_AND_TEMPERATURE AS String = "&lev_10_m_above_ground=on&lev_2_m_above_ground=on&var_UGRD=on&var_VGRD=on&var_TMP=on"

LET WIND_ALOFT AS String = "&lev_850_mb=on&lev_250_mb=on&var_UGRD=on&var_VGRD=on"

LET PRECIPITATION AS String = "&lev_surface=on&var_PRATE=on"

' The NOMADS filter URL for one request of one hour of one cycle. The %2F are
' literal: the CGI's dir parameter carries a path, and it has to arrive
' percent-encoded rather than as slashes in the query string.
FUNC filterUrl(c AS Cycle, hour AS Integer, fields AS String) AS String
  RETURN "https://nomads.ncep.noaa.gov/cgi-bin/filter_gfs_" & GRID_NAME & ".pl?file=gfs.t" & c.hour & "z.pgrb2full." & GRID_NAME & "." & hourTag(hour) & fields & "&dir=%2Fgfs." & c.day & "%2F" & c.hour & "%2Fatmos"
END FUNC

FUNC cacheDirectory AS String
  LET dir AS String = fs::pathJoin([fs::tempDirectory(), "mfb-weather-gfs"])
  IF NOT fs::directoryExists(dir) THEN fs::createDirectories(dir)
  RETURN dir
END FUNC

' Every cached file of one cycle starts with this.
FUNC cachePrefix(c AS Cycle) AS String
  RETURN "gfs-" & c.day & "-" & c.hour & "-"
END FUNC

' Every cached file ends with this. It names what the file holds, so a file
' cached by a build that asked for other fields is never taken for one of these.
FUNC cacheSuffix AS String
  RETURN "-wind-wind850-wind250-temp-rain-" & GRID_NAME & ".grb2"
END FUNC

' Where one hour of a cycle is kept between runs.
FUNC cachePath(c AS Cycle, hour AS Integer) AS String
  RETURN fs::pathJoin([cacheDirectory(), cachePrefix(c) & hourTag(hour) & cacheSuffix()])
END FUNC

' Delete every cached file that is not one of cycle c's. The program only ever
' draws the newest run it can find, so an older run's files are never read
' again once a newer one has been fetched, and a file holding other fields is
' never read at all.
FUNC pruneCache(c AS Cycle) AS Nothing
  LET dir AS String = cacheDirectory()
  LET keep AS String = cachePrefix(c)
  FOR EACH name IN fs::listDirectory(dir)
    LET current AS Boolean = strings::startsWith(name, keep) AND strings::endsWith(name, cacheSuffix())
    IF strings::startsWith(name, "gfs-") AND NOT current THEN fs::deleteFile(fs::pathJoin([dir, name]))
  NEXT
END FUNC

' "GRIB" as a big-endian 32-bit number, which is how decodeMessage recognises a
' message and how this recognises a real answer.
LET GRIB_MAGIC AS Integer = 1196575042

' One filter request's answer.
'
' The status code is not enough on its own: the filter CGI answers 200 with a
' short HTML page when the cycle's directory exists but the requested field is
' not in it, which is exactly what a run still being written looks like. So the
' body is checked for the GRIB magic.
FUNC download(c AS Cycle, hour AS Integer, fields AS String) AS List OF Byte
  LET response AS http::Response = http::read(net::toUrl(filterUrl(c, hour, fields)))
  IF NOT response.ok THEN FAIL error(errorCode::ErrNotFound, "NOMADS answered " & toString(response.status) & " for " & hourCaption(c, hour))
  IF len(response.body) <= 16 OR beInt(response.body, 0, 4) <> GRIB_MAGIC THEN FAIL error(errorCode::ErrNotFound, hourCaption(c, hour) & " is not published yet")
  RETURN response.body
END FUNC

' One hour of one cycle, decoded - from the cache if it is there and decodes,
' and from NOMADS if it is not. A cached file is only a candidate if it starts
' with the GRIB magic; it is only trusted once it actually decodes. A cached
' file that starts with the magic but does not decode is deleted, so the next
' run - this one's retry to an older cycle, or a wholly separate future run -
' does not read the same corrupt bytes again. A freshly fetched file is
' written to the cache (atomically, so a program closed part of the way
' through leaves no half an hour to be trusted next time) only after it has
' decoded, so a bad fetch never touches the cache in the first place.
FUNC cycleData(c AS Cycle, hour AS Integer) AS Winds
  LET path AS String = cachePath(c, hour)
  IF fs::fileExists(path) THEN
    LET cached AS List OF Byte = fs::readBytes(path)
    IF len(cached) > 16 AND beInt(cached, 0, 4) = GRIB_MAGIC THEN
      LET winds AS Winds = windsFrom(cached, c) TRAP(e)
        fs::deleteFile(path)
        FAIL e
      END TRAP
      RETURN winds
    END IF
  END IF

  LET weather AS List OF Byte = download(c, hour, WIND_AND_TEMPERATURE)
  LET aloft AS List OF Byte = download(c, hour, WIND_ALOFT)
  LET rain AS List OF Byte = download(c, hour, PRECIPITATION)
  LET fetched AS List OF Byte = collections::append(collections::append(weather, aloft), rain)
  LET winds AS Winds = windsFrom(fetched, c)
  fs::writeBytesAtomic(path, fetched)
  RETURN winds
END FUNC

' Trying one cycle never lets an error escape: a network failure, an
' unpublished cycle, and a cached-or-fetched file that fails to decode are all
' the same kind of outcome - this cycle's attempt did not pan out - and the
' caller (loadAnalysis, fetchForecast) walks back or retries the same way for
' all three.
FUNC attemptCycle(c AS Cycle, hour AS Integer) AS Attempt
  RETURN Attempt[winds := cycleData(c, hour), problem := ""]

  TRAP(e)
    RETURN Attempt[winds := emptyWinds(), problem := e.message]
  END TRAP
END FUNC

' The two wind components at each height, temperature and precipitation rate
' out of one cycle's file. Discipline 0, category 2 is momentum; parameter 2 is
' the u component and 3 the v. Category 0, parameter 0 is temperature, and
' category 1, parameter 7 the precipitation rate. Surface type 103 is "specified
' height above ground"; wind is at 10 metres and temperature at 2 metres.
' Surface type 100 is an isobaric surface, given in pascals: 85000 is 850
' millibars and 25000 is 250. Surface type 1 is the ground itself.
FUNC windsFrom(data AS List OF Byte, c AS Cycle) AS Winds
  LET fields AS List OF Field = decodeFile(data)
  RETURN Winds[east := pick(fields, 2, 2, 103, 10), north := pick(fields, 2, 3, 103, 10), east850 := pick(fields, 2, 2, 100, 85000), north850 := pick(fields, 2, 3, 100, 85000), east250 := pick(fields, 2, 2, 100, 25000), north250 := pick(fields, 2, 3, 100, 25000), temperature := pick(fields, 0, 0, 103, 2), precipitation := pick(fields, 1, 7, 1, 0), label := "GFS surface weather  " & c.caption]
END FUNC

' The most recent GFS surface analysis this machine can get hold of, and the run
' it belongs to.
FUNC loadAnalysis AS Analysis
  LET newest AS Integer = (datetime::now().seconds - PUBLISH_DELAY_SECONDS) / CYCLE_SECONDS
  MUT firstProblem AS String = ""

  FOR back = 0 TO CYCLES_TO_TRY - 1
    LET c AS Cycle = cycleAt((newest - back) * CYCLE_SECONDS)
    LET tried AS Attempt = attemptCycle(c, 0)
    IF tried.problem = "" THEN RETURN Analysis[cycle := c, winds := tried.winds]
    IF firstProblem = "" THEN firstProblem = tried.problem
  NEXT

  FAIL error(errorCode::ErrNotFound, "no GFS run in the last two days could be fetched: " & firstProblem)
END FUNC
