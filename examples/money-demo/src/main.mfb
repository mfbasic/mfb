IMPORT collections
IMPORT color
IMPORT datetime
IMPORT errorCode
IMPORT io
IMPORT math
IMPORT money
IMPORT strings
IMPORT term

' Money Demo - one person's finances simulated a day at a time, to show what
' the Money type does that Float cannot. Paychecks split into checking,
' savings, a 401(k) and withholding; bills, fuel, food and fun come out of
' checking; every two or three years an emergency hits savings; every year or
' two something is saved up for in equal monthly installments (the last one
' absorbs the rounding remainder) and then bought; each April the previous
' year's taxes are filed. The career ends after 40 years.
'
' Build and run it from an interactive terminal (80x25 or larger):
'   mfb build examples/money-demo
'   ./examples/money-demo/build/money-demo.out
'
' Controls:
'   space   pause / resume
'   + / -   faster / slower
'   r       switch Commercial <-> Banker rounding (replays the whole history)
'   f       switch the view between Money and Float arithmetic
'   q       quit
'
' The only true state is the event log: every paycheck, bill, fill-up and
' market move is recorded with its raw inputs (a gross amount, a unit price and
' a quantity, a rate in basis points). Balances, the columns, and the yearly
' totals are all derived by posting those events into a ledger. A rounding
' switch replays the whole log under the other mode and reports exactly which
' entries moved; the Float view is the same log posted with binary Float
' arithmetic, and switching to it reports where the two ledgers disagree.

' ------------------------------------------------------------------ the model

ENUM Kind
  Paycheck, Bonus, Bill, Metered, Taxed, Dining, Interest, Market, TaxFiling, Emergency, GoalStart, GoalSave, GoalBuy
END ENUM

ENUM Acct
  Checking, Savings, Retire, Withheld
END ENUM

' One thing that happened, with the raw inputs it happened with. Nothing here
' depends on the rounding mode or on Money vs Float: posting does the math.
TYPE Event
  day AS Integer
  stamp AS String
  year AS Integer
  kind AS Kind
  label AS String
  cat AS Integer
  amount AS Money
  qty AS Integer
  unit AS String
  bp AS Integer
END TYPE

' One posted line. `exact` is the full-precision result of the arithmetic and
' `posted` is what was booked (whole cents). `key` is eventIndex * 16 + slot, so
' two ledgers built from the same log can be lined up entry by entry.
TYPE Entry
  key AS Integer
  acct AS Acct
  cat AS Integer
  label AS String
  exact AS Money
  posted AS Money
END TYPE

TYPE FEntry
  key AS Integer
  acct AS Acct
  cat AS Integer
  label AS String
  exact AS Float
  posted AS Float
END TYPE

TYPE LogLine
  text AS String
  tone AS Integer
END TYPE

' Running balances derived from a ledger, plus the year-to-date figures the
' Expenses column and the April tax filing need.
TYPE MBook
  checking AS Money
  savings AS Money
  retire AS Money
  year AS Integer
  cats AS List OF Money
  wages AS Money
  fedHeld AS Money
  stateHeld AS Money
  prevWages AS Money
  prevFed AS Money
  prevState AS Money
END TYPE

TYPE FBook
  checking AS Float
  savings AS Float
  retire AS Float
  year AS Integer
  cats AS List OF Float
  wages AS Float
  fedHeld AS Float
  stateHeld AS Float
  prevWages AS Float
  prevFed AS Float
  prevState AS Float
END TYPE

TYPE MPost
  book AS MBook
  entries AS List OF Entry
  log AS List OF LogLine
END TYPE

TYPE FPost
  book AS FBook
  entries AS List OF FEntry
  log AS List OF LogLine
END TYPE

TYPE Row
  left AS String
  right AS String
  tone AS Integer
END TYPE

' Expense categories, in the order the Expenses column lists them.
LET catHousing AS Integer = 0
LET catUtilities AS Integer = 1
LET catGroceries AS Integer = 2
LET catDining AS Integer = 3
LET catFuel AS Integer = 4
LET catCar AS Integer = 5
LET catStreaming AS Integer = 6
LET catShopping AS Integer = 7
LET catFedTax AS Integer = 8
LET catStateTax AS Integer = 9
LET catFica AS Integer = 10
LET catEmergency AS Integer = 11
LET catGoals AS Integer = 12
LET noCat AS Integer = -1
LET catNames AS List OF String = ["Housing", "Utility", "Grocery", "Dining", "Fuel", "Car", "Stream", "Shop", "Fed tax", "St. tax", "FICA", "Emerg.", "Goals"]

' Emergencies: a column label, what happened, the bill range in dollars, and
' the share of the bill paid in basis points - under 10000 is a coinsurance
' share, over 10000 adds sales tax.
LET emergencyLabels AS List OF String = ["Crash", "ER", "Flood", "Dental", "Furnace", "Vet"]
LET emergencyWhat AS List OF String = ["Car crash, body shop", "ER visit, hospital bill", "Flooded basement, cleanup", "Cracked tooth, crown", "Furnace replacement", "Dog ate a sock, vet"]
LET emergencyLow AS List OF Integer = [2500, 6000, 3000, 2400, 4500, 1800]
LET emergencyHigh AS List OF Integer = [9000, 38000, 12000, 4800, 8500, 5500]
LET emergencyBps AS List OF Integer = [10825, 2000, 10600, 5000, 10700, 10000]

' Things saved up for: the savings-transfer label, the purchase label, the
' price range in dollars, the sales tax, and how many months to save.
LET goalFundLabels AS List OF String = ["To trip", "To car", "To PC", "To sofa", "To bike"]
LET goalBuyLabels AS List OF String = ["Vacation", "New car", "New PC", "Sofa", "E-bike"]
LET goalLow AS List OF Integer = [3000, 24000, 1800, 1200, 1500]
LET goalHigh AS List OF Integer = [6500, 36000, 3400, 3000, 4000]
LET goalTaxBps AS List OF Integer = [0, 625, 750, 750, 750]
LET goalMinMonths AS List OF Integer = [6, 30, 6, 6, 6]
LET goalMaxMonths AS List OF Integer = [12, 36, 10, 10, 12]

' Rates are whole basis points (1/100 of a percent), so the Money and Float
' ledgers start from identical inputs.
LET k401Bp AS Integer = 500
LET saveBp AS Integer = 200
LET ssBp AS Integer = 620
LET medicareBp AS Integer = 145
LET stateBp AS Integer = 495
LET bonusFedBp AS Integer = 2200
LET diningTaxBp AS Integer = 750
LET shoppingTaxBp AS Integer = 750
LET groceryTaxBp AS Integer = 225
LET savingsApyBp AS Integer = 425
LET payPeriods AS Integer = 26
LET standardDeduction AS Money = 15000.00m
LET bracketTops AS List OF Money = [11925.00m, 48475.00m, 103350.00m, 197300.00m, 250525.00m, 626350.00m]
LET bracketBps AS List OF Integer = [1000, 1200, 2200, 2400, 3200, 3500, 3700]
LET lowChecking AS Money = 300.00m
LET topUp AS Money = 1000.00m
LET highChecking AS Money = 6000.00m
LET sweepFloor AS Money = 4000.00m
LET startYear AS Integer = 2026
LET careerYears AS Integer = 40

LET toneText AS Integer = 0
LET toneIn AS Integer = 1
LET toneOut AS Integer = 2
LET toneMove AS Integer = 3
LET toneTax AS Integer = 4
LET toneHead AS Integer = 5
LET toneDim AS Integer = 6
LET toneFloat AS Integer = 7
LET toneTitle AS Integer = 8
LET toneBright AS Integer = 9

LET frameWidth AS Integer = 80
LET minRows AS Integer = 25
LET frameMs AS Integer = 50
LET speeds AS List OF Integer = [1, 2, 4, 8, 15, 30, 60, 120]

' ---------------------------------------------------------------- formatting

FUNC groupDigits(digits AS String) AS String
  MUT out AS String = ""
  LET n AS Integer = len(digits)
  FOR i = 0 TO n - 1
    IF i > 0 AND (n - i) MOD 3 = 0 THEN out = out & ","
    out = out & strings::mid(digits, i, 1)
  NEXT
  RETURN out
END FUNC

' "-1234.56" -> "-1,234.56"
FUNC withCommas(plain AS String) AS String
  MUT s AS String = plain
  MUT sign AS String = ""
  IF strings::startsWith(s, "-") THEN
    sign = "-"
    s = strings::mid(s, 1, len(s) - 1)
  END IF
  MUT whole AS String = s
  MUT frac AS String = ""
  IF strings::contains(s, ".") THEN
    LET dot AS Integer = strings::find(s, ".")
    whole = strings::left(s, dot)
    frac = strings::mid(s, dot, len(s) - dot)
  END IF
  RETURN sign & groupDigits(whole) & frac
END FUNC

FUNC dollars(t AS String) AS String
  IF strings::startsWith(t, "-") THEN RETURN "-$" & strings::mid(t, 1, len(t) - 1)
  RETURN "$" & t
END FUNC

FUNC signed(t AS String) AS String
  IF strings::startsWith(t, "-") THEN RETURN t
  RETURN "+" & t
END FUNC

' Booked Money: $1,234.56
FUNC fm(x AS Money) AS String
  RETURN dollars(withCommas(toString(x)))
END FUNC

' The full five-place Money value: 45.92280
FUNC fx(x AS Money) AS String
  RETURN toString(x, toByte(5))
END FUNC

FUNC fmPlain(x AS Money) AS String
  RETURN withCommas(toString(x))
END FUNC

FUNC ff(x AS Float) AS String
  RETURN dollars(withCommas(toString(x)))
END FUNC

FUNC ffPlain(x AS Float) AS String
  RETURN withCommas(toString(x))
END FUNC

' A Float printed to 17 significant digits - enough to show the binary value
' it really holds - with trailing zeros trimmed back to two places.
FUNC fraw(x AS Float) AS String
  LET a AS Float = math::abs(x)
  MUT digits AS Integer = 1
  MUT limit AS Float = 10.0
  DO WHILE a >= limit AND digits < 17
    digits = digits + 1
    limit = limit * 10.0
  LOOP
  MUT places AS Integer = 17 - digits
  IF places < 2 THEN places = 2
  MUT s AS String = toString(x, toByte(places))
  LET dot AS Integer = strings::find(s, ".")
  DO WHILE strings::endsWith(s, "0") AND len(s) - dot - 1 > 2
    s = strings::left(s, len(s) - 1)
  LOOP
  RETURN s
END FUNC

' A tiny difference in scientific form: -8.3e-12
FUNC fsci(d AS Float) AS String
  IF d = 0.0 THEN RETURN "0 (closest)"
  IF math::abs(d) >= 0.001 THEN RETURN signed(toString(d, toByte(3)))
  MUT e AS Integer = math::floor(math::log10(math::abs(d)))
  MUT mant AS Float = d / math::pow(10.0, toFloat(e))
  IF math::abs(mant) >= 9.95 THEN
    mant = mant / 10.0
    e = e + 1
  END IF
  RETURN toString(mant, toByte(1)) & "e" & toString(e)
END FUNC

' 612400 thousandths -> "612.400"
FUNC thousandths(q AS Integer) AS String
  RETURN toString(q / 1000) & "." & strings::padLeft(toString(q MOD 1000), 3, "0")
END FUNC

' 425 basis points -> "4.25%"
FUNC bpText(bp AS Integer) AS String
  MUT sign AS String = ""
  MUT b AS Integer = bp
  IF b < 0 THEN
    sign = "-"
    b = -b
  END IF
  RETURN sign & toString(b / 100) & "." & strings::padLeft(toString(b MOD 100), 2, "0") & "%"
END FUNC

FUNC fit(s AS String, width AS Integer) AS String
  IF width <= 0 THEN RETURN ""
  IF len(s) > width THEN RETURN strings::left(s, width)
  RETURN strings::padRight(s, width)
END FUNC

FUNC fitRight(s AS String, width AS Integer) AS String
  IF width <= 0 THEN RETURN ""
  IF len(s) > width THEN RETURN strings::right(s, width)
  RETURN strings::padLeft(s, width)
END FUNC

FUNC modeName(banker AS Boolean) AS String
  IF banker THEN RETURN "Banker"
  RETURN "Commercial"
END FUNC

FUNC line(text AS String, tone AS Integer) AS LogLine
  RETURN LogLine[text := text, tone := tone]
END FUNC

' ------------------------------------------------------------- Money ledger

FUNC pct(x AS Money, bp AS Integer) AS Money
  RETURN x * bp / 10000
END FUNC

' Book an amount to whole cents under the current money::Rounding mode.
FUNC cents(x AS Money) AS Money
  RETURN money::round(x, 2)
END FUNC

FUNC moneyMax(a AS Money, b AS Money) AS Money
  IF a > b THEN RETURN a
  RETURN b
END FUNC

FUNC incomeTax(taxable AS Money) AS Money
  MUT tax AS Money = 0.00m
  MUT lower AS Money = 0.00m
  FOR i = 0 TO len(bracketBps) - 1
    IF taxable <= lower THEN EXIT FOR
    MUT top AS Money = taxable
    IF i < len(bracketTops) THEN
      LET cap AS Money = collections::get(bracketTops, i)
      IF cap < top THEN top = cap
    END IF
    tax = tax + pct(top - lower, collections::get(bracketBps, i))
    IF i < len(bracketTops) THEN lower = collections::get(bracketTops, i)
  NEXT
  RETURN tax
END FUNC

FUNC openingMoney() AS MBook
  RETURN MBook[checking := 2500.00m, savings := 8000.00m, retire := 25000.00m, year := startYear, cats := collections::repeat([], 0.00m, len(catNames)), wages := 0.00m, fedHeld := 0.00m, stateHeld := 0.00m, prevWages := 0.00m, prevFed := 0.00m, prevState := 0.00m]
END FUNC

FUNC creditMoney(b AS MBook, acct AS Acct, cat AS Integer, posted AS Money) AS MBook
  MUT r AS MBook = b
  IF acct = Acct.Checking THEN
    r = WITH r { checking := r.checking + posted }
  ELSEIF acct = Acct.Savings THEN
    r = WITH r { savings := r.savings + posted }
  ELSEIF acct = Acct.Retire THEN
    r = WITH r { retire := r.retire + posted }
  END IF
  IF cat >= 0 THEN
    r = WITH r { cats := collections::set(r.cats, cat, collections::get(r.cats, cat) - posted) }
  END IF
  RETURN r
END FUNC

FUNC addM(p AS MPost, key AS Integer, acct AS Acct, cat AS Integer, label AS String, exact AS Money, posted AS Money) AS MPost
  LET e AS Entry = Entry[key := key, acct := acct, cat := cat, label := label, exact := exact, posted := posted]
  RETURN MPost[book := creditMoney(p.book, acct, cat, posted), entries := collections::append(p.entries, e), log := p.log]
END FUNC

FUNC sayM(p AS MPost, narrate AS Boolean, text AS String, tone AS Integer) AS MPost
  IF NOT narrate THEN RETURN p
  RETURN WITH p { log := collections::append(p.log, line(text, tone)) }
END FUNC

' Post one event to the Money ledger, under whatever money::Rounding mode is
' installed. Every rate multiply and divide keeps all five places; cents()
' books the result ("compute at five places, book at two").
FUNC postMoney(start AS MBook, ev AS Event, index AS Integer, narrate AS Boolean) AS MPost
  MUT b AS MBook = start
  IF ev.year <> b.year THEN
    b = WITH b { year := ev.year, cats := collections::repeat([], 0.00m, len(catNames)), prevWages := b.wages, prevFed := b.fedHeld, prevState := b.stateHeld, wages := 0.00m, fedHeld := 0.00m, stateHeld := 0.00m }
  END IF
  MUT p AS MPost = MPost[book := b, entries := [], log := []]
  LET k AS Integer = index * 16

  IF ev.kind = Kind.Paycheck OR ev.kind = Kind.Bonus THEN
    LET gross AS Money = ev.amount
    LET k401x AS Money = pct(gross, k401Bp)
    LET k401 AS Money = cents(k401x)
    LET matchx AS Money = k401 / 2
    LET employer AS Money = cents(matchx)
    MUT savex AS Money = 0.00m
    IF ev.kind = Kind.Paycheck THEN savex = pct(gross, saveBp)
    LET toSavings AS Money = cents(savex)
    LET taxable AS Money = gross - k401
    MUT fedx AS Money = pct(taxable, bonusFedBp)
    IF ev.kind = Kind.Paycheck THEN
      fedx = incomeTax(moneyMax(taxable * payPeriods - standardDeduction, 0.00m)) / payPeriods
    END IF
    LET fed AS Money = cents(fedx)
    LET statex AS Money = pct(taxable, stateBp)
    LET stateTax AS Money = cents(statex)
    LET ssx AS Money = pct(gross, ssBp)
    LET ss AS Money = cents(ssx)
    LET medx AS Money = pct(gross, medicareBp)
    LET med AS Money = cents(medx)
    LET net AS Money = gross - k401 - toSavings - fed - stateTax - ss - med
    p = addM(p, k, Acct.Checking, noCat, ev.label, net, net)
    IF toSavings > 0.00m THEN p = addM(p, k + 1, Acct.Savings, noCat, "Save 2%", savex, toSavings)
    p = addM(p, k + 2, Acct.Retire, noCat, "401k 5%", k401x, k401)
    p = addM(p, k + 3, Acct.Retire, noCat, "Match", matchx, employer)
    p = addM(p, k + 4, Acct.Withheld, catFedTax, "Fed W/H", -fedx, -fed)
    p = addM(p, k + 5, Acct.Withheld, catStateTax, "State W/H", -statex, -stateTax)
    p = addM(p, k + 6, Acct.Withheld, catFica, "Soc Sec", -ssx, -ss)
    p = addM(p, k + 7, Acct.Withheld, catFica, "Medicare", -medx, -med)
    MUT nb AS MBook = p.book
    nb = WITH nb { wages := nb.wages + taxable, fedHeld := nb.fedHeld + fed, stateHeld := nb.stateHeld + stateTax }
    p = WITH p { book := nb }
    p = sayM(p, narrate, ev.label & " " & fm(gross) & ": net " & fm(net) & " to checking, " & fm(toSavings) & " to savings, " & fm(k401) & " + " & fm(employer) & " match to 401(k)", toneIn)
    p = sayM(p, narrate, "  withheld: fed " & fx(fedx) & " -> " & fm(fed) & ", state " & fx(statex) & " -> " & fm(stateTax) & ", FICA " & fm(ss + med), toneTax)

  ELSEIF ev.kind = Kind.Bill THEN
    p = addM(p, k, Acct.Checking, ev.cat, ev.label, -ev.amount, -ev.amount)
    p = sayM(p, narrate, ev.label & " " & fm(ev.amount) & " paid from checking", toneOut)

  ELSEIF ev.kind = Kind.Metered THEN
    LET costx AS Money = ev.amount * ev.qty / 1000
    LET cost AS Money = cents(costx)
    p = addM(p, k, Acct.Checking, ev.cat, ev.label, -costx, -cost)
    p = sayM(p, narrate, ev.label & ": " & thousandths(ev.qty) & " " & ev.unit & " @ $" & fx(ev.amount) & " = " & fx(costx) & " -> booked " & fm(cost), toneOut)

  ELSEIF ev.kind = Kind.Taxed THEN
    LET taxx AS Money = pct(ev.amount, ev.bp)
    LET tax AS Money = cents(taxx)
    p = addM(p, k, Acct.Checking, ev.cat, ev.label, -(ev.amount + taxx), -(ev.amount + tax))
    p = sayM(p, narrate, ev.label & " " & fm(ev.amount) & " + " & bpText(ev.bp) & " tax " & fx(taxx) & " -> booked " & fm(ev.amount + tax), toneOut)

  ELSEIF ev.kind = Kind.Dining THEN
    LET taxx AS Money = pct(ev.amount, diningTaxBp)
    LET tipx AS Money = pct(ev.amount, ev.bp)
    LET total AS Money = ev.amount + cents(taxx) + cents(tipx)
    p = addM(p, k, Acct.Checking, ev.cat, ev.label, -(ev.amount + taxx + tipx), -total)
    p = sayM(p, narrate, ev.label & " " & fm(ev.amount) & " + tax " & fx(taxx) & " + " & bpText(ev.bp) & " tip " & fx(tipx) & " -> booked " & fm(total), toneOut)

  ELSEIF ev.kind = Kind.Interest THEN
    IF p.book.checking > highChecking THEN
      LET sweep AS Money = p.book.checking - sweepFloor
      p = addM(p, k, Acct.Checking, noCat, "Sweep", -sweep, -sweep)
      p = addM(p, k + 1, Acct.Savings, noCat, "Sweep", sweep, sweep)
      p = sayM(p, narrate, "Checking over " & fm(highChecking) & ": swept " & fm(sweep) & " into savings, leaving " & fm(sweepFloor), toneMove)
    END IF
    LET base AS Money = p.book.savings
    LET interestx AS Money = base * ev.bp / 120000
    LET interest AS Money = cents(interestx)
    p = addM(p, k + 2, Acct.Savings, noCat, "Int.", interestx, interest)
    p = sayM(p, narrate, "Savings interest " & bpText(ev.bp) & " APY / 12 on " & fm(base) & " = " & fx(interestx) & " -> booked " & fm(interest), toneIn)

  ELSEIF ev.kind = Kind.Market THEN
    LET base AS Money = p.book.retire
    LET gainx AS Money = pct(base, ev.bp)
    LET gain AS Money = cents(gainx)
    p = addM(p, k, Acct.Retire, noCat, "Mkt", gainx, gain)
    MUT tone AS Integer = toneIn
    IF gain < 0.00m THEN tone = toneOut
    p = sayM(p, narrate, "401(k) market " & signed(bpText(ev.bp)) & " on " & fm(base) & " = " & fx(gainx) & " -> booked " & fm(gain), tone)

  ELSEIF ev.kind = Kind.Emergency THEN
    LET costx AS Money = pct(ev.amount, ev.bp)
    LET cost AS Money = cents(costx)
    MUT from AS String = "savings"
    IF p.book.savings >= cost THEN
      p = addM(p, k, Acct.Savings, catEmergency, ev.label, -costx, -cost)
    ELSE
      from = "checking"
      p = addM(p, k + 1, Acct.Checking, catEmergency, ev.label, -costx, -cost)
    END IF
    p = sayM(p, narrate, "EMERGENCY - " & ev.unit & " " & fm(ev.amount) & shareText(ev.bp) & " = " & fx(costx) & " -> " & fm(cost) & " from " & from, toneOut)

  ELSEIF ev.kind = Kind.GoalStart THEN
    p = sayM(p, narrate, "New goal: " & ev.label & " - saving " & fm(ev.amount) & " over " & toString(ev.qty) & " months", toneMove)

  ELSEIF ev.kind = Kind.GoalSave THEN
    ' Split the goal into equal installments; the last one takes whatever the
    ' rounding left over, so the installments add up to the goal exactly.
    LET sharex AS Money = ev.amount / ev.qty
    MUT share AS Money = cents(sharex)
    MUT how AS String = fm(ev.amount) & " / " & toString(ev.qty) & " = " & fx(sharex) & " -> " & fm(share)
    IF ev.bp = ev.qty THEN
      LET earlier AS Money = cents(sharex) * (ev.qty - 1)
      share = ev.amount - earlier
      how = fm(ev.amount) & " - " & toString(ev.qty - 1) & " x " & fm(cents(sharex)) & " = " & fm(share) & " (the remainder)"
    END IF
    p = addM(p, k, Acct.Checking, noCat, ev.label, -sharex, -share)
    p = addM(p, k + 1, Acct.Savings, noCat, ev.label, sharex, share)
    p = sayM(p, narrate, ev.label & " " & toString(ev.bp) & "/" & toString(ev.qty) & ": " & how, toneMove)

  ELSEIF ev.kind = Kind.GoalBuy THEN
    LET taxx AS Money = pct(ev.amount, ev.bp)
    LET total AS Money = ev.amount + cents(taxx)
    p = addM(p, k, Acct.Savings, catGoals, ev.label, -(ev.amount + taxx), -total)
    MUT taxPart AS String = ""
    IF ev.bp > 0 THEN taxPart = " + " & bpText(ev.bp) & " tax " & fx(taxx) & " -> " & fm(total)
    p = sayM(p, narrate, "Bought: " & ev.label & " " & fm(ev.amount) & taxPart & " from savings (saved " & fm(centsToMoney(ev.qty)) & ")", toneMove)

  ELSEIF ev.kind = Kind.TaxFiling THEN
    LET fedLiabx AS Money = incomeTax(moneyMax(p.book.prevWages - standardDeduction, 0.00m))
    LET fedLiab AS Money = cents(fedLiabx)
    LET fedDue AS Money = fedLiab - p.book.prevFed
    IF fedDue <> 0.00m THEN
      MUT label AS String = "Fed due"
      IF fedDue < 0.00m THEN label = "Fed refund"
      p = addM(p, k, Acct.Checking, catFedTax, label, -(fedLiabx - p.book.prevFed), -fedDue)
    END IF
    p = sayM(p, narrate, toString(ev.year - 1) & " federal: owed " & fm(fedLiab) & ", withheld " & fm(p.book.prevFed) & dueText(fedDue), toneTax)
    LET stLiabx AS Money = pct(p.book.prevWages, stateBp)
    LET stLiab AS Money = cents(stLiabx)
    LET stDue AS Money = stLiab - p.book.prevState
    IF stDue <> 0.00m THEN
      MUT label AS String = "State due"
      IF stDue < 0.00m THEN label = "St refund"
      p = addM(p, k + 1, Acct.Checking, catStateTax, label, -(stLiabx - p.book.prevState), -stDue)
    END IF
    p = sayM(p, narrate, "  state " & bpText(stateBp) & " of " & fm(p.book.prevWages) & " = " & fx(stLiabx) & " -> " & fm(stLiab) & ", withheld " & fm(p.book.prevState) & dueText(stDue), toneTax)
  END IF

  IF p.book.checking < lowChecking AND p.book.savings >= topUp THEN
    LET low AS Money = p.book.checking
    p = addM(p, k + 14, Acct.Checking, noCat, "Top-up", topUp, topUp)
    p = addM(p, k + 15, Acct.Savings, noCat, "Top-up", -topUp, -topUp)
    p = sayM(p, narrate, "Checking fell to " & fm(low) & ": moved " & fm(topUp) & " over from savings", toneMove)
  END IF
  RETURN p
END FUNC

FUNC shareText(bp AS Integer) AS String
  IF bp < 10000 THEN RETURN ", you pay " & bpText(bp)
  IF bp > 10000 THEN RETURN " + " & bpText(bp - 10000) & " tax"
  RETURN ""
END FUNC

FUNC dueText(due AS Money) AS String
  IF due > 0.00m THEN RETURN " -> pay " & fm(due)
  IF due < 0.00m THEN RETURN " -> refund " & fm(-due)
  RETURN " -> even"
END FUNC

' ------------------------------------------------------------- Float ledger
'
' The same posting rules written the way a program without Money would write
' them: binary Float arithmetic, booked to cents by scaling and rounding.

FUNC fpct(x AS Float, bp AS Integer) AS Float
  RETURN x * toFloat(bp) / 10000.0
END FUNC

' Book a Float to cents. The half-cent test sees the binary value, so an amount
' that is a tie in decimal can land just above or below it.
FUNC fcents(x AS Float, banker AS Boolean) AS Float
  LET a AS Float = math::abs(x * 100.0)
  MUT whole AS Integer = math::floor(a)
  LET frac AS Float = a - toFloat(whole)
  IF frac > 0.5 THEN
    whole = whole + 1
  ELSEIF frac = 0.5 THEN
    IF NOT banker OR whole MOD 2 = 1 THEN whole = whole + 1
  END IF
  LET r AS Float = toFloat(whole) / 100.0
  IF x < 0.0 THEN RETURN -r
  RETURN r
END FUNC

FUNC floatMax(a AS Float, b AS Float) AS Float
  IF a > b THEN RETURN a
  RETURN b
END FUNC

FUNC fIncomeTax(taxable AS Float) AS Float
  MUT tax AS Float = 0.0
  MUT lower AS Float = 0.0
  FOR i = 0 TO len(bracketBps) - 1
    IF taxable <= lower THEN EXIT FOR
    MUT top AS Float = taxable
    IF i < len(bracketTops) THEN
      LET cap AS Float = toFloat(collections::get(bracketTops, i))
      IF cap < top THEN top = cap
    END IF
    tax = tax + fpct(top - lower, collections::get(bracketBps, i))
    IF i < len(bracketTops) THEN lower = toFloat(collections::get(bracketTops, i))
  NEXT
  RETURN tax
END FUNC

FUNC openingFloat() AS FBook
  RETURN FBook[checking := 2500.0, savings := 8000.0, retire := 25000.0, year := startYear, cats := collections::repeat([], 0.0, len(catNames)), wages := 0.0, fedHeld := 0.0, stateHeld := 0.0, prevWages := 0.0, prevFed := 0.0, prevState := 0.0]
END FUNC

FUNC creditFloat(b AS FBook, acct AS Acct, cat AS Integer, posted AS Float) AS FBook
  MUT r AS FBook = b
  IF acct = Acct.Checking THEN
    r = WITH r { checking := r.checking + posted }
  ELSEIF acct = Acct.Savings THEN
    r = WITH r { savings := r.savings + posted }
  ELSEIF acct = Acct.Retire THEN
    r = WITH r { retire := r.retire + posted }
  END IF
  IF cat >= 0 THEN
    r = WITH r { cats := collections::set(r.cats, cat, collections::get(r.cats, cat) - posted) }
  END IF
  RETURN r
END FUNC

FUNC addF(p AS FPost, key AS Integer, acct AS Acct, cat AS Integer, label AS String, exact AS Float, posted AS Float) AS FPost
  LET e AS FEntry = FEntry[key := key, acct := acct, cat := cat, label := label, exact := exact, posted := posted]
  RETURN FPost[book := creditFloat(p.book, acct, cat, posted), entries := collections::append(p.entries, e), log := p.log]
END FUNC

FUNC sayF(p AS FPost, narrate AS Boolean, text AS String, tone AS Integer) AS FPost
  IF NOT narrate THEN RETURN p
  RETURN WITH p { log := collections::append(p.log, line(text, tone)) }
END FUNC

FUNC fDueText(due AS Float) AS String
  IF due > 0.0 THEN RETURN " -> pay " & ff(due)
  IF due < 0.0 THEN RETURN " -> refund " & ff(-due)
  RETURN " -> even"
END FUNC

FUNC postFloat(start AS FBook, ev AS Event, index AS Integer, banker AS Boolean, narrate AS Boolean) AS FPost
  MUT b AS FBook = start
  IF ev.year <> b.year THEN
    b = WITH b { year := ev.year, cats := collections::repeat([], 0.0, len(catNames)), prevWages := b.wages, prevFed := b.fedHeld, prevState := b.stateHeld, wages := 0.0, fedHeld := 0.0, stateHeld := 0.0 }
  END IF
  MUT p AS FPost = FPost[book := b, entries := [], log := []]
  LET k AS Integer = index * 16
  LET amount AS Float = toFloat(ev.amount)

  IF ev.kind = Kind.Paycheck OR ev.kind = Kind.Bonus THEN
    LET gross AS Float = amount
    LET k401x AS Float = fpct(gross, k401Bp)
    LET k401 AS Float = fcents(k401x, banker)
    LET matchx AS Float = k401 / 2.0
    LET employer AS Float = fcents(matchx, banker)
    MUT savex AS Float = 0.0
    IF ev.kind = Kind.Paycheck THEN savex = fpct(gross, saveBp)
    LET toSavings AS Float = fcents(savex, banker)
    LET taxable AS Float = gross - k401
    MUT fedx AS Float = fpct(taxable, bonusFedBp)
    IF ev.kind = Kind.Paycheck THEN
      fedx = fIncomeTax(floatMax(taxable * toFloat(payPeriods) - toFloat(standardDeduction), 0.0)) / toFloat(payPeriods)
    END IF
    LET fed AS Float = fcents(fedx, banker)
    LET statex AS Float = fpct(taxable, stateBp)
    LET stateTax AS Float = fcents(statex, banker)
    LET ssx AS Float = fpct(gross, ssBp)
    LET ss AS Float = fcents(ssx, banker)
    LET medx AS Float = fpct(gross, medicareBp)
    LET med AS Float = fcents(medx, banker)
    LET net AS Float = gross - k401 - toSavings - fed - stateTax - ss - med
    p = addF(p, k, Acct.Checking, noCat, ev.label, net, net)
    IF toSavings > 0.0 THEN p = addF(p, k + 1, Acct.Savings, noCat, "Save 2%", savex, toSavings)
    p = addF(p, k + 2, Acct.Retire, noCat, "401k 5%", k401x, k401)
    p = addF(p, k + 3, Acct.Retire, noCat, "Match", matchx, employer)
    p = addF(p, k + 4, Acct.Withheld, catFedTax, "Fed W/H", -fedx, -fed)
    p = addF(p, k + 5, Acct.Withheld, catStateTax, "State W/H", -statex, -stateTax)
    p = addF(p, k + 6, Acct.Withheld, catFica, "Soc Sec", -ssx, -ss)
    p = addF(p, k + 7, Acct.Withheld, catFica, "Medicare", -medx, -med)
    MUT nb AS FBook = p.book
    nb = WITH nb { wages := nb.wages + taxable, fedHeld := nb.fedHeld + fed, stateHeld := nb.stateHeld + stateTax }
    p = WITH p { book := nb }
    p = sayF(p, narrate, ev.label & " " & ff(gross) & ": net " & fraw(net) & " to checking, " & ff(toSavings) & " to savings, " & ff(k401) & " + " & ff(employer) & " match to 401(k)", toneIn)
    p = sayF(p, narrate, "  withheld: fed " & fraw(fedx) & " -> " & ff(fed) & ", state " & fraw(statex) & " -> " & ff(stateTax), toneTax)

  ELSEIF ev.kind = Kind.Bill THEN
    p = addF(p, k, Acct.Checking, ev.cat, ev.label, -amount, -amount)
    p = sayF(p, narrate, ev.label & " $" & fraw(amount) & " paid from checking", toneOut)

  ELSEIF ev.kind = Kind.Metered THEN
    LET costx AS Float = amount * toFloat(ev.qty) / 1000.0
    LET cost AS Float = fcents(costx, banker)
    p = addF(p, k, Acct.Checking, ev.cat, ev.label, -costx, -cost)
    p = sayF(p, narrate, ev.label & ": " & thousandths(ev.qty) & " " & ev.unit & " @ $" & fraw(amount) & " = " & fraw(costx) & " -> booked " & ff(cost), toneOut)

  ELSEIF ev.kind = Kind.Taxed THEN
    LET taxx AS Float = fpct(amount, ev.bp)
    LET tax AS Float = fcents(taxx, banker)
    p = addF(p, k, Acct.Checking, ev.cat, ev.label, -(amount + taxx), -(amount + tax))
    p = sayF(p, narrate, ev.label & " " & ff(amount) & " + " & bpText(ev.bp) & " tax " & fraw(taxx) & " -> booked " & fraw(amount + tax), toneOut)

  ELSEIF ev.kind = Kind.Dining THEN
    LET taxx AS Float = fpct(amount, diningTaxBp)
    LET tipx AS Float = fpct(amount, ev.bp)
    LET total AS Float = amount + fcents(taxx, banker) + fcents(tipx, banker)
    p = addF(p, k, Acct.Checking, ev.cat, ev.label, -(amount + taxx + tipx), -total)
    p = sayF(p, narrate, ev.label & " " & ff(amount) & " + tax " & fraw(taxx) & " + " & bpText(ev.bp) & " tip " & fraw(tipx) & " -> booked " & fraw(total), toneOut)

  ELSEIF ev.kind = Kind.Interest THEN
    IF p.book.checking > toFloat(highChecking) THEN
      LET sweep AS Float = p.book.checking - toFloat(sweepFloor)
      p = addF(p, k, Acct.Checking, noCat, "Sweep", -sweep, -sweep)
      p = addF(p, k + 1, Acct.Savings, noCat, "Sweep", sweep, sweep)
      p = sayF(p, narrate, "Checking over " & fm(highChecking) & ": swept " & fraw(sweep) & " into savings, leaving " & fraw(p.book.checking), toneMove)
    END IF
    LET base AS Float = p.book.savings
    LET interestx AS Float = base * toFloat(ev.bp) / 120000.0
    LET interest AS Float = fcents(interestx, banker)
    p = addF(p, k + 2, Acct.Savings, noCat, "Int.", interestx, interest)
    p = sayF(p, narrate, "Savings interest " & bpText(ev.bp) & " APY / 12 on " & fraw(base) & " = " & fraw(interestx) & " -> " & ff(interest), toneIn)

  ELSEIF ev.kind = Kind.Market THEN
    LET base AS Float = p.book.retire
    LET gainx AS Float = fpct(base, ev.bp)
    LET gain AS Float = fcents(gainx, banker)
    p = addF(p, k, Acct.Retire, noCat, "Mkt", gainx, gain)
    MUT tone AS Integer = toneIn
    IF gain < 0.0 THEN tone = toneOut
    p = sayF(p, narrate, "401(k) market " & signed(bpText(ev.bp)) & " on " & fraw(base) & " = " & fraw(gainx) & " -> " & ff(gain), tone)

  ELSEIF ev.kind = Kind.Emergency THEN
    LET costx AS Float = fpct(amount, ev.bp)
    LET cost AS Float = fcents(costx, banker)
    MUT from AS String = "savings"
    IF p.book.savings >= cost THEN
      p = addF(p, k, Acct.Savings, catEmergency, ev.label, -costx, -cost)
    ELSE
      from = "checking"
      p = addF(p, k + 1, Acct.Checking, catEmergency, ev.label, -costx, -cost)
    END IF
    p = sayF(p, narrate, "EMERGENCY - " & ev.unit & " " & ff(amount) & shareText(ev.bp) & " = " & fraw(costx) & " -> " & ff(cost) & " from " & from, toneOut)

  ELSEIF ev.kind = Kind.GoalStart THEN
    p = sayF(p, narrate, "New goal: " & ev.label & " - saving " & ff(amount) & " over " & toString(ev.qty) & " months", toneMove)

  ELSEIF ev.kind = Kind.GoalSave THEN
    LET sharex AS Float = amount / toFloat(ev.qty)
    MUT share AS Float = fcents(sharex, banker)
    MUT how AS String = ff(amount) & " / " & toString(ev.qty) & " = " & fraw(sharex) & " -> " & ff(share)
    IF ev.bp = ev.qty THEN
      LET earlier AS Float = fcents(sharex, banker) * toFloat(ev.qty - 1)
      share = amount - earlier
      how = ff(amount) & " - " & toString(ev.qty - 1) & " x " & ff(fcents(sharex, banker)) & " = " & fraw(share) & " (the remainder)"
    END IF
    p = addF(p, k, Acct.Checking, noCat, ev.label, -sharex, -share)
    p = addF(p, k + 1, Acct.Savings, noCat, ev.label, sharex, share)
    p = sayF(p, narrate, ev.label & " " & toString(ev.bp) & "/" & toString(ev.qty) & ": " & how, toneMove)

  ELSEIF ev.kind = Kind.GoalBuy THEN
    LET taxx AS Float = fpct(amount, ev.bp)
    LET total AS Float = amount + fcents(taxx, banker)
    p = addF(p, k, Acct.Savings, catGoals, ev.label, -(amount + taxx), -total)
    MUT taxPart AS String = ""
    IF ev.bp > 0 THEN taxPart = " + " & bpText(ev.bp) & " tax " & fraw(taxx) & " -> " & fraw(total)
    p = sayF(p, narrate, "Bought: " & ev.label & " " & ff(amount) & taxPart & " from savings (saved " & fm(centsToMoney(ev.qty)) & ")", toneMove)

  ELSEIF ev.kind = Kind.TaxFiling THEN
    LET fedLiabx AS Float = fIncomeTax(floatMax(p.book.prevWages - toFloat(standardDeduction), 0.0))
    LET fedLiab AS Float = fcents(fedLiabx, banker)
    LET fedDue AS Float = fedLiab - p.book.prevFed
    IF fedDue <> 0.0 THEN
      MUT label AS String = "Fed due"
      IF fedDue < 0.0 THEN label = "Fed refund"
      p = addF(p, k, Acct.Checking, catFedTax, label, -(fedLiabx - p.book.prevFed), -fedDue)
    END IF
    p = sayF(p, narrate, toString(ev.year - 1) & " federal: owed " & ff(fedLiab) & ", withheld " & fraw(p.book.prevFed) & fDueText(fedDue), toneTax)
    LET stLiabx AS Float = fpct(p.book.prevWages, stateBp)
    LET stLiab AS Float = fcents(stLiabx, banker)
    LET stDue AS Float = stLiab - p.book.prevState
    IF stDue <> 0.0 THEN
      MUT label AS String = "State due"
      IF stDue < 0.0 THEN label = "St refund"
      p = addF(p, k + 1, Acct.Checking, catStateTax, label, -(stLiabx - p.book.prevState), -stDue)
    END IF
    p = sayF(p, narrate, "  state " & bpText(stateBp) & " = " & fraw(stLiabx) & " -> " & ff(stLiab) & ", withheld " & fraw(p.book.prevState) & " -> due " & fraw(stDue), toneTax)
  END IF

  IF p.book.checking < toFloat(lowChecking) AND p.book.savings >= toFloat(topUp) THEN
    LET low AS Float = p.book.checking
    LET move AS Float = toFloat(topUp)
    p = addF(p, k + 14, Acct.Checking, noCat, "Top-up", move, move)
    p = addF(p, k + 15, Acct.Savings, noCat, "Top-up", -move, -move)
    p = sayF(p, narrate, "Checking fell to " & fraw(low) & ": moved " & ff(move) & " over from savings", toneMove)
  END IF
  RETURN p
END FUNC

' ------------------------------------------------------------------ replays

FUNC replayMoney(evs AS List OF Event) AS MPost
  MUT book AS MBook = openingMoney()
  MUT all AS List OF Entry = []
  FOR i = 0 TO len(evs) - 1
    LET p AS MPost = postMoney(book, collections::get(evs, i), i, FALSE)
    book = p.book
    all = collections::append(all, p.entries)
  NEXT
  RETURN MPost[book := book, entries := all, log := []]
END FUNC

FUNC replayFloat(evs AS List OF Event, banker AS Boolean) AS FPost
  MUT book AS FBook = openingFloat()
  MUT all AS List OF FEntry = []
  FOR i = 0 TO len(evs) - 1
    LET p AS FPost = postFloat(book, collections::get(evs, i), i, banker, FALSE)
    book = p.book
    all = collections::append(all, p.entries)
  NEXT
  RETURN FPost[book := book, entries := all, log := []]
END FUNC

FUNC sumMoney(xs AS List OF Money) AS Money
  MUT t AS Money = 0.00m
  FOR EACH x IN xs
    t = t + x
  NEXT
  RETURN t
END FUNC

FUNC sumFloat(xs AS List OF Float) AS Float
  MUT t AS Float = 0.0
  FOR EACH x IN xs
    t = t + x
  NEXT
  RETURN t
END FUNC

FUNC stampOf(evs AS List OF Event, key AS Integer) AS String
  RETURN collections::get(evs, key / 16).stamp
END FUNC

' An exact half cent: the one case where Commercial and Banker disagree.
FUNC isHalfCent(x AS Money) AS Boolean
  LET r AS Money = x MOD 0.01m
  RETURN r = 0.00500m OR r = -0.00500m
END FUNC

' Booked cents with no exact binary Float form (anything but .00 .25 .50 .75).
FUNC notBinary(x AS Money) AS Boolean
  LET c AS Money = x MOD 0.25m
  RETURN c <> 0.00m
END FUNC

FUNC balanceRow(name AS String, a AS Money, b AS Money) AS LogLine
  LET d AS Money = b - a
  MUT tone AS Integer = toneDim
  MUT change AS String = "same"
  IF d <> 0.00m THEN
    tone = toneMove
    change = signed(fmPlain(d))
  END IF
  RETURN line(fit(name, 14) & fitRight(fm(a), 16) & fitRight(fm(b), 16) & "   " & change, tone)
END FUNC

' Everything a rounding switch changed, read off the two ledgers.
FUNC roundingReport(evs AS List OF Event, before AS MPost, after AS MPost, fromBanker AS Boolean, floatBefore AS FPost, floatAfter AS FPost) AS List OF LogLine
  LET fromName AS String = modeName(fromBanker)
  LET toName AS String = modeName(NOT fromBanker)
  LET na AS Integer = len(before.entries)
  LET nb AS Integer = len(after.entries)
  MUT i AS Integer = 0
  MUT j AS Integer = 0
  MUT bookedChanged AS Integer = 0
  MUT exactChanged AS Integer = 0
  MUT onlyBefore AS Integer = 0
  MUT onlyAfter AS Integer = 0
  MUT samples AS List OF LogLine = []
  MUT exactSamples AS List OF LogLine = []
  DO WHILE i < na OR j < nb
    MUT takeA AS Boolean = FALSE
    MUT takeB AS Boolean = FALSE
    IF i >= na THEN
      takeB = TRUE
    ELSEIF j >= nb THEN
      takeA = TRUE
    ELSE
      LET ka AS Integer = collections::get(before.entries, i).key
      LET kb AS Integer = collections::get(after.entries, j).key
      IF ka < kb THEN
        takeA = TRUE
      ELSEIF kb < ka THEN
        takeB = TRUE
      END IF
    END IF
    IF takeA THEN
      LET a AS Entry = collections::get(before.entries, i)
      onlyBefore = onlyBefore + 1
      IF len(samples) < 4 THEN samples = collections::append(samples, line(stampOf(evs, a.key) & " " & fit(a.label, 10) & " " & signed(fmPlain(a.posted)) & " only happened under " & fromName, toneMove))
      i = i + 1
    ELSEIF takeB THEN
      LET b AS Entry = collections::get(after.entries, j)
      onlyAfter = onlyAfter + 1
      IF len(samples) < 4 THEN samples = collections::append(samples, line(stampOf(evs, b.key) & " " & fit(b.label, 10) & " " & signed(fmPlain(b.posted)) & " only happens under " & toName, toneMove))
      j = j + 1
    ELSE
      LET a AS Entry = collections::get(before.entries, i)
      LET b AS Entry = collections::get(after.entries, j)
      IF a.posted <> b.posted THEN
        bookedChanged = bookedChanged + 1
        IF len(samples) < 4 THEN
          LET head AS String = stampOf(evs, a.key) & " " & fit(a.label, 10)
          IF a.exact = b.exact THEN
            samples = collections::append(samples, line(head & " exact " & fx(a.exact) & "  booked " & fmPlain(a.posted) & " -> " & fmPlain(b.posted), toneMove))
          ELSE
            samples = collections::append(samples, line(head & " booked " & fmPlain(a.posted) & " -> " & fmPlain(b.posted), toneMove))
            samples = collections::append(samples, line(strings::repeat(" ", 22) & "exact " & fx(a.exact) & " -> " & fx(b.exact) & " (knock-on)", toneDim))
          END IF
        END IF
      ELSEIF a.exact <> b.exact THEN
        exactChanged = exactChanged + 1
        IF len(exactSamples) < 3 THEN exactSamples = collections::append(exactSamples, line(stampOf(evs, a.key) & " " & fit(a.label, 10) & " exact " & fx(a.exact) & " -> " & fx(b.exact) & "  booked " & fmPlain(a.posted) & " (same)", toneText))
      END IF
      i = i + 1
      j = j + 1
    END IF
  LOOP

  MUT ties AS Integer = 0
  FOR EACH e IN after.entries
    IF isHalfCent(e.exact) THEN ties = ties + 1
  NEXT

  MUT floatMoved AS Integer = 0
  LET fn AS Integer = len(floatBefore.entries)
  IF fn = len(floatAfter.entries) THEN
    FOR q = 0 TO fn - 1
      IF collections::get(floatBefore.entries, q).posted <> collections::get(floatAfter.entries, q).posted THEN floatMoved = floatMoved + 1
    NEXT
  END IF

  MUT out AS List OF LogLine = []
  out = collections::append(out, line("Replayed " & toString(len(evs)) & " events under " & toName & " rounding: " & toString(nb) & " entries (was " & toString(na) & ").", toneText))
  out = collections::append(out, line("", toneText))
  out = collections::append(out, line("Exact half-cent amounts in the ledger:   " & toString(ties), toneHead))
  out = collections::append(out, line("Booked amounts that changed:             " & toString(bookedChanged), toneHead))
  out = collections::append(out, line("Exact (5th-place) values that changed:   " & toString(exactChanged), toneHead))
  IF onlyBefore + onlyAfter > 0 THEN
    out = collections::append(out, line("Entries that exist under one mode only:  " & toString(onlyBefore + onlyAfter), toneHead))
  END IF
  IF fn = len(floatAfter.entries) THEN
    out = collections::append(out, line("Float ledger, replayed too - booked amounts changed: " & toString(floatMoved), toneFloat))
  ELSE
    out = collections::append(out, line("Float ledger, replayed too - entry count " & toString(fn) & " -> " & toString(len(floatAfter.entries)), toneFloat))
  END IF
  out = collections::append(out, line("", toneText))
  out = collections::append(out, line(fit("Balance", 14) & fitRight(fromName, 16) & fitRight(toName, 16) & "   change", toneHead))
  out = collections::append(out, balanceRow("Checking", before.book.checking, after.book.checking))
  out = collections::append(out, balanceRow("Savings", before.book.savings, after.book.savings))
  out = collections::append(out, balanceRow("401(k)", before.book.retire, after.book.retire))
  out = collections::append(out, balanceRow("Expenses YTD", sumMoney(before.book.cats), sumMoney(after.book.cats)))
  out = collections::append(out, line("", toneText))
  IF len(samples) > 0 THEN
    out = collections::append(out, line("Booked changes (oldest first):", toneHead))
    out = collections::append(out, samples)
    LET more AS Integer = bookedChanged + onlyBefore + onlyAfter - len(samples)
    IF more > 0 THEN out = collections::append(out, line("  ...and " & toString(more) & " more", toneDim))
  ELSE
    IF ties = 0 THEN
      out = collections::append(out, line("No booking has landed on an exact half cent yet, so both modes", toneText))
      out = collections::append(out, line("book every amount the same way.", toneText))
    ELSE
      out = collections::append(out, line("Every half-cent tie was resolved the same way by both modes.", toneText))
    END IF
  END IF
  IF len(exactSamples) > 0 AND len(samples) = 0 THEN
    out = collections::append(out, line("Ties at the 5th decimal (cents unchanged):", toneHead))
    out = collections::append(out, exactSamples)
  END IF
  RETURN out
END FUNC

FUNC driftRow(name AS String, m AS Money, f AS Float) AS LogLine
  LET d AS Float = f - toFloat(m)
  MUT tone AS Integer = toneDim
  IF d <> 0.0 THEN tone = toneFloat
  RETURN line(fit(name, 13) & fitRight(fmPlain(m), 13) & "  " & fit(fraw(f), 24) & fsci(d), tone)
END FUNC

' Everything that differs between the Money ledger and the Float ledger.
FUNC floatReport(evs AS List OF Event, m AS MPost, f AS FPost, toFloatView AS Boolean, banker AS Boolean) AS List OF LogLine
  LET na AS Integer = len(m.entries)
  LET nb AS Integer = len(f.entries)
  MUT i AS Integer = 0
  MUT j AS Integer = 0
  MUT aligned AS Integer = 0
  MUT centDiffs AS Integer = 0
  MUT rawDiffs AS Integer = 0
  MUT oneSided AS Integer = 0
  MUT inexact AS Integer = 0
  MUT worstGap AS Float = 0.0
  MUT worstLine AS LogLine = line("", toneText)
  MUT samples AS List OF LogLine = []
  MUT sampled AS Integer = 0
  DO WHILE i < na OR j < nb
    MUT takeA AS Boolean = FALSE
    MUT takeB AS Boolean = FALSE
    IF i >= na THEN
      takeB = TRUE
    ELSEIF j >= nb THEN
      takeA = TRUE
    ELSE
      LET ka AS Integer = collections::get(m.entries, i).key
      LET kb AS Integer = collections::get(f.entries, j).key
      IF ka < kb THEN
        takeA = TRUE
      ELSEIF kb < ka THEN
        takeB = TRUE
      END IF
    END IF
    IF takeA THEN
      LET a AS Entry = collections::get(m.entries, i)
      oneSided = oneSided + 1
      IF len(samples) < 4 THEN
        samples = collections::append(samples, line(stampOf(evs, a.key) & " " & fit(a.label, 10) & " " & signed(fmPlain(a.posted)) & " happens only with Money", toneMove))
        sampled = sampled + 1
      END IF
      i = i + 1
    ELSEIF takeB THEN
      LET b AS FEntry = collections::get(f.entries, j)
      oneSided = oneSided + 1
      IF len(samples) < 4 THEN
        samples = collections::append(samples, line(stampOf(evs, b.key) & " " & fit(b.label, 10) & " " & signed(ffPlain(b.posted)) & " happens only with Float", toneMove))
        sampled = sampled + 1
      END IF
      j = j + 1
    ELSE
      LET a AS Entry = collections::get(m.entries, i)
      LET b AS FEntry = collections::get(f.entries, j)
      aligned = aligned + 1
      IF notBinary(a.posted) THEN inexact = inexact + 1
      LET gap AS Float = math::abs(b.exact - toFloat(a.exact))
      IF gap > 0.0 THEN rawDiffs = rawDiffs + 1
      LET centsAgree AS Boolean = math::abs(b.posted - toFloat(a.posted)) < 0.005
      IF centsAgree AND gap > worstGap THEN
        worstGap = gap
        worstLine = line(stampOf(evs, a.key) & " " & fit(a.label, 10) & " Money " & fx(a.exact) & "  Float " & fraw(b.exact), toneFloat)
      END IF
      IF NOT centsAgree THEN
        centDiffs = centDiffs + 1
        IF len(samples) < 3 THEN
          samples = collections::append(samples, line(stampOf(evs, a.key) & " " & fit(a.label, 10) & " Money " & fx(a.exact) & " -> " & fmPlain(a.posted), toneText))
          samples = collections::append(samples, line(strings::repeat(" ", 22) & "Float " & fraw(b.exact) & " -> " & ffPlain(b.posted), toneFloat))
          sampled = sampled + 1
        END IF
      END IF
      i = i + 1
      j = j + 1
    END IF
  LOOP

  MUT out AS List OF LogLine = []
  IF toFloatView THEN
    out = collections::append(out, line("Same " & toString(len(evs)) & " events, now posted with binary Float (" & modeName(banker) & " rounding):", toneText))
  ELSE
    out = collections::append(out, line("Back to base-10 Money. The same " & toString(len(evs)) & " events (" & modeName(banker) & " rounding):", toneText))
  END IF
  out = collections::append(out, line("", toneText))
  out = collections::append(out, line("Booked amounts with no exact binary form:  " & toString(inexact) & " of " & toString(aligned), toneHead))
  out = collections::append(out, line("Results where Float's raw value differs:   " & toString(rawDiffs) & " of " & toString(aligned), toneHead))
  out = collections::append(out, line("Booked cents that differ:                  " & toString(centDiffs), toneHead))
  IF oneSided > 0 THEN
    out = collections::append(out, line("Entries only one ledger has:               " & toString(oneSided), toneHead))
  END IF
  out = collections::append(out, line("", toneText))
  out = collections::append(out, line(fit("Balance", 13) & fitRight("Money", 13) & "  " & fit("Float (raw)", 24) & "Float - Money", toneHead))
  out = collections::append(out, driftRow("Checking", m.book.checking, f.book.checking))
  out = collections::append(out, driftRow("Savings", m.book.savings, f.book.savings))
  out = collections::append(out, driftRow("401(k)", m.book.retire, f.book.retire))
  out = collections::append(out, driftRow("Expenses YTD", sumMoney(m.book.cats), sumFloat(f.book.cats)))
  out = collections::append(out, line("", toneText))
  IF worstGap > 0.0 THEN
    out = collections::append(out, line("Largest raw gap where the cents still agree (" & fsci(worstGap) & "):", toneHead))
    out = collections::append(out, worstLine)
  END IF
  IF len(samples) > 0 THEN
    out = collections::append(out, line("Where the booked amounts disagree (oldest first):", toneHead))
    out = collections::append(out, samples)
    LET more AS Integer = centDiffs + oneSided - sampled
    IF more > 0 THEN out = collections::append(out, line("  ...and " & toString(more) & " more", toneDim))
  ELSE
    LET drifted AS Boolean = f.book.checking <> toFloat(m.book.checking) OR f.book.savings <> toFloat(m.book.savings) OR f.book.retire <> toFloat(m.book.retire)
    out = collections::append(out, line("No booked cent differs yet: every Float error is under half a cent.", toneText))
    IF drifted THEN
      out = collections::append(out, line("The balances above have drifted from the exact amounts anyway.", toneText))
    ELSE
      out = collections::append(out, line("Every balance is still the closest Float to the exact amount.", toneText))
    END IF
  END IF
  RETURN out
END FUNC

' ------------------------------------------------------- the simulated life

MUT events AS List OF Event = []
MUT mBook AS MBook = openingMoney()
MUT mEntries AS List OF Entry = []
MUT fBook AS FBook = openingFloat()
MUT fEntries AS List OF FEntry = []
MUT logLines AS List OF LogLine = []
MUT viewFloat AS Boolean = FALSE
MUT bankerMode AS Boolean = FALSE
MUT simDay AS Integer = 0
MUT finished AS Boolean = FALSE
MUT salaryCents AS Integer = 7800000
MUT gasMilli AS Integer = 3459
MUT nextEmergencyDay AS Integer = 0
MUT nextGoalDay AS Integer = 0
MUT goalKind AS Integer = -1
MUT goalCents AS Integer = 0
MUT goalMonths AS Integer = 0
MUT goalSaved AS Integer = 0
MUT goalBuyDay AS Integer = -1

FUNC startDate() AS datetime::DateTime
  RETURN datetime::civil(datetime::date(startYear, 1, 1), datetime::time(0, 0, 0), datetime::utc())
END FUNC

FUNC centsToMoney(c AS Integer) AS Money
  RETURN 0.01m * c
END FUNC

' Append narration to the log, dating the first line and wrapping long lines
' at a space so nothing is cut off at the frame edge.
FUNC pushLog(stamp AS String, lines AS List OF LogLine) AS Nothing
  LET width AS Integer = frameWidth - 10
  MUT first AS Boolean = TRUE
  FOR EACH l IN lines
    MUT rest AS String = l.text
    DO WHILE len(rest) > 0
      MUT piece AS String = rest
      IF len(rest) > width THEN
        MUT cut AS Integer = width
        DO WHILE cut > 20 AND strings::mid(rest, cut, 1) <> " "
          cut = cut - 1
        LOOP
        piece = strings::left(rest, cut)
        rest = "  " & strings::trimStart(strings::mid(rest, cut, len(rest) - cut))
      ELSE
        rest = ""
      END IF
      MUT prefix AS String = "      "
      IF first THEN prefix = strings::right(stamp, 5) & " "
      first = FALSE
      logLines = collections::append(logLines, line(prefix & piece, l.tone))
    LOOP
  NEXT
  IF len(logLines) > 200 THEN logLines = collections::drop(logLines, len(logLines) - 100)
END FUNC

FUNC mk(d AS Integer, stamp AS String, y AS Integer, kind AS Kind, label AS String, cat AS Integer, amount AS Money, qty AS Integer, unit AS String, bp AS Integer) AS Event
  RETURN Event[day := d, stamp := stamp, year := y, kind := kind, label := label, cat := cat, amount := amount, qty := qty, unit := unit, bp := bp]
END FUNC

' The day's events. All randomness happens here, once: replays only re-post.
FUNC eventsFor(d AS Integer) AS List OF Event
  LET dt AS datetime::DateTime = datetime::addDays(startDate(), d)
  LET y AS Integer = dt.date.year
  LET mo AS Integer = dt.date.month
  LET dom AS Integer = dt.date.day
  LET wd AS datetime::Weekday = datetime::weekday(dt)
  LET stamp AS String = datetime::format(dt, "yyyy-MM-dd")
  LET lastDay AS Integer = datetime::daysInMonth(y, mo)
  MUT out AS List OF Event = []

  IF d > 0 AND mo = 1 AND dom = 1 THEN
    salaryCents = salaryCents * 103 / 100
    pushLog(stamp, [line("Happy new year: a 3% raise takes the salary to " & fm(centsToMoney(salaryCents)), toneIn)])
  END IF
  IF wd = datetime::Weekday.Monday THEN gasMilli = math::rand(319, 389) * 10 + 9

  IF d >= 1 AND (d - 1) MOD 14 = 0 THEN
    out = collections::append(out, mk(d, stamp, y, Kind.Paycheck, "Paycheck", noCat, centsToMoney(salaryCents / payPeriods), 0, "", 0))
  END IF
  IF mo = 12 AND dom = 15 THEN
    out = collections::append(out, mk(d, stamp, y, Kind.Bonus, "Bonus", noCat, centsToMoney(salaryCents * 8 / 100), 0, "", 0))
  END IF
  IF dom = 1 THEN out = collections::append(out, mk(d, stamp, y, Kind.Bill, "Rent", catHousing, 1850.00m, 0, "", 0))
  IF dom = 3 THEN out = collections::append(out, mk(d, stamp, y, Kind.Bill, "Car Ins", catCar, 142.18m, 0, "", 0))
  IF dom = 5 THEN out = collections::append(out, mk(d, stamp, y, Kind.Metered, "Electric", catUtilities, 0.1537m, math::rand(3500, 9000) * 100, "kWh", 0))
  IF dom = 8 THEN
    MUT therms AS Integer = math::rand(150, 350)
    IF mo <= 3 OR mo >= 11 THEN therms = math::rand(600, 1100)
    out = collections::append(out, mk(d, stamp, y, Kind.Metered, "Gas/Heat", catUtilities, 1.2345m, therms * 100, "therm", 0))
  END IF
  IF dom = 12 THEN out = collections::append(out, mk(d, stamp, y, Kind.Bill, "Internet", catUtilities, 79.99m, 0, "", 0))
  IF dom = 18 THEN out = collections::append(out, mk(d, stamp, y, Kind.Bill, "Phone", catUtilities, 65.00m, 0, "", 0))
  IF dom = 20 THEN out = collections::append(out, mk(d, stamp, y, Kind.Bill, "Netflix", catStreaming, 15.49m, 0, "", 0))
  IF dom = 22 THEN out = collections::append(out, mk(d, stamp, y, Kind.Bill, "Spotify", catStreaming, 11.99m, 0, "", 0))
  IF wd = datetime::Weekday.Monday OR wd = datetime::Weekday.Thursday THEN
    out = collections::append(out, mk(d, stamp, y, Kind.Metered, "Fuel", catFuel, 0.001m * gasMilli, math::rand(6000, 12999), "gal", 0))
  END IF
  IF wd = datetime::Weekday.Saturday THEN
    out = collections::append(out, mk(d, stamp, y, Kind.Taxed, "Groceries", catGroceries, centsToMoney(math::rand(6000, 18000)), 0, "", groceryTaxBp))
  END IF
  IF wd = datetime::Weekday.Friday THEN
    MUT tip AS Integer = 1800
    IF math::rand(0, 2) = 0 THEN tip = 2000
    out = collections::append(out, mk(d, stamp, y, Kind.Dining, "Dining", catDining, centsToMoney(math::rand(2500, 9000)), 0, "", tip))
  END IF
  IF wd = datetime::Weekday.Sunday AND (d / 7) MOD 2 = 0 THEN
    out = collections::append(out, mk(d, stamp, y, Kind.Taxed, "Shopping", catShopping, centsToMoney(math::rand(1500, 12000)), 0, "", shoppingTaxBp))
  END IF
  IF d = nextEmergencyDay THEN
    LET e AS Integer = math::rand(0, len(emergencyLabels) - 1)
    LET bill AS Integer = math::rand(collections::get(emergencyLow, e) * 100, collections::get(emergencyHigh, e) * 100)
    out = collections::append(out, mk(d, stamp, y, Kind.Emergency, collections::get(emergencyLabels, e), catEmergency, centsToMoney(bill), 0, collections::get(emergencyWhat, e), collections::get(emergencyBps, e)))
    nextEmergencyDay = d + math::rand(730, 1095)
  END IF
  IF goalKind < 0 AND d >= nextGoalDay THEN
    goalKind = math::rand(0, len(goalBuyLabels) - 1)
    goalCents = math::rand(collections::get(goalLow, goalKind), collections::get(goalHigh, goalKind)) * 100
    goalMonths = math::rand(collections::get(goalMinMonths, goalKind), collections::get(goalMaxMonths, goalKind))
    goalSaved = 0
    goalBuyDay = -1
    out = collections::append(out, mk(d, stamp, y, Kind.GoalStart, collections::get(goalBuyLabels, goalKind), catGoals, centsToMoney(goalCents), goalMonths, "", 0))
  ELSEIF goalKind >= 0 AND dom = 2 AND goalSaved < goalMonths THEN
    goalSaved = goalSaved + 1
    out = collections::append(out, mk(d, stamp, y, Kind.GoalSave, collections::get(goalFundLabels, goalKind), noCat, centsToMoney(goalCents), goalMonths, "", goalSaved))
    IF goalSaved = goalMonths THEN goalBuyDay = d + 8
  ELSEIF goalKind >= 0 AND d = goalBuyDay THEN
    ' The real price lands within 5% of the estimate that was saved for.
    LET price AS Integer = goalCents / 100 * math::rand(9500, 10500)
    out = collections::append(out, mk(d, stamp, y, Kind.GoalBuy, collections::get(goalBuyLabels, goalKind), catGoals, centsToMoney(price / 100), goalCents, "", collections::get(goalTaxBps, goalKind)))
    goalKind = -1
    nextGoalDay = d + math::rand(90, 365)
  END IF
  IF mo = 4 AND dom = 15 AND y > startYear THEN
    out = collections::append(out, mk(d, stamp, y, Kind.TaxFiling, "Taxes", catFedTax, 0.00m, 0, "", 0))
  END IF
  IF dom = lastDay THEN
    out = collections::append(out, mk(d, stamp, y, Kind.Interest, "Interest", noCat, 0.00m, 0, "", savingsApyBp))
    out = collections::append(out, mk(d, stamp, y, Kind.Market, "Market", noCat, 0.00m, 0, "", math::rand(-350, 450)))
  END IF
  RETURN out
END FUNC

' Record one event and post it to both ledgers; narrate it from the ledger on
' screen.
FUNC record(ev AS Event) AS Nothing
  LET index AS Integer = len(events)
  events = collections::append(events, ev)
  LET mp AS MPost = postMoney(mBook, ev, index, NOT viewFloat)
  mBook = mp.book
  mEntries = collections::append(mEntries, mp.entries)
  LET fp AS FPost = postFloat(fBook, ev, index, bankerMode, viewFloat)
  fBook = fp.book
  fEntries = collections::append(fEntries, fp.entries)
  IF viewFloat THEN
    pushLog(ev.stamp, fp.log)
  ELSE
    pushLog(ev.stamp, mp.log)
  END IF
END FUNC

' One simulated day. The career ends after `careerYears`, which also keeps
' every balance far inside Money's range.
FUNC simulateDay() AS Nothing
  IF finished THEN RETURN
  LET dt AS datetime::DateTime = datetime::addDays(startDate(), simDay)
  IF dt.date.year >= startYear + careerYears THEN
    finished = TRUE
    pushLog("     ", [line("Retired after " & toString(careerYears) & " years and " & toString(len(events)) & " events. r and f still replay the history.", toneTitle)])
    RETURN
  END IF
  FOR EACH ev IN eventsFor(simDay)
    record(ev)
  NEXT
  simDay = simDay + 1
END FUNC

' ------------------------------------------------------------------ drawing

FUNC toneColor(tone AS Integer) AS color::Color
  IF tone = toneIn THEN RETURN color::rgb(110, 220, 120)
  IF tone = toneOut THEN RETURN color::rgb(240, 110, 105)
  IF tone = toneMove THEN RETURN color::rgb(240, 200, 80)
  IF tone = toneTax THEN RETURN color::rgb(215, 140, 235)
  IF tone = toneHead THEN RETURN color::rgb(100, 200, 235)
  IF tone = toneDim THEN RETURN color::rgb(110, 118, 135)
  IF tone = toneFloat THEN RETURN color::rgb(255, 160, 70)
  IF tone = toneTitle THEN RETURN color::rgb(255, 215, 90)
  IF tone = toneBright THEN RETURN color::rgb(250, 250, 250)
  RETURN color::rgb(215, 218, 225)
END FUNC

FUNC put(row AS Integer, col AS Integer, text AS String, tone AS Integer) AS Nothing
  term::setForeground(toneColor(tone))
  term::drawText(row, col, text)
END FUNC

FUNC isMove(label AS String) AS Boolean
  RETURN label = "Top-up" OR label = "Sweep" OR strings::startsWith(label, "To ")
END FUNC

FUNC entryTone(label AS String, posted AS Money) AS Integer
  IF isMove(label) THEN RETURN toneMove
  IF posted < 0.00m THEN RETURN toneOut
  RETURN toneIn
END FUNC

FUNC fEntryTone(label AS String, posted AS Float) AS Integer
  IF isMove(label) THEN RETURN toneMove
  IF posted < 0.0 THEN RETURN toneOut
  RETURN toneIn
END FUNC

' The newest `n` entries for an account, newest first.
FUNC recentRows(acct AS Acct, n AS Integer) AS List OF Row
  MUT out AS List OF Row = []
  IF viewFloat THEN
    MUT i AS Integer = len(fEntries) - 1
    DO WHILE i >= 0 AND len(out) < n
      LET e AS FEntry = collections::get(fEntries, i)
      IF e.acct = acct THEN out = collections::append(out, Row[left := e.label, right := ffPlain(e.posted), tone := fEntryTone(e.label, e.posted)])
      i = i - 1
    LOOP
  ELSE
    MUT i AS Integer = len(mEntries) - 1
    DO WHILE i >= 0 AND len(out) < n
      LET e AS Entry = collections::get(mEntries, i)
      IF e.acct = acct THEN out = collections::append(out, Row[left := e.label, right := fmPlain(e.posted), tone := entryTone(e.label, e.posted)])
      i = i - 1
    LOOP
  END IF
  RETURN out
END FUNC

FUNC expenseRows() AS List OF Row
  MUT out AS List OF Row = []
  FOR c = 0 TO len(catNames) - 1
    MUT text AS String = ""
    MUT zero AS Boolean = FALSE
    IF viewFloat THEN
      LET v AS Float = collections::get(fBook.cats, c)
      text = ffPlain(v)
      zero = v = 0.0
    ELSE
      LET v AS Money = collections::get(mBook.cats, c)
      text = fmPlain(v)
      zero = v = 0.00m
    END IF
    MUT tone AS Integer = toneText
    IF c >= catFedTax AND c <= catFica THEN tone = toneTax
    IF zero THEN tone = toneDim
    out = collections::append(out, Row[left := collections::get(catNames, c), right := text, tone := tone])
  NEXT
  RETURN out
END FUNC

FUNC drawColumn(top AS Integer, col AS Integer, width AS Integer, title AS String, balance AS String, balanceTone AS Integer, rows AS List OF Row, maxRows AS Integer) AS Nothing
  term::setBold(TRUE)
  put(top, col + 1, fit(title, width - 2), toneHead)
  put(top + 1, col, fitRight(balance, width - 1), balanceTone)
  term::setBold(FALSE)
  FOR r = 0 TO maxRows - 1
    IF r < len(rows) THEN
      LET row AS Row = collections::get(rows, r)
      LET amountWidth AS Integer = len(row.right)
      put(top + 3 + r, col + 1, fit(row.left, width - 3 - amountWidth), toneDim)
      put(top + 3 + r, col + width - 1 - amountWidth, row.right, row.tone)
    END IF
  NEXT
END FUNC

FUNC moneyOrFloat(m AS Money, f AS Float) AS String
  IF viewFloat THEN RETURN ff(f)
  RETURN fm(m)
END FUNC

FUNC drawFrame(rows AS Integer, cols AS Integer, paused AS Boolean, speedIndex AS Integer) AS Nothing
  LET left AS Integer = (cols - frameWidth) / 2
  LET right AS Integer = left + frameWidth - 1
  LET bottom AS Integer = rows - 1
  LET divider AS Integer = rows - 5

  term::setBackground(color::rgb(0, 0, 0))
  term::clear()

  ' Border, header rule, column rules, log rule.
  term::setForeground(toneColor(toneDim))
  term::drawBox(term::LineStyle.Double, 0, left, bottom, right)
  term::drawHLine(term::LineStyle.Light, 2, left + 1, right - 1)
  term::drawHLine(term::LineStyle.Light, divider, left + 1, right - 1)
  term::drawGlyph(2, left, 0x255F)
  term::drawGlyph(2, right, 0x2562)
  term::drawGlyph(divider, left, 0x255F)
  term::drawGlyph(divider, right, 0x2562)
  term::drawHLine(term::LineStyle.LightDot, 5, left + 1, right - 1)
  FOR EACH sep IN [20, 40, 59]
    LET x AS Integer = left + sep
    term::drawVLine(term::LineStyle.Light, 3, x, divider - 1)
    term::drawGlyph(2, x, 0x252C)
    term::drawGlyph(divider, x, 0x2534)
  NEXT

  ' Title, centred in the top border.
  LET title AS String = " MONEY DEMO "
  term::setBold(TRUE)
  put(0, left + (frameWidth - len(title)) / 2, title, toneTitle)
  term::setBold(FALSE)

  ' Status line: date, speed, arithmetic and rounding.
  MUT shown AS Integer = simDay - 1
  IF shown < 0 THEN shown = 0
  LET today AS datetime::DateTime = datetime::addDays(startDate(), shown)
  term::setBold(TRUE)
  put(1, left + 2, datetime::format(today, "EEE MMM dd yyyy"), toneBright)
  term::setBold(FALSE)
  IF finished THEN
    put(1, left + 31, "retired", toneTitle)
  ELSEIF paused THEN
    put(1, left + 31, "|| paused", toneMove)
  ELSE
    put(1, left + 31, "> " & toString(collections::get(speeds, speedIndex)) & " days/s", toneIn)
  END IF
  LET rounding AS String = modeName(bankerMode) & " rounding"
  put(1, right - 1 - len(rounding), rounding, toneMove)
  term::setBold(TRUE)
  IF viewFloat THEN
    put(1, right - 4 - len(rounding) - 5, "FLOAT", toneFloat)
  ELSE
    put(1, right - 4 - len(rounding) - 5, "MONEY", toneIn)
  END IF
  term::setBold(FALSE)

  ' The four columns.
  LET listRows AS Integer = divider - 6
  MUT checkTone AS Integer = toneBright
  IF viewFloat THEN
    IF fBook.checking < toFloat(lowChecking) THEN checkTone = toneOut
  ELSE
    IF mBook.checking < lowChecking THEN checkTone = toneOut
  END IF
  drawColumn(3, left + 1, 19, "CHECKING", moneyOrFloat(mBook.checking, fBook.checking), checkTone, recentRows(Acct.Checking, listRows), listRows)
  drawColumn(3, left + 21, 19, "SAVINGS", moneyOrFloat(mBook.savings, fBook.savings), toneBright, recentRows(Acct.Savings, listRows), listRows)
  drawColumn(3, left + 41, 18, "401(K)", moneyOrFloat(mBook.retire, fBook.retire), toneBright, recentRows(Acct.Retire, listRows), listRows)
  LET ytd AS String = "YTD " & moneyOrFloat(sumMoney(mBook.cats), sumFloat(fBook.cats))
  drawColumn(3, left + 60, 19, "EXPENSES " & toString(mBook.year), ytd, toneOut, expenseRows(), listRows)

  ' The three newest log lines.
  LET nLog AS Integer = len(logLines)
  FOR r = 0 TO 2
    LET idx AS Integer = nLog - 3 + r
    IF idx >= 0 THEN
      LET l AS LogLine = collections::get(logLines, idx)
      put(divider + 1 + r, left + 2, fit(l.text, frameWidth - 4), l.tone)
    END IF
  NEXT

  ' Key help, in the bottom border.
  LET keys AS List OF String = ["space", "+/-", "r", "f", "q"]
  LET what AS List OF String = ["pause", "speed", "rounding", "money/float", "quit"]
  MUT helpWidth AS Integer = 0
  FOR k = 0 TO len(keys) - 1
    helpWidth = helpWidth + len(collections::get(keys, k)) + len(collections::get(what, k)) + 3
  NEXT
  MUT x AS Integer = left + (frameWidth - helpWidth) / 2
  FOR k = 0 TO len(keys) - 1
    LET keyText AS String = " " & collections::get(keys, k)
    LET whatText AS String = " " & collections::get(what, k) & " "
    put(bottom, x, keyText, toneMove)
    put(bottom, x + len(keyText), whatText, toneDim)
    x = x + len(keyText) + len(whatText)
  NEXT
END FUNC

FUNC drawModal(rows AS Integer, cols AS Integer, title AS String, accent AS Integer, lines AS List OF LogLine) AS Nothing
  LET width AS Integer = 76
  LET left AS Integer = (cols - width) / 2
  MUT shown AS Integer = len(lines)
  IF shown > rows - 4 THEN shown = rows - 4
  LET height AS Integer = shown + 4
  LET top AS Integer = (rows - height) / 2
  term::setBackground(color::rgb(18, 22, 38))
  FOR r = 0 TO height - 1
    term::drawText(top + r, left, strings::repeat(" ", width))
  NEXT
  term::setForeground(toneColor(accent))
  term::drawBox(term::LineStyle.Light, top, left, top + height - 1, left + width - 1)
  term::setBold(TRUE)
  put(top, left + 2, " " & title & " ", accent)
  term::setBold(FALSE)
  FOR r = 0 TO shown - 1
    LET l AS LogLine = collections::get(lines, r)
    put(top + 2 + r, left + 2, fit(l.text, width - 4), l.tone)
  NEXT
  LET footer AS String = " any key to continue "
  put(top + height - 1, left + width - 2 - len(footer), footer, toneDim)
  term::setBackground(color::rgb(0, 0, 0))
END FUNC

' The next key within `ms` milliseconds, "" when none came, "EOF" when input
' has ended.
FUNC nextKey(ms AS Integer) AS String
  LET k AS io::Key = io::readKey(ms) TRAP(e)
    IF e.code = errorCode::ErrTimeout THEN RETURN ""
    RETURN "EOF"
  END TRAP
  IF k.event = io::KeyEvent.Release THEN RETURN ""
  RETURN k.grapheme
END FUNC

FUNC main AS Integer
  IF NOT io::isOutputTerminal() OR NOT io::isInputTerminal() THEN
    io::printError("money-demo: run this from an interactive terminal.")
    RETURN 1
  END IF

  math::seed(20260101)
  nextEmergencyDay = math::rand(240, 900)
  nextGoalDay = math::rand(60, 240)
  money::setRounding(money::Rounding.Commercial)
  term::on()
  term::hideCursor()
  pushLog("     ", [line("Welcome. Starting balances: checking $2,500.00, savings $8,000.00, 401(k) $25,000.00.", toneHead)])

  MUT running AS Boolean = TRUE
  MUT paused AS Boolean = FALSE
  MUT speedIndex AS Integer = 2
  MUT modalOpen AS Boolean = FALSE
  MUT modalTitle AS String = ""
  MUT modalAccent AS Integer = toneHead
  MUT modalLines AS List OF LogLine = []
  MUT dayCarry AS Integer = 0
  MUT nextFrameAt AS Integer = datetime::monotonicNanos() + frameMs * 1000000

  DO WHILE running
    LET size AS term::TermSize = term::terminalSize() TRAP(e)
      EXIT DO
    END TRAP

    IF size.columns < frameWidth OR size.rows < minRows THEN
      term::setBackground(color::rgb(0, 0, 0))
      term::clear()
      put(0, 0, "Money Demo needs at least 80x25 (this is " & toString(size.columns) & "x" & toString(size.rows) & "). q quits.", toneText)
      term::sync()
      LET smallKey AS String = nextKey(100)
      IF smallKey = "q" OR smallKey = "Q" OR smallKey = "EOF" THEN running = FALSE
      CONTINUE DO
    END IF

    drawFrame(size.rows, size.columns, paused, speedIndex)
    IF modalOpen THEN drawModal(size.rows, size.columns, modalTitle, modalAccent, modalLines)
    term::sync()

    MUT waitMs AS Integer = (nextFrameAt - datetime::monotonicNanos()) / 1000000
    IF waitMs < 0 THEN waitMs = 0
    IF waitMs > frameMs THEN waitMs = frameMs
    LET key AS String = nextKey(waitMs)

    IF key = "EOF" THEN
      running = FALSE
    ELSEIF key <> "" AND modalOpen THEN
      modalOpen = FALSE
    ELSEIF key = "q" OR key = "Q" THEN
      running = FALSE
    ELSEIF key = " " THEN
      paused = NOT paused
    ELSEIF key = "+" OR key = "=" THEN
      IF speedIndex < len(speeds) - 1 THEN speedIndex = speedIndex + 1
    ELSEIF key = "-" OR key = "_" THEN
      IF speedIndex > 0 THEN speedIndex = speedIndex - 1
    ELSEIF key = "r" OR key = "R" THEN
      LET wasBanker AS Boolean = bankerMode
      LET beforeM AS MPost = MPost[book := mBook, entries := mEntries, log := []]
      LET beforeF AS FPost = FPost[book := fBook, entries := fEntries, log := []]
      bankerMode = NOT bankerMode
      IF bankerMode THEN
        money::setRounding(money::Rounding.Banker)
      ELSE
        money::setRounding(money::Rounding.Commercial)
      END IF
      LET afterM AS MPost = replayMoney(events)
      LET afterF AS FPost = replayFloat(events, bankerMode)
      modalLines = roundingReport(events, beforeM, afterM, wasBanker, beforeF, afterF)
      modalTitle = "Rounding: " & modeName(wasBanker) & " -> " & modeName(bankerMode)
      modalAccent = toneMove
      modalOpen = TRUE
      mBook = afterM.book
      mEntries = afterM.entries
      fBook = afterF.book
      fEntries = afterF.entries
      pushLog("     ", [line("Switched to " & modeName(bankerMode) & " rounding: replayed " & toString(len(events)) & " events.", toneMove)])
    ELSEIF key = "f" OR key = "F" THEN
      viewFloat = NOT viewFloat
      modalLines = floatReport(events, MPost[book := mBook, entries := mEntries, log := []], FPost[book := fBook, entries := fEntries, log := []], viewFloat, bankerMode)
      IF viewFloat THEN
        modalTitle = "Money -> Float"
        modalAccent = toneFloat
      ELSE
        modalTitle = "Float -> Money"
        modalAccent = toneIn
      END IF
      modalOpen = TRUE
      MUT viewName AS String = "Money"
      IF viewFloat THEN viewName = "Float"
      pushLog("     ", [line("Now viewing the " & viewName & " ledger.", toneFloat)])
    END IF

    IF datetime::monotonicNanos() >= nextFrameAt THEN
      nextFrameAt = datetime::monotonicNanos() + frameMs * 1000000
      IF NOT paused AND NOT modalOpen THEN
        dayCarry = dayCarry + collections::get(speeds, speedIndex) * frameMs
        DO WHILE dayCarry >= 1000
          simulateDay()
          dayCarry = dayCarry - 1000
        LOOP
      END IF
    END IF
  LOOP

  term::showCursor()
  term::off()
  RETURN 0

  TRAP(e)
    term::showCursor()
    term::off()
    io::printError("money-demo: " & e.message)
    RETURN 1
  END TRAP
END FUNC
