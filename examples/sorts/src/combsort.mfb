' combsort - sorts `order` one comparison at a time.
'
' A bubble sort over elements `gap` apart, with the gap shrinking by 1.3 each
' pass. Wide gaps carry small elements stuck near the end forward quickly - the
' thing that makes a bubble sort slow. Once the gap is 1 it keeps passing until
' a pass swaps nothing. Nothing is in its final place until then.

IMPORT math

MUT combGap AS Integer = 0
MUT combScan AS Integer = 0
MUT combSwapped AS Boolean = FALSE
MUT combFinished AS Boolean = FALSE
MUT combCompareCount AS Integer = 0

' The next gap: the last one divided by 1.3, but never below 1.
FUNC combShrink(gap AS Integer) AS Integer
  RETURN math::max(1, math::floor(toFloat(gap) / 1.3))
END FUNC

FUNC combStart AS Nothing
  combGap = combShrink(DOT_COUNT)
  combScan = 0
  combSwapped = FALSE
  combFinished = DOT_COUNT < 2
  combCompareCount = 0
END FUNC

FUNC combDone AS Boolean
  RETURN combFinished
END FUNC

FUNC combCompares AS Integer
  RETURN combCompareCount
END FUNC

' Run up to `budget` comparisons.
FUNC combSteps(budget AS Integer) AS Nothing
  MUT left AS Integer = budget
  DO WHILE left > 0 AND NOT combFinished
    IF combScan + combGap < DOT_COUNT THEN
      IF orderAt(combScan) > orderAt(combScan + combGap) THEN
        swapOrder(combScan, combScan + combGap)
        combSwapped = TRUE
      END IF
      combScan = combScan + 1
      combCompareCount = combCompareCount + 1
      left = left - 1
    ELSE
      IF combGap = 1 AND NOT combSwapped THEN combFinished = TRUE
      combGap = combShrink(combGap)
      combScan = 0
      combSwapped = FALSE
    END IF
  LOOP
END FUNC
