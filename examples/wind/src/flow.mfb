' flow - the streamlines.
'
' A streamline visualisation is one idea repeated a few thousand times: drop a
' massless particle on the map, push it along by whatever the wind is at the
' place it currently occupies, draw the path it took, and after a while pick it
' up and drop it somewhere else. The wind field is a still picture - one
' forecast hour, not a movie - so what is animated is the tracer, not the
' weather. What you are watching is the shape of the field.
'
' Three details make the difference between that idea and a picture worth
' looking at:
'
'   Particles are retired on a schedule, not when they leave the map. Left to
'   run, every particle is eventually swept into a convergence zone and the
'   picture collapses into a few bright knots over empty ocean. A fixed life,
'   staggered across the swarm so they do not all expire at once, keeps the
'   coverage even.
'
'   Trails are kept in projected plane coordinates. They survive a pan or a
'   zoom untouched, and redrawing one costs a multiply and an add per point
'   rather than a re-projection. Only spinning the world re-projects them.
'
'   New particles are scattered over the window, not over the world. Uniform
'   longitude and latitude would pile them at the poles, where an equal-area
'   projection gives them the least room; and once you have zoomed into the
'   North Atlantic, particles seeded over the Pacific are pure waste.
'
' Particles come in pairs that chase each other. A leader is dropped somewhere
' new; its follower is dropped on the very same spot half a lifetime later.
' Because the field is still, the follower retraces the leader's path exactly,
' so every streamline carries two comets, half a life apart, instead of one.
'
' The swarm is module-level state rather than a value threaded through the
' frame. Every one of its lists is updated with the self-assigning shape -
' `xs = collections::set(xs, i, v)` - which changes the list where it stands
' instead of building a new one, on a module-level MUT exactly as on a local.

IMPORT canvas
IMPORT collections
IMPORT color
IMPORT math

' The u and v components of one forecast hour, and what to call it on screen.
TYPE Winds
  east AS Field        ' UGRD: metres per second towards the east
  north AS Field       ' VGRD: metres per second towards the north
  label AS String
END TYPE

' A wind, in the two directions it has.
TYPE Vector
  east AS Float
  north AS Float
END TYPE

' ---------------------------------------------------------------------------
' Tuning
' ---------------------------------------------------------------------------

' How many degrees a second a one-metre-per-second wind carries a particle. The
' real answer is about 0.0009, which would be a still picture; this is a display
' speed, chosen so that a 10 m/s wind reads as a steady drift and a 40 m/s jet
' streak reads as fast.
LET DRIFT_RATE AS Float = 1.15

' How many positions of a particle's history are kept. The trail is drawn as
' this many points joined by lines, so it is also the cost: the scene carries
' roughly particleCount() * (TRAIL_LENGTH - 1) lines.
LET TRAIL_LENGTH AS Integer = 12

' How many frames a particle lives before it is picked up and dropped somewhere
' else.
LET PARTICLE_LIFE AS Integer = 190

' One streamline - a leader and its follower - per this many square pixels of
' window, within the bounds. The bounds count streamlines too, so the swarm
' holds twice as many particles.
LET PIXELS_PER_PARTICLE AS Float = 1100.0

LET MIN_PARTICLES AS Integer = 250

LET MAX_PARTICLES AS Integer = 1600

' Metres in a degree of latitude, and in a degree of longitude at the equator.
LET METRES_PER_DEGREE AS Float = 111320.0

' The wind speed, in metres per second, that the colour ramp treats as its top.
LET FAST_WIND AS Float = 32.0

' ---------------------------------------------------------------------------
' Sampling the field
' ---------------------------------------------------------------------------

' One field, sampled with bilinear interpolation at an arbitrary place.
'
' Longitude wraps - column ni - 1 is a neighbour of column 0, because the grid
' goes all the way round - and latitude clamps, because it does not: there is no
' row above the north pole to interpolate towards.
FUNC sampleField(f AS Field, g AS Geo) AS Float
  LET columns AS Float = toFloat(f.ni)
  MUT x AS Float = (g.lon - f.lon1) / f.dlon
  x = x - columns * toFloat(math::floor(x / columns))

  LET lastRow AS Integer = math::max(f.nj - 2, 0)
  LET y AS Float = math::clamp((f.lat1 - g.lat) / f.dlat, 0.0, toFloat(lastRow))

  LET i0 AS Integer = math::min(math::floor(x), f.ni - 1) MOD f.ni
  LET i1 AS Integer = (i0 + 1) MOD f.ni
  LET j0 AS Integer = math::min(math::floor(y), lastRow)
  LET j1 AS Integer = math::min(j0 + 1, f.nj - 1)

  LET fx AS Float = math::clamp(x - toFloat(i0), 0.0, 1.0)
  LET fy AS Float = math::clamp(y - toFloat(j0), 0.0, 1.0)

  LET topLeft AS Float = collections::get(f.values, j0 * f.ni + i0)
  LET topRight AS Float = collections::get(f.values, j0 * f.ni + i1)
  LET bottomLeft AS Float = collections::get(f.values, j1 * f.ni + i0)
  LET bottomRight AS Float = collections::get(f.values, j1 * f.ni + i1)

  LET top AS Float = topLeft + (topRight - topLeft) * fx
  LET bottom AS Float = bottomLeft + (bottomRight - bottomLeft) * fx
  RETURN top + (bottom - top) * fy
END FUNC

FUNC windAt(w AS Winds, g AS Geo) AS Vector
  RETURN Vector[east := sampleField(w.east, g), north := sampleField(w.north, g)]
END FUNC

FUNC speedOf(wind AS Vector) AS Float
  RETURN math::sqrt(wind.east * wind.east + wind.north * wind.north)
END FUNC

' ---------------------------------------------------------------------------
' The swarm
' ---------------------------------------------------------------------------
'
' Parallel lists rather than a List OF Particle. A particle record holding its
' own trail would be the natural shape, but reading one particle out of a list
' with collections::get gives back a copy of the whole particle, trail and all,
' and writing it back copies it again - every particle, every frame. Lists of
' plain numbers are read and written where they stand, so here there are eleven
' lists, all sized once.
'
' Particles are stored in pairs: an even index is a leader, the odd index after
' it is that leader's follower.

MUT swarmLon AS List OF Float = []
MUT swarmLat AS List OF Float = []
MUT swarmAge AS List OF Integer = []      ' frames lived, counting from 0; below 0, still waiting to start
MUT swarmLife AS List OF Integer = []     ' frames this particle gets
MUT swarmSpeed AS List OF Float = []      ' the wind it last sat in, m/s
MUT swarmStartLon AS List OF Float = []   ' where this particle was last dropped
MUT swarmStartLat AS List OF Float = []

' Trails, TRAIL_LENGTH points per particle, used as a ring buffer. Every
' particle advances on the same frame, so one shared write position serves the
' whole swarm - particle i's newest point is always at i * TRAIL_LENGTH +
' trailHead.
'
' Each point is kept twice: as a place (trailLon/trailLat), and projected onto
' the plane of a map centred on trailLon0 (trailX/trailY), which is what a frame
' draws. Spinning the world re-projects the places once (reprojectTrails), so a
' frame that did not spin costs no projection at all.
MUT trailLon AS List OF Float = []
MUT trailLat AS List OF Float = []
MUT trailX AS List OF Float = []
MUT trailY AS List OF Float = []
MUT trailHead AS Integer = 0
MUT trailLon0 AS Float = 0.0

' Re-project every trail point for a map centred on lon0, when that has changed.
SUB reprojectTrails(lon0 AS Float)
  IF lon0 = trailLon0 THEN EXIT SUB
  trailLon0 = lon0
  FOR k = 0 TO len(trailLon) - 1
    LET p AS Plane = project(Geo[lon := collections::get(trailLon, k), lat := collections::get(trailLat, k)], lon0)
    trailX = collections::set(trailX, k, p.x)
    trailY = collections::set(trailY, k, p.y)
  NEXT
END SUB

' Record point k of the trails: the place, and where it lands on today's map.
SUB setTrailPoint(k AS Integer, g AS Geo)
  LET p AS Plane = project(g, trailLon0)
  trailLon = collections::set(trailLon, k, g.lon)
  trailLat = collections::set(trailLat, k, g.lat)
  trailX = collections::set(trailX, k, p.x)
  trailY = collections::set(trailY, k, p.y)
END SUB

FUNC particleCount AS Integer
  RETURN len(swarmLon)
END FUNC

' How many particles a window of this size should carry: two per streamline.
FUNC countFor(v AS View) AS Integer
  LET area AS Float = v.width * v.height
  RETURN 2 * math::clamp(math::floor(area / PIXELS_PER_PARTICLE), MIN_PARTICLES, MAX_PARTICLES)
END FUNC

' A random Float in [0, 1).
FUNC unitRandom AS Float
  RETURN toFloat(math::rand(0, 999999)) / 1000000.0
END FUNC

' A place to drop a particle: a uniform point in the window, turned back into
' longitude and latitude. Points that land off the edge of the map - the corners
' beside the poles, which the projection leaves empty - are retried, and after
' enough tries the middle of the view is used so that this always terminates.
FUNC birthplace(v AS View) AS Geo
  FOR attempt = 1 TO 24
    LET candidate AS Unprojected = unproject(toPlane(v, unitRandom() * v.width, unitRandom() * v.height), v.lon0)
    IF candidate.inside AND math::abs(candidate.place.lat) < 88.0 THEN RETURN candidate.place
  NEXT
  RETURN unproject(Plane[x := v.cx, y := v.cy], v.lon0).place
END FUNC

' Put particle i at a place, with its whole trail collapsed onto that one point
' so it has nothing to draw until it has moved. A negative age holds it there,
' unmoved and undrawn, for that many frames.
SUB placeParticle(i AS Integer, g AS Geo, life AS Integer, age AS Integer)
  swarmLon = collections::set(swarmLon, i, g.lon)
  swarmLat = collections::set(swarmLat, i, g.lat)
  swarmAge = collections::set(swarmAge, i, age)
  swarmLife = collections::set(swarmLife, i, life)
  swarmSpeed = collections::set(swarmSpeed, i, 0.0)
  swarmStartLon = collections::set(swarmStartLon, i, g.lon)
  swarmStartLat = collections::set(swarmStartLat, i, g.lat)

  LET base AS Integer = i * TRAIL_LENGTH
  FOR slot = 0 TO TRAIL_LENGTH - 1
    setTrailPoint(base + slot, g)
  NEXT
END SUB

' A staggered life, so that a swarm seeded all at once does not expire all at
' once and leave the map blank every PARTICLE_LIFE frames. Drawn once per pair,
' when the swarm is seeded, and kept: a leader whose next life were shorter than
' its last would be half-way along its new path before its follower had finished
' the old one, and the pair would drift out of step.
FUNC staggeredLife AS Integer
  RETURN PARTICLE_LIFE / 2 + math::rand(0, PARTICLE_LIFE)
END FUNC

' Drop follower i on the spot its leader (i - 1) was last dropped, timed to start
' half the leader's life behind it.
'
' A follower normally arrives with its leader less than half a life along, and
' waits out the difference. It arrives late only when its leader was retired
' early near a pole and dropped again while the follower was still out; then it
' starts at once, and gives up as much of this life as it is late, so the next
' drop finds the pair half a life apart again.
SUB placeFollower(i AS Integer)
  LET leader AS Integer = i - 1
  LET life AS Integer = collections::get(swarmLife, leader)
  LET late AS Integer = collections::get(swarmAge, leader) - life / 2
  LET start AS Geo = Geo[lon := collections::get(swarmStartLon, leader), lat := collections::get(swarmStartLat, leader)]
  IF late > 0 THEN
    placeParticle(i, start, life - late, 0)
  ELSE
    placeParticle(i, start, life, late)
  END IF
END SUB

' Drop particle i again once its life is over: a leader somewhere new, for the
' same life it had, and a follower after its leader.
SUB respawnParticle(i AS Integer, v AS View)
  IF i MOD 2 = 1 THEN
    placeFollower(i)
  ELSE
    placeParticle(i, birthplace(v), collections::get(swarmLife, i), 0)
  END IF
END SUB

' Build a swarm of `count` particles - count / 2 leader and follower pairs -
' scattered over the view. Called at startup and again whenever the window
' changes size enough to want a different number.
SUB seedSwarm(count AS Integer, v AS View)
  swarmLon = []
  swarmLat = []
  swarmAge = []
  swarmLife = []
  swarmSpeed = []
  swarmStartLon = []
  swarmStartLat = []
  trailLon = []
  trailLat = []
  trailX = []
  trailY = []
  trailLon0 = v.lon0
  trailHead = 0

  FOR i = 1 TO count
    swarmLon = collections::append(swarmLon, 0.0)
    swarmLat = collections::append(swarmLat, 0.0)
    swarmAge = collections::append(swarmAge, 0)
    swarmLife = collections::append(swarmLife, 0)
    swarmSpeed = collections::append(swarmSpeed, 0.0)
    swarmStartLon = collections::append(swarmStartLon, 0.0)
    swarmStartLat = collections::append(swarmStartLat, 0.0)
    FOR slot = 1 TO TRAIL_LENGTH
      trailLon = collections::append(trailLon, 0.0)
      trailLat = collections::append(trailLat, 0.0)
      trailX = collections::append(trailX, 0.0)
      trailY = collections::append(trailY, 0.0)
    NEXT
  NEXT

  FOR i = 0 TO count - 1
    IF i MOD 2 = 1 THEN
      placeFollower(i)
    ELSE
      placeParticle(i, birthplace(v), staggeredLife(), 0)
    END IF
  NEXT
END SUB

' Advance the whole swarm by dt seconds of animation.
'
' A degree of longitude shrinks towards the poles, so an eastward wind turns
' into more degrees the further north it blows. The 0.12 floor on that cosine
' stops the division running away above 83 degrees, where a particle would
' otherwise be flung right round the world in a frame; particles that get that
' far are retired on the next line anyway.
SUB stepSwarm(w AS Winds, v AS View, dt AS Float)
  LET count AS Integer = particleCount()
  IF count = 0 THEN EXIT SUB

  trailHead = (trailHead + 1) MOD TRAIL_LENGTH
  LET drift AS Float = DRIFT_RATE * dt

  FOR i = 0 TO count - 1
    LET age AS Integer = collections::get(swarmAge, i) + 1
    IF age <= 0 THEN
      ' A follower still waiting for its leader to get half a life ahead.
      swarmAge = collections::set(swarmAge, i, age)
      CONTINUE FOR
    END IF
    MUT lat AS Float = collections::get(swarmLat, i)

    IF age > collections::get(swarmLife, i) OR math::abs(lat) > 87.0 THEN
      respawnParticle(i, v)
      CONTINUE FOR
    END IF

    MUT lon AS Float = collections::get(swarmLon, i)
    LET wind AS Vector = windAt(w, Geo[lon := lon, lat := lat])
    LET shrink AS Float = math::max(math::cos(radians(lat)), 0.12)

    lon = wrapLon(lon + wind.east * drift / shrink)
    lat = math::clamp(lat + wind.north * drift, -89.5, 89.5)

    swarmLon = collections::set(swarmLon, i, lon)
    swarmLat = collections::set(swarmLat, i, lat)
    swarmAge = collections::set(swarmAge, i, age)
    swarmSpeed = collections::set(swarmSpeed, i, speedOf(wind))

    setTrailPoint(i * TRAIL_LENGTH + trailHead, Geo[lon := lon, lat := lat])
  NEXT
END SUB

' ---------------------------------------------------------------------------
' Drawing the swarm
' ---------------------------------------------------------------------------

' The colour of a particle moving at `speed`, from a cool slow blue through to a
' warm fast cream. The ramp is square-rooted because most of the atmosphere is
' slow: on a linear ramp almost every particle on the map would be the same
' blue, and only the jet streams would carry any colour at all.
FUNC speedColor(speed AS Float) AS color::Color
  LET t AS Float = math::sqrt(math::clamp(speed / FAST_WIND, 0.0, 1.0))
  RETURN color::rgb(120 + math::floor(t * 135.0), 170 + math::floor(t * 70.0), 215 - math::floor(t * 55.0))
END FUNC

' Every particle's trail, as lines in window coordinates.
'
' A trail is drawn newest segment first, fading towards the tail, so a particle
' reads as having a head and a direction rather than as a worm of even
' brightness. Two segments are skipped rather than drawn: one whose particle is
' younger than the segment - a freshly dropped particle has no history yet - and
' one that spans more than half the map, which is what the antimeridian looks
' like when a particle crosses it and its longitude wraps.
FUNC trailItems(v AS View) AS List OF canvas::DrawItem
  MUT items AS List OF canvas::DrawItem = []
  LET count AS Integer = particleCount()
  LET trail AS Integer = TRAIL_LENGTH
  LET segments AS Integer = trail - 1
  IF count = 0 OR segments < 1 THEN RETURN items

  LET box AS Box = viewBox(v, 0.02)
  LET wrapLimit AS Float = PLANE_HALF_WIDTH

  FOR i = 0 TO count - 1
    LET age AS Integer = collections::get(swarmAge, i)
    IF age < 1 THEN CONTINUE FOR
    LET base AS Integer = i * trail
    LET drawable AS Integer = math::min(segments, age)
    LET tint AS color::Color = speedColor(collections::get(swarmSpeed, i))

    FOR k = 0 TO drawable - 1
      ' Slot (trailHead - k) is the k-th most recent point; the + trail keeps
      ' the subtraction positive before it is folded back into the ring.
      LET newer AS Integer = base + ((trailHead - k + trail) MOD trail)
      LET older AS Integer = base + ((trailHead - k - 1 + trail) MOD trail)
      LET ax AS Float = collections::get(trailX, newer)
      LET ay AS Float = collections::get(trailY, newer)
      LET bx AS Float = collections::get(trailX, older)
      LET by AS Float = collections::get(trailY, older)

      IF math::abs(ax - bx) > wrapLimit THEN CONTINUE FOR
      IF NOT overlaps(Box[minX := math::min(ax, bx), minY := math::min(ay, by), maxX := math::max(ax, bx), maxY := math::max(ay, by)], box) THEN CONTINUE FOR

      LET head AS canvas::Point = toScreen(v, Plane[x := ax, y := ay])
      LET tail AS canvas::Point = toScreen(v, Plane[x := bx, y := by])
      LET fade AS Float = 1.0 - toFloat(k) / toFloat(segments)
      LET paint AS canvas::Paint = canvas::stroke(color::withAlpha(tint, 40 + math::floor(fade * 195.0)), 1.35)
      LET segment AS canvas::DrawItem = canvas::Line[x1 := head.x, y1 := head.y, x2 := tail.x, y2 := tail.y, cap := canvas::CapStyle.Round, paint := paint]
      items = collections::append(items, segment)
    NEXT
  NEXT

  RETURN items
END FUNC
