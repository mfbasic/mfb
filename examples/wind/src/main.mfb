' wind - NOAA's global 10 m wind field, drawn as streamlines on an Equal Earth
' map.
'
' The program downloads the latest GFS analysis from NOAA NOMADS, decodes the
' GRIB2 it arrives in, and animates a few thousand massless tracers through the
' field. Once that is on screen, a worker thread fetches the next five days of
' the same run's forecast, and when the last of it is in, the forecast plays:
' the wind under the tracers changes hour by hour along a tracker at the bottom
' of the window. Nothing is bundled but the coastline.
'
' Build and run it (canvas needs a window, so this is an --app program):
'   mfb build examples/wind
'   open examples/wind/build/wind.app          (macOS)
'   ./examples/wind/build/wind.AppImage        (Linux)
'
' Controls:
'   q e            zoom in, zoom out
'   a d            spin the world west, east (it wraps all the way round)
'   w s            pan up, down
'   arrow keys     the same as w a s d
'   f              fullscreen on or off
'   r              back to the whole world
'   h              hide or show the captions
'   space          play or stop the forecast
'   esc            quit
'
' The mouse works the button and the tracker: click the button to play or stop,
' and click or drag along the tracker to go to a moment of the forecast.
'
' The program is in eight files:
'   grib.mfb      GRIB2: messages, sections, and the two packings NCEP writes
'   fetch.mfb     which GFS cycle to ask NOMADS for, and the on-disk cache
'   forecast.mfb  the worker thread that fetches the five-day forecast
'   earth.mfb     the Equal Earth projection, and the window onto it
'   land.mfb      the coastline resource, and the blue-and-green underlay
'   flow.mfb      sampling the field, and the swarm of tracers over it
'   timeline.mfb  the play/stop button and the tracker
'   main.mfb      the font, the keys, the mouse, and the frame loop
'
' The first run downloads about half a megabyte and takes a moment to decode
' before the map appears, then about 23 megabytes more in the background for
' the forecast; later runs of the same GFS cycle read the cached files instead.

IMPORT app
IMPORT canvas
IMPORT collections
IMPORT color
IMPORT datetime
IMPORT errorCode
IMPORT fs
IMPORT io
IMPORT math
IMPORT os
IMPORT thread

' ---------------------------------------------------------------------------
' The font
' ---------------------------------------------------------------------------

' canvas::loadFont reads TrueType outlines, so every candidate here is a plain
' .ttf - not a .ttc collection and not an .otf with PostScript outlines. The
' captions are the only text in the program, so a missing font is fatal but
' cheap to diagnose.
FUNC systemFontPath AS String
  MUT candidates AS List OF String = []
  IF os::name() = "macos" THEN
    candidates = ["/System/Library/Fonts/Supplemental/Arial.ttf", "/System/Library/Fonts/Supplemental/Verdana.ttf", "/System/Library/Fonts/Geneva.ttf", "/System/Library/Fonts/Monaco.ttf"]
  ELSE
    candidates = ["/usr/share/fonts/truetype/dejavu/DejaVuSans.ttf", "/usr/share/fonts/TTF/DejaVuSans.ttf", "/usr/share/fonts/dejavu/DejaVuSans.ttf", "/usr/share/fonts/truetype/liberation/LiberationSans-Regular.ttf", "/usr/share/fonts/liberation-sans/LiberationSans-Regular.ttf"]
  END IF

  FOR EACH path IN candidates
    IF fs::fileExists(path) THEN RETURN path
  NEXT
  RETURN ""
END FUNC

' ---------------------------------------------------------------------------
' Input
' ---------------------------------------------------------------------------

FUNC pending(ms AS Integer) AS Boolean
  RETURN io::pollInput(ms)
END FUNC

' One character of input, or "" once there is no more. Only the two failures a
' keyboard can actually produce are answered here: the end of input, which
' readKey turns into a quit, and a byte that is not UTF-8, which is a key this
' program has no use for. Anything else is a real failure and goes on up.
FUNC nextChar AS String
  RETURN io::readChar()

  TRAP(e)
    IF e.code = errorCode::ErrEndOfFile THEN RETURN ""
    IF e.code = errorCode::ErrEncoding THEN RETURN "\u{FFFD}"
    PROPAGATE
  END TRAP
END FUNC

' One key press, with the arrow keys named.
'
' An arrow arrives as an escape sequence - escape, then "[" or "O", then a
' letter - so a lone escape byte with nothing behind it is the Esc key and one
' with more behind it is the start of a sequence. Anything else in a sequence is
' read off and reported as "", which does nothing.
FUNC readKey AS String
  LET first AS String = nextChar()
  IF first = "" THEN RETURN "EOF"
  IF first <> "\u{1B}" THEN RETURN first
  IF NOT pending(20) THEN RETURN "ESC"

  LET bracket AS String = nextChar()
  IF bracket <> "[" AND bracket <> "O" THEN RETURN ""
  IF NOT pending(20) THEN RETURN ""

  MATCH nextChar()
    CASE "A" : RETURN "UP"
    CASE "B" : RETURN "DOWN"
    CASE "C" : RETURN "RIGHT"
    CASE "D" : RETURN "LEFT"
    CASE ELSE : RETURN ""
  END MATCH
END FUNC

' Hold the window open until the reader has had a chance to read something off
' it. Used only for the failure screen, where returning would close the window
' before the message could be read.
SUB waitForKey
  DO WHILE TRUE
    IF pending(200) THEN
      IF readKey() <> "" THEN EXIT SUB
    END IF
  LOOP
END SUB

' ---------------------------------------------------------------------------
' Commands
' ---------------------------------------------------------------------------

TYPE Pan
  dx AS Float          ' fractions of the window
  dy AS Float
END TYPE

TYPE Zoom
  factor AS Float
END TYPE

TYPE Spin
  fraction AS Float    ' of the window, east positive
END TYPE

TYPE Reset
END TYPE

TYPE ToggleCaptions
END TYPE

TYPE ToggleFullscreen
END TYPE

TYPE TogglePlay
END TYPE

TYPE Quit
END TYPE

TYPE Ignore
END TYPE

UNION Command
  Pan
  Spin
  Zoom
  Reset
  ToggleCaptions
  ToggleFullscreen
  TogglePlay
  Quit
  Ignore
END UNION

' How far one press pans or spins, as a fraction of the window.
LET PAN_STEP AS Float = 0.09

' What one press of the zoom keys multiplies the scale by.
LET ZOOM_STEP AS Float = 1.18

FUNC commandFor(key AS String) AS Command
  MATCH key
    CASE "w", "W", "UP" : RETURN Pan[dx := 0.0, dy := PAN_STEP]
    CASE "s", "S", "DOWN" : RETURN Pan[dx := 0.0, dy := -PAN_STEP]
    CASE "a", "A", "LEFT" : RETURN Spin[fraction := -PAN_STEP]
    CASE "d", "D", "RIGHT" : RETURN Spin[fraction := PAN_STEP]
    CASE "q", "Q" : RETURN Zoom[factor := ZOOM_STEP]
    CASE "e", "E" : RETURN Zoom[factor := 1.0 / ZOOM_STEP]
    CASE "r", "R" : RETURN Reset[]
    CASE "h", "H" : RETURN ToggleCaptions[]
    CASE "f", "F" : RETURN ToggleFullscreen[]
    CASE " " : RETURN TogglePlay[]
    CASE "ESC", "EOF" : RETURN Quit[]
    CASE ELSE : RETURN Ignore[]
  END MATCH
END FUNC

' ---------------------------------------------------------------------------
' The captions
' ---------------------------------------------------------------------------

LET CAPTION_COLOR AS color::Color = color::rgb(198, 214, 226)

LET HINT_COLOR AS color::Color = color::rgb(120, 140, 158)

' A caption size that holds still at any window size, within readable bounds.
FUNC captionSize(v AS View) AS Float
  RETURN math::clamp(v.height * 0.022, 12.0, 20.0)
END FUNC

FUNC textItem(face AS canvas::Font, x AS Float, y AS Float, size AS Float, tint AS color::Color, text AS String) AS canvas::DrawItem
  RETURN canvas::Text[x := x, y := y, text := text, font := face, size := size, paint := canvas::fill(tint)]
END FUNC

' A full-window message on the void colour - the loading screen, and the one
' that says why there is nothing to show.
FUNC noticeScene(size AS canvas::Size, face AS canvas::Font, headline AS String, detail AS String) AS List OF canvas::DrawItem
  LET width AS Float = toFloat(size.width)
  LET height AS Float = toFloat(size.height)
  LET big AS Float = math::clamp(height * 0.030, 14.0, 24.0)
  LET small AS Float = big * 0.75

  MUT items AS List OF canvas::DrawItem = [canvas::Rectangle[x := 0.0, y := 0.0, w := width, h := height, paint := canvas::fill(VOID_COLOR)]]

  LET headlineWidth AS Float = canvas::measureText(face, big, headline).width
  items = collections::append(items, textItem(face, (width - headlineWidth) / 2.0, height / 2.0, big, CAPTION_COLOR, headline))

  IF detail <> "" THEN
    LET detailWidth AS Float = canvas::measureText(face, small, detail).width
    items = collections::append(items, textItem(face, (width - detailWidth) / 2.0, height / 2.0 + big * 1.8, small, HINT_COLOR, detail))
  END IF

  RETURN items
END FUNC

' How far in the view is, written the way a map says it.
FUNC zoomCaption(v AS View, size AS canvas::Size) AS String
  LET times AS Float = v.scale / fitScale(size)
  RETURN "zoom " & toString(times, toByte(1)) & "x"
END FUNC

' One frame: the map, the streamlines, and the captions over them.
FUNC frameScene(world AS Ring, v AS View, w AS Winds, face AS canvas::Font, size AS canvas::Size, captions AS Boolean) AS List OF canvas::DrawItem
  MUT items AS List OF canvas::DrawItem = mapItems(world, v)

  FOR EACH item IN trailItems(v)
    items = collections::append(items, item)
  NEXT

  IF captions THEN
    LET size1 AS Float = captionSize(v)
    LET margin AS Float = size1 * 1.2
    items = collections::append(items, textItem(face, margin, margin + size1, size1, CAPTION_COLOR, w.label))
    items = collections::append(items, textItem(face, margin, margin + size1 * 2.5, size1 * 0.85, HINT_COLOR, zoomCaption(v, size) & "  \u{00B7}  " & toString(particleCount()) & " tracers"))
    LET hint AS String = "q e zoom  \u{00B7}  a d spin  \u{00B7}  w s pan  \u{00B7}  space play/stop  \u{00B7}  f fullscreen  \u{00B7}  r whole world  \u{00B7}  h captions  \u{00B7}  esc quits"
    items = collections::append(items, textItem(face, margin, v.height - margin, size1 * 0.85, HINT_COLOR, hint))
  END IF

  RETURN items
END FUNC

' ---------------------------------------------------------------------------
' The frame loop
' ---------------------------------------------------------------------------

' The frame budget in milliseconds. canvas::present installs a scene rather than
' waiting for the screen, so nothing here blocks on the display and the loop
' would otherwise spin as fast as the machine allows - burning a core to compute
' frames nobody sees.
LET FRAME_MILLIS AS Integer = 16

' The longest step the simulation will take at once. Without it, a window
' dragged to another desktop or a machine that went to sleep comes back with a
' multi-second dt and every tracer teleports across an ocean.
LET MAX_STEP_SECONDS AS Float = 0.05

' ---------------------------------------------------------------------------
' The forecast
' ---------------------------------------------------------------------------
'
' The forecast hours are kept in a list in the order they arrived, which is the
' order of the hours: index k is hour k * FORECAST_STEP_HOURS, and index 0 is
' the analysis the program opened on. The frame loop draws through the two
' either side of the moment shown, and keeps those two in their own bindings,
' because reading a Winds out of the list copies the whole of both its fields -
' fine once every few hundred frames, when the moment crosses into the next
' pair, but not on every frame.

MUT forecastFrames AS List OF Winds = []
MUT earlierIndex AS Integer = -1
MUT laterIndex AS Integer = -1
MUT earlierWinds AS Winds = Winds[east := emptyField(), north := emptyField(), label := ""]
MUT laterWinds AS Winds = Winds[east := emptyField(), north := emptyField(), label := ""]

FUNC emptyField AS Field
  RETURN Field[ni := 0, nj := 0, lat1 := 0.0, lon1 := 0.0, dlat := 0.0, dlon := 0.0, category := 0, parameter := 0, surface := 0, height := 0, values := []]
END FUNC

' Point earlierWinds and laterWinds at the pair either side of `hours`, and say
' how far between them it falls.
FUNC windsFor(hours AS Float) AS Float
  LET last AS Integer = len(forecastFrames) - 1
  LET spacing AS Float = toFloat(FORECAST_STEP_HOURS)
  LET earlier AS Integer = math::clamp(math::floor(hours / spacing), 0, last)
  LET later AS Integer = math::min(earlier + 1, last)

  IF earlier <> earlierIndex THEN
    earlierWinds = collections::get(forecastFrames, earlier)
    earlierIndex = earlier
  END IF
  IF later <> laterIndex THEN
    laterWinds = collections::get(forecastFrames, later)
    laterIndex = later
  END IF

  IF later = earlier THEN RETURN 0.0
  RETURN math::clamp((hours - toFloat(earlier) * spacing) / spacing, 0.0, 1.0)
END FUNC

' What the tracker says while the forecast is arriving.
FUNC fetchedStatus AS String
  RETURN "fetching the forecast  " & toString(len(forecastFrames) - 1) & " of " & toString(forecastSteps())
END FUNC

' Take one piece of news from the worker: a forecast hour to add to the end of
' the list, or word of one it is waiting for.
FUNC withNews(news AS ForecastNews, p AS Playback) AS Playback
  MATCH news
    CASE ForecastFrame(f)
      forecastFrames = collections::append(forecastFrames, f.winds)
      RETURN WITH p { loadedHours := toFloat(f.hour), status := fetchedStatus() }
    CASE ForecastWait(w)
      RETURN WITH p { status := w.reason & " - asking again shortly" }
  END MATCH
END FUNC

' ---------------------------------------------------------------------------
' Main
' ---------------------------------------------------------------------------

FUNC main AS Integer
  app::setMode(app::Mode.Canvas)
  app::setTitle("Wind")

  LET fontPath AS String = systemFontPath()
  IF fontPath = "" THEN
    io::printError("wind: no TrueType font found in the usual system locations.")
    RETURN 1
  END IF
  RES face AS canvas::Font = canvas::loadFont(fontPath)

  canvas::present(noticeScene(canvas::getSize(), face, "Fetching the latest GFS 10 m wind from NOAA NOMADS", "about half a megabyte of GRIB2, then a moment to unpack it"))

  LET analysis AS Analysis = loadAnalysis() TRAP(e)
    canvas::present(noticeScene(canvas::getSize(), face, "No forecast to draw", e.message))
    waitForKey()
    RETURN 1
  END TRAP
  LET run AS Cycle = analysis.cycle
  app::setTitle("Wind \u{00B7} " & analysis.winds.label)

  ' The analysis is on screen from here on; the rest of the run arrives behind
  ' it. Dropping the handle on the way out - quitting before the fetch is done -
  ' cancels the worker.
  forecastFrames = [analysis.winds]
  LET worker AS Thread OF ForecastNews TO Integer = thread::start(fetchForecast, run)
  MUT fetching AS Boolean = TRUE
  MUT playback AS Playback = Playback[startSeconds := run.seconds, totalHours := toFloat(FORECAST_HOURS), loadedHours := 0.0, hours := 0.0, playing := FALSE, status := fetchedStatus()]
  LET days AS List OF DayMark = dayMarks(playback)

  LET world AS Ring = worldOutline()
  loadCoastline()

  MUT size AS canvas::Size = canvas::getSize()
  MUT view AS View = wholeWorld(size)
  MUT captions AS Boolean = TRUE
  MUT running AS Boolean = TRUE
  MUT scrubbing AS Boolean = FALSE
  seedSwarm(countFor(view), view)
  canvas::enableMouse(TRUE)

  MUT lastNanos AS Integer = datetime::monotonicNanos()
  DO WHILE running
    IF canvas::didResize() THEN
      size = canvas::getSize()
      view = resized(view, size)
      ' The swarm is sized for the window, so a resize that wants a different
      ' number of tracers rebuilds it. Reseeding throws away every trail, which
      ' is why it is only done when the count actually changes rather than on
      ' every pixel of a drag.
      IF particleCount() <> countFor(view) THEN seedSwarm(countFor(view), view)
    END IF

    ' The worker's news. Whether it has finished is asked before its queue is
    ' drained, not after: a worker that sends its last hour and ends between
    ' the two would otherwise be collected with that hour still unread. The
    ' handle stays in this function: handing a Thread to another function
    ' hands it over for good, and it is closed when that function returns.
    IF fetching THEN
      LET finished AS Boolean = NOT thread::isRunning(worker)
      DO WHILE thread::poll(worker, 0)
        playback = withNews(thread::receive(worker, 0), playback)
      LOOP
      IF finished THEN
        fetching = FALSE
        MUT problem AS String = ""
        LET sent AS Integer = thread::waitFor(worker) TRAP(e)
          problem = e.message
          RECOVER 0
        END TRAP
        IF problem <> "" THEN
          playback = WITH playback { status := "no forecast: " & problem }
        ELSEIF sent < forecastSteps() THEN
          playback = WITH playback { status := "the forecast stopped after " & toString(sent) & " of " & toString(forecastSteps()) & " hours" }
        ELSE
          ' All of it is in: start playing, from wherever the thumb was left.
          playback = WITH playback { status := "", playing := TRUE }
        END IF
      END IF
    END IF
    LET ready AS Boolean = playback.loadedHours >= playback.totalHours
    LET track AS Track = trackFor(view.width, view.height, captionSize(view))

    DO WHILE pending(0)
      MATCH commandFor(readKey())
        CASE Pan(p) : view = panned(view, p.dx, p.dy)
        CASE Spin(t) : view = spun(view, t.fraction)
        CASE Zoom(z) : view = zoomed(view, z.factor, size)
        CASE Reset : view = wholeWorld(size)
        CASE ToggleCaptions : captions = NOT captions
          ' The window resizes as it goes in or out, and the resize is picked up
          ' at the top of the next frame like any other.
        CASE ToggleFullscreen : app::setFullscreen(NOT app::getFullscreen())
        CASE TogglePlay : IF ready THEN playback = WITH playback { playing := NOT playback.playing }
        CASE Quit : running = FALSE
        CASE Ignore
      END MATCH
    LOOP

    ' The mouse only works the button and the tracker. A press on the tracker
    ' moves the thumb there and keeps it under the pointer for as long as the
    ' button stays down, playing or not.
    DO WHILE TRUE
      LET mouse AS canvas::MouseEvent = canvas::pollMouse()
      IF mouse.kind = canvas::MouseKind.None THEN EXIT DO
      IF mouse.kind = canvas::MouseKind.Down AND mouse.button = canvas::MouseButton.Left THEN
        IF onButton(track, mouse.position) THEN
          IF ready THEN playback = WITH playback { playing := NOT playback.playing }
        ELSEIF onTrack(track, mouse.position) THEN
          scrubbing = TRUE
          playback = WITH playback { hours := hoursAt(track, playback, mouse.position.x) }
        END IF
      ELSEIF mouse.kind = canvas::MouseKind.Drag AND scrubbing THEN
        playback = WITH playback { hours := hoursAt(track, playback, mouse.position.x) }
      ELSEIF mouse.kind = canvas::MouseKind.Up THEN
        scrubbing = FALSE
      END IF
    LOOP

    LET startNanos AS Integer = datetime::monotonicNanos()
    LET elapsed AS Float = math::clamp(toFloat(startNanos - lastNanos) / 1000000000.0, 0.0, MAX_STEP_SECONDS)
    lastNanos = startNanos

    ' Playing runs the thumb along the line and round to the start again.
    IF playback.playing AND NOT scrubbing THEN
      MUT hours AS Float = playback.hours + elapsed * PLAY_HOURS_PER_SECOND
      IF hours > playback.totalHours THEN hours = 0.0
      playback = WITH playback { hours := hours }
    END IF
    LET mix AS Float = windsFor(playback.hours)

    reprojectTrails(view.lon0)
    stepSwarm(earlierWinds, laterWinds, mix, view, elapsed)
    MUT scene AS List OF canvas::DrawItem = frameScene(world, view, analysis.winds, face, size, captions)
    FOR EACH item IN timelineItems(track, playback, days, face)
      scene = collections::append(scene, item)
    NEXT
    canvas::present(scene)

    LET spentMillis AS Integer = (datetime::monotonicNanos() - startNanos) / 1000000
    IF spentMillis < FRAME_MILLIS THEN os::sleep(FRAME_MILLIS - spentMillis)
  LOOP

  RETURN 0
END FUNC
