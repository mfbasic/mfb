' land - the blue and green the wind is drawn over.
'
' Two shapes make the map: the outline of the projected world, filled with the
' ocean's blue, and the coastlines, filled with the land's green. There is no
' terrain, no borders and no labels, because everything here is background - the
' point of the picture is what moves over it.
'
' The coastlines come from resources/wind/coastline.bin: Natural Earth's 1:10m
' land layer, with every point ranked by how much the outline would change if it
' were dropped. tools/wind-coastline/ builds it; its README says where the data
' came from and how the file is laid out.
'
' The map is drawn at a level of detail that follows the view. However far in or
' out you are, the coastline on screen carries at most coastBudget() points: the
' whole world gets the most important 2,500, and zooming in on Hawaii gives
' Hawaii's own detail, down to everything the data has. Shapes are cut at the
' edge of the window, so land running off screen costs nothing.
'
' Every ring is projected once, when the file is read, and kept in plane
' coordinates from then on. The drawn map is rebuilt only when the view moves;
' a frame that did not pan or zoom reuses the last one.
'
' The coastline is kept as flat module-level lists rather than a List OF Ring,
' for the reason flow.mfb keeps its swarm that way: 6,836 records each holding
' two lists cost 3 seconds to build at startup, where the same 434,309 points
' appended to four flat lists cost a tenth of a second.

IMPORT canvas
IMPORT collections
IMPORT color
IMPORT fs
IMPORT math
IMPORT os

' One closed outline on the projected plane and the box around it. Only the
' world's outline is one of these; the coastline's rings live in the flat lists
' below.
TYPE Ring
  points AS List OF Plane
  bounds AS Box
END TYPE

FUNC ringOf(points AS List OF Plane) AS Ring
  RETURN Ring[points := points, bounds := boxOf(points)]
END FUNC

' The coastline: every ring's points one after another, each point's importance
' level beside it, where each ring starts (ring i is coastStart[i] up to
' coastStart[i + 1]), and each ring's box.
MUT coastPoints AS List OF Plane = []
MUT coastLevels AS List OF Integer = []
MUT coastStart AS List OF Integer = []
MUT coastBounds AS List OF Box = []

FUNC coastRings AS Integer
  RETURN len(coastBounds)
END FUNC

' The most coastline points the map puts on screen at once.
FUNC coastBudget AS Integer
  RETURN 2500
END FUNC

' ---------------------------------------------------------------------------
' The palette
' ---------------------------------------------------------------------------

' Beyond the edge of the map. Darker than the sea, so the world reads as a shape
' rather than as the whole window.
FUNC voidColor AS color::Color
  RETURN color::rgb(9, 12, 20)
END FUNC

FUNC oceanColor AS color::Color
  RETURN color::rgb(18, 42, 68)
END FUNC

FUNC landColor AS color::Color
  RETURN color::rgb(38, 68, 52)
END FUNC

FUNC coastColor AS color::Color
  RETURN color::rgb(58, 96, 76)
END FUNC

' ---------------------------------------------------------------------------
' Reading the coastline
' ---------------------------------------------------------------------------
'
' The file is "MFBC", a version byte, then a varint ring count; each ring is a
' varint point count and, per point, the zigzag-varint change in longitude and in
' latitude (in 1/10000 of a degree) from the previous point, then one importance
' byte. The reader walks it with a cursor over the bytes.

MUT coastBytes AS List OF Byte = []
MUT coastAt AS Integer = 0

' The next unsigned varint.
FUNC nextVarint AS Integer
  MUT value AS Integer = 0
  MUT weight AS Integer = 1
  DO
    LET b AS Integer = toInt(collections::get(coastBytes, coastAt))
    coastAt = coastAt + 1
    value = value + (b MOD 128) * weight
    weight = weight * 128
    IF b < 128 THEN EXIT DO
  LOOP UNTIL FALSE
  RETURN value
END FUNC

' The next zigzag varint: 0, -1, 1, -2, ... from 0, 1, 2, 3, ...
FUNC nextSigned AS Integer
  LET raw AS Integer = nextVarint()
  IF raw MOD 2 = 0 THEN RETURN raw / 2
  RETURN -((raw + 1) / 2)
END FUNC

' Whether the bytes open with "MFBC" and format version 1.
FUNC isCoastlineFile AS Boolean
  IF len(coastBytes) < 6 THEN RETURN FALSE
  LET magic AS List OF Integer = [77, 70, 66, 67, 1]
  FOR i = 0 TO 4
    IF toInt(collections::get(coastBytes, i)) <> collections::get(magic, i) THEN RETURN FALSE
  NEXT
  RETURN TRUE
END FUNC

' Read the shipped coastline into the flat lists, every point projected.
SUB loadCoastline()
  coastBytes = fs::readBytes(os::resourcePath("wind/coastline.bin"))
  IF NOT isCoastlineFile() THEN FAIL error(77050003, "coastline: not a version 1 MFBC coastline file")
  coastAt = 5
  LET ringCount AS Integer = nextVarint()
  coastPoints = []
  coastLevels = []
  coastStart = []
  coastBounds = []
  FOR r = 1 TO ringCount
    LET count AS Integer = nextVarint()
    coastStart = collections::append(coastStart, len(coastPoints))
    MUT x AS Integer = 0
    MUT y AS Integer = 0
    MUT minX AS Float = 0.0
    MUT minY AS Float = 0.0
    MUT maxX AS Float = 0.0
    MUT maxY AS Float = 0.0
    FOR k = 1 TO count
      x = x + nextSigned()
      y = y + nextSigned()
      LET p AS Plane = project(Geo[lon := toFloat(x) / 10000.0, lat := toFloat(y) / 10000.0])
      IF k = 1 THEN
        minX = p.x
        minY = p.y
        maxX = p.x
        maxY = p.y
      ELSE
        minX = math::min(minX, p.x)
        minY = math::min(minY, p.y)
        maxX = math::max(maxX, p.x)
        maxY = math::max(maxY, p.y)
      END IF
      coastPoints = collections::append(coastPoints, p)
      coastLevels = collections::append(coastLevels, toInt(collections::get(coastBytes, coastAt)))
      coastAt = coastAt + 1
    NEXT
    coastBounds = collections::append(coastBounds, Box[minX := minX, minY := minY, maxX := maxX, maxY := maxY])
  NEXT
  coastStart = collections::append(coastStart, len(coastPoints))
  coastBytes = []
END SUB

' ---------------------------------------------------------------------------
' The edge of the world
' ---------------------------------------------------------------------------

' The outline of the projected world: down the antimeridian on one side and back
' up it on the other, which under an equal-area pseudo-cylindrical projection is
' a rounded lens rather than a rectangle. Filled, it is the sea. Every point is
' kept at every zoom.
FUNC worldOutline AS Ring
  MUT points AS List OF Plane = []
  FOR i = 0 TO 180
    points = collections::append(points, project(Geo[lon := 180.0, lat := 90.0 - toFloat(i)]))
  NEXT
  FOR i = 0 TO 180
    points = collections::append(points, project(Geo[lon := -180.0, lat := -90.0 + toFloat(i)]))
  NEXT
  RETURN ringOf(points)
END FUNC

' ---------------------------------------------------------------------------
' Choosing the detail
' ---------------------------------------------------------------------------

FUNC inBox(p AS Plane, b AS Box) AS Boolean
  RETURN p.x >= b.minX AND p.x <= b.maxX AND p.y >= b.minY AND p.y <= b.maxY
END FUNC

' The lowest importance level the view can afford: count the on-screen points at
' each level, then take levels from the most important down while the total stays
' within the budget. Every point at or above the answer is drawn.
FUNC detailLevel(screen AS Box) AS Integer
  MUT counts AS List OF Integer = []
  FOR lv = 0 TO 255
    counts = collections::append(counts, 0)
  NEXT
  FOR r = 0 TO coastRings() - 1
    IF NOT overlaps(collections::get(coastBounds, r), screen) THEN CONTINUE FOR
    FOR i = collections::get(coastStart, r) TO collections::get(coastStart, r + 1) - 1
      IF inBox(collections::get(coastPoints, i), screen) THEN
        LET lv AS Integer = collections::get(coastLevels, i)
        counts = collections::set(counts, lv, collections::get(counts, lv) + 1)
      END IF
    NEXT
  NEXT
  MUT total AS Integer = 0
  MUT threshold AS Integer = 256
  FOR lv = 255 TO 1 STEP -1
    total = total + collections::get(counts, lv)
    IF total > coastBudget() THEN EXIT FOR
    threshold = lv
  NEXT
  RETURN threshold
END FUNC

' ---------------------------------------------------------------------------
' Cutting a shape at the window's edge
' ---------------------------------------------------------------------------
'
' Sutherland-Hodgman, one side of the box at a time. A closed outline cut by a
' rectangle is still one closed outline, with the part outside replaced by a run
' along the rectangle's side, so it fills exactly as the uncut shape would inside
' the box. The box sits a few pixels outside the window, so that run - and the
' coast stroke drawn along it - is never on screen.

' Which side of one edge of the box a point is on. `side` is 0 left, 1 right,
' 2 bottom, 3 top.
FUNC insideEdge(p AS Plane, side AS Integer, b AS Box) AS Boolean
  IF side = 0 THEN RETURN p.x >= b.minX
  IF side = 1 THEN RETURN p.x <= b.maxX
  IF side = 2 THEN RETURN p.y >= b.minY
  RETURN p.y <= b.maxY
END FUNC

' Where the segment a-b crosses one edge of the box.
FUNC crossing(a AS Plane, b AS Plane, side AS Integer, box AS Box) AS Plane
  IF side < 2 THEN
    MUT at AS Float = box.minX
    IF side = 1 THEN at = box.maxX
    LET t AS Float = (at - a.x) / (b.x - a.x)
    RETURN Plane[x := at, y := a.y + (b.y - a.y) * t]
  END IF
  MUT at AS Float = box.minY
  IF side = 3 THEN at = box.maxY
  LET t AS Float = (at - a.y) / (b.y - a.y)
  RETURN Plane[x := a.x + (b.x - a.x) * t, y := at]
END FUNC

FUNC clipSide(points AS List OF Plane, side AS Integer, box AS Box) AS List OF Plane
  MUT out AS List OF Plane = []
  LET n AS Integer = len(points)
  IF n = 0 THEN RETURN out
  MUT prev AS Plane = collections::get(points, n - 1)
  MUT prevIn AS Boolean = insideEdge(prev, side, box)
  FOR EACH p IN points
    LET here AS Boolean = insideEdge(p, side, box)
    IF here THEN
      IF NOT prevIn THEN out = collections::append(out, crossing(prev, p, side, box))
      out = collections::append(out, p)
    ELSEIF prevIn THEN
      out = collections::append(out, crossing(prev, p, side, box))
    END IF
    prev = p
    prevIn = here
  NEXT
  RETURN out
END FUNC

FUNC clipToBox(points AS List OF Plane, box AS Box) AS List OF Plane
  MUT out AS List OF Plane = points
  FOR side = 0 TO 3
    out = clipSide(out, side, box)
  NEXT
  RETURN out
END FUNC

' ---------------------------------------------------------------------------
' Drawing
' ---------------------------------------------------------------------------

' An outline's kept points as a polygon in window coordinates, cut at the clip
' box - or nothing, when fewer than three points are left. The caller appends
' what comes back, so an empty list is how "skip this one" is said.
FUNC outlineItems(kept AS List OF Plane, v AS View, clip AS Box, paint AS canvas::Paint) AS List OF canvas::DrawItem
  IF len(kept) < 3 THEN RETURN []
  LET cut AS List OF Plane = clipToBox(kept, clip)
  IF len(cut) < 3 THEN RETURN []
  MUT points AS List OF canvas::Point = []
  FOR EACH p IN cut
    points = collections::append(points, toScreen(v, p))
  NEXT
  RETURN [canvas::Polygon[points := points, paint := paint]]
END FUNC

' Coastline ring r at one level of detail, or nothing when it is off screen or
' too small to keep three points.
FUNC coastItems(r AS Integer, v AS View, clip AS Box, threshold AS Integer, paint AS canvas::Paint) AS List OF canvas::DrawItem
  IF NOT overlaps(collections::get(coastBounds, r), clip) THEN RETURN []
  MUT kept AS List OF Plane = []
  FOR i = collections::get(coastStart, r) TO collections::get(coastStart, r + 1) - 1
    IF collections::get(coastLevels, i) >= threshold THEN kept = collections::append(kept, collections::get(coastPoints, i))
  NEXT
  RETURN outlineItems(kept, v, clip, paint)
END FUNC

' The last map drawn and the view it was drawn for.
MUT drawnView AS View = View[scale := 0.0, cx := 0.0, cy := 0.0, width := 0.0, height := 0.0]
MUT drawnMap AS List OF canvas::DrawItem = []

FUNC sameView(a AS View, b AS View) AS Boolean
  RETURN a.scale = b.scale AND a.cx = b.cx AND a.cy = b.cy AND a.width = b.width AND a.height = b.height
END FUNC

' The whole underlay: the backdrop, the sea, and the land on top of it. Built
' again only when the view has moved since the last call.
FUNC mapItems(world AS Ring, v AS View) AS List OF canvas::DrawItem
  IF sameView(v, drawnView) THEN RETURN drawnMap

  ' Four pixels outside the window on every side.
  LET clip AS Box = viewBox(v, 4.0 / v.scale)
  LET threshold AS Integer = detailLevel(viewBox(v, 0.0))

  MUT items AS List OF canvas::DrawItem = [canvas::Rectangle[x := 0.0, y := 0.0, w := v.width, h := v.height, paint := canvas::fill(voidColor())]]
  IF overlaps(world.bounds, clip) THEN
    items = collections::append(items, outlineItems(world.points, v, clip, canvas::fill(oceanColor())))
  END IF

  ' A hairline of a lighter green around each landmass. At a world-sized zoom
  ' most islands are a couple of pixels across, and without it they disappear
  ' into the sea entirely.
  LET paint AS canvas::Paint = canvas::fillStroke(landColor(), coastColor(), 1.0)
  FOR r = 0 TO coastRings() - 1
    items = collections::append(items, coastItems(r, v, clip, threshold, paint))
  NEXT

  drawnView = v
  drawnMap = items
  RETURN items
END FUNC
