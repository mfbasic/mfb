  t = collections::append(t, AutoGenerator[terrain := 0, layer := 0, DFType := 0, machine := 64, requiredDungeonFoundationType := 2, requiredLiquidFoundationType := 0, minDepth := 7, maxDepth := 40, frequency := 12, minNumberIntercept := 0, minNumberSlope := 0, maxNumber := 5]) ' 43
  t = collections::append(t, AutoGenerator[terrain := 0, layer := 0, DFType := 0, machine := 65, requiredDungeonFoundationType := 2, requiredLiquidFoundationType := 0, minDepth := 5, maxDepth := 39, frequency := 6, minNumberIntercept := 0, minNumberSlope := 0, maxNumber := 2]) ' 44
  t = collections::append(t, AutoGenerator[terrain := 0, layer := 0, DFType := 0, machine := 66, requiredDungeonFoundationType := 2, requiredLiquidFoundationType := 0, minDepth := 5, maxDepth := 39, frequency := 6, minNumberIntercept := 0, minNumberSlope := 0, maxNumber := 2]) ' 45
  t = collections::append(t, AutoGenerator[terrain := 0, layer := 0, DFType := 0, machine := 69, requiredDungeonFoundationType := 2, requiredLiquidFoundationType := 0, minDepth := 6, maxDepth := 39, frequency := 15, minNumberIntercept := 0, minNumberSlope := 0, maxNumber := 3]) ' 46
  t = collections::append(t, AutoGenerator[terrain := 0, layer := 0, DFType := 0, machine := 71, requiredDungeonFoundationType := 2, requiredLiquidFoundationType := 0, minDepth := 12, maxDepth := 39, frequency := 10, minNumberIntercept := 0, minNumberSlope := 0, maxNumber := 2]) ' 47
  t = collections::append(t, AutoGenerator[terrain := 0, layer := 0, DFType := 0, machine := 70, requiredDungeonFoundationType := 2, requiredLiquidFoundationType := 0, minDepth := 12, maxDepth := 39, frequency := 12, minNumberIntercept := 0, minNumberSlope := 0, maxNumber := 3]) ' 48
  RETURN t
END FUNC

PUBLIC LET autoGeneratorCatalog AS List OF AutoGenerator = buildAutoGeneratorCatalog()

FUNC buildDungeonProfileCatalog() AS List OF DungeonProfile
  MUT t AS List OF DungeonProfile = []
  t = collections::append(t, DungeonProfile[roomFrequencies := [2, 1, 1, 1, 7, 1, 0, 0], corridorChance := 10]) ' DP_BASIC
  t = collections::append(t, DungeonProfile[roomFrequencies := [10, 0, 0, 3, 7, 10, 10, 0], corridorChance := 0]) ' DP_BASIC_FIRST_ROOM
  t = collections::append(t, DungeonProfile[roomFrequencies := [0, 0, 1, 0, 0, 0, 0, 0], corridorChance := 0]) ' DP_GOBLIN_WARREN
  t = collections::append(t, DungeonProfile[roomFrequencies := [0, 5, 0, 1, 0, 0, 0, 0], corridorChance := 0]) ' DP_SENTINEL_SANCTUARY
  RETURN t
END FUNC

PUBLIC LET dungeonProfileCatalog AS List OF DungeonProfile = buildDungeonProfileCatalog()
