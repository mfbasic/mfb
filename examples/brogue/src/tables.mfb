' floorTileType, less its display and text fields.
PUBLIC TYPE FloorTileType
  drawPriority AS Integer
  chanceToIgnite AS Integer
  fireType AS Integer
  discoverType AS Integer
  promoteType AS Integer
  promoteChance AS Integer
  glowLight AS Integer
  flags AS Integer
  mechFlags AS Integer
END TYPE

' dungeonFeature, less its message text and colour; hasDescription and
' hasFlashColor record whether the C fields are set.
PUBLIC TYPE DungeonFeature
  tile AS Integer
  layer AS Integer
  startProbability AS Integer
  probabilityDecrement AS Integer
  flags AS Integer
  hasDescription AS Boolean
  lightFlare AS Integer
  hasFlashColor AS Boolean
  effectRadius AS Integer
  propagationTerrain AS Integer
  subsequentDF AS Integer
END TYPE

PUBLIC TYPE AutoGenerator
  terrain AS Integer
  layer AS Integer
  DFType AS Integer
  machine AS Integer
  requiredDungeonFoundationType AS Integer
  requiredLiquidFoundationType AS Integer
  minDepth AS Integer
  maxDepth AS Integer
  frequency AS Integer
  minNumberIntercept AS Integer
  minNumberSlope AS Integer
  maxNumber AS Integer
END TYPE

PUBLIC TYPE DungeonProfile
  roomFrequencies AS List OF Integer
  corridorChance AS Integer
END TYPE

