IMPORT io

' Prints "Hello World" in 38 different languages.
FUNC main AS Integer
  io::print("Abkhaz:      Салам Адунеи")
  io::print("Acehnese:    Halo Donya")
  io::print("Acholi:      Apwoyo lobo")
  io::print("Afar:        Nagaale Baadal")
  io::print("Afrikaans:   Hallo Wêreld")
  io::print("Albanian:    Përshëndetje Botë")
  io::print("Alur:        Amothi ngom")
  io::print("Amharic:     ሰላም አለም")
  io::print("Arabic:      مرحبا بالعالم")
  io::print("Armenian:    Բարև աշխարհ")
  io::print("Assamese:    হেল্ল' ৱৰ্ল্ড")
  io::print("Avar:        Салам Дунял")
  io::print("Awadhi:      हैलो वर्ल्ड")
  io::print("Aymara:      Suma Uraqpachan")
  io::print("Azerbaijani: Salam Dünya")
  io::print("Balinese:    Halo Jagat")
  io::print("Baluchi:     سلام دنیا")
  io::print("Bambara:     Bonjour Monde")
  io::print("Bashkir:     Һаумыһығыҙ Донъя")
  io::print("Basque:      Kaixo Mundua")
  io::print("Batak Karo:  Halo Dunia")
  io::print("Belarusian:  Прывітанне, свет")
  io::print("Bemba:       Mwapoleni Icalo conse")
  io::print("Bengali:     হ্যালো ওয়ার্ল্ড")
  io::print("Bhojpuri:    नमस्कार दुनिया के बा")
  io::print("Bikol:       Kumusta an Kinaban")
  io::print("Bosnian:     Zdravo svijete")
  io::print("Breton:      Salud Bed")
  io::print("English:     Hello World")
  io::print("Spanish:     Hola Mundo")
  io::print("French:      Bonjour le monde")
  io::print("German:      Hallo Welt")
  io::print("Italian:     Ciao mondo")
  io::print("Portuguese:  Olá Mundo")
  io::print("Swedish:     Hej världen")
  io::print("Russian:     Привет, мир")
  io::print("Japanese:    こんにちは世界")
  io::print("Greek:       Γειά σου Κόσμε")
