' twilight - III. Twilight Flight over the Runestone Fountain.
'
' Dusk over a mountain lake. A flock of birds wheels over the water, each one
' steering by three rules alone - keep a little apart, fly the way your
' neighbours fly, stay with the group (Craig Reynolds' boids) - plus a fourth:
' keep clear of the fountain on its island, the cliff tree, and the mouse,
' which the flock treats as a hawk. Hold the button down and the mouse becomes
' a lure instead, and the flock streams after it.
'
' The lake mirrors the mountains and the fountain. Each is a group, drawn once
' as it stands and once more by a Group node whose transform has a negative Y
' scale, which turns it upside down about the waterline; the mirrored copy is
' the same figure built a little transparent. The mountains never change, so
' both are installed once. The crescent moon is two circles, the second cut
' out of the first under EvenOdd; the portal on the far shore is a radial
' gradient with GradientSpread.Repeat, its rings pulsing outward as its radius
' is animated.

IMPORT canvas
IMPORT vector
IMPORT collections
IMPORT color
IMPORT math

TYPE Boid
  x AS Float
  y AS Float
  vx AS Float
  vy AS Float
  phase AS Float       ' where in its wingbeat it is
END TYPE

TYPE TwilightState
  t AS Float
  boids AS List OF Boid
  w AS Float
  h AS Float
  scare AS Float       ' 1 just after a click, fading: the flock scatters
  sx AS Float          ' where the last scare was
  sy AS Float
END TYPE

LET FLOCK_SIZE AS Integer = 150

FUNC twilightNew AS TwilightState
  RETURN TwilightState[t := 0.0, boids := [], w := 0.0, h := 0.0, scare := 0.0, sx := 0.0, sy := 0.0]
END FUNC

FUNC spawnFlock(w AS Float, h AS Float) AS List OF Boid
  MUT out AS List OF Boid = []
  FOR i = 0 TO FLOCK_SIZE - 1
    LET a AS Float = randF(-0.4, 0.4)
    out = collections::append(out, Boid[x := randF(w * 0.15, w * 0.85), y := randF(h * 0.15, h * 0.45), vx := math::cos(a) * 120.0, vy := math::sin(a) * 120.0, phase := randF(0.0, TAU)])
  NEXT
  RETURN out
END FUNC

' Where the fountain stands, which the flock keeps clear of.
FUNC fountainSpot(w AS Float, h AS Float) AS vector::Float2
  RETURN pt(w * 0.56, h * 0.56)
END FUNC

FUNC twilightStep(s AS TwilightState, inp AS Input, dt AS Float) AS TwilightState
  LET w AS Float = inp.w
  LET h AS Float = inp.h
  MUT boids AS List OF Boid = s.boids
  IF len(boids) = 0 OR s.w <> w OR s.h <> h THEN
    boids = spawnFlock(w, h)
    twilightInstall(w, h)
  END IF
  MUT scare AS Float = math::max(0.0, s.scare - dt * 0.8)
  MUT sx AS Float = s.sx
  MUT sy AS Float = s.sy
  IF inp.rightPressed OR keyPressed(inp, "space") THEN
    scare = 1.0
    sx = inp.mx
    sy = inp.my
  END IF
  LET mouseIn AS Boolean = inp.mx >= 0.0
  LET lure AS Boolean = inp.down AND mouseIn
  LET fs AS vector::Float2 = fountainSpot(w, h)
  LET n AS Integer = len(boids)
  LET view AS Float = 70.0
  LET sepR AS Float = 18.0
  LET maxSpeed AS Float = 210.0
  LET minSpeed AS Float = 90.0
  MUT out AS List OF Boid = []
  FOR i = 0 TO n - 1
    LET b AS Boid = collections::get(boids, i)
    MUT ax AS Float = 0.0
    MUT ay AS Float = 0.0
    MUT cx AS Float = 0.0
    MUT cy AS Float = 0.0
    MUT avx AS Float = 0.0
    MUT avy AS Float = 0.0
    MUT count AS Integer = 0
    MUT sepX AS Float = 0.0
    MUT sepY AS Float = 0.0
    FOR j = 0 TO n - 1
      IF j <> i THEN
        LET o AS Boid = collections::get(boids, j)
        LET dx AS Float = o.x - b.x
        LET dy AS Float = o.y - b.y
        IF math::abs(dx) < view AND math::abs(dy) < view THEN
          LET d2 AS Float = dx * dx + dy * dy
          IF d2 < view * view THEN
            cx = cx + o.x
            cy = cy + o.y
            avx = avx + o.vx
            avy = avy + o.vy
            count = count + 1
            IF d2 < sepR * sepR AND d2 > 0.01 THEN
              sepX = sepX - dx / d2 * sepR
              sepY = sepY - dy / d2 * sepR
            END IF
          END IF
        END IF
      END IF
    NEXT
    IF count > 0 THEN
      LET fc AS Float = toFloat(count)
      ' Cohesion: towards the neighbours' centre. Alignment: towards their
      ' average velocity.
      ax = ax + (cx / fc - b.x) * 0.9 + (avx / fc - b.vx) * 1.4
      ay = ay + (cy / fc - b.y) * 0.9 + (avy / fc - b.vy) * 1.4
    END IF
    ax = ax + sepX * 60.0
    ay = ay + sepY * 60.0
    ' Keep to the sky above the lake, turning back from the edges.
    LET margin AS Float = w * 0.12
    IF b.x < margin THEN ax = ax + (margin - b.x) * 14.0
    IF b.x > w - margin THEN ax = ax - (b.x - (w - margin)) * 14.0
    IF b.y < h * 0.12 THEN ay = ay + (h * 0.12 - b.y) * 16.0
    IF b.y > h * 0.52 THEN ay = ay - (b.y - h * 0.52) * 16.0
    ' A gentle pull towards the middle of the sky keeps the flock in view.
    ax = ax + (w * 0.5 - b.x) * 0.15
    ay = ay + (h * 0.32 - b.y) * 0.3
    ' Steer round the fountain's spire.
    LET fdx AS Float = b.x - fs.x
    LET fdy AS Float = b.y - (fs.y - h * 0.1)
    LET fd AS Float = math::sqrt(fdx * fdx + fdy * fdy) + 0.001
    IF fd < h * 0.17 THEN
      ax = ax + fdx / fd * 900.0 * (1.0 - fd / (h * 0.17))
      ay = ay + fdy / fd * 900.0 * (1.0 - fd / (h * 0.17))
    END IF
    ' The mouse: a hawk to flee, or with the button held, a lure to chase.
    IF mouseIn THEN
      LET mdx AS Float = b.x - inp.mx
      LET mdy AS Float = b.y - inp.my
      LET md AS Float = math::sqrt(mdx * mdx + mdy * mdy) + 0.001
      IF lure THEN
        ax = ax - mdx / md * 420.0
        ay = ay - mdy / md * 420.0
      ELSEIF md < h * 0.2 THEN
        ax = ax + mdx / md * 2400.0 * (1.0 - md / (h * 0.2))
        ay = ay + mdy / md * 2400.0 * (1.0 - md / (h * 0.2))
      END IF
    END IF
    IF scare > 0.0 THEN
      LET kdx AS Float = b.x - sx
      LET kdy AS Float = b.y - sy
      LET kd AS Float = math::sqrt(kdx * kdx + kdy * kdy) + 0.001
      ax = ax + kdx / kd * 3000.0 * scare * math::max(0.0, 1.0 - kd / (h * 0.6))
      ay = ay + kdy / kd * 3000.0 * scare * math::max(0.0, 1.0 - kd / (h * 0.6))
    END IF
    MUT vx AS Float = b.vx + ax * dt
    MUT vy AS Float = b.vy + ay * dt
    LET sp AS Float = math::sqrt(vx * vx + vy * vy) + 0.001
    LET limited AS Float = clampF(sp, minSpeed, maxSpeed * (1.0 + scare))
    vx = vx / sp * limited
    vy = vy / sp * limited
    ' Birds climbing beat their wings faster.
    LET beat AS Float = 9.0 + math::max(0.0, -vy) * 0.05 + scare * 8.0
    out = collections::append(out, Boid[x := b.x + vx * dt, y := b.y + vy * dt, vx := vx, vy := vy, phase := b.phase + beat * dt])
  NEXT
  RETURN TwilightState[t := s.t + dt, boids := out, w := w, h := h, scare := scare, sx := sx, sy := sy]
END FUNC

' ---------------------------------------------------------------------------
' Drawing
' ---------------------------------------------------------------------------

' A gnarled tree clinging to a cliff: a recursive branching, each limb one
' quadratic curve from where its parent ended, bowed to one side by a
' repeatable twist and drawn with round caps, so the joins are smooth.
FUNC gnarled(x AS Float, y AS Float, angle AS Float, len_ AS Float, width AS Float, depth AS Integer, seed AS Integer, t AS Float, c AS color::Color) AS List OF canvas::DrawItem
  IF depth = 0 OR len_ < 3.0 THEN RETURN []
  LET a AS Float = angle + math::sin(t * 0.8 + toFloat(seed)) * 0.02 * toFloat(6 - depth)
  LET bow AS Float = len_ * hashRange(seed, -0.12, 0.12)
  LET mx AS Float = math::cos(a) * len_ * 0.5 + math::cos(a + 1.57) * bow
  LET my AS Float = math::sin(a) * len_ * 0.5 + math::sin(a + 1.57) * bow
  LET ex AS Float = math::cos(a) * len_
  LET ey AS Float = math::sin(a) * len_
  MUT out AS List OF canvas::DrawItem = [curvePath(x, y, [quad(0.0, 0.0, mx, my, ex, ey)], WITH strokeP(c, width) { cap := canvas::CapStyle.Round })]
  LET spread AS Float = hashRange(seed * 3 + 1, 0.35, 0.7)
  out = collections::append(out, gnarled(x + ex, y + ey, a - spread, len_ * hashRange(seed * 5 + 2, 0.62, 0.8), width * 0.68, depth - 1, seed * 2 + 1, t, c))
  RETURN collections::append(out, gnarled(x + ex, y + ey, a + spread * 0.8, len_ * hashRange(seed * 7 + 3, 0.55, 0.76), width * 0.65, depth - 1, seed * 2 + 2, t, c))
END FUNC

' An ornate fountain in three tiers on an island, in silhouette against the
' dusk, built around the middle of its base, `s` its size: runes glowing on
' its plinth and water shining at each tier. `opacity` fades the whole of it,
' for its reflection.
FUNC runeFountain(s AS Float, t AS Float, opacity AS Float) AS List OF canvas::DrawItem
  LET stone AS canvas::Paint = faded(fillP(hex("#1a1426")), opacity)
  ' The island, the plinth, then three bowls on their stems and a spire.
  MUT out AS List OF canvas::DrawItem = [ellipse(0.0, 0.0, s * 1.3, s * 0.12, 0.0, faded(WITH gradP(linear(0.0, -s * 0.12, 0.0, s * 0.12, [gstop(0.0, hex("#3a2a48")), gstop(0.5, hex("#160f22")), gstop(1.0, hex("#0b0812"))])) { stroke := rgba(255, 160, 180, 60), strokeWidth := 1.0 }, opacity))]
  out = collections::append(out, poly([pt(-s * 0.5, 0.0), pt(-s * 0.42, -s * 0.28), pt(s * 0.42, -s * 0.28), pt(s * 0.5, 0.0)], stone))
  FOR k = 0 TO 2
    out = collections::append(out, fountainTier(s, k, t, opacity))
  NEXT
  out = collections::append(out, poly([pt(-s * 0.04, -s * 1.08), pt(0.0, -s * 1.45), pt(s * 0.04, -s * 1.08)], stone))
  ' Runes along the plinth.
  FOR i = 0 TO 4
    LET rx AS Float = -s * 0.32 + toFloat(i) * s * 0.16
    LET ry AS Float = -s * 0.14
    LET pulse AS Float = 0.55 + 0.45 * math::sin(t * 2.0 + toFloat(i) * 1.3)
    out = collections::append(out, pathAt(rx, ry, [pt(-s * 0.03, -s * 0.06), pt(0.0, s * 0.06), pt(s * 0.03, -s * 0.06)], faded(WITH strokeP(rgba(130, 240, 255, math::round(255.0 * pulse)), 1.4) { join := canvas::JoinStyle.Miter }, opacity)))
    out = collections::append(out, glow(rx, ry, s * 0.09, rgba(100, 230, 255, math::round(110.0 * pulse * opacity))))
  NEXT
  RETURN collections::append(out, glow(0.0, -s * 1.45, s * 0.25, rgba(160, 240, 255, math::round(120.0 * opacity))))
END FUNC

' One bowl of the fountain on its stem, with water spilling over its lip in a
' thin glowing sheet on each side.
FUNC fountainTier(s AS Float, k AS Integer, t AS Float, opacity AS Float) AS List OF canvas::DrawItem
  LET fk AS Float = toFloat(k)
  LET by AS Float = -s * (0.36 + fk * 0.36)
  LET br AS Float = s * (0.85 - fk * 0.24)
  LET stone AS canvas::Paint = faded(fillP(hex("#1a1426")), opacity)
  MUT out AS List OF canvas::DrawItem = [poly([pt(-s * 0.08, by + s * 0.36), pt(-s * 0.05, by + s * 0.08), pt(s * 0.05, by + s * 0.08), pt(s * 0.08, by + s * 0.36)], stone)]
  out = collections::append(out, poly([pt(-br, by), pt(-br * 0.7, by + s * 0.1), pt(br * 0.7, by + s * 0.1), pt(br, by)], faded(WITH fillP(hex("#1a1426")) { stroke := hex("#5a3d6a"), strokeWidth := 1.2 }, opacity)))
  ' The sheet falls as x = a * sqrt(y / drop) - a parabola on its side, which
  ' is exactly one quadratic curve: from the lip, its control point level with
  ' the lip halfway out, to its foot.
  LET drop AS Float = s * 0.34
  LET a AS Float = s * 0.08
  FOR side = -1 TO 1 STEP 2
    LET sd AS Float = toFloat(side)
    out = collections::append(out, curvePath(sd * br, by, [quad(0.0, 0.0, sd * a / 2.0, 0.0, sd * a, drop)], faded(WITH strokeP(rgba(225, 248, 255, 230), 2.0 + math::sin(t * 6.0 + fk) * 0.4) { blend := canvas::BlendMode.Add, dashes := [6.0, 4.0], dashOffset := -t * 60.0 }, opacity)))
  NEXT
  RETURN collections::append(out, ellipse(0.0, by - 1.0, br * 0.92, s * 0.025, 0.0, glowP(rgba(120, 230, 255, math::round(90.0 * opacity)))))
END FUNC

FUNC twilightSky(horizon AS Float) AS canvas::Gradient
  RETURN downward(horizon, [gstop(0.0, hex("#0b0820")), gstop(0.35, hex("#2a1650")), gstop(0.68, hex("#7a2f6a")), gstop(0.88, hex("#d0566a")), gstop(1.0, hex("#f59a62"))])
END FUNC

' The mountains, near and far, standing on the horizon; `opacity` as opaque
' as they are drawn.
FUNC twilightMountains(w AS Float, h AS Float, horizon AS Float, opacity AS Float) AS List OF canvas::DrawItem
  MUT out AS List OF canvas::DrawItem = [poly(ridge(w, horizon + 1.0, horizon - h * 0.07, h * 0.12, 27, 1.4, 70), faded(fillP(hex("#4a2a5e")), opacity))]
  out = collections::append(out, poly(ridge(w, horizon + 1.0, horizon - h * 0.02, h * 0.07, 31, 1.6, 90), faded(fillP(hex("#2e1a40")), opacity)))
  ' The cliff on the left, rising steeply out of the water.
  out = collections::append(out, poly([pt(-10.0, horizon + 1.0), pt(-10.0, h * 0.3), pt(w * 0.05, h * 0.28), pt(w * 0.11, h * 0.36), pt(w * 0.14, h * 0.35), pt(w * 0.19, h * 0.5), pt(w * 0.25, h * 0.58), pt(w * 0.3, horizon + 1.0)], faded(fillP(hex("#170f22")), opacity)))
  ' The far shore on the right, where the portal stands.
  RETURN collections::append(out, poly([pt(w * 0.72, horizon + 1.0), pt(w * 0.8, horizon - h * 0.06), pt(w * 0.9, horizon - h * 0.08), pt(w + 10.0, horizon - h * 0.05), pt(w + 10.0, horizon + 1.0)], faded(fillP(hex("#1b1228")), opacity)))
END FUNC

FUNC twilightInstall(w AS Float, h AS Float) AS Nothing
  LET horizon AS Float = h * 0.66
  canvas::setGroup("twilight-mountains", twilightMountains(w, h, horizon, 1.0))
  canvas::setGroup("twilight-mountains-mirrored", twilightMountains(w, h, horizon, 0.55))
END FUNC

' The portal on the far shore: rings of light from a radial gradient that
' repeats, its radius breathing so the rings seem to flow outward, between two
' standing stones.
FUNC portal(w AS Float, h AS Float, horizon AS Float, t AS Float) AS List OF canvas::DrawItem
  LET px AS Float = w * 0.86
  LET py AS Float = horizon - h * 0.16
  LET pr AS Float = h * 0.075
  LET ringR AS Float = pr * (0.32 + 0.06 * fract(t * 0.5))
  MUT out AS List OF canvas::DrawItem = [glow(px, py, pr * 2.4, rgba(150, 110, 255, 70))]
  out = collections::append(out, ellipse(px, py, pr * 0.62, pr, 0.0, WITH gradP(WITH radial(0.0, 0.0, ringR, [gstop(0.0, rgba(120, 250, 255, 30)), gstop(0.5, rgba(170, 120, 255, 220)), gstop(1.0, rgba(120, 250, 255, 30))]) { spread := canvas::GradientSpread.Repeat }) { blend := canvas::BlendMode.Add, stroke := rgba(200, 180, 255, 220), strokeWidth := 3.0 }))
  out = collections::append(out, ellipse(px, py, pr * 0.62, pr, 0.0, WITH canvas::stroke(rgba(255, 240, 255, 180), 1.5) { dashes := [pr * 0.12, pr * 0.08], dashOffset := t * 40.0, cap := canvas::CapStyle.Round, blend := canvas::BlendMode.Add }))
  out = collections::append(out, polyAt(px, horizon - h * 0.07, [pt(-pr * 0.9, 0.0), pt(-pr * 0.85, py - pr * 1.1 - horizon + h * 0.07), pt(-pr * 0.65, py - pr * 1.2 - horizon + h * 0.07), pt(-pr * 0.6, 0.0)], fillP(hex("#120c1c"))))
  RETURN collections::append(out, polyAt(px, horizon - h * 0.07, [pt(pr * 0.6, 0.0), pt(pr * 0.66, py - pr * 1.25 - horizon + h * 0.07), pt(pr * 0.84, py - pr * 1.1 - horizon + h * 0.07), pt(pr * 0.9, 0.0)], fillP(hex("#120c1c"))))
END FUNC

FUNC twilightDraw(s AS TwilightState, w AS Float, h AS Float) AS List OF canvas::DrawItem
  LET t AS Float = s.t
  LET horizon AS Float = h * 0.66
  ' The sky, and the lake below it.
  MUT out AS List OF canvas::DrawItem = [rect(0.0, 0.0, w, horizon + 1.0, gradP(twilightSky(horizon)))]
  out = collections::append(out, rect(0.0, horizon, w, h - horizon, gradP(downward(h - horizon, [gstop(0.0, hex("#c8546a")), gstop(0.25, hex("#5a2456")), gstop(1.0, hex("#0a0716"))]))))
  out = collections::append(out, starField(w, horizon * 0.6, 120, t, 0.9, 41))

  ' The crescent moon, its light from a focal gradient off to one side.
  LET mx AS Float = w * 0.8
  LET my AS Float = h * 0.17
  LET mr AS Float = h * 0.06
  out = collections::append(out, glow(mx, my, mr * 6.0, rgba(255, 200, 220, 45)))
  out = collections::append(out, crescent(mx, my, mr, 0.42, -0.18, 0.9, gradP(focal(0.0, 0.0, mr, -mr * 0.4, mr * 0.2, [gstop(0.0, hex("#fff8ea")), gstop(1.0, hex("#f6d8c0"))]))))

  ' The mountains, and their reflection: the same figure under a node that
  ' flips it about the horizon.
  out = collections::append(out, node("twilight-mountains", 0.0, 0.0))
  out = collections::append(out, nodeT("twilight-mountains-mirrored", 0.0, horizon * 2.0, scaled(1.0, -1.0)))
  out = collections::append(out, portal(w, h, horizon, t))

  ' Shimmer on the water: thin horizontal glints drifting.
  FOR i = 0 TO 40
    LET gy AS Float = horizon + (h - horizon) * math::pow(hash01(i + 300), 1.5)
    LET gx AS Float = fract(hash01(i + 310) + t * 0.01 * hashRange(i + 320, -1.0, 1.0)) * w
    LET gl AS Float = w * hashRange(i + 330, 0.01, 0.05) * (0.5 + (gy - horizon) / (h - horizon))
    LET ga AS Float = 0.25 + 0.25 * math::sin(t * 1.5 + toFloat(i))
    out = collections::append(out, line(gx - gl, gy, gx + gl, gy, WITH strokeP(rgba(255, 190, 200, math::round(90.0 * ga)), 1.2) { blend := canvas::BlendMode.Add }))
  NEXT

  ' The fountain on its island, and its reflection, squashed a little as well
  ' as flipped, as a reflection seen from above the water is. The fountain's
  ' water and runes move, so it is installed afresh each frame - one list,
  ' placed twice.
  LET fs AS vector::Float2 = fountainSpot(w, h)
  LET baseY AS Float = horizon + h * 0.03
  canvas::setGroup("twilight-fountain", runeFountain(h * 0.2, t, 1.0))
  canvas::setGroup("twilight-fountain-mirrored", runeFountain(h * 0.2, t, 0.4))
  out = collections::append(out, nodeT("twilight-fountain-mirrored", fs.x, baseY, scaled(1.0, -0.7)))
  out = collections::append(out, node("twilight-fountain", fs.x, baseY))

  ' The cliff tree, leaning out over the water.
  out = collections::append(out, gnarled(w * 0.12, h * 0.36, -1.15, h * 0.13, h * 0.022, 7, 1, t, hex("#120a18")))

  ' The flock, each bird turned to its heading. A bird's shade depends on its
  ' height, so the ones low over the bright horizon read as silhouettes.
  FOR EACH b IN s.boids
    LET tone AS color::Color = mixC(hex("#2a1830"), hex("#0d0812"), clamp01(b.y / horizon))
    out = collections::append(out, bird(b.x, b.y, math::atan2(b.vy, b.vx), h * 0.028, math::sin(b.phase), 1.0, tone, mixC(tone, hex("#000000"), 0.3)))
  NEXT
  IF s.scare > 0.0 THEN out = collections::append(out, circle(s.sx, s.sy, h * 0.6 * (1.0 - s.scare), WITH canvas::stroke(rgba(255, 220, 255, math::round(120.0 * s.scare)), 2.0) { blend := canvas::BlendMode.Add }))
  RETURN collections::append(out, vignette(w, h, 170))
END FUNC
