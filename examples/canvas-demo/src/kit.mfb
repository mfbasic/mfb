' kit - the small vocabulary every scene in the demo is drawn with.
'
' canvas items are plain records, so most of this file is shorthand: a point, a
' colour with an alpha, a paint that glows, a gradient from a list of stops, a
' curve. None of it holds state.
'
' Every shape is built where it stands: its position is the point it is
' measured from, and everything else about it - a polygon's points, a curve's
' control points, a gradient's two ends, a clip's rings - is an offset from
' that point. Moving a shape is changing its position alone, and its transform
' turns and scales it about that point. A figure made of several shapes is
' built around its own origin, installed once with canvas::setGroup, and placed
' by a canvas::Group node; nothing here rewrites a finished item to move it.
'
' Each builder returns one canvas::DrawItem, written as a full literal. A scene
' calls them many times rather than spelling records out inline: the code a
' function compiles to grows with the number of items it holds at once.

IMPORT canvas
IMPORT vector
IMPORT collections
IMPORT color
IMPORT math

LET TAU AS Float = 6.283185307179586

' ---------------------------------------------------------------------------
' Numbers
' ---------------------------------------------------------------------------

FUNC clamp01(v AS Float) AS Float
  IF v < 0.0 THEN RETURN 0.0
  IF v > 1.0 THEN RETURN 1.0
  RETURN v
END FUNC

FUNC clampF(v AS Float, lo AS Float, hi AS Float) AS Float
  IF v < lo THEN RETURN lo
  IF v > hi THEN RETURN hi
  RETURN v
END FUNC

FUNC lerp(a AS Float, b AS Float, t AS Float) AS Float
  RETURN a + (b - a) * t
END FUNC

' The fractional part, always in 0..1, also for negative values.
FUNC fract(v AS Float) AS Float
  RETURN v - toFloat(math::floor(v))
END FUNC

FUNC smooth(t AS Float) AS Float
  LET c AS Float = clamp01(t)
  RETURN c * c * (3.0 - 2.0 * c)
END FUNC

FUNC easeOutCubic(t AS Float) AS Float
  LET c AS Float = 1.0 - clamp01(t)
  RETURN 1.0 - c * c * c
END FUNC

FUNC easeInOut(t AS Float) AS Float
  LET c AS Float = clamp01(t)
  IF c < 0.5 THEN RETURN 4.0 * c * c * c
  LET f AS Float = -2.0 * c + 2.0
  RETURN 1.0 - f * f * f / 2.0
END FUNC

' A slight overshoot past 1 and back, for panels that pop in.
FUNC easeOutBack(t AS Float) AS Float
  LET c AS Float = clamp01(t) - 1.0
  RETURN 1.0 + 2.70158 * c * c * c + 1.70158 * c * c
END FUNC

' Move `current` towards `target`, covering the fraction of the gap a spring of
' the given rate covers in `dt` seconds - frame-rate independent smoothing.
FUNC approach(current AS Float, target AS Float, rate AS Float, dt AS Float) AS Float
  RETURN target + (current - target) * math::exp(-rate * dt)
END FUNC

' A repeatable pseudo-random number in 0..1 for an integer seed: the scenery is
' scattered with these, so it is the same every time a scene is opened.
FUNC hash01(n AS Integer) AS Float
  LET s AS Float = math::sin(toFloat(n MOD 100003) * 12.9898 + 78.233) * 43758.5453
  RETURN fract(s)
END FUNC

FUNC hashRange(n AS Integer, lo AS Float, hi AS Float) AS Float
  RETURN lo + (hi - lo) * hash01(n)
END FUNC

' A uniform random Float in lo..hi, from the thread's random sequence: for the
' few things simulated step by step - a flock, falling leaves, a fountain's
' drops - where no two runs need to match.
FUNC randF(lo AS Float, hi AS Float) AS Float
  RETURN lo + (hi - lo) * toFloat(math::rand(0, 1000000)) / 1000000.0
END FUNC

FUNC dist(ax AS Float, ay AS Float, bx AS Float, by AS Float) AS Float
  LET dx AS Float = bx - ax
  LET dy AS Float = by - ay
  RETURN math::sqrt(dx * dx + dy * dy)
END FUNC

' ---------------------------------------------------------------------------
' Colour
' ---------------------------------------------------------------------------

FUNC rgba(r AS Integer, g AS Integer, b AS Integer, a AS Integer) AS color::Color
  RETURN color::rgba(r, g, b, a)
END FUNC

FUNC hex(text AS String) AS color::Color
  RETURN color::fromHex(text)
END FUNC

FUNC clear AS color::Color
  RETURN color::rgba(0, 0, 0, 0)
END FUNC

' A colour with its alpha scaled by `f` (0..1).
FUNC fade(c AS color::Color, f AS Float) AS color::Color
  RETURN color::withAlpha(c, math::round(toFloat(toInt(c.alpha)) * clamp01(f)))
END FUNC

' A colour with alpha set to `f` of opaque.
FUNC alpha(c AS color::Color, f AS Float) AS color::Color
  RETURN color::withAlpha(c, math::round(255.0 * clamp01(f)))
END FUNC

' Blend two colours channel by channel in sRGB, alpha included. (color::mix
' blends in linear light, which is right for light and wrong for a palette
' animated by hand: sRGB steps look even to the eye.)
FUNC mixC(a AS color::Color, b AS color::Color, t AS Float) AS color::Color
  LET k AS Float = clamp01(t)
  LET r AS Integer = math::round(lerp(toFloat(toInt(a.red)), toFloat(toInt(b.red)), k))
  LET g AS Integer = math::round(lerp(toFloat(toInt(a.green)), toFloat(toInt(b.green)), k))
  LET bl AS Integer = math::round(lerp(toFloat(toInt(a.blue)), toFloat(toInt(b.blue)), k))
  LET al AS Integer = math::round(lerp(toFloat(toInt(a.alpha)), toFloat(toInt(b.alpha)), k))
  RETURN color::rgba(r, g, bl, al)
END FUNC

' Sample a palette of colours spread evenly over 0..1.
FUNC rampC(colors AS List OF color::Color, t AS Float) AS color::Color
  LET n AS Integer = len(colors)
  IF n = 1 THEN RETURN collections::get(colors, 0)
  LET f AS Float = clamp01(t) * toFloat(n - 1)
  MUT i AS Integer = math::floor(f)
  IF i >= n - 1 THEN i = n - 2
  RETURN mixC(collections::get(colors, i), collections::get(colors, i + 1), f - toFloat(i))
END FUNC

' ---------------------------------------------------------------------------
' Points, transforms and paints
' ---------------------------------------------------------------------------

FUNC pt(x AS Float, y AS Float) AS vector::Float2
  RETURN vector::Float2[x := x, y := y]
END FUNC

' The all-zero transform: the identity.
FUNC none AS canvas::Transform
  RETURN canvas::Transform[a := 0.0, b := 0.0, c := 0.0, d := 0.0, tx := 0.0, ty := 0.0]
END FUNC

' Turn by `angle` and scale by `sx` along the turned X axis and `sy` along the
' turned Y axis. A negative `sx` mirrors. With no translation, it acts about
' whatever point the item or group it is given to is positioned at.
FUNC turnScale(angle AS Float, sx AS Float, sy AS Float) AS canvas::Transform
  LET co AS Float = math::cos(angle)
  LET si AS Float = math::sin(angle)
  RETURN canvas::Transform[a := co * sx, b := si * sx, c := -si * sy, d := co * sy, tx := 0.0, ty := 0.0]
END FUNC

FUNC turn(angle AS Float) AS canvas::Transform
  RETURN turnScale(angle, 1.0, 1.0)
END FUNC

FUNC scaled(sx AS Float, sy AS Float) AS canvas::Transform
  RETURN canvas::Transform[a := sx, b := 0.0, c := 0.0, d := sy, tx := 0.0, ty := 0.0]
END FUNC

FUNC fillP(c AS color::Color) AS canvas::Paint
  RETURN canvas::fill(c)
END FUNC

FUNC strokeP(c AS color::Color, w AS Float) AS canvas::Paint
  RETURN WITH canvas::stroke(c, w) { cap := canvas::CapStyle.Round, join := canvas::JoinStyle.Round }
END FUNC

FUNC fillStrokeP(fill AS color::Color, stroke AS color::Color, w AS Float) AS canvas::Paint
  RETURN canvas::fillStroke(fill, stroke, w)
END FUNC

' Additive light: what overlapping glows, sparks and sunbeams are drawn with.
FUNC glowP(c AS color::Color) AS canvas::Paint
  RETURN WITH canvas::fill(c) { blend := canvas::BlendMode.Add }
END FUNC

FUNC gradP(g AS canvas::Gradient) AS canvas::Paint
  RETURN WITH canvas::fill(color::white) { gradient := g }
END FUNC

' A paint as it is, made `opacity` (0..1) as opaque again: how a panel fades in
' without a second way of building it.
FUNC faded(p AS canvas::Paint, opacity AS Float) AS canvas::Paint
  IF opacity >= 1.0 THEN RETURN p
  RETURN WITH p { transparency := 1.0 - (1.0 - clamp01(p.transparency)) * clamp01(opacity) }
END FUNC

FUNC gstop(offset AS Float, c AS color::Color) AS canvas::GradientStop
  RETURN canvas::GradientStop[offset := offset, color := c]
END FUNC

' The gradients' points are offsets from the position of the shape they fill.
FUNC linear(x1 AS Float, y1 AS Float, x2 AS Float, y2 AS Float, stops AS List OF canvas::GradientStop) AS canvas::Gradient
  RETURN canvas::Gradient[kind := canvas::GradientKind.Linear, startPoint := pt(x1, y1), endPoint := pt(x2, y2), stops := stops, spread := canvas::GradientSpread.Pad, transform := none(), focalOffset := pt(0.0, 0.0), focalRadius := 0.0, strokeApply := canvas::GradientApply.FillOnly]
END FUNC

' Top to bottom over the height `h` of a shape positioned at its top.
FUNC downward(h AS Float, stops AS List OF canvas::GradientStop) AS canvas::Gradient
  RETURN linear(0.0, 0.0, 0.0, h, stops)
END FUNC

FUNC radial(cx AS Float, cy AS Float, r AS Float, stops AS List OF canvas::GradientStop) AS canvas::Gradient
  RETURN canvas::Gradient[kind := canvas::GradientKind.Radial, startPoint := pt(cx, cy), endPoint := pt(cx + r, cy), stops := stops, spread := canvas::GradientSpread.Pad, transform := none(), focalOffset := pt(0.0, 0.0), focalRadius := 0.0, strokeApply := canvas::GradientApply.FillOnly]
END FUNC

' A radial ramp whose bright start sits off-centre by (fx, fy): the highlight
' on a glass sphere or a pearl.
FUNC focal(cx AS Float, cy AS Float, r AS Float, fx AS Float, fy AS Float, stops AS List OF canvas::GradientStop) AS canvas::Gradient
  RETURN WITH radial(cx, cy, r, stops) { focalOffset := pt(fx, fy) }
END FUNC

' A radial ramp centred on the shape's position and stretched into an ellipse
' of radii rx and ry by the gradient's own transform.
FUNC ovalRamp(rx AS Float, ry AS Float, stops AS List OF canvas::GradientStop) AS canvas::Gradient
  RETURN WITH radial(0.0, 0.0, 1.0, stops) { transform := scaled(rx, ry) }
END FUNC

' ---------------------------------------------------------------------------
' Items
' ---------------------------------------------------------------------------

FUNC rect(x AS Float, y AS Float, w AS Float, h AS Float, p AS canvas::Paint) AS canvas::DrawItem
  RETURN canvas::Rectangle[id := "", position := pt(x, y), bind := canvas::BindTo.TopLeft, size := canvas::Size[width := w, height := h], radiusTL := 0.0, radiusTR := 0.0, radiusBL := 0.0, radiusBR := 0.0, paint := p, transform := none()]
END FUNC

' A rectangle with circular corners of radius `r` pixels (above one; a pill
' when `r` is half the height).
FUNC rrect(x AS Float, y AS Float, w AS Float, h AS Float, r AS Float, p AS canvas::Paint) AS canvas::DrawItem
  RETURN canvas::Rectangle[id := "", position := pt(x, y), bind := canvas::BindTo.TopLeft, size := canvas::Size[width := w, height := h], radiusTL := r, radiusTR := r, radiusBL := r, radiusBR := r, paint := p, transform := none()]
END FUNC

' A rectangle centred on (x, y), turned by `angle` about its middle.
FUNC rectC(x AS Float, y AS Float, w AS Float, h AS Float, r AS Float, angle AS Float, p AS canvas::Paint) AS canvas::DrawItem
  RETURN canvas::Rectangle[id := "", position := pt(x, y), bind := canvas::BindTo.Center, size := canvas::Size[width := w, height := h], radiusTL := r, radiusTR := r, radiusBL := r, radiusBR := r, paint := p, transform := turn(angle)]
END FUNC

FUNC circle(x AS Float, y AS Float, r AS Float, p AS canvas::Paint) AS canvas::DrawItem
  RETURN canvas::Circle[id := "", position := pt(x, y), radius := r, paint := p, transform := none()]
END FUNC

FUNC ellipse(x AS Float, y AS Float, rx AS Float, ry AS Float, angle AS Float, p AS canvas::Paint) AS canvas::DrawItem
  MUT t AS canvas::Transform = none()
  IF angle <> 0.0 THEN t = turn(angle)
  RETURN canvas::Ellipse[id := "", position := pt(x, y), radiusX := rx, radiusY := ry, paint := p, transform := t]
END FUNC

' A line from (x1, y1) to (x2, y2), positioned at its start.
FUNC line(x1 AS Float, y1 AS Float, x2 AS Float, y2 AS Float, p AS canvas::Paint) AS canvas::DrawItem
  RETURN canvas::Line[id := "", position := pt(x1, y1), startAt := pt(0.0, 0.0), endAt := pt(x2 - x1, y2 - y1), paint := p, transform := none()]
END FUNC

FUNC arc(x AS Float, y AS Float, r AS Float, a0 AS Float, a1 AS Float, p AS canvas::Paint) AS canvas::DrawItem
  RETURN canvas::Arc[id := "", position := pt(x, y), radius := r, startAngle := a0, endAngle := a1, paint := p, transform := none()]
END FUNC

' A polygon whose points are measured from (x, y).
FUNC polyAt(x AS Float, y AS Float, points AS List OF vector::Float2, p AS canvas::Paint) AS canvas::DrawItem
  RETURN canvas::Polygon[id := "", position := pt(x, y), contours := [points], rule := canvas::FillRule.NonZero, paint := p, transform := none()]
END FUNC

' A polygon given in window pixels.
FUNC poly(points AS List OF vector::Float2, p AS canvas::Paint) AS canvas::DrawItem
  RETURN polyAt(0.0, 0.0, points, p)
END FUNC

' A polygon of points measured from (x, y), turned and scaled about that point.
FUNC polyT(x AS Float, y AS Float, points AS List OF vector::Float2, t AS canvas::Transform, p AS canvas::Paint) AS canvas::DrawItem
  RETURN canvas::Polygon[id := "", position := pt(x, y), contours := [points], rule := canvas::FillRule.NonZero, paint := p, transform := t]
END FUNC

FUNC shapeAt(x AS Float, y AS Float, rings AS List OF List OF vector::Float2, rule AS canvas::FillRule, p AS canvas::Paint) AS canvas::DrawItem
  RETURN canvas::Polygon[id := "", position := pt(x, y), contours := rings, rule := rule, paint := p, transform := none()]
END FUNC

FUNC pathAt(x AS Float, y AS Float, points AS List OF vector::Float2, p AS canvas::Paint) AS canvas::DrawItem
  RETURN canvas::PolyLine[id := "", position := pt(x, y), points := points, colors := [], paint := p, transform := none()]
END FUNC

FUNC path(points AS List OF vector::Float2, p AS canvas::Paint) AS canvas::DrawItem
  RETURN pathAt(0.0, 0.0, points, p)
END FUNC

' A PolyLine whose stroke colour runs from point to point: a fading trail.
FUNC trail(points AS List OF vector::Float2, colors AS List OF color::Color, p AS canvas::Paint) AS canvas::DrawItem
  RETURN canvas::PolyLine[id := "", position := pt(0.0, 0.0), points := points, colors := colors, paint := p, transform := none()]
END FUNC

FUNC label(font AS canvas::Font, size AS Float, text AS String, x AS Float, baseline AS Float, c AS color::Color) AS canvas::DrawItem
  RETURN canvas::Text[id := "", position := pt(x, baseline), text := text, font := font, fontSize := size, paint := canvas::fill(c), transform := none()]
END FUNC

FUNC labelP(font AS canvas::Font, size AS Float, text AS String, x AS Float, baseline AS Float, p AS canvas::Paint) AS canvas::DrawItem
  RETURN canvas::Text[id := "", position := pt(x, baseline), text := text, font := font, fontSize := size, paint := p, transform := none()]
END FUNC

' A soft round glow: a disc whose radial ramp falls away quickly from `c` and
' then slowly to nothing, as light does, added onto what is beneath it.
FUNC glowRamp(r AS Float, c AS color::Color) AS canvas::Gradient
  RETURN radial(0.0, 0.0, r, [gstop(0.0, c), gstop(0.2, fade(c, 0.5)), gstop(0.5, fade(c, 0.15)), gstop(1.0, fade(c, 0.0))])
END FUNC

FUNC glow(x AS Float, y AS Float, r AS Float, c AS color::Color) AS canvas::DrawItem
  RETURN circle(x, y, r, WITH glowP(color::white) { gradient := glowRamp(r, c) })
END FUNC

' ---------------------------------------------------------------------------
' Groups
' ---------------------------------------------------------------------------

' A use of an installed group, its origin at (x, y).
FUNC node(name AS String, x AS Float, y AS Float) AS canvas::DrawItem
  RETURN canvas::Group[id := "", position := pt(x, y), transform := none(), name := name]
END FUNC

' The same, turned, scaled or mirrored about (x, y).
FUNC nodeT(name AS String, x AS Float, y AS Float, t AS canvas::Transform) AS canvas::DrawItem
  RETURN canvas::Group[id := "", position := pt(x, y), transform := t, name := name]
END FUNC

' A use with an id of its own, which canvas::MouseEvent.overID puts in front
' of the ids inside it: one group drawn ten times, told apart by this.
FUNC nodeId(id AS String, name AS String, x AS Float, y AS Float, t AS canvas::Transform) AS canvas::DrawItem
  RETURN canvas::Group[id := id, position := pt(x, y), transform := t, name := name]
END FUNC

' ---------------------------------------------------------------------------
' Curves
' ---------------------------------------------------------------------------

FUNC bz(points AS List OF vector::Float2) AS canvas::BezierCurve
  RETURN canvas::BezierCurve[points := points, weights := []]
END FUNC

FUNC straight(x0 AS Float, y0 AS Float, x1 AS Float, y1 AS Float) AS canvas::BezierCurve
  RETURN bz([pt(x0, y0), pt(x1, y1)])
END FUNC

FUNC quad(x0 AS Float, y0 AS Float, x1 AS Float, y1 AS Float, x2 AS Float, y2 AS Float) AS canvas::BezierCurve
  RETURN bz([pt(x0, y0), pt(x1, y1), pt(x2, y2)])
END FUNC

FUNC cubic(x0 AS Float, y0 AS Float, x1 AS Float, y1 AS Float, x2 AS Float, y2 AS Float, x3 AS Float, y3 AS Float) AS canvas::BezierCurve
  RETURN bz([pt(x0, y0), pt(x1, y1), pt(x2, y2), pt(x3, y3)])
END FUNC

' The straight edges through a list of points, in order, as two-point curves:
' a polygon's outline as a chain a CurvePolygon or PolyCurve can take.
FUNC straights(points AS List OF vector::Float2) AS List OF canvas::BezierCurve
  MUT out AS List OF canvas::BezierCurve = []
  FOR k = 1 TO len(points) - 1
    LET a AS vector::Float2 = collections::get(points, k - 1)
    LET b AS vector::Float2 = collections::get(points, k)
    out = collections::append(out, straight(a.x, a.y, b.x, b.y))
  NEXT
  RETURN out
END FUNC

' An arc of the ellipse of radii rx, ry about (cx, cy), from angle a0 to a1
' (clockwise when a1 > a0), as exact rational quadratic curves of at most a
' quarter turn each: a conic is a rational quadratic, so no point of it is an
' approximation.
FUNC arcCurves(cx AS Float, cy AS Float, rx AS Float, ry AS Float, a0 AS Float, a1 AS Float) AS List OF canvas::BezierCurve
  LET n AS Integer = math::max(1, math::ceil(math::abs(a1 - a0) / (math::pi / 2.0) - 0.000001))
  LET d AS Float = (a1 - a0) / toFloat(n)
  LET w AS Float = math::cos(d / 2.0)
  MUT out AS List OF canvas::BezierCurve = []
  FOR i = 0 TO n - 1
    LET s AS Float = a0 + d * toFloat(i)
    LET m AS Float = s + d / 2.0
    LET e AS Float = s + d
    out = collections::append(out, canvas::BezierCurve[points := [pt(cx + rx * math::cos(s), cy + ry * math::sin(s)), pt(cx + rx * math::cos(m) / w, cy + ry * math::sin(m) / w), pt(cx + rx * math::cos(e), cy + ry * math::sin(e))], weights := [1.0, w, 1.0]])
  NEXT
  RETURN out
END FUNC

' A whole ellipse as one closed contour, from angle `a0` round clockwise.
FUNC ovalCurves(cx AS Float, cy AS Float, rx AS Float, ry AS Float) AS List OF canvas::BezierCurve
  RETURN arcCurves(cx, cy, rx, ry, 0.0, TAU)
END FUNC

' The same, anticlockwise: under FillRule.NonZero a contour wound against the
' one around it cuts a hole.
FUNC ovalCurvesCcw(cx AS Float, cy AS Float, rx AS Float, ry AS Float) AS List OF canvas::BezierCurve
  RETURN arcCurves(cx, cy, rx, ry, TAU, 0.0)
END FUNC

FUNC pickPt(points AS List OF vector::Float2, i AS Integer) AS vector::Float2
  RETURN collections::get(points, math::max(0, math::min(len(points) - 1, i)))
END FUNC

' The smooth curve through every point, in order: each stretch between two
' points a cubic whose ends leave in the direction of the neighbours either
' side (a Catmull-Rom spline). For outlines that are naturally curved but only
' known at a few points - a stream, a hill line, a vine.
FUNC smoothCurves(points AS List OF vector::Float2) AS List OF canvas::BezierCurve
  MUT out AS List OF canvas::BezierCurve = []
  FOR i = 0 TO len(points) - 2
    LET p0 AS vector::Float2 = pickPt(points, i - 1)
    LET p1 AS vector::Float2 = pickPt(points, i)
    LET p2 AS vector::Float2 = pickPt(points, i + 1)
    LET p3 AS vector::Float2 = pickPt(points, i + 2)
    out = collections::append(out, cubic(p1.x, p1.y, p1.x + (p2.x - p0.x) / 6.0, p1.y + (p2.y - p0.y) / 6.0, p2.x - (p3.x - p1.x) / 6.0, p2.y - (p3.y - p1.y) / 6.0, p2.x, p2.y))
  NEXT
  RETURN out
END FUNC

' A closed smooth curve through every point, back to the first.
FUNC smoothLoop(points AS List OF vector::Float2) AS List OF canvas::BezierCurve
  LET n AS Integer = len(points)
  MUT out AS List OF canvas::BezierCurve = []
  FOR i = 0 TO n - 1
    LET p0 AS vector::Float2 = collections::get(points, (i + n - 1) MOD n)
    LET p1 AS vector::Float2 = collections::get(points, i)
    LET p2 AS vector::Float2 = collections::get(points, (i + 1) MOD n)
    LET p3 AS vector::Float2 = collections::get(points, (i + 2) MOD n)
    out = collections::append(out, cubic(p1.x, p1.y, p1.x + (p2.x - p0.x) / 6.0, p1.y + (p2.y - p0.y) / 6.0, p2.x - (p3.x - p1.x) / 6.0, p2.y - (p3.y - p1.y) / 6.0, p2.x, p2.y))
  NEXT
  RETURN out
END FUNC

' Points along a chain of curves, for the one thing that has to be points: a
' Paint.clip ring. canvas::flatten keeps every point within `tolerance` of the
' curve; the first point of each curve after the first repeats the last of the
' one before, so it is dropped.
FUNC flattenAll(curves AS List OF canvas::BezierCurve, tolerance AS Float) AS List OF vector::Float2
  MUT out AS List OF vector::Float2 = []
  FOR EACH c IN curves
    LET pts AS List OF vector::Float2 = canvas::flatten(c, tolerance)
    IF len(out) = 0 THEN
      out = pts
    ELSE
      out = collections::append(out, collections::drop(pts, 1))
    END IF
  NEXT
  RETURN out
END FUNC

' A closed curved shape: one or more contours of curves, positioned at (x, y).
FUNC curveShape(x AS Float, y AS Float, contours AS List OF List OF canvas::BezierCurve, rule AS canvas::FillRule, p AS canvas::Paint) AS canvas::DrawItem
  RETURN canvas::CurvePolygon[id := "", position := pt(x, y), contours := contours, rule := rule, paint := p, transform := none()]
END FUNC

' The same, turned and scaled about (x, y) by its own transform - which is how
' a curved shape is enlarged without losing its smoothness.
FUNC curveShapeT(x AS Float, y AS Float, contours AS List OF List OF canvas::BezierCurve, rule AS canvas::FillRule, t AS canvas::Transform, p AS canvas::Paint) AS canvas::DrawItem
  RETURN canvas::CurvePolygon[id := "", position := pt(x, y), contours := contours, rule := rule, paint := p, transform := t]
END FUNC

' An open stroked path of curves, positioned at (x, y).
FUNC curvePath(x AS Float, y AS Float, curves AS List OF canvas::BezierCurve, p AS canvas::Paint) AS canvas::DrawItem
  RETURN canvas::PolyCurve[id := "", position := pt(x, y), curves := curves, paint := p, transform := none()]
END FUNC

FUNC curvePathT(x AS Float, y AS Float, curves AS List OF canvas::BezierCurve, t AS canvas::Transform, p AS canvas::Paint) AS canvas::DrawItem
  RETURN canvas::PolyCurve[id := "", position := pt(x, y), curves := curves, paint := p, transform := t]
END FUNC

' Points carried through a transform's turn and scale, for a shape that is
' made afresh every frame in large numbers - a flock, a fall of leaves. Such a
' shape is built from points already turned rather than given its own
' transform: the canvas's fast geometry builder takes only shapes with no
' transform in effect. Measured on scene III's 150 birds (450 polygons a
' frame, headless on Metal, best of three): with their own transforms the
' graphics thread's geometry phase took 2.97 ms a frame, with points turned
' here 0.75 ms, and the frame 16.3 ms against 13.9.
FUNC turned(points AS List OF vector::Float2, m AS canvas::Transform) AS List OF vector::Float2
  RETURN collections::transform(points, LAMBDA(q AS vector::Float2) -> pt(m.a * q.x + m.c * q.y, m.b * q.x + m.d * q.y))
END FUNC

' ---------------------------------------------------------------------------
' Rings of points
' ---------------------------------------------------------------------------

FUNC rectRing(x AS Float, y AS Float, w AS Float, h AS Float) AS List OF vector::Float2
  RETURN [pt(x, y), pt(x + w, y), pt(x + w, y + h), pt(x, y + h)]
END FUNC

' The points of an ellipse, for a clip: its curves flattened to within a
' tenth of a pixel.
FUNC ovalRing(cx AS Float, cy AS Float, rx AS Float, ry AS Float) AS List OF vector::Float2
  RETURN flattenAll(ovalCurves(cx, cy, rx, ry), 0.1)
END FUNC

' A ring given about some point, as seen from a point (dx, dy) away from it -
' a shared clip put into the coordinates of an item positioned there.
FUNC ringFrom(ring AS List OF vector::Float2, dx AS Float, dy AS Float) AS List OF vector::Float2
  RETURN collections::transform(ring, LAMBDA(p AS vector::Float2) -> pt(p.x - dx, p.y - dy))
END FUNC

' A ridge line across the width `w`: a mountain range or a hill crest, as the
' top edge of a polygon closed along `baseY`. `seed` picks the ridge; `rough`
' is how jagged it is.
FUNC ridge(w AS Float, baseY AS Float, topY AS Float, amp AS Float, seed AS Integer, rough AS Float, steps AS Integer) AS List OF vector::Float2
  MUT out AS List OF vector::Float2 = [pt(-20.0, baseY)]
  FOR i = 0 TO steps
    LET u AS Float = toFloat(i) / toFloat(steps)
    LET s AS Float = toFloat(seed)
    LET h AS Float = math::sin(u * 3.1 + s) * 0.45 + math::sin(u * 7.3 + s * 1.9) * 0.3 * rough + math::sin(u * 17.0 + s * 3.1) * 0.15 * rough + (hash01(seed * 131 + i) - 0.5) * 0.18 * rough
    out = collections::append(out, pt(-20.0 + (w + 40.0) * u, topY - amp * h))
  NEXT
  RETURN collections::append(out, pt(w + 20.0, baseY))
END FUNC

' ---------------------------------------------------------------------------
' Light
' ---------------------------------------------------------------------------

' Darken the corners: an elliptical radial ramp, centred in the window and
' stretched to its shape by the gradient's own transform, from clear in the
' middle to `strength` (0..255) black at the edges.
FUNC vignette(w AS Float, h AS Float, strength AS Integer) AS canvas::DrawItem
  LET g AS canvas::Gradient = WITH radial(0.0, 0.0, w * 0.72, [gstop(0.0, rgba(0, 0, 0, 0)), gstop(0.6, rgba(0, 0, 0, 0)), gstop(1.0, rgba(0, 0, 0, strength))]) { transform := canvas::Transform[a := 1.0, b := 0.0, c := 0.0, d := h / w, tx := w * 0.5, ty := h * 0.5] }
  RETURN rect(0.0, 0.0, w, h, gradP(g))
END FUNC

' A soft shaft of light from (x, y) along `angle`, `length` long and `width`
' wide at its broadest: a rectangle centred on the shaft's middle and turned
' to lie along it, filled with a radial ramp that the gradient's own transform
' stretches into a long thin ellipse, so it feathers out sideways and along its
' length at once. The focal offset pulls the brightest point back towards the
' source.
FUNC beam(x AS Float, y AS Float, angle AS Float, length AS Float, width AS Float, c AS color::Color, strength AS Float) AS canvas::DrawItem
  LET hl AS Float = length / 2.0
  LET g AS canvas::Gradient = WITH radial(0.0, 0.0, 1.0, [gstop(0.0, fade(c, strength)), gstop(0.4, fade(c, strength * 0.5)), gstop(1.0, fade(c, 0.0))]) { transform := scaled(hl, width), focalOffset := pt(-0.6, 0.0) }
  RETURN rectC(x + math::cos(angle) * hl, y + math::sin(angle) * hl, length, width * 2.0, 0.0, angle, WITH glowP(color::white) { gradient := g })
END FUNC
