' spring - II. The Guardian of the Spring.
'
' A hidden glade at nightfall where a mossy stone fountain spills into a pool.
' Water drops fall from the upper bowl and, where each one lands, a ripple
' spreads across the pool - clipped to the pool's own ellipse, so a ripple near
' the rim is cut off by the stone. A glowing sprite, the guardian, follows the
' mouse on a spring and trails light; click and it dives into the pool, and a
' burst of sparks flies up where it lands. Small birds drink at the rim and
' scatter when the guardian comes too close.
'
' The glade is drawn in depth layers. The still ones - far trees, the middle
' woods, the ferns in front, the fountain's stone - are each installed once as
' a named group with canvas::setGroup, and the frame only says where to draw
' them: as the mouse moves, each layer slides by a different amount, the near
' ones most. The basin's curved wall and its rim are CurvePolygons: arcs of
' ellipses, exactly.

IMPORT canvas
IMPORT vector
IMPORT collections
IMPORT color
IMPORT math

' A drop of the fountain's water. The drops are moved step by step rather than
' drawn by a particle system because each one makes a ripple where it lands -
' a particle's place is worked out afresh every frame, and nothing is told
' when it reaches the water.
TYPE Drop
  x AS Float
  y AS Float
  vx AS Float
  vy AS Float
  big AS Boolean       ' splash spray, which falls into the pool as well
END TYPE

TYPE Ripple
  x AS Float
  y AS Float
  age AS Float
  strength AS Float    ' 0..1; a splash is 1, a drop much less
END TYPE

' A spark the guardian sheds behind it. These too are moved by hand: they are
' left where the guardian was, and a particle system's particles all move
' with the system when it moves.
TYPE Spark
  x AS Float
  y AS Float
  vx AS Float
  vy AS Float
  age AS Float
  life AS Float
END TYPE

' A bird that drinks at the rim: `away` runs 0 (drinking) to 1 (gone), and the
' bird flies out along an arc and back as it changes.
TYPE Drinker
  homeX AS Float       ' its place on the rim, as a fraction of the pool's half-width
  away AS Float
  fleeing AS Boolean
  calm AS Float        ' seconds until it dares come back
END TYPE

TYPE SpringState
  t AS Float
  fx AS Float          ' the fireflies' clock
  w AS Float           ' the size the groups were installed for
  h AS Float
  px AS Float          ' the parallax, -1..1 each way, eased towards the mouse
  py AS Float
  sx AS Float          ' the guardian
  sy AS Float
  svx AS Float
  svy AS Float
  trail AS List OF vector::Float2
  diving AS Boolean
  diveT AS Float       ' seconds into the dive
  diveX AS Float       ' where the dive began
  diveY AS Float
  splashT AS Float     ' seconds since the last dive landed, or -1 before the first
  splashX AS Float     ' where it landed
  splashY AS Float
  surge AS Float       ' 1 just after a dive, fading: the fountain's runes glow
  emit AS Float        ' drops owed to the stream, carried between frames
  drops AS List OF Drop
  ripples AS List OF Ripple
  sparks AS List OF Spark
  birds AS List OF Drinker
END TYPE

FUNC springNew AS SpringState
  RETURN SpringState[t := 0.0, fx := 0.0, w := 0.0, h := 0.0, px := 0.0, py := 0.0, sx := -1.0, sy := -1.0, svx := 0.0, svy := 0.0, trail := [], diving := FALSE, diveT := 0.0, diveX := 0.0, diveY := 0.0, splashT := -1.0, splashX := 0.0, splashY := 0.0, surge := 0.0, emit := 0.0, drops := [], ripples := [], sparks := [], birds := [Drinker[homeX := -0.82, away := 0.0, fleeing := FALSE, calm := 0.0], Drinker[homeX := -0.35, away := 0.0, fleeing := FALSE, calm := 0.0], Drinker[homeX := 0.55, away := 0.0, fleeing := FALSE, calm := 0.0]]]
END FUNC

' ---------------------------------------------------------------------------
' Where things are
' ---------------------------------------------------------------------------

TYPE Fountain
  cx AS Float
  poolY AS Float       ' the water's surface, at the pool's centre
  rx AS Float          ' the pool's radii
  ry AS Float
  bowlY AS Float       ' the upper bowl's rim
  bowlR AS Float
END TYPE

FUNC fountainAt(w AS Float, h AS Float, ox AS Float, oy AS Float) AS Fountain
  LET rx AS Float = math::min(w * 0.25, h * 0.42)
  RETURN Fountain[cx := w * 0.5 + ox, poolY := h * 0.77 + oy, rx := rx, ry := rx * 0.22, bowlY := h * 0.5 + oy, bowlR := rx * 0.36]
END FUNC

' How far each layer slides at full parallax, in pixels.
LET SPRING_FAR AS Float = 10.0
LET SPRING_MID AS Float = 24.0
LET SPRING_POOL AS Float = 38.0
LET SPRING_NEAR AS Float = 80.0

' The splash: how many sparks, and the longest any of them lives.
LET SPLASH_SPARKS AS Integer = 30
LET SPLASH_LIFE AS Float = 1.3

' ---------------------------------------------------------------------------
' The still layers, installed as groups
' ---------------------------------------------------------------------------

' A fern frond rooted at (x, y), `size` tall, leaning by `lean`: a curving stem
' with leaflets that shrink towards the tip. The stem is a smooth curve through
' every other point it is worked out at; the leaflets sit on the points.
FUNC fern(x AS Float, y AS Float, size AS Float, lean AS Float, seed AS Integer, c AS color::Color) AS List OF canvas::DrawItem
  LET n AS Integer = 14
  MUT stem AS List OF vector::Float2 = []
  FOR i = 0 TO n
    LET u AS Float = toFloat(i) / toFloat(n)
    LET a AS Float = -math::pi / 2.0 + lean * u * 1.6
    stem = collections::append(stem, pt(math::sin(lean) * size * u * 0.6 + math::cos(a) * size * u * 0.35, -size * u + size * u * u * 0.25 * math::abs(lean)))
  NEXT
  MUT knots AS List OF vector::Float2 = []
  FOR i = 0 TO n STEP 2
    knots = collections::append(knots, collections::get(stem, i))
  NEXT
  MUT out AS List OF canvas::DrawItem = [curvePath(x, y, smoothCurves(knots), strokeP(mixC(c, color::black, 0.3), size * 0.018))]
  FOR i = 1 TO n - 1
    LET p AS vector::Float2 = collections::get(stem, i)
    LET q AS vector::Float2 = collections::get(stem, i + 1)
    LET dir AS Float = math::atan2(q.y - p.y, q.x - p.x)
    LET len_ AS Float = size * 0.2 * (1.0 - toFloat(i) / toFloat(n)) * hashRange(seed * 7 + i, 0.8, 1.1)
    FOR side = -1 TO 1 STEP 2
      LET a AS Float = dir + toFloat(side) * 1.15
      LET tipX AS Float = math::cos(a) * len_
      LET tipY AS Float = math::sin(a) * len_ + len_ * 0.25
      LET nx AS Float = -math::sin(a) * len_ * 0.14
      LET ny AS Float = math::cos(a) * len_ * 0.14
      out = collections::append(out, polyAt(x + p.x, y + p.y, [pt(0.0, 0.0), pt(tipX / 2.0 + nx, tipY / 2.0 + ny), pt(tipX, tipY), pt(tipX / 2.0 - nx, tipY / 2.0 - ny)], fillP(mixC(c, hex("#b8ff9a"), hash01(seed * 3 + i + side) * 0.18))))
    NEXT
  NEXT
  RETURN out
END FUNC

FUNC springFarLayer(w AS Float, h AS Float) AS List OF canvas::DrawItem
  MUT out AS List OF canvas::DrawItem = [poly(ridge(w + 40.0, h, h * 0.5, h * 0.06, 14, 0.7, 50), fillP(hex("#1a3a4a")))]
  out = collections::append(out, pineRow(w + 40.0, h * 0.6, h * 0.22, 26, 41, fillP(hex("#163242"))))
  out = collections::append(out, rect(-40.0, h * 0.45, w + 80.0, h * 0.2, gradP(downward(h * 0.2, [gstop(0.0, rgba(120, 200, 210, 0)), gstop(0.6, rgba(120, 200, 210, 45)), gstop(1.0, rgba(120, 200, 210, 0))]))))
  RETURN collections::append(out, pineRow(w + 40.0, h * 0.7, h * 0.3, 16, 43, fillP(hex("#10283a"))))
END FUNC

FUNC trunk(x0 AS Float, x1 AS Float, points AS List OF vector::Float2, mid AS Float) AS canvas::DrawItem
  RETURN polyAt(x0, 0.0, points, gradP(linear(0.0, 0.0, x1 - x0, 0.0, [gstop(0.0, hex("#0d1c22")), gstop(mid, hex("#1f3a3e")), gstop(1.0, hex("#0d1c22"))])))
END FUNC

FUNC springMidLayer(w AS Float, h AS Float) AS List OF canvas::DrawItem
  ' Old trunks at the edges of the glade, and the mossy bank behind the pool.
  MUT out AS List OF canvas::DrawItem = [trunk(w * 0.04, w * 0.17, [pt(0.0, h), pt(w * 0.03, h * 0.2), pt(w * 0.02, -20.0), pt(w * 0.12, -20.0), pt(w * 0.09, h * 0.25), pt(w * 0.13, h)], 0.7)]
  out = collections::append(out, trunk(w * 0.86, w * 0.99, [pt(0.0, h), pt(w * 0.03, h * 0.3), pt(w * 0.02, -20.0), pt(w * 0.11, -20.0), pt(w * 0.09, h * 0.3), pt(w * 0.13, h)], 0.4))
  out = collections::append(out, poly(ridge(w + 60.0, h + 40.0, h * 0.72, h * 0.03, 17, 0.4, 40), gradP(linear(0.0, h * 0.68, 0.0, h, [gstop(0.0, hex("#2c5a3c")), gstop(0.3, hex("#1b3c2a")), gstop(1.0, hex("#0a1810"))]))))
  FOR i = 0 TO 7
    out = collections::append(out, fern(hash01(i + 600) * w, h * hashRange(i + 610, 0.72, 0.78), h * hashRange(i + 620, 0.12, 0.2), hashRange(i + 630, -0.6, 0.6), i + 1, hex("#2f6a44")))
  NEXT
  RETURN out
END FUNC

FUNC springNearLayer(w AS Float, h AS Float) AS List OF canvas::DrawItem
  MUT out AS List OF canvas::DrawItem = fern(-w * 0.02, h * 1.05, h * 0.5, 0.55, 31, hex("#173a26"))
  out = collections::append(out, fern(w * 0.06, h * 1.08, h * 0.42, 0.25, 32, hex("#1d4630")))
  out = collections::append(out, fern(w * 1.02, h * 1.05, h * 0.55, -0.6, 33, hex("#173a26")))
  out = collections::append(out, fern(w * 0.93, h * 1.08, h * 0.38, -0.3, 34, hex("#1d4630")))
  out = collections::append(out, fern(w * 0.3, h * 1.12, h * 0.25, -0.2, 35, hex("#14301f")))
  RETURN collections::append(out, fern(w * 0.72, h * 1.12, h * 0.28, 0.3, 36, hex("#14301f")))
END FUNC

' The willow's dark crown, which the fronds hang from: (0, 0) is the foot of
' its trunk.
FUNC willowCrown(h AS Float) AS List OF canvas::DrawItem
  MUT out AS List OF canvas::DrawItem = [poly([pt(-h * 0.035, 0.0), pt(-h * 0.015, -h * 0.3), pt(h * 0.04, -h * 0.47), pt(h * 0.06, -h * 0.45), pt(h * 0.015, -h * 0.28), pt(h * 0.04, 0.0)], gradP(linear(-h * 0.04, 0.0, h * 0.04, 0.0, [gstop(0.0, hex("#101c18")), gstop(0.6, hex("#2a3a30")), gstop(1.0, hex("#101c18"))])))]
  FOR i = 0 TO 9
    LET cy AS Float = -h * (0.48 + 0.05 * math::sin(toFloat(i) * 0.9) + hashRange(i + 540, -0.02, 0.02))
    out = collections::append(out, ellipse(h * (-0.17 + 0.042 * toFloat(i)), cy, h * hashRange(i + 550, 0.05, 0.08), h * hashRange(i + 560, 0.035, 0.05), hashRange(i + 570, -0.4, 0.4), gradP(linear(0.0, -h * 0.05, 0.0, h * 0.05, [gstop(0.0, hex("#2f6040")), gstop(1.0, hex("#12261c"))]))))
  NEXT
  RETURN out
END FUNC

' The stone fountain, around the middle of the pool's surface: a wide basin
' whose wall is the front half of an elliptical band - its rim, then back
' along its foot - and over the wall's runes, a rim that is a ring of two
' ellipses, with moss on it.
FUNC fountainWall(f AS Fountain) AS canvas::DrawItem
  LET rimH AS Float = f.ry * 0.9
  MUT wall AS List OF canvas::BezierCurve = arcCurves(0.0, -rimH * 0.15, f.rx * 1.06, f.ry * 1.06, 0.0, math::pi)
  wall = collections::append(wall, arcCurves(0.0, rimH * 2.6, f.rx * 1.02, f.ry * 1.02, math::pi, 0.0))
  RETURN curveShape(0.0, 0.0, [wall], canvas::FillRule.NonZero, gradP(linear(-f.rx, 0.0, f.rx, 0.0, [gstop(0.0, hex("#2c3836")), gstop(0.45, hex("#7d8c88")), gstop(1.0, hex("#2c3836"))])))
END FUNC

FUNC fountainRim(f AS Fountain) AS List OF canvas::DrawItem
  LET rimH AS Float = f.ry * 0.9
  MUT out AS List OF canvas::DrawItem = [curveShape(0.0, 0.0, [ovalCurves(0.0, -rimH * 0.15, f.rx * 1.1, f.ry * 1.25), ovalCurves(0.0, 0.0, f.rx * 0.97, f.ry * 0.95)], canvas::FillRule.EvenOdd, WITH gradP(linear(0.0, -f.ry * 1.3, 0.0, f.ry * 1.2, [gstop(0.0, hex("#5f6f69")), gstop(0.5, hex("#97a59c")), gstop(1.0, hex("#4c5a55"))])) { stroke := hex("#1d2826"), strokeWidth := 1.2 })]
  FOR i = 0 TO 23
    LET a AS Float = math::pi * hashRange(i + 700, 0.03, 0.97)
    out = collections::append(out, ellipse(math::cos(a) * f.rx * 1.05, math::sin(a) * f.ry * 1.1 - f.ry * 0.05, f.rx * hashRange(i + 710, 0.025, 0.06), f.ry * 0.11, 0.0, fillP(mixC(hex("#2c5a2c"), hex("#5f9440"), hash01(i + 720)))))
  NEXT
  RETURN out
END FUNC

' The pillar and the upper bowl, around the bowl's rim.
FUNC fountainPillar(f AS Fountain) AS List OF canvas::DrawItem
  LET pw AS Float = f.bowlR * 0.24
  LET drop AS Float = f.poolY - f.bowlY
  LET stoneLit AS color::Color = hex("#8a9993")
  LET stoneDark AS color::Color = hex("#2c3836")
  ' The pillar, waisted in the middle, with grooves.
  MUT out AS List OF canvas::DrawItem = [poly([pt(-pw * 1.3, drop), pt(-pw * 0.8, drop * 0.5), pt(-pw * 1.1, f.bowlR * 0.2), pt(pw * 1.1, f.bowlR * 0.2), pt(pw * 0.8, drop * 0.5), pt(pw * 1.3, drop)], gradP(linear(-pw, 0.0, pw, 0.0, [gstop(0.0, stoneDark), gstop(0.4, stoneLit), gstop(1.0, stoneDark)])))]
  FOR i = -1 TO 1
    out = collections::append(out, line(toFloat(i) * pw * 0.45, f.bowlR * 0.3, toFloat(i) * pw * 0.6, drop - 4.0, strokeP(rgba(20, 28, 26, 120), 1.2)))
  NEXT
  ' The upper bowl: a shallow cup, its water surface, and its lip.
  out = collections::append(out, poly([pt(-f.bowlR, 0.0), pt(-f.bowlR * 0.75, f.bowlR * 0.28), pt(-f.bowlR * 0.3, f.bowlR * 0.36), pt(f.bowlR * 0.3, f.bowlR * 0.36), pt(f.bowlR * 0.75, f.bowlR * 0.28), pt(f.bowlR, 0.0)], gradP(linear(-f.bowlR, 0.0, f.bowlR, 0.0, [gstop(0.0, stoneDark), gstop(0.45, stoneLit), gstop(1.0, stoneDark)]))))
  out = collections::append(out, ellipse(0.0, 0.0, f.bowlR, f.bowlR * 0.2, 0.0, WITH gradP(radial(0.0, 0.0, f.bowlR, [gstop(0.0, hex("#6fe0e8")), gstop(1.0, hex("#1d5a66"))])) { stroke := hex("#a9b6ae"), strokeWidth := 2.0 }))
  ' A spout at the top bubbling up.
  RETURN collections::append(out, ellipse(0.0, -2.0, f.bowlR * 0.12, f.bowlR * 0.05, 0.0, glowP(rgba(160, 250, 255, 160))))
END FUNC

FUNC springInstall(w AS Float, h AS Float) AS Nothing
  canvas::setGroup("spring-far", springFarLayer(w, h))
  canvas::setGroup("spring-mid", springMidLayer(w, h))
  canvas::setGroup("spring-near", springNearLayer(w, h))
  canvas::setGroup("spring-willow", willowCrown(h))
  LET f AS Fountain = fountainAt(w, h, 0.0, 0.0)
  canvas::setGroup("spring-wall", [fountainWall(f)])
  canvas::setGroup("spring-rim", fountainRim(f))
  canvas::setGroup("spring-pillar", fountainPillar(f))
  FOR i = 0 TO 2
    installSongbird("spring" & toString(i), drinkerColor(i), hex("#e8d6b0"))
  NEXT
END FUNC

FUNC drinkerColor(i AS Integer) AS color::Color
  RETURN mixC(hex("#5d6f8a"), hex("#8a5a3a"), toFloat(i) / 2.0)
END FUNC

' ---------------------------------------------------------------------------
' Stepping
' ---------------------------------------------------------------------------

FUNC insidePool(f AS Fountain, x AS Float, y AS Float) AS Boolean
  LET dx AS Float = (x - f.cx) / f.rx
  LET dy AS Float = (y - f.poolY) / f.ry
  RETURN dx * dx + dy * dy <= 1.0
END FUNC

FUNC springStep(s AS SpringState, inp AS Input, dt AS Float) AS SpringState
  LET w AS Float = inp.w
  LET h AS Float = inp.h
  IF s.w <> w OR s.h <> h THEN springInstall(w, h)
  LET t AS Float = s.t + dt
  ' Parallax follows the mouse, eased.
  MUT tx AS Float = 0.0
  MUT ty AS Float = 0.0
  IF inp.mx >= 0.0 THEN
    tx = clampF((inp.mx / w - 0.5) * 2.0, -1.0, 1.0)
    ty = clampF((inp.my / h - 0.5) * 2.0, -1.0, 1.0)
  END IF
  LET px AS Float = approach(s.px, tx, 3.0, dt)
  LET py AS Float = approach(s.py, ty, 3.0, dt)
  LET f AS Fountain = fountainAt(w, h, -px * SPRING_POOL, -py * SPRING_POOL * 0.4)

  ' The guardian: a damped spring towards the mouse, or towards the pool when
  ' diving. Before the mouse is seen it circles the fountain.
  MUT sx AS Float = s.sx
  MUT sy AS Float = s.sy
  IF sx < 0.0 THEN
    sx = f.cx + f.rx * 0.6
    sy = f.bowlY - h * 0.1
  END IF
  MUT goalX AS Float = f.cx + math::cos(t * 0.6) * f.rx * 0.9
  MUT goalY AS Float = f.bowlY - h * 0.12 + math::sin(t * 1.2) * h * 0.05
  IF inp.mx >= 0.0 THEN
    goalX = inp.mx
    goalY = inp.my
  END IF
  MUT diving AS Boolean = s.diving
  MUT diveT AS Float = s.diveT + dt
  MUT diveX AS Float = s.diveX
  MUT diveY AS Float = s.diveY
  IF inp.pressed AND NOT diving THEN
    diving = TRUE
    diveT = 0.0
    diveX = sx
    diveY = sy
  END IF
  LET k AS Float = 34.0
  LET damp AS Float = 7.5
  MUT svx AS Float = s.svx + ((goalX - sx) * k - s.svx * damp) * dt
  MUT svy AS Float = s.svy + ((goalY - sy) * k - s.svy * damp) * dt
  IF diving THEN
    ' The dive is flown, not sprung: a quick rise, then an accelerating arc
    ' down into the middle of the pool.
    LET u AS Float = clamp01(diveT / 0.7)
    LET lift AS Float = math::sin(u * math::pi) * h * 0.08
    LET e AS Float = u * u * u
    LET nx AS Float = lerp(diveX, f.cx + f.rx * 0.15, e)
    LET ny AS Float = lerp(diveY, f.poolY + 2.0, e) - lift * (1.0 - e)
    svx = (nx - sx) / math::max(dt, 0.001)
    svy = (ny - sy) / math::max(dt, 0.001)
    sx = nx
    sy = ny
  ELSE
    sx = sx + svx * dt
    sy = sy + svy * dt
  END IF
  MUT trail AS List OF vector::Float2 = collections::prepend(s.trail, pt(sx, sy))
  IF len(trail) > 26 THEN trail = collections::take(trail, 26)

  MUT drops AS List OF Drop = []
  MUT ripples AS List OF Ripple = []
  MUT sparks AS List OF Spark = []
  MUT surge AS Float = math::max(0.0, s.surge - dt * 0.35)
  ' The splash's clock runs from the moment the dive lands.
  MUT splashT AS Float = s.splashT
  MUT splashX AS Float = s.splashX
  MUT splashY AS Float = s.splashY
  IF splashT >= 0.0 THEN splashT = splashT + inp.pdt

  ' The dive lands: a ring of spray, a big ripple, and a burst of sparks.
  IF diving AND diveT >= 0.7 THEN
    diving = FALSE
    surge = 1.0
    splashT = 0.0
    splashX = sx
    splashY = f.poolY - 4.0
    ripples = collections::append(ripples, Ripple[x := sx, y := f.poolY, age := 0.0, strength := 1.0])
    ripples = collections::append(ripples, Ripple[x := sx, y := f.poolY, age := -0.25, strength := 0.7])
    FOR i = 0 TO 39
      LET a AS Float = -math::pi * hashRange(i + math::floor(t * 100.0), 0.1, 0.9)
      LET sp AS Float = randF(150.0, 420.0)
      drops = collections::append(drops, Drop[x := sx, y := f.poolY, vx := math::cos(a) * sp * 0.7, vy := math::sin(a) * sp, big := TRUE])
    NEXT
    sy = f.poolY - h * 0.02
    svx = 0.0
    svy = -900.0
  END IF

  ' The stream: drops spill from the upper bowl's rim on both sides.
  MUT emit AS Float = s.emit + dt * 110.0
  DO WHILE emit >= 1.0
    LET side AS Float = toFloat(math::rand(0, 1) * 2 - 1)
    LET along AS Float = randF(0.55, 1.0)
    drops = collections::append(drops, Drop[x := f.cx + side * f.bowlR * along, y := f.bowlY + randF(-2.0, 2.0), vx := side * randF(20.0, 60.0) * along, vy := randF(-20.0, 10.0), big := FALSE])
    emit = emit - 1.0
  LOOP

  ' Move every drop; one that reaches the water leaves a ripple.
  FOR EACH d IN s.drops
    LET nvy AS Float = d.vy + 980.0 * dt
    LET nx AS Float = d.x + d.vx * dt
    LET ny AS Float = d.y + nvy * dt
    IF ny >= f.poolY AND insidePool(f, nx, f.poolY) AND nvy > 0.0 THEN
      IF d.big OR math::rand(0, 5) = 0 THEN ripples = collections::append(ripples, Ripple[x := nx, y := f.poolY + (ny - f.poolY) * 0.2, age := 0.0, strength := randF(0.12, 0.3)])
    ELSEIF ny < h + 20.0 THEN
      drops = collections::append(drops, Drop[x := nx, y := ny, vx := d.vx, vy := nvy, big := d.big])
    END IF
  NEXT
  FOR EACH r IN s.ripples
    IF r.age + dt < 2.4 THEN ripples = collections::append(ripples, WITH r { age := r.age + dt })
  NEXT
  FOR EACH sp IN s.sparks
    IF sp.age + dt < sp.life THEN sparks = collections::append(sparks, WITH sp { x := sp.x + sp.vx * dt, y := sp.y + sp.vy * dt, vx := sp.vx * 0.97, vy := sp.vy + 60.0 * dt, age := sp.age + dt })
  NEXT
  ' The guardian sheds a spark now and then as it moves.
  IF math::rand(0, 3) = 0 THEN sparks = collections::append(sparks, Spark[x := sx + randF(-6.0, 6.0), y := sy + randF(-6.0, 6.0), vx := randF(-20.0, 20.0), vy := randF(-30.0, 10.0), age := 0.0, life := randF(0.5, 1.2)])

  ' The drinking birds take fright when the guardian is near.
  MUT birds AS List OF Drinker = []
  FOR EACH b IN s.birds
    LET bx AS Float = f.cx + b.homeX * f.rx
    LET by AS Float = f.poolY - f.ry * 0.9
    MUT fleeing AS Boolean = b.fleeing
    MUT calm AS Float = math::max(0.0, b.calm - dt)
    IF dist(bx, by, sx, sy) < h * 0.18 THEN
      fleeing = TRUE
      calm = 3.5
    ELSEIF calm <= 0.0 THEN
      fleeing = FALSE
    END IF
    MUT away AS Float = b.away
    IF fleeing THEN
      away = math::min(1.0, away + dt / 1.4)
    ELSE
      away = math::max(0.0, away - dt / 2.2)
    END IF
    birds = collections::append(birds, Drinker[homeX := b.homeX, away := away, fleeing := fleeing, calm := calm])
  NEXT

  RETURN SpringState[t := t, fx := s.fx + inp.pdt, w := w, h := h, px := px, py := py, sx := sx, sy := sy, svx := svx, svy := svy, trail := trail, diving := diving, diveT := diveT, diveX := diveX, diveY := diveY, splashT := splashT, splashX := splashX, splashY := splashY, surge := surge, emit := emit, drops := drops, ripples := ripples, sparks := sparks, birds := birds]
END FUNC

' ---------------------------------------------------------------------------
' Drawing
' ---------------------------------------------------------------------------

' The pool's outline as a clip for an item positioned at (x, y): the clip is
' in the item's own coordinates, so the outline - made once a frame about the
' pool's middle - is seen from the item.
FUNC poolClip(ring AS List OF vector::Float2, f AS Fountain, x AS Float, y AS Float) AS List OF List OF vector::Float2
  RETURN [ringFrom(ring, x - f.cx, y - f.poolY)]
END FUNC

' Whether an ellipse of radii rx, ry about (x, y) lies wholly on the water, and
' so needs no clip: the corners of its box are tested against the pool.
FUNC onTheWater(f AS Fountain, x AS Float, y AS Float, rx AS Float, ry AS Float) AS Boolean
  LET dx AS Float = (math::abs(x - f.cx) + rx) / (f.rx * 0.97)
  LET dy AS Float = (math::abs(y - f.poolY) + ry) / (f.ry * 0.95)
  RETURN dx * dx + dy * dy <= 1.0
END FUNC

' The runes carved round the basin wall, glowing after a dive.
FUNC basinRunes(f AS Fountain, surge AS Float) AS List OF canvas::DrawItem
  LET rimH AS Float = f.ry * 0.9
  LET runeGlow AS color::Color = mixC(hex("#3a4a48"), hex("#8ff8ff"), clamp01(0.25 + surge))
  MUT out AS List OF canvas::DrawItem = []
  FOR i = 0 TO 6
    LET a AS Float = math::pi * (0.18 + 0.64 * toFloat(i) / 6.0)
    LET rx AS Float = f.cx + math::cos(a) * f.rx * 1.04
    LET ry AS Float = f.poolY + math::sin(a) * f.ry * 1.04 + rimH * 1.25
    LET s AS Float = rimH * 0.5
    out = collections::append(out, pathAt(rx, ry, [pt(-s * 0.4, -s), pt(0.0, s), pt(s * 0.4, -s)], WITH strokeP(runeGlow, 1.6) { join := canvas::JoinStyle.Miter }))
    out = collections::append(out, line(rx - s * 0.5, ry - s * 0.1, rx + s * 0.5, ry - s * 0.1, strokeP(runeGlow, 1.4)))
    IF surge > 0.02 THEN out = collections::append(out, glow(rx, ry, s * 4.0, alpha(hex("#7ff4ff"), surge * 0.6)))
  NEXT
  RETURN out
END FUNC

' The water: a deep ellipse with a lighter rim, the moon and the guardian
' reflected in it, and the ripples - all clipped to the pool.
FUNC poolWater(s AS SpringState, f AS Fountain) AS List OF canvas::DrawItem
  LET ring AS List OF vector::Float2 = ovalRing(0.0, 0.0, f.rx * 0.97, f.ry * 0.95)
  MUT out AS List OF canvas::DrawItem = [ellipse(f.cx, f.poolY, f.rx * 0.97, f.ry * 0.95, 0.0, gradP(ovalRamp(f.rx, f.ry, [gstop(0.0, hex("#0f3f4a")), gstop(0.7, hex("#1b6470")), gstop(1.0, hex("#47a4a8"))])))]
  LET mx AS Float = f.cx + f.rx * 0.45
  LET my AS Float = f.poolY + f.ry * 0.25
  out = collections::append(out, ellipse(mx, my, f.rx * 0.08, f.ry * 0.5, 0.0, WITH glowP(color::white) { clip := poolClip(ring, f, mx, my), gradient := ovalRamp(f.rx * 0.08, f.ry * 0.5, [gstop(0.0, rgba(220, 240, 255, 70)), gstop(1.0, rgba(220, 240, 255, 0))]) }))
  LET gy AS Float = f.poolY + (f.poolY - s.sy) * 0.08
  out = collections::append(out, ellipse(s.sx, gy, f.rx * 0.12, f.ry * 0.3, 0.0, WITH glowP(color::white) { clip := poolClip(ring, f, s.sx, gy), gradient := ovalRamp(f.rx * 0.12, f.ry * 0.3, [gstop(0.0, rgba(180, 255, 240, 120)), gstop(1.0, rgba(180, 255, 240, 0))]) }))
  ' The ripples. Most are wholly on the water; only one that reaches the rim is
  ' clipped to it.
  FOR EACH r IN s.ripples
    IF r.age > 0.0 THEN
      LET rr AS Float = f.rx * (0.05 + 0.55 * r.strength) * easeOutCubic(r.age / 2.4) + 2.0
      LET a AS Float = r.strength * (1.0 - r.age / 2.4)
      MUT ring_ AS canvas::Paint = WITH canvas::stroke(rgba(200, 255, 255, math::round(230.0 * clamp01(a))), 1.0 + 2.0 * r.strength) { blend := canvas::BlendMode.Add }
      IF NOT onTheWater(f, r.x, r.y, rr + 3.0, rr * f.ry / f.rx + 3.0) THEN ring_ = WITH ring_ { clip := poolClip(ring, f, r.x, r.y) }
      out = collections::append(out, ellipse(r.x, r.y, rr, rr * f.ry / f.rx, 0.0, ring_))
      IF r.strength > 0.5 THEN out = collections::append(out, ellipse(r.x, r.y, rr * 0.7, rr * 0.7 * f.ry / f.rx, 0.0, WITH ring_ { stroke := rgba(200, 255, 255, math::round(160.0 * clamp01(a))), strokeWidth := 1.5 }))
    END IF
  NEXT
  RETURN out
END FUNC

' The splash's sparks: one burst, thrown up from where the dive landed, its
' clock the time since then. Before the first dive there is no splash at all,
' and once every spark has died it is left out again.
FUNC splash(s AS SpringState) AS List OF canvas::DrawItem
  IF s.splashT < 0.0 OR s.splashT > SPLASH_LIFE * 1.4 THEN RETURN []
  LET spark AS canvas::AutoShape = canvas::Circle[id := "", position := pt(0.0, 0.0), radius := 2.8, paint := glowP(rgba(200, 255, 240, 255)), transform := none()]
  LET point AS canvas::Shape = canvas::Circle[id := "", position := pt(0.0, 0.0), radius := 0.0, paint := canvas::fill(color::white), transform := none()]
  LET emission AS canvas::Emission = canvas::Emission[mode := canvas::EmissionMode.Burst, maxParticles := SPLASH_SPARKS, rate := 0.0, burst := SPLASH_SPARKS, burstPeriod := 0.0, lifetime := SPLASH_LIFE, lifetimeVar := 0.38]
  ' Thrown up and out over most of a half-turn, slowed by the air and pulled
  ' gently back down.
  LET motion AS canvas::Motion = canvas::Motion[speed := 160.0, speedVar := 0.6, angle := -math::pi / 2.0, spread := 1.9, gravityX := 0.0, gravityY := 60.0, drag := 1.2, rotation := 0.0, rotationVar := 0.0, spin := 0.0, spinVar := 0.0, turbulence := 0.0, turbulenceHz := 0.0]
  LET look AS canvas::Appearance = canvas::Appearance[startColor := color::white, endColor := rgba(255, 255, 255, 0), startScale := 1.0, endScale := 0.43, scaleVar := 0.0]
  RETURN [canvas::ParticleSystem[position := pt(s.splashX, s.splashY), item := spark, emitter := point, emission := emission, motion := motion, appearance := look, seed := 2001, time := s.splashT]]
END FUNC

' The willow's fronds hang from its crown: each a PolyLine stroked with a dash
' pattern and round caps, so it reads as a string of leaves rather than a line,
' its colours fading towards the tip. Its points sway every frame.
FUNC fronds(wx AS Float, wy AS Float, h AS Float, t AS Float) AS List OF canvas::DrawItem
  MUT out AS List OF canvas::DrawItem = []
  FOR i = 0 TO 47
    LET u AS Float = toFloat(i) / 47.0
    LET ox AS Float = h * (-0.22 + 0.48 * u) + hashRange(i + 520, -0.01, 0.01) * h
    LET oy AS Float = -h * 0.5 + math::pow(math::abs(u - 0.45) * 2.0, 2.0) * h * 0.12
    LET len_ AS Float = h * hashRange(i + 500, 0.2, 0.42)
    LET tint AS Float = hash01(i + 530)
    MUT pts AS List OF vector::Float2 = []
    MUT cols AS List OF color::Color = []
    FOR j = 0 TO 10
      LET v AS Float = toFloat(j) / 10.0
      LET sway AS Float = math::sin(t * 0.9 + toFloat(i) * 0.37 + v * 2.0) * h * 0.022 * v * v
      pts = collections::append(pts, pt(sway + (u - 0.45) * v * h * 0.08, v * len_))
      cols = collections::append(cols, mixC(mixC(rgba(46, 102, 62, 255), rgba(96, 170, 100, 255), tint), rgba(160, 230, 150, 0), v * v * v))
    NEXT
    out = collections::append(out, canvas::PolyLine[id := "", position := pt(wx + ox, wy + oy), points := pts, colors := cols, paint := WITH strokeP(color::white, h * 0.0075) { dashes := [h * 0.009, h * 0.0045], dashOffset := toFloat(i) * 3.0 }, transform := none()])
  NEXT
  RETURN out
END FUNC

FUNC drinkers(s AS SpringState, f AS Fountain, w AS Float, h AS Float) AS List OF canvas::DrawItem
  MUT out AS List OF canvas::DrawItem = []
  FOR i = 0 TO len(s.birds) - 1
    LET b AS Drinker = collections::get(s.birds, i)
    LET bx AS Float = f.cx + b.homeX * f.rx
    LET by AS Float = f.poolY - f.ry * 0.9
    LET dir AS Float = toFloat(i MOD 2) * 2.0 - 1.0
    IF b.away <= 0.001 THEN
      LET peck AS Float = math::max(0.0, math::sin(s.t * 2.0 + toFloat(i) * 2.1))
      out = collections::append(out, songbird("spring" & toString(i), bx, by, h * 0.045, dir, 0.6 * math::pow(peck, 6.0)))
    ELSEIF b.away < 0.999 THEN
      LET e AS Float = easeInOut(b.away)
      MUT heading AS Float = math::atan2(-h * 0.6, dir * w * 0.45)
      IF NOT b.fleeing THEN heading = math::atan2(h * 0.6, -dir * w * 0.45)
      out = collections::append(out, bird(bx + dir * w * 0.45 * e, by - h * 0.6 * e + math::sin(e * math::pi) * h * 0.05, heading, h * 0.05, math::sin(s.t * 40.0 + toFloat(i)), 0.8, drinkerColor(i), hex("#2a3040")))
    END IF
  NEXT
  RETURN out
END FUNC

' The guardian: a bright core in layered glows with little wings of light, a
' trail whose colours fade out along it, and the sparks it has shed.
FUNC guardian(s AS SpringState, h AS Float) AS List OF canvas::DrawItem
  MUT out AS List OF canvas::DrawItem = []
  IF len(s.trail) > 1 THEN
    MUT cols AS List OF color::Color = []
    FOR i = 0 TO len(s.trail) - 1
      cols = collections::append(cols, mixC(rgba(200, 255, 240, 200), rgba(90, 160, 255, 0), toFloat(i) / toFloat(len(s.trail) - 1)))
    NEXT
    out = collections::append(out, trail(s.trail, cols, WITH strokeP(color::white, h * 0.012) { blend := canvas::BlendMode.Add }))
  END IF
  out = collections::append(out, glow(s.sx, s.sy, h * 0.14 * (0.85 + 0.15 * math::sin(s.t * 6.0)), rgba(120, 255, 230, 70)))
  out = collections::append(out, glow(s.sx, s.sy, h * 0.05, rgba(200, 255, 245, 200)))
  out = collections::append(out, circle(s.sx, s.sy, h * 0.009, fillP(color::white)))
  FOR side = -1 TO 1 STEP 2
    out = collections::append(out, ellipse(s.sx + toFloat(side) * h * 0.018, s.sy - h * 0.008, h * 0.018, h * 0.007, toFloat(side) * (0.5 + math::sin(s.t * 22.0) * 0.5), glowP(rgba(190, 255, 250, 140))))
  NEXT
  FOR EACH sp IN s.sparks
    LET a AS Float = 1.0 - sp.age / sp.life
    out = collections::append(out, circle(sp.x, sp.y, 1.2 + 1.6 * a, glowP(rgba(200, 255, 240, math::round(255.0 * a)))))
  NEXT
  RETURN out
END FUNC

FUNC springDraw(s AS SpringState, w AS Float, h AS Float) AS List OF canvas::DrawItem
  LET t AS Float = s.t
  LET f AS Fountain = fountainAt(w, h, -s.px * SPRING_POOL, -s.py * SPRING_POOL * 0.4)
  ' Sky and the far layers, each a Group slid by the parallax.
  MUT out AS List OF canvas::DrawItem = [rect(0.0, 0.0, w, h, gradP(downward(h * 0.7, [gstop(0.0, hex("#060d1e")), gstop(0.6, hex("#16384c")), gstop(1.0, hex("#2f6a72"))])))]
  out = collections::append(out, starField(w, h * 0.45, 90, t, 0.8, 23))
  out = collections::append(out, glow(w * 0.78 - s.px * 4.0, h * 0.16, h * 0.25, rgba(170, 230, 255, 40)))
  out = collections::append(out, circle(w * 0.78 - s.px * 4.0, h * 0.16, h * 0.035, fillP(hex("#eef6ff"))))
  out = collections::append(out, node("spring-far", -s.px * SPRING_FAR - 20.0, -s.py * SPRING_FAR * 0.4))
  out = collections::append(out, node("spring-mid", -s.px * SPRING_MID - 30.0, -s.py * SPRING_MID * 0.4))

  ' The willow behind the fountain.
  LET wx AS Float = w * 0.22 - s.px * SPRING_MID
  LET wy AS Float = h * 0.74 - s.py * SPRING_MID * 0.4
  out = collections::append(out, node("spring-willow", wx, wy))
  out = collections::append(out, fronds(wx, wy, h, t))

  ' The pool's glow lights the stone around it.
  out = collections::append(out, glow(f.cx, f.poolY, f.rx * 1.6, rgba(80, 220, 230, 40 + toInt(70.0 * s.surge))))
  out = collections::append(out, node("spring-wall", f.cx, f.poolY))
  out = collections::append(out, basinRunes(f, s.surge))
  out = collections::append(out, node("spring-rim", f.cx, f.poolY))
  out = collections::append(out, poolWater(s, f))
  out = collections::append(out, node("spring-pillar", f.cx, f.bowlY))
  ' Falling water: each drop a short streak along its velocity.
  FOR EACH d IN s.drops
    LET sp AS Float = math::sqrt(d.vx * d.vx + d.vy * d.vy) + 0.001
    LET l AS Float = math::min(10.0, sp * 0.018)
    out = collections::append(out, line(d.x, d.y, d.x - d.vx / sp * l, d.y - d.vy / sp * l, WITH strokeP(rgba(170, 240, 255, 170), 1.6) { blend := canvas::BlendMode.Add }))
  NEXT
  out = collections::append(out, drinkers(s, f, w, h))
  out = collections::append(out, guardian(s, h))
  out = collections::append(out, splash(s))

  ' Fireflies, and the near ferns in front of everything.
  out = collections::append(out, motes(0.0, h * 0.35, w, h * 0.6, 28, s.fx, hex("#b6ff8a"), 1.8, 61))
  out = collections::append(out, node("spring-near", -s.px * SPRING_NEAR, -s.py * SPRING_NEAR * 0.4))
  RETURN collections::append(out, vignette(w, h, 170))
END FUNC
