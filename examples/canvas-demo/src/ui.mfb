' ui - the fonts, the input snapshot, text layout, and the pieces of interface
' every screen shares: buttons, the intro panel shown before each scene, the
' hint line along the bottom, and the fade between screens.
'
' Nothing here tests the mouse against a rectangle. Whatever can be clicked
' carries an id, and canvas::MouseEvent.overID - worked out by the canvas from
' the very outlines it draws - says which one the mouse is over. A button's
' hover and press are a canvas::AutoPaint, which the window repaints by itself
' as the mouse comes and goes.

IMPORT canvas
IMPORT collections
IMPORT color
IMPORT io
IMPORT math
IMPORT strings

' The faces the demo is set in. Each is a RES handle, so a Fonts value is a
' second name for the same open fonts, not a copy of them.
TYPE Fonts
  display AS RES canvas::Font    ' Cinzel Decorative Bold: the title
  heading AS RES canvas::Font    ' Cinzel: scene names and headings
  body AS RES canvas::Font       ' Lato
  bold AS RES canvas::Font       ' Lato Bold
  italic AS RES canvas::Font     ' Lato Italic
END TYPE

' Everything the user did since the last frame, gathered once and handed to
' whichever screen is showing.
TYPE Input
  w AS Float                ' the window size
  h AS Float
  mx AS Float               ' where the mouse is
  my AS Float
  over AS String            ' the id path of what the mouse is over (MouseEvent.overID)
  clicked AS String         ' the id path the left button went down on this frame, or ""
  down AS Boolean           ' the left button is held
  pressed AS Boolean        ' the left button went down this frame
  released AS Boolean       ' the left button came up this frame
  rightDown AS Boolean
  rightPressed AS Boolean
  wheel AS Integer          ' wheel clicks this frame, positive away from the user
  pdt AS Float              ' the step for a particle system's clock: seconds since the last frame, at most a tenth
  keys AS List OF String    ' keys pressed (or repeating) this frame
  held AS List OF String    ' keys held down now
END TYPE

' The same input with every action removed: what a scene sees while the intro
' panel is in front of it, so it keeps animating without reacting.
FUNC idleInput(inp AS Input) AS Input
  RETURN WITH inp { over := "", clicked := "", down := FALSE, pressed := FALSE, released := FALSE, rightDown := FALSE, rightPressed := FALSE, wheel := 0, keys := [], held := [] }
END FUNC

FUNC keyPressed(inp AS Input, name AS String) AS Boolean
  RETURN collections::contains(inp.keys, name)
END FUNC

FUNC keyHeld(inp AS Input, name AS String) AS Boolean
  RETURN collections::contains(inp.held, name)
END FUNC

' The name a key is known by in Input.keys and Input.held: "left", "right",
' "up", "down", "space", "enter", "esc", "tab", "backspace", or the lower-case
' character a key types. "" for a key this demo has no use for.
FUNC keyName(k AS io::Key) AS String
  MATCH k.key
    CASE io::KeyName.Up : RETURN "up"
    CASE io::KeyName.Down : RETURN "down"
    CASE io::KeyName.Left : RETURN "left"
    CASE io::KeyName.Right : RETURN "right"
    CASE io::KeyName.Enter : RETURN "enter"
    CASE io::KeyName.Escape : RETURN "esc"
    CASE io::KeyName.Tab : RETURN "tab"
    CASE io::KeyName.Backspace : RETURN "backspace"
    CASE io::KeyName.Delete : RETURN "backspace"
    CASE io::KeyName.Unicode
      IF k.grapheme = " " THEN RETURN "space"
      RETURN strings::lower(k.grapheme)
    CASE ELSE : RETURN ""
  END MATCH
END FUNC

' The number at the end of an id such as "card-7" when the id starts with
' `prefix`, or -1. An id path names the groups around an item first, so only
' the part after the last "::" is looked at.
FUNC idNumber(path AS String, prefix AS String) AS Integer
  LET parts AS List OF String = strings::split(path, "::")
  IF len(parts) = 0 THEN RETURN -1
  LET last AS String = collections::get(parts, len(parts) - 1)
  IF NOT strings::startsWith(last, prefix) THEN RETURN -1
  LET n AS Integer = toInt(strings::stripPrefix(last, prefix)) TRAP(e)
    RECOVER -1
  END TRAP
  RETURN n
END FUNC

' ---------------------------------------------------------------------------
' Palette
' ---------------------------------------------------------------------------

FUNC gold AS color::Color
  RETURN hex("#e8c77a")
END FUNC

FUNC parchment AS color::Color
  RETURN hex("#f3ead6")
END FUNC

FUNC muted AS color::Color
  RETURN hex("#a9b4c2")
END FUNC

FUNC panelTop AS color::Color
  RETURN hex("#17263a")
END FUNC

FUNC panelBottom AS color::Color
  RETURN hex("#0b121c")
END FUNC

' ---------------------------------------------------------------------------
' Text layout
' ---------------------------------------------------------------------------

' Break `text` into lines no wider than `maxW` at `size`, at spaces.
FUNC wrap(font AS canvas::Font, size AS Float, text AS String, maxW AS Float) AS List OF String
  MUT lines AS List OF String = []
  MUT current AS String = ""
  FOR EACH word IN strings::split(text, " ")
    MUT candidate AS String = word
    IF current <> "" THEN candidate = current & " " & word
    IF current <> "" AND canvas::measureText(font, size, candidate).width > maxW THEN
      lines = collections::append(lines, current)
      current = word
    ELSE
      current = candidate
    END IF
  NEXT
  IF current <> "" THEN lines = collections::append(lines, current)
  RETURN lines
END FUNC

FUNC textWidth(font AS canvas::Font, size AS Float, text AS String) AS Float
  RETURN canvas::measureText(font, size, text).width
END FUNC

FUNC centered(font AS canvas::Font, size AS Float, text AS String, cx AS Float, baseline AS Float, p AS canvas::Paint) AS canvas::DrawItem
  RETURN labelP(font, size, text, cx - textWidth(font, size, text) / 2.0, baseline, p)
END FUNC

' Text with its letters spread apart - the small capitals over each block of
' the intro panel and on the buttons. Each letter is its own item, placed by
' the measured advance of everything before it. Measuring is the costly part,
' so a Tracked is laid out once and drawn from as often as needed.
TYPE Tracked
  glyphs AS List OF String
  xs AS List OF Float
  width AS Float
END TYPE

FUNC noTracked AS Tracked
  RETURN Tracked[glyphs := [], xs := [], width := 0.0]
END FUNC

FUNC layoutTracked(font AS canvas::Font, size AS Float, text AS String, track AS Float) AS Tracked
  MUT glyphs AS List OF String = []
  MUT xs AS List OF Float = []
  MUT so AS String = ""
  MUT i AS Integer = 0
  FOR EACH g IN strings::graphemes(text)
    glyphs = collections::append(glyphs, g)
    xs = collections::append(xs, textWidth(font, size, so) + toFloat(i) * track)
    so = so & g
    i = i + 1
  NEXT
  RETURN Tracked[glyphs := glyphs, xs := xs, width := textWidth(font, size, text) + toFloat(math::max(i - 1, 0)) * track]
END FUNC

FUNC drawTracked(font AS canvas::Font, size AS Float, tt AS Tracked, x AS Float, baseline AS Float, p AS canvas::Paint) AS List OF canvas::DrawItem
  MUT out AS List OF canvas::DrawItem = []
  FOR i = 0 TO len(tt.glyphs) - 1
    LET g AS String = collections::get(tt.glyphs, i)
    IF g <> " " THEN out = collections::append(out, labelP(font, size, g, x + collections::get(tt.xs, i), baseline, p))
  NEXT
  RETURN out
END FUNC

FUNC drawTrackedCentered(font AS canvas::Font, size AS Float, tt AS Tracked, cx AS Float, baseline AS Float, p AS canvas::Paint) AS List OF canvas::DrawItem
  RETURN drawTracked(font, size, tt, cx - tt.width / 2.0, baseline, p)
END FUNC

' A soft halo behind a line of text: the text again, nudged a pixel or two in
' eight directions and added on at low strength.
FUNC glowText(font AS canvas::Font, size AS Float, text AS String, x AS Float, baseline AS Float, c AS color::Color, radius AS Float, opacity AS Float) AS List OF canvas::DrawItem
  MUT out AS List OF canvas::DrawItem = []
  FOR i = 0 TO 7
    LET a AS Float = toFloat(i) * TAU / 8.0
    out = collections::append(out, labelP(font, size, text, x + math::cos(a) * radius, baseline + math::sin(a) * radius, glowP(fade(c, 0.16 * opacity))))
  NEXT
  RETURN out
END FUNC

' ---------------------------------------------------------------------------
' Buttons
' ---------------------------------------------------------------------------

' What makes a button react: a rounded rectangle laid over the button's face
' and its label, invisible until the mouse is on it. It is an AutoPaint, so the
' window swaps its paint for `hover` while the mouse rests on it and for
' `press` while the button is held on it, with none of this program's code
' running. It is drawn last because only the topmost item under the mouse
' reacts - a label on top of it would take the mouse away from it - and its
' id is what canvas::MouseEvent.overID reports for a click on the button.
FUNC hotspot(id AS String, x AS Float, y AS Float, w AS Float, h AS Float, r AS Float, hover AS canvas::Paint, press AS canvas::Paint) AS canvas::DrawItem
  LET rest AS canvas::Paint = canvas::fill(clear())
  RETURN canvas::AutoPaint[shape := canvas::Rectangle[id := id, position := pt(x, y), bind := canvas::BindTo.TopLeft, size := canvas::Size[width := w, height := h], radiusTL := r, radiusTR := r, radiusBL := r, radiusBR := r, paint := rest, transform := none()], useEnter := FALSE, useExit := FALSE, useHover := TRUE, usePressed := TRUE, enterPaint := rest, exitPaint := rest, hoverPaint := hover, pressedPaint := press]
END FUNC

' The paints a gold-rimmed control lights up with: a warm wash screened over
' the face and its label, and a brighter rim; pressed, the face darkens.
FUNC hoverWash(rim AS Float) AS canvas::Paint
  RETURN WITH canvas::fill(rgba(255, 236, 190, 16)) { blend := canvas::BlendMode.Screen, stroke := alpha(gold(), 0.95), strokeWidth := rim }
END FUNC

FUNC pressWash(rim AS Float) AS canvas::Paint
  RETURN WITH canvas::fill(rgba(150, 120, 80, 255)) { blend := canvas::BlendMode.Multiply, stroke := gold(), strokeWidth := rim }
END FUNC

' The label for a button of height h, laid out.
FUNC buttonLabel(f AS Fonts, text AS String, h AS Float) AS Tracked
  RETURN layoutTracked(f.bold, h * 0.42, strings::upper(text), h * 0.42 * 0.18)
END FUNC

' A pill button: a face, its label, and the hotspot that lights them up.
' `primary` is the solid gold one; the others are outlined.
FUNC button(f AS Fonts, id AS String, text AS Tracked, x AS Float, y AS Float, w AS Float, h AS Float, primary AS Boolean, opacity AS Float) AS List OF canvas::DrawItem
  LET size AS Float = h * 0.42
  MUT fillTop AS color::Color = rgba(232, 199, 122, 30)
  MUT fillBottom AS color::Color = rgba(232, 199, 122, 10)
  MUT ink AS color::Color = gold()
  IF primary THEN
    fillTop = hex("#f2d792")
    fillBottom = hex("#c99a4a")
    ink = hex("#1c1408")
  END IF
  MUT out AS List OF canvas::DrawItem = [rrect(x, y, w, h, h / 2.0, faded(WITH gradP(downward(h, [gstop(0.0, fillTop), gstop(1.0, fillBottom)])) { stroke := alpha(gold(), 0.55), strokeWidth := 1.2 }, opacity))]
  out = collections::append(out, drawTrackedCentered(f.bold, size, text, x + w / 2.0, y + h / 2.0 + size * 0.36, faded(fillP(ink), opacity)))
  RETURN collections::append(out, hotspot(id, x, y, w, h, h / 2.0, hoverWash(1.6), pressWash(1.6)))
END FUNC

' ---------------------------------------------------------------------------
' Ornament
' ---------------------------------------------------------------------------

' A thin rule with a diamond in the middle, fading out at both ends.
FUNC divider(cx AS Float, y AS Float, halfW AS Float, a AS Float) AS List OF canvas::DrawItem
  LET c AS color::Color = gold()
  LET d AS Float = 4.5
  LET arm AS Float = halfW - d * 2.0
  MUT out AS List OF canvas::DrawItem = [rect(cx - halfW, y - 0.6, arm, 1.2, gradP(linear(0.0, 0.0, arm, 0.0, [gstop(0.0, fade(c, 0.0)), gstop(1.0, fade(c, 0.7 * a))])))]
  out = collections::append(out, rect(cx + d * 2.0, y - 0.6, arm, 1.2, gradP(linear(0.0, 0.0, arm, 0.0, [gstop(0.0, fade(c, 0.7 * a)), gstop(1.0, fade(c, 0.0))]))))
  RETURN collections::append(out, diamond(cx, y, d, fade(c, a)))
END FUNC

FUNC diamond(x AS Float, y AS Float, r AS Float, c AS color::Color) AS canvas::DrawItem
  RETURN polyAt(x, y, [pt(0.0, -r), pt(r, 0.0), pt(0.0, r), pt(-r, 0.0)], fillP(c))
END FUNC

' ---------------------------------------------------------------------------
' The intro panel
' ---------------------------------------------------------------------------

' Where the panel and its Begin button are, for a window of this size and
' this scene.
TYPE PanelLayout
  x AS Float
  y AS Float
  w AS Float
  h AS Float
  bx AS Float
  by AS Float
  bw AS Float
  bh AS Float
END TYPE

' The text of the panel, laid out: kept between frames, since measuring every
' word sixty times a second would be wasted work. `k` is the size it was laid
' out at: 1, or smaller when the window is too short for the panel. The panel
' is set in smaller type rather than drawn smaller, because glyphs drawn under
' a shrinking transform lose their thin strokes.
TYPE PanelText
  forW AS Float
  forH AS Float
  k AS Float
  flavor AS List OF String
  primary AS List OF List OF String
  secondary AS List OF List OF String
  controls AS List OF String
  onCanvas AS Tracked
  inLanguage AS Tracked
  controlsLabel AS Tracked
  begin AS Tracked
END TYPE

LET PANEL_PAD AS Float = 34.0
LET PANEL_TITLE AS Float = 30.0
LET PANEL_FLAVOR AS Float = 16.0
LET PANEL_LABEL AS Float = 11.5
LET PANEL_PRIMARY AS Float = 15.0
LET PANEL_SECONDARY AS Float = 13.5

FUNC panelWidth(w AS Float) AS Float
  RETURN math::min(680.0, w - 60.0)
END FUNC

FUNC panelTextAt(f AS Fonts, info AS DemoInfo, w AS Float, h AS Float, k AS Float) AS PanelText
  LET inner AS Float = panelWidth(w) - PANEL_PAD * k * 2.0
  MUT primary AS List OF List OF String = []
  FOR EACH line IN info.canvasFeatures
    primary = collections::append(primary, [wrap(f.body, PANEL_PRIMARY * k, line, inner - 22.0 * k)])
  NEXT
  MUT secondary AS List OF List OF String = []
  FOR EACH line IN info.languageFeatures
    secondary = collections::append(secondary, [wrap(f.body, PANEL_SECONDARY * k, line, inner - 22.0 * k)])
  NEXT
  RETURN PanelText[forW := w, forH := h, k := k, flavor := wrap(f.italic, PANEL_FLAVOR * k, info.flavor, inner), primary := primary, secondary := secondary, controls := wrap(f.body, PANEL_SECONDARY * k, info.controls, inner - 120.0 * k), onCanvas := layoutTracked(f.bold, PANEL_LABEL * k, "ON THE CANVAS", 2.2 * k), inLanguage := layoutTracked(f.bold, PANEL_LABEL * k, "IN THE LANGUAGE", 2.2 * k), controlsLabel := layoutTracked(f.bold, PANEL_LABEL * k, "CONTROLS", 2.2 * k), begin := buttonLabel(f, "Begin", 44.0 * k)]
END FUNC

' The panel's text for this window: at full size if it fits, else set small
' enough to fit (but never below 70%).
FUNC panelText(f AS Fonts, info AS DemoInfo, w AS Float, h AS Float) AS PanelText
  LET full AS PanelText = panelTextAt(f, info, w, h, 1.0)
  LET need AS Float = panelHeight(full)
  IF need <= h - 30.0 THEN RETURN full
  LET k AS Float = math::max(0.7, (h - 30.0) / need)
  LET smaller AS PanelText = panelTextAt(f, info, w, h, k)
  ' Smaller type wraps into fewer lines, so one more pass can grow it back.
  LET k2 AS Float = math::max(0.7, math::min(1.0, k * (h - 30.0) / panelHeight(smaller)))
  IF k2 > k * 1.02 THEN RETURN panelTextAt(f, info, w, h, k2)
  RETURN smaller
END FUNC

FUNC linesHeight(blocks AS List OF List OF String, lineH AS Float, gap AS Float) AS Float
  MUT total AS Float = 0.0
  FOR EACH b IN blocks
    total = total + toFloat(len(b)) * lineH + gap
  NEXT
  RETURN total
END FUNC

FUNC panelHeight(text AS PanelText) AS Float
  LET k AS Float = text.k
  MUT ph AS Float = (PANEL_PAD + 52.0 + PANEL_TITLE + 14.0 + toFloat(len(text.flavor)) * 22.0 + 26.0) * k
  ph = ph + (22.0 + linesHeight(text.primary, 21.0, 6.0) + 18.0) * k
  ph = ph + (22.0 + linesHeight(text.secondary, 19.0, 4.0) + 18.0) * k
  RETURN ph + (math::max(toFloat(len(text.controls)) * 19.0, 19.0) + 26.0 + 46.0 + PANEL_PAD) * k
END FUNC

FUNC panelLayout(text AS PanelText, w AS Float, h AS Float) AS PanelLayout
  LET k AS Float = text.k
  LET pw AS Float = panelWidth(w)
  LET ph AS Float = panelHeight(text)
  LET px AS Float = (w - pw) / 2.0
  LET py AS Float = math::max(10.0, (h - ph) / 2.0)
  LET bw AS Float = 168.0 * k
  LET bh AS Float = 44.0 * k
  RETURN PanelLayout[x := px, y := py, w := pw, h := ph, bx := px + (pw - bw) / 2.0, by := py + ph - PANEL_PAD * k - bh, bw := bw, bh := bh]
END FUNC

FUNC bullet(x AS Float, y AS Float, r AS Float, c AS color::Color) AS canvas::DrawItem
  RETURN diamond(x, y, r, c)
END FUNC

' The panel's frame and title block, `a` as opaque as it will be.
FUNC panelFrame(f AS Fonts, info AS DemoInfo, lay AS PanelLayout, k AS Float, a AS Float) AS List OF canvas::DrawItem
  LET x AS Float = lay.x
  LET y AS Float = lay.y
  LET pw AS Float = lay.w
  LET cx AS Float = x + pw / 2.0
  ' Shadow, body and a double gold border.
  MUT out AS List OF canvas::DrawItem = [rrect(x - 6.0, y + 10.0, pw + 12.0, lay.h + 8.0, 20.0, faded(fillP(rgba(0, 0, 0, 110)), a))]
  out = collections::append(out, rrect(x, y, pw, lay.h, 16.0, faded(WITH gradP(downward(lay.h, [gstop(0.0, panelTop()), gstop(1.0, panelBottom())])) { stroke := alpha(gold(), 0.7), strokeWidth := 1.4 }, a)))
  out = collections::append(out, rrect(x + 7.0, y + 7.0, pw - 14.0, lay.h - 14.0, 11.0, faded(canvas::stroke(alpha(gold(), 0.22), 1.0), a)))
  ' The medallion with the scene's numeral.
  LET yy AS Float = y + (PANEL_PAD + 20.0) * k
  LET mr AS Float = 22.0 * k
  out = collections::append(out, circle(cx, yy, mr, faded(WITH gradP(focal(0.0, 0.0, mr, -mr * 0.27, -mr * 0.36, [gstop(0.0, hex("#3a4e6a")), gstop(1.0, hex("#101a28"))])) { stroke := gold(), strokeWidth := 1.5 }, a)))
  out = collections::append(out, centered(f.heading, 17.0 * k, info.numeral, cx, yy + 6.0 * k, faded(fillP(gold()), a)))
  LET ty AS Float = yy + (32.0 + PANEL_TITLE) * k
  LET ts AS Float = PANEL_TITLE * k
  out = collections::append(out, glowText(f.heading, ts, info.title, cx - textWidth(f.heading, ts, info.title) / 2.0, ty, gold(), 1.6, a))
  RETURN collections::append(out, centered(f.heading, ts, info.title, cx, ty, faded(fillP(parchment()), a)))
END FUNC

' One block of bulleted lines; returns the items, and where the next block starts in `after`.
FUNC bulletBlock(font AS canvas::Font, size AS Float, block AS List OF String, left AS Float, y AS Float, lineH AS Float, k AS Float, ink AS color::Color, dot AS color::Color, a AS Float) AS List OF canvas::DrawItem
  MUT out AS List OF canvas::DrawItem = []
  FOR i = 0 TO len(block) - 1
    LET ly AS Float = y + toFloat(i + 1) * lineH * k
    IF i = 0 THEN out = collections::append(out, bullet(left + 4.0 * k, ly - 5.0 * k, 3.5 * k, fade(dot, a)))
    out = collections::append(out, labelP(font, size, collections::get(block, i), left + 20.0 * k, ly, faded(fillP(ink), a)))
  NEXT
  RETURN out
END FUNC

' The panel itself at full size, `a` as opaque as it will be.
FUNC introPanel(f AS Fonts, info AS DemoInfo, text AS PanelText, lay AS PanelLayout, a AS Float) AS List OF canvas::DrawItem
  LET k AS Float = text.k
  LET pw AS Float = lay.w
  LET cx AS Float = lay.x + pw / 2.0
  LET left AS Float = lay.x + PANEL_PAD * k
  MUT out AS List OF canvas::DrawItem = panelFrame(f, info, lay, k, a)
  MUT yy AS Float = lay.y + (PANEL_PAD + 20.0 + 32.0 + PANEL_TITLE + 14.0) * k
  FOR EACH l IN text.flavor
    yy = yy + 22.0 * k
    out = collections::append(out, centered(f.italic, PANEL_FLAVOR * k, l, cx, yy, faded(fillP(muted()), a)))
  NEXT
  yy = yy + 20.0 * k
  out = collections::append(out, divider(cx, yy, pw * 0.36, a))
  ' What the scene shows of the canvas.
  yy = yy + 28.0 * k
  out = collections::append(out, drawTracked(f.bold, PANEL_LABEL * k, text.onCanvas, left, yy, faded(fillP(gold()), a)))
  yy = yy + 6.0 * k
  FOR EACH block IN text.primary
    out = collections::append(out, bulletBlock(f.body, PANEL_PRIMARY * k, block, left, yy, 21.0, k, parchment(), gold(), a))
    yy = yy + (toFloat(len(block)) * 21.0 + 6.0) * k
  NEXT
  ' And what it shows of the language.
  yy = yy + 22.0 * k
  out = collections::append(out, drawTracked(f.bold, PANEL_LABEL * k, text.inLanguage, left, yy, faded(fillP(alpha(muted(), 0.9)), a)))
  yy = yy + 4.0 * k
  FOR EACH block IN text.secondary
    out = collections::append(out, bulletBlock(f.body, PANEL_SECONDARY * k, block, left, yy, 19.0, k, muted(), alpha(muted(), 0.8), a))
    yy = yy + (toFloat(len(block)) * 19.0 + 4.0) * k
  NEXT
  ' Controls.
  yy = yy + 18.0 * k
  LET boxH AS Float = (math::max(toFloat(len(text.controls)) * 19.0, 19.0) + 14.0) * k
  out = collections::append(out, rrect(left - 8.0 * k, yy - 4.0 * k, pw - PANEL_PAD * k * 2.0 + 16.0 * k, boxH, 8.0 * k, faded(WITH fillP(rgba(255, 255, 255, 10)) { stroke := rgba(255, 255, 255, 22), strokeWidth := 1.0 }, a)))
  out = collections::append(out, drawTracked(f.bold, PANEL_LABEL * k, text.controlsLabel, left + 4.0 * k, yy + 15.0 * k, faded(fillP(gold()), a)))
  FOR i = 0 TO len(text.controls) - 1
    out = collections::append(out, labelP(f.body, PANEL_SECONDARY * k, collections::get(text.controls, i), left + 108.0 * k, yy + (15.0 + toFloat(i) * 19.0) * k, faded(fillP(parchment()), a)))
  NEXT
  ' Begin.
  out = collections::append(out, button(f, "begin", text.begin, lay.bx, lay.by, lay.bw, lay.bh, TRUE, a))
  RETURN collections::append(out, centered(f.body, 11.5 * k, "Enter  ·  Space  ·  Click", cx, lay.by + lay.bh + 18.0 * k, faded(fillP(alpha(muted(), 0.6)), a)))
END FUNC

' The panel animated in (or out): `open` runs 0 -> 1 as it appears. It is
' installed as a group whose node grows it from 94% about its middle and
' lifts it into place while it fades in; once open, the node draws it at
' exactly its own size. The sheen along its top edge drifts every frame, so it
' is drawn outside the group rather than re-installing the panel for it.
FUNC drawIntro(f AS Fonts, info AS DemoInfo, text AS PanelText, lay AS PanelLayout, w AS Float, h AS Float, open AS Float, t AS Float) AS List OF canvas::DrawItem
  LET a AS Float = easeOutCubic(open)
  canvas::setGroup("intro-panel", introPanel(f, info, text, lay, a))
  LET cx AS Float = lay.x + lay.w / 2.0
  LET cy AS Float = lay.y + lay.h / 2.0
  MUT s AS Float = 1.0
  IF open < 1.0 THEN s = 0.94 + 0.06 * easeOutBack(open)
  LET rise AS Float = (1.0 - a) * 24.0
  ' The node sits at the panel's middle; the group's origin is the window's,
  ' so the scale is taken about the middle and then moved back out to it.
  LET tr AS canvas::Transform = canvas::Transform[a := s, b := 0.0, c := 0.0, d := s, tx := -cx * s, ty := -cy * s]
  MUT out AS List OF canvas::DrawItem = [rect(0.0, 0.0, w, h, fillP(rgba(4, 7, 12, math::round(150.0 * a)))), nodeT("intro-panel", cx, cy + rise, tr)]
  IF open >= 1.0 THEN out = collections::append(out, sheen(lay, t))
  RETURN out
END FUNC

' A highlight running along the panel's top edge, drifting slowly.
FUNC sheen(lay AS PanelLayout, t AS Float) AS canvas::DrawItem
  LET sx AS Float = lay.w * fract(t * 0.07)
  RETURN rrect(lay.x, lay.y, lay.w, 3.0, 1.5, WITH glowP(color::white) { gradient := linear(sx - 140.0, 0.0, sx + 140.0, 0.0, [gstop(0.0, rgba(255, 230, 170, 0)), gstop(0.5, rgba(255, 230, 170, 120)), gstop(1.0, rgba(255, 230, 170, 0))]) })
END FUNC

' ---------------------------------------------------------------------------
' Hints and the fade
' ---------------------------------------------------------------------------

' The scene's name in the top-left corner and a line of hints along the
' bottom, both fading away a few seconds after the scene starts and coming back
' while the mouse is near the bottom edge.
FUNC sceneChrome(f AS Fonts, info AS DemoInfo, w AS Float, h AS Float, visible AS Float) AS List OF canvas::DrawItem
  IF visible <= 0.01 THEN RETURN []
  LET hint AS String = info.hint & "      I  about this scene      M  sound      Esc  menu"
  LET hw AS Float = textWidth(f.body, 13.0, hint)
  LET title AS String = info.numeral & "  ·  " & info.title
  LET tw AS Float = textWidth(f.heading, 15.0, title)
  MUT out AS List OF canvas::DrawItem = [rrect(16.0, 14.0, tw + 30.0, 32.0, 16.0, WITH fillP(rgba(8, 12, 20, toInt(150.0 * visible))) { stroke := alpha(gold(), 0.35 * visible), strokeWidth := 1.0 })]
  out = collections::append(out, label(f.heading, 15.0, title, 31.0, 35.5, alpha(parchment(), visible)))
  out = collections::append(out, rrect((w - hw) / 2.0 - 18.0, h - 44.0, hw + 36.0, 28.0, 14.0, fillP(rgba(8, 12, 20, toInt(140.0 * visible)))))
  RETURN collections::append(out, label(f.body, 13.0, hint, (w - hw) / 2.0, h - 25.5, alpha(muted(), visible)))
END FUNC

FUNC blackout(w AS Float, h AS Float, amount AS Float) AS List OF canvas::DrawItem
  IF amount <= 0.001 THEN RETURN []
  RETURN [rect(0.0, 0.0, w, h, fillP(rgba(0, 0, 0, math::round(255.0 * clamp01(amount)))))]
END FUNC

' The P overlay: frames drawn and presented per second, which renderer drew the
' last frame and how long it took, and how many items the scene has.
FUNC statsPanel(f AS Fonts, s AS canvas::FrameStats, items AS Integer, w AS Float) AS List OF canvas::DrawItem
  LET lines AS List OF String = [toString(math::round(s.fps)) & " fps  ·  " & toString(math::round(s.pps)) & " presents/s", toString(s.renderer) & "  ·  " & toString(math::round(s.frameSeconds * 100000.0) / 100) & " ms a frame", toString(items) & " items"]
  LET x AS Float = w - 236.0
  MUT out AS List OF canvas::DrawItem = [rrect(x, 14.0, 220.0, 70.0, 10.0, WITH fillP(rgba(6, 10, 16, 200)) { stroke := alpha(gold(), 0.4), strokeWidth := 1.0 })]
  FOR i = 0 TO 2
    out = collections::append(out, label(f.body, 13.0, collections::get(lines, i), x + 14.0, 35.0 + toFloat(i) * 19.0, parchment()))
  NEXT
  RETURN out
END FUNC
