' cathedral - IX. The Cathedral of Light.
'
' A forest chapel and its great rose window. The glass is the scene's whole
' point: each pane is a polygon filled with a gradient that imitates hand-made
' glass - streaks from a linear ramp that GradientSpread.Repeat repeats and the
' gradient's own transform turns, a bloom from a radial ramp whose focal point
' sits towards the light - and the lead between the panes is the polygons'
' stroke. A gilded frame is painted, fill and outline, by one gradient
' (GradientApply.FillAndStroke).
'
' The sun outside follows the mouse. The light through the window falls on the
' floor as the same pane polygons again, under a transform that shears and
' flattens them onto the flagstones, added on with BlendMode.Add, so moving the
' sun swings the coloured pools across the floor. Click a pane to change its
' glass; R re-leads the whole window in new colours.

IMPORT canvas
IMPORT collections
IMPORT color
IMPORT math

TYPE Pane
  ring AS List OF canvas::Point    ' relative to the window's centre, in units of its radius
  hue AS Integer
END TYPE

TYPE CathedralState
  t AS Float
  panes AS List OF Pane
  hover AS Integer
  sunX AS Float        ' -1..1, where the sun is across the sky outside
  sunY AS Float        '  0..1, how high it is
  flash AS Float
  flashPane AS Integer
END TYPE

FUNC glassColor(i AS Integer) AS color::Color
  MATCH i MOD 7
    CASE 0 : RETURN hex("#c8182c")
    CASE 1 : RETURN hex("#1f4fc8")
    CASE 2 : RETURN hex("#f2b21a")
    CASE 3 : RETURN hex("#1f9a52")
    CASE 4 : RETURN hex("#7b2fbf")
    CASE 5 : RETURN hex("#e2641a")
    CASE ELSE : RETURN hex("#28b4c8")
  END MATCH
END FUNC

' An arc of points at radius r from angle a0 to a1.
FUNC arcRing(r AS Float, a0 AS Float, a1 AS Float, n AS Integer) AS List OF canvas::Point
  MUT out AS List OF canvas::Point = []
  FOR i = 0 TO n
    LET a AS Float = a0 + (a1 - a0) * toFloat(i) / toFloat(n)
    out = collections::append(out, pt(math::cos(a) * r, math::sin(a) * r))
  NEXT
  RETURN out
END FUNC

' The panes of the rose: a round centre, a ring of six, a ring of twelve
' lancet petals, and twelve small roundels between the petals' tips.
FUNC rosePanes AS List OF Pane
  MUT out AS List OF Pane = [Pane[ring := ovalRing(0.0, 0.0, 0.2, 0.2, 40, 0.0), hue := 2]]
  LET gap AS Float = 0.035
  FOR k = 0 TO 5
    LET a0 AS Float = toFloat(k) * TAU / 6.0 + gap - math::pi / 2.0
    LET a1 AS Float = toFloat(k + 1) * TAU / 6.0 - gap - math::pi / 2.0
    LET ring AS List OF canvas::Point = collections::append(arcRing(0.25, a0 + 0.03, a1 - 0.03, 8), collections::transform(collections::take(arcRing(0.52, a1, a0, 10), 11), LAMBDA(p AS canvas::Point) -> p))
    out = collections::append(out, Pane[ring := ring, hue := k MOD 2 + 0])
  NEXT
  FOR k = 0 TO 11
    ' A lancet: two arcs meeting in a point, standing on a curved sill.
    LET mid AS Float = toFloat(k) * TAU / 12.0 - math::pi / 2.0
    LET half AS Float = TAU / 24.0 - gap * 0.7
    LET ca AS Float = math::cos(mid)
    LET sa AS Float = math::sin(mid)
    MUT ring AS List OF canvas::Point = arcRing(0.56, mid - half, mid + half, 6)
    ' Up the right side to the point, and back down the left.
    LET rBase AS Float = 0.56
    LET rTip AS Float = 0.9
    LET wBase AS Float = math::sin(half) * rBase
    FOR i = 1 TO 8
      LET u AS Float = toFloat(i) / 8.0
      LET r AS Float = rBase * math::cos(half) + (rTip - rBase * math::cos(half)) * u
      LET wdt AS Float = wBase * math::sqrt(1.0 - u * u * 0.98) * (1.0 - u * 0.15)
      ring = collections::append(ring, pt(ca * r - sa * wdt, sa * r + ca * wdt))
    NEXT
    FOR i = 8 TO 1 STEP -1
      LET u AS Float = toFloat(i) / 8.0
      LET r AS Float = rBase * math::cos(half) + (rTip - rBase * math::cos(half)) * u
      LET wdt AS Float = wBase * math::sqrt(1.0 - u * u * 0.98) * (1.0 - u * 0.15)
      ring = collections::append(ring, pt(ca * r + sa * wdt, sa * r - ca * wdt))
    NEXT
    out = collections::append(out, Pane[ring := ring, hue := (k MOD 3) + 3])
  NEXT
  FOR k = 0 TO 11
    LET a AS Float = (toFloat(k) + 0.5) * TAU / 12.0 - math::pi / 2.0
    out = collections::append(out, Pane[ring := ovalRing(math::cos(a) * 0.86, math::sin(a) * 0.86, 0.065, 0.065, 20, 0.0), hue := 2 + (k MOD 2) * 4])
  NEXT
  RETURN out
END FUNC

FUNC cathedralNew AS CathedralState
  RETURN CathedralState[t := 0.0, panes := rosePanes(), hover := -1, sunX := 0.2, sunY := 0.5, flash := 0.0, flashPane := -1]
END FUNC

' Is the point inside the ring? A ray to the right crosses an odd number of
' edges exactly when it is.
FUNC insideRing(ring AS List OF canvas::Point, x AS Float, y AS Float) AS Boolean
  MUT inside AS Boolean = FALSE
  LET n AS Integer = len(ring)
  MUT j AS Integer = n - 1
  FOR i = 0 TO n - 1
    LET a AS canvas::Point = collections::get(ring, i)
    LET b AS canvas::Point = collections::get(ring, j)
    IF (a.y > y) <> (b.y > y) THEN
      IF x < (b.x - a.x) * (y - a.y) / (b.y - a.y) + a.x THEN inside = NOT inside
    END IF
    j = i
  NEXT
  RETURN inside
END FUNC

TYPE Rose
  cx AS Float
  cy AS Float
  r AS Float
END TYPE

FUNC roseAt(w AS Float, h AS Float) AS Rose
  RETURN Rose[cx := w * 0.5, cy := h * 0.33, r := math::min(h * 0.27, w * 0.24)]
END FUNC

FUNC cathedralStep(s AS CathedralState, inp AS Input, dt AS Float) AS CathedralState
  LET rose AS Rose = roseAt(inp.w, inp.h)
  LET lx AS Float = (inp.mx - rose.cx) / rose.r
  LET ly AS Float = (inp.my - rose.cy) / rose.r
  MUT hover AS Integer = -1
  IF inp.mx >= 0.0 THEN
    FOR i = 0 TO len(s.panes) - 1
      IF insideRing(collections::get(s.panes, i).ring, lx, ly) THEN hover = i
    NEXT
  END IF
  MUT panes AS List OF Pane = s.panes
  MUT flash AS Float = math::max(0.0, s.flash - dt * 1.5)
  MUT flashPane AS Integer = s.flashPane
  IF inp.pressed AND hover >= 0 THEN
    LET p AS Pane = collections::get(panes, hover)
    panes = collections::set(panes, hover, WITH p { hue := (p.hue + 1) MOD 7 })
    flash = 1.0
    flashPane = hover
  END IF
  IF keyPressed(inp, "r") THEN
    panes = collections::transform(panes, LAMBDA(p AS Pane) -> WITH p { hue := math::rand(0, 6) })
    flash = 1.0
    flashPane = -1
  END IF
  ' The sun follows the mouse, eased, and drifts by itself while the mouse is away.
  MUT tx AS Float = math::sin(s.t * 0.1) * 0.8
  MUT ty AS Float = 0.5
  IF inp.mx >= 0.0 THEN
    tx = clampF((inp.mx / inp.w - 0.5) * 2.0, -1.0, 1.0)
    ty = clampF(1.0 - inp.my / inp.h, 0.1, 1.0)
  END IF
  RETURN CathedralState[t := s.t + dt, panes := panes, hover := hover, sunX := approach(s.sunX, tx, 2.5, dt), sunY := approach(s.sunY, ty, 2.5, dt), flash := flash, flashPane := flashPane]
END FUNC

' ---------------------------------------------------------------------------
' Drawing
' ---------------------------------------------------------------------------


' The glass of one pane: streaked by a repeating linear ramp turned to its own
' angle, with a bloom of light from a focal radial ramp on top.
FUNC glassPaint(base AS color::Color, seed AS Integer, rose AS Rose, light AS Float) AS canvas::Paint
  LET deep AS color::Color = mixC(base, color::black, 0.45)
  LET bright AS color::Color = mixC(base, color::white, 0.25 + 0.3 * light)
  LET angle AS Float = hashRange(seed, 0.0, math::pi)
  LET streak AS canvas::Gradient = WITH linear(0.0, 0.0, 0.0, rose.r * 0.045, [gstop(0.0, deep), gstop(0.5, mixC(base, bright, light)), gstop(1.0, deep)]) { spread := canvas::GradientSpread.Repeat, transform := place(rose.cx, rose.cy, angle, 1.0) }
  RETURN WITH canvas::fill(color::white) { gradient := streak, stroke := hex("#141010"), strokeWidth := math::max(2.0, rose.r * 0.022), join := canvas::JoinStyle.Round }
END FUNC

FUNC cathedralDraw(s AS CathedralState, f AS Fonts, w AS Float, h AS Float) AS List OF canvas::DrawItem
  LET t AS Float = s.t
  LET rose AS Rose = roseAt(w, h)
  LET floorY AS Float = h * 0.68
  ' The light outside: warmer and lower as the sun drops.
  LET sunWarm AS Float = 1.0 - s.sunY
  LET light AS color::Color = mixC(hex("#fff6e0"), hex("#ffb060"), sunWarm)
  LET strength AS Float = 0.45 + 0.55 * s.sunY
  ' The nave: dark stone walls, the floor, and two great pillars.
  MUT out AS List OF canvas::DrawItem = [rect(0.0, 0.0, w, floorY, gradP(linear(0.0, 0.0, 0.0, floorY, [gstop(0.0, hex("#0d0b10")), gstop(1.0, hex("#2a2420"))])))]
  ' Courses of stone in the wall.
  FOR row = 0 TO 22
    LET y AS Float = floorY * toFloat(row) / 22.0
    out = collections::append(out, line(0.0, y, w, y, canvas::stroke(rgba(255, 230, 200, 10), 1.0)))
  NEXT
  out = collections::append(out, rect(0.0, floorY, w, h - floorY, gradP(linear(0.0, floorY, 0.0, h, [gstop(0.0, hex("#2e2824")), gstop(1.0, hex("#120e0c"))]))))
  ' Flagstones in perspective: lines converging on a point above the window.
  FOR i = -10 TO 10
    LET u AS Float = toFloat(i) / 10.0
    out = collections::append(out, line(w * 0.5 + u * w * 0.12, floorY, w * 0.5 + u * w * 1.1, h, canvas::stroke(rgba(0, 0, 0, 70), 1.2)))
  NEXT
  FOR i = 1 TO 6
    LET y AS Float = floorY + (h - floorY) * math::pow(toFloat(i) / 6.0, 1.6)
    out = collections::append(out, line(0.0, y, w, y, canvas::stroke(rgba(0, 0, 0, 60), 1.2)))
  NEXT

  ' Light through the window, falling on the floor: every pane again, under a
  ' transform that flattens it onto the floor and shears it away from the sun.
  LET shear AS Float = -s.sunX * 1.2
  LET squash AS Float = 0.32 + 0.25 * (1.0 - s.sunY)
  LET poolX AS Float = w * 0.5 - s.sunX * w * 0.18
  LET poolY AS Float = floorY + (h - floorY) * (0.35 + 0.35 * s.sunY)
  LET onFloor AS canvas::Transform = canvas::Transform[a := rose.r * 1.15, b := 0.0, c := shear * rose.r, d := rose.r * squash, tx := poolX, ty := poolY]
  ' The shaft between the window and the floor: a soft quad, added on.
  LET shaft AS List OF canvas::Point = [pt(rose.cx - rose.r * 0.9, rose.cy), pt(rose.cx + rose.r * 0.9, rose.cy), pt(poolX + rose.r * 1.1 + shear * rose.r * 0.3, poolY), pt(poolX - rose.r * 1.1 - shear * rose.r * 0.3, poolY)]
  out = collections::append(out, poly(shaft, WITH glowP(color::white) { gradient := linear(0.0, rose.cy, 0.0, poolY, [gstop(0.0, fade(light, 0.12 * strength)), gstop(1.0, fade(light, 0.05 * strength))]) }))
  FOR EACH p IN s.panes
    out = collections::append(out, poly(mapRing(p.ring, onFloor), glowP(fade(glassColor(p.hue), 0.42 * strength))))
  NEXT
  out = collections::append(out, glow(poolX, poolY, rose.r * 1.3, fade(light, 0.12 * strength)))

  ' The window's stone surround and its gilded frame: one gradient paints the
  ' frame's face and its outline both (FillAndStroke).
  out = collections::append(out, circle(rose.cx, rose.cy, rose.r * 1.16, fillP(hex("#3a332c"))))
  LET gilt AS canvas::Gradient = WITH linear(rose.cx - rose.r, rose.cy - rose.r, rose.cx + rose.r, rose.cy + rose.r, [gstop(0.0, hex("#fff0b0")), gstop(0.35, hex("#c99a3a")), gstop(0.7, hex("#7a5418")), gstop(1.0, hex("#e8c070"))]) { strokeApply := canvas::GradientApply.FillAndStroke, spread := canvas::GradientSpread.Reflect }
  out = collections::append(out, shape([ovalRing(rose.cx, rose.cy, rose.r * 1.08, rose.r * 1.08, 96, 0.0), ovalRing(rose.cx, rose.cy, rose.r * 0.98, rose.r * 0.98, 96, 0.0)], canvas::FillRule.EvenOdd, WITH gradP(gilt) { stroke := rgba(255, 255, 255, 120), strokeWidth := 2.0 }))
  ' Studs around the frame.
  FOR k = 0 TO 35
    LET a AS Float = toFloat(k) * TAU / 36.0
    out = collections::append(out, circle(rose.cx + math::cos(a) * rose.r * 1.03, rose.cy + math::sin(a) * rose.r * 1.03, rose.r * 0.013, fillP(hex("#fff4c8"))))
  NEXT
  ' The dark behind the glass, then the panes.
  out = collections::append(out, circle(rose.cx, rose.cy, rose.r * 0.98, fillP(hex("#120e10"))))
  LET winT AS canvas::Transform = canvas::Transform[a := rose.r, b := 0.0, c := 0.0, d := rose.r, tx := rose.cx, ty := rose.cy]
  FOR i = 0 TO len(s.panes) - 1
    LET p AS Pane = collections::get(s.panes, i)
    MUT lit AS Float = strength
    IF i = s.hover THEN lit = math::min(1.0, lit + 0.35)
    IF i = s.flashPane OR s.flashPane < 0 THEN lit = math::min(1.0, lit + s.flash * 0.5)
    ' The pane is placed by mapping its unit ring into window pixels, so its
    ' gradients are given in window pixels too.
    LET ring AS List OF canvas::Point = mapRing(p.ring, winT)
    out = collections::append(out, poly(ring, glassPaint(glassColor(p.hue), i + 7, rose, lit)))
    ' The bloom: light pooling in the glass towards the sun.
    out = collections::append(out, poly(ring, WITH glowP(color::white) { gradient := WITH radial(rose.cx, rose.cy, rose.r, [gstop(0.0, fade(light, 0.35 * lit)), gstop(0.6, fade(glassColor(p.hue), 0.12 * lit)), gstop(1.0, rgba(0, 0, 0, 0))]) { focalOffset := pt(s.sunX * 0.5 * rose.r, -0.3 * rose.r) } }))
  NEXT
  ' The tracery: the lead lines of the rings, over the glass.
  FOR EACH r IN [0.21, 0.255, 0.535, 0.56, 0.98]
    out = collections::append(out, circle(rose.cx, rose.cy, rose.r * r, canvas::stroke(hex("#141010"), math::max(2.0, rose.r * 0.02))))
  NEXT

  ' Pillars either side, in front of the walls.
  FOR side = -1 TO 1 STEP 2
    LET px AS Float = w * 0.5 + toFloat(side) * w * 0.4
    out = collections::append(out, rect(px - w * 0.045, 0.0, w * 0.09, floorY + h * 0.02, gradP(linear(px - w * 0.045, 0.0, px + w * 0.045, 0.0, [gstop(0.0, hex("#15110e")), gstop(0.5 - toFloat(side) * 0.2, hex("#4a4038")), gstop(1.0, hex("#15110e"))]))))
    out = collections::append(out, rect(px - w * 0.055, floorY - h * 0.01, w * 0.11, h * 0.05, fillP(hex("#2a241f"))))
  NEXT

  ' Dust drifting in the shaft.
  out = collections::append(out, motes(rose.cx - rose.r, rose.cy, rose.r * 2.0, poolY - rose.cy, 30, t, fade(light, 0.8), 1.3, 41))
  out = collections::append(out, vignette(w, h, 190))
  ' The pane under the mouse, named by its colour.
  IF s.hover >= 0 THEN
    LET names AS List OF String = ["Ruby", "Cobalt", "Amber", "Emerald", "Amethyst", "Flame", "Turquoise"]
    out = collections::append(out, centered(f.italic, 16.0, collections::get(names, collections::get(s.panes, s.hover).hue MOD 7) & " glass  -  click to change", w / 2.0, h - 70.0, fillP(parchment())))
  END IF
  RETURN out
END FUNC
