' Dungeon - a nethack-style dungeon of rooms and halls, drawn isometrically
' from tiles.
'
' Build and run it (canvas needs a window, so this is an --app program):
'   mfb build examples/dungeon
'   open examples/dungeon/build/dungeon.app        (macOS)
'
' Controls:
'   w a s d   move up-right, up-left, down-left, down-right on the screen
'   q         rotate the view counterclockwise
'   e         rotate the view clockwise
'   esc       quit
'
' The program is in four files:
'   map.mfb        the map format, the four directions, movement, validity
'   generate.mfb   generateDungeon(seed): rooms, halls, doors and props
'   render.mfb     the view, the tiles, and the scene drawn from a map
'   main.mfb       reading keys, and the loop that draws and moves

IMPORT app
IMPORT canvas
IMPORT io

' ---------------------------------------------------------------------------
' Input
' ---------------------------------------------------------------------------

FUNC getChar AS String
  LET c AS String = io::readChar() TRAP(e)
    RECOVER ""
  END TRAP
  RETURN c
END FUNC

FUNC ready(ms AS Integer) AS Boolean
  LET r AS Boolean = io::pollInput(ms) TRAP(e)
    RECOVER FALSE
  END TRAP
  RETURN r
END FUNC

' One key press. A lone escape byte is the Esc key; an escape followed by more
' input is a key sequence, which is read off and reported as "" so it does
' nothing. "EOF" means the window closed.
FUNC readKey AS String
  LET c AS String = getChar()
  IF c = "" THEN RETURN "EOF"
  IF c <> "\u{1B}" THEN RETURN c
  IF NOT ready(30) THEN RETURN "ESC"
  DO WHILE ready(0)
    LET rest AS String = getChar()
    IF rest = "" THEN RETURN "EOF"
  LOOP
  RETURN ""
END FUNC

' The screen direction a movement key walks in, as a view direction: w is
' up-right, d down-right, s down-left and a up-left. [] is not a movement key.
FUNC keyDirection(key AS String) AS List OF Facing
  MATCH key
    CASE "w", "W" : RETURN [Facing.North]
    CASE "d", "D" : RETURN [Facing.East]
    CASE "s", "S" : RETURN [Facing.South]
    CASE "a", "A" : RETURN [Facing.West]
    CASE ELSE : RETURN []
  END MATCH
END FUNC

' ---------------------------------------------------------------------------
' Main loop
' ---------------------------------------------------------------------------

FUNC main AS Integer
  app::setMode(app::Mode.Canvas)

  LET m AS DungeonMap = generateDungeon(10)
  LET tiles AS Map OF String TO RES canvas::Image = loadTiles(["stone", "stoneMissingTiles", "stoneWall", "stoneWallArchway", "stoneWallCorner", "barrel", "tableShort"]) TRAP(e)
    io::printError("dungeon: cannot load the tiles: " & e.message)
    RETURN 1
  END TRAP

  MUT px AS Integer = m.startX
  MUT py AS Integer = m.startY
  MUT turns AS Integer = 0
  MUT redraw AS Boolean = TRUE
  MUT running AS Boolean = TRUE
  DO WHILE running
    IF canvas::didResize() THEN redraw = TRUE
    IF redraw THEN
      canvas::present(sceneFor(m, tiles, viewFor(m, turns, canvas::getSize(), px, py), px, py))
      redraw = FALSE
    END IF

    IF ready(16) THEN
      LET key AS String = readKey()
      FOR EACH toward IN keyDirection(key)
        LET dir AS Facing = mapDirection(toward, turns)
        IF canMove(m, px, py, dir) THEN
          px = px + stepX(dir)
          py = py + stepY(dir)
          redraw = TRUE
        END IF
      NEXT
      MATCH key
        CASE "q", "Q"
          turns = (turns + 3) MOD 4
          redraw = TRUE
        CASE "e", "E"
          turns = (turns + 1) MOD 4
          redraw = TRUE
        CASE "ESC", "EOF" : running = FALSE
        CASE ELSE
      END MATCH
    END IF
  LOOP
  RETURN 0
END FUNC
