IMPORT app
IMPORT canvas
IMPORT collections
IMPORT color
IMPORT io
IMPORT math
IMPORT os

' Dungeon - a nethack-style dungeon of rooms and halls, drawn isometrically
' from tiles.
'
' Build and run it (canvas needs a window, so this is an --app program):
'   mfb build examples/dungeon
'   open examples/dungeon/build/dungeon.app        (macOS)
'
' Controls:
'   w a s d   move up-right, up-left, down-left, down-right on the screen
'   q         rotate the view counterclockwise
'   e         rotate the view clockwise
'   esc       quit
'
' generateDungeon(seed) builds the whole level from math::rand after seeding
' it, so the same seed always gives the same dungeon: walled rooms, joined by
' walled halls.
'
' Every tile in resources/dungeon comes in four versions, <name>_N, _E, _S and
' _W, one per direction the piece faces. All of them are 256 x 512 sprites
' drawn at the same anchor for a map cell: the floor's diamond fills the bottom
' of the sprite and taller pieces rise above it. A wall piece stands on the
' edge of its cell opposite the way it faces, so a wall facing North stands on
' the cell's South edge. A corner piece stands on two edges: the one a wall
' facing the same way would, and the next one counterclockwise, so a corner
' facing North stands on the South and East edges.
'
' A wall's slab lies inside the cell that holds the piece, along the edge. Every
' place a wall turns is one corner piece, and a straight run of wall keeps its
' slab on one side, or steps across its edge between two pieces. A map where
' that cannot be so - a door in a room's corner, a hall bending twice within a
' cell, two walls on one edge - is invalid (see mapIsValid), and
' generateDungeon never returns one.

' ---------------------------------------------------------------------------
' The map format
' ---------------------------------------------------------------------------

' Map directions. North is toward row 0, East toward the last column.
ENUM Facing
  North, East, South, West
END ENUM

' One tile placed in a cell, e.g. Piece["barrel", Facing.North] draws
' barrel_N.png while the view is unrotated.
TYPE Piece
  tile AS String
  facing AS Facing
END TYPE

' Everything in one map cell. A cell whose floor tile is "" is solid rock:
' nothing is drawn there and nobody can stand there. Walls are kept apart from
' props because they stand on the cell's edges and are drawn in two halves
' around the props.
TYPE Cell
  floor AS Piece
  walls AS List OF Piece
  props AS List OF Piece
END TYPE

' A width x height grid of cells, stored row by row: cell (x, y) is at index
' y * width + x. (startX, startY) is where the player begins.
TYPE DungeonMap
  width AS Integer
  height AS Integer
  cells AS List OF Cell
  startX AS Integer
  startY AS Integer
END TYPE

FUNC cellAt(m AS DungeonMap, x AS Integer, y AS Integer) AS Cell
  RETURN collections::get(m.cells, y * m.width + x)
END FUNC

' ---------------------------------------------------------------------------
' Directions
' ---------------------------------------------------------------------------

FUNC facingIndex(f AS Facing) AS Integer
  IF f = Facing.North THEN RETURN 0
  IF f = Facing.East THEN RETURN 1
  IF f = Facing.South THEN RETURN 2
  RETURN 3
END FUNC

' The facing for an index, taken round the compass, so -1 is West.
FUNC facingOf(i AS Integer) AS Facing
  LET k AS Integer = ((i MOD 4) + 4) MOD 4
  IF k = 0 THEN RETURN Facing.North
  IF k = 1 THEN RETURN Facing.East
  IF k = 2 THEN RETURN Facing.South
  RETURN Facing.West
END FUNC

FUNC opposite(f AS Facing) AS Facing
  RETURN facingOf(facingIndex(f) + 2)
END FUNC

FUNC stepX(f AS Facing) AS Integer
  IF f = Facing.East THEN RETURN 1
  IF f = Facing.West THEN RETURN -1
  RETURN 0
END FUNC

FUNC stepY(f AS Facing) AS Integer
  IF f = Facing.South THEN RETURN 1
  IF f = Facing.North THEN RETURN -1
  RETURN 0
END FUNC

FUNC compass AS List OF Facing
  RETURN [Facing.North, Facing.East, Facing.South, Facing.West]
END FUNC

' Whether a wall piece closes off the given edge of its cell. An archway stands
' on its edge but leaves it open.
FUNC blocksEdge(p AS Piece, edge AS Facing) AS Boolean
  IF p.tile = "stoneWall" THEN RETURN opposite(p.facing) = edge
  IF p.tile = "stoneWallCorner" THEN RETURN opposite(p.facing) = edge OR opposite(facingOf(facingIndex(p.facing) - 1)) = edge
  RETURN FALSE
END FUNC

' ---------------------------------------------------------------------------
' Generation
' ---------------------------------------------------------------------------

FUNC dungeonWidth AS Integer
  RETURN 72
END FUNC

FUNC dungeonHeight AS Integer
  RETURN 48
END FUNC

FUNC maxRooms AS Integer
  RETURN 9
END FUNC

' Room sides, in cells: 4 x 4 is the smallest room, 15 x 15 the biggest.
FUNC minRoomSide AS Integer
  RETURN 4
END FUNC

FUNC maxRoomSide AS Integer
  RETURN 15
END FUNC

' What fills each cell while the level is dug out.
ENUM Ground
  Rock, RoomFloor, Hall
END ENUM

TYPE Rect
  x AS Integer
  y AS Integer
  w AS Integer
  h AS Integer
END TYPE

' A room: the cells of its bounding box less the rectangles cut out of it. No
' cuts is a plain rectangle; one cut from a corner makes an L, one from the
' middle of a side a U, and one from each end of a side a T. Every arm, notch
' and side is at least two cells, so each run of wall has room for a piece of
' its own between the corners at its ends.
TYPE Room
  x AS Integer
  y AS Integer
  w AS Integer
  h AS Integer
  cuts AS List OF Rect
END TYPE

FUNC inRect(r AS Rect, x AS Integer, y AS Integer) AS Boolean
  RETURN x >= r.x AND y >= r.y AND x < r.x + r.w AND y < r.y + r.h
END FUNC

FUNC inRoom(r AS Room, x AS Integer, y AS Integer) AS Boolean
  IF NOT inRect(Rect[r.x, r.y, r.w, r.h], x, y) THEN RETURN FALSE
  FOR EACH c IN r.cuts
    IF inRect(c, x, y) THEN RETURN FALSE
  NEXT
  RETURN TRUE
END FUNC

' The rectangle `depth` deep along side `side` of box b, running `length`
' cells from `from` along that side (from its top or left end).
FUNC sideCut(b AS Rect, side AS Facing, from AS Integer, length AS Integer, depth AS Integer) AS Rect
  IF side = Facing.North THEN RETURN Rect[b.x + from, b.y, length, depth]
  IF side = Facing.South THEN RETURN Rect[b.x + from, b.y + b.h - depth, length, depth]
  IF side = Facing.West THEN RETURN Rect[b.x, b.y + from, depth, length]
  RETURN Rect[b.x + b.w - depth, b.y + from, depth, length]
END FUNC

' A room filling box b: a rectangle, an L, a U or a T, turned any way.
FUNC shapeRoom(b AS Rect) AS Room
  LET side AS Facing = facingOf(math::rand(0, 3))
  ' The box's size along the chosen side, and across it.
  MUT span AS Integer = b.w
  MUT deep AS Integer = b.h
  IF side = Facing.East OR side = Facing.West THEN
    span = b.h
    deep = b.w
  END IF
  LET kind AS Integer = math::rand(0, 3)
  LET depth AS Integer = math::rand(2, deep - 2)
  IF kind = 1 THEN
    ' L: a corner off one end of the side.
    LET length AS Integer = math::rand(2, span - 2)
    MUT from AS Integer = 0
    IF math::rand(0, 1) = 0 THEN from = span - length
    RETURN Room[b.x, b.y, b.w, b.h, [sideCut(b, side, from, length, depth)]]
  END IF
  IF kind = 2 AND span >= 6 THEN
    ' U: a notch out of the middle, with an arm of two or more each side.
    LET length AS Integer = math::rand(2, span - 4)
    RETURN Room[b.x, b.y, b.w, b.h, [sideCut(b, side, math::rand(2, span - length - 2), length, depth)]]
  END IF
  IF kind = 3 AND span >= 6 THEN
    ' T: both ends of the side cut away, leaving a stem two or more wide.
    LET stem AS Integer = math::rand(2, span - 4)
    LET left AS Integer = math::rand(2, span - stem - 2)
    RETURN Room[b.x, b.y, b.w, b.h, [sideCut(b, side, 0, left, depth), sideCut(b, side, left + stem, span - left - stem, depth)]]
  END IF
  RETURN Room[b.x, b.y, b.w, b.h, []]
END FUNC

' An opening in a room's wall: the room cell and the edge of it that opens
' onto a hall.
TYPE Door
  x AS Integer
  y AS Integer
  edge AS Facing
END TYPE

' The level while it is being dug: what fills each cell, the doors so far,
' and every wall piece by the index of the cell it stands in.
TYPE Dig
  width AS Integer
  height AS Integer
  ground AS List OF Ground
  doors AS List OF Door
  walls AS Map OF Integer TO List OF Piece
END TYPE

FUNC groundAt(d AS Dig, x AS Integer, y AS Integer) AS Ground
  IF x < 0 OR y < 0 OR x >= d.width OR y >= d.height THEN RETURN Ground.Rock
  RETURN collections::get(d.ground, y * d.width + x)
END FUNC

FUNC iabs(n AS Integer) AS Integer
  IF n < 0 THEN RETURN -n
  RETURN n
END FUNC

' Whether two rooms' boxes come within `gap` cells of each other.
FUNC roomsTouch(a AS Room, b AS Room, gap AS Integer) AS Boolean
  RETURN a.x - gap < b.x + b.w AND b.x - gap < a.x + a.w AND a.y - gap < b.y + b.h AND b.y - gap < a.y + a.h
END FUNC

' Up to maxRooms rooms scattered over the level, at least three cells apart so
' a hall can run between them, sorted left to right.
FUNC placeRooms(width AS Integer, height AS Integer) AS List OF Room
  MUT rooms AS List OF Room = []
  MUT tries AS Integer = 0
  DO WHILE len(rooms) < maxRooms() AND tries < 400
    tries = tries + 1
    LET w AS Integer = math::rand(minRoomSide(), maxRoomSide())
    LET h AS Integer = math::rand(minRoomSide(), maxRoomSide())
    LET candidate AS Room = shapeRoom(Rect[math::rand(2, width - w - 2), math::rand(2, height - h - 2), w, h])
    MUT clear AS Boolean = TRUE
    FOR EACH r IN rooms
      IF roomsTouch(r, candidate, 3) THEN clear = FALSE
    NEXT
    IF clear THEN rooms = collections::append(rooms, candidate)
  LOOP

  MUT sorted AS List OF Room = []
  MUT rest AS List OF Room = rooms
  DO WHILE len(rest) > 0
    MUT best AS Integer = 0
    FOR i = 1 TO len(rest) - 1
      IF collections::get(rest, i).x < collections::get(rest, best).x THEN best = i
    NEXT
    sorted = collections::append(sorted, collections::get(rest, best))
    rest = collections::removeAt(rest, best)
  LOOP
  RETURN sorted
END FUNC

' A wall piece standing on the given edge of its cell.
FUNC wallOn(edge AS Facing) AS Piece
  RETURN Piece["stoneWall", opposite(edge)]
END FUNC

' The corner piece standing on two edges of its cell that meet.
FUNC cornerOn(a AS Facing, b AS Facing) AS Piece
  IF facingOf(facingIndex(opposite(a)) - 1) = opposite(b) THEN RETURN Piece["stoneWallCorner", opposite(a)]
  RETURN Piece["stoneWallCorner", opposite(b)]
END FUNC

' A wall piece and the index of the cell it stands in.
TYPE Placed
  cell AS Integer
  piece AS Piece
END TYPE

' The wall pieces round room r. Walking each wall clockwise, a run of wall
' ends at a corner where the room turns: outward round a corner of the room
' (the corner piece stands in the room) or inward round a notch (it stands in
' the rock cell in the angle). Each piece of the run between stands on the
' same side as the corner nearer to it, so a run between an outer and an inner
' corner steps across its edge halfway along.
FUNC roomWalls(r AS Room, width AS Integer) AS List OF Placed
  MUT out AS List OF Placed = []
  FOR y = r.y TO r.y + r.h - 1
    FOR x = r.x TO r.x + r.w - 1
      IF inRoom(r, x, y) THEN
        FOR EACH e IN compass()
          IF NOT inRoom(r, x + stepX(e), y + stepY(e)) THEN
            LET t AS Facing = facingOf(facingIndex(e) + 1)
            LET u AS Facing = opposite(t)
            ' How many more edges the run has each way, and how it ends.
            MUT ahead AS Integer = 0
            MUT ax AS Integer = x
            MUT ay AS Integer = y
            DO WHILE inRoom(r, ax + stepX(t), ay + stepY(t)) AND NOT inRoom(r, ax + stepX(t) + stepX(e), ay + stepY(t) + stepY(e))
              ax = ax + stepX(t)
              ay = ay + stepY(t)
              ahead = ahead + 1
            LOOP
            LET aheadOutward AS Boolean = NOT inRoom(r, ax + stepX(t), ay + stepY(t))
            MUT behind AS Integer = 0
            MUT bx AS Integer = x
            MUT by AS Integer = y
            DO WHILE inRoom(r, bx + stepX(u), by + stepY(u)) AND NOT inRoom(r, bx + stepX(u) + stepX(e), by + stepY(u) + stepY(e))
              bx = bx + stepX(u)
              by = by + stepY(u)
              behind = behind + 1
            LOOP
            LET behindOutward AS Boolean = NOT inRoom(r, bx + stepX(u), by + stepY(u))
            LET k AS Integer = y * width + x
            LET beyond AS Integer = k + stepY(e) * width + stepX(e)
            ' The corner where this edge's run ends ahead - each corner is the
            ' end ahead of exactly one edge.
            IF ahead = 0 AND aheadOutward THEN out = collections::append(out, Placed[k, cornerOn(e, t)])
            IF ahead = 0 AND NOT aheadOutward THEN out = collections::append(out, Placed[beyond, cornerOn(opposite(e), t)])
            ' This edge's own piece, unless a corner at one end of it has it.
            IF ahead > 0 AND behind > 0 THEN
              MUT inRoomSide AS Boolean = aheadOutward
              IF behind < ahead THEN inRoomSide = behindOutward
              IF inRoomSide THEN
                out = collections::append(out, Placed[k, wallOn(e)])
              ELSE
                out = collections::append(out, Placed[beyond, wallOn(opposite(e))])
              END IF
            END IF
          END IF
        NEXT
      END IF
    NEXT
  NEXT
  RETURN out
END FUNC

FUNC wallsAt(d AS Dig, x AS Integer, y AS Integer) AS List OF Piece
  LET none AS List OF Piece = []
  RETURN collections::getOr(d.walls, y * d.width + x, none)
END FUNC

' Whether some piece in the list stands on the given edge.
FUNC covers(pieces AS List OF Piece, edge AS Facing) AS Boolean
  FOR EACH p IN pieces
    IF blocksEdge(p, edge) THEN RETURN TRUE
  NEXT
  RETURN FALSE
END FUNC

' Where a door can go in room r's wall on the given side: a plain wall piece
' standing in the room, with the room's wall carrying on in line either side
' of it on the same side of the edge. That keeps doors out of corners and off
' a step, and puts the room's wall where a hall's walls can meet it flush.
FUNC doorPlaces(d AS Dig, r AS Room, edge AS Facing) AS List OF Door
  LET t AS Facing = facingOf(facingIndex(edge) + 1)
  MUT out AS List OF Door = []
  FOR y = r.y TO r.y + r.h - 1
    FOR x = r.x TO r.x + r.w - 1
      IF inRoom(r, x, y) AND NOT inRoom(r, x + stepX(edge), y + stepY(edge)) THEN
        MUT plain AS Boolean = FALSE
        FOR EACH p IN wallsAt(d, x, y)
          IF p.tile = "stoneWall" AND p.facing = opposite(edge) THEN plain = TRUE
        NEXT
        LET nx AS Integer = x + stepX(t)
        LET ny AS Integer = y + stepY(t)
        LET px AS Integer = x - stepX(t)
        LET py AS Integer = y - stepY(t)
        IF plain AND inRoom(r, nx, ny) AND inRoom(r, px, py) AND covers(wallsAt(d, nx, ny), edge) AND covers(wallsAt(d, px, py), edge) THEN
          out = collections::append(out, Door[x, y, edge])
        END IF
      END IF
    NEXT
  NEXT
  RETURN out
END FUNC

' The door's wall piece becomes an archway.
FUNC openDoor(d AS Dig, door AS Door) AS Dig
  MUT pieces AS List OF Piece = []
  FOR EACH p IN wallsAt(d, door.x, door.y)
    IF p.tile = "stoneWall" AND p.facing = opposite(door.edge) THEN
      pieces = collections::append(pieces, Piece["stoneWallArchway", p.facing])
    ELSE
      pieces = collections::append(pieces, p)
    END IF
  NEXT
  RETURN WITH d { walls := collections::set(d.walls, door.y * d.width + door.x, pieces) }
END FUNC

' A hall that fits, with its cells from door to door and its wall pieces, or
' ok = FALSE.
TYPE HallPlan
  ok AS Boolean
  cells AS List OF Integer
  walls AS List OF Placed
END TYPE

' A point on the grid.
TYPE Spot
  x AS Integer
  y AS Integer
END TYPE

FUNC isign(n AS Integer) AS Integer
  IF n < 0 THEN RETURN -1
  IF n > 0 THEN RETURN 1
  RETURN 0
END FUNC

' How far along direction f a spot is.
FUNC along(p AS Spot, f AS Facing) AS Integer
  RETURN p.x * stepX(f) + p.y * stepY(f)
END FUNC

' The spot `n` along direction f's axis, keeping p's other coordinate.
FUNC withAlong(p AS Spot, f AS Facing, n AS Integer) AS Spot
  IF stepX(f) <> 0 THEN RETURN Spot[n * stepX(f), p.y]
  RETURN Spot[p.x, n * stepY(f)]
END FUNC

' The direction from a to b, which must lie in a line.
FUNC directionTo(a AS Spot, b AS Spot) AS Facing
  IF b.x > a.x THEN RETURN Facing.East
  IF b.x < a.x THEN RETURN Facing.West
  IF b.y > a.y THEN RETURN Facing.South
  RETURN Facing.North
END FUNC

' A random whole number strictly between lo and hi, or lo when there is none.
FUNC between(lo AS Integer, hi AS Integer) AS Integer
  IF hi - lo < 2 THEN RETURN lo
  RETURN math::rand(lo + 1, hi - 1)
END FUNC

' The turning points of a hall that leaves s heading h1 and reaches t heading
' h2: straight or a Z when h2 = h1, a U when h2 is the way back, and an L or a
' three-bend staircase when h2 turns off h1. [s] alone means no shape fits.
FUNC hallShape(s AS Spot, t AS Spot, h1 AS Facing, h2 AS Facing) AS List OF Spot
  IF h2 = h1 THEN
    IF along(s, facingOf(facingIndex(h1) + 1)) = along(t, facingOf(facingIndex(h1) + 1)) THEN RETURN [s, t]
    LET m AS Integer = between(along(s, h1), along(t, h1))
    RETURN [s, withAlong(s, h1, m), withAlong(t, h1, m), t]
  END IF
  IF h2 = opposite(h1) THEN
    LET m AS Integer = math::max(along(s, h1), along(t, h1)) + math::rand(2, 5)
    RETURN [s, withAlong(s, h1, m), withAlong(t, h1, m), t]
  END IF
  LET corner AS Spot = withAlong(s, h1, along(t, h1))
  IF math::rand(0, 1) = 0 THEN RETURN [s, corner, t]
  LET m AS Integer = between(along(s, h1), along(t, h1))
  LET n AS Integer = between(along(s, h2), along(t, h2))
  LET first AS Spot = withAlong(s, h1, m)
  LET second AS Spot = withAlong(first, h2, n)
  RETURN [s, first, second, withAlong(second, h1, along(t, h1)), t]
END FUNC

' Plans a hall from door da to door db. Any shape of straight runs will do as
' long as each run is at least two cells long, not counting the bends, and the
' hall keeps to rock at least two cells from any room and three from any other
' hall, apart from the cells just outside its own doors, and clear of the rock
' holding a room's walls.
'
' The walls sit so every turn is one corner piece: round the outside of a bend
' the corner stands in the hall, and round the inside in the rock cell in the
' angle. Each straight run of wall takes the side of the corners at its ends;
' a run whose ends disagree - the middle of a Z - steps across its edge
' halfway along, which needs the run to have at least one piece of its own:
' hence the two cells.
FUNC planHall(d AS Dig, da AS Door, db AS Door) AS HallPlan
  LET noHall AS HallPlan = HallPlan[FALSE, [], []]
  LET h1 AS Facing = da.edge
  LET h2 AS Facing = opposite(db.edge)
  LET points AS List OF Spot = hallShape(Spot[da.x + stepX(h1), da.y + stepY(h1)], Spot[db.x + stepX(db.edge), db.y + stepY(db.edge)], h1, h2)
  LET legs AS Integer = len(points) - 1
  IF legs < 1 THEN RETURN noHall

  ' The direction of each run, which must start h1, end h2, and turn at every
  ' point in between.
  MUT dirs AS List OF Facing = []
  FOR i = 0 TO legs - 1
    LET a AS Spot = collections::get(points, i)
    LET b AS Spot = collections::get(points, i + 1)
    IF a.x <> b.x AND a.y <> b.y THEN RETURN noHall
    IF a.x = b.x AND a.y = b.y THEN
      ' Only a straight hall one cell long starts where it ends.
      IF legs > 1 THEN RETURN noHall
      dirs = collections::append(dirs, h1)
    ELSE
      dirs = collections::append(dirs, directionTo(a, b))
    END IF
  NEXT
  IF collections::get(dirs, 0) <> h1 OR collections::get(dirs, legs - 1) <> h2 THEN RETURN noHall
  FOR i = 1 TO legs - 1
    LET a AS Facing = collections::get(dirs, i - 1)
    LET b AS Facing = collections::get(dirs, i)
    IF b = a OR b = opposite(a) THEN RETURN noHall
  NEXT

  ' Each run's own cells: the cells from one point to the next, less the bends
  ' at either end. Every run needs at least two.
  MUT runs AS List OF List OF Integer = []
  MUT cells AS List OF Integer = []
  MUT onPath AS Map OF Integer TO Boolean = Map OF Integer TO Boolean {}
  FOR i = 0 TO legs - 1
    LET a AS Spot = collections::get(points, i)
    LET b AS Spot = collections::get(points, i + 1)
    LET dir AS Facing = collections::get(dirs, i)
    LET length AS Integer = iabs(b.x - a.x) + iabs(b.y - a.y)
    MUT run AS List OF Integer = []
    FOR n = 0 TO length
      LET k AS Integer = (a.y + n * stepY(dir)) * d.width + a.x + n * stepX(dir)
      IF NOT (n = 0 AND i > 0) THEN
        cells = collections::append(cells, k)
        onPath = collections::set(onPath, k, TRUE)
      END IF
      IF NOT (n = 0 AND i > 0) AND NOT (n = length AND i < legs - 1) THEN run = collections::append(run, k)
    NEXT
    IF len(run) < 2 THEN RETURN noHall
    runs = collections::append(runs, run)
  NEXT

  FOR n = 0 TO len(cells) - 1
    LET k AS Integer = collections::get(cells, n)
    LET x AS Integer = k MOD d.width
    LET y AS Integer = k / d.width
    IF x < 1 OR y < 1 OR x > d.width - 2 OR y > d.height - 2 THEN RETURN noHall
    IF groundAt(d, x, y) <> Ground.Rock THEN RETURN noHall
    LET atDoor AS Boolean = n = 0 OR n = len(cells) - 1
    FOR dy = -2 TO 2
      FOR dx = -2 TO 2
        IF NOT collections::getOr(onPath, (y + dy) * d.width + x + dx, FALSE) THEN
          LET g AS Ground = groundAt(d, x + dx, y + dy)
          LET near AS Boolean = iabs(dx) <= 1 AND iabs(dy) <= 1
          IF g = Ground.Hall THEN RETURN noHall
          IF g = Ground.RoomFloor AND near AND NOT atDoor THEN RETURN noHall
          ' Rock holding a room's wall, round the inside of a notch.
          IF g = Ground.Rock AND near AND len(wallsAt(d, x + dx, y + dy)) > 0 THEN RETURN noHall
        END IF
      NEXT
    NEXT
    ' The hall must not come back alongside itself.
    FOR m = n + 3 TO len(cells) - 1
      LET o AS Integer = collections::get(cells, m)
      IF iabs(o MOD d.width - x) <= 1 AND iabs(o / d.width - y) <= 1 THEN RETURN noHall
    NEXT
  NEXT

  MUT walls AS List OF Placed = []
  ' The corners at each bend, outside and inside.
  FOR i = 1 TO legs - 1
    LET a AS Facing = collections::get(dirs, i - 1)
    LET b AS Facing = collections::get(dirs, i)
    LET bend AS Spot = collections::get(points, i)
    LET k AS Integer = bend.y * d.width + bend.x
    LET inside AS Integer = k + (stepY(opposite(a)) + stepY(b)) * d.width + stepX(opposite(a)) + stepX(b)
    walls = collections::append(walls, [Placed[k, cornerOn(a, opposite(b))], Placed[inside, cornerOn(opposite(b), a)]])
  NEXT
  ' The straight walls along each side of each run. A side is the inside of a
  ' bend at one end when the hall turns toward it there; that end's cell is
  ' then the inner corner's, and the run's wall stands in the rock. Round the
  ' outside it stands in the hall. With no bend (at a door) either will do.
  FOR i = 0 TO legs - 1
    LET dir AS Facing = collections::get(dirs, i)
    LET run AS List OF Integer = collections::get(runs, i)
    FOR EACH side IN [facingOf(facingIndex(dir) - 1), facingOf(facingIndex(dir) + 1)]
      ' 0 no bend, 1 the wall is in the hall, 2 in the rock.
      MUT fromStart AS Integer = 0
      MUT fromEnd AS Integer = 0
      IF i > 0 THEN
        fromStart = 1
        IF side = opposite(collections::get(dirs, i - 1)) THEN fromStart = 2
      END IF
      IF i < legs - 1 THEN
        fromEnd = 1
        IF side = collections::get(dirs, i + 1) THEN fromEnd = 2
      END IF
      MUT first AS Integer = 0
      MUT last AS Integer = len(run) - 1
      IF fromStart = 2 THEN first = 1
      IF fromEnd = 2 THEN last = last - 1
      LET count AS Integer = last - first + 1
      LET out AS Integer = stepY(side) * d.width + stepX(side)
      FOR n = first TO last
        MUT where AS Integer = fromStart
        IF where = 0 OR (fromEnd <> 0 AND n - first >= (count + 1) / 2) THEN where = fromEnd
        LET k AS Integer = collections::get(run, n)
        IF where = 2 THEN
          walls = collections::append(walls, Placed[k + out, wallOn(opposite(side))])
        ELSE
          walls = collections::append(walls, Placed[k, wallOn(side)])
        END IF
      NEXT
    NEXT
  NEXT
  RETURN HallPlan[TRUE, cells, walls]
END FUNC

' Digs a hall between a door in room a and a door in room b, trying doors on
' different sides and places, and different shapes, until one fits. A pair of
' rooms nothing fits between is left unjoined.
FUNC joinRooms(d AS Dig, a AS Room, b AS Room) AS Dig
  FOR attempt = 1 TO 60
    LET e1 AS Facing = facingOf(math::rand(0, 3))
    LET e2 AS Facing = facingOf(facingIndex(e1) + math::rand(0, 3))
    LET fromA AS List OF Door = doorPlaces(d, a, e1)
    MUT fromB AS List OF Door = doorPlaces(d, b, e2)
    IF len(fromA) > 0 AND len(fromB) > 0 THEN
      LET da AS Door = collections::get(fromA, math::rand(0, len(fromA) - 1))
      IF e2 = opposite(e1) AND math::rand(0, 1) = 0 THEN
        ' Now and then line b's door up with a's, for a straight hall.
        MUT inLine AS List OF Door = []
        FOR EACH o IN fromB
          IF (stepX(e1) <> 0 AND o.y = da.y) OR (stepY(e1) <> 0 AND o.x = da.x) THEN inLine = collections::append(inLine, o)
        NEXT
        IF len(inLine) > 0 THEN fromB = inLine
      END IF
      LET db AS Door = collections::get(fromB, math::rand(0, len(fromB) - 1))
      LET dug AS Dig = tryHall(d, da, db)
      IF len(dug.doors) > len(d.doors) THEN RETURN dug
    END IF
  NEXT
  RETURN d
END FUNC

' Digs the hall planned between two doors, if one fits, opening both doors.
FUNC tryHall(d AS Dig, da AS Door, db AS Door) AS Dig
  LET plan AS HallPlan = planHall(d, da, db)
  IF plan.ok THEN
    MUT ground AS List OF Ground = d.ground
    FOR EACH k IN plan.cells
      ground = collections::set(ground, k, Ground.Hall)
    NEXT
    MUT walls AS Map OF Integer TO List OF Piece = d.walls
    LET none AS List OF Piece = []
    FOR EACH w IN plan.walls
      walls = collections::set(walls, w.cell, collections::append(collections::getOr(walls, w.cell, none), w.piece))
    NEXT
    RETURN openDoor(openDoor(WITH d { ground := ground, doors := collections::append(d.doors, [da, db]), walls := walls }, da), db)
  END IF
  RETURN d
END FUNC

' Puts room b's group into room a's.
FUNC mergeGroups(group AS List OF Integer, a AS Integer, b AS Integer) AS List OF Integer
  LET into AS Integer = collections::get(group, a)
  LET from AS Integer = collections::get(group, b)
  MUT out AS List OF Integer = []
  FOR EACH g IN group
    IF g = from THEN
      out = collections::append(out, into)
    ELSE
      out = collections::append(out, g)
    END IF
  NEXT
  RETURN out
END FUNC

' The other rooms' indexes, nearest to room i first.
FUNC nearestFirst(rooms AS List OF Room, i AS Integer) AS List OF Integer
  LET r AS Room = collections::get(rooms, i)
  MUT rest AS List OF Integer = []
  FOR j = 0 TO len(rooms) - 1
    IF j <> i THEN rest = collections::append(rest, j)
  NEXT
  MUT out AS List OF Integer = []
  DO WHILE len(rest) > 0
    MUT best AS Integer = 0
    MUT bestDistance AS Integer = -1
    FOR k = 0 TO len(rest) - 1
      LET o AS Room = collections::get(rooms, collections::get(rest, k))
      LET distance AS Integer = iabs(2 * o.x + o.w - 2 * r.x - r.w) + iabs(2 * o.y + o.h - 2 * r.y - r.h)
      IF bestDistance < 0 OR distance < bestDistance THEN
        best = k
        bestDistance = distance
      END IF
    NEXT
    out = collections::append(out, collections::get(rest, best))
    rest = collections::removeAt(rest, best)
  LOOP
  RETURN out
END FUNC

' A stone floor, now and then with tiles missing - more often in the halls.
FUNC floorPiece(g AS Ground) AS Piece
  MUT odds AS Integer = 20
  IF g = Ground.Hall THEN odds = 6
  IF math::rand(1, odds) = 1 THEN RETURN Piece["stoneMissingTiles", facingOf(math::rand(0, 3))]
  RETURN Piece["stone", facingOf(math::rand(0, 3))]
END FUNC

' The whole level for a seed: rooms - rectangles, Ls, Us and Ts - joined left
' to right by halls, with a few extra halls that skip a room, as nethack does,
' and some barrels and
' tables in the rooms. The same seed always gives the same level: a level
' that comes out invalid, or with a room that cannot be reached, is thrown
' away and the next one drawn from the same random sequence.
FUNC generateDungeon(seed AS Integer) AS DungeonMap
  math::seed(seed)
  MUT level AS Level = buildLevel()
  DO WHILE NOT (level.connected AND mapIsValid(level.map))
    level = buildLevel()
  LOOP
  RETURN level.map
END FUNC

' One attempt at a level, and whether every room could be joined to the first.
TYPE Level
  map AS DungeonMap
  connected AS Boolean
END TYPE

FUNC buildLevel AS Level
  LET width AS Integer = dungeonWidth()
  LET height AS Integer = dungeonHeight()
  LET rooms AS List OF Room = placeRooms(width, height)

  MUT ground AS List OF Ground = []
  FOR i = 1 TO width * height
    ground = collections::append(ground, Ground.Rock)
  NEXT
  LET none AS List OF Piece = []
  MUT walls AS Map OF Integer TO List OF Piece = Map OF Integer TO List OF Piece {}
  FOR EACH r IN rooms
    FOR y = r.y TO r.y + r.h - 1
      FOR x = r.x TO r.x + r.w - 1
        IF inRoom(r, x, y) THEN ground = collections::set(ground, y * width + x, Ground.RoomFloor)
      NEXT
    NEXT
    FOR EACH w IN roomWalls(r, width)
      walls = collections::set(walls, w.cell, collections::append(collections::getOr(walls, w.cell, none), w.piece))
    NEXT
  NEXT

  MUT d AS Dig = Dig[width, height, ground, [], walls]
  ' group(i) names the rooms room i is connected to so far.
  MUT group AS List OF Integer = []
  FOR i = 0 TO len(rooms) - 1
    group = collections::append(group, i)
  NEXT
  FOR i = 0 TO len(rooms) - 2
    LET before AS Integer = len(d.doors)
    d = joinRooms(d, collections::get(rooms, i), collections::get(rooms, i + 1))
    IF len(d.doors) > before THEN group = mergeGroups(group, i, i + 1)
  NEXT
  FOR i = 0 TO len(rooms) - 3
    IF math::rand(0, 1) = 0 THEN
      LET before AS Integer = len(d.doors)
      d = joinRooms(d, collections::get(rooms, i), collections::get(rooms, i + 2))
      IF len(d.doors) > before THEN group = mergeGroups(group, i, i + 2)
    END IF
  NEXT

  ' A pair of rooms with no hall between them can leave rooms cut off. Join
  ' each of them to the nearest room already reachable from the first, until
  ' nothing more connects.
  MUT progress AS Boolean = TRUE
  DO WHILE progress
    progress = FALSE
    FOR i = 1 TO len(rooms) - 1
      IF collections::get(group, i) <> collections::get(group, 0) THEN
        FOR EACH j IN nearestFirst(rooms, i)
          IF collections::get(group, i) <> collections::get(group, 0) AND collections::get(group, j) = collections::get(group, 0) THEN
            LET before AS Integer = len(d.doors)
            d = joinRooms(d, collections::get(rooms, j), collections::get(rooms, i))
            IF len(d.doors) > before THEN
              group = mergeGroups(group, j, i)
              progress = TRUE
            END IF
          END IF
        NEXT
      END IF
    NEXT
  LOOP

  MUT cells AS List OF Cell = []
  FOR y = 0 TO height - 1
    FOR x = 0 TO width - 1
      LET g AS Ground = groundAt(d, x, y)
      IF g = Ground.Rock THEN
        cells = collections::append(cells, Cell[Piece["", Facing.North], wallsAt(d, x, y), []])
      ELSE
        cells = collections::append(cells, Cell[floorPiece(g), wallsAt(d, x, y), []])
      END IF
    NEXT
  NEXT

  ' The player starts in the cell of the leftmost room nearest the middle of
  ' its box.
  LET first AS Room = collections::get(rooms, 0)
  MUT startX AS Integer = -1
  MUT startY AS Integer = -1
  FOR y = first.y TO first.y + first.h - 1
    FOR x = first.x TO first.x + first.w - 1
      LET off AS Integer = iabs(2 * (x - first.x) + 1 - first.w) + iabs(2 * (y - first.y) + 1 - first.h)
      IF inRoom(first, x, y) AND (startX < 0 OR off < iabs(2 * (startX - first.x) + 1 - first.w) + iabs(2 * (startY - first.y) + 1 - first.h)) THEN
        startX = x
        startY = y
      END IF
    NEXT
  NEXT

  ' Up to two props per room, only where every cell round them is the room's -
  ' the cells along the walls, which all the doors open onto, stay clear and
  ' joined - and never on the start.
  FOR EACH r IN rooms
    FOR i = 1 TO math::rand(0, 2)
      LET x AS Integer = math::rand(r.x, r.x + r.w - 1)
      LET y AS Integer = math::rand(r.y, r.y + r.h - 1)
      MUT open AS Boolean = TRUE
      FOR dy = -1 TO 1
        FOR dx = -1 TO 1
          IF NOT inRoom(r, x + dx, y + dy) THEN open = FALSE
        NEXT
      NEXT
      MUT tile AS String = "barrel"
      IF math::rand(0, 1) = 0 THEN tile = "tableShort"
      LET prop AS Piece = Piece[tile, facingOf(math::rand(0, 3))]
      LET c AS Cell = collections::get(cells, y * width + x)
      IF open AND len(c.props) = 0 AND NOT (x = startX AND y = startY) THEN
        cells = collections::set(cells, y * width + x, WITH c { props := [prop] })
      END IF
    NEXT
  NEXT

  MUT connected AS Boolean = TRUE
  FOR EACH g IN group
    IF g <> collections::get(group, 0) THEN connected = FALSE
  NEXT
  RETURN Level[DungeonMap[width, height, cells, startX, startY], connected]
END FUNC

' ---------------------------------------------------------------------------
' Validity
' ---------------------------------------------------------------------------

' One end of a wall piece's edge, at a grid point: which piece, which edge,
' whether the edge runs across (West to East) or down, which side of the edge
' the piece's slab lies on, and which way the edge leaves the point.
TYPE Touch
  piece AS Integer
  edge AS Integer
  across AS Boolean
  side AS Facing
  away AS Facing
  archway AS Boolean
END TYPE

' The edges a wall piece stands on.
FUNC pieceEdges(p AS Piece) AS List OF Facing
  IF p.tile = "stoneWallCorner" THEN RETURN [opposite(p.facing), opposite(facingOf(facingIndex(p.facing) - 1))]
  RETURN [opposite(p.facing)]
END FUNC

' Whether the tiles can draw the map's walls. Each grid point may have:
'   - no wall, or one wall ending there;
'   - two edges in a line - with their slabs on the same side, or stepping
'     across the line between two wall pieces, as the middle of a Z hall does,
'     but never at an archway;
'   - two edges at a right angle that are one corner piece;
'   - three edges: two in a line with their slabs on the same side, and a third
'     meeting them from the other side, flush against the slabs - where a
'     hall's wall meets a room's.
' Anything else - two pieces on one edge, a turn made of two pieces, a wall
' running into another's slab, four edges - is invalid.
FUNC mapIsValid(m AS DungeonMap) AS Boolean
  ' Grid point (gx, gy) is the top-left corner of cell (gx, gy); there are
  ' (width + 1) x (height + 1) of them.
  LET across AS Integer = m.width + 1
  MUT touches AS Map OF Integer TO List OF Touch = Map OF Integer TO List OF Touch {}
  LET none AS List OF Touch = []
  MUT piece AS Integer = 0
  FOR y = 0 TO m.height - 1
    FOR x = 0 TO m.width - 1
      FOR EACH w IN cellAt(m, x, y).walls
        piece = piece + 1
        FOR EACH edge IN pieceEdges(w)
          ' The edge's two ends: (ax, ay) the top or left one.
          MUT ax AS Integer = x
          MUT ay AS Integer = y
          MUT bx AS Integer = x + 1
          MUT by AS Integer = y
          IF edge = Facing.East THEN
            ax = x + 1
            by = y + 1
          ELSEIF edge = Facing.South THEN
            ay = y + 1
            by = y + 1
          ELSEIF edge = Facing.West THEN
            bx = x
            by = y + 1
          END IF
          LET isAcross AS Boolean = ay = by
          MUT edgeId AS Integer = (ay * across + ax) * 2
          MUT fromA AS Facing = Facing.East
          MUT fromB AS Facing = Facing.West
          IF NOT isAcross THEN
            edgeId = edgeId + 1
            fromA = Facing.South
            fromB = Facing.North
          END IF
          LET atA AS Integer = ay * across + ax
          LET atB AS Integer = by * across + bx
          touches = collections::set(touches, atA, collections::append(collections::getOr(touches, atA, none), Touch[piece, edgeId, isAcross, opposite(edge), fromA, w.tile = "stoneWallArchway"]))
          touches = collections::set(touches, atB, collections::append(collections::getOr(touches, atB, none), Touch[piece, edgeId, isAcross, opposite(edge), fromB, w.tile = "stoneWallArchway"]))
        NEXT
      NEXT
    NEXT
  NEXT

  FOR EACH point IN collections::keys(touches)
    LET here AS List OF Touch = collections::get(touches, point)
    IF len(here) > 3 THEN RETURN FALSE
    FOR i = 0 TO len(here) - 2
      FOR j = i + 1 TO len(here) - 1
        IF collections::get(here, i).edge = collections::get(here, j).edge THEN RETURN FALSE
      NEXT
    NEXT
    IF len(here) = 2 THEN
      LET a AS Touch = collections::get(here, 0)
      LET b AS Touch = collections::get(here, 1)
      IF a.across = b.across AND a.side <> b.side AND (a.archway OR b.archway) THEN RETURN FALSE
      IF a.across <> b.across AND a.piece <> b.piece THEN RETURN FALSE
    END IF
    IF len(here) = 3 THEN
      ' The stem is the one edge that runs the other way from the other two.
      MUT stem AS Integer = 0
      FOR i = 0 TO 2
        MUT same AS Integer = 0
        FOR j = 0 TO 2
          IF collections::get(here, j).across = collections::get(here, i).across THEN same = same + 1
        NEXT
        IF same = 1 THEN stem = i
      NEXT
      LET t AS Touch = collections::get(here, stem)
      LET a AS Touch = collections::get(here, (stem + 1) MOD 3)
      LET b AS Touch = collections::get(here, (stem + 2) MOD 3)
      IF a.side <> b.side OR t.away = a.side THEN RETURN FALSE
    END IF
  NEXT
  RETURN TRUE
END FUNC

' ---------------------------------------------------------------------------
' Movement
' ---------------------------------------------------------------------------

' Whether the player can step from (x, y) one cell toward dir: onto a floor
' with nothing standing on it, through no wall.
FUNC canMove(m AS DungeonMap, x AS Integer, y AS Integer, dir AS Facing) AS Boolean
  LET nx AS Integer = x + stepX(dir)
  LET ny AS Integer = y + stepY(dir)
  IF nx < 0 OR ny < 0 OR nx >= m.width OR ny >= m.height THEN RETURN FALSE
  LET there AS Cell = cellAt(m, nx, ny)
  IF there.floor.tile = "" OR len(there.props) > 0 THEN RETURN FALSE
  FOR EACH w IN cellAt(m, x, y).walls
    IF blocksEdge(w, dir) THEN RETURN FALSE
  NEXT
  FOR EACH w IN there.walls
    IF blocksEdge(w, opposite(dir)) THEN RETURN FALSE
  NEXT
  RETURN TRUE
END FUNC

' ---------------------------------------------------------------------------
' Rotation
' ---------------------------------------------------------------------------

' The file suffix for a piece facing f once the view is turned `turns`
' quarter turns clockwise.
FUNC suffixFor(f AS Facing, turns AS Integer) AS String
  LET i AS Integer = facingIndex(facingOf(facingIndex(f) + turns))
  IF i = 0 THEN RETURN "N"
  IF i = 1 THEN RETURN "E"
  IF i = 2 THEN RETURN "S"
  RETURN "W"
END FUNC

' The map direction that shows on screen as view direction v.
FUNC mapDirection(v AS Facing, turns AS Integer) AS Facing
  RETURN facingOf(facingIndex(v) - turns)
END FUNC

' On screen the cell's back edges are the ones an East- and a South-facing
' wall stand on. A wall on either front edge covers what is in the cell, and so
' does every corner but the South-facing one, which stands on both back edges.
FUNC isFrontWall(w AS Piece, turns AS Integer) AS Boolean
  LET s AS String = suffixFor(w.facing, turns)
  IF w.tile = "stoneWallCorner" THEN RETURN s <> "S"
  RETURN s = "N" OR s = "W"
END FUNC

' A cell in view coordinates, where the map lands once it is turned `turns`
' quarter turns clockwise, alongside the map cell it shows.
TYPE ViewCell
  x AS Integer
  y AS Integer
  mapX AS Integer
  mapY AS Integer
END TYPE

' Each turn sends (x, y) in a w x h map to (h - 1 - y, x) in an h x w one.
FUNC toView(m AS DungeonMap, mapX AS Integer, mapY AS Integer, turns AS Integer) AS ViewCell
  MUT x AS Integer = mapX
  MUT y AS Integer = mapY
  MUT w AS Integer = m.width
  MUT h AS Integer = m.height
  FOR i = 1 TO turns
    LET nx AS Integer = h - 1 - y
    y = x
    x = nx
    LET nw AS Integer = h
    h = w
    w = nw
  NEXT
  RETURN ViewCell[x, y, mapX, mapY]
END FUNC

' The inverse of toView: each turn back sends (x, y) in a w x h view to
' (y, w - 1 - x) in an h x w one.
FUNC fromView(m AS DungeonMap, viewX AS Integer, viewY AS Integer, turns AS Integer) AS ViewCell
  MUT x AS Integer = viewX
  MUT y AS Integer = viewY
  MUT w AS Integer = m.width
  MUT h AS Integer = m.height
  IF turns MOD 2 = 1 THEN
    w = m.height
    h = m.width
  END IF
  FOR i = 1 TO turns
    LET nx AS Integer = y
    y = w - 1 - x
    x = nx
    LET nw AS Integer = h
    h = w
    w = nw
  NEXT
  RETURN ViewCell[viewX, viewY, x, y]
END FUNC

' ---------------------------------------------------------------------------
' Tiles
' ---------------------------------------------------------------------------

FUNC tileWidth AS Float
  RETURN 256.0
END FUNC

FUNC tileHeight AS Float
  RETURN 512.0
END FUNC

' The top of the tallest piece (a corner) sits this far down its sprite.
FUNC tileTop AS Float
  RETURN 224.0
END FUNC

' The centre of the floor's top face in the sprite.
FUNC floorCentreY AS Float
  RETURN 428.0
END FUNC

' Every sprite the map names, keyed by file name without ".png".
FUNC loadTiles(names AS List OF String) AS Map OF String TO RES canvas::Image
  MUT tiles AS Map OF String TO RES canvas::Image = Map OF String TO RES canvas::Image {}
  FOR EACH name IN names
    FOR EACH suffix IN ["N", "E", "S", "W"]
      LET key AS String = name & "_" & suffix
      RES img AS canvas::Image = canvas::loadImage(os::resourcePath("dungeon/" & key & ".png"))
      tiles = collections::set(tiles, key, img)
    NEXT
  NEXT
  RETURN tiles
END FUNC

' ---------------------------------------------------------------------------
' The scene
' ---------------------------------------------------------------------------

' Where the map sits on the window: the scale, the screen position of view
' cell (0, 0)'s sprite, the turn, the view's size in cells and the window's in
' pixels.
TYPE View
  scale AS Float
  originX AS Float
  originY AS Float
  turns AS Integer
  columns AS Integer
  rows AS Integer
  winW AS Float
  winH AS Float
END TYPE

' About eight cells across the window, centred on the player.
FUNC viewFor(m AS DungeonMap, turns AS Integer, size AS canvas::Size, px AS Integer, py AS Integer) AS View
  LET winW AS Float = toFloat(size.width)
  LET winH AS Float = toFloat(size.height)
  LET s AS Float = winW / (tileWidth() * 8.0)
  LET halfW AS Float = tileWidth() / 2.0 * s
  LET halfH AS Float = tileWidth() / 4.0 * s
  LET p AS ViewCell = toView(m, px, py, turns)
  LET ox AS Float = winW / 2.0 - toFloat(p.x - p.y) * halfW - halfW
  LET oy AS Float = winH / 2.0 - toFloat(p.x + p.y) * halfH - floorCentreY() * s
  MUT columns AS Integer = m.width
  MUT rows AS Integer = m.height
  IF turns MOD 2 = 1 THEN
    columns = m.height
    rows = m.width
  END IF
  RETURN View[s, ox, oy, turns, columns, rows, winW, winH]
END FUNC

' The cells whose sprites reach the window, back to front: by x + y in view
' coordinates.
FUNC visibleOrder(m AS DungeonMap, v AS View) AS List OF ViewCell
  LET halfW AS Float = tileWidth() / 2.0 * v.scale
  LET halfH AS Float = tileWidth() / 4.0 * v.scale
  MUT out AS List OF ViewCell = []
  FOR depth = 0 TO v.columns + v.rows - 2
    LET top AS Float = v.originY + toFloat(depth) * halfH
    IF top + tileHeight() * v.scale > 0.0 AND top + tileTop() * v.scale < v.winH THEN
      FOR x = math::max(0, depth - v.rows + 1) TO math::min(v.columns - 1, depth)
        LET left AS Float = v.originX + toFloat(2 * x - depth) * halfW
        IF left + tileWidth() * v.scale > 0.0 AND left < v.winW THEN
          out = collections::append(out, fromView(m, x, depth - x, v.turns))
        END IF
      NEXT
    END IF
  NEXT
  RETURN out
END FUNC

FUNC spriteX(v AS View, c AS ViewCell) AS Float
  RETURN v.originX + toFloat(c.x - c.y) * tileWidth() / 2.0 * v.scale
END FUNC

FUNC spriteY(v AS View, c AS ViewCell) AS Float
  RETURN v.originY + toFloat(c.x + c.y) * tileWidth() / 4.0 * v.scale
END FUNC

FUNC sprite(tiles AS Map OF String TO RES canvas::Image, v AS View, c AS ViewCell, p AS Piece) AS canvas::DrawItem
  RES img AS canvas::Image = collections::get(tiles, p.tile & "_" & suffixFor(p.facing, v.turns))
  RETURN canvas::Picture[x := spriteX(v, c), y := spriteY(v, c), w := tileWidth() * v.scale, h := tileHeight() * v.scale, image := img, paint := canvas::fill(color::rgb(255, 255, 255))]
END FUNC

' The player: a red pawn with a shadow, standing in the middle of its cell.
FUNC playerFigure(v AS View, c AS ViewCell) AS List OF canvas::DrawItem
  LET s AS Float = v.scale
  LET cx AS Float = spriteX(v, c) + tileWidth() / 2.0 * s
  LET cy AS Float = spriteY(v, c) + floorCentreY() * s
  RETURN [canvas::Ellipse[x := cx, y := cy, radiusX := 44.0 * s, radiusY := 22.0 * s, angle := 0.0, paint := canvas::fill(color::rgba(0, 0, 0, 110))], canvas::Ellipse[x := cx, y := cy - 40.0 * s, radiusX := 30.0 * s, radiusY := 44.0 * s, angle := 0.0, paint := canvas::fill(color::rgb(190, 40, 36))], canvas::Circle[x := cx, y := cy - 100.0 * s, radius := 24.0 * s, paint := canvas::fill(color::rgb(236, 196, 160))]]
END FUNC

' Whether a wall piece would hide the player, who stands in view cell p: a
' front wall of the player's own cell, or a wall of the cell just in front
' standing on the edge it shares with the player's cell. Those are left out.
FUNC hidesPlayer(w AS Piece, c AS ViewCell, p AS ViewCell, turns AS Integer) AS Boolean
  IF c.x = p.x AND c.y = p.y THEN RETURN isFrontWall(w, turns)
  IF c.x = p.x + 1 AND c.y = p.y THEN RETURN blocksEdge(w, mapDirection(Facing.West, turns)) OR w.tile = "stoneWallArchway" AND suffixFor(w.facing, turns) = "E"
  IF c.x = p.x AND c.y = p.y + 1 THEN RETURN blocksEdge(w, mapDirection(Facing.North, turns)) OR w.tile = "stoneWallArchway" AND suffixFor(w.facing, turns) = "S"
  RETURN FALSE
END FUNC

' Floors first, so nothing standing on one cell is covered by the floor of the
' cell in front of it. Then cell by cell, back to front: the back walls, the
' props and the player, and the front walls.
FUNC sceneFor(m AS DungeonMap, tiles AS Map OF String TO RES canvas::Image, v AS View, px AS Integer, py AS Integer) AS List OF canvas::DrawItem
  LET order AS List OF ViewCell = visibleOrder(m, v)
  LET player AS ViewCell = toView(m, px, py, v.turns)
  MUT scene AS List OF canvas::DrawItem = []
  FOR EACH c IN order
    LET cell AS Cell = cellAt(m, c.mapX, c.mapY)
    IF cell.floor.tile <> "" THEN scene = collections::append(scene, sprite(tiles, v, c, cell.floor))
  NEXT
  FOR EACH c IN order
    LET cell AS Cell = cellAt(m, c.mapX, c.mapY)
    FOR EACH w IN cell.walls
      IF NOT isFrontWall(w, v.turns) AND NOT hidesPlayer(w, c, player, v.turns) THEN scene = collections::append(scene, sprite(tiles, v, c, w))
    NEXT
    FOR EACH p IN cell.props
      scene = collections::append(scene, sprite(tiles, v, c, p))
    NEXT
    IF c.x = player.x AND c.y = player.y THEN scene = collections::append(scene, playerFigure(v, c))
    FOR EACH w IN cell.walls
      IF isFrontWall(w, v.turns) AND NOT hidesPlayer(w, c, player, v.turns) THEN scene = collections::append(scene, sprite(tiles, v, c, w))
    NEXT
  NEXT
  RETURN scene
END FUNC

' ---------------------------------------------------------------------------
' Input
' ---------------------------------------------------------------------------

FUNC getChar AS String
  LET c AS String = io::readChar() TRAP(e)
    RECOVER ""
  END TRAP
  RETURN c
END FUNC

FUNC ready(ms AS Integer) AS Boolean
  LET r AS Boolean = io::pollInput(ms) TRAP(e)
    RECOVER FALSE
  END TRAP
  RETURN r
END FUNC

' One key press. A lone escape byte is the Esc key; an escape followed by more
' input is a key sequence, which is read off and reported as "" so it does
' nothing. "EOF" means the window closed.
FUNC readKey AS String
  LET c AS String = getChar()
  IF c = "" THEN RETURN "EOF"
  IF c <> "\u{1B}" THEN RETURN c
  IF NOT ready(30) THEN RETURN "ESC"
  DO WHILE ready(0)
    LET rest AS String = getChar()
    IF rest = "" THEN RETURN "EOF"
  LOOP
  RETURN ""
END FUNC

' The screen direction a movement key walks in, as a view direction: w is
' up-right, d down-right, s down-left and a up-left.
FUNC keyDirection(key AS String) AS Integer
  IF key = "w" OR key = "W" THEN RETURN 0
  IF key = "d" OR key = "D" THEN RETURN 1
  IF key = "s" OR key = "S" THEN RETURN 2
  IF key = "a" OR key = "A" THEN RETURN 3
  RETURN -1
END FUNC

' ---------------------------------------------------------------------------
' Main loop
' ---------------------------------------------------------------------------

FUNC main AS Integer
  app::setMode(app::Mode.Canvas)

  LET m AS DungeonMap = generateDungeon(10)
  LET tiles AS Map OF String TO RES canvas::Image = loadTiles(["stone", "stoneMissingTiles", "stoneWall", "stoneWallArchway", "stoneWallCorner", "barrel", "tableShort"]) TRAP(e)
    io::printError("dungeon: cannot load the tiles: " & e.message)
    RETURN 1
  END TRAP

  MUT px AS Integer = m.startX
  MUT py AS Integer = m.startY
  MUT turns AS Integer = 0
  MUT redraw AS Boolean = TRUE
  MUT running AS Boolean = TRUE
  DO WHILE running
    IF canvas::didResize() THEN redraw = TRUE
    IF redraw THEN
      canvas::present(sceneFor(m, tiles, viewFor(m, turns, canvas::getSize(), px, py), px, py))
      redraw = FALSE
    END IF

    IF ready(16) THEN
      LET key AS String = readKey()
      LET move AS Integer = keyDirection(key)
      IF move >= 0 THEN
        LET dir AS Facing = mapDirection(facingOf(move), turns)
        IF canMove(m, px, py, dir) THEN
          px = px + stepX(dir)
          py = py + stepY(dir)
          redraw = TRUE
        END IF
      ELSEIF key = "q" OR key = "Q" THEN
        turns = (turns + 3) MOD 4
        redraw = TRUE
      ELSEIF key = "e" OR key = "E" THEN
        turns = (turns + 1) MOD 4
        redraw = TRUE
      ELSEIF key = "ESC" OR key = "EOF" THEN
        running = FALSE
      END IF
    END IF
  LOOP
  RETURN 0
END FUNC
