' Key-reading helper for the dungeon game.
'
' Kept in its own file (rather than inline in main.mfb) so
' tools/dungeon-key-probe can build the REAL function below directly — a
' byte-for-byte copy of this exact file, checked before every build — instead
' of a hand-maintained or extracted copy that could drift out of sync with what
' dungeon actually ships.

IMPORT errorCode
IMPORT io

' The next key within `ms` milliseconds: "ESC" for Escape, the text any other
' key types, "" when no key came in time (or the key was a release, or typed
' nothing), and "EOF" once the window has closed. io::readKey itself skips a
' malformed (non-UTF-8) input byte, so one can never read as end of input.
FUNC nextKey(ms AS Integer) AS String
  LET k AS io::Key = io::readKey(ms) TRAP(e)
    IF e.code = errorCode::ErrTimeout THEN RETURN ""
    IF e.code = errorCode::ErrEndOfFile THEN RETURN "EOF"
    PROPAGATE
  END TRAP
  IF k.event = io::KeyEvent.Release THEN RETURN ""
  IF k.key = io::KeyName.Escape THEN RETURN "ESC"
  RETURN k.grapheme
END FUNC
