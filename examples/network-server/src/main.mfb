' network-server — one server, three transports.
'
' Pick a transport on the command line. The program binds a local port, gives
' every connection a UUID, greets it, and then broadcasts a per-connection
' counter to everyone still attached, every 500 ms:
'
'   $ network-server --tcp
'   $ network-server --udp
'   $ network-server --tls certs/cert.pem certs/key.pem
'
' It writes one line to standard output per connection lifecycle event:
'
'   Connected <uuid>       a client attached
'   Disconnect <uuid>      a client detached
'
' and sends each client a line-oriented, "\n"-terminated UTF-8 stream:
'
'   Hello <uuid>           once, on connect
'   Update <uuid> NN       every 500 ms; NN counts from 01 for that connection
'
' A client detaches by closing the stream (TCP and TLS) or by sending the line
' "BYE" (any transport). UDP has no close to observe, so "BYE" — or fifteen
' seconds of silence — is the only signal there. examples/network-client is the
' matching client and speaks exactly this protocol.
'
' By default the whole server is a single thread running one polling loop: it
' admits every queued connection, drains what each client sent, then broadcasts
' on the tick.
'
' With --thread (--tcp and --tls only) the work is split instead: this thread
' does nothing but accept, and every accepted socket is handed to a worker over
' the thread resource channel. The worker assigns the UUID, greets, ticks and
' reports — the whole session, off the main thread. The socket itself moves, so
' only one thread can ever touch a given connection; for TLS the handshake still
' completes here and the live session travels intact.
'
' --udp rejects --thread: a UDP server has one bound socket shared by every
' peer, so there is no per-connection handle to hand over.

IMPORT collections
IMPORT crypto
IMPORT datetime
IMPORT io
IMPORT net
IMPORT os
IMPORT strings
IMPORT tcp
IMPORT thread
IMPORT tls
IMPORT udp

' The wire helpers and the tick/nap constants live in src/wire.mfb — the same
' code the --thread workers run, so both modes speak one wire format. They are
' PUBLIC, which is project-wide, so they are named here without a prefix.

' The argument at position i, or "" when the command line ended before it.
FUNC argAt(args AS List OF String, i AS Integer) AS String
  RETURN collections::getOr(args, i, "")
END FUNC

' The index of a live peer with this "host:port" key, or -1. A retired key is
' skipped so a client that reconnects from a recycled source port is greeted as
' the new connection it is, with a fresh UUID.
FUNC liveIndexOf(keys AS List OF String, live AS List OF Boolean, key AS String) AS Integer
  FOR i = 0 TO len(keys) - 1
    IF collections::get(live, i) AND collections::get(keys, i) = key THEN
      RETURN i
    END IF
  NEXT
  RETURN -1
END FUNC

SUB usage()
  io::print("network-server — a broadcast server over TCP, UDP, or TLS.")
  io::print("")
  io::print("USAGE")
  io::print("  network-server --tcp [--host HOST] [--port PORT]")
  io::print("  network-server --udp [--host HOST] [--port PORT]")
  io::print("  network-server --tls CERT KEY [--host HOST] [--port PORT]")
  io::print("  ... any of the above, plus --thread (--tcp and --tls only)")
  io::print("")
  io::print("TRANSPORT (exactly one, and it is required)")
  io::print("  --tcp             Accept plaintext TCP streams.")
  io::print("  --udp             Serve UDP datagrams. A peer joins by sending any")
  io::print("                    datagram and leaves by sending BYE or falling silent.")
  io::print("  --tls CERT KEY    Terminate TLS. CERT is a PEM certificate chain, leaf")
  io::print("                    first; KEY is the matching unencrypted PEM private key.")
  io::print("")
  io::print("OPTIONS")
  io::print("  --host HOST       Local address to bind. Default 127.0.0.1;")
  io::print("                    0.0.0.0 binds every interface.")
  io::print("  --port PORT       Local port to bind. Default 7000; 0 lets the OS pick")
  io::print("                    one and the bound port is printed.")
  io::print("  --thread          Accept on the main thread, then hand each connection")
  io::print("                    to a worker thread that runs the whole session. Not")
  io::print("                    valid with --udp, which has no per-connection socket.")
  io::print("  --debug-counts    Print the live connection/peer count once per tick.")
  io::print("                    Not valid with --thread (the single-threaded loop only).")
  io::print("  --help            Show this text and exit.")
  io::print("")
  io::print("PROTOCOL")
  io::print("  server -> client  Hello <uuid>        once, on connect")
  io::print("  server -> client  Update <uuid> NN    every 500 ms")
  io::print("  client -> server  BYE                 asks the server to drop it")
  io::print("  Every line is UTF-8 and ends with a newline.")
  io::print("")
  io::print("EXAMPLE")
  io::print("  network-server --tls certs/cert.pem certs/key.pem --port 8443")
  io::print("  network-server --tcp --thread --port 7000")
END SUB

' ---------------------------------------------------------------------- TCP --

SUB serveTcp(host AS String, port AS Integer, debugCounts AS Boolean)
  RES server AS tcp::Listener = tcp::listen(host, port) TRAP(e)
    io::printError("Cannot listen on tcp " & host & ":" & toString(port) & " — " & e.message)
    EXIT PROGRAM 1
  END TRAP
  LET bound AS net::Address = tcp::localAddress(server)
  io::print("Listening tcp " & bound.host & ":" & toString(bound.port))

  ' One connection per index across four parallel lists rather than one list of
  ' a Conn record holding the socket and its state together: appending such a
  ' record to an owned list inside a loop fails to lower ("owned-list element
  ' type 'Conn' has no registered close op") — a compiler limitation, not a
  ' language one — so the per-connection state that travels with a socket lives
  ' beside it rather than inside it.
  MUT conns AS List OF RES tcp::Socket = []
  MUT ids AS List OF String = []
  MUT counts AS List OF Integer = []
  MUT live AS List OF Boolean = []
  MUT nextTick AS Integer = datetime::monotonicNanos() + tickNanos()

  DO
    ' 1. Admit every connection the kernel has already queued. accept(0) is one
    '    immediate attempt, so ErrTimeout means "none pending" and ends the drain.
    DO
      RES sock AS tcp::Socket = tcp::accept(server, 0) TRAP(e)
        EXIT DO
      END TRAP
      LET id AS String = crypto::uuid4()
      conns = collections::append(conns, sock)
      ids = collections::append(ids, id)
      counts = collections::append(counts, 0)
      live = collections::append(live, TRUE)
      ' Greeting after the append so the socket is owned by the list on every
      ' path. A greeting that fails is not fatal: the next sweep sees the broken
      ' connection and retires it through the ordinary disconnect path.
      tcp::write(sock, "Hello " & id & "\n") TRAP(e)
        RECOVER
      END TRAP
      io::print("Connected " & id)
    LOOP UNTIL FALSE

    ' 2. Drain whatever each client sent. A readable socket whose read raises is
    '    a closed peer (tcp::read reports end of stream as ErrConnectionClosed,
    '    never as an empty list), and "BYE" is an explicit goodbye. Any *other*
    '    read failure retires the connection too: poll has already said this
    '    socket will not block, so leaving it in the list would spin on it
    '    forever.
    FOR i = 0 TO len(conns) - 1
      IF collections::get(live, i) THEN
        RES sock AS tcp::Socket = collections::get(conns, i)
        MUT gone AS Boolean = FALSE
        IF tcp::poll(sock, 0) THEN
          LET chunk AS List OF Byte = tcp::read(sock, 4096) TRAP(e)
            gone = TRUE
            RECOVER []
          END TRAP
          IF hasBye(chunk) THEN
            gone = TRUE
          END IF
        END IF
        IF gone THEN
          io::print("Disconnect " & collections::get(ids, i))
          live = collections::set(live, i, FALSE)
          ' Release the descriptor now rather than at program exit. The list
          ' keeps the (closed) handle: a List OF RES owns its members, and
          ' lifting one back out would need an ownership move out of a
          ' collection that the language does not offer.
          tcp::close(sock) TRAP(e)
            RECOVER
          END TRAP
        END IF
      END IF
    NEXT

    ' 3. On the tick, send everyone still attached their next counter.
    IF datetime::monotonicNanos() >= nextTick THEN
      nextTick = nextTick + tickNanos()
      FOR i = 0 TO len(conns) - 1
        IF collections::get(live, i) THEN
          RES sock AS tcp::Socket = collections::get(conns, i)
          LET id AS String = collections::get(ids, i)
          LET n AS Integer = collections::get(counts, i) + 1
          counts = collections::set(counts, i, n)
          tcp::write(sock, "Update " & id & " " & counterText(n) & "\n") TRAP(e)
            io::print("Disconnect " & id)
            live = collections::set(live, i, FALSE)
            ' bug-705: the write-failure branch used to leave the fd open —
            ' the read-failure sweep four lines above already closes on its
            ' own disconnect path, so this one needs the same call.
            tcp::close(sock) TRAP(e2)
              RECOVER
            END TRAP
            RECOVER
          END TRAP
        END IF
      NEXT

      ' 4. Splice dead slots out of every parallel list (bug-705), backwards
      '    so an earlier removeAt never invalidates a not-yet-visited higher
      '    index. Every tick (not every nap): that is already the cadence at
      '    which live is authoritatively re-evaluated for broadcast, and
      '    without this splice every list grows by one per disconnect
      '    forever, doing O(all-time connections) work every tick.
      FOR i = len(live) - 1 TO 0 STEP -1
        IF NOT collections::get(live, i) THEN
          conns = collections::removeAt(conns, i)
          ids = collections::removeAt(ids, i)
          counts = collections::removeAt(counts, i)
          live = collections::removeAt(live, i)
        END IF
      NEXT

      IF debugCounts THEN
        io::print("DEBUG counts tcp conns=" & toString(len(conns)))
      END IF
    END IF

    os::sleep(napMs())
  LOOP UNTIL FALSE
END SUB

' ---------------------------------------------------------------------- TLS --

SUB serveTls(host AS String, port AS Integer, certPath AS String, keyPath AS String, debugCounts AS Boolean)
  RES server AS tls::Listener = tls::listen(host, port, certPath, keyPath) TRAP(e)
    io::printError("Cannot listen on tls " & host & ":" & toString(port) & " — " & e.message)
    EXIT PROGRAM 1
  END TRAP
  LET bound AS net::Address = tls::localAddress(server)
  io::print("Listening tls " & bound.host & ":" & toString(bound.port))

  MUT conns AS List OF RES tls::Socket = []
  MUT ids AS List OF String = []
  MUT counts AS List OF Integer = []
  MUT live AS List OF Boolean = []
  MUT nextTick AS Integer = datetime::monotonicNanos() + tickNanos()

  DO
    ' The budget is the whole remainder of the tick. It bounds the wait for a
    ' connection, which doubles as the loop's idle wait since accept returns the
    ' moment a client completes. tls::accept then gives the handshake the same
    ' budget again, so a client that connects late in the tick delays the tick
    ' while its handshake finishes instead of being cut off. Once too little of
    ' the tick is left to finish a handshake in, the accept is skipped, and a
    ' client that arrives inside that window waits in the kernel backlog for the
    ' next pass.
    DO
      LET budgetMs AS Integer = (nextTick - datetime::monotonicNanos()) / 1000000
      IF budgetMs < minHandshakeMs() THEN
        EXIT DO
      END IF
      RES sock AS tls::Socket = tls::accept(server, budgetMs) TRAP(e)
        EXIT DO
      END TRAP
      LET id AS String = crypto::uuid4()
      conns = collections::append(conns, sock)
      ids = collections::append(ids, id)
      counts = collections::append(counts, 0)
      live = collections::append(live, TRUE)
      tls::write(sock, "Hello " & id & "\n") TRAP(e)
        RECOVER
      END TRAP
      io::print("Connected " & id)
    LOOP UNTIL FALSE

    FOR i = 0 TO len(conns) - 1
      IF collections::get(live, i) THEN
        RES sock AS tls::Socket = collections::get(conns, i)
        MUT gone AS Boolean = FALSE
        IF tls::poll(sock, 0) THEN
          LET chunk AS List OF Byte = tls::read(sock, 4096) TRAP(e)
            gone = TRUE
            RECOVER []
          END TRAP
          IF hasBye(chunk) THEN
            gone = TRUE
          END IF
        END IF
        IF gone THEN
          io::print("Disconnect " & collections::get(ids, i))
          live = collections::set(live, i, FALSE)
          tls::close(sock) TRAP(e)
            RECOVER
          END TRAP
        END IF
      END IF
    NEXT

    IF datetime::monotonicNanos() >= nextTick THEN
      nextTick = nextTick + tickNanos()
      FOR i = 0 TO len(conns) - 1
        IF collections::get(live, i) THEN
          RES sock AS tls::Socket = collections::get(conns, i)
          LET id AS String = collections::get(ids, i)
          LET n AS Integer = collections::get(counts, i) + 1
          counts = collections::set(counts, i, n)
          tls::write(sock, "Update " & id & " " & counterText(n) & "\n") TRAP(e)
            io::print("Disconnect " & id)
            live = collections::set(live, i, FALSE)
            ' bug-705: see serveTcp's identical write-failure branch above.
            tls::close(sock) TRAP(e2)
              RECOVER
            END TRAP
            RECOVER
          END TRAP
        END IF
      NEXT

      ' bug-705: see serveTcp's identical splice step above.
      FOR i = len(live) - 1 TO 0 STEP -1
        IF NOT collections::get(live, i) THEN
          conns = collections::removeAt(conns, i)
          ids = collections::removeAt(ids, i)
          counts = collections::removeAt(counts, i)
          live = collections::removeAt(live, i)
        END IF
      NEXT

      IF debugCounts THEN
        io::print("DEBUG counts tls conns=" & toString(len(conns)))
      END IF
    END IF

    os::sleep(napMs())
  LOOP UNTIL FALSE
END SUB

' ---------------------------------------------------------------------- UDP --

SUB serveUdp(host AS String, port AS Integer, debugCounts AS Boolean)
  RES server AS udp::Socket = udp::bind(host, port) TRAP(e)
    io::printError("Cannot bind udp " & host & ":" & toString(port) & " — " & e.message)
    EXIT PROGRAM 1
  END TRAP
  LET bound AS net::Address = udp::localAddress(server)
  io::print("Listening udp " & bound.host & ":" & toString(bound.port))

  ' UDP has no connection, so one is invented: a peer is a source address, it
  ' joins by sending its first datagram, and it leaves by saying BYE or by
  ' falling silent for udpIdleNanos. net::Address is an ordinary value record,
  ' so unlike the stream servers above these lists hold no resources.
  MUT keys AS List OF String = []
  MUT peers AS List OF net::Address = []
  MUT ids AS List OF String = []
  MUT counts AS List OF Integer = []
  MUT live AS List OF Boolean = []
  MUT lastSeen AS List OF Integer = []
  MUT nextTick AS Integer = datetime::monotonicNanos() + tickNanos()

  DO
    ' 1. Drain the receive queue: register new peers, refresh known ones.
    DO WHILE udp::poll(server, 0)
      LET datagram AS udp::Datagram = udp::receive(server, 65535) TRAP(e)
        EXIT DO
      END TRAP
      LET now AS Integer = datetime::monotonicNanos()
      LET key AS String = datagram.from.host & ":" & toString(datagram.from.port)
      MUT idx AS Integer = liveIndexOf(keys, live, key)
      IF idx < 0 THEN
        ' bug-705: a UDP "connection" is invented purely from a source
        ' address, so admission needs a hard cap independent of the
        ' idle-eviction splice below — otherwise any party that can send from
        ' new source ports faster than udpIdleNanos() retires old ones grows
        ' these six lists without bound. A peer beyond the cap is refused
        ' (its first datagram is silently ignored); see maxUdpPeers().
        IF len(keys) < maxUdpPeers() THEN
          LET id AS String = crypto::uuid4()
          keys = collections::append(keys, key)
          peers = collections::append(peers, datagram.from)
          ids = collections::append(ids, id)
          counts = collections::append(counts, 0)
          live = collections::append(live, TRUE)
          lastSeen = collections::append(lastSeen, now)
          idx = len(keys) - 1
          udp::send(server, datagram.from, "Hello " & id & "\n") TRAP(e)
            RECOVER
          END TRAP
          io::print("Connected " & id)
        END IF
      ELSE
        lastSeen = collections::set(lastSeen, idx, now)
      END IF
      ' idx stays -1 for a refused-at-the-cap peer (no slot was created for
      ' it above) — nothing to mark dead in that case.
      IF idx >= 0 AND hasBye(datagram.bytes) THEN
        io::print("Disconnect " & collections::get(ids, idx))
        live = collections::set(live, idx, FALSE)
      END IF
    LOOP

    ' 2. Retire peers that have gone quiet.
    FOR i = 0 TO len(keys) - 1
      IF collections::get(live, i) THEN
        IF datetime::monotonicNanos() - collections::get(lastSeen, i) > udpIdleNanos() THEN
          io::print("Disconnect " & collections::get(ids, i))
          live = collections::set(live, i, FALSE)
        END IF
      END IF
    NEXT

    ' 3. On the tick, broadcast to everyone still attached.
    IF datetime::monotonicNanos() >= nextTick THEN
      nextTick = nextTick + tickNanos()
      FOR i = 0 TO len(keys) - 1
        IF collections::get(live, i) THEN
          LET id AS String = collections::get(ids, i)
          LET n AS Integer = collections::get(counts, i) + 1
          counts = collections::set(counts, i, n)
          udp::send(server, collections::get(peers, i), "Update " & id & " " & counterText(n) & "\n") TRAP(e)
            ' A refused datagram means the peer's port is gone (the host sent
            ' back ICMP port-unreachable), which is as close to a disconnect as
            ' UDP gets.
            io::print("Disconnect " & id)
            live = collections::set(live, i, FALSE)
            RECOVER
          END TRAP
        END IF
      NEXT

      ' bug-705: splice dead peers out of all six parallel lists — no fd to
      ' close here (one shared bound socket, net::Address holds no resource),
      ' but every disconnect path (BYE, idle retirement, a refused broadcast)
      ' still only flags live=FALSE, so without this the peer table only ever
      ' grows. Backwards so an earlier removeAt never invalidates a
      ' not-yet-visited higher index.
      FOR i = len(live) - 1 TO 0 STEP -1
        IF NOT collections::get(live, i) THEN
          keys = collections::removeAt(keys, i)
          peers = collections::removeAt(peers, i)
          ids = collections::removeAt(ids, i)
          counts = collections::removeAt(counts, i)
          live = collections::removeAt(live, i)
          lastSeen = collections::removeAt(lastSeen, i)
        END IF
      NEXT

      IF debugCounts THEN
        io::print("DEBUG counts udp keys=" & toString(len(keys)))
      END IF
    END IF

    os::sleep(napMs())
  LOOP UNTIL FALSE
END SUB

' ------------------------------------------------------- threaded transports --

' --thread: accept here, serve there.
'
' The main thread does nothing but bind and accept. Each accepted socket is
' handed to a worker over the thread resource channel, and from that moment the
' connection belongs entirely to the worker — it assigns the UUID, greets, ticks
' and reports. thread::transfer closes this end of the handle, so there is no
' window in which both threads can touch the same socket.
'
' One worker serves every connection rather than one worker per connection: it
' keeps the design to a single accept loop and a single worker loop no matter
' how many clients are attached, mirroring the single-threaded transport's one
' set of parallel lists instead of growing a list of worker handles alongside
' it.

SUB serveTcpThreaded(host AS String, port AS Integer)
  RES server AS tcp::Listener = tcp::listen(host, port) TRAP(e)
    io::printError("Cannot listen on tcp " & host & ":" & toString(port) & " — " & e.message)
    EXIT PROGRAM 1
  END TRAP
  LET bound AS net::Address = tcp::localAddress(server)
  io::print("Listening tcp " & bound.host & ":" & toString(bound.port) & " (threaded)")

  RES worker AS Thread OF RES tcp::Socket TO Integer = thread::start(serveTcpConnections, "tcp") TRAP(e)
    io::printError("Cannot start the connection worker — " & e.message)
    EXIT PROGRAM 1
  END TRAP

  DO
    RES sock AS tcp::Socket = tcp::accept(server) TRAP(e)
      CONTINUE DO
    END TRAP
    thread::transfer(worker, sock) TRAP(e)
      io::printError("Could not hand the connection to the worker — " & e.message)
      RECOVER
    END TRAP
  LOOP UNTIL FALSE
END SUB

SUB serveTlsThreaded(host AS String, port AS Integer, certPath AS String, keyPath AS String)
  RES server AS tls::Listener = tls::listen(host, port, certPath, keyPath) TRAP(e)
    io::printError("Cannot listen on tls " & host & ":" & toString(port) & " — " & e.message)
    EXIT PROGRAM 1
  END TRAP
  LET bound AS net::Address = tls::localAddress(server)
  io::print("Listening tls " & bound.host & ":" & toString(bound.port) & " (threaded)")

  RES worker AS Thread OF RES tls::Socket TO Integer = thread::start(serveTlsConnections, "tls") TRAP(e)
    io::printError("Cannot start the connection worker — " & e.message)
    EXIT PROGRAM 1
  END TRAP

  ' The handshake still completes here, on the main thread: tls::accept is the
  ' handshake. Only the finished session crosses to the worker. This is the
  ' only thread that ever accepts in --tls --thread mode, so the accept call
  ' is bounded (bug-704): an idle or hostile peer that never completes its
  ' handshake would otherwise park this thread forever, starving every other
  ' client queued behind it. A timed-out or failed handshake is treated like
  ' any other TRAP here — the loop just moves on to the next connection.
  DO
    RES sock AS tls::Socket = tls::accept(server, acceptHandshakeTimeoutMs()) TRAP(e)
      CONTINUE DO
    END TRAP
    thread::transfer(worker, sock) TRAP(e)
      io::printError("Could not hand the connection to the worker — " & e.message)
      RECOVER
    END TRAP
  LOOP UNTIL FALSE
END SUB

' --------------------------------------------------------------------- main --

SUB main()
  LET args AS List OF String = os::args()
  IF len(args) = 0 THEN
    usage()
    EXIT SUB
  END IF

  MUT mode AS String = ""
  MUT certPath AS String = ""
  MUT keyPath AS String = ""
  MUT host AS String = "127.0.0.1"
  MUT port AS Integer = 7000
  MUT threaded AS Boolean = FALSE
  MUT debugCounts AS Boolean = FALSE
  MUT i AS Integer = 0

  DO WHILE i < len(args)
    LET arg AS String = collections::get(args, i)
    IF arg = "--help" OR arg = "-h" THEN
      usage()
      EXIT SUB
    ELSEIF arg = "--tcp" THEN
      mode = "tcp"
      i = i + 1
    ELSEIF arg = "--udp" THEN
      mode = "udp"
      i = i + 1
    ELSEIF arg = "--tls" THEN
      mode = "tls"
      certPath = argAt(args, i + 1)
      keyPath = argAt(args, i + 2)
      IF certPath = "" OR keyPath = "" THEN
        io::printError("--tls needs a certificate path and a key path")
        EXIT PROGRAM 2
      END IF
      i = i + 3
    ELSEIF arg = "--thread" THEN
      threaded = TRUE
      i = i + 1
    ELSEIF arg = "--debug-counts" THEN
      debugCounts = TRUE
      i = i + 1
    ELSEIF arg = "--host" THEN
      host = argAt(args, i + 1)
      IF host = "" THEN
        io::printError("--host needs an address")
        EXIT PROGRAM 2
      END IF
      i = i + 2
    ELSEIF arg = "--port" THEN
      port = toInt(argAt(args, i + 1)) TRAP(e)
        io::printError("--port needs a number, not " & argAt(args, i + 1))
        EXIT PROGRAM 2
      END TRAP
      i = i + 2
    ELSE
      io::printError("Unknown argument: " & arg)
      io::printError("Run network-server --help for usage.")
      EXIT PROGRAM 2
    END IF
  LOOP

  IF mode = "" THEN
    io::printError("Pick a transport: --tcp, --udp, or --tls CERT KEY.")
    io::printError("Run network-server --help for usage.")
    EXIT PROGRAM 2
  END IF

  IF threaded AND mode = "udp" THEN
    io::printError("--thread does not apply to --udp: UDP has no per-connection")
    io::printError("socket to hand to a worker — every peer shares the one bound")
    io::printError("socket. Use --thread with --tcp or --tls.")
    EXIT PROGRAM 2
  END IF

  IF threaded AND debugCounts THEN
    io::printError("--debug-counts only applies to the single-threaded loop —")
    io::printError("serveTcpConnections/serveTlsConnections have no equivalent hook.")
    EXIT PROGRAM 2
  END IF

  io::print("Server " & toString(os::pid()) & " (Ctrl-C to stop)")

  IF mode = "tcp" THEN
    IF threaded THEN
      serveTcpThreaded(host, port)
    ELSE
      serveTcp(host, port, debugCounts)
    END IF
  ELSEIF mode = "udp" THEN
    serveUdp(host, port, debugCounts)
  ELSE
    IF threaded THEN
      serveTlsThreaded(host, port, certPath, keyPath)
    ELSE
      serveTls(host, port, certPath, keyPath, debugCounts)
    END IF
  END IF
END SUB
