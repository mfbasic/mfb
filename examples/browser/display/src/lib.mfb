' display — render a dom::Node to text.
'
'   render(node, width)  the readable page text, wrapped to width
'   tree(node, width)     an indented DOM tree (for a "raw" view)
'
' Both walk the tree iteratively with an explicit stack — a recursive function
' over the imported Node union does not lower to native code across a package
' boundary (see the browser README). Every MATCH on the imported (open) Node
' union carries a CASE ELSE, as the language requires.

IMPORT astrings
IMPORT color
IMPORT collections
IMPORT dom
IMPORT regex
IMPORT strings

FUNC maxOf(a AS Integer, b AS Integer) AS Integer
  IF a > b THEN RETURN a
  RETURN b
END FUNC

FUNC minOf(a AS Integer, b AS Integer) AS Integer
  IF a < b THEN RETURN a
  RETURN b
END FUNC

' Integer divide, rounding to nearest (half up). Used to map the DOM's CSS-px
' geometry down to terminal cells: a px length becomes round(px / glyphSize) cells.
FUNC divRound(a AS Integer, b AS Integer) AS Integer
  LET d AS Integer = maxOf(1, b)
  RETURN (a + d / 2) / d
END FUNC

' Tags that force a line break in the rendered text.
FUNC isBlock(name AS String) AS Boolean
  RETURN name = "p" OR name = "div" OR name = "br" OR name = "hr" OR name = "li" OR name = "ul" OR name = "ol" OR name = "tr" OR name = "table" OR name = "h1" OR name = "h2" OR name = "h3" OR name = "h4" OR name = "h5" OR name = "h6" OR name = "section" OR name = "article" OR name = "header" OR name = "footer" OR name = "nav" OR name = "aside" OR name = "main" OR name = "blockquote" OR name = "pre" OR name = "figure" OR name = "figcaption" OR name = "dl" OR name = "dd" OR name = "dt" OR name = "form"
END FUNC

' Tags whose subtree contributes nothing to the readable text.
FUNC skipTag(name AS String) AS Boolean
  RETURN name = "head" OR name = "script" OR name = "style" OR name = "noscript" OR name = "meta" OR name = "link" OR name = "title"
END FUNC

' Collapse whitespace runs and trim blank lines.
FUNC tidy(s AS String) AS String
  MUT t AS String = strings::replace(s, "\t", " ")
  t = strings::replace(t, "\r", "")
  t = regex::replace(t, " +", " ")
  t = regex::replace(t, " ?\n ?", "\n")
  t = regex::replace(t, "\n{3,}", "\n\n")
  RETURN strings::trim(t)
END FUNC

' Collapse a run to a single line (for the tree view's text/attr display).
FUNC collapse(s AS String) AS String
  MUT t AS String = strings::replace(s, "\n", " ")
  t = strings::replace(t, "\t", " ")
  t = strings::replace(t, "\r", " ")
  RETURN regex::replace(t, " +", " ")
END FUNC

' Truncate to `width` terminal columns (strings::displayWidth, not scalar
' count), appending an ellipsis when clipped. One column is reserved for the
' ellipsis and truncation breaks on whole graphemes, so wide CJK/emoji glyphs
' stay aligned and are never split.
FUNC clip(s AS String, width AS Integer) AS String
  IF strings::displayWidth(s) <= width THEN RETURN s
  LET limit AS Integer = maxOf(0, width - 1)
  MUT out AS String = ""
  MUT used AS Integer = 0
  FOR EACH g IN strings::graphemes(s)
    LET gw AS Integer = strings::displayWidth(g)
    IF used + gw > limit THEN EXIT FOR
    out = out & g
    used = used + gw
  NEXT
  RETURN out & "…"
END FUNC

' Word-wrap each newline-delimited line to `width` terminal columns, measuring
' by strings::displayWidth so a wide CJK/emoji glyph counts as two cells. A
' single word wider than `width` is left whole; the app's own hard-wrap breaks
' it on grapheme boundaries.
FUNC wrap(s AS String, width AS Integer) AS String
  LET w AS Integer = maxOf(1, width)
  MUT out AS List OF String = []
  FOR EACH line IN strings::split(s, "\n")
    IF strings::displayWidth(line) <= w THEN
      out = collections::append(out, line)
    ELSE
      MUT currentLine AS String = ""
      FOR EACH word IN strings::split(line, " ")
        IF currentLine = "" THEN
          currentLine = word
        ELSEIF strings::displayWidth(currentLine) + 1 + strings::displayWidth(word) <= w THEN
          currentLine = currentLine & " " & word
        ELSE
          out = collections::append(out, currentLine)
          currentLine = word
        END IF
      NEXT
      IF currentLine <> "" THEN
        out = collections::append(out, currentLine)
      END IF
    END IF
  NEXT
  RETURN strings::join(out, "\n")
END FUNC

' ----- 2D painting (consumes dom::Layout) -------------------------------------
'
' paint() renders the document by its computed geometry rather than as reflowed
' text: dom::updateLayout positions every element box and text run in CSS px for the
' given viewport, and paint maps each text run's px box down to terminal cells (via
' the glyph size) as it draws. Element boxes are invisible containers here (a text
' terminal has no backgrounds or borders), so the placed text is the whole picture —
' flex columns land side by side, padding indents, widths clip. The result is a
' `widthCols`-wide canvas, one String per page row, that the app scrolls a window
' over exactly like the reflowed-text lines.

' Collapse whitespace runs to single spaces and trim, matching how the layout pass
' measured the run (dom's collapseWs) so paint wraps to the same line count.
FUNC collapseRun(s AS String) AS String
  MUT t AS String = strings::replace(s, "\n", " ")
  t = strings::replace(t, "\t", " ")
  t = strings::replace(t, "\r", " ")
  MUT words AS List OF String = []
  FOR EACH w IN strings::split(t, " ")
    IF w <> "" THEN words = collections::append(words, w)
  NEXT
  RETURN strings::join(words, " ")
END FUNC

' The first `n` display columns of `s` (whole graphemes; a two-cell glyph that
' would straddle the cut is dropped, leaving the result up to one column short).
FUNC takeCols(s AS String, n AS Integer) AS String
  IF n <= 0 THEN RETURN ""
  IF strings::displayWidth(s) <= n THEN RETURN s
  MUT out AS String = ""
  MUT used AS Integer = 0
  FOR EACH g IN strings::graphemes(s)
    LET gw AS Integer = strings::displayWidth(g)
    IF used + gw > n THEN EXIT FOR
    out = out & g
    used = used + gw
  NEXT
  RETURN out
END FUNC

' Everything after the first `n` display columns of `s`.
FUNC dropCols(s AS String, n AS Integer) AS String
  IF n <= 0 THEN RETURN s
  MUT used AS Integer = 0
  MUT out AS String = ""
  MUT dropping AS Boolean = TRUE
  FOR EACH g IN strings::graphemes(s)
    IF dropping THEN
      used = used + strings::displayWidth(g)
      IF used >= n THEN
        dropping = FALSE
      END IF
    ELSE
      out = out & g
    END IF
  NEXT
  RETURN out
END FUNC

' Right-pad `s` with spaces to exactly `w` display columns (s must already fit).
FUNC padTo(s AS String, w AS Integer) AS String
  LET sw AS Integer = strings::displayWidth(s)
  IF sw >= w THEN RETURN s
  RETURN s & strings::repeat(" ", w - sw)
END FUNC

' Overlay `s` onto `base` starting at display column `x`, clipped to `width`.
FUNC overlay(base AS String, x AS Integer, s AS String, width AS Integer) AS String
  IF x >= width THEN RETURN base
  LET left AS String = padTo(takeCols(base, x), x)
  LET mid AS String = takeCols(s, width - x)
  LET after AS String = dropCols(base, x + strings::displayWidth(mid))
  RETURN takeCols(left & mid & after, width)
END FUNC

' Word-wrap a single collapsed run to `w` display columns, returning the lines. A
' word wider than `w` is left whole (drawn clipped). Mirrors dom's textHeight so
' the line count equals the box height the layout pass computed.
FUNC wrapRun(s AS String, w AS Integer) AS List OF String
  LET width AS Integer = maxOf(1, w)
  MUT out AS List OF String = []
  IF s = "" THEN RETURN out
  MUT cur AS String = ""
  MUT curW AS Integer = 0
  FOR EACH word IN strings::split(s, " ")
    LET ww AS Integer = strings::displayWidth(word)
    IF curW = 0 THEN
      cur = word
      curW = ww
    ELSEIF curW + 1 + ww <= width THEN
      cur = cur & " " & word
      curW = curW + 1 + ww
    ELSE
      out = collections::append(out, cur)
      cur = word
      curW = ww
    END IF
  NEXT
  IF curW > 0 THEN out = collections::append(out, cur)
  RETURN out
END FUNC

' The laid-out page height in terminal rows: the root element's px box height mapped
' down by the line height `linePx`.
FUNC pageHeight(root AS Node, linePx AS Integer) AS Integer
  MATCH root
    CASE ElementNode(e)
      RETURN divRound(e.layout.height, linePx)
    CASE ELSE
      RETURN 0
  END MATCH
END FUNC

' Draw one text run onto the canvas at its layout box.
' The column offset within a run's box for one wrapped line, honoring the run's
' horizontal alignment: left flush (0), centered, or right flush.
FUNC alignOffset(align AS Justify, boxWidth AS Integer, lineWidth AS Integer) AS Integer
  IF align = Justify.Center THEN RETURN maxOf(0, (boxWidth - lineWidth) / 2)
  IF align = Justify.FlexEnd THEN RETURN maxOf(0, boxWidth - lineWidth)
  RETURN 0
END FUNC

' ----- attribute plumbing -------------------------------------------------------
'
' paint returns AttributedString rows: the same positioned text as the plain canvas,
' plus per-column bold/underline/foreground so term::drawText can colour and style it.
' A run's dom TextSpans are in grapheme indices over its collapsed text; paint maps
' them through the same word-wrap it draws, onto the row columns each glyph lands in.
' The mapping assumes one grapheme == one column (true for the Latin text that links
' and bold/underline appear on); a wide glyph can shift an attribute a cell, never
' corrupt the frame.

' The terminal style resolved at one grapheme: bold/underline flags, a 0xRRGGBB
' foreground (-1 = default), a link href ("" = not a link), and a form-field ordinal
' (-1 = not an editable <input>'s box).
TYPE Style3
  bold AS Boolean
  underline AS Boolean
  color AS Integer
  href AS String
  field AS Integer
END TYPE

' A styled column range within one output row (inclusive [c0, c1]); `href` is set when
' the range is a link's text, `field` when it is an editable <input>'s box.
TYPE RowSpan
  c0 AS Integer
  c1 AS Integer
  bold AS Boolean
  underline AS Boolean
  color AS Integer
  href AS String
  field AS Integer
END TYPE

' One rectangle of a navigation target on a page row: columns [c0, c1] on canvas row
' `row` (before horizontal scroll).
EXPORT TYPE Rect
  row AS Integer
  c0 AS Integer
  c1 AS Integer
END TYPE

' Something the reader can Tab to: a hyperlink or an editable form field, and the
' on-screen rectangles it occupies. For a link that is its *text* (a wrapped link spans
' several rows; its decorative brackets are excluded) and `href` is the URL with
' `field` = -1; for a field it is the whole |S:----| box, `field` is the dom field
' ordinal to edit and `href` is "".
EXPORT TYPE Target
  href AS String
  rects AS List OF Rect
  field AS Integer
END TYPE

' The result of painting a page: the styled rows to draw, and the targets found with
' their rectangles (for the app's link/field focus, activation and text entry).
EXPORT TYPE PaintResult
  rows AS List OF AttributedString
  targets AS List OF Target
END TYPE

' The positioned canvas: the plain text rows, the styled spans per row, and the
' targets accumulated as runs are painted.
TYPE Canvas
  rows AS List OF String
  spans AS List OF List OF RowSpan
  targets AS List OF Target
END TYPE

' The style covering grapheme `idx` per a run's spans (ordered, non-overlapping);
' default (unstyled) when none covers it.
FUNC styleAt(spans AS List OF TextSpan, idx AS Integer) AS Style3
  FOR EACH sp IN spans
    IF idx >= sp.start AND idx <= sp.endIndex THEN
      RETURN Style3[sp.bold, sp.underline, sp.color, sp.href, sp.field]
    END IF
  NEXT
  RETURN Style3[FALSE, FALSE, -1, "", -1]
END FUNC

' The graphemes in a string (its count is used to advance the wrap offset).
FUNC graphemeCount(s AS String) AS Integer
  RETURN len(strings::graphemes(s))
END FUNC

' Map one wrapped line's styled graphemes to row column-spans: grapheme j of the line
' is source grapheme `lineOffset + j` (look its style up in `spans`) and lands at row
' column `startCol + j`, clipped at `rightBound` exactly as the drawn text is. Maximal
' same-style, contiguous columns are merged into one RowSpan.
FUNC mapLineSpans(spans AS List OF TextSpan, line AS String, lineOffset AS Integer, startCol AS Integer, rightBound AS Integer) AS List OF RowSpan
  MUT out AS List OF RowSpan = []
  MUT haveRun AS Boolean = FALSE
  MUT rs0 AS Integer = 0
  MUT rs1 AS Integer = 0
  MUT rb AS Boolean = FALSE
  MUT ru AS Boolean = FALSE
  MUT rc AS Integer = -1
  MUT rh AS String = ""
  MUT rf AS Integer = -1
  MUT j AS Integer = 0
  FOR EACH g IN strings::graphemes(line)
    LET col AS Integer = startCol + j
    IF col >= rightBound THEN
      EXIT FOR
    END IF
    LET stl AS Style3 = styleAt(spans, lineOffset + j)
    LET styled AS Boolean = stl.bold OR stl.underline OR stl.color >= 0 OR stl.href <> "" OR stl.field >= 0
    IF styled AND col >= 0 THEN
      IF haveRun AND stl.bold = rb AND stl.underline = ru AND stl.color = rc AND stl.href = rh AND stl.field = rf AND col = rs1 + 1 THEN
        rs1 = col
      ELSE
        IF haveRun THEN
          out = collections::append(out, RowSpan[rs0, rs1, rb, ru, rc, rh, rf])
        END IF
        haveRun = TRUE
        rs0 = col
        rs1 = col
        rb = stl.bold
        ru = stl.underline
        rc = stl.color
        rh = stl.href
        rf = stl.field
      END IF
    ELSE
      IF haveRun THEN
        out = collections::append(out, RowSpan[rs0, rs1, rb, ru, rc, rh, rf])
        haveRun = FALSE
      END IF
    END IF
    j = j + 1
  NEXT
  IF haveRun THEN
    out = collections::append(out, RowSpan[rs0, rs1, rb, ru, rc, rh, rf])
  END IF
  RETURN out
END FUNC

' Add a rect to the target identified by (`href`, `field`), appending a new target
' when this run has not seen that pair yet. Grouping is per run, so the same URL in
' two runs is two links; a field ordinal is unique to one <input>, so its box —
' however the run wraps — is always one target.
FUNC addRect(targets AS List OF Target, href AS String, field AS Integer, rect AS Rect) AS List OF Target
  MUT out AS List OF Target = []
  MUT found AS Boolean = FALSE
  FOR EACH tg IN targets
    IF NOT found AND tg.href = href AND tg.field = field THEN
      out = collections::append(out, Target[href, collections::append(tg.rects, rect), field])
      found = TRUE
    ELSE
      out = collections::append(out, tg)
    END IF
  NEXT
  IF NOT found THEN
    LET rects AS List OF Rect = [rect]
    out = collections::append(out, Target[href, rects, field])
  END IF
  RETURN out
END FUNC

' Draw one text run onto the canvas at its layout box, recording its styled spans.
' The DOM gives the box in CSS px; map it down with the glyph size (`cw` px wide,
' `linePx` tall): the run starts at column x/cw, row y/linePx, `box.width/cw` wide.
FUNC paintRun(cv AS Canvas, t AS TextNode, widthCols AS Integer, cw AS Integer, linePx AS Integer) AS Canvas
  LET box AS Layout = t.layout
  LET wCols AS Integer = divRound(box.width, cw)
  IF wCols <= 0 THEN RETURN cv
  LET colX AS Integer = divRound(box.x, cw)
  LET rowY AS Integer = divRound(box.y, linePx)
  LET lines AS List OF String = wrapRun(collapseRun(t.text), wCols)
  MUT rows AS List OF String = cv.rows
  MUT allSpans AS List OF List OF RowSpan = cv.spans
  MUT targets AS List OF Target = cv.targets
  MUT runTargets AS List OF Target = []
  MUT lineOffset AS Integer = 0
  MUT i AS Integer = 0
  FOR EACH line IN lines
    LET row AS Integer = rowY + i
    IF row >= 0 AND row < len(rows) THEN
      LET off AS Integer = alignOffset(t.align, wCols, strings::displayWidth(line))
      ' Clip the line to the run's own box (not just the canvas) so a run never
      ' bleeds past its box into a neighbour — e.g. an over-narrow table column.
      LET rightBound AS Integer = minOf(widthCols, colX + wCols)
      rows = collections::set(rows, row, overlay(collections::get(rows, row), colX + off, line, rightBound))
      IF len(t.spans) > 0 THEN
        MUT existing AS List OF RowSpan = collections::get(allSpans, row)
        FOR EACH rs IN mapLineSpans(t.spans, line, lineOffset, colX + off, rightBound)
          existing = collections::append(existing, rs)
          IF rs.href <> "" OR rs.field >= 0 THEN
            runTargets = addRect(runTargets, rs.href, rs.field, Rect[row, rs.c0, rs.c1])
          END IF
        NEXT
        allSpans = collections::set(allSpans, row, existing)
      END IF
    END IF
    lineOffset = lineOffset + graphemeCount(line) + 1
    i = i + 1
  NEXT
  FOR EACH tg IN runTargets
    targets = collections::append(targets, tg)
  NEXT
  RETURN Canvas[rows, allSpans, targets]
END FUNC

' The (r, g, b) channels of a packed 0xRRGGBB color.
FUNC redOf(c AS Integer) AS Byte
  RETURN toByte((c / 65536) - ((c / 16777216) * 256))
END FUNC
FUNC greenOf(c AS Integer) AS Byte
  RETURN toByte((c / 256) - ((c / 65536) * 256))
END FUNC
FUNC blueOf(c AS Integer) AS Byte
  RETURN toByte(c - ((c / 256) * 256))
END FUNC

' Build one row's AttributedString: the plain text plus each recorded span's bold /
' underline / foreground applied over its columns (== scalar indices for Latin text).
FUNC buildRow(rowText AS String, spans AS List OF RowSpan) AS AttributedString
  MUT a AS AttributedString = astrings::fromString(rowText)
  LET n AS Integer = len(rowText)
  IF n = 0 THEN RETURN a
  FOR EACH sp IN spans
    LET s0 AS Integer = maxOf(0, sp.c0)
    LET s1 AS Integer = minOf(sp.c1, n - 1)
    IF s1 >= s0 THEN
      IF sp.bold THEN a = astrings::addAttribute(a, s0, s1, astrings::bold())
      IF sp.underline THEN a = astrings::addAttribute(a, s0, s1, astrings::underline())
      IF sp.color >= 0 THEN a = astrings::addAttribute(a, s0, s1, astrings::foreground(color::rgb(toInt(redOf(sp.color)), toInt(greenOf(sp.color)), toInt(blueOf(sp.color)))))
    END IF
  NEXT
  RETURN a
END FUNC

' Render the document to a `widthCols`-wide canvas: a `PaintResult` of one
' AttributedString per page row plus the navigation targets found (links, with their
' on-screen rectangles). The DOM lays out in device-independent CSS px, so paint gives
' it a viewport of `widthCols * cellPx` px and the glyph size (`cellPx` wide, `linePx`
' tall), maps every text run's px box down to terminal cells as it draws, carries each
' run's styling onto the rows, and collects each link's text rectangles (see paintRun).
' This is where all px → cell conversion happens; the DOM never knows about terminal
' cells. Walks iteratively (the imported Node union does not lower to a recursive fn).
EXPORT FUNC paint(root AS Node, widthCols AS Integer, cellPx AS Integer, linePx AS Integer) AS PaintResult
  LET cw AS Integer = maxOf(1, cellPx)
  LET lh AS Integer = maxOf(1, linePx)
  LET viewportPx AS Integer = maxOf(0, widthCols) * cw
  LET laid AS Node = dom::updateLayout(root, viewportPx, cw, lh, TRUE)
  LET h AS Integer = pageHeight(laid, lh)
  MUT rows AS List OF String = []
  MUT spans AS List OF List OF RowSpan = []
  LET emptyRow AS List OF RowSpan = []
  FOR i = 0 TO h - 1
    rows = collections::append(rows, "")
    spans = collections::append(spans, emptyRow)
  NEXT
  LET noTargets AS List OF Target = []
  MUT cv AS Canvas = Canvas[rows, spans, noTargets]
  MUT stack AS List OF Node = [laid]
  DO WHILE len(stack) > 0
    LET i AS Integer = len(stack) - 1
    LET node AS Node = collections::get(stack, i)
    stack = collections::removeAt(stack, i)
    MATCH node
      CASE ElementNode(e)
        MUT j AS Integer = len(e.children) - 1
        DO WHILE j >= 0
          stack = collections::append(stack, collections::get(e.children, j))
          j = j - 1
        LOOP
      CASE TextNode(t)
        cv = paintRun(cv, t, widthCols, cw, lh)
      CASE HeaderNode(hn)
      CASE ELSE
    END MATCH
  LOOP
  MUT out AS List OF AttributedString = []
  MUT r AS Integer = 0
  FOR EACH rowText IN cv.rows
    out = collections::append(out, buildRow(rowText, collections::get(cv.spans, r)))
    r = r + 1
  NEXT
  RETURN PaintResult[out, cv.targets]
END FUNC

' ----- the [L]inks view: every link as a labelled multi-column list ------------

' A hyperlink on the page: its URL and its visible text (for the links list).
EXPORT TYPE Link
  href AS String
  text AS String
END TYPE

' The concatenated text of an element's subtree, in document order (skipping a
' display:none subtree). Iterative — no recursion over the imported Node union.
FUNC subtreeText(e AS ElementNode) AS String
  MUT parts AS List OF String = []
  MUT stack AS List OF Node = []
  MUT j AS Integer = len(e.children) - 1
  DO WHILE j >= 0
    stack = collections::append(stack, collections::get(e.children, j))
    j = j - 1
  LOOP
  DO WHILE len(stack) > 0
    LET i AS Integer = len(stack) - 1
    LET node AS Node = collections::get(stack, i)
    stack = collections::removeAt(stack, i)
    MATCH node
      CASE ElementNode(ce)
        IF ce.style.display <> Display.None THEN
          MUT k AS Integer = len(ce.children) - 1
          DO WHILE k >= 0
            stack = collections::append(stack, collections::get(ce.children, k))
            k = k - 1
          LOOP
        END IF
      CASE TextNode(t)
        parts = collections::append(parts, t.text)
      CASE ELSE
    END MATCH
  LOOP
  RETURN strings::join(parts, "")
END FUNC

' Every hyperlink (an <a> with an href) on the page, in document order, with its
' visible text. Links inside a display:none subtree are skipped. Iterative walk.
EXPORT FUNC links(root AS Node) AS List OF Link
  MUT out AS List OF Link = []
  MUT stack AS List OF Node = [root]
  DO WHILE len(stack) > 0
    LET i AS Integer = len(stack) - 1
    LET node AS Node = collections::get(stack, i)
    stack = collections::removeAt(stack, i)
    MATCH node
      CASE ElementNode(e)
        IF e.style.display <> Display.None THEN
          IF e.tag = "a" THEN
            LET href AS String = collections::getOr(e.attrs, "href", "")
            IF href <> "" THEN
              LET txt AS String = strings::trim(collapse(subtreeText(e)))
              IF txt <> "" THEN
                out = collections::append(out, Link[href, txt])
              END IF
            END IF
          END IF
          MUT j AS Integer = len(e.children) - 1
          DO WHILE j >= 0
            stack = collections::append(stack, collections::get(e.children, j))
            j = j - 1
          LOOP
        END IF
      CASE ELSE
    END MATCH
  LOOP
  RETURN out
END FUNC

' The number of letters in each link label: 1 for <=26 links, 2 for <=676, else 3.
EXPORT FUNC linkLabelWidth(total AS Integer) AS Integer
  IF total <= 26 THEN RETURN 1
  IF total <= 676 THEN RETURN 2
  RETURN 3
END FUNC

' The fixed-width, upper-case A-Z label for link `index` (0 -> A or AA, 25 -> Z or AZ,
' 26 -> BA …), so the app can map a typed label straight back to a link.
EXPORT FUNC linkLabel(index AS Integer, total AS Integer) AS String
  LET alpha AS String = "ABCDEFGHIJKLMNOPQRSTUVWXYZ"
  LET w AS Integer = linkLabelWidth(total)
  MUT s AS String = ""
  MUT x AS Integer = index
  MUT k AS Integer = 0
  DO WHILE k < w
    LET d AS Integer = x MOD 26
    s = strings::mid(alpha, d, 1) & s
    x = x / 26
    k = k + 1
  LOOP
  RETURN s
END FUNC

' Render the links as a multi-column labelled list — "A) Link Text" cells, one
' AttributedString per row (labels bold), fit to `widthCols`. The column count adapts
' to the width (so wide/extra-wide modes show more columns); a long link text is
' clipped to its column. Row-major: labels read left-to-right, top-to-bottom.
EXPORT FUNC linksView(items AS List OF Link, widthCols AS Integer) AS List OF AttributedString
  LET n AS Integer = len(items)
  MUT out AS List OF AttributedString = []
  IF n = 0 THEN
    out = collections::append(out, astrings::fromString("(no links on this page)"))
    RETURN out
  END IF
  LET w AS Integer = maxOf(1, widthCols)
  LET gap AS Integer = 2
  LET minCell AS Integer = 24
  LET cols AS Integer = maxOf(1, (w + gap) / (minCell + gap))
  LET cellW AS Integer = maxOf(1, (w - gap * (cols - 1)) / cols)
  LET rowsN AS Integer = (n + cols - 1) / cols
  MUT r AS Integer = 0
  DO WHILE r < rowsN
    MUT line AS String = ""
    MUT labStarts AS List OF Integer = []
    MUT labEnds AS List OF Integer = []
    MUT c AS Integer = 0
    DO WHILE c < cols
      LET index AS Integer = r * cols + c
      IF index < n THEN
        LET lab AS String = linkLabel(index, n)
        LET content AS String = lab & ") " & collections::get(items, index).text
        LET cell AS String = padTo(clip(content, cellW), cellW)
        LET colStart AS Integer = len(line)
        labStarts = collections::append(labStarts, colStart)
        labEnds = collections::append(labEnds, colStart + len(lab) - 1)
        line = line & cell
        IF c < cols - 1 THEN
          line = line & strings::repeat(" ", gap)
        END IF
      END IF
      c = c + 1
    LOOP
    MUT a AS AttributedString = astrings::fromString(line)
    MUT li AS Integer = 0
    DO WHILE li < len(labStarts)
      a = astrings::addAttribute(a, collections::get(labStarts, li), collections::get(labEnds, li), astrings::bold())
      li = li + 1
    LOOP
    out = collections::append(out, a)
    r = r + 1
  LOOP
  RETURN out
END FUNC

' The readable page text: a pre-order walk emitting text, breaking lines on
' block tags, skipping the header and non-visible subtrees.
EXPORT FUNC render(root AS Node, width AS Integer) AS String
  MUT parts AS List OF String = []
  MUT stack AS List OF Node = [root]
  DO WHILE len(stack) > 0
    LET i AS Integer = len(stack) - 1
    LET node AS Node = collections::get(stack, i)
    stack = collections::removeAt(stack, i)
    MATCH node
      CASE ElementNode(e)
        IF NOT skipTag(e.tag) THEN
          IF isBlock(e.tag) THEN
            parts = collections::append(parts, "\n")
          END IF
          MUT j AS Integer = len(e.children) - 1
          DO WHILE j >= 0
            stack = collections::append(stack, collections::get(e.children, j))
            j = j - 1
          LOOP
        END IF
      CASE TextNode(t)
        parts = collections::append(parts, t.text)
      CASE HeaderNode(h)
        ' the header carries no visible text
      CASE ELSE
    END MATCH
  LOOP
  RETURN wrap(tidy(strings::join(parts, "")), width)
END FUNC

' One node's attribute summary for the tree view (id / class / href only).
FUNC attrsBrief(attrs AS Map OF String TO String) AS String
  MUT out AS String = ""
  IF collections::hasKey(attrs, "id") THEN
    out = out & " id=" & collections::getOr(attrs, "id", "")
  END IF
  IF collections::hasKey(attrs, "class") THEN
    out = out & " class=" & clip(collections::getOr(attrs, "class", ""), 24)
  END IF
  IF collections::hasKey(attrs, "href") THEN
    out = out & " href=" & clip(collections::getOr(attrs, "href", ""), 40)
  END IF
  RETURN out
END FUNC

' One frame of the tree walk: a node and its indent depth.
TYPE Walk
  node AS Node
  depth AS Integer
END TYPE

' Format one parsed CSS rule as `selector { prop: value; … }`. display reads the
' StyleNode record's fields directly now that a transitively-reached record's
' fields are visible across a package boundary (bug-435 fix) — dom no longer has
' to pre-format the rules into strings.
FUNC formatRule(r AS StyleNode) AS String
  MUT decls AS String = ""
  FOR EACH key IN collections::keys(r.props)
    IF decls <> "" THEN
      decls = decls & "; "
    END IF
    decls = decls & key & ": " & collections::getOr(r.props, key, "")
  NEXT
  RETURN r.selector & " { " & decls & " }"
END FUNC

' An indented text rendering of the DOM tree itself (the "raw" view).
EXPORT FUNC tree(root AS Node, width AS Integer) AS String
  MUT lines AS List OF String = []
  MUT cssLines AS List OF String = []
  MUT stack AS List OF Walk = [Walk[root, 0]]
  DO WHILE len(stack) > 0
    LET i AS Integer = len(stack) - 1
    LET w AS Walk = collections::get(stack, i)
    stack = collections::removeAt(stack, i)
    LET indent AS String = strings::repeat("  ", w.depth)
    MATCH w.node
      CASE ElementNode(e)
        lines = collections::append(lines, indent & "<" & e.tag & attrsBrief(e.attrs) & ">")
        MUT j AS Integer = len(e.children) - 1
        DO WHILE j >= 0
          stack = collections::append(stack, Walk[collections::get(e.children, j), w.depth + 1])
          j = j - 1
        LOOP
      CASE TextNode(t)
        LET tx AS String = strings::trim(collapse(t.text))
        IF tx <> "" THEN
          lines = collections::append(lines, indent & "\"" & clip(tx, 60) & "\"")
        END IF
      CASE HeaderNode(h)
        lines = collections::append(lines, indent & "#head  title=\"" & clip(h.title, 40) & "\"  scripts=" & toString(len(h.scripts)) & "  styles=" & toString(len(h.styles)) & "  css=" & toString(len(h.css)) & "  rules=" & toString(len(h.rules)))
        ' Format the header's CSS rules directly from the StyleNode records.
        FOR EACH r IN h.rules
          cssLines = collections::append(cssLines, formatRule(r))
        NEXT
      CASE ELSE
    END MATCH
  LOOP
  IF len(cssLines) > 0 THEN
    lines = collections::append(lines, "")
    lines = collections::append(lines, "CSS rules (" & toString(len(cssLines)) & "):")
    FOR EACH cssLine IN cssLines
      lines = collections::append(lines, "  " & clip(cssLine, width - 2))
    NEXT
  END IF
  RETURN wrap(strings::join(lines, "\n"), width)
END FUNC
