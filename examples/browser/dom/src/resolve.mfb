' dom/resolve — compute each element's resolved Style from the parsed CSS.
'
' After parse() builds the document and attachCss() has folded in every external
' stylesheet's rules, resolveStyles(doc) walks the tree and fills each
' ElementNode.style: for every element it starts from a user-agent default (per
' tag), applies each matching StyleNode rule in document order, then applies the
' element's inline `style="…"` attribute (highest priority). Layout properties do
' not inherit, so each element's Style depends only on its own tag/attrs and the
' global rule set — no ancestor context is threaded.
'
' This lives in dom (not display) so it can read the StyleNode records and rebuild
' the Node tree by recursion over dom's OWN union — the "must be iterative" rule
' only binds a consumer recursing over an imported union.

IMPORT collections
IMPORT strings

' ----- value parsers (raw CSS string -> typed field, falling back to `fb`) -----

FUNC normalize(v AS String) AS String
  RETURN strings::lower(strings::trim(v))
END FUNC

' Integer from a trimmed numeric string, or `fb` if it will not parse.
FUNC parseIntOr(s AS String, fb AS Integer) AS Integer
  LET r AS Integer = toInt(strings::trim(s), 10) TRAP(e)
    RECOVER fb
  END TRAP
  RETURN r
END FUNC

' The leading integer text of `v` (an optional '-' then digits), e.g. "20px" ->
' "20", "-3" -> "-3", "auto" -> "".
FUNC leadingInt(v AS String) AS String
  LET t AS String = strings::trim(v)
  MUT out AS String = ""
  MUT i AS Integer = 0
  LET n AS Integer = len(t)
  DO WHILE i < n
    LET ch AS String = strings::mid(t, i, 1)
    IF i = 0 AND ch = "-" THEN
      out = out & ch
    ELSEIF strings::contains("0123456789", ch) THEN
      out = out & ch
    ELSE
      EXIT DO
    END IF
    i = i + 1
  LOOP
  RETURN out
END FUNC

' A CSS length in CSS px (updateLayout later scales px -> cells): "auto" -> -1,
' "20px"/"20" -> 20, "1.5em"/"2rem" -> n*16 (a 16px default font size). A viewport-
' or container-relative length ("60vw", "100%", "50vh", …) cannot resolve to an
' absolute px here — this Style model carries no containing-block width — so it falls
' back to auto (-1): a relative WIDTH then fills the available space (reflowing with
' the viewport) instead of being read as a raw px number that collapses the box to a
' sliver (e.g. "60vw" as 60px -> ~8 cells). Any other/unknown unit keeps its leading
' number as px.
FUNC lengthOf(v AS String, fb AS Integer) AS Integer
  LET t AS String = normalize(v)
  IF t = "auto" THEN RETURN -1
  IF strings::endsWith(t, "%") OR strings::endsWith(t, "vw") OR strings::endsWith(t, "vh") OR strings::endsWith(t, "vmin") OR strings::endsWith(t, "vmax") OR strings::endsWith(t, "vi") OR strings::endsWith(t, "vb") THEN
    RETURN -1
  END IF
  LET num AS String = leadingInt(t)
  IF num = "" OR num = "-" THEN RETURN fb
  LET n AS Integer = parseIntOr(num, fb)
  ' em/rem (rem also ends with "em") -> a 16px default font size.
  IF strings::endsWith(t, "em") THEN RETURN n * 16
  RETURN n
END FUNC

' Resolve the `width` property, preserving its unit so layout can resolve a relative
' width against the right reference. "auto" -> width -1; a percent/viewport unit
' ("60vw", "100%", "50vh"…) keeps its number and tags widthUnit; everything else is an
' absolute px length (px/unitless, em/rem via lengthOf's 16px font). A malformed value
' leaves the width unchanged. Unlike lengthOf (which collapses relative units to auto
' for the other box properties), width carries the unit through to layout.
FUNC applyWidth(base AS Style, raw AS String) AS Style
  LET t AS String = normalize(raw)
  MUT s AS Style = base
  IF t = "auto" THEN
    RETURN WITH s { width := -1 }
  END IF
  MUT unit AS LengthUnit = LengthUnit.Px
  MUT relative AS Boolean = TRUE
  IF strings::endsWith(t, "%") THEN
    unit = LengthUnit.Percent
  ELSEIF strings::endsWith(t, "vmin") THEN
    unit = LengthUnit.Vmin
  ELSEIF strings::endsWith(t, "vmax") THEN
    unit = LengthUnit.Vmax
  ELSEIF strings::endsWith(t, "vw") THEN
    unit = LengthUnit.Vw
  ELSEIF strings::endsWith(t, "vh") THEN
    unit = LengthUnit.Vh
  ELSE
    relative = FALSE
  END IF
  IF relative THEN
    LET num AS String = leadingInt(t)
    IF num = "" OR num = "-" THEN
      RETURN base
    END IF
    s = WITH s { width := parseIntOr(num, 0) }
    s = WITH s { widthUnit := unit }
    RETURN s
  END IF
  ' Absolute: reuse lengthOf (px / unitless / em / rem), and mark the unit Px so a
  ' later absolute rule overrides an earlier relative one in the cascade.
  s = WITH s { width := lengthOf(t, base.width) }
  s = WITH s { widthUnit := LengthUnit.Px }
  RETURN s
END FUNC

' A plain integer value (flex-grow/shrink), or `fb`.
FUNC intOf(v AS String, fb AS Integer) AS Integer
  LET num AS String = leadingInt(v)
  IF num = "" OR num = "-" THEN RETURN fb
  RETURN parseIntOr(num, fb)
END FUNC

FUNC displayOf(v AS String, fb AS Display) AS Display
  LET t AS String = normalize(v)
  IF t = "none" THEN RETURN Display.None
  IF t = "inline" THEN RETURN Display.Inline
  IF t = "block" THEN RETURN Display.Block
  IF t = "flex" THEN RETURN Display.Flex
  IF t = "inline-flex" THEN RETURN Display.Flex
  IF t = "inline-block" THEN RETURN Display.Block
  RETURN fb
END FUNC

FUNC directionOf(v AS String, fb AS FlexDirection) AS FlexDirection
  LET t AS String = normalize(v)
  IF t = "row" THEN RETURN FlexDirection.Row
  IF t = "column" THEN RETURN FlexDirection.Column
  IF t = "row-reverse" THEN RETURN FlexDirection.RowReverse
  IF t = "column-reverse" THEN RETURN FlexDirection.ColumnReverse
  RETURN fb
END FUNC

FUNC wrapOf(v AS String, fb AS FlexWrap) AS FlexWrap
  LET t AS String = normalize(v)
  IF t = "nowrap" THEN RETURN FlexWrap.NoWrap
  IF t = "wrap" THEN RETURN FlexWrap.Wrap
  IF t = "wrap-reverse" THEN RETURN FlexWrap.WrapReverse
  RETURN fb
END FUNC

FUNC justifyOf(v AS String, fb AS Justify) AS Justify
  LET t AS String = normalize(v)
  IF t = "flex-start" OR t = "start" THEN RETURN Justify.FlexStart
  IF t = "flex-end" OR t = "end" THEN RETURN Justify.FlexEnd
  IF t = "center" THEN RETURN Justify.Center
  IF t = "space-between" THEN RETURN Justify.SpaceBetween
  IF t = "space-around" THEN RETURN Justify.SpaceAround
  IF t = "space-evenly" THEN RETURN Justify.SpaceEvenly
  RETURN fb
END FUNC

FUNC alignOf(v AS String, fb AS Align) AS Align
  LET t AS String = normalize(v)
  IF t = "stretch" THEN RETURN Align.Stretch
  IF t = "flex-start" OR t = "start" THEN RETURN Align.FlexStart
  IF t = "flex-end" OR t = "end" THEN RETURN Align.FlexEnd
  IF t = "center" THEN RETURN Align.Center
  RETURN fb
END FUNC

' Split a whitespace-separated value list, dropping empty runs.
FUNC splitWs(v AS String) AS List OF String
  MUT out AS List OF String = []
  FOR EACH p IN strings::split(strings::trim(v), " ")
    LET q AS String = strings::trim(p)
    IF q <> "" THEN out = collections::append(out, q)
  NEXT
  RETURN out
END FUNC

' ----- applying a declaration map onto a Style -----

' Apply the four sides of a padding/margin shorthand ("0", "1 2", "1 2 3 4") plus
' their longhands. Called twice (padding, margin) via the two helpers below.
FUNC applyPadding(base AS Style, props AS Map OF String TO String) AS Style
  MUT s AS Style = base
  LET sh AS String = collections::getOr(props, "padding", "")
  IF sh <> "" THEN
    LET p AS List OF String = splitWs(sh)
    LET c AS Integer = len(p)
    IF c >= 1 THEN
      MUT top AS Integer = lengthOf(collections::get(p, 0), 0)
      MUT right AS Integer = top
      MUT bottom AS Integer = top
      MUT left AS Integer = top
      IF c >= 2 THEN
        right = lengthOf(collections::get(p, 1), 0)
        left = right
      END IF
      IF c >= 3 THEN bottom = lengthOf(collections::get(p, 2), 0)
      IF c >= 4 THEN left = lengthOf(collections::get(p, 3), 0)
      s = WITH s { paddingTop := top }
      s = WITH s { paddingRight := right }
      s = WITH s { paddingBottom := bottom }
      s = WITH s { paddingLeft := left }
    END IF
  END IF
  LET pt AS String = collections::getOr(props, "padding-top", "")
  IF pt <> "" THEN s = WITH s { paddingTop := lengthOf(pt, s.paddingTop) }
  LET pr AS String = collections::getOr(props, "padding-right", "")
  IF pr <> "" THEN s = WITH s { paddingRight := lengthOf(pr, s.paddingRight) }
  LET pb AS String = collections::getOr(props, "padding-bottom", "")
  IF pb <> "" THEN s = WITH s { paddingBottom := lengthOf(pb, s.paddingBottom) }
  LET pl AS String = collections::getOr(props, "padding-left", "")
  IF pl <> "" THEN s = WITH s { paddingLeft := lengthOf(pl, s.paddingLeft) }
  RETURN s
END FUNC

FUNC applyMargin(base AS Style, props AS Map OF String TO String) AS Style
  MUT s AS Style = base
  LET sh AS String = collections::getOr(props, "margin", "")
  IF sh <> "" THEN
    LET p AS List OF String = splitWs(sh)
    LET c AS Integer = len(p)
    IF c >= 1 THEN
      MUT top AS Integer = lengthOf(collections::get(p, 0), 0)
      MUT right AS Integer = top
      MUT bottom AS Integer = top
      MUT left AS Integer = top
      IF c >= 2 THEN
        right = lengthOf(collections::get(p, 1), 0)
        left = right
      END IF
      IF c >= 3 THEN bottom = lengthOf(collections::get(p, 2), 0)
      IF c >= 4 THEN left = lengthOf(collections::get(p, 3), 0)
      s = WITH s { marginTop := top }
      s = WITH s { marginRight := right }
      s = WITH s { marginBottom := bottom }
      s = WITH s { marginLeft := left }
    END IF
  END IF
  LET mt AS String = collections::getOr(props, "margin-top", "")
  IF mt <> "" THEN s = WITH s { marginTop := lengthOf(mt, s.marginTop) }
  LET mr AS String = collections::getOr(props, "margin-right", "")
  IF mr <> "" THEN s = WITH s { marginRight := lengthOf(mr, s.marginRight) }
  LET mb AS String = collections::getOr(props, "margin-bottom", "")
  IF mb <> "" THEN s = WITH s { marginBottom := lengthOf(mb, s.marginBottom) }
  LET ml AS String = collections::getOr(props, "margin-left", "")
  IF ml <> "" THEN s = WITH s { marginLeft := lengthOf(ml, s.marginLeft) }
  RETURN s
END FUNC

' Fold a resolved declaration map onto `base`, overriding only the properties the
' map actually carries (an absent or empty value leaves the base field intact).
EXPORT FUNC applyDeclarations(base AS Style, props AS Map OF String TO String) AS Style
  MUT s AS Style = base
  LET disp AS String = collections::getOr(props, "display", "")
  IF disp <> "" THEN s = WITH s { display := displayOf(disp, s.display) }
  LET dir AS String = collections::getOr(props, "flex-direction", "")
  IF dir <> "" THEN s = WITH s { direction := directionOf(dir, s.direction) }
  LET wr AS String = collections::getOr(props, "flex-wrap", "")
  IF wr <> "" THEN s = WITH s { wrap := wrapOf(wr, s.wrap) }
  LET jc AS String = collections::getOr(props, "justify-content", "")
  IF jc <> "" THEN s = WITH s { justify := justifyOf(jc, s.justify) }
  LET ai AS String = collections::getOr(props, "align-items", "")
  IF ai <> "" THEN s = WITH s { align := alignOf(ai, s.align) }
  LET fg AS String = collections::getOr(props, "flex-grow", "")
  IF fg <> "" THEN s = WITH s { flexGrow := intOf(fg, s.flexGrow) }
  LET fsh AS String = collections::getOr(props, "flex-shrink", "")
  IF fsh <> "" THEN s = WITH s { flexShrink := intOf(fsh, s.flexShrink) }
  LET basis AS String = collections::getOr(props, "flex-basis", "")
  IF basis <> "" THEN s = WITH s { flexBasis := lengthOf(basis, s.flexBasis) }
  LET wd AS String = collections::getOr(props, "width", "")
  IF wd <> "" THEN s = applyWidth(s, wd)
  LET ht AS String = collections::getOr(props, "height", "")
  IF ht <> "" THEN s = WITH s { height := lengthOf(ht, s.height) }
  LET gp AS String = collections::getOr(props, "gap", "")
  IF gp <> "" THEN s = WITH s { gap := lengthOf(gp, s.gap) }
  LET ta AS String = collections::getOr(props, "text-align", "")
  IF ta <> "" THEN s = WITH s { textAlign := textAlignOf(ta, s.textAlign) }
  s = applyPadding(s, props)
  s = applyMargin(s, props)
  RETURN s
END FUNC

' Map a text-align keyword to the shared Justify vocabulary: left/start -> FlexStart,
' center -> Center, right/end -> FlexEnd. `justify` (full text justification) has no
' terminal analogue, so it falls back to left.
FUNC textAlignOf(v AS String, fb AS Justify) AS Justify
  LET t AS String = normalize(v)
  IF t = "left" OR t = "start" OR t = "justify" THEN RETURN Justify.FlexStart
  IF t = "center" THEN RETURN Justify.Center
  IF t = "right" OR t = "end" THEN RETURN Justify.FlexEnd
  RETURN fb
END FUNC

' ----- selector matching + the user-agent default sheet -----

FUNC listHasStr(items AS List OF String, name AS String) AS Boolean
  FOR EACH c IN items
    IF c = name THEN RETURN TRUE
  NEXT
  RETURN FALSE
END FUNC

' A lightweight identity of one element for selector matching: its tag, id, and
' class list. resolveOne threads the ancestor chain of these so descendant
' selectors can look upward.
TYPE ElemDesc
  tag AS String
  id AS String
  classes AS List OF String
END TYPE

' Does a COMPOUND selector — a run of simple selectors with no combinator, e.g.
' "a.gb_4a", ".x.y", "div#id" — match an element with this tag/id/classes? "*"
' matches anything. A leading tag name is matched case-insensitively; each `.name`
' must be in the class list and each `#name` must equal the id. An unsupported
' piece (a `:pseudo`, `[attr]`) is folded into the preceding token so it simply
' fails to match rather than matching wrongly.
FUNC compoundMatches(comp AS String, tag AS String, id AS String, classes AS List OF String) AS Boolean
  LET s AS String = strings::trim(comp)
  IF s = "" THEN RETURN FALSE
  IF s = "*" THEN RETURN TRUE
  LET n AS Integer = len(s)
  ' Leading tag name (up to the first '.' or '#').
  MUT i AS Integer = 0
  MUT tagPart AS String = ""
  DO WHILE i < n
    LET ch AS String = strings::mid(s, i, 1)
    IF ch = "." OR ch = "#" THEN EXIT DO
    tagPart = tagPart & ch
    i = i + 1
  LOOP
  IF tagPart <> "" AND tagPart <> "*" THEN
    IF strings::lower(tagPart) <> tag THEN RETURN FALSE
  END IF
  ' Remaining '.class' / '#id' tokens.
  DO WHILE i < n
    LET marker AS String = strings::mid(s, i, 1)
    i = i + 1
    MUT tok AS String = ""
    DO WHILE i < n AND strings::mid(s, i, 1) <> "." AND strings::mid(s, i, 1) <> "#"
      tok = tok & strings::mid(s, i, 1)
      i = i + 1
    LOOP
    IF tok = "" THEN RETURN FALSE
    IF marker = "." THEN
      IF NOT listHasStr(classes, tok) THEN
        RETURN FALSE
      END IF
    ELSEIF marker = "#" THEN
      IF id <> tok THEN
        RETURN FALSE
      END IF
    ELSE
      RETURN FALSE
    END IF
  LOOP
  RETURN TRUE
END FUNC

' Split a complex selector into its compound parts by combinator. A child
' combinator ">" is treated as a descendant (a looser but safe approximation); any
' sibling combinator left as its own token simply fails to match.
FUNC splitCompounds(sel AS String) AS List OF String
  LET s AS String = strings::replace(sel, ">", " ")
  MUT out AS List OF String = []
  FOR EACH p IN strings::split(s, " ")
    LET q AS String = strings::trim(p)
    IF q <> "" THEN out = collections::append(out, q)
  NEXT
  RETURN out
END FUNC

' Does a full selector match this element? Supports compound selectors and the
' descendant combinator (space): the rightmost compound must match the element and
' each earlier compound must match an ancestor, nearest-first (greedy). `ancestors`
' is the element's ancestor chain (root first). `classes` is the element's pre-split
' class list; `attrs` supplies its id.
FUNC selectorMatches(sel AS String, tag AS String, classes AS List OF String, attrs AS Map OF String TO String, ancestors AS List OF ElemDesc) AS Boolean
  LET id AS String = collections::getOr(attrs, "id", "")
  LET parts AS List OF String = splitCompounds(sel)
  LET np AS Integer = len(parts)
  IF np = 0 THEN RETURN FALSE
  IF NOT compoundMatches(collections::get(parts, np - 1), tag, id, classes) THEN RETURN FALSE
  IF np = 1 THEN RETURN TRUE
  ' Match the remaining compounds against ancestors, nearest ancestor first.
  MUT need AS Integer = np - 2
  MUT ai AS Integer = len(ancestors) - 1
  DO WHILE ai >= 0 AND need >= 0
    LET anc AS ElemDesc = collections::get(ancestors, ai)
    IF compoundMatches(collections::get(parts, need), anc.tag, anc.id, anc.classes) THEN
      need = need - 1
    END IF
    ai = ai - 1
  LOOP
  RETURN need < 0
END FUNC

FUNC isBlockTag(tag AS String) AS Boolean
  RETURN tag = "#document" OR tag = "html" OR tag = "body" OR tag = "div" OR tag = "p" OR tag = "section" OR tag = "article" OR tag = "header" OR tag = "footer" OR tag = "nav" OR tag = "aside" OR tag = "main" OR tag = "ul" OR tag = "ol" OR tag = "li" OR tag = "table" OR tag = "tr" OR tag = "td" OR tag = "th" OR tag = "thead" OR tag = "tbody" OR tag = "tfoot" OR tag = "caption" OR tag = "blockquote" OR tag = "pre" OR tag = "figure" OR tag = "figcaption" OR tag = "dl" OR tag = "dd" OR tag = "dt" OR tag = "form" OR tag = "fieldset" OR tag = "textarea" OR tag = "center" OR tag = "address" OR tag = "details" OR tag = "summary" OR tag = "h1" OR tag = "h2" OR tag = "h3" OR tag = "h4" OR tag = "h5" OR tag = "h6" OR tag = "hr"
END FUNC

' The user-agent default Style for a tag: display None for non-visual elements,
' Block for block-level tags, Inline otherwise. Block text containers carry a
' default bottom margin (and headings a top margin too) so stacked paragraphs and
' headings are separated by a blank row without any authored CSS — matching a
' browser's default sheet. Everything else stays at the CSS initial value.
FUNC uaStyle(tag AS String) AS Style
  MUT base AS Style = defaultStyle()
  IF tag = "head" OR tag = "script" OR tag = "style" OR tag = "meta" OR tag = "link" OR tag = "title" OR tag = "noscript" THEN
    RETURN WITH base { display := Display.None }
  END IF
  IF NOT isBlockTag(tag) THEN
    RETURN base
  END IF
  base = WITH base { display := Display.Block }
  ' Default spacing in CSS px (~1em); a metric scales it to about a blank row.
  IF tag = "p" OR tag = "ul" OR tag = "ol" OR tag = "blockquote" OR tag = "pre" OR tag = "figure" OR tag = "dl" OR tag = "table" OR tag = "form" THEN
    base = WITH base { marginBottom := 16 }
  END IF
  IF tag = "h1" OR tag = "h2" OR tag = "h3" OR tag = "h4" OR tag = "h5" OR tag = "h6" THEN
    base = WITH base { marginTop := 16 }
    base = WITH base { marginBottom := 16 }
  END IF
  RETURN base
END FUNC

' The resolved Style for one element: the UA default seeded with the inherited
' text-align, then the presentational `align=`/`<center>` hint, then each matching
' rule in document order, then the inline `style="…"` attribute. `inherited` is the
' parent's resolved text-align — the one property that inherits, so <center> or a
' text-align on an ancestor centers this element's text unless it overrides.
FUNC resolveOne(tag AS String, attrs AS Map OF String TO String, rules AS List OF StyleNode, inherited AS Justify, ancestors AS List OF ElemDesc) AS Style
  ' Split the class attribute once, not once per class-selector below.
  LET classes AS List OF String = splitWs(collections::getOr(attrs, "class", ""))
  MUT s AS Style = uaStyle(tag)
  ' text-align inherits; <center> and an align= attribute are presentational seeds
  ' that a matching CSS rule (applied below) can still override.
  MUT ta AS Justify = inherited
  IF tag = "center" THEN ta = Justify.Center
  LET alignAttr AS String = strings::lower(strings::trim(collections::getOr(attrs, "align", "")))
  IF alignAttr = "center" THEN ta = Justify.Center
  IF alignAttr = "right" THEN ta = Justify.FlexEnd
  IF alignAttr = "left" THEN ta = Justify.FlexStart
  s = WITH s { textAlign := ta }
  FOR EACH r IN rules
    IF selectorMatches(r.selector, tag, classes, attrs, ancestors) THEN
      s = applyDeclarations(s, r.props)
    END IF
  NEXT
  LET inline AS String = collections::getOr(attrs, "style", "")
  IF inline <> "" THEN
    s = applyDeclarations(s, parseDeclarations(inline))
  END IF
  RETURN s
END FUNC

' ----- the tree rewrite -----

' The parsed CSS rules hanging off the document's HeaderNode.
FUNC docRules(doc AS Node) AS List OF StyleNode
  MATCH doc
    CASE ElementNode(e)
      FOR EACH child IN e.children
        MATCH child
          CASE HeaderNode(h)
            RETURN h.rules
          CASE ELSE
        END MATCH
      NEXT
      RETURN []
    CASE ELSE
      RETURN []
  END MATCH
END FUNC

' Rebuild a node with its resolved style, recursing into element children which
' inherit this element's resolved text-align. Text and header nodes are returned
' unchanged. Recursion over dom's own Node union is fine (this is inside dom).
' `s` is declared before the MATCH: binding a call result with LET *inside* a CASE
' mis-types to Unknown at native codegen, so resolveOne is assigned to a pre-declared
' MUT instead.
' The element's own identity for descendant matching by its children.
FUNC descOf(e AS ElementNode) AS ElemDesc
  RETURN ElemDesc[e.tag, collections::getOr(e.attrs, "id", ""), splitWs(collections::getOr(e.attrs, "class", ""))]
END FUNC

FUNC rebuild(n AS Node, rules AS List OF StyleNode, inherited AS Justify, ancestors AS List OF ElemDesc) AS Node
  MUT out AS Node = n
  MUT s AS Style = defaultStyle()
  MUT childAncestors AS List OF ElemDesc = ancestors
  MATCH n
    CASE ElementNode(e)
      s = resolveOne(e.tag, e.attrs, rules, inherited, ancestors)
      childAncestors = collections::append(ancestors, descOf(e))
      MUT kids AS List OF Node = []
      FOR EACH c IN e.children
        kids = collections::append(kids, rebuild(c, rules, s.textAlign, childAncestors))
      NEXT
      out = elementStyled(e.tag, e.attrs, kids, s)
    CASE ELSE
  END MATCH
  RETURN out
END FUNC

' Fill in every ElementNode.style across the document from the parsed CSS rules
' and inline styles. Call after parse() and attachCss().
EXPORT FUNC resolveStyles(doc AS Node) AS Node
  LET rules AS List OF StyleNode = docRules(doc)
  LET noAncestors AS List OF ElemDesc = []
  RETURN rebuild(doc, rules, Justify.FlexStart, noAncestors)
END FUNC
