' dom — a small HTML DOM for the browser example.
'
' Node is a union of three record variants:
'   ElementNode  a tag with attributes and child Nodes (the tree spine)
'   TextNode     a run of text
'   HeaderNode   a summary of the page <head>: title + script/style references
'
' parse() (in parse.mfb) turns HTML into a document: an ElementNode tagged
' "#document" whose first child is the HeaderNode and whose remaining children
' are the parsed body tree. The whole package is iterative — it never recurses
' over Node — because a recursive function over an imported union does not yet
' lower to native code across a package boundary (see the browser README).

IMPORT collections
IMPORT strings

' A tag with its HTML attributes, child nodes, resolved layout Style, and computed
' Layout. `style` is the CSS resolved for this element (see style.mfb); the parser
' fills it with defaultStyle() and a later style-resolution pass rebuilds elements
' with their cascaded styles. `layout` is the flex geometry computed *from* style by
' updateLayout (see layout.mfb) for a given viewport width; the parser and style
' resolution leave it at zeroLayout() and it is recomputed on each render/resize.
EXPORT TYPE ElementNode
  tag AS String
  attrs AS Map OF String TO String
  children AS List OF Node
  style AS Style
  layout AS Layout
END TYPE

' A styled range within a text run: the inclusive grapheme range [start, endIndex]
' of the run's text and the terminal attributes to apply over it — bold, underline,
' and a 0xRRGGBB foreground color (-1 = the default color). `href` is the link URL
' when the range is a hyperlink's text (empty otherwise) — the renderer uses it to
' expose links as navigation targets; the link's decorative [brackets] carry the same
' style but no href, so a link's target covers its text only. Built by the inline text
' gather from the tags a run flattens (a link → underlined + link color + href,
' <b>/<strong> → bold, <u>/<ins> → underline). Ranges are over the run's already-
' collapsed text, so they line up with what the renderer wraps and draws.
'
' `field` is the form-field ordinal when the range is an editable <input>'s box
' (-1 otherwise) — the twin of `href` for text entry: the renderer exposes the range
' as a focusable target and the app edits that field's value by ordinal (see
' indexFields / setFieldValue below). A range is a link or a field, never both in
' practice, but the two are independent so an <input> inside an <a> keeps both.
EXPORT TYPE TextSpan
  start AS Integer
  endIndex AS Integer
  bold AS Boolean
  underline AS Boolean
  color AS Integer
  href AS String
  field AS Integer
END TYPE

' A run of text. `layout` is the box the layout pass placed this run in (x, y in CSS
' px, width = the box it wraps to, height = its wrapped height); the parser leaves it
' at zeroLayout() and updateLayout fills it. `align` is the horizontal alignment of
' each wrapped line within that box (from the block's text-align). `spans` carries the
' run's per-range styling (see TextSpan) for a color/bold/underline-aware renderer; it
' is empty for plain text. A renderer draws the text at this box — element boxes are
' invisible containers in a text terminal, so the positioned text is what paints.
EXPORT TYPE TextNode
  text AS String
  layout AS Layout
  align AS Justify
  spans AS List OF TextSpan
END TYPE

' One parsed CSS rule: a selector and its property map (see parseCss in css.mfb).
' A plain standalone record — a consumer package (display) reads its fields
' directly even though it is reached only transitively through HeaderNode.rules
' (a field of a Node variant). That cross-package transitive read was opaque
' before the bug-435 fix, which is why this used to be a Node variant.
EXPORT TYPE StyleNode
  selector AS String
  props AS Map OF String TO String
END TYPE

EXPORT TYPE HeaderNode
  title AS String
  scripts AS List OF String
  styles AS List OF String
  css AS List OF String
  rules AS List OF StyleNode
END TYPE

EXPORT UNION Node
  ElementNode
  TextNode
  HeaderNode
END UNION

' ----- constructors (widen a member record to Node via a typed binding) -----

FUNC emptyAttrs() AS Map OF String TO String
  RETURN Map OF String TO String {}
END FUNC

' Build an element with the initial (unresolved) style and zero layout. Every
' element enters the tree this way during parsing; styles are resolved and layout
' is computed in later passes.
EXPORT FUNC element(tag AS String, attrs AS Map OF String TO String, children AS List OF Node) AS Node
  LET n AS Node = ElementNode[tag, attrs, children, defaultStyle(), zeroLayout()]
  RETURN n
END FUNC

' Build an element carrying an explicit resolved style (layout defaults to zero;
' it is recomputed by updateLayout). Used by style resolution and by rebuilds that
' must preserve an element's already-resolved style.
EXPORT FUNC elementStyled(tag AS String, attrs AS Map OF String TO String, children AS List OF Node, s AS Style) AS Node
  LET n AS Node = ElementNode[tag, attrs, children, s, zeroLayout()]
  RETURN n
END FUNC

' Build an element carrying both a resolved style and a computed layout. Used by
' the layout pass (updateLayout) to rebuild each element with its flex geometry.
EXPORT FUNC elementLaid(tag AS String, attrs AS Map OF String TO String, children AS List OF Node, s AS Style, box AS Layout) AS Node
  LET n AS Node = ElementNode[tag, attrs, children, s, box]
  RETURN n
END FUNC

EXPORT FUNC textNode(s AS String) AS Node
  LET n AS Node = TextNode[s, zeroLayout(), Justify.FlexStart, []]
  RETURN n
END FUNC

' Build a text run carrying its computed layout box, line alignment, and per-range
' styling (spans; empty for plain text). Used by updateLayout to place each run; the
' renderer reads the box + align + spans to paint the styled text at its position.
EXPORT FUNC textLaid(s AS String, box AS Layout, align AS Justify, spans AS List OF TextSpan) AS Node
  LET n AS Node = TextNode[s, box, align, spans]
  RETURN n
END FUNC

EXPORT FUNC styleNode(selector AS String, props AS Map OF String TO String) AS StyleNode
  RETURN StyleNode[selector, props]
END FUNC

EXPORT FUNC headerNode(title AS String, scripts AS List OF String, styles AS List OF String, css AS List OF String, rules AS List OF StyleNode) AS Node
  LET n AS Node = HeaderNode[title, scripts, styles, css, rules]
  RETURN n
END FUNC

' A valid but empty document, for error/placeholder states.
EXPORT FUNC emptyDocument() AS Node
  LET header AS Node = headerNode("", [], [], [], [])
  RETURN element("#document", emptyAttrs(), [header])
END FUNC

' Wrap plain (non-HTML) text as a one-text-node document.
EXPORT FUNC textDocument(s AS String) AS Node
  LET header AS Node = headerNode("", [], [], [], [])
  RETURN element("#document", emptyAttrs(), [header, textNode(s)])
END FUNC

' The external stylesheet links recorded on the header (the `styles` entries that
' are real hrefs, not "(inline …)" markers) — the URLs a caller should fetch.
EXPORT FUNC styleLinks(doc AS Node) AS List OF String
  MATCH doc
    CASE ElementNode(e)
      FOR EACH child IN e.children
        MATCH child
          CASE HeaderNode(h)
            MUT out AS List OF String = []
            FOR EACH ref IN h.styles
              IF NOT strings::startsWith(ref, "(") THEN
                out = collections::append(out, ref)
              END IF
            NEXT
            RETURN out
          CASE ELSE
        END MATCH
      NEXT
      RETURN []
    CASE ELSE
      RETURN []
  END MATCH
END FUNC

' Return the document with `extra` stylesheet bodies appended to its header: each
' raw text is kept in `css` and parsed into `rules` (records are immutable, so the
' header — the document's first child — is rebuilt). Used after a caller fetches
' the external stylesheets.
EXPORT FUNC attachCss(doc AS Node, extra AS List OF String) AS Node
  MATCH doc
    CASE ElementNode(e)
      MUT newKids AS List OF Node = []
      MUT patched AS Boolean = FALSE
      FOR EACH child IN e.children
        IF NOT patched THEN
          MATCH child
            CASE HeaderNode(h)
              MUT css AS List OF String = h.css
              MUT rules AS List OF StyleNode = h.rules
              FOR EACH text IN extra
                css = collections::append(css, text)
                FOR EACH rule IN parseCss(text)
                  rules = collections::append(rules, rule)
                NEXT
              NEXT
              newKids = collections::append(newKids, headerNode(h.title, h.scripts, h.styles, css, rules))
              patched = TRUE
            CASE ELSE
              newKids = collections::append(newKids, child)
          END MATCH
        ELSE
          newKids = collections::append(newKids, child)
        END IF
      NEXT
      RETURN elementStyled(e.tag, e.attrs, newKids, e.style)
    CASE ELSE
      RETURN doc
  END MATCH
END FUNC

' ----- form fields -----
'
' The document describes a page's form *structure*; it never holds what the reader
' types. indexFields stamps each editable <input> (see isEditableInput in layout.mfb)
' with its ordinal in document order as the `mfb-field` attribute, once, after
' parsing. That ordinal is the field's identity everywhere: it rides along through
' every style/layout rebuild, the inline gather tags the field box's glyphs with it,
' and the renderer hands it to the app as a focusable target.
'
' fieldSpecs then describes each field — which form it belongs to, the key it takes
' in that form's data, how it is drawn, and the value the page shipped it with — so
' an app can hold the live values in its own per-form data object and render a field
' from a spec plus a String. Keeping the values out of the tree is what makes typing
' cheap: recording a keystroke touches only the app's data, never this tree (rebuilding
' a page-sized tree costs hundreds of milliseconds and degrades as it is repeated).
' applyFieldValues folds those values back in for the one operation that does need a
' whole document — a full re-layout.
'
' These recurse over dom's own Node union, which is fine inside dom (only a consumer
' recursing over the imported union has to be iterative — see resolve.mfb).

' Rebuild `n`, stamping each editable <input> with its ordinal starting at `startAt`,
' and return the rebuilt node together with the first ordinal still free (`after`).
TYPE FieldWalk
  node AS Node
  after AS Integer
END TYPE

FUNC stampFields(n AS Node, startAt AS Integer) AS FieldWalk
  MUT out AS Node = n
  MUT counter AS Integer = startAt
  MATCH n
    CASE ElementNode(e)
      MUT attrs AS Map OF String TO String = e.attrs
      IF isEditableInput(e) THEN
        attrs = collections::set(attrs, fieldAttr(), toString(counter))
        counter = counter + 1
      END IF
      MUT kids AS List OF Node = []
      FOR EACH c IN e.children
        LET w AS FieldWalk = stampFields(c, counter)
        kids = collections::append(kids, w.node)
        counter = w.after
      NEXT
      out = elementStyled(e.tag, attrs, kids, e.style)
    CASE ELSE
  END MATCH
  RETURN FieldWalk[out, counter]
END FUNC

' Number every editable <input> in the document in document order, stamping each with
' its ordinal. Call once per loaded page, after resolveStyles (it preserves the
' resolved styles and leaves layout to be recomputed as usual).
EXPORT FUNC indexFields(doc AS Node) AS Node
  RETURN stampFields(doc, 0).node
END FUNC

' What an app needs to know about one editable field, without walking the tree.
'
' `ordinal` is the field's identity — its index in this list, the number stamped on
' the element, and the `field` on the display target the reader Tabs to. `form` is the
' index of the <form> that owns it (forms are numbered in document order; a field
' outside every <form> belongs to one extra implicit form, numbered last), and `key`
' is the name it takes inside that form's data — its `name` attribute, made unique
' within the form and synthesized when the element has no name. `kind` and `size` are
' how it draws, and `initial` is the value the page shipped it with.
EXPORT TYPE FieldSpec
  ordinal AS Integer
  form AS Integer
  key AS String
  kind AS String
  size AS Integer
  initial AS String
END TYPE

' Collect every editable field under `n`, in document order, tagged with the form it
' is inside (`formIdx`; -1 while outside any <form>). `forms` counts the <form>
' elements opened so far, so each one gets its own index.
TYPE SpecWalk
  specs AS List OF FieldSpec
  forms AS Integer
END TYPE

FUNC gatherSpecs(n AS Node, formIdx AS Integer, acc AS SpecWalk) AS SpecWalk
  MUT specs AS List OF FieldSpec = acc.specs
  MUT forms AS Integer = acc.forms
  MATCH n
    CASE ElementNode(e)
      MUT childForm AS Integer = formIdx
      IF e.tag = "form" THEN
        childForm = forms
        forms = forms + 1
      END IF
      IF isEditableInput(e) THEN
        specs = collections::append(specs, FieldSpec[ _
          fieldOrdinalOf(e), _
          childForm, _
          strings::trim(collections::getOr(e.attrs, "name", "")), _
          inputType(e), _
          attrInt(e.attrs, "size", 20), _
          collections::getOr(e.attrs, "value", "")])
      END IF
      MUT inner AS SpecWalk = SpecWalk[specs, forms]
      FOR EACH c IN e.children
        inner = gatherSpecs(c, childForm, inner)
      NEXT
      RETURN inner
    CASE ELSE
  END MATCH
  RETURN SpecWalk[specs, forms]
END FUNC

' Whether `key` is already taken by an earlier field of the same form.
FUNC keyTaken(specs AS List OF FieldSpec, form AS Integer, key AS String) AS Boolean
  FOR EACH sp IN specs
    IF sp.form = form AND sp.key = key THEN RETURN TRUE
  NEXT
  RETURN FALSE
END FUNC

' Every editable field on the page, in document order (so index == ordinal), with the
' form and data key each one takes. A field with no `name` gets a synthesized key, and
' a name already used by an earlier field of the same form is suffixed with the
' ordinal — two same-named text controls are two independent controls, so they must
' not share one entry in the form's data.
EXPORT FUNC fieldSpecs(doc AS Node) AS List OF FieldSpec
  LET none AS List OF FieldSpec = []
  LET walk AS SpecWalk = gatherSpecs(doc, -1, SpecWalk[none, 0])
  ' A field outside every <form> still needs somewhere to live: one implicit form,
  ' numbered after the real ones.
  LET loose AS Integer = walk.forms
  MUT out AS List OF FieldSpec = []
  FOR EACH sp IN walk.specs
    MUT form AS Integer = sp.form
    IF form < 0 THEN form = loose
    MUT key AS String = sp.key
    IF key = "" THEN key = "field" & toString(sp.ordinal)
    IF keyTaken(out, form, key) THEN key = key & "#" & toString(sp.ordinal)
    out = collections::append(out, FieldSpec[sp.ordinal, form, key, sp.kind, sp.size, sp.initial])
  NEXT
  RETURN out
END FUNC

' How many form data objects a page needs: one per <form>, plus one for the fields
' that sit outside every form (always allocated, so a form index is never out of
' range whether or not the page has loose fields).
EXPORT FUNC formCount(doc AS Node) AS Integer
  LET none AS List OF FieldSpec = []
  RETURN gatherSpecs(doc, -1, SpecWalk[none, 0]).forms + 1
END FUNC

' The box a field draws as when it holds `value` — "|S:cat-------|" and so on. The box
' is a fixed `size` columns wide whatever the value, so editing a field moves nothing
' else on the page: an app can redraw just this box over the field's rectangle instead
' of re-laying-out the page for every keystroke. It renders through the same code the
' full layout pass uses, so the two cannot disagree.
EXPORT FUNC fieldBox(spec AS FieldSpec, value AS String) AS String
  RETURN inputBoxOf(spec.kind, spec.size, value)
END FUNC

' Rebuild the document with each editable field's `value` attribute taken from
' `values` (indexed by field ordinal), so the layout pass draws the reader's data. The
' app holds the live values, so this is a render input, not a store — pass the result
' to the renderer and keep the original document as the page's own state.
EXPORT FUNC applyFieldValues(doc AS Node, values AS List OF String) AS Node
  IF len(values) = 0 THEN RETURN doc
  RETURN placeValues(doc, values)
END FUNC

FUNC placeValues(n AS Node, values AS List OF String) AS Node
  MUT out AS Node = n
  MATCH n
    CASE ElementNode(e)
      MUT attrs AS Map OF String TO String = e.attrs
      LET ord AS Integer = fieldOrdinalOf(e)
      IF ord >= 0 AND ord < len(values) THEN
        attrs = collections::set(attrs, "value", collections::get(values, ord))
      END IF
      MUT kids AS List OF Node = []
      FOR EACH c IN e.children
        kids = collections::append(kids, placeValues(c, values))
      NEXT
      out = elementStyled(e.tag, attrs, kids, e.style)
    CASE ELSE
  END MATCH
  RETURN out
END FUNC

' The page title: the HeaderNode child's title, or "" if there is none. Reads
' the document's direct children only — no recursion.
EXPORT FUNC title(doc AS Node) AS String
  MATCH doc
    CASE ElementNode(e)
      FOR EACH child IN e.children
        MATCH child
          CASE HeaderNode(h)
            RETURN h.title
          CASE ELSE
        END MATCH
      NEXT
      RETURN ""
    CASE ELSE
      RETURN ""
  END MATCH
END FUNC
