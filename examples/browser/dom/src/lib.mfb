' dom — a small HTML DOM for the browser example.
'
' Node is a union of three record variants:
'   ElementNode  a tag with attributes and child Nodes (the tree spine)
'   TextNode     a run of text
'   HeaderNode   a summary of the page <head>: title + script/style references
'
' parse() (in parse.mfb) turns HTML into a document: an ElementNode tagged
' "#document" whose first child is the HeaderNode and whose remaining children
' are the parsed body tree. The whole package is iterative — it never recurses
' over Node — because a recursive function over an imported union does not yet
' lower to native code across a package boundary (see the browser README).

IMPORT collections
IMPORT strings

' A tag with its HTML attributes, child nodes, resolved layout Style, and computed
' Layout. `style` is the CSS resolved for this element (see style.mfb); the parser
' fills it with defaultStyle() and a later style-resolution pass rebuilds elements
' with their cascaded styles. `layout` is the flex geometry computed *from* style by
' updateLayout (see layout.mfb) for a given viewport width; the parser and style
' resolution leave it at zeroLayout() and it is recomputed on each render/resize.
EXPORT TYPE ElementNode
  tag AS String
  attrs AS Map OF String TO String
  children AS List OF Node
  style AS Style
  layout AS Layout
END TYPE

' A styled range within a text run: the inclusive grapheme range [start, endIndex]
' of the run's text and the terminal attributes to apply over it — bold, underline,
' and a 0xRRGGBB foreground color (-1 = the default color). Built by the inline text
' gather from the tags a run flattens (a link → underlined + link color, <b>/<strong>
' → bold, <u>/<ins> → underline) and consumed by the renderer to build an
' AttributedString. Ranges are over the run's already-collapsed text, so they line up
' with what the renderer wraps and draws.
EXPORT TYPE TextSpan
  start AS Integer
  endIndex AS Integer
  bold AS Boolean
  underline AS Boolean
  color AS Integer
END TYPE

' A run of text. `layout` is the box the layout pass placed this run in (x, y in CSS
' px, width = the box it wraps to, height = its wrapped height); the parser leaves it
' at zeroLayout() and updateLayout fills it. `align` is the horizontal alignment of
' each wrapped line within that box (from the block's text-align). `spans` carries the
' run's per-range styling (see TextSpan) for a color/bold/underline-aware renderer; it
' is empty for plain text. A renderer draws the text at this box — element boxes are
' invisible containers in a text terminal, so the positioned text is what paints.
EXPORT TYPE TextNode
  text AS String
  layout AS Layout
  align AS Justify
  spans AS List OF TextSpan
END TYPE

' One parsed CSS rule: a selector and its property map (see parseCss in css.mfb).
' A plain standalone record — a consumer package (display) reads its fields
' directly even though it is reached only transitively through HeaderNode.rules
' (a field of a Node variant). That cross-package transitive read was opaque
' before the bug-435 fix, which is why this used to be a Node variant.
EXPORT TYPE StyleNode
  selector AS String
  props AS Map OF String TO String
END TYPE

EXPORT TYPE HeaderNode
  title AS String
  scripts AS List OF String
  styles AS List OF String
  css AS List OF String
  rules AS List OF StyleNode
END TYPE

EXPORT UNION Node
  ElementNode
  TextNode
  HeaderNode
END UNION

' ----- constructors (widen a member record to Node via a typed binding) -----

FUNC emptyAttrs() AS Map OF String TO String
  RETURN Map OF String TO String {}
END FUNC

' Build an element with the initial (unresolved) style and zero layout. Every
' element enters the tree this way during parsing; styles are resolved and layout
' is computed in later passes.
EXPORT FUNC element(tag AS String, attrs AS Map OF String TO String, children AS List OF Node) AS Node
  LET n AS Node = ElementNode[tag, attrs, children, defaultStyle(), zeroLayout()]
  RETURN n
END FUNC

' Build an element carrying an explicit resolved style (layout defaults to zero;
' it is recomputed by updateLayout). Used by style resolution and by rebuilds that
' must preserve an element's already-resolved style.
EXPORT FUNC elementStyled(tag AS String, attrs AS Map OF String TO String, children AS List OF Node, s AS Style) AS Node
  LET n AS Node = ElementNode[tag, attrs, children, s, zeroLayout()]
  RETURN n
END FUNC

' Build an element carrying both a resolved style and a computed layout. Used by
' the layout pass (updateLayout) to rebuild each element with its flex geometry.
EXPORT FUNC elementLaid(tag AS String, attrs AS Map OF String TO String, children AS List OF Node, s AS Style, box AS Layout) AS Node
  LET n AS Node = ElementNode[tag, attrs, children, s, box]
  RETURN n
END FUNC

EXPORT FUNC textNode(s AS String) AS Node
  LET n AS Node = TextNode[s, zeroLayout(), Justify.FlexStart, []]
  RETURN n
END FUNC

' Build a text run carrying its computed layout box, line alignment, and per-range
' styling (spans; empty for plain text). Used by updateLayout to place each run; the
' renderer reads the box + align + spans to paint the styled text at its position.
EXPORT FUNC textLaid(s AS String, box AS Layout, align AS Justify, spans AS List OF TextSpan) AS Node
  LET n AS Node = TextNode[s, box, align, spans]
  RETURN n
END FUNC

EXPORT FUNC styleNode(selector AS String, props AS Map OF String TO String) AS StyleNode
  RETURN StyleNode[selector, props]
END FUNC

EXPORT FUNC headerNode(title AS String, scripts AS List OF String, styles AS List OF String, css AS List OF String, rules AS List OF StyleNode) AS Node
  LET n AS Node = HeaderNode[title, scripts, styles, css, rules]
  RETURN n
END FUNC

' A valid but empty document, for error/placeholder states.
EXPORT FUNC emptyDocument() AS Node
  LET header AS Node = headerNode("", [], [], [], [])
  RETURN element("#document", emptyAttrs(), [header])
END FUNC

' Wrap plain (non-HTML) text as a one-text-node document.
EXPORT FUNC textDocument(s AS String) AS Node
  LET header AS Node = headerNode("", [], [], [], [])
  RETURN element("#document", emptyAttrs(), [header, textNode(s)])
END FUNC

' The external stylesheet links recorded on the header (the `styles` entries that
' are real hrefs, not "(inline …)" markers) — the URLs a caller should fetch.
EXPORT FUNC styleLinks(doc AS Node) AS List OF String
  MATCH doc
    CASE ElementNode(e)
      FOR EACH child IN e.children
        MATCH child
          CASE HeaderNode(h)
            MUT out AS List OF String = []
            FOR EACH ref IN h.styles
              IF NOT strings::startsWith(ref, "(") THEN
                out = collections::append(out, ref)
              END IF
            NEXT
            RETURN out
          CASE ELSE
        END MATCH
      NEXT
      RETURN []
    CASE ELSE
      RETURN []
  END MATCH
END FUNC

' Return the document with `extra` stylesheet bodies appended to its header: each
' raw text is kept in `css` and parsed into `rules` (records are immutable, so the
' header — the document's first child — is rebuilt). Used after a caller fetches
' the external stylesheets.
EXPORT FUNC attachCss(doc AS Node, extra AS List OF String) AS Node
  MATCH doc
    CASE ElementNode(e)
      MUT newKids AS List OF Node = []
      MUT patched AS Boolean = FALSE
      FOR EACH child IN e.children
        IF NOT patched THEN
          MATCH child
            CASE HeaderNode(h)
              MUT css AS List OF String = h.css
              MUT rules AS List OF StyleNode = h.rules
              FOR EACH text IN extra
                css = collections::append(css, text)
                FOR EACH rule IN parseCss(text)
                  rules = collections::append(rules, rule)
                NEXT
              NEXT
              newKids = collections::append(newKids, headerNode(h.title, h.scripts, h.styles, css, rules))
              patched = TRUE
            CASE ELSE
              newKids = collections::append(newKids, child)
          END MATCH
        ELSE
          newKids = collections::append(newKids, child)
        END IF
      NEXT
      RETURN elementStyled(e.tag, e.attrs, newKids, e.style)
    CASE ELSE
      RETURN doc
  END MATCH
END FUNC

' The page title: the HeaderNode child's title, or "" if there is none. Reads
' the document's direct children only — no recursion.
EXPORT FUNC title(doc AS Node) AS String
  MATCH doc
    CASE ElementNode(e)
      FOR EACH child IN e.children
        MATCH child
          CASE HeaderNode(h)
            RETURN h.title
          CASE ELSE
        END MATCH
      NEXT
      RETURN ""
    CASE ELSE
      RETURN ""
  END MATCH
END FUNC
