' fetch — the browser example's network worker.
'
' http::read is blocking: it freezes the calling thread until the whole exchange
' finishes. To keep the UI (and its loading spinner) alive, the app runs this on
' a separate OS thread via thread::start(fetch::fetch, url) and polls
' thread::isRunning while animating. thread::start accepts any ISOLATED FUNC —
' one the caller's own project declares, or an EXPORT ISOLATED FUNC of an
' imported package — so the fetch lives in its own package for the same reason
' dom and display do: it is one self-contained concern, reusable outside this app.
'
' The worker fetches the URL (following redirects), parses it into a DOM, and
' returns the document Node — so both the network and the parse stay off the UI
' thread, and the whole recursive Node tree is deep-copied back to the app.

IMPORT collections
IMPORT datetime
IMPORT dom
IMPORT http
IMPORT net
IMPORT os
IMPORT strings
IMPORT thread

' The outcome of one load attempt. On success `document` is the parsed DOM and
' `title` is its <title>; on failure `ok` is FALSE, `message` holds the error,
' and `document` is an empty document. filesLoaded / filesTotal count the
' resources fetched (one document today). A recursive dom::Node crosses the
' thread boundary because thread transfer now deep-copies recursive values.
EXPORT TYPE LoadResult
  ok AS Boolean
  document AS dom::Node
  title AS String
  message AS String
  secure AS Boolean
  filesLoaded AS Integer
  filesTotal AS Integer
END TYPE

' Give a bare host an https scheme so net::toUrl accepts it.
FUNC ensureScheme(u AS String) AS String
  IF strings::contains(u, "://") THEN RETURN u
  RETURN "https://" & u
END FUNC

' A response the client should follow to a new location. http:: returns 3xx
' as-is (it never follows), so the worker follows them itself.
FUNC isRedirect(resp AS http::Response) AS Boolean
  LET s AS Integer = resp.status
  RETURN s = 301 OR s = 302 OR s = 303 OR s = 307 OR s = 308
END FUNC

' Index of the last "/" in s, or -1 if none (strings has no reverse find).
FUNC lastSlash(s AS String) AS Integer
  MUT idx AS Integer = -1
  MUT i AS Integer = 0
  LET n AS Integer = len(s)
  DO WHILE i < n
    IF strings::mid(s, i, 1) = "/" THEN idx = i
    i = i + 1
  LOOP
  RETURN idx
END FUNC

' Index of the first occurrence of ch (a single character) in s at or after
' start, or -1 if none.
FUNC indexOfFrom(s AS String, ch AS String, start AS Integer) AS Integer
  MUT i AS Integer = start
  LET n AS Integer = len(s)
  DO WHILE i < n
    IF strings::mid(s, i, 1) = ch THEN RETURN i
    i = i + 1
  LOOP
  RETURN -1
END FUNC

' Whether c is one of the characters a URI scheme's first character may be
' (RFC 3986 3.1: ALPHA).
FUNC isSchemeStart(c AS String) AS Boolean
  RETURN strings::contains("abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ", c)
END FUNC

' Whether c is one of the characters allowed after a URI scheme's first
' character (RFC 3986 3.1: ALPHA / DIGIT / "+" / "-" / ".").
FUNC isSchemeChar(c AS String) AS Boolean
  RETURN strings::contains("abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789+-.", c)
END FUNC

' Whether s has a leading URI scheme — a run of scheme characters starting
' with a letter, terminated by ":" — before any "/", "?", or "#". This is the
' RFC 3986 3.1 test for "is this reference absolute", unlike scanning the
' whole string for "://" anywhere (which a relative href's query string can
' contain, e.g. "search?next=http://example/x").
FUNC hasLeadingScheme(s AS String) AS Boolean
  LET n AS Integer = len(s)
  IF n = 0 THEN RETURN FALSE
  IF NOT isSchemeStart(strings::mid(s, 0, 1)) THEN RETURN FALSE
  MUT i AS Integer = 1
  DO WHILE i < n
    LET c AS String = strings::mid(s, i, 1)
    IF c = ":" THEN RETURN TRUE
    IF c = "/" OR c = "?" OR c = "#" THEN RETURN FALSE
    IF NOT isSchemeChar(c) THEN RETURN FALSE
    i = i + 1
  LOOP
  RETURN FALSE
END FUNC

' Remove path's last "/"-segment (and its trailing slash), or "" if it has no
' "/" at all.
FUNC removeLastSegment(path AS String) AS String
  LET slash AS Integer = lastSlash(path)
  IF slash < 0 THEN RETURN ""
  RETURN strings::mid(path, 0, slash)
END FUNC

' RFC 3986 5.2.4 "remove_dot_segments", applied to an absolute (leading "/")
' merged path: removes "." and ".." segments in place, the same way a
' conforming URI resolver would before treating the result as the effective
' path of a merged reference.
FUNC removeDotSegments(pathIn AS String) AS String
  MUT input AS String = pathIn
  MUT output AS String = ""
  DO WHILE input <> ""
    IF strings::startsWith(input, "../") THEN
      input = strings::mid(input, 3, len(input) - 3)
    ELSEIF strings::startsWith(input, "./") THEN
      input = strings::mid(input, 2, len(input) - 2)
    ELSEIF strings::startsWith(input, "/./") THEN
      input = "/" & strings::mid(input, 3, len(input) - 3)
    ELSEIF input = "/." THEN
      input = "/"
    ELSEIF strings::startsWith(input, "/../") THEN
      input = "/" & strings::mid(input, 4, len(input) - 4)
      output = removeLastSegment(output)
    ELSEIF input = "/.." THEN
      input = "/"
      output = removeLastSegment(output)
    ELSEIF input = "." OR input = ".." THEN
      input = ""
    ELSE
      ' Move the first path segment (through, but not including, the next
      ' "/") from input to output.
      LET nextSlash AS Integer = indexOfFrom(input, "/", 1)
      IF nextSlash < 0 THEN
        output = output & input
        input = ""
      ELSE
        output = output & strings::mid(input, 0, nextSlash)
        input = strings::mid(input, nextSlash, len(input) - nextSlash)
      END IF
    END IF
  LOOP
  RETURN output
END FUNC

' Resolve a Location header or link href against the request URL, per RFC 3986
' §5.3 (Component Recomposition): a reference with a leading scheme is already
' absolute and is returned unchanged; a network-path reference ("//host/...")
' keeps the base's scheme; a root-relative path ("/x") keeps the base's
' authority; a query-only ("?x") or fragment-only ("#x") reference keeps the
' base's own path (and, for a fragment-only reference, the base's query too —
' RFC 3986 5.3 only replaces the query when the reference supplies one); and
' anything else is merged against the base's directory. The merged path always
' passes through remove_dot_segments (§5.2.4) before being returned.
FUNC resolveLocation(base AS net::Url, loc AS String) AS String
  LET target AS String = strings::trim(loc)
  IF hasLeadingScheme(target) THEN RETURN target
  IF strings::startsWith(target, "//") THEN
    RETURN base.scheme & ":" & target
  END IF
  LET authority AS String = base.scheme & "://" & base.host & ":" & toString(base.port)

  ' Split the reference into its path/query/fragment parts. A fragment or
  ' query can legally contain "/", "?", or even "://" — only the part of the
  ' string before the first "#" or "?" is ever treated as a path.
  MUT rest AS String = target
  MUT fragment AS String = ""
  LET hashIdx AS Integer = indexOfFrom(rest, "#", 0)
  IF hashIdx >= 0 THEN
    fragment = strings::mid(rest, hashIdx + 1, len(rest) - hashIdx - 1)
    rest = strings::mid(rest, 0, hashIdx)
  END IF
  MUT query AS String = ""
  LET qIdx AS Integer = indexOfFrom(rest, "?", 0)
  IF qIdx >= 0 THEN
    query = strings::mid(rest, qIdx + 1, len(rest) - qIdx - 1)
    rest = strings::mid(rest, 0, qIdx)
  END IF

  MUT mergedPath AS String = ""
  IF rest = "" THEN
    mergedPath = base.path
    IF qIdx < 0 THEN query = base.query
  ELSEIF strings::startsWith(rest, "/") THEN
    mergedPath = removeDotSegments(rest)
  ELSE
    MUT dir AS String = base.path
    LET slash AS Integer = lastSlash(dir)
    IF slash >= 0 THEN
      dir = strings::mid(dir, 0, slash + 1)
    ELSE
      dir = "/"
    END IF
    mergedPath = removeDotSegments(dir & rest)
  END IF

  MUT result AS String = authority & mergedPath
  IF query <> "" THEN result = result & "?" & query
  IF fragment <> "" THEN result = result & "#" & fragment
  RETURN result
END FUNC

' Resolve a link href against the current page URL, returning an absolute URL the app
' can load. Wraps resolveLocation with URL parsing (a relative href becomes absolute,
' an already-absolute one is returned as-is); on a malformed base the raw href is
' returned unchanged.
EXPORT FUNC resolveHref(baseUrl AS String, href AS String) AS String
  LET abs AS String = resolveLocation(net::toUrl(ensureScheme(baseUrl)), href) TRAP(e)
    RECOVER href
  END TRAP
  RETURN abs
END FUNC

' The result of fetching a page's stylesheets: the CSS bodies to parse into rules
' (only the non-empty ones — an empty sheet has no rules) and how many sheets
' actually loaded (which is what the footer's Files count reports).
TYPE SheetLoad
  texts AS List OF String
  loaded AS Integer
END TYPE

' Whether one stylesheet response counts as loaded: the exchange completed with
' HTTP 200 and the whole declared body arrived — the received byte count equals the
' Content-Length. A response with no Content-Length (a chunked body) counts on a
' successful finish alone, since http::finish already requires the terminating chunk.
' This excludes non-200s (a redirect or 404 error page that finish still returns) and
' any short read, and — unlike a non-empty-body test — counts a valid empty sheet
' (a 200 with Content-Length: 0, as google.com serves for one of its <link>s).
FUNC sheetLoaded(resp AS http::Response) AS Boolean
  IF resp.status <> 200 THEN RETURN FALSE
  LET cl AS String = strings::trim(collections::getOr(resp.headers, "content-length", ""))
  IF cl = "" THEN RETURN TRUE
  LET declared AS Integer = toInt(cl, 10) TRAP(e)
    RECOVER -1
  END TRAP
  IF declared < 0 THEN RETURN TRUE
  RETURN len(resp.body) = declared
END FUNC

' Fetch several external stylesheets concurrently and return their texts.
'
' Blocking http::read would fetch them one after another. Instead each sheet is
' started with http::startRead, which opens its connection and writes its
' request up front and returns a drivable http::Stream without waiting — so all
' the requests are in flight at once. The streams are collected into a
' List OF RES http::Stream STATE PendingState (a resource per open connection),
' then driven cooperatively: one pass over the list per round pumps only the
' streams that have bytes ready, so a slow sheet never blocks a fast one, until
' every stream is http::done. Finally each completed stream is parsed with
' http::finish into its response body.
'
' A stylesheet whose URL is malformed, whose connection fails, whose response
' errors, or whose exchange never completes within the drive deadline below is
' simply skipped, matching a page that renders without it. The returned list
' holds only the CSS bodies that were fetched successfully. The whole streams
' list is owned by this function's scope, so every connection is closed
' exactly once when it returns.
FUNC fetchStyles(base AS net::Url, hrefs AS List OF String) AS SheetLoad
  MUT streams AS List OF RES http::Stream STATE http::PendingState = []

  ' Kick off every request. A sheet that cannot even connect is left out of the
  ' drive set; the diverging TRAP handler means its handle is never added.
  FOR EACH href IN hrefs
    RES s AS http::Stream STATE http::PendingState = http::startRead(net::toUrl(resolveLocation(base, href))) TRAP(e)
      CONTINUE FOR
    END TRAP
    streams = collections::append(streams, s)
  NEXT

  ' Drive all streams together until each has completed, the batch's overall
  ' deadline elapses, or (independently of the deadline) between rounds that
  ' made no progress, back off instead of busy-spinning: http::ready/http::pump
  ' never block (mfb man http ready/pump), so a round that finds nothing ready
  ' would otherwise re-poll at full speed forever. `pending` stays TRUE while
  ' any stream still needs more bytes; a stream still incomplete once the
  ' deadline elapses is left un-done and is skipped below, exactly like a sheet
  ' that failed to connect. The 30-second budget matches http::startRead's own
  ' connect deadline for consistency (mfb man http startRead).
  LET deadlineNanos AS Integer = 30 * 1000000000
  LET startedAt AS Integer = datetime::monotonicNanos()
  MUT pending AS Boolean = TRUE
  DO WHILE pending
    pending = FALSE
    MUT progressed AS Boolean = FALSE
    FOR EACH s IN streams
      IF http::done(s) = FALSE THEN
        IF http::ready(s) THEN
          http::pump(s)
          progressed = TRUE
        END IF
        pending = TRUE
      END IF
    NEXT
    IF pending THEN
      IF datetime::monotonicNanos() - startedAt > deadlineNanos THEN
        pending = FALSE
      ELSEIF NOT progressed THEN
        os::sleep(10)
      END IF
    END IF
  LOOP

  ' Parse each completed stream; drop any whose exchange failed or never
  ' finished within the deadline above. A sheet counts as loaded on a complete
  ' HTTP 200 (see sheetLoaded); its body is kept for rule parsing only when
  ' non-empty.
  MUT cssTexts AS List OF String = []
  MUT loaded AS Integer = 0
  FOR EACH s IN streams
    IF http::done(s) = FALSE THEN CONTINUE FOR
    LET resp AS http::Response = http::finish(s) TRAP(e)
      CONTINUE FOR
    END TRAP
    IF sheetLoaded(resp) THEN loaded = loaded + 1
    LET css AS String = toString(resp.body)
    IF css <> "" THEN cssTexts = collections::append(cssTexts, css)
  NEXT
  RETURN SheetLoad[cssTexts, loaded]
END FUNC

' Turn a final response into a LoadResult: parse HTML into a DOM, fetch its
' external stylesheets, and attach every CSS body (parsed into rules) to the
' document header. A non-HTML body (JSON, plain text, CSS) is wrapped as a
' one-text-node document. filesLoaded/filesTotal count the HTML plus each
' stylesheet fetched.
FUNC pageResult(resp AS http::Response, u AS net::Url, secure AS Boolean) AS LoadResult
  LET body AS String = toString(resp.body)
  LET ctype AS String = collections::getOr(resp.headers, "content-type", "")
  IF NOT (strings::contains(ctype, "html") OR ctype = "") THEN
    RETURN LoadResult[TRUE, dom::textDocument(body), "", "", secure, 1, 1]
  END IF
  MUT document AS dom::Node = dom::parse(body)
  LET links AS List OF String = dom::styleLinks(document)
  LET sheets AS SheetLoad = fetchStyles(u, links)
  ' filesLoaded/filesTotal count the HTML (always loaded here) plus each linked
  ' stylesheet; a sheet counts as loaded on a complete HTTP 200 (see sheetLoaded).
  LET loaded AS Integer = 1 + sheets.loaded
  LET total AS Integer = 1 + len(links)
  document = dom::attachCss(document, sheets.texts)
  ' Resolve each element's Style from the parsed rules + inline styles now, on the
  ' worker thread, so the fully-styled document is deep-copied back to the UI.
  document = dom::resolveStyles(document)
  ' Number the page's editable <input>s so the app can focus and type into them; the
  ' ordinal rides along on each field through every later layout pass.
  document = dom::indexFields(document)
  RETURN LoadResult[TRUE, document, dom::title(document), "", secure, loaded, total]
END FUNC

' Fetch a URL, following up to 10 redirects, then parse it into a DOM. Any
' failure — a malformed URL, DNS/TLS/transport error, a non-UTF-8 body, or a
' redirect loop — is caught and returned as an error LoadResult.
'
' The ISOLATED worker entry point started by thread::start. Its first parameter
' is the runtime-provided ThreadWorker handle (unused — the result is returned,
' not sent as a message); the second is the URL to load.
EXPORT ISOLATED FUNC fetch(worker AS ThreadWorker OF String TO LoadResult, rawUrl AS String) AS LoadResult
  LET trimmed AS String = strings::trim(rawUrl)
  IF trimmed = "" THEN
    RETURN LoadResult[FALSE, dom::emptyDocument(), "", "No address entered. Press G and type a URL.", FALSE, 0, 0]
  END IF
  MUT href AS String = ensureScheme(trimmed)
  FOR hop = 0 TO 10
    LET u AS net::Url = net::toUrl(href)
    LET resp AS http::Response = http::read(u)
    LET loc AS String = collections::getOr(resp.headers, "location", "")
    IF NOT isRedirect(resp) OR loc = "" THEN
      RETURN pageResult(resp, u, u.scheme = "https")
    END IF
    href = resolveLocation(u, loc)
  NEXT
  RETURN LoadResult[FALSE, dom::emptyDocument(), "", "Too many redirects while loading " & rawUrl, FALSE, 0, 1]

  TRAP(e)
    RETURN LoadResult[FALSE, dom::emptyDocument(), "", "Error loading " & rawUrl & "\n\n" & e.message, FALSE, 0, 1]
  END TRAP
END FUNC
