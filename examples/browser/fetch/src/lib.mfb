' fetch — the browser example's network worker.
'
' http::read is blocking: it freezes the calling thread until the whole exchange
' finishes. To keep the UI (and its loading spinner) alive, the app runs this on
' a separate OS thread via thread::start(fetch::fetch, url) and polls
' thread::isRunning while animating. thread::start requires an ISOLATED worker
' exported from an imported package, which is why the fetch lives here.
'
' The worker fetches the URL (following redirects), parses it into a DOM, and
' returns the document Node — so both the network and the parse stay off the UI
' thread, and the whole recursive Node tree is deep-copied back to the app.

IMPORT collections
IMPORT dom
IMPORT http
IMPORT net
IMPORT strings
IMPORT thread

' The outcome of one load attempt. On success `document` is the parsed DOM and
' `title` is its <title>; on failure `ok` is FALSE, `message` holds the error,
' and `document` is an empty document. filesLoaded / filesTotal count the
' resources fetched (one document today). A recursive dom::Node crosses the
' thread boundary because thread transfer now deep-copies recursive values.
EXPORT TYPE LoadResult
  ok AS Boolean
  document AS Node
  title AS String
  message AS String
  secure AS Boolean
  filesLoaded AS Integer
  filesTotal AS Integer
END TYPE

' Give a bare host an https scheme so net::toUrl accepts it.
FUNC ensureScheme(u AS String) AS String
  IF strings::contains(u, "://") THEN RETURN u
  RETURN "https://" & u
END FUNC

' A response the client should follow to a new location. http:: returns 3xx
' as-is (it never follows), so the worker follows them itself.
FUNC isRedirect(resp AS http::Response) AS Boolean
  LET s AS Integer = resp.status
  RETURN s = 301 OR s = 302 OR s = 303 OR s = 307 OR s = 308
END FUNC

' Index of the last "/" in s, or -1 if none (strings has no reverse find).
FUNC lastSlash(s AS String) AS Integer
  MUT idx AS Integer = -1
  MUT i AS Integer = 0
  LET n AS Integer = len(s)
  DO WHILE i < n
    IF strings::mid(s, i, 1) = "/" THEN idx = i
    i = i + 1
  LOOP
  RETURN idx
END FUNC

' Resolve a Location header against the request URL: an absolute URL, a
' root-relative path ("/x"), or a path relative to the current directory.
FUNC resolveLocation(base AS net::Url, loc AS String) AS String
  LET target AS String = strings::trim(loc)
  IF strings::contains(target, "://") THEN RETURN target
  LET authority AS String = base.scheme & "://" & base.host & ":" & toString(base.port)
  IF strings::startsWith(target, "//") THEN 
    RETURN base.scheme & ":" & target
  ELSEIF strings::startsWith(target, "/") THEN 
    RETURN authority & target
  END IF
  MUT dir AS String = base.path
  LET slash AS Integer = lastSlash(dir)
  IF slash >= 0 THEN
    dir = strings::mid(dir, 0, slash + 1)
  ELSE
    dir = "/"
  END IF
  RETURN authority & dir & target
END FUNC

' Resolve a link href against the current page URL, returning an absolute URL the app
' can load. Wraps resolveLocation with URL parsing (a relative href becomes absolute,
' an already-absolute one is returned as-is); on a malformed base the raw href is
' returned unchanged.
EXPORT FUNC resolveHref(baseUrl AS String, href AS String) AS String
  LET abs AS String = resolveLocation(net::toUrl(ensureScheme(baseUrl)), href) TRAP(e)
    RECOVER href
  END TRAP
  RETURN abs
END FUNC

' The result of fetching a page's stylesheets: the CSS bodies to parse into rules
' (only the non-empty ones — an empty sheet has no rules) and how many sheets
' actually loaded (which is what the footer's Files count reports).
TYPE SheetLoad
  texts AS List OF String
  loaded AS Integer
END TYPE

' Whether one stylesheet response counts as loaded: the exchange completed with
' HTTP 200 and the whole declared body arrived — the received byte count equals the
' Content-Length. A response with no Content-Length (a chunked body) counts on a
' successful finish alone, since http::finish already requires the terminating chunk.
' This excludes non-200s (a redirect or 404 error page that finish still returns) and
' any short read, and — unlike a non-empty-body test — counts a valid empty sheet
' (a 200 with Content-Length: 0, as google.com serves for one of its <link>s).
FUNC sheetLoaded(resp AS http::Response) AS Boolean
  IF resp.status <> 200 THEN RETURN FALSE
  LET cl AS String = strings::trim(collections::getOr(resp.headers, "content-length", ""))
  IF cl = "" THEN RETURN TRUE
  LET declared AS Integer = toInt(cl, 10) TRAP(e)
    RECOVER -1
  END TRAP
  IF declared < 0 THEN RETURN TRUE
  RETURN len(resp.body) = declared
END FUNC

' Fetch several external stylesheets concurrently and return their texts.
'
' Blocking http::read would fetch them one after another. Instead each sheet is
' started with http::startRead, which opens its connection and writes its
' request up front and returns a drivable http::Stream without waiting — so all
' the requests are in flight at once. The streams are collected into a
' List OF RES http::Stream STATE PendingState (a resource per open connection),
' then driven cooperatively: one pass over the list per round pumps only the
' streams that have bytes ready, so a slow sheet never blocks a fast one, until
' every stream is http::done. Finally each completed stream is parsed with
' http::finish into its response body.
'
' A stylesheet whose URL is malformed, whose connection fails, or whose response
' errors is simply skipped, matching a page that renders without it. The
' returned list holds only the CSS bodies that were fetched successfully. The
' whole streams list is owned by this function's scope, so every connection is
' closed exactly once when it returns.
FUNC fetchStyles(base AS net::Url, hrefs AS List OF String) AS SheetLoad
  MUT streams AS List OF RES http::Stream STATE PendingState = []

  ' Kick off every request. A sheet that cannot even connect is left out of the
  ' drive set; the diverging TRAP handler means its handle is never added.
  FOR EACH href IN hrefs
    RES s AS http::Stream STATE PendingState = http::startRead(net::toUrl(resolveLocation(base, href))) TRAP(e)
      CONTINUE FOR
    END TRAP
    streams = collections::append(streams, s)
  NEXT

  ' Drive all streams together until each has completed. Each round pumps only
  ' the streams with data ready, so no single stream is blocked on waiting for
  ' another; `pending` stays TRUE while any stream still needs more bytes.
  MUT pending AS Boolean = TRUE
  DO WHILE pending
    pending = FALSE
    FOR EACH s IN streams
      IF http::done(s) = FALSE THEN
        IF http::ready(s) THEN http::pump(s)
        pending = TRUE
      END IF
    NEXT
  LOOP

  ' Parse each completed stream; drop any whose exchange failed. A sheet counts as
  ' loaded on a complete HTTP 200 (see sheetLoaded); its body is kept for rule parsing
  ' only when non-empty.
  MUT cssTexts AS List OF String = []
  MUT loaded AS Integer = 0
  FOR EACH s IN streams
    LET resp AS http::Response = http::finish(s) TRAP(e)
      CONTINUE FOR
    END TRAP
    IF sheetLoaded(resp) THEN loaded = loaded + 1
    LET css AS String = toString(resp.body)
    IF css <> "" THEN cssTexts = collections::append(cssTexts, css)
  NEXT
  RETURN SheetLoad[cssTexts, loaded]
END FUNC

' Turn a final response into a LoadResult: parse HTML into a DOM, fetch its
' external stylesheets, and attach every CSS body (parsed into rules) to the
' document header. A non-HTML body (JSON, plain text, CSS) is wrapped as a
' one-text-node document. filesLoaded/filesTotal count the HTML plus each
' stylesheet fetched.
FUNC pageResult(resp AS http::Response, u AS net::Url, secure AS Boolean) AS LoadResult
  LET body AS String = toString(resp.body)
  LET ctype AS String = collections::getOr(resp.headers, "content-type", "")
  IF NOT (strings::contains(ctype, "html") OR ctype = "") THEN
    RETURN LoadResult[TRUE, dom::textDocument(body), "", "", secure, 1, 1]
  END IF
  MUT document AS Node = dom::parse(body)
  LET links AS List OF String = dom::styleLinks(document)
  LET sheets AS SheetLoad = fetchStyles(u, links)
  ' filesLoaded/filesTotal count the HTML (always loaded here) plus each linked
  ' stylesheet; a sheet counts as loaded on a complete HTTP 200 (see sheetLoaded).
  LET loaded AS Integer = 1 + sheets.loaded
  LET total AS Integer = 1 + len(links)
  document = dom::attachCss(document, sheets.texts)
  ' Resolve each element's Style from the parsed rules + inline styles now, on the
  ' worker thread, so the fully-styled document is deep-copied back to the UI.
  document = dom::resolveStyles(document)
  RETURN LoadResult[TRUE, document, dom::title(document), "", secure, loaded, total]
END FUNC

' Fetch a URL, following up to 10 redirects, then parse it into a DOM. Any
' failure — a malformed URL, DNS/TLS/transport error, a non-UTF-8 body, or a
' redirect loop — is caught and returned as an error LoadResult.
'
' The ISOLATED worker entry point started by thread::start. Its first parameter
' is the runtime-provided ThreadWorker handle (unused — the result is returned,
' not sent as a message); the second is the URL to load.
EXPORT ISOLATED FUNC fetch(worker AS ThreadWorker OF String TO LoadResult, rawUrl AS String) AS LoadResult
  LET trimmed AS String = strings::trim(rawUrl)
  IF trimmed = "" THEN
    RETURN LoadResult[FALSE, dom::emptyDocument(), "", "No address entered. Press G and type a URL.", FALSE, 0, 0]
  END IF
  MUT href AS String = ensureScheme(trimmed)
  FOR hop = 0 TO 10
    LET u AS net::Url = net::toUrl(href)
    LET resp AS http::Response = http::read(u)
    LET loc AS String = collections::getOr(resp.headers, "location", "")
    IF NOT isRedirect(resp) OR loc = "" THEN
      RETURN pageResult(resp, u, u.scheme = "https")
    END IF
    href = resolveLocation(u, loc)
  NEXT
  RETURN LoadResult[FALSE, dom::emptyDocument(), "", "Too many redirects while loading " & rawUrl, FALSE, 0, 1]

  TRAP(e)
    RETURN LoadResult[FALSE, dom::emptyDocument(), "", "Error loading " & rawUrl & "\n\n" & e.message, FALSE, 0, 1]
  END TRAP
END FUNC
