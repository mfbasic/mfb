IMPORT astrings
IMPORT collections
IMPORT display
IMPORT dom
IMPORT fetch
IMPORT io
IMPORT strings
IMPORT term
IMPORT thread

' browser — a tiny full-screen terminal "web browser" built on the term:: TUI
' module. The blocking http:: fetch runs on a worker thread (the `backend`
' package) so the loading spinner keeps animating while a page loads.
'
' Build and run it from an interactive terminal (see examples/browser/README.md
' for the one-time backend package install):
'   mfb build examples/browser/app
'   ./examples/browser/app/build/browser.out
'
' Layout (top to bottom):
'   row 0            top bar:  [<spinner|🔒|🔓>] followed by the page title
'                    (right-aligned) in Display Mode, or "HREF: <url>" while
'                    editing in Address Mode
'   row 1            a single horizontal rule
'   rows 2..H-3      the content area (the page title + parsed text, or an error)
'   row H-2          a single horizontal rule
'   row H-1          footer:   [Q]uit  [G]o            Files: <loaded>/<total>
'
' The bracket at the far left is a spinner while a page is loading, a locked
' padlock (🔒) once a page has loaded over https, and an open padlock (🔓)
' otherwise. "Files: n/m" counts the resources for the current page: the HTML
' document plus each <link> stylesheet, where n is how many loaded (a complete
' HTTP 200). A page with no external stylesheets reads 1/1 (redirect hops are
' followed to reach the document, not counted as separate resources).
'
' Controls:
'   Q / q      quit
'   G / g      enter Address Mode
'   R / r      (Display Mode) switch to Raw Mode — the parsed DOM as a tree
'   D / d      (Raw Mode) switch back to Display Mode
'   In Address Mode: type to edit the URL, Backspace deletes, Enter loads the
'                    URL and returns to Display Mode, Esc clears the address (and
'                    cancels when it is already empty).
'   Up / Down  scroll the content one line at a time.
'   Left/Right pan a wider-than-screen page horizontally one column at a time.
'   M / m      cycle the display width: (s)tandard=terminal width, (w)ide=300,
'              (e)xtra-wide=600 columns (shown as (s)/(w)/(e) before Files). A new
'              page load resets to standard.
'   Tab        (Display Mode) focus the next on-screen link, wrapping within the
'              links currently visible; the focused link is highlighted.
'   Enter      (Display Mode) follow the focused link.
'   Esc        (Display Mode) un-focus the highlighted link.
'   L / l      (Display Mode) open the Links list: a labelled multi-column list of
'              every link on the page ("A) Link Text"). Type a link's letter(s) to
'              follow it, Up/Down scroll, Esc returns to the page.
'
' On a load error of any kind the error message is shown in the content area.
'
' The work is split across three imported packages: `dom` (the Node types +
' HTML parser), `fetch` (the ISOLATED thread worker that fetches + parses into a
' document Node — thread::start needs the worker in an imported package), and
' `display` (renders a Node to readable text or an indented tree).

' ----- small numeric helpers (no built-in min/max) -----

FUNC maxOf(a AS Integer, b AS Integer) AS Integer
  IF a > b THEN RETURN a
  RETURN b
END FUNC

FUNC minOf(a AS Integer, b AS Integer) AS Integer
  IF a < b THEN RETURN a
  RETURN b
END FUNC

' The width (in columns) a page is laid out to, by the display width mode: standard
' ("s") is the actual terminal width, wide ("w") is 300, extra-wide ("e") is 600, so
' wide multi-column layouts get room instead of cramming. These are exact so every
' mode is a distinct width (even on a terminal already wider than 300). When wider
' than the terminal the viewport shows a `cols`-wide window; Left/Right pan the rest.
FUNC layoutWidthFor(mode AS String, cols AS Integer) AS Integer
  IF mode = "w" THEN RETURN 300
  IF mode = "e" THEN RETURN 600
  RETURN cols
END FUNC

' The terminal's monospace character cell in CSS px: about 8 px wide and 16 px tall.
' The DOM lays a page out in device-independent CSS px and knows nothing about
' terminals; display maps that px geometry back to terminal cells using this glyph
' size. This terminal-specific knowledge lives here in the terminal app, keeping the
' dom package pixel-native and reusable by a future graphics renderer.
FUNC termCellPx() AS Integer
  RETURN 8
END FUNC

FUNC termLinePx() AS Integer
  RETURN 16
END FUNC

' The next width mode in the toggle cycle: standard -> wide -> extra-wide -> standard.
FUNC nextWidthMode(mode AS String) AS String
  IF mode = "s" THEN RETURN "w"
  IF mode = "w" THEN RETURN "e"
  RETURN "s"
END FUNC

' Rows available for page content: everything except the 2 header and 2 footer
' rows. At least one row so the arithmetic below never goes negative.
FUNC contentHeight(size AS TermSize) AS Integer
  RETURN maxOf(1, size.rows - 4)
END FUNC

' ----- text shaping -----
'
' Every measurement here is in terminal *columns* (strings::displayWidth), never
' Unicode scalar count (len): a CJK ideograph or emoji occupies two cells and a
' combining mark none, so measuring by scalars would let a wide glyph push the
' right edge out of alignment. Truncation always breaks on a grapheme boundary,
' so a two-cell glyph or a base-plus-combining-mark sequence is never split.

' Space-pad `s` on the right to exactly `width` columns. `s` must already be no
' wider than `width`; a space is one column, so the pad count is exact.
FUNC padCols(s AS String, width AS Integer) AS String
  LET w AS Integer = strings::displayWidth(s)
  IF w >= width THEN RETURN s
  RETURN s & strings::repeat(" ", width - w)
END FUNC

' Truncate `s` to at most `width` columns, keeping whole graphemes. When a
' two-cell glyph would straddle the limit it is dropped, leaving the result one
' column short (the caller pads that cell).
FUNC clipCols(s AS String, width AS Integer) AS String
  IF width <= 0 THEN RETURN ""
  IF strings::displayWidth(s) <= width THEN RETURN s
  MUT out AS String = ""
  MUT used AS Integer = 0
  FOR EACH g IN strings::graphemes(s)
    LET gw AS Integer = strings::displayWidth(g)
    IF used + gw > width THEN EXIT FOR
    out = out & g
    used = used + gw
  NEXT
  RETURN out
END FUNC

' Truncate or space-pad a string to exactly `width` terminal columns.
FUNC fit(s AS String, width AS Integer) AS String
  IF width <= 0 THEN RETURN ""
  RETURN padCols(clipCols(s, width), width)
END FUNC

' The widest line in a set of content rows, in display columns (the visible text of
' each AttributedString).
FUNC maxLineWidth(lines AS List OF AttributedString) AS Integer
  MUT m AS Integer = 0
  FOR EACH line IN lines
    LET w AS Integer = strings::displayWidth(toString(line))
    IF w > m THEN m = w
  NEXT
  RETURN m
END FUNC

' Wrap plain content lines as unstyled AttributedStrings, so the Raw view, the
' welcome/error fallback, and the loading screen share drawContent with the styled
' Display-mode rows that display::paint produces.
FUNC attrLines(lines AS List OF String) AS List OF AttributedString
  MUT out AS List OF AttributedString = []
  FOR EACH line IN lines
    out = collections::append(out, astrings::fromString(line))
  NEXT
  RETURN out
END FUNC

' Compose one footer line: `left` flush-left, `right` flush-right, in `width`
' columns. Both are truncated (by column) if they cannot fit.
FUNC composeFooter(left AS String, right AS String, width AS Integer) AS String
  IF width <= 0 THEN RETURN ""
  LET r AS String = clipCols(right, width)
  LET leftRoom AS Integer = width - strings::displayWidth(r)
  RETURN padCols(clipCols(left, leftRoom), leftRoom) & r
END FUNC

' Break raw page text into display lines, hard-wrapping at `width` columns and
' honouring existing newlines. Tabs become four spaces so widths stay stable.
FUNC wrapContent(content AS String, width AS Integer) AS List OF String
  LET w AS Integer = maxOf(1, width)
  MUT out AS List OF String = []
  LET rawLines AS List OF String = strings::split(content, "\n")
  FOR EACH raw IN rawLines
    MUT line AS String = raw
    IF strings::endsWith(line, "\r") THEN line = strings::mid(line, 0, len(line) - 1)
    line = strings::replace(line, "\t", "    ")
    IF len(line) = 0 THEN
      out = collections::append(out, "")
    ELSE
      ' Accumulate whole graphemes into a chunk, flushing before the chunk would
      ' exceed `w` columns. A lone grapheme wider than `w` is kept on its own
      ' line (fit() clips it when drawn) rather than looping forever.
      MUT chunk AS String = ""
      MUT chunkW AS Integer = 0
      FOR EACH g IN strings::graphemes(line)
        LET gw AS Integer = strings::displayWidth(g)
        IF chunkW > 0 AND chunkW + gw > w THEN
          out = collections::append(out, chunk)
          chunk = ""
          chunkW = 0
        END IF
        chunk = chunk & g
        chunkW = chunkW + gw
      NEXT
      IF chunkW > 0 THEN out = collections::append(out, chunk)
    END IF
  NEXT
  RETURN out
END FUNC

' The far-left status glyph in the top bar.
FUNC spinnerGlyph(i AS Integer) AS String
  LET frames AS String = "⣷⣯⣟⡿⢿⣻⣽⣾"
  RETURN strings::mid(frames, i MOD 8, 1)
END FUNC

FUNC indicatorText(loadState AS String, secure AS Boolean, spinner AS Integer) AS String
  IF loadState = "loading" THEN RETURN spinnerGlyph(spinner)
  IF secure THEN RETURN "🔒"
  RETURN "🔓"
END FUNC

' The first-run help shown in the content area.
FUNC welcomeText() AS String
  RETURN "browser — a tiny terminal web viewer\n\nPress G to type an address, then Enter to load it.\nUse the Up / Down arrows to scroll a loaded page, and Left / Right to\npan a wide page horizontally.\nPress Q to quit.\n\nExample addresses (https:// is assumed when omitted):\n  example.com\n  https://example.org\n"
END FUNC

' ----- input -----

' Read one Unicode scalar, or "" at end of input / on a read error.
FUNC getChar() AS String
  LET c AS String = io::readChar() TRAP(e)
    RECOVER ""
  END TRAP
  RETURN c
END FUNC

' True if input is ready within `ms` milliseconds; never raises.
FUNC ready(ms AS Integer) AS Boolean
  LET r AS Boolean = io::pollInput(ms) TRAP(e)
    RECOVER FALSE
  END TRAP
  RETURN r
END FUNC

' Read one logical key, decoding arrow-key escape sequences into named tokens.
' Returns "UP"/"DOWN"/"LEFT"/"RIGHT", "ENTER", "ESC", "BACKSPACE", "EOF", or a
' single printable scalar as itself.
FUNC readKey() AS String
  LET c AS String = getChar()
  IF c = "" THEN RETURN "EOF"
  IF c = "\u{1B}" THEN
    ' ESC alone, or the start of a CSI arrow sequence (ESC [ A .. D).
    IF NOT ready(30) THEN RETURN "ESC"
    LET c2 AS String = getChar()
    IF c2 = "[" OR c2 = "O" THEN
      LET c3 AS String = getChar()
      IF c3 = "A" THEN RETURN "UP"
      IF c3 = "B" THEN RETURN "DOWN"
      IF c3 = "C" THEN RETURN "RIGHT"
      IF c3 = "D" THEN RETURN "LEFT"
      RETURN "ESC"
    END IF
    RETURN "ESC"
  END IF
  IF c = "\r" OR c = "\n" THEN RETURN "ENTER"
  IF c = "\u{7F}" OR c = "\u{08}" THEN RETURN "BACKSPACE"
  RETURN c
END FUNC

' A key that should be inserted into the address field: a single scalar that is
' not one of the multi-character named tokens above.
FUNC isTextKey(key AS String) AS Boolean
  RETURN len(key) = 1
END FUNC

' ----- drawing -----
'
' The frame is split into "chrome" (the address bar, the two rules, and the
' footer) and the "content" region (the page text). Chrome is one row each and
' cheap, so it is repainted every frame. The content region can be many rows and
' its wrapped text is expensive to lay out, so it is repainted only when the
' page, the scroll offset, or the terminal size actually changes — the main loop
' tracks that with a dirty flag. term::sync then emits only the cells that
' differ from the previous frame, so an unchanged region costs no terminal I/O.

' Draw the top bar, both rules, the footer, and place the cursor. The top bar
' shows the URL being edited in Address Mode ("[ind] HREF: <url>") and the page
' title, right-aligned, in Display Mode ("[ind]            <title>").
SUB drawChrome(size AS TermSize, addressMode AS Boolean, rawMode AS Boolean, linksMode AS Boolean, url AS String, title AS String, loadState AS String, secure AS Boolean, spinner AS Integer, widthMode AS String, filesLoaded AS Integer, filesTotal AS Integer)
  LET cols AS Integer = size.columns
  LET rows AS Integer = size.rows
  LET ind AS String = indicatorText(loadState, secure, spinner)
  LET hrefPrefix AS String = "[" & ind & "] HREF: "

  ' Row 0: top bar.
  term::setBackground(30, 40, 60)
  term::setForeground(225, 233, 255)
  term::setBold(TRUE)
  term::moveTo(0, 0)
  IF addressMode THEN
    io::write(fit(hrefPrefix & url, cols))
  ELSE
    io::write(composeFooter("[" & ind & "] ", title, cols))
  END IF
  term::setBold(FALSE)

  ' Row 1 and row H-2: the header and footer rules.
  term::setBackground(0, 0, 0)
  term::setForeground(90, 110, 150)
  term::drawHLine(LineStyle.Light, 1, 0, cols - 1)
  term::drawHLine(LineStyle.Light, rows - 2, 0, cols - 1)

  ' Row H-1: footer controls. The width-mode indicator (s)tandard / (w)ide /
  ' (e)xtra-wide sits just before the file count on the right.
  LET rightPart AS String = "(" & widthMode & ") Files: " & toString(filesLoaded) & "/" & toString(filesTotal)
  MUT leftPart AS String = "[Q]uit  [G]o  [R]aw  [L]inks  [M]ode"
  IF rawMode THEN leftPart = "[Q]uit  [G]o  [D]ocument  [M]ode"
  IF linksMode THEN leftPart = "[Esc] Back"
  IF addressMode THEN leftPart = "[Esc] Clear/Cancel  [Enter] Go"
  term::setBackground(30, 40, 60)
  term::setForeground(225, 233, 255)
  term::setBold(TRUE)
  term::moveTo(rows - 1, 0)
  ' Full surface width, including the bottom-right cell: the term:: presenter
  ' positions every cell with an absolute cursor move and restores the cursor at
  ' the end of each frame, so the last cell never triggers a wrap/scroll. Drawing
  ' the footer to cols-1 (one short) would leave its right edge misaligned with
  ' the full-width top bar and rules.
  io::write(composeFooter(leftPart, rightPart, cols))
  term::setBold(FALSE)
  term::setBackground(0, 0, 0)
  term::setForeground(255, 255, 255)

  ' Cursor: visible at the end of the URL while editing, hidden otherwise. The
  ' column is the on-screen width of the prefix plus URL, not their scalar count:
  ' the indicator emoji (🔒/🔓) is one scalar but occupies two terminal cells, so
  ' `len` would place the cursor one cell short — on the last letter, not past it.
  IF addressMode THEN
    LET curCol AS Integer = minOf(strings::displayWidth(hrefPrefix) + strings::displayWidth(url), cols - 1)
    term::moveTo(0, curCol)
    term::showCursor()
  ELSE
    term::hideCursor()
  END IF
END SUB

' ----- link navigation -----
'
' display::paint returns the page's links as `Target`s, each with the on-screen
' rectangles its text occupies (brackets excluded). The app Tab-cycles the links that
' are currently on screen, highlights the focused one, and loads its href on Enter.

' Whether any of target `t`'s text is on a currently visible row and column.
FUNC targetVisible(t AS Target, scroll AS Integer, contentH AS Integer, hscroll AS Integer, cols AS Integer) AS Boolean
  FOR EACH rc IN t.rects
    IF rc.row >= scroll AND rc.row < scroll + contentH THEN
      IF rc.c1 >= hscroll AND rc.c0 < hscroll + cols THEN
        RETURN TRUE
      END IF
    END IF
  NEXT
  RETURN FALSE
END FUNC

' The next on-screen target after `from` in document order, wrapping around the visible
' set; -1 when no target is on screen. `from` = -1 starts the scan at the first target.
FUNC nextVisibleTarget(targets AS List OF Target, from AS Integer, scroll AS Integer, contentH AS Integer, hscroll AS Integer, cols AS Integer) AS Integer
  LET n AS Integer = len(targets)
  IF n = 0 THEN RETURN -1
  MUT k AS Integer = 0
  DO WHILE k < n
    LET idx AS Integer = (from + 1 + k) MOD n
    IF targetVisible(collections::get(targets, idx), scroll, contentH, hscroll, cols) THEN
      RETURN idx
    END IF
    k = k + 1
  LOOP
  RETURN -1
END FUNC

' Whether `ch` is a single A-Z letter (a link-label character).
FUNC isAlpha(ch AS String) AS Boolean
  RETURN len(ch) = 1 AND strings::contains("ABCDEFGHIJKLMNOPQRSTUVWXYZ", ch)
END FUNC

' The index of the link whose label is `lab`, or -1 if none matches.
FUNC labelIndex(items AS List OF Link, lab AS String) AS Integer
  LET n AS Integer = len(items)
  MUT i AS Integer = 0
  DO WHILE i < n
    IF display::linkLabel(i, n) = lab THEN RETURN i
    i = i + 1
  LOOP
  RETURN -1
END FUNC

' Overlay a selection background over columns [c0, c1] of a row (the focused link).
FUNC highlightRow(a AS AttributedString, c0 AS Integer, c1 AS Integer) AS AttributedString
  LET n AS Integer = len(toString(a))
  LET s0 AS Integer = maxOf(0, c0)
  LET s1 AS Integer = minOf(c1, n - 1)
  IF s1 < s0 THEN RETURN a
  RETURN astrings::addAttribute(a, s0, s1, astrings::background(60, 90, 150))
END FUNC

' Repaint the whole content region (rows 2 .. H-3). Every row is rewritten,
' blanks included, so a shorter page leaves no stale lines behind. Each row is an
' AttributedString drawn with term::drawText, which honours its per-run bold /
' underline / foreground colour. `focusRects` are the focused link's rectangles; their
' cells get a selection background overlaid before the row is drawn.
SUB drawContent(size AS TermSize, wrapped AS List OF AttributedString, scroll AS Integer, hscroll AS Integer, focusRects AS List OF Rect)
  LET cols AS Integer = size.columns
  LET contentH AS Integer = maxOf(1, size.rows - 4)
  term::setBackground(0, 0, 0)
  term::setForeground(210, 214, 220)
  term::setBold(FALSE)
  LET blank AS String = strings::repeat(" ", maxOf(1, cols))
  FOR r = 0 TO contentH - 1
    LET idx AS Integer = scroll + r
    ' Clear the row, then stamp the styled content shifted left by `hscroll`:
    ' term::drawText skips negative columns and clips at the right edge, so it
    ' windows the row horizontally without slicing the (opaque) AttributedString.
    term::drawText(0, 2 + r, blank)
    IF idx >= 0 AND idx < len(wrapped) THEN
      MUT rowA AS AttributedString = collections::get(wrapped, idx)
      FOR EACH rc IN focusRects
        IF rc.row = idx THEN
          rowA = highlightRow(rowA, rc.c0, rc.c1)
        END IF
      NEXT
      term::drawText(0 - hscroll, 2 + r, rowA)
    END IF
  NEXT
END SUB

FUNC main AS Integer
  ' A full-screen TUI needs an interactive terminal on both ends.
  IF NOT io::isOutputTerminal() OR NOT io::isInputTerminal() THEN
    io::printError("browser: run this from an interactive terminal.")
    RETURN 1
  END IF

  term::on()
  term::hideCursor()

  MUT running AS Boolean = TRUE
  MUT addressMode AS Boolean = FALSE
  MUT rawMode AS Boolean = FALSE
  ' Links Mode: a labelled multi-column list of every link on the page ([L] enters it,
  ' Esc leaves, typing a link's letter follows it). `labelBuf` accumulates the typed
  ' label letters until a full label (see display::linkLabelWidth) is entered.
  MUT linksMode AS Boolean = FALSE
  MUT labelBuf AS String = ""
  MUT url AS String = ""
  ' The address as it was on entering Address Mode, restored if the edit is cancelled
  ' (so cancelling — including a clear-then-cancel — leaves the current address intact).
  MUT savedUrl AS String = ""
  MUT pageTitle AS String = ""
  MUT scroll AS Integer = 0
  MUT hscroll AS Integer = 0
  ' Display width mode: "s" standard (terminal width), "w" wide (>=300), "e"
  ' extra-wide (>=600). [M] cycles it; a new page load resets it to standard.
  MUT widthMode AS String = "s"
  MUT loadState AS String = "idle"
  MUT secure AS Boolean = FALSE
  MUT spinner AS Integer = 0
  MUT filesLoaded AS Integer = 0
  MUT filesTotal AS Integer = 0

  ' The loaded document, and the content lines derived from it. Display Mode paints
  ' the DOM by its computed Layout (display::paint → positioned lines) directly into
  ' `wrapped`; Raw Mode (display::tree) and the welcome/error `fallback` are plain
  ' text held in `content` and hard-wrapped. display:: takes the width, so the
  ' content is recomputed on load, mode switch, and resize — tracked by
  ' needRecontent / lastContentWidth.
  MUT pageDoc AS Node = dom::emptyDocument()
  MUT haveDom AS Boolean = FALSE
  MUT fallback AS String = welcomeText()
  MUT content AS String = welcomeText()
  MUT needRecontent AS Boolean = TRUE
  MUT lastContentWidth AS Integer = -1

  ' Cached layout. `wrapped` holds the content lines laid out at the width-mode
  ' width; `lastContentWidth` is that width, so a change re-lays-out. `contentDirty`
  ' marks the content region for repaint (a load, a scroll, or a resize); the chrome
  ' is cheap and repainted every frame. term::didResize() reports a terminal resize.
  MUT wrapped AS List OF AttributedString = []
  ' The page's navigation targets (links) from display::paint, recomputed with
  ' `wrapped`. `focusIdx` is the Tab-selected link (-1 = none); it is only ever set to
  ' an on-screen link and is dropped when the page reflows or that link scrolls away.
  MUT targets AS List OF Target = []
  MUT focusIdx AS Integer = -1
  ' Every link on the current page (display::links), for the [L]inks view; recomputed
  ' on each load.
  MUT pageLinks AS List OF Link = []
  ' A URL to load this frame (set by Address-Mode Enter or activating a focused link),
  ' consumed by the load section below; "" means nothing to load.
  MUT loadTarget AS String = ""
  ' An empty rect list, for drawing content with no link highlighted.
  LET noRects AS List OF Rect = []
  ' The widest content line, for clamping the horizontal scroll (Left/Right). The
  ' page can be laid out wider than the terminal (see layoutWidthFor / the width
  ' mode), and the viewport shows a `cols`-wide window starting at `hscroll`.
  MUT contentPixWidth AS Integer = 0
  MUT contentDirty AS Boolean = TRUE

  ' Start from a clean surface; thereafter term::didResize() drives the re-clear.
  term::clear()

  DO WHILE running
    ' Track the live terminal size; stop cleanly if the terminal detaches.
    LET size AS TermSize = term::terminalSize() TRAP(e)
      EXIT DO
    END TRAP
    LET cols AS Integer = size.columns
    LET rows AS Integer = size.rows

    ' Read the latched resize flag once per frame (reading it clears it). A resize
    ' invalidates the whole surface, so clear and repaint everything.
    LET resized AS Boolean = term::didResize()

    IF cols < 1 OR rows < 5 THEN
      ' Too small for the full layout: show a hint and wait for a key or resize.
      term::clear()
      term::moveTo(0, 0)
      io::write(fit("Window too small", maxOf(1, cols)))
      term::sync()
      contentDirty = TRUE
    ELSE
      IF resized THEN
        term::clear()
        contentDirty = TRUE
      END IF

      ' Recompute the content lines when the page, the display mode, the width mode,
      ' or the terminal width changed. Everything is laid out to the width-mode width
      ' (layoutW): Display Mode paints the DOM there, Raw Mode wraps the tree there,
      ' and the welcome/error fallback wraps there too — so [M] re-lays-out whatever
      ' is on screen. When layoutW exceeds the terminal the viewport shows a
      ' `cols`-wide window (drawContent clips each line to `cols`); Left/Right pan.
      LET paintMode AS Boolean = haveDom AND NOT rawMode AND NOT linksMode
      LET layoutW AS Integer = layoutWidthFor(widthMode, cols)
      IF needRecontent OR layoutW <> lastContentWidth THEN
        IF linksMode THEN
          wrapped = display::linksView(pageLinks, layoutW)
          targets = []
        ELSEIF paintMode THEN
          LET pr AS PaintResult = display::paint(pageDoc, layoutW, termCellPx(), termLinePx())
          wrapped = pr.rows
          targets = pr.targets
        ELSE
          IF haveDom THEN
            content = display::tree(pageDoc, layoutW)
          ELSE
            content = fallback
          END IF
          wrapped = attrLines(wrapContent(content, layoutW))
          targets = []
        END IF
        contentPixWidth = maxLineWidth(wrapped)
        lastContentWidth = layoutW
        needRecontent = FALSE
        contentDirty = TRUE
        ' The page reflowed: any link selection no longer maps to it.
        focusIdx = -1
      END IF

      ' Keep the scroll offset in range; a change repaints the content region.
      LET maxScroll AS Integer = maxOf(0, len(wrapped) - contentHeight(size))
      IF scroll > maxScroll THEN
        scroll = maxScroll
        contentDirty = TRUE
      END IF
      IF scroll < 0 THEN
        scroll = 0
        contentDirty = TRUE
      END IF

      ' Keep the horizontal scroll offset in range too.
      LET maxHScroll AS Integer = maxOf(0, contentPixWidth - cols)
      IF hscroll > maxHScroll THEN
        hscroll = maxHScroll
        contentDirty = TRUE
      END IF
      IF hscroll < 0 THEN
        hscroll = 0
        contentDirty = TRUE
      END IF

      ' A focused link that has scrolled out of view loses its selection.
      IF focusIdx >= 0 THEN
        IF NOT targetVisible(collections::get(targets, focusIdx), scroll, contentHeight(size), hscroll, cols) THEN
          focusIdx = -1
          contentDirty = TRUE
        END IF
      END IF

      MUT focusRects AS List OF Rect = noRects
      IF focusIdx >= 0 THEN
        focusRects = collections::get(targets, focusIdx).rects
      END IF

      drawChrome(size, addressMode, rawMode, linksMode, url, pageTitle, loadState, secure, spinner, widthMode, filesLoaded, filesTotal)
      IF contentDirty THEN
        drawContent(size, wrapped, scroll, hscroll, focusRects)
        contentDirty = FALSE
      END IF
      term::sync()
    END IF

    spinner = spinner + 1

    LET key AS String = readKey()

    IF addressMode THEN
      IF key = "ENTER" THEN
        ' Leave Address Mode; the unified load section below fetches loadTarget.
        addressMode = FALSE
        loadTarget = strings::trim(url)
      ELSEIF key = "ESC" THEN
        ' Esc clears the address first; a second Esc (empty field) cancels, restoring
        ' the address that was there on entering Address Mode (so a cancel is a no-op).
        IF len(url) > 0 THEN
          url = ""
        ELSE
          url = savedUrl
          addressMode = FALSE
        END IF
      ELSEIF key = "BACKSPACE" THEN
        IF len(url) > 0 THEN url = strings::mid(url, 0, len(url) - 1)
      ELSEIF key = "EOF" THEN
        running = FALSE
      ELSEIF isTextKey(key) THEN
        url = url & key
      END IF
    ELSEIF linksMode THEN
      ' Links Mode: Esc back to the page, Up/Down scroll the list, and typing a
      ' link's label letter(s) follows it (labelBuf gathers a multi-letter label).
      IF key = "EOF" THEN
        running = FALSE
      ELSEIF key = "ESC" THEN
        linksMode = FALSE
        labelBuf = ""
        scroll = 0
        needRecontent = TRUE
      ELSEIF key = "UP" THEN
        IF scroll > 0 THEN
          scroll = scroll - 1
          contentDirty = TRUE
        END IF
      ELSEIF key = "DOWN" THEN
        scroll = scroll + 1
        contentDirty = TRUE
      ELSEIF isTextKey(key) THEN
        LET ch AS String = strings::upper(key)
        IF isAlpha(ch) THEN
          labelBuf = labelBuf & ch
          IF len(labelBuf) >= display::linkLabelWidth(len(pageLinks)) THEN
            LET idx AS Integer = labelIndex(pageLinks, labelBuf)
            IF idx >= 0 THEN
              loadTarget = fetch::resolveHref(url, collections::get(pageLinks, idx).href)
            END IF
            labelBuf = ""
          END IF
        ELSE
          labelBuf = ""
        END IF
      END IF
    ELSE
      ' Display Mode or Raw Mode.
      IF key = "q" OR key = "Q" OR key = "EOF" THEN
        running = FALSE
      ELSEIF key = "g" OR key = "G" THEN
        savedUrl = url
        addressMode = TRUE
      ELSEIF (key = "r" OR key = "R") AND haveDom AND NOT rawMode THEN
        rawMode = TRUE
        scroll = 0
        hscroll = 0
        needRecontent = TRUE
      ELSEIF (key = "l" OR key = "L") AND haveDom AND NOT rawMode THEN
        ' Enter the links list.
        linksMode = TRUE
        labelBuf = ""
        scroll = 0
        hscroll = 0
        needRecontent = TRUE
      ELSEIF (key = "d" OR key = "D") AND rawMode THEN
        rawMode = FALSE
        scroll = 0
        hscroll = 0
        needRecontent = TRUE
      ELSEIF key = "UP" THEN
        IF scroll > 0 THEN
          scroll = scroll - 1
          contentDirty = TRUE
        END IF
      ELSEIF key = "DOWN" THEN
        scroll = scroll + 1
        contentDirty = TRUE
      ELSEIF key = "LEFT" THEN
        IF hscroll > 0 THEN
          hscroll = hscroll - 1
          contentDirty = TRUE
        END IF
      ELSEIF key = "RIGHT" THEN
        hscroll = hscroll + 1
        contentDirty = TRUE
      ELSEIF key = "m" OR key = "M" THEN
        ' Cycle the display width mode (standard -> wide -> extra-wide) and re-lay
        ' out; reset the horizontal pan since the canvas width changed.
        widthMode = nextWidthMode(widthMode)
        hscroll = 0
        needRecontent = TRUE
        contentDirty = TRUE
      ELSEIF key = "\t" THEN
        ' Tab: focus the next on-screen link, wrapping within the visible set.
        focusIdx = nextVisibleTarget(targets, focusIdx, scroll, contentHeight(size), hscroll, cols)
        contentDirty = TRUE
      ELSEIF key = "ENTER" THEN
        ' Enter activates the focused link: resolve its href against the current page
        ' URL and queue the load. With no link focused it does nothing.
        IF focusIdx >= 0 THEN
          loadTarget = fetch::resolveHref(url, collections::get(targets, focusIdx).href)
        END IF
      ELSEIF key = "ESC" THEN
        ' Esc un-highlights the focused link.
        IF focusIdx >= 0 THEN
          focusIdx = -1
          contentDirty = TRUE
        END IF
      END IF
    END IF

    ' Unified load: Address-Mode Enter and activating a focused link both set
    ' loadTarget. Fetch it on a worker thread while the spinner keeps animating.
    IF loadTarget <> "" AND running THEN
      LET target AS String = loadTarget
      loadTarget = ""
      url = target
      addressMode = FALSE
      loadState = "loading"
      pageTitle = ""
      focusIdx = -1
      LET loadingLines AS List OF AttributedString = attrLines(wrapContent("Loading " & target & " ...", cols))
      drawChrome(size, FALSE, FALSE, FALSE, url, pageTitle, loadState, secure, spinner, widthMode, filesLoaded, filesTotal)
      drawContent(size, loadingLines, 0, 0, noRects)
      term::sync()

      LET worker AS Thread OF String TO LoadResult = thread::start(fetch::fetch, target)
      DO WHILE thread::isRunning(worker)
        spinner = spinner + 1
        drawChrome(size, FALSE, FALSE, FALSE, url, pageTitle, loadState, secure, spinner, widthMode, filesLoaded, filesTotal)
        term::sync()
        ' Wait up to one frame for a key; Q aborts the load and quits.
        IF ready(100) THEN
          LET k AS String = readKey()
          IF k = "q" OR k = "Q" OR k = "EOF" THEN
            thread::cancel(worker)
            running = FALSE
            EXIT DO
          END IF
        END IF
      LOOP

      IF running THEN
        ' Not aborted: take the result. (On abort the handle drops here, cancelling
        ' and detaching the worker so quitting is immediate.)
        LET page AS LoadResult = thread::waitFor(worker)
        ' The worker parsed the page into a DOM and deep-copied it back. The title
        ' goes in the top bar; the document drives the content. A new page opens in
        ' Display Mode. On error there is no DOM, so the message shows via `fallback`.
        haveDom = page.ok
        IF page.ok THEN
          pageDoc = page.document
          pageTitle = page.title
          pageLinks = display::links(pageDoc)
        ELSE
          fallback = page.message
          pageTitle = ""
          pageLinks = []
        END IF
        rawMode = FALSE
        linksMode = FALSE
        labelBuf = ""
        secure = page.secure
        filesLoaded = page.filesLoaded
        filesTotal = page.filesTotal
        scroll = 0
        hscroll = 0
        widthMode = "s"
        needRecontent = TRUE
        contentDirty = TRUE
        IF page.ok THEN
          loadState = "ok"
        ELSE
          loadState = "error"
        END IF
      END IF
    END IF
  LOOP

  term::showCursor()
  term::off()
  RETURN 0

  TRAP(e)
    term::showCursor()
    term::off()
    io::printError("browser: " & e.message)
    RETURN 1
  END TRAP
END FUNC
