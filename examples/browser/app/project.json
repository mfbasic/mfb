{
  "name": "browser",
  "version": "0.1.0",
  "mfb": "1.0",
  "kind": "executable",
  "sources": [
    {
      "root": "src",
      "role": "main",
      "include": [
        "**/*.mfb"
      ]
    }
  ],
  "packages": [
    {
      "name": "dom",
      "version": "=0.1.0",
      "source": "file:packages/dom.mfp"
    },
    {
      "name": "fetch",
      "version": "=0.1.0",
      "source": "file:packages/fetch.mfp"
    },
    {
      "name": "display",
      "version": "=0.1.0",
      "source": "file:packages/display.mfp"
    }
  ],
  "entry": "main",
  "targets": [
    "native"
  ]
}
