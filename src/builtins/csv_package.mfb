IMPORT collections
IMPORT strings
IMPORT encoding

' csv::parse — scan CSV text into a grid of rows of String cells.
'
' The dialect is RFC-4180-aligned (see src/docs/spec/stdlib/03_csv.md):
'   * comma is the only field delimiter;
'   * a record separator is LF ("\n") or CRLF ("\r\n"); a bare CR is data;
'   * a field may be wrapped in double quotes, inside which "" is a literal
'     quote and commas / CR / LF are ordinary data;
'   * a single trailing separator does not create an empty final row.
' CRLF is handled by peeking (__csv_separatorLength): the runtime grapheme
' splitter may yield "\r" and "\n" as two separate graphemes, so the scanner must
' not assume CR+LF arrives as one cursor step.
' plan-39 G1/G2: scan the input over its Unicode scalars (one-pass utf32Encode ->
' List OF Integer) instead of materializing a grapheme List OF String — avoiding
' the ~n single-grapheme string allocations and the O(n^2) `field = field & ch`
' concat. Every structural CSV character (comma, quote, CR, LF) is ASCII, and a
' grapheme cluster split into scalars and rejoined is byte-identical, so the grid
' is unchanged. Scalar codes: comma=44, double-quote=34, CR=13, LF=10.
' plan-64 A3: an UNQUOTED field is a contiguous run of those scalars, so it is
' decoded straight from the shared scalar buffer with one __csv_decodeRange
' call (`__csv_fieldValue`) — no per-character scalar-buffer growth and no
' intermediate slice. Only a QUOTED field (whose "" escapes and stripped delimiters
' make its content non-contiguous) builds `fieldBuf`. This removes the ~n per-field
' append churn that fed the arena mixed-transient-churn quadratic (plan-64 sub-plan
' A) while keeping the grid byte-identical. `fieldStart` tracks the scalar index
' where the current field's content begins; `wasQuoted` selects the buffer vs. range
' path.
' plan-77 C3: `delimiter` and `quote` are single-character strings (RFC-4180
' defaults "," and the double quote when the caller omits them). The parser works
' on Unicode scalar codes, so each is converted to its first code point once.
FUNC __csv_parse(value AS String, delimiter AS String, quote AS String) AS List OF List OF String
  LET delimCode AS Integer = __csv_firstCode(delimiter)
  LET quoteCode AS Integer = __csv_firstCode(quote)
  LET chars AS List OF Integer = encoding::utf32Encode(value)
  LET count AS Integer = len(chars)
  MUT rows AS List OF List OF String = []
  MUT row AS List OF String = []
  MUT fieldBuf AS List OF Integer = []
  MUT fieldStart AS Integer = 0
  MUT index AS Integer = 0
  MUT inQuotes AS Boolean = FALSE
  MUT fieldStarted AS Boolean = FALSE
  MUT wasQuoted AS Boolean = FALSE
  MUT recordPending AS Boolean = FALSE

  WHILE index < count
    LET ch AS Integer = collections::get(chars, index)
    IF inQuotes THEN
      IF ch = quoteCode THEN
        IF __csv_isDoubledQuote(chars, count, index, quoteCode) THEN
          fieldBuf = collections::append(fieldBuf, quoteCode)
          index = index + 2
        ELSE
          inQuotes = FALSE
          wasQuoted = TRUE
          index = index + 1
        END IF
      ELSE
        fieldBuf = collections::append(fieldBuf, ch)
        index = index + 1
      END IF
    ELSEIF __csv_separatorLength(chars, count, index) > 0 THEN
      row = collections::append(row, __csv_fieldValue(chars, fieldBuf, wasQuoted, fieldStart, index))
      rows = collections::append(rows, row)
      row = []
      fieldBuf = []
      fieldStarted = FALSE
      wasQuoted = FALSE
      recordPending = FALSE
      index = index + __csv_separatorLength(chars, count, index)
      fieldStart = index
    ELSEIF ch = delimCode THEN
      row = collections::append(row, __csv_fieldValue(chars, fieldBuf, wasQuoted, fieldStart, index))
      fieldBuf = []
      fieldStarted = FALSE
      wasQuoted = FALSE
      recordPending = TRUE
      index = index + 1
      fieldStart = index
    ELSEIF wasQuoted THEN
      FAIL error(77050003, "invalid CSV format")
    ELSEIF ch = quoteCode AND fieldStarted = FALSE THEN
      inQuotes = TRUE
      fieldStarted = TRUE
      index = index + 1
    ELSE
      fieldStarted = TRUE
      index = index + 1
    END IF
  END WHILE

  IF inQuotes THEN
    FAIL error(77050003, "invalid CSV format")
  END IF

  IF fieldStarted OR recordPending OR wasQuoted THEN
    row = collections::append(row, __csv_fieldValue(chars, fieldBuf, wasQuoted, fieldStart, index))
    rows = collections::append(rows, row)
  END IF

  RETURN rows
END FUNC

' Decode one CSV field. A quoted field's content was collapsed into `buf`
' (doubled quotes folded, delimiters stripped), so it is decoded from the buffer.
' An unquoted field is exactly the contiguous scalar run chars[fieldStart..index),
' so it is decoded straight from the shared scalar buffer with one range decode —
' no per-character buffer growth and no intermediate slice (plan-64 A3). `index`
' is the scalar just past the field (the delimiter, or `count` at end of input),
' so it is the exclusive end of the field's scalar run.
FUNC __csv_fieldValue(chars AS List OF Integer, buf AS List OF Integer, wasQuoted AS Boolean, fieldStart AS Integer, index AS Integer) AS String
  IF wasQuoted THEN
    RETURN encoding::utf32Decode(buf)
  END IF
  RETURN __csv_decodeRange(chars, fieldStart, index)
END FUNC

' Decode the half-open scalar range chars[startIndex..endIndex) directly to a
' String, reusing encoding's canonical per-code-point UTF-8 encoder. Validation
' and output match encoding::utf32Decode over that slice, so this equals
' utf32Decode(mid(chars, s, e - s)) byte-for-byte — but it reads straight from the
' shared scalar buffer with no intermediate List OF Integer allocation, which is
' the whole point (plan-64 A3). Kept in csv (rather than added as an encoding
' member) so only csv's own corpus changes; encoding's — imported far more widely —
' stays byte-identical.
FUNC __csv_decodeRange(chars AS List OF Integer, startIndex AS Integer, endIndex AS Integer) AS String
  MUT out AS String = ""
  MUT i AS Integer = startIndex
  WHILE i < endIndex
    LET cp AS Integer = collections::get(chars, i)
    IF cp < 0 OR cp > 1114111 THEN
      FAIL error(77050003, "invalid code point")
    END IF
    IF cp >= 55296 AND cp <= 57343 THEN
      FAIL error(77050003, "surrogate code point")
    END IF
    out = out & __encoding_fromCodepoint(cp)
    i = i + 1
  END WHILE
  RETURN out
END FUNC

FUNC __csv_isDoubledQuote(chars AS List OF Integer, count AS Integer, index AS Integer, quoteCode AS Integer) AS Boolean
  IF index + 1 >= count THEN
    RETURN FALSE
  END IF
  IF collections::get(chars, index + 1) = quoteCode THEN
    RETURN TRUE
  END IF
  RETURN FALSE
END FUNC

' First Unicode scalar code of a (single-character) dialect string. An empty
' string would make parsing ambiguous, so it is rejected.
FUNC __csv_firstCode(s AS String) AS Integer
  LET codes AS List OF Integer = encoding::utf32Encode(s)
  IF len(codes) = 0 THEN
    FAIL error(77050003, "csv: dialect delimiter/quote must be a non-empty character")
  END IF
  RETURN collections::get(codes, 0)
END FUNC

' Length, in scalars, of a record separator starting at index, or 0 if the scalar
' there is not a separator. A bare LF is one step; a CR (13) followed by an LF
' (10) is two steps; a lone CR is data (0). utf32Encode never merges CRLF, so the
' two-scalar case is the only CRLF form.
FUNC __csv_separatorLength(chars AS List OF Integer, count AS Integer, index AS Integer) AS Integer
  LET ch AS Integer = collections::get(chars, index)
  IF ch = 10 THEN
    RETURN 1
  END IF
  IF ch = 13 THEN
    IF index + 1 < count THEN
      IF collections::get(chars, index + 1) = 10 THEN
        RETURN 2
      END IF
    END IF
  END IF
  RETURN 0
END FUNC

' csv::stringify — render a grid back to CSV text (see §6).
' Rows are joined with a single LF (no trailing newline); fields are joined with
' a comma and quoted only when they contain a comma, a double quote, a CR, or an
' LF. Inside a quoted field every double quote is doubled.
' plan-77 C3: `delimiter`/`quote`/`newline` are the output dialect (RFC-4180
' defaults ",", the double quote, and LF when the caller omits them).
FUNC __csv_stringify(value AS List OF List OF String, delimiter AS String, quote AS String, newline AS String) AS String
  MUT out AS String = ""
  MUT firstRow AS Boolean = TRUE
  FOR EACH row IN value
    IF firstRow THEN
      firstRow = FALSE
    ELSE
      out = out & newline
    END IF
    out = out & __csv_stringifyRow(row, delimiter, quote)
  NEXT
  RETURN out
END FUNC

FUNC __csv_stringifyRow(row AS List OF String, delimiter AS String, quote AS String) AS String
  MUT out AS String = ""
  MUT firstField AS Boolean = TRUE
  FOR EACH field IN row
    IF firstField THEN
      firstField = FALSE
    ELSE
      out = out & delimiter
    END IF
    out = out & __csv_encodeField(field, delimiter, quote)
  NEXT
  RETURN out
END FUNC

FUNC __csv_encodeField(field AS String, delimiter AS String, quote AS String) AS String
  IF __csv_needsQuote(field, delimiter, quote) THEN
    RETURN __csv_quoteField(field, quote)
  END IF
  RETURN field
END FUNC

FUNC __csv_needsQuote(field AS String, delimiter AS String, quote AS String) AS Boolean
  IF strings::contains(field, delimiter) THEN
    RETURN TRUE
  END IF
  IF strings::contains(field, quote) THEN
    RETURN TRUE
  END IF
  IF strings::contains(field, "\r") THEN
    RETURN TRUE
  END IF
  IF strings::contains(field, "\n") THEN
    RETURN TRUE
  END IF
  RETURN FALSE
END FUNC

FUNC __csv_quoteField(field AS String, quote AS String) AS String
  ' plan-77 C5/C3: double every embedded quote char and wrap in it. strings::replace
  ' works on the raw string, avoiding a grapheme list + per-grapheme concat.
  RETURN quote & strings::replace(field, quote, quote & quote) & quote
END FUNC
