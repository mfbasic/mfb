' Built-in `datetime::` package (plan-01-datetime.md).
'
' All portable calendar math, formatting, and parsing lives here as internal
' `__datetime_*` functions. Only the OS clock and the local-zone table are
' platform state, reached through the `datetime::nowNanos` / `monotonicNanos` /
' `localOffset` intrinsics (lowered to libc runtime helpers, §8.2). The public
' surface (`datetime::now`, `datetime::instant`, ...) is presented by the Rust
' seam (`src/builtins/datetime.rs`), which rewrites each public call onto the
' matching internal implementation below.

IMPORT datetime
IMPORT strings
IMPORT collections

' ===========================================================================
' Types (§3). Every public type is a flat copyable record/enum.
' ===========================================================================

DOC
  TYPE Instant
  DESC An absolute point on the UTC timeline, stored as a count of seconds since
  DESC the Unix epoch plus a sub-second nanosecond part.
  PROP seconds Whole seconds since the Unix epoch (1970-01-01T00:00:00Z).
  PROP nanos Sub-second part in nanoseconds, in the range 0..999_999_999.
END DOC
EXPORT TYPE Instant
  seconds AS Integer
  nanos   AS Integer
END TYPE

DOC
  TYPE Duration
  DESC A signed span of time between two instants, stored as seconds plus a
  DESC nanosecond part.
  PROP seconds The whole-seconds component of the span.
  PROP nanos The sub-second part in nanoseconds, in the range 0..999_999_999.
END DOC
EXPORT TYPE Duration
  seconds AS Integer
  nanos   AS Integer
END TYPE

DOC
  TYPE Date
  DESC A proleptic-Gregorian calendar date, without any time or zone.
  PROP year The year (e.g. 2026).
  PROP month The month of the year, 1..12.
  PROP day The day of the month, 1..31.
END DOC
EXPORT TYPE Date
  year  AS Integer
  month AS Integer
  day   AS Integer
END TYPE

DOC
  TYPE Time
  DESC A wall-clock time of day, without any date or zone.
  PROP hour The hour of the day, 0..23.
  PROP minute The minute of the hour, 0..59.
  PROP second The second of the minute, 0..59.
  PROP nanos The sub-second part in nanoseconds, in the range 0..999_999_999.
END DOC
EXPORT TYPE Time
  hour   AS Integer
  minute AS Integer
  second AS Integer
  nanos  AS Integer
END TYPE

DOC
  TYPE Zone
  DESC A time zone, described by its offset from UTC together with the kind of
  DESC zone and a display label.
  PROP offsetSeconds Offset from UTC in seconds (east positive).
  PROP kind The zone's kind as a `ZoneKind` discriminant (Utc, FixedOffset, or Local).
  PROP label A human-readable label for the zone (e.g. `"UTC"` or `"+05:30"`).
END DOC
EXPORT TYPE Zone
  offsetSeconds AS Integer
  kind          AS Integer
  label         AS String
END TYPE

DOC
  TYPE DateTime
  DESC A zoned date-and-time: a `Date` and `Time` interpreted in a `Zone`, with
  DESC the resolved UTC offset cached alongside.
  PROP date The calendar date component.
  PROP time The wall-clock time component.
  PROP zone The zone the date and time are expressed in.
  PROP offset The resolved offset from UTC in seconds at this moment.
END DOC
EXPORT TYPE DateTime
  date   AS Date
  time   AS Time
  zone   AS Zone
  offset AS Integer
END TYPE

DOC
  ENUM ZoneKind
  DESC Classifies a `Zone`: coordinated universal time, a fixed offset, or the
  DESC host's local zone.
  PROP Utc Coordinated Universal Time (offset 0).
  PROP FixedOffset A constant offset from UTC.
  PROP Local The host system's local time zone.
END DOC
EXPORT ENUM ZoneKind
  Utc, FixedOffset, Local
END ENUM

DOC
  ENUM Weekday
  DESC A day of the week, Monday through Sunday.
  PROP Monday Monday.
  PROP Tuesday Tuesday.
  PROP Wednesday Wednesday.
  PROP Thursday Thursday.
  PROP Friday Friday.
  PROP Saturday Saturday.
  PROP Sunday Sunday.
END DOC
EXPORT ENUM Weekday
  Monday, Tuesday, Wednesday, Thursday, Friday, Saturday, Sunday
END ENUM

DOC
  ENUM Month
  DESC A month of the year, January through December.
  PROP January January.
  PROP February February.
  PROP March March.
  PROP April April.
  PROP May May.
  PROP June June.
  PROP July July.
  PROP August August.
  PROP September September.
  PROP October October.
  PROP November November.
  PROP December December.
END DOC
EXPORT ENUM Month
  January, February, March, April, May, June, July, August, September, October, November, December
END ENUM

' ===========================================================================
' Normalization helpers. Carry a raw (seconds, nanos) pair into the canonical
' form where nanos is in [0, 1_000_000_000). `/` truncates toward zero and
' `MOD` takes the sign of the dividend, so a negative nanos borrows one second.
' ===========================================================================

FUNC __datetime_normInstant(seconds AS Integer, nanos AS Integer) AS Instant
  MUT q AS Integer = nanos / 1000000000
  MUT r AS Integer = nanos MOD 1000000000
  IF r < 0 THEN
    r = r + 1000000000
    q = q - 1
  END IF
  RETURN Instant[seconds + q, r]
END FUNC

FUNC __datetime_normDuration(seconds AS Integer, nanos AS Integer) AS Duration
  MUT q AS Integer = nanos / 1000000000
  MUT r AS Integer = nanos MOD 1000000000
  IF r < 0 THEN
    r = r + 1000000000
    q = q - 1
  END IF
  RETURN Duration[seconds + q, r]
END FUNC

' ===========================================================================
' Clock (§5.1). The intrinsics return nanoseconds since the epoch / an
' arbitrary origin; both are non-negative on any sane host, so the split is a
' plain truncating divide.
' ===========================================================================

'@@MFB_BODY:now@@

'@@MFB_BODY:monotonic@@

' ===========================================================================
' Instant component builders (§5.1.1). Disjoint arities 1..5.
' ===========================================================================

FUNC __datetime_instant1(seconds AS Integer) AS Instant
  RETURN Instant[seconds, 0]
END FUNC

FUNC __datetime_instant2(seconds AS Integer, nanos AS Integer) AS Instant
  RETURN __datetime_normInstant(seconds, nanos)
END FUNC

FUNC __datetime_instant3(mins AS Integer, seconds AS Integer, nanos AS Integer) AS Instant
  RETURN __datetime_normInstant(mins * 60 + seconds, nanos)
END FUNC

FUNC __datetime_instant4(hours AS Integer, mins AS Integer, seconds AS Integer, nanos AS Integer) AS Instant
  RETURN __datetime_normInstant(hours * 3600 + mins * 60 + seconds, nanos)
END FUNC

FUNC __datetime_instant5(days AS Integer, hours AS Integer, mins AS Integer, seconds AS Integer, nanos AS Integer) AS Instant
  RETURN __datetime_normInstant(days * 86400 + hours * 3600 + mins * 60 + seconds, nanos)
END FUNC

' ===========================================================================
' Duration component builders (§5.1).
' ===========================================================================

FUNC __datetime_duration1(seconds AS Integer) AS Duration
  RETURN Duration[seconds, 0]
END FUNC

FUNC __datetime_duration2(seconds AS Integer, nanos AS Integer) AS Duration
  RETURN __datetime_normDuration(seconds, nanos)
END FUNC

FUNC __datetime_duration3(mins AS Integer, seconds AS Integer, nanos AS Integer) AS Duration
  RETURN __datetime_normDuration(mins * 60 + seconds, nanos)
END FUNC

FUNC __datetime_duration4(hours AS Integer, mins AS Integer, seconds AS Integer, nanos AS Integer) AS Duration
  RETURN __datetime_normDuration(hours * 3600 + mins * 60 + seconds, nanos)
END FUNC

FUNC __datetime_duration5(days AS Integer, hours AS Integer, mins AS Integer, seconds AS Integer, nanos AS Integer) AS Duration
  RETURN __datetime_normDuration(days * 86400 + hours * 3600 + mins * 60 + seconds, nanos)
END FUNC

